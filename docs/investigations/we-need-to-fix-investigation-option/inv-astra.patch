+# investigation_completed_wait parent identifies an old completed handoff still marked waiting.
+# Only a recorded terminal result in Phase 4 proves completion; clarification and capacity waits stay active.
+investigation_completed_wait() {
+  local parent=$1 result
+  [[ $(task_field "$parent" STATUS) == waiting \
+    && $(investigation_field "$parent" INVESTIGATION_PIPELINE) == 1 \
+    && $(investigation_field "$parent" INVESTIGATION_PHASE) == 4 ]] || return 1
+  result=$(investigation_field "$parent" INVESTIGATION_HANDOFF_RESULT)
+  [[ $result == done || $result == failed ]]
+}
