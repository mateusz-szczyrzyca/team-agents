# bus forwards a local command without the admission lock, including any children it wakes.
bus() { "$AGENTBUS_BIN" "$@" 10>&-; }

# `agent stop --running` in progress: blocks waking, queues and notifications (flag valid for 2 min)
stopping() {
  local f="$AGENTS_HOME/.stop-all"
  [[ -f $f ]] && (( $(date +%s) - $(stat -c %Y "$f") < 120 ))
}

# ------------------------------------------------------------------ task metadata (meta.env)

meta_file() { printf '%s/%s/meta.env' "$TASKS" "$1"; }

meta_set() { # id key value [run] — sets KEY=value under the task lock; a stale optional run is a successful no-op
  local f; f=$(meta_file "$1")
  (
    # a run, agent stop and the bus's wake-ups write the same file: without the lock an update gets lost
    flock -w 30 9 || { log_error meta_lock_timeout "file=$f" "key=$2"; exit 1; }
    # Check while holding the writer lock: an old kick or exit trap must not mutate a newer run.
    if [[ -n ${4:-} && $(task_field "$1" RUN) != "${4:-}" ]]; then exit 0; fi
    # Each step reports its own failure: a failed write must never be moved over the old file. Inside the
    # conditional the subshell does not stop at the first error, so the status is checked explicitly.
    local tmp="$f.tmp.$$"
    # grep exits 1 when no other line remains — that is not an error
    if ! { { grep -v "^$2=" "$f" || (($? == 1)); } && printf '%s=%q\n' "$2" "$3"; } > "$tmp"; then
      rm -f "$tmp"
      log_error meta_write_failed "file=$f" "key=$2"
      exit 1
    fi
    if ! mv "$tmp" "$f"; then
      rm -f "$tmp"
      log_error meta_write_failed "file=$f" "key=$2"
      exit 1
    fi
    if [[ $2 == STATUS ]]; then
      local jid="" journal_rc
      # Exit 1 means an ordinary task without a job marker; a read failure must not be hidden.
      if jid=$(grep "^JOB_ID=" "$f"); then
        jid=${jid#JOB_ID=}
        if [[ -n $jid ]]; then
          local now record
          now=$(date -u +"%Y-%m-%dT%H:%M:%S.%NZ")
          record=$(jq -cn --arg state "$3" --arg at "$now" '{state:$state,at:$at}') || exit 1
          if ! printf '%s\n' "$record" >> "$TASKS/$1/job_transitions.jsonl"; then
            log_error meta_write_failed "file=$f" "key=job_transitions"
            exit 1
          fi
        fi
      else
        journal_rc=$?
        if ((journal_rc != 1)); then
          log_error meta_write_failed "file=$f" "key=JOB_ID"
          exit 1
        fi
      fi
    fi
  ) 9> "$f.lock"
}

meta_load() { # loads the task's meta.env variables into the current shell
  local f; f=$(meta_file "$1")
  [[ -f $f ]] || die "no such task: $1"
  # shellcheck source=/dev/null
  # shellcheck source=/dev/null
  source "$f"
}

# task_field task key reads one persisted metadata field without inheriting an ambient shell variable when it is absent.
# shellcheck source=/dev/null
task_field() { ( unset "$2"; source "$(meta_file "$1")"; printf '%s' "${!2:-}" ) }

resolve_id() { # exact task ID or an unambiguous fragment → task ID
  local q=$1 m=()
  [[ -d $TASKS/$q ]] && { printf '%s' "$q"; return; }
  local d
  for d in "$TASKS"/*/; do
    d=${d%/}; d=${d##*/}
    [[ $d == *"$q"* ]] && m+=("$d")
  done
  ((${#m[@]} == 1)) || die "no unique task matches '$q' (${#m[@]} matches)"
  printf '%s' "${m[0]}"
}

unit_name() { printf 'agent-%s-r%s' "$1" "$2"; }

unit_active() { # id run
  # a query: "inactive" and "no such unit" both mean the run is not active
  systemctl --user is-active --quiet "$(unit_name "$1" "$2").service" 2>/dev/null
}

agent_running_task() { # agent name → ID of the task it is running (or nothing)
  local d
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    local id st run ag
    id=${d%/}; id=${id##*/}
    ag=$(task_field "$id" AGENT); st=$(task_field "$id" STATUS); run=$(task_field "$id" RUN)
    if [[ $ag == "$1" && ($st == running || $st == starting) ]] && unit_active "$id" "$run"; then
      printf '%s' "$id"; return 0
    fi
    if [[ $ag == "$1" && $st == sleeping ]]; then   # a sleeping team member keeps its agent reserved
      printf '%s' "$id"; return 0
    fi
    # A prepared node job awaiting lead start acknowledgement keeps its agent reserved before run 1
    local jid
    jid=$(task_field "$id" JOB_ID)
    if [[ $ag == "$1" && -n $jid && $run -eq 0 && ($st == new || $st == starting || $st == running) ]]; then
      printf '%s' "$id"; return 0
    fi
  done
  return 1
}

# ------------------------------------------------------------------ questions

count_questions() { # file → number of "## N." questions (0 for a missing file)
  [[ -f $1 ]] || { echo 0; return; }
  grep -cE '^## [0-9]+\.' "$1" || (($? == 1))   # grep -c exits 1 when it counts 0
}

# The labels of a questions file. They are fixed English words whatever language the questions are in; spaces
# inside the asterisks are tolerated. "Answer" and "Odpowiedź" are the verdict labels of older versions.
Q_VERDICT_RE='^[*][*][[:space:]]*(Verdict|Answer|Odpowiedź)[[:space:]]*:[[:space:]]*[*][*]'
Q_RECOMMENDED_RE='^[*][*][[:space:]]*Recommended[[:space:]]*:[[:space:]]*[*][*]'
Q_LABEL_RE='^[*][*][[:space:]]*[[:alpha:]][[:alpha:] ]*:[[:space:]]*[*][*]'
Q_ANSWERED_RE='^[*][*][[:space:]]*ANSWERED[[:space:]]*[*][*][[:space:]]*$'

validate_answers() { # file → 0 when every question has a non-empty verdict
  [[ -s $1 ]] || { echo "questions file missing: $1" >&2; return 1; }
  awk -v ver="$Q_VERDICT_RE" -v lab="$Q_LABEL_RE" -v done_re="$Q_ANSWERED_RE" '
    function check() {
      if (!inq) return
      if (!mark) { bad++; printf "  question %s: missing **Verdict:** line\n", num > "/dev/stderr" }
      else if (ans ~ /^[[:space:]]*$/) { bad++; printf "  question %s: no verdict\n", num > "/dev/stderr" }
    }
    /^## [0-9]+\./ {
      check(); inq = 1; mark = 0; inv = 0; ans = ""; q++
      num = $2; sub(/\.$/, "", num); next
    }
    $0 ~ done_re { next }
    $0 ~ ver { if (inq) { mark = 1; inv = 1; line = $0; sub(ver, "", line); ans = ans line }; next }
    $0 ~ lab { inv = 0; next }   # another label (e.g. **Recommended:**) is not part of the verdict
    { if (inq && inv) ans = ans $0 }
    END {
      check()
      if (q == 0) { print "  no questions in the \"## N. ...\" format" > "/dev/stderr"; exit 1 }
      exit (bad > 0)
    }
  ' "$1"
}

# questions_missing_recommendations file — the numbers of the questions without a non-empty **Recommended:** part
questions_missing_recommendations() {
  awk -v rec="$Q_RECOMMENDED_RE" -v lab="$Q_LABEL_RE" '
    function check() { if (inq && txt ~ /^[[:space:]]*$/) out = out (out == "" ? "" : " ") num }
    /^## [0-9]+\./ { check(); inq = 1; txt = ""; inr = 0; num = $2; sub(/\.$/, "", num); next }
    $0 ~ rec { inr = 1; line = $0; sub(rec, "", line); txt = txt line; next }
    $0 ~ lab { inr = 0; next }
    { if (inr) txt = txt $0 }
    END { check(); printf "%s", out }
  ' "$1"
}

# expand_answers file — the answered questions file as the agent gets it: a verdict that is exactly "ok" becomes
# the recommendation it accepts; the ANSWERED marker and the answering instructions (questions_note) are dropped.
expand_answers() {
  awk -v ver="$Q_VERDICT_RE" -v rec="$Q_RECOMMENDED_RE" -v lab="$Q_LABEL_RE" -v done_re="$Q_ANSWERED_RE" '
    function trim(x) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x }
    function accepted() { return "**Verdict:** ok — the human accepts the recommendation: " trim(rect) }
    /^## [0-9]+\./ { rect = ""; inr = 0; pend = 0; print; next }
    $0 ~ done_re { next }
    /^> Answer every question after / { skip_blank = 1; next }
    skip_blank && /^[[:space:]]*$/ { skip_blank = 0; next }
    { skip_blank = 0 }
    $0 ~ rec { inr = 1; line = $0; sub(rec, "", line); rect = line; print; next }
    $0 ~ ver {
      inr = 0; line = $0; sub(ver, "", line)
      if (tolower(trim(line)) == "ok") { print accepted(); next }
      pend = (trim(line) == ""); print; next
    }
    $0 ~ lab { inr = 0; pend = 0; print; next }
    {
      if (inr && trim($0) != "") rect = rect " " $0
      if (pend && trim($0) != "") { pend = 0; if (tolower(trim($0)) == "ok") { print accepted(); next } }
      print
    }
  ' "$1"
}

# answers_marked file — 0 when the last non-empty line is the **ANSWERED** marker
answers_marked() {
  awk -v done_re="$Q_ANSWERED_RE" 'NF { last = $0 } END { exit !(last ~ done_re) }' "$1"
}

# questions_note id file — puts the answering instructions under the title of a new questions file (once)
questions_note() {
  local id=$1 f=$2 note tmp action=resume
  [[ $id != *@* ]] || action=answer
  note="> Answer every question after **Verdict:** — \`ok\` accepts the recommendation. When you are done, put **ANSWERED** on the last line and save: the answers are sent at once (or run \`agent $action $id\`)."
  grep -qF -- '**ANSWERED** on the last line' "$f" && return 0
  # Callers may test our status, disabling errexit: propagate preparation failures explicitly.
  tmp=$(mktemp) || return 1
  if ! awk -v note="$note" 'NR == 1 && /^# / { print; print ""; print note; next } NR == 1 { print note; print "" } { print }' "$f" > "$tmp"; then
    rm -f -- "$tmp" || log_warn questions_note_cleanup_failed "path=$tmp"
    return 1
  fi
  # Rewrite in place so local question files keep the inode watched by the answer service.
  if ! cat "$tmp" > "$f"; then
    rm -f -- "$tmp" || log_warn questions_note_cleanup_failed "path=$tmp"
    return 1
  fi
  rm -f -- "$tmp"
}

# file_mtime file — the modification time with sub-second precision
file_mtime() {
  # GNU stat first; BSD/macOS stat rejects -c (that error is expected) and the BSD form is used instead
  stat -c %.9Y "$1" 2>/dev/null || stat -f %Fm "$1"
}

# questions_ready id file — a questions file now waits for the human: answering instructions, the time it was asked,
# the watch that sends the answers when the file is saved marked ANSWERED, and the editor
questions_ready() {
  local id=$1 f=$2
  questions_note "$id" "$f"
  meta_set "$id" QUESTIONS_MTIME "$(file_mtime "$f")"
  # A configured job receives its answers from the lead, through the same saved-answer handler.
  if [[ -n $(task_field "$id" JOB_ID) && ( -n $(task_field "$id" JOB_LEAD) || -n $LEAD_URL ) ]]; then return 0; fi
  watch_answers "$id" "$f"
  open_in_editor "$id" "$f"
}

# remote_identity qualified-id — sets REMOTE_NODE and REMOTE_TASK to validated path components.
remote_identity() {
  [[ -n $LEAD_LISTEN && $1 =~ ^([A-Za-z0-9][A-Za-z0-9._-]{0,127})@([A-Za-z0-9][A-Za-z0-9._-]{0,127})$ ]] || return 1
  REMOTE_TASK=${BASH_REMATCH[1]}; REMOTE_NODE=${BASH_REMATCH[2]}
}

# remote_question_context qualified-id — sets REMOTE_* for the current, assigned waiting mirror; 1 means stale.
remote_question_context() {
  local f n job
  remote_identity "$1" || return 1
  REMOTE_MIRROR="$BUS_DIR/remote/$REMOTE_NODE/$REMOTE_TASK"
  [[ -f $REMOTE_MIRROR/metadata.json && -f $BUS_DIR/jobs.json ]] || return 1
  job=$(jq -r '.JOB_ID // empty' "$REMOTE_MIRROR/metadata.json")
  if ! REMOTE_REPO=$(jq -er --arg job "$job" --arg node "$REMOTE_NODE" --arg task "$REMOTE_TASK" \
    '[.Jobs[] | select(.Request.ID==$job and .Node==$node and .TaskID==$task and .State=="waiting") | .Request.Repository] | select(length==1) | .[0]' "$BUS_DIR/jobs.json"); then return 1; fi
  REMOTE_ROUND=0
  for f in "$REMOTE_MIRROR"/questions-*.md; do
    [[ -f $f && ${f##*/} =~ ^questions-([1-9][0-9]{0,8})\.md$ ]] || continue
    n=${BASH_REMATCH[1]}
    if ((n > REMOTE_ROUND)); then REMOTE_ROUND=$n; fi
  done
  ((REMOTE_ROUND > 0)) || return 1
  REMOTE_DIR="$AGENTS_HOME/remote-questions/$REMOTE_NODE/$REMOTE_TASK"
  REMOTE_FILE="$REMOTE_DIR/questions-$REMOTE_ROUND.md"
}

# cmd__remote_questions qualified-id — schedules readiness without making sync wait for an editor or notifier.
cmd__remote_questions() {
  remote_question_context "${1:?}" || return 0  # metadata and artifacts can arrive in separate syncs
  local unit="agent-remote-questions-$REMOTE_TASK@$REMOTE_NODE"
  if systemctl --user is-active --quiet "$unit.service"; then return 0; fi
  systemd-run --user --quiet --collect --unit="$unit" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _remote_questions_ready "$1" 3>&- 7>&- 8>&- 9>&- 10>&- \
    || { log_warn remote_questions_start_failed "task=$1"; return 1; }
}

# cmd__remote_questions_ready qualified-id — its subshell owns the readiness lock until copy/watch setup ends.
cmd__remote_questions_ready() (
  local id=${1:?} marker tmp
  remote_question_context "$id" || return 0
  mkdir -p "$REMOTE_DIR"
  exec 7>"$REMOTE_DIR/ready.lock"
  flock -w 30 7 || { log_warn remote_questions_lock_failed "task=$id"; return 1; }
  remote_question_context "$id" || return 0
  if [[ ! -f $REMOTE_FILE ]]; then
    # Publish only the complete copy: readers must not see text before its answer instructions.
    tmp=$(mktemp "$REMOTE_DIR/.questions-$REMOTE_ROUND.XXXXXX") || return 1
    # Cleanup must still run if mktemp fails; try itself needs another temporary file.
    trap 'rm -f -- "$tmp" || log_warn remote_questions_cleanup_failed "path=$tmp"' EXIT
    awk '!/^> Answer every question after /' "$REMOTE_MIRROR/questions-$REMOTE_ROUND.md" > "$tmp" || return 1
    chmod 600 "$tmp" || return 1
    questions_note "$id" "$tmp" || return 1
    mv -fT -- "$tmp" "$REMOTE_FILE" || return 1
    trap - EXIT
  fi
  if ! systemctl --user is-active --quiet "agent-$id-answers-$REMOTE_ROUND.path"; then
    watch_answers "$id" "$REMOTE_FILE"
  fi
  marker="$REMOTE_DIR/questions-$REMOTE_ROUND.notified"
  if [[ ! -f $marker ]]; then
    open_in_editor "$id" "$REMOTE_FILE" 7>&-
    notify "$id" waiting "Questions file: $REMOTE_FILE" 7>&-
    touch "$marker"
  fi
)

# supervise_remote_questions retries readiness after a failed sync side effect or a lead restart.
supervise_remote_questions() {
  [[ -n $LEAD_LISTEN ]] || return 0
  local f dir task node
  for f in "$BUS_DIR"/remote/*/*/metadata.json; do
    [[ -f $f ]] || continue
    dir=${f%/*}; task=${dir##*/}; dir=${dir%/*}; node=${dir##*/}
    cmd__remote_questions_ready "$task@$node" || log_warn remote_questions_retry_failed "task=$task@$node"
  done
  # Editable files have the mirror's lifetime, including when the lead was down during retention cleanup.
  for dir in "$AGENTS_HOME"/remote-questions/*/*; do
    [[ -d $dir ]] || continue
    task=${dir##*/}; f=${dir%/*}; node=${f##*/}
    remote_identity "$task@$node" || continue
    if [[ ! -f $BUS_DIR/remote/$node/$task/metadata.json ]]; then
      rm -rf -- "$dir"
      log_info remote_questions_expired "task=$task@$node"
    fi
  done
}

# remote_answers_saved qualified-id round — queues complete edited answers even while the listener is offline.
remote_answers_saved() {
  local id=$1 round=$2 out
  remote_question_context "$id" || { log_warn remote_answer_stale "task=$id"; return 1; }
  [[ $round == "$REMOTE_ROUND" && -f $REMOTE_FILE ]] || return 1
  exec 8>"$REMOTE_DIR/answers.lock"
  flock -w 30 8 || { log_warn remote_answer_lock_failed "task=$id"; return 1; }
  answers_marked "$REMOTE_FILE" || return 0  # a draft save is not a send
  validate_answers "$REMOTE_FILE" || return 1
  if out=$(bus lead-answer --dir "$BUS_DIR" --ttl "${NODE_TTL_SEC}s" --node "$REMOTE_NODE" --task "$REMOTE_TASK" \
    --file "questions-$round.md" < "$REMOTE_FILE" 7>&- 8>&- 2>&1); then
    log_info remote_answer_queued "task=$id" "round=$round"
    stop_answers_watch "$id" "$round"
    echo "Answers queued for $id."
  else
    log_warn remote_answer_rejected "task=$id" "reason=$out"
    printf '%s\n' "$out" >&2
    return 1
  fi
}

# watch_answers id file — a systemd path unit runs `agent _answers_saved <id> <round>` whenever the file is saved
watch_answers() {
  local id=$1 f=$2 round
  round=${f##*/questions-}; round=${round%.md}
  systemd-run --user --quiet --collect --unit="agent-$id-answers-$round" \
    --path-property=PathModified="$f" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _answers_saved "$id" "$round" 3>&- 7>&- 8>&- 9>&- 10>&- \
    || log_error answers_watch_failed "task=$id" "file=$f"   # answering still works: agent resume <id>
}

# stop_answers_watch id round — removes the path unit of a questions file (if it still exists)
stop_answers_watch() {
  local unit="agent-$1-answers-$2.path"
  # a query: "inactive" and "no such unit" both mean there is nothing to stop
  systemctl --user is-active --quiet "$unit" || return 0
  try answers_watch_stop_failed systemctl --user stop "$unit"
}

# open_in_editor id file — opens a questions file in the VS Code window connected to this host, if there is one.
# A connected window leaves a socket (vscode-ipc-*.sock) and its server a remote CLI; sockets of closed windows stay
# behind and refuse connections, so the newest one that works is used.
open_in_editor() {
  [[ $QUESTIONS_EDITOR == vscode ]] || return 0
  local id=$1 f=$2 cli="" c d s out last=""
  for d in $VSCODE_SERVER_DIRS; do
    for c in "$d"/cli/servers/*/server/bin/remote-cli/* "$d"/bin/*/bin/remote-cli/*; do
      [[ -f $c && -x $c ]] || continue
      if [[ -z $cli || $c -nt $cli ]]; then cli=$c; fi
    done
  done
  [[ -n $cli ]] || return 0      # no VS Code server on this host
  local socks=() own=() fallback=() rundir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  for s in "$rundir"/vscode-ipc-*.sock; do   # this session's: where the server puts them
    if [[ -S $s && -O $s ]]; then own+=("$s"); socks+=("$s"); fi
  done
  if [[ $rundir != /tmp ]]; then
    for s in /tmp/vscode-ipc-*.sock; do      # other sessions' (or a server without XDG_RUNTIME_DIR)
      if [[ -S $s && -O $s ]]; then fallback+=("$s"); socks+=("$s"); fi
    done
  fi
  if ((${#socks[@]} == 0)); then
    log_info editor_not_connected "task=$id"
    return 0
  fi
  while IFS= read -r s; do
    if out=$(VSCODE_IPC_HOOK_CLI=$s timeout 10 "$cli" "$f" 2>&1); then
      log_info editor_opened "task=$id" "file=$f" "socket=$s"
      return 0
    fi
    last=$out
  done < <(   # this session's sockets before the other ones, each newest first
    {
      for s in "${own[@]}"; do printf '0 %s %s\n' "$(file_mtime "$s")" "$s"; done
      for s in "${fallback[@]}"; do printf '1 %s %s\n' "$(file_mtime "$s")" "$s"; done
    } | sort -k1,1n -k2,2rn | cut -d' ' -f3-)
  log_info editor_open_failed "task=$id" "file=$f" "error=$last"
}

# ------------------------------------------------------------------ prompts

render() { # template file → stdout, with {{KEY}} placeholders substituted from R
  local t; t=$(<"$1")
  local k
  for k in "${!R[@]}"; do t=${t//"{{$k}}"/${R[$k]}}; done
  printf '%s\n' "$t"
}

team_members_list() {
  [[ ${REMOTE_TEAM:-} != 1 ]] || { printf '%s' "(see team_status)"; return 0; }   # the team lives on the lead
  [[ -n ${TEAM:-} ]] || return 0
  local a out=()
  while read -r a; do
    [[ -n $a ]] && out+=("$a (${AGENT_TYPE[$a]:-?})")
  done < <(try peers_unavailable bus team-get --dir "$BUS_DIR" --team "$TEAM" | jq_soft peers_parse -r '.members[] | .agent')
  local IFS=,; printf '%s' "${out[*]}" | sed 's/,/, /g'
}

# ------------------------------------------------------------------ teams

# Exit codes of agentbus subcommands per error cause (ErrorCause.ExitCode in agentbus/errors.go).
BUS_NOT_FOUND=3
# BUS_PERMISSION is the typed Permission exit code used to reconcile a rejected node assignment.
BUS_PERMISSION=5
# BUS_STORAGE is the typed Storage exit code used to identify retryable local storage errors.
BUS_STORAGE=8

# team_json team — the team's JSON; nothing when the team does not exist (exit code BUS_NOT_FOUND), any
# other failure is logged.
team_json() {
  local errf rc=0 out
  errf=$(mktemp)
  out=$(bus team-get --dir "$BUS_DIR" --team "$1" 2>"$errf") || rc=$?
  if ((rc != 0 && rc != BUS_NOT_FOUND)); then
    log_warn team_read_failed "team=$1" "exit_code=$rc" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  printf '%s' "$out"
}
team_lead() { team_json "$1" | jq -r '.lead // empty'; }
team_done_flag() { team_json "$1" | jq -r '.done // false'; }

# pause_lock / pause_unlock — serializes a start's look at the pause with the pause and unpause of a team: a start
# either sees the team paused and waits, or runs before the pause stops it; none is lost between them (PAUSE_FD)
pause_lock() { exec {PAUSE_FD}>> "$AGENTS_HOME/.pause.lock" && flock "$PAUSE_FD"; }
pause_unlock() { exec {PAUSE_FD}>&-; }

# team_paused team — whether the human paused the team (agent pause): nothing of it starts until agent unpause
team_paused() { [[ -n ${1:-} && -f $AGENTS_HOME/paused/$1 ]]; }

# task_held task — whether the task belongs to a paused team: its own team, or the team of the task that asked for it
# (a worker's, an investigation's, a review's), up to three levels up
task_held() {
  local t=$1 i team
  for i in 1 2 3; do
    team=$(task_field "$t" TEAM)
    if [[ -n $team ]]; then team_paused "$team"; return; fi
    t=$(task_field "$t" PARENT_TASK)
    [[ -n $t ]] || return 1
  done
  return 1
}

# team_related_tasks team — the team's tasks, and the tasks they asked for (workers, investigations, reviews), one a line
team_related_tasks() {
  local -A related=()
  local t m p
  for t in $(team_tasks "$1"); do related[$t]=1; done
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    p=$(sed -n 's/^PARENT_TASK=//p' "$m")
    [[ -n $p && -n ${related[$p]:-} ]] || continue
    t=${m%/meta.env}; related[${t##*/}]=1
  done
  ((${#related[@]})) || return 0
  printf '%s\n' "${!related[@]}"
}
team_tasks() { team_json "$1" | jq -r '.members[]? | .task'; }

notify_send() { # file — delivers a notification file (first line = title/thread, rest = body). A failure is logged
  # and kept a day in $AGENTS_HOME/notify-failures.jsonl (notify_failure_keep): the dashboard counts them
  local f=$1 out rc=0 cmd
  if [[ -n $NOTIFY_CMD ]]; then
    cmd=$NOTIFY_CMD
    out=$($NOTIFY_CMD "$f" 2>&1) || rc=$?
  elif [[ -n $NOTIFY_SCRIPT ]]; then   # legacy: script run inside NOTIFY_DIR with the file name
    cmd=$NOTIFY_SCRIPT
    out=$(cd "$NOTIFY_DIR" && "$NOTIFY_SCRIPT" "${f##*/}" 2>&1) || rc=$?
  else
    return 0
  fi
  ((rc != 0)) || return 0
  log_warn notification_failed "exit_code=$rc" "command=$cmd ${f##*/}" "stderr=${out:0:300}"
  notify_failure_keep "$cmd" "exit $rc: $(tail -n 3 <<< "$out" | tr '\n' ' ' | cut -c1-300)"
  return 0
}

# notify_failure_keep command error — the failure, with this process's subcommand, kept a day in notify-failures.jsonl
# (older ones are left out on the way): a notification delivered by another process does not hide it
notify_failure_keep() {
  local f="$AGENTS_HOME/notify-failures.jsonl" now
  now=$(date +%s)
  (
    flock -w 10 9 || exit 1
    { if [[ -f $f ]]; then jq -c --argjson c "$((now - 86400))" 'select((.epoch // 0) > $c)' "$f"; fi
      jq -nc --arg at "$(date '+%Y-%m-%d %H:%M')" --argjson e "$now" --arg from "$AGENT_SUBCOMMAND" --arg command "$1" \
        --arg error "$2" '{at: $at, epoch: $e, from: $from, command: $command, error: $error}'; } > "$f.tmp.$$" \
      && mv "$f.tmp.$$" "$f"
  ) 9> "$f.lock" || log_warn notification_state_failed "file=$f"
}

# notice kind from to text [field=value ...] — publishes an event of this script on the bus (kinds: ScriptNotice in
# agentbus/events.go). Delivering it is a side effect of the calling step, so a failure is logged, not fatal.
notice() {
  local kind=$1 from=$2 to=$3 text=$4; shift 4
  local args=(--dir "$BUS_DIR" --from "$from" --to "$to" --notice "$kind") kv
  for kv in "$@"; do args+=(--field "$kv"); done
  try "notice_failed" bus send "${args[@]}" "$text" >/dev/null
  log_info notice_sent "notice=$kind" "to=$to"
}

push_text() { # repo line... — a notification outside the normal task cycle
  local repo=$1; shift
  mkdir -p "$NOTIFY_DIR"
  local f
  f="$NOTIFY_DIR/$(date +%Y%m%d-%H%M%S)-$RANDOM-summary.md"
  local icon
  icon=$(leading_icon "${1:-}")   # the icon its text starts with comes first in the title, seen at once
  { printf '%s\n' "${icon:+$icon }$repo"; printf '%s\n' "$@"; } > "$f"
  notify_send "$f"
}

team_summary() { # team — lines "agent: status (branch)"
  local t
  for t in $(team_tasks "$1"); do
    printf '  %s: %s (%s)\n' "$(task_field "$t" AGENT)" "$(task_field "$t" STATUS)" "$(task_field "$t" BRANCH)"
  done
}

# team_helpers_end team — the worker requests a finished team's tasks made (helper-list: "from <agent> (<task>)"):
# the queued and those under way are closed as failed — before their worker's task is stopped, so that no dispatch
# starts them again —, and the worker tasks still at work, paused or starting are stopped
team_helpers_end() {
  local team=$1 ids=" " t line hid st from wt hids=() hl
  for t in $(team_tasks "$team"); do ids+="$t "; done
  [[ $ids != " " ]] || return 0
  exec {hl}< <(bus helper-list --dir "$BUS_DIR" 2> /dev/null)   # a descriptor of its own: fd 3 may be another's
  while IFS= read -r line <&"$hl"; do   # first every request closed: none can start while the workers are stopped
    [[ $line =~ ^H([0-9]+)\ \[([a-z]+) ]] || continue
    hid=${BASH_REMATCH[1]}; st=${BASH_REMATCH[2]}
    [[ $st == queued || $st == starting || $st == running ]] || continue
    [[ $line =~ \ \(([^\)]+)\):\  ]] || continue
    from=${BASH_REMATCH[1]}
    [[ $ids == *" $from "* ]] || continue
    try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status failed \
      --summary "team $team finished: its request is no longer needed" < /dev/null
    hids+=("$hid")
    log_info team_helper_ended "team=$team" "request=H$hid"
  done
  exec {hl}<&-
  for hid in "${hids[@]}"; do   # then the worker tasks still at work, paused or starting
    for wt in $(grep -lx "HELPER_ID=$hid" "$TASKS"/*/meta.env 2> /dev/null | xargs -r -n1 dirname | xargs -r -n1 basename); do
      case $(task_field "$wt" STATUS) in
        running|paused|starting|new) "$SELF" stop "$wt" > /dev/null 2>&1 < /dev/null || log_warn team_helper_stop_failed "task=$wt" ;;
      esac
    done
  done
}

# coordinator_takeover team previous why — a member still in the team (normal, not out) takes over the role of a
# coordinator that is out: the first of AGENT_COORDINATOR_PREFER among them, else the first of them. The script
# claims the role for it (agentbus claim-lead) and wakes it with what happened; it prints the new coordinator, and
# nothing when no member is at work.
coordinator_takeover() {
  local team=$1 prev=$2 why=$3 next out
  local -a cands=()
  mapfile -t cands < <(team_json "$team" | jq -r --arg p "$prev" \
    '.members | to_entries[] | select(.key != $p and .value.tier != "worker" and ((.value.state // "") as $s | ["done", "stopped", "excluded", "hung"] | index($s) | not)) | .key')
  ((${#cands[@]})) || return 1
  next=$(preferred_coordinator "${cands[@]}")
  next=${next:-${cands[0]}}
  if ! out=$(bus claim-lead --dir "$BUS_DIR" --team "$team" --as "$next" 2>&1) || [[ $(team_lead "$team") != "$next" ]]; then
    log_warn coordinator_takeover_failed "team=$team" "member=$next" "reason=${out:0:300}"
    return 1
  fi
  log_info coordinator_takeover "team=$team" "coordinator=$next" "previous=$prev"
  try takeover_message_failed bus send --dir "$BUS_DIR" --from agent --to "$next" \
    "YOU ARE NOW THE COORDINATOR of team $team: $prev is out ($why). Read its last checkpoint, the board and the round's PR, give out the work that is left, and continue the round as its coordinator." > /dev/null
  echo "$next"
}

finish_team() { # team reason — closes the team; sleeping members finish as done
  rm -f "$AGENTS_HOME/paused/$1" || log_warn pause_clear_failed "team=$1"   # a finished team is not paused
  local team=$1 why=$2 t out
  [[ $(team_done_flag "$team") == true ]] && return 0
  log_info team_finished "team=$team" "reason=$why"
  bus team-done --dir "$BUS_DIR" --team "$team"
  team_helpers_end "$team"   # no worker goes on, or starts, with work nobody waits for
  for t in $(team_tasks "$team"); do   # remote members: their jobs end, their grants go
    [[ $(task_field "$t" KIND) == remote-member ]] || continue
    if ! out=$("$SELF" jobs --cancel "$(task_field "$t" JOB_ID)" 2>&1); then   # an ended job cannot be cancelled
      log_warn remote_member_cancel_failed "task=$t" "job=$(task_field "$t" JOB_ID)" "reason=${out:0:300}"
    fi
    try remote_member_revoke_failed bus lead-member --dir "$BUS_DIR" --remove --member "$(task_field "$t" AGENT)" >/dev/null
    meta_set "$t" STATUS done
  done
  for t in $(team_tasks "$team"); do
    if [[ $(task_field "$t" STATUS) == sleeping ]]; then
      meta_set "$t" STATUS done
      meta_set "$t" FINISHED "$(date -Is)"
      act "$t" info "■ $why"
    fi
    case $(task_field "$t" STATUS) in
      done|failed) bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$t" AGENT)" --state done >/dev/null ;;
      stopped) bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$t" AGENT)" --state stopped >/dev/null ;;
      excluded) bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$t" AGENT)" --state excluded >/dev/null ;;
    esac
  done
}

# ------------------------------------------------------------------ rounds (README "Rounds")

team_waits_on_others() { # team — does a member wait for a worker request or an investigation it asked for?
  local out
  out=$(bus team-waiting --dir "$BUS_DIR" --team "$1") || return 1   # cannot tell (bus logs why): check as before
  [[ $(jq_soft team_waiting_parse -r '.waiting | length' <<< "$out") -gt 0 ]] || return 1
  log_info team_waiting "team=$1" "for=$(jq_soft team_waiting_parse -r '.waiting | join("; ")' <<< "$out")"
}

round_limit() { # repository name → its hard round limit (0 = none)
  printf '%s' "${ROUND_MAX_LINES_REPO[$1]:-$ROUND_MAX_LINES}"
}

round_limit_text() { # repository name → the round limit as the prompt states it
  local hard; hard=$(round_limit "$1")
  if ((hard > 0)); then
    printf 'may change at most %s lines (aim for %s)' "$hard" "$(round_soft "$1")"
  else
    printf 'has no line limit in this repository (still: split a big task into rounds the human can review)'
  fi
}

round_soft() { # repository name → its soft limit (never above the hard one)
  local hard; hard=$(round_limit "$1")
  if ((hard > 0 && ROUND_SOFT_LINES > hard)); then printf '%s' "$hard"; else printf '%s' "$ROUND_SOFT_LINES"; fi
}

round_base_ref() { # id → the ref a task's change is measured against: origin/<base> (fetched first) or <base>
  local wt base; wt=$(task_field "$1" WORKTREE); base=$(task_field "$1" BASE)
  if git -C "$wt" remote get-url origin >/dev/null 2>&1; then   # a query: no origin = a repository without a remote
    try round_fetch_failed git -C "$wt" fetch --quiet origin "$base"
    if git -C "$wt" rev-parse --verify --quiet "origin/$base" >/dev/null; then printf 'origin/%s' "$base"; return 0; fi
  fi
  printf '%s' "$base"
}

# Skipped tests (docs/tdd.md "Skipped tests"): for each kind of test file, the statements that skip a test — a
# statement starts its line, so assertions, comments and strings that only mention a skip do not count, and code
# of another language inside a test (a heredoc, a fixture) is not read with this file's pattern. No backslashes:
# the patterns are also given to awk.
SKIP_GLOBS=('*_test.go' '*.bats' 'test_*.py' '*_test.py' '*.test.*' '*.spec.*' '*.rs')
SKIP_PATTERNS=(
  '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[.]Skip(f|Now)?[(]'
  '^[[:space:]]*skip([[:space:]]|$)'
  '^[[:space:]]*(@pytest[.]mark[.]skip|@unittest[.]skip|pytest[.]skip[(]|self[.]skipTest[(])'
  '^[[:space:]]*(@pytest[.]mark[.]skip|@unittest[.]skip|pytest[.]skip[(]|self[.]skipTest[(])'
  '^[[:space:]]*((it|test|describe)[.]skip[(]|x(it|describe)[(])'
  '^[[:space:]]*((it|test|describe)[.]skip[(]|x(it|describe)[(])'
  '^[[:space:]]*#[[]ignore'
)

skips_in_repo() { # worktree → its skipped tests, "file:line: statement", at most 30 (sed, not head: no SIGPIPE)
  local i
  for i in "${!SKIP_GLOBS[@]}"; do
    { git -C "$1" grep -nE "${SKIP_PATTERNS[i]}" -- ":(glob)**/${SKIP_GLOBS[i]}" || (($? == 1)); }
  done | sort -t: -k1,1 -k2,2n -u | sed -E 's/[[:space:]]+/ /g' | cut -c1-200 | sed -n '1,30p'
}

skips_added() { # id → the skips this task's change adds against its base, "file: statement"
  local wt base i
  wt=$(task_field "$1" WORKTREE); base=$(round_base_ref "$1")
  for i in "${!SKIP_GLOBS[@]}"; do
    git -C "$wt" diff -U0 --no-color --no-ext-diff "$base...HEAD" -- ":(glob)**/${SKIP_GLOBS[i]}" \
      | awk -v pat="${SKIP_PATTERNS[i]}" '/^\+\+\+ b\// { file = substr($0, 7); next }
          /^\+/ && !/^\+\+\+/ { line = substr($0, 2); if (line ~ pat) { gsub(/[[:space:]]+/, " ", line); print file ":" line } }'
  done | sort -u
}

pr_skipped_section() { # id → the "## Skipped tests" section of the description of the task's PR (empty: none)
  local pr body
  pr=$(try pr_lookup_failed trusted_prs "$(task_field "$1" REPO_ROOT)" "$(task_field "$1" BRANCH)" all body)
  body=$(jq_soft pr_body_parse -r '.[0].body // empty' <<< "${pr:-[]}")
  awk '/^#+[[:space:]]*Skipped tests/ { on = 1; next } on && /^#+[[:space:]]/ { on = 0 } on { print }' <<< "$body"
}

skip_note() { # id — the skipped tests of the task's repository, appended to every run's prompt (nothing if none; not
  # for investigators and helpers)
  case $(task_field "$1" KIND) in investigation|helper) return 0 ;; esac   # a helper does exactly what was asked
  local wt list
  wt=$(task_field "$1" WORKTREE)
  [[ -d $wt ]] || return 0
  list=$(skips_in_repo "$wt")
  [[ -n $list ]] || return 0
  printf '\n---\n\n## Skipped tests in this repository (%s)\n\n' "$(wc -l <<< "$list")"
  printf 'Fill every one whose functionality exists now, test first; a skip is never a placeholder (see "Test first").\n\n'
  sed -E 's/^([^:]+:[0-9]+):[[:space:]]*(.*)$/- `\1`: \2/' <<< "$list"
}

agent_desc() { # agent → "`name` (type, model `model`)" for attributions; an investigator from INVESTIGATORS_TYPE
  local type=${AGENT_TYPE[$1]:-${INVESTIGATORS_TYPE[$1]:-?}} model=${AGENT_MODEL[$1]:-${INVESTIGATORS_MODEL[$1]:-}}
  printf '`%s` (%s%s)' "$1" "$type" "${model:+, model \`$model\`}"
}

# agent_github_colors — "name=#RRGGBB …": the colour of every configured agent's name on GitHub (gh_colour_names), from
# AGENT_GITHUB_COLORS in the configuration's order, so that it stays the same in every round: the team agents
# (NORMAL_AGENTS, WORKER_AGENTS, then the others by name) and, apart, the investigators (by name)
agent_github_colors() {
  local palette=() names=() others=() a i out=""
  local -A listed=()
  [[ $AGENT_GITHUB_COLORS != none ]] || return 0
  read -ra palette <<< "$AGENT_GITHUB_COLORS"
  ((${#palette[@]})) || return 0
  mapfile -t others < <(printf '%s\n' "${!AGENT_TYPE[@]}" | sort)
  for a in "${NORMAL_AGENTS[@]}" "${WORKER_AGENTS[@]}" "${others[@]}"; do
    [[ -n $a ]] || continue
    [[ -z ${listed[$a]:-} ]] || continue
    listed[$a]=1; names+=("$a")
  done
  for i in "${!names[@]}"; do out+="${names[i]}=${palette[i % ${#palette[@]}]} "; done
  mapfile -t names < <(investigator_names)
  for i in "${!names[@]}"; do out+="${names[i]}=${palette[i % ${#palette[@]}]} "; done
  printf '%s' "${out% }"
}

# github_colour_register name... — gives each of those names that has no colour yet one of AGENT_GITHUB_COLORS in
# $AGENTS_HOME/github-colors ("name #RRGGBB" a line, kept for good, so that a name's colour never changes with the
# configuration's order): the palette's first colour no name has, else the one the fewest names have. Under the
# file's lock (runs start at once). A failure is logged: the names then get the configuration's order's colours.
github_colour_register() {
  local f="$AGENTS_HOME/github-colors" palette=()
  [[ $AGENT_GITHUB_COLORS != none ]] || return 0
  read -ra palette <<< "$AGENT_GITHUB_COLORS"
  ((${#palette[@]} && $#)) || return 0
  (
    flock -w 10 9 || exit 1
    local -A have=() uses=()
    local n c p best
    if [[ -f $f ]]; then
      while read -r n c; do
        [[ $n =~ ^[A-Za-z0-9._@-]+$ && $c =~ ^#[0-9A-Fa-f]{6}$ ]] || continue   # a line not ours: no colour from it
        have[$n]=$c; uses[$c]=$((${uses[$c]:-0} + 1))
      done < "$f"
    fi
    for n in "$@"; do
      [[ $n =~ ^[A-Za-z0-9._@-]+$ && -z ${have[$n]:-} ]] || continue
      best=""
      for p in "${palette[@]}"; do
        if [[ -z $best ]] || ((${uses[$p]:-0} < ${uses[$best]:-0})); then best=$p; fi
      done
      printf '%s %s\n' "$n" "$best" >> "$f" || exit 1
      have[$n]=$best; uses[$best]=$((${uses[$best]:-0} + 1))
    done
  ) 9>> "$f.lock" || log_warn github_colors_failed "file=$f"
}

# github_name_colors — "name=#RRGGBB …", the colours the agents' gh gives the names (AGENT_GITHUB_NAME_COLORS): those
# remembered in github-colors, then for every other configured agent its colour from the configuration's order
# (agent_github_colors); none = nothing
github_name_colors() {
  local f="$AGENTS_HOME/github-colors" n c e out=""
  local -A have=()
  [[ $AGENT_GITHUB_COLORS != none ]] || return 0
  if [[ -f $f ]]; then
    while read -r n c; do
      [[ $n =~ ^[A-Za-z0-9._@-]+$ && $c =~ ^#[0-9A-Fa-f]{6}$ && -z ${have[$n]:-} ]] || continue
      have[$n]=1; out+="$n=$c "
    done < "$f"
  fi
  for e in $(agent_github_colors); do [[ -n ${have[${e%%=*}]:-} ]] || out+="$e "; done
  printf '%s' "${out% }"
}

# run_github_names — the names a run can publish on GitHub, one a line: every investigator (a review's byline), the
# run's agent and, in a team, every agent of the team (the attribution's coordinator and members, from their task files)
run_github_names() {
  local m a
  investigator_names
  [[ -z ${AGENT:-} ]] || printf '%s\n' "$AGENT"
  [[ -n ${TEAM:-} ]] || return 0
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] && grep -qxF "TEAM=$TEAM" "$m" || continue
    a=$(sed -n 's/^AGENT=//p' "$m")
    [[ -z $a ]] || printf '%s\n' "$a"
  done
}

attribution_block() { # indent — the lines that end the description of a PR: the agent, or the team, its coordinator and its members
  local ind=$1 a
  printf '%sOpened by team-agents:\n' "$ind"
  if [[ -z ${TEAM:-} ]]; then
    printf '%s- agent: %s\n' "$ind" "$(agent_desc "$AGENT")"
    return 0
  fi
  printf '%s- team: `%s`\n' "$ind" "$TEAM"
  printf '%s- coordinator: %s\n' "$ind" "$(agent_desc "$AGENT")"
  # the members from their task files: they all exist before any run starts (the bus may not know them all yet)
  local m
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] && grep -qxF "TEAM=$TEAM" "$m" || continue
    a=$(sed -n 's/^AGENT=//p' "$m")
    if [[ -n $a && $a != "$AGENT" ]]; then printf '%s- member: %s\n' "$ind" "$(agent_desc "$a")"; fi
  done
}

round_check() { # id → what keeps a finished round from closing, one "- …" line each (empty: nothing)
  local id=$1 limit size lines out=""
  limit=$(round_limit "$(task_field "$id" REPO_NAME)")
  if ((limit > 0)); then
    if size=$(bus round-size --repo "$(task_field "$id" WORKTREE)" --base "$(round_base_ref "$id")" --exclude "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE" --json); then
      lines=$(jq -r .lines <<< "$size")
      if ((lines > limit)); then
        out+="- The change has $lines lines (+$(jq -r .added <<< "$size") -$(jq -r .deleted <<< "$size")): over the round limit of $limit (aim for $(round_soft "$(task_field "$id" REPO_NAME)"))."$'\n'
      fi
    else
      log_warn round_size_failed "task=$id"   # the size cannot be measured: the round is not held back for that
    fi
  fi
  # every skip the round adds must be listed, with its reason, in the PR description's "## Skipped tests" section
  local added section f missing=""
  added=$(skips_added "$id")
  if [[ -n $added ]]; then
    section=$(pr_skipped_section "$id")
    while read -r f; do
      [[ -n $f ]] || continue
      if ! grep -qF -- "${f##*/}" <<< "$section"; then missing+="  - $(grep -F -- "$f:" <<< "$added" | head -1)"$'\n'; fi
    done < <(cut -d: -f1 <<< "$added" | sort -u)
    if [[ -n $missing ]]; then
      out+="- Skipped tests added in this round are not listed in the PR description's \"## Skipped tests\" section (each with its reason) — or fill them instead:"$'\n'"$missing"
    fi
  fi
  printf '%s' "$out"
}

round_pr_url() { # id → the URL of the PR of the task's branch ("" when there is none)
  local pr
  pr=$(try pr_lookup_failed trusted_prs "$(task_field "$1" REPO_ROOT)" "$(task_field "$1" BRANCH)" all url)
  jq_soft pr_lookup_parse -r '.[0].url // empty' <<< "${pr:-[]}"
}

cmd_round_size() { # <task> — the size of a task's change and its round limits
  local id repo limit
  id=$(resolve_id "${1:?usage: agent round-size <task>}")
  repo=$(task_field "$id" REPO_NAME); limit=$(round_limit "$repo")
  bus round-size --repo "$(task_field "$id" WORKTREE)" --base "$(round_base_ref "$id")" --exclude "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE"
  if ((limit > 0)); then
    echo "limits: soft $(round_soft "$repo"), hard limit $limit lines (excluded from counting: $ROUND_EXCLUDE)"
  else
    echo "the repository $repo has no round limit"
  fi
}

last_team_id() { # the newest team of the repository in the current directory (outside one: the newest at all)
  local root="" m t best="" ; local -A teams=()
  if root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then   # fails outside a repository
    root=$(dirname "$root")
  fi
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    t=$(sed -n 's/^TEAM=//p' "$m")
    [[ -n $t ]] || continue
    if [[ -n $root && $(sed -n 's/^REPO_ROOT=//p' "$m") != "$root" ]]; then continue; fi
    teams[$t]=1
  done
  for t in $(printf '%s\n' "${!teams[@]}" | sort -r); do
    # a team the bus does not know was left by a resume that failed: the next older one is meant
    if bus team-get --dir "$BUS_DIR" --team "$t" >/dev/null 2>&1; then best=$t; break; fi
  done
  printf '%s' "$best"
}

# github_repo_url returns a canonical GitHub origin link, or empty for other/missing origins.
github_repo_url() {
  local url tail owner repo rc=0
  url=$(git -C "$1" remote get-url origin 2>&1) || rc=$?
  if ((rc == 2)); then return 0; fi # git reports a missing origin with exit 2
  if ((rc != 0)); then log_warn job_origin_lookup_failed "repository=$1" "exit=$rc" "reason=${url:0:300}"; return 0; fi
  case $url in
    https://github.com/*) tail=${url#https://github.com/} ;;
    git@github.com:*) tail=${url#git@github.com:} ;;
    ssh://git@github.com/*) tail=${url#ssh://git@github.com/} ;;
    *) return 0 ;;
  esac
  tail=${tail%.git}; owner=${tail%%/*}; repo=${tail#*/}
  if [[ $tail == */* && $owner =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ && $repo =~ ^[A-Za-z0-9_.-]{1,100}$ && $repo != . && $repo != .. ]]; then
    printf 'https://github.com/%s/%s' "$owner" "$repo"
  fi
}

github_owner() { # repository root → the owner of its GitHub origin ("" when origin is not on GitHub)
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 0   # no origin: no owner
  sed -nE 's#^(https://|git@|ssh://git@)github\.com[:/]([^/]+)/.*#\2#p' <<< "$url"
}

count_of() { # text words — the number next to the first of the words: "major 2", "major: 2", "major (2)" or "2 major"
  local n
  n=$({ grep -oiE "($2)[[:space:]]*[:=(]?[[:space:]]*[0-9]+" <<< "$1" || (($? == 1)); } | head -1 | grep -oE '[0-9]+$' || (($? == 1)))
  if [[ -z $n ]]; then
    n=$({ grep -oiE "[0-9]+[[:space:]]+($2)" <<< "$1" || (($? == 1)); } | head -1 | grep -oE '^[0-9]+' || (($? == 1)))
  fi
  echo "${n:-0}"
}

findings_count() { # text — the critical (blocker) + major problems a review reports, in any usual form: "critical 0,
  # major 2", "0 critical, 2 major", "**Major:** 2", "| Major | 2 |", "Major (2)" (Markdown emphasis and table bars
  # are dropped first)
  local plain
  plain=$(tr -d '*_`|' <<< "$1" | tr -s ' \t' '  ')
  echo $(( $(count_of "$plain" 'critical|blocker') + $(count_of "$plain" 'major') ))
}

review_verdict() { # text — the review's verdict (its last VERDICT line): ready-to-merge | needs-fixes | incomplete | nothing
  sed 's/[*`_]//g' <<< "$1" | { grep -oiE 'verdict:[[:space:]]*(ready-to-merge|needs-fixes|incomplete)' || (($? == 1)); } \
    | tail -1 | sed -E 's/^[^:]*:[[:space:]]*//' | tr '[:upper:]' '[:lower:]'
}

review_task_verdict() { # review-task final — its verdict; an old-style review (no VERDICT line) with critical or major
  # findings needs fixes; findings outweigh a "ready-to-merge"; nothing when the review gives no verdict
  local id=$1 text=$2 v n
  [[ ! -s $TASKS/$id/result.md ]] || text+=$'\n'$(cat "$TASKS/$id/result.md")
  v=$(review_verdict "$2"); [[ -n $v ]] || v=$(review_verdict "$text")
  n=$(findings_count "$text")
  if ((n > 0)) && [[ -z $v || $v == ready-to-merge ]]; then v=needs-fixes; fi
  printf '%s' "$v"
}

# the paths of test files (git pathspecs) in the languages the repositories use
TEST_PATHSPECS=(':(glob)**/*.bats' ':(glob)**/*_test.go' ':(glob)**/test_*.py' ':(glob)**/*_test.py'
  ':(glob)**/*.test.[jt]s' ':(glob)**/*.spec.[jt]s' ':(glob)**/tests/**/*.rs')

round_test_changes() { # repo base head — what a round did to the tests: "code=0|1 added=N changed=N" — code: a file
  # other than documentation changed; added: new test cases; changed: existing test files with lines taken away
  local repo=$1 base=$2 head=$3 f code=0 added changed
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    case $f in *.md|*.txt|*.rst|docs/*|LICENSE*) ;; *) code=1 ;; esac
  done < <(git -C "$repo" diff --name-only "$base" "$head")
  local plus minus diff rsdiff rsplus rsminus rstest
  diff=$(git -C "$repo" diff -U0 "$base" "$head" -- "${TEST_PATHSPECS[@]}" ':(exclude,glob)**/*.rs')
  plus=$({ grep -cE '^\+[[:space:]]*(@test |func Test|def test_|(it|test)\()' || (($? == 1)); } <<< "$diff")
  minus=$({ grep -cE '^-[[:space:]]*(@test |func Test|def test_|(it|test)\()' || (($? == 1)); } <<< "$diff")
  # Rust keeps its unit tests next to the code (#[cfg(test)] in src/): every .rs file counts, a test by its attribute —
  # #[test], #[tokio::test], #[tokio::test(...)], #[rstest], #[test_case(...)]
  rstest='#\[([A-Za-z_][A-Za-z0-9_]*::)*(test|rstest|test_case)(\]|\()'
  rsdiff=$(git -C "$repo" diff -U0 "$base" "$head" -- ':(glob)**/*.rs')
  rsplus=$({ grep -cE "^\+[[:space:]]*$rstest" || (($? == 1)); } <<< "$rsdiff")
  rsminus=$({ grep -cE "^-[[:space:]]*$rstest" || (($? == 1)); } <<< "$rsdiff")
  plus=$((plus + rsplus)); minus=$((minus + rsminus))
  added=$((plus > minus ? plus - minus : 0))   # a test whose declaring line changed is not a new one
  changed=$(git -C "$repo" diff --numstat "$base" "$head" -- "${TEST_PATHSPECS[@]}" | awk '$2 > 0 { n++ } END { print n + 0 }')
  printf 'code=%s added=%s changed=%s' "$code" "$added" "$changed"
}

# pr_body_with_round_size body block — the PR description with the round's size block (PR_SIZE_START...PR_SIZE_END)
# in place of the old one, or added at its end; the rest of the description as it was
pr_body_with_round_size() {
  local body=$1 block=$2
  if [[ $body == *"$PR_SIZE_START"*"$PR_SIZE_END"* ]]; then
    printf '%s%s%s' "${body%%"$PR_SIZE_START"*}" "$block" "${body#*"$PR_SIZE_END"}"
  elif [[ -z $body ]]; then
    printf '%s' "$block"
  else
    printf '%s\n\n%s' "$body" "$block"
  fi
}

# pr_body_with_task body block — the PR description with the task block (PR_TASK_START...PR_TASK_END) in place of the
# old one, or put first; the rest of the description as it was
pr_body_with_task() {
  local body=$1 block=$2
  if [[ $body == *"$PR_TASK_START"*"$PR_TASK_END"* ]]; then
    printf '%s%s%s' "${body%%"$PR_TASK_START"*}" "$block" "${body#*"$PR_TASK_END"}"
  elif [[ -z $body ]]; then
    printf '%s' "$block"
  else
    printf '%s\n\n%s' "$block" "$body"
  fi
}

# pr_body_without_task body — the PR description less the task block: the text the agents wrote, for the checks of
# their text (the task is the human's, written as it was given)
pr_body_without_task() {
  local body=$1
  if [[ $body == *"$PR_TASK_START"*"$PR_TASK_END"* ]]; then
    body="${body%%"$PR_TASK_START"*}${body#*"$PR_TASK_END"}"
    body=${body#"${body%%[![:space:]]*}"}
  fi
  printf '%s' "$body"
}

# pr_body_task_text body — the task text in a PR description's task block (without its heading); nothing without one
pr_body_task_text() {
  local body=$1
  [[ $body == *"$PR_TASK_START"*"$PR_TASK_END"* ]] || return 0
  body=${body#*"$PR_TASK_START"}; body=${body%%"$PR_TASK_END"*}
  awk '!started && /^[[:space:]]*$/ { next }            # the blank lines before the text
       !started && !headed && /^## Task$/ { headed = 1; next }   # its heading
       { started = 1; print }' <<< "$body"
}

# pr_task_block task — the task block of the task's text (its task.md) for its PR description, cut at
# PR_TASK_MAX_CHARS with a note; fails without the text
pr_task_block() {
  local text
  [[ -f $TASKS/$1/task.md ]] || return 1
  text=$(<"$TASKS/$1/task.md")
  if ((${#text} > PR_TASK_MAX_CHARS)); then
    text="${text:0:PR_TASK_MAX_CHARS}

… (cut at $PR_TASK_MAX_CHARS of ${#text} characters; the reviewers get the whole task)"
  fi
  printf '%s\n## Task\n\n%s\n%s' "$PR_TASK_START" "$text" "$PR_TASK_END"
}

# pr_write_task task root pr — writes the task first in its PR description, the description read again here (a write
# just before may have changed it). Nothing changes when it is there already; a failure is logged
pr_write_task() {
  local id=$1 root=$2 pr=$3 body block new
  if ! body=$(cd "$root" && gh pr view "$pr" --json body --jq .body); then
    log_warn pr_task_failed "task=$id" "pr=$pr" "error=gh pr view failed"
    return 0
  fi
  if ! block=$(pr_task_block "$id"); then
    log_warn pr_task_failed "task=$id" "pr=$pr" "error=the task has no task.md"
    return 0
  fi
  new=$(pr_body_with_task "$body" "$block")
  [[ $new != "$body" ]] || return 0
  if (cd "$root" && gh pr edit "$pr" --body "$new" > /dev/null); then
    log_info pr_task_written "task=$id" "pr=$pr"
  else
    log_warn pr_task_failed "task=$id" "pr=$pr" "error=gh pr edit failed"
  fi
}

# pr_write_round_size task root pr body — writes the round's size into its PR description (body: the description as
# read just before), counted as the round limit counts it: teams counted lines for their PRs by rules of their own
# and sent workers to recount them. Nothing changes when the size is the same; a failure is logged
pr_write_round_size() {
  local id=$1 root=$2 pr=$3 body=$4 json repo limit block new
  repo=$(task_field "$id" REPO_NAME); limit=$(round_limit "$repo")
  if ! json=$(bus round-size --json --repo "$(task_field "$id" WORKTREE)" --base "$(round_base_ref "$id")" \
      --exclude "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE" 2>&1); then
    log_warn pr_round_size_failed "task=$id" "pr=$pr" "error=$json"
    return 0
  fi
  if ! block=$(jq -r --arg s "$PR_SIZE_START" --arg e "$PR_SIZE_END" --arg soft "$(round_soft "$repo")" \
      --arg hard "$limit" --arg ex "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE" '[$s,
      "**Round size**, counted by the script as the round limit counts it: \(.lines) lines (+\(.added) -\(.deleted)) in \(.files) files"
      + (if ($hard | tonumber) > 0 then "; limits: soft \($soft), hard \($hard)" else "" end) + ". Not counted: \($ex).",
      $e] | join("\n")' <<< "$json" 2>&1); then
    log_warn pr_round_size_failed "task=$id" "pr=$pr" "error=$block"
    return 0
  fi
  new=$(pr_body_with_round_size "$body" "$block")
  [[ $new != "$body" ]] || return 0
  if (cd "$root" && gh pr edit "$pr" --body "$new" > /dev/null); then
    log_info pr_round_size_written "task=$id" "pr=$pr" "lines=$(jq -r .lines <<< "$json")"
  else
    log_warn pr_round_size_failed "task=$id" "pr=$pr" "error=gh pr edit failed"
  fi
}

# task_of_dir dir — the task whose worktree holds dir (the newest, when several had it); empty: none
task_of_dir() {
  local top m w r found=""
  top=$(git -C "$1" rev-parse --show-toplevel 2> /dev/null) || return 0
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    w=$(sed -n 's/^WORKTREE=//p' "$m"); r=$(sed -n 's/^REPO_ROOT=//p' "$m")
    # the repository's own checkout is nobody's worktree, though a task (an investigation team's) names it its own
    if [[ $w == "$top" && $w != "$r" ]]; then found=${m%/meta.env}; found=${found##*/}; fi
  done
  printf '%s' "$found"
}

# gate_holder field — a field of the gate lock's holder (label, task, dir, pid, pgid, start)
gate_holder() { sed -n "s/^$1=//p" "$AGENTS_HOME/gate.lock" 2> /dev/null | head -n 1; }
gate_holder_line() {
  local s; s=$(gate_holder start); [[ $s =~ ^[0-9]+$ ]] || s=$(date +%s)
  printf '%s of task %s in %s (pid %s), for %s min' "$(gate_holder label)" "$(gate_holder task)" "$(gate_holder dir)" \
    "$(gate_holder pid)" "$(( ($(date +%s) - s) / 60 ))"
}

# gate_busy_for task — whether a gate run of the task holds the machine's gate lock (its holder's agent gate still
# alive: the holder's line stays in gate.lock after the run) or waits in line for it (a place names its task)
gate_busy_for() {
  local id=$1 f pid
  pid=$(gate_holder pid)
  if [[ $(gate_holder task) == "$id" && $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2> /dev/null; then return 0; fi
  for f in "$AGENTS_HOME/gate.queue"/*; do
    [[ -f $f ]] || continue
    pid=${f##*-}
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2> /dev/null || continue
    [[ $(head -n 1 "$f" 2> /dev/null) == "$id" ]] && return 0
  done
  return 1
}

# gate_waiters — the live waiters' places in line for the gate lock (AGENTS_HOME/gate.queue: a file each, <start in
# ns>-<pid>), oldest first; a dead waiter's place is removed
gate_waiters() {
  local f pid
  for f in "$AGENTS_HOME/gate.queue"/*; do
    [[ -e $f ]] || continue
    pid=${f##*-}
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2> /dev/null; then
      printf '%s\n' "${f##*/}"
    else
      rm -f "$f"
    fi
  done
}

# gate_take_over — stops a gate run holding the lock past AGENT_GATE_STALE_MIN and takes the lock (status 0); 1: the
# holder is not stale
gate_take_over() {
  local start pg
  start=$(gate_holder start)
  [[ $start =~ ^[0-9]+$ ]] || start=$(stat -c %Y "$AGENTS_HOME/gate.lock")
  (($(date +%s) - start >= AGENT_GATE_STALE_MIN * 60)) || return 1
  echo "agent gate: $(gate_holder_line) — past $AGENT_GATE_STALE_MIN min, taken for hung: its run is stopped" >&2
  log_warn gate_lock_taken_over "holder=$(gate_holder task)" "pgid=$(gate_holder pgid)"
  pg=$(gate_holder pgid)
  if [[ $pg =~ ^[0-9]+$ ]] && ((pg > 1)); then
    kill -TERM -- "-$pg" 2> /dev/null || echo "agent gate: its process group $pg is gone already" >&2
    flock -w 10 "$GATE_FD" && return 0
    kill -KILL -- "-$pg" 2> /dev/null || echo "agent gate: its process group $pg is gone already" >&2
  fi
  flock -w 10 "$GATE_FD" && return 0
  die "the hung gate run did not let go of the lock; see: cat $AGENTS_HOME/gate.lock"
}

# gate_lock wait task dir — takes the machine's gate lock in turn (fd GATE_FD, inherited by the gate run, so it holds
# the lock while it runs): at once when free and nobody waits; busy or someone waiting: refuses with
# GATE_BUSY_MESSAGE, exit 75, or with wait=1 takes a place in line (AGENTS_HOME/gate.queue) and waits for its turn —
# the lock goes in turn, not to whoever retries when it is let go. The first in line stops a holder past
# AGENT_GATE_STALE_MIN minutes, taken for hung, and takes the lock over
gate_lock() {
  local wait=$1 task=$2 dir=$3 mine="" first n
  exec {GATE_FD}>> "$AGENTS_HOME/gate.lock" || die "cannot open $AGENTS_HOME/gate.lock"
  if ((wait)); then
    mkdir -p "$AGENTS_HOME/gate.queue" || die "cannot create $AGENTS_HOME/gate.queue"
    mine="$(date +%s%N)-$$"
    printf '%s\n' "$task" > "$AGENTS_HOME/gate.queue/$mine" || die "cannot take a place in $AGENTS_HOME/gate.queue"
  fi
  while :; do
    first=$(gate_waiters | head -n 1)
    if [[ -z $first || $first == "$mine" ]]; then
      flock -n "$GATE_FD" && break
      gate_take_over && break
    fi
    if ((wait == 0)); then
      n=$(gate_waiters | wc -l)
      if ((n > 0)); then
        printf '%s\n  %s waiting in line for it\n' "$GATE_BUSY_MESSAGE" "$n" >&2
      else
        printf '%s\n  holder: %s; taken for hung after %s min\n' "$GATE_BUSY_MESSAGE" "$(gate_holder_line)" \
          "$AGENT_GATE_STALE_MIN" >&2
      fi
      exit 75
    fi
    if [[ $first == "$mine" ]]; then
      flock -w 15 "$GATE_FD" && break
    else
      sleep 1
    fi
  done
  [[ -z $mine ]] || rm -f "$AGENTS_HOME/gate.queue/$mine"
  printf 'label=gate\ntask=%s\ndir=%s\npid=%s\npgid=\nstart=%s\n' "$task" "$dir" "$$" "$(date +%s)" \
    > "$AGENTS_HOME/gate.lock"
}
# gate_lock_pgid pgid — the run's process group into the holder, once started: written in place (never sed -i, which
# puts a new file in the lock's place — another run would lock that one while this run still holds the old)
gate_lock_pgid() {
  local holder
  holder=$(sed "s/^pgid=.*/pgid=$1/" "$AGENTS_HOME/gate.lock")
  printf '%s\n' "$holder" > "$AGENTS_HOME/gate.lock"
}
gate_unlock() { exec {GATE_FD}>&-; }

# gate_record task sha clean rc seconds command log — records a gate run in AGENTS_HOME/gates: the task's latest
# (<task>.json) and the machine's history (history.jsonl)
gate_record() {
  local rec
  mkdir -p "$AGENTS_HOME/gates" || { log_warn gate_record_failed "task=$1" "reason=cannot create the directory"; return 0; }
  rec=$(jq -nc --arg task "$1" --arg sha "$2" --argjson clean "$3" --argjson rc "$4" --argjson secs "$5" \
    --arg cmd "$6" --arg log "$7" --arg at "$(date -Is)" \
    '{task: $task, sha: $sha, clean: $clean, status: (if $rc == 0 then "pass" else "fail" end), exit: $rc,
      seconds: $secs, command: $cmd, log: $log, at: $at}')
  if ! printf '%s\n' "$rec" > "$AGENTS_HOME/gates/$1.json" || ! printf '%s\n' "$rec" >> "$AGENTS_HOME/gates/history.jsonl"; then
    log_warn gate_record_failed "task=$1"
  fi
  log_info gate_recorded "task=$1" "sha=$2" "clean=$3" "exit=$4"
}

# gate_refused task worktree — an agent's gate of its own uncommitted tree: what to do instead, and a line in the
# gates' history (status refused) — the task's last run, which gate-status and board_done read, stays as it was
gate_refused() {
  local id=$1 wt=$2 rec
  printf '%s\n' "gate: not run — the tree has uncommitted changes: a gate on them counts for nothing (board_done needs a" \
    "pass of a committed HEAD) and holds the machine for minutes. While you work, run single tests and the linter of" \
    "what you change; commit — remove what a build left (git status below) —, then run agent gate once." \
    "Uncommitted:" >&2
  git -C "$wt" status --porcelain | head -n 10 >&2
  rec=$(jq -nc --arg task "$id" --arg sha "$(git -C "$wt" rev-parse HEAD)" --arg at "$(date -Is)" \
    '{task: $task, sha: $sha, clean: false, status: "refused", reason: "an agent'"'"'s own uncommitted tree", at: $at}')
  mkdir -p "$AGENTS_HOME/gates" && printf '%s\n' "$rec" >> "$AGENTS_HOME/gates/history.jsonl" \
    || log_warn gate_record_failed "task=$id" "reason=the refusal could not be kept"
  log_info gate_refused "task=$id" "reason=uncommitted"
}

# gate_verdict task — whether the task's last recorded gate run is a pass of its HEAD on a clean tree; says why not
gate_verdict() {
  local id=$1 wt head rec sha clean status rc at
  wt=$(task_field "$id" WORKTREE)
  head=$(git -C "$wt" rev-parse HEAD 2> /dev/null) || { echo "task $id has no worktree"; return 1; }
  rec=$AGENTS_HOME/gates/$id.json
  if [[ ! -f $rec ]]; then echo "no gate run recorded for task $id (HEAD ${head:0:7}) — run: agent gate"; return 1; fi
  sha=$(jq -r .sha "$rec"); clean=$(jq -r .clean "$rec"); status=$(jq -r .status "$rec"); rc=$(jq -r .exit "$rec")
  at=$(jq -r .at "$rec")
  if [[ $sha != "$head" ]]; then
    echo "no gate run for HEAD ${head:0:7}: the last ($status) was of ${sha:0:7} — run: agent gate"; return 1
  fi
  if [[ $clean != true ]]; then
    echo "the last gate run of HEAD ${head:0:7} was on a tree not clean — commit, then run: agent gate"; return 1
  fi
  if [[ $status != pass ]]; then echo "FAIL at ${head:0:7} (exit $rc), $at — log: $(jq -r .log "$rec")"; return 1; fi
  echo "PASS at ${head:0:7} on a clean tree, $at — log: $(jq -r .log "$rec")"
}

# gate_task [task] — the task named, or the one whose worktree the current directory is in
gate_task() {
  local id
  if [[ -n ${1:-} ]]; then resolve_id "$1"; return; fi
  id=$(task_of_dir "$PWD")
  [[ -n $id ]] || die "not in a task's worktree: name the task (agent gate <task>)"
  printf '%s' "$id"
}

# cmd_gate [task] [--wait] — runs the repository's gate (review_gate_cmd: as the precheck) in the task's worktree,
# one run at a time on the machine, and records the commit, the tree's cleanliness and the result: a claimed gate
# result can be checked (agent gate-status). Its output's end, then the verdict; exit: the gate's
cmd_gate() {
  local id="" wait=0 a wt gate sha clean=true rc=0 log start child
  for a in "$@"; do case $a in --wait) wait=1 ;; *) id=$a ;; esac; done
  id=$(gate_task "$id")
  wt=$(task_field "$id" WORKTREE)
  [[ -d $wt ]] || die "task $id has no worktree"
  gate=$(review_gate_cmd "$wt" "$(round_base_ref "$id")")
  [[ -n $gate ]] || die "the repository has no gate (AGENT_REVIEW_GATE=$AGENT_REVIEW_GATE)"
  # an agent's gate of its own task on uncommitted work counts for nothing (board_done needs a pass of a committed
  # HEAD) and holds the machine for minutes: refused, with what to do — a human's, or another task's, runs
  # a merge in progress excepted: a coordinator checks the tree it merged before it commits the merge
  if [[ ${AGENT_RUN_TASK:-} == "$id" && -n $(git -C "$wt" status --porcelain) ]] \
    && ! git -C "$wt" rev-parse -q --verify MERGE_HEAD > /dev/null; then
    gate_refused "$id" "$wt"
    return 2
  fi
  gate_lock "$wait" "$id" "$wt"
  sha=$(git -C "$wt" rev-parse HEAD)
  [[ -z $(git -C "$wt" status --porcelain) ]] || clean=false
  mkdir -p "$AGENTS_HOME/gates" || die "cannot create $AGENTS_HOME/gates"
  log=$AGENTS_HOME/gates/$id-$(date +%Y%m%d-%H%M%S).log
  start=$(date +%s)
  set -m   # the run in its own process group: a hung one is stopped whole, the agent's shell around it is not
  # AGENT_GATE_RUN: the repository's gate knows it runs inside agent gate (a tool of its own that would send its
  # gate through agent gate runs it as it is)
  (cd "$wt" && AGENT_GATE_RUN=$id exec timeout "${AGENT_REVIEW_GATE_MIN}m" bash -c "$gate") < /dev/null > "$log" 2>&1 &
  child=$!
  set +m
  gate_lock_pgid "$child"
  trap 'kill -TERM -- "-$child" 2> /dev/null; exit 143' INT TERM HUP
  wait "$child" || rc=$?
  trap - INT TERM HUP
  gate_unlock
  tail -n 60 "$log"
  if ((rc == 75)) && grep -qF "$GATE_BUSY_MESSAGE" "$log"; then   # the repository's own lock: not a result
    echo "gate: not run — the repository's own test lock is busy; nothing recorded"
    return 75
  fi
  gate_record "$id" "$sha" "$clean" "$rc" "$(($(date +%s) - start))" "$gate" "$log"
  echo "gate: $( ((rc == 0)) && echo PASS || echo "FAIL (exit $rc)") at ${sha:0:7}$([[ $clean == true ]] || echo ", tree not clean: not a pass of HEAD") — recorded; full log: $log"
  return "$rc"
}

# cmd__board_done_check task — the bus asks before a local agent submits an item's result (board_done): exit 0 yes;
# exit 3 no — its work changed code since its round's base and no gate pass of its HEAD on a clean tree is recorded
# (what to do on stdout). Any other exit is no answer: the bus lets the result through, logged.
cmd__board_done_check() {
  local id=${1:?usage: agent _board_done_check <task>} wt gate base tc verdict
  wt=$(task_field "$id" WORKTREE)
  if [[ ! -d $wt ]]; then echo "no worktree: not checked"; return 0; fi
  base=$(round_base_ref "$id")
  gate=$(review_gate_cmd "$wt" "$base" HEAD)
  if [[ -z $gate ]]; then echo "the repository has no gate: not checked"; return 0; fi
  if ! tc=$(round_test_changes "$wt" "$base" HEAD); then echo "cannot compare with the round's base: not checked"; return 0; fi
  if [[ $tc != code=1* ]]; then echo "no change of code: no gate needed"; return 0; fi
  if verdict=$(gate_verdict "$id"); then echo "$verdict"; return 0; fi
  echo "This item's work changes code: its gate must pass at your HEAD before you submit it — $verdict."
  echo "Run \`agent gate\` in your worktree (commit first), then board_done again. If the gate fails for a reason outside"
  echo "your work (a flaky test, a broken tool), submit with gate_exception: <why> — the result is then marked not verified."
  log_info board_done_refused "task=$id"
  return 3
}

# cmd_gate_status [task] — whether the task's last recorded gate run is a pass of its HEAD on a clean tree (exit 0)
cmd_gate_status() {
  local id
  id=$(gate_task "${1:-}")
  gate_verdict "$id"
}

# team_lineage team — the team and the teams it was resumed from, newest first: a resume makes a new team of new
# tasks whose RESUMED_FROM names the old team's tasks (a member the resume added names none)
team_lineage() {
  local team=$1 m tid prev n=0
  local -A visited=()
  while [[ -n $team && -z ${visited[$team]:-} ]] && ((n++ < 100)); do
    visited[$team]=1
    printf '%s\n' "$team"
    prev=""
    while IFS= read -r m; do
      tid=${m%/meta.env}; tid=${tid##*/}
      prev=$(task_field "$tid" RESUMED_FROM)
      [[ -z $prev ]] || break
    done < <(grep -lx -- "TEAM=$team" "$TASKS"/*/meta.env 2> /dev/null)
    [[ -n $prev && -d $TASKS/$prev ]] || return 0
    team=$(task_field "$prev" TEAM)
  done
}

# team_allowed_paths team — the paths the human allowed a team to change against AGENTS.md's rules (agent allow):
# allowed to the team or to a team it was resumed from — a resume keeps the human's allowances, also one given to the
# old team after the resume (the precheck names the team of the round it checked)
team_allowed_paths() {
  local t
  while IFS= read -r t; do
    [[ -f $AGENTS_HOME/allowed/$t ]] && cat "$AGENTS_HOME/allowed/$t"
  done < <(team_lineage "$1")
  return 0
}

# rule_test_path / rule_judge_path / rule_production_path path — what a path is to the rule gates: a test (tests/**,
# *_test.go, *.bats); a file that judges a round; production code (bin/, agent/, agentbus/, live/, not a test)
rule_test_path() { [[ $1 == tests/* || $1 == *_test.go || $1 == *.bats ]]; }
rule_judge_path() {
  case $1 in
    .golangci.yml | tools/gate.sh | tools/check-*.sh | tools/agent-bats.sh | tools/test-lock.sh | Makefile) return 0 ;;
    .github/workflows/* | AGENTS.md | */AGENTS.md | CLAUDE.md | */CLAUDE.md) return 0 ;;
  esac
  return 1
}
rule_production_path() { [[ ($1 == bin/* || $1 == agent/* || $1 == agentbus/* || $1 == live/*) ]] && ! rule_test_path "$1"; }

# rule_path_matches path pattern... — whether a path matches one of the patterns as ROUND_EXCLUDE's do: "name/" a
# directory of that name on its way, a pattern with a slash the whole path, any other the file's name
rule_path_matches() {
  local f=$1 p dir
  shift
  dir=$(dirname "$f")
  for p in "$@"; do
    case $p in
      */) [[ /$dir/ == *"/$p"* ]] && return 0 ;;
      */*)
        # shellcheck disable=SC2053  # $p is unquoted on purpose: a pattern is a glob, as round-size's
        [[ $f == $p ]] && return 0
        ;;
      *)
        # shellcheck disable=SC2053  # $p is unquoted on purpose: a pattern is a glob, as round-size's
        [[ ${f##*/} == $p ]] && return 0
        ;;
    esac
  done
  return 1
}

# round_rule_issues repo base head team body — what a round's own diff (base: its merge base with main) does against
# AGENTS.md's rules, one a line. "human: ..." only the human may allow (agent allow <team> <path>); "disclose: ..." a
# suppression the PR description (body) does not name. Prompts and reviewers held these rules alone before.
#   B1 an existing test file changed (not whitespace), removed or renamed; tests added to it, new files, are fine
#   B2 an added lint suppression (Go, shell, Python, TS/JS, Rust) in a file the description does not name; skipped
#      tests are round_check's (the PR's "## Skipped tests" section)
#   B3 production code that looks at whether it runs under test
#   B4 a file that judges a round changed (the Makefile and checks: added to is fine; workflows, AGENTS.md: any change)
round_rule_issues() {
  local repo=$1 base=$2 head=$3 team=$4 body=$5 allowed st a b f del line file n text
  local -a test_data excluded
  read -r -a test_data <<< "$RULE_TEST_DATA"                            # data under a test directory: no tests
  read -r -a excluded <<< "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE"        # what the round's size leaves out
  allowed=$(team_allowed_paths "$team")
  while IFS=$'\t' read -r st a b; do
    [[ -n $st ]] || continue
    f=$a
    grep -qxF -- "$f" <<< "$allowed" && continue
    if ((${#test_data[@]})) && rule_test_path "$f" && rule_path_matches "$f" "${test_data[@]}"; then continue; fi
    if rule_test_path "$f" || { rule_judge_path "$f" && [[ $f != .github/* && $f != AGENTS.md && $f != */AGENTS.md && $f != CLAUDE.md && $f != */CLAUDE.md ]]; }; then
      case $st in
        D) echo "human: $f — an existing $(rule_test_path "$f" && echo test || echo check) file deleted" ;;
        R*) echo "human: $f — an existing $(rule_test_path "$f" && echo test || echo check) file renamed to $b" ;;
        M)
          del=$(git -C "$repo" diff -w --numstat "$base" "$head" -- "$f" | awk '{print $2}')
          if [[ ${del:-0} =~ ^[0-9]+$ ]] && ((del > 0)); then
            echo "human: $f — $del line(s) of an existing $(rule_test_path "$f" && echo test || echo check) file changed or removed"
          fi
          ;;
      esac
    elif rule_judge_path "$f"; then   # workflows, AGENTS.md, CLAUDE.md: any change
      echo "human: $f — changed ($st); AGENTS.md: never change it"
    fi
  done < <(git -C "$repo" diff --name-status -M "$base" "$head")
  file="" n=0
  while IFS= read -r line; do
    case $line in
      '+++ /dev/null') file="" ;;
      '+++ b/'*) file=${line#+++ b/} ;;
      '@@ '*) if [[ $line =~ ^@@\ -[0-9,]+\ \+([0-9]+) ]]; then n=${BASH_REMATCH[1]}; fi ;;
      '+'*)
        [[ -n $file ]] || continue
        text=${line:1}
        if ! grep -qxF -- "$file" <<< "$allowed"; then
          if rule_production_path "$file" && [[ $text =~ (testing\.Testing\(\)|flag\.Lookup\(\"test\.|BATS_[A-Z_]+) ]]; then
            echo "human: $file:$n — production code that looks at whether it runs under test (${BASH_REMATCH[1]})"
          fi
          # lint suppressions (skipped tests are round_check's: the PR's "## Skipped tests" section) — in code: not
          # in a document, nor in what the round's size leaves out (reports, generated or vendored files)
          if [[ $body != *"$file"* && $file != *.md && $file != *.txt ]] && ! rule_path_matches "$file" "${excluded[@]}"; then
            if [[ $text =~ //[[:space:]]*nolint ]]; then
              echo "disclose: $file:$n — nolint"
            elif [[ $text =~ \#[[:space:]]*nosec ]]; then
              echo "disclose: $file:$n — nosec"
            elif [[ $text =~ \#[[:space:]]*shellcheck[[:space:]]+disable= ]]; then
              echo "disclose: $file:$n — shellcheck disable"
            elif [[ $text =~ \#[[:space:]]*noqa ]]; then
              echo "disclose: $file:$n — noqa"
            elif [[ $text =~ \#[[:space:]]*type:[[:space:]]*ignore ]]; then
              echo "disclose: $file:$n — type: ignore"
            elif [[ $text =~ @ts-(ignore|expect-error|nocheck) ]]; then
              echo "disclose: $file:$n — ts-${BASH_REMATCH[1]}"
            elif [[ $text =~ eslint-disable ]]; then
              echo "disclose: $file:$n — eslint-disable"
            elif [[ $text =~ ^[[:space:]]*\#!?\[allow\( ]]; then
              echo "disclose: $file:$n — allow (Rust)"
            fi
          fi
        fi
        n=$((n + 1))
        ;;
    esac
  done < <(git -C "$repo" diff -U0 "$base" "$head")
  return 0
}

# gh_coordinator task — the coordinator of the task's team when the task is one of its members and not the
# coordinator itself (the agents' gh refuses such a task's gh pr create); empty for anyone else: a coordinator, a
# solo task, an investigator, or a team whose coordinator the bus does not say
gh_coordinator() {
  local id=$1 team lead
  team=$(task_field "$id" TEAM 2> /dev/null)
  [[ -n $team && $(task_field "$id" KIND 2> /dev/null) != investigation* ]] || return 0
  lead=$(team_lead "$team" 2> /dev/null) || return 0
  [[ -z $lead || $lead == "$(task_field "$id" AGENT)" ]] || echo "$lead"
}

# agents_gh_env — the agents' CLI gets this script as its gh (a link named gh, first on its PATH: agent_gh): text on GitHub reaches it only from
# the trusted accounts. AGENT_REAL_GH is the real gh; without gh there is nothing to put in front of
agents_gh_env() {
  local real dir="$AGENTS_HOME/run/gh-trusted"
  real=$(command -v gh) || { log_warn agents_gh_missing "task=${RUNNER_ID:-}"; return 0; }
  [[ $real != "$dir/gh" ]] || real=${AGENT_REAL_GH:-}   # set already in this process
  [[ -n $real ]] || return 1
  mkdir -p "$dir" || return 1
  if [[ $(readlink "$dir/gh") != "$SELF" ]]; then   # agent run as gh is the filter (agent_gh)
    # replaced in one step (a rename), never missing: runs that start at once (a review pair's) do this together
    if ! { ln -s "$SELF" "$dir/gh.$BASHPID" && mv -Tf "$dir/gh.$BASHPID" "$dir/gh"; }; then
      rm -f "$dir/gh.$BASHPID"
      return 1
    fi
  fi
  AGENT_GH_COORDINATOR=$(gh_coordinator "${RUNNER_ID:-}")   # a team member's: its PR commands are refused
  AGENT_GH_OWN_PR=$(gh_own_pr "${RUNNER_ID:-}")              # a task's own PR: no second one while it is open
  AGENT_GH_TEAM="" AGENT_GH_SELF="" AGENT_GH_BUS_DIR=$BUS_DIR   # a team task's: whom the bus names coordinator, at the call
  if [[ -n ${RUNNER_ID:-} && $(task_field "$RUNNER_ID" KIND) != investigation* ]]; then
    AGENT_GH_TEAM=$(task_field "$RUNNER_ID" TEAM)
    [[ -z $AGENT_GH_TEAM ]] || AGENT_GH_SELF=$(task_field "$RUNNER_ID" AGENT)
  fi
  export AGENT_REAL_GH=$real AGENT_GITHUB_TRUSTED_RESOLVED AGENT_REVIEW_BYLINE="" AGENT_GITHUB_COLORS AGENT_GH_COORDINATOR \
    AGENT_GH_TEAM AGENT_GH_SELF AGENT_GH_BUS_DIR AGENTBUS_BIN AGENT_GH_OWN_PR
  local names=()
  mapfile -t names < <(run_github_names)
  github_colour_register "${names[@]}"
  AGENT_GITHUB_NAME_COLORS=$(github_name_colors)
  export AGENT_GITHUB_NAME_COLORS
  if [[ $(task_field "${RUNNER_ID:-}" KIND 2>/dev/null) == investigation ]]; then   # its reviews say who wrote them, first
    AGENT_REVIEW_BYLINE=$(review_byline "$RUNNER_ID")
  fi
  AGENT_GITHUB_TRUSTED_RESOLVED=$(github_trusted "${REPO_ROOT:-.}")
  [[ :$PATH: == *":$dir:"* ]] || export PATH="$dir:$PATH"
}

# review_byline task — who wrote an investigator's review: its first line on GitHub (put there by the agents' gh), and
# its last (the review prompt's signature)
review_byline() {
  local model
  model=$(task_field "$1" MODEL)
  printf 'Review by the team-agents investigator `%s` (%s%s), request #%s.' "$(task_field "$1" AGENT)" "$(task_field "$1" TYPE)" \
    "${model:+, model $model}" "$(task_field "$1" INV_ID)"
}

# github_trusted root — the GitHub accounts whose PRs and texts the round trusts, space-separated: AGENT_GITHUB_TRUSTED,
# or by default the repository's owner and the account gh is logged in as (the agents')
github_trusted() {
  if [[ -n ${AGENT_GITHUB_TRUSTED:-} ]]; then printf '%s' "$AGENT_GITHUB_TRUSTED"; return 0; fi
  if [[ -z ${GH_LOGIN_CACHE:-} ]]; then   # one question to GitHub per process; none answered: only the owner
    GH_LOGIN_CACHE=$(cd "$1" 2>/dev/null && gh api user --jq .login 2>/dev/null) || GH_LOGIN_CACHE=""
  fi
  printf '%s %s' "$(github_owner "$1")" "$GH_LOGIN_CACHE"
}

# trusted_prs root branch state fields — the round's PRs of that branch, newest first, as a JSON array: from this
# repository (a fork's PR with the same branch name is not — the agents' branch names are public) and opened by a
# trusted account (github_trusted); the others are logged (pr_untrusted_ignored) and left out
trusted_prs() {   # (an empty branch: every branch's PRs)
  local root=$1 branch=$2 state=$3 fields out trusted ignored head_opt=()
  [[ -z $branch ]] || head_opt=(--head "$branch")
  fields=$(printf '%s,number,isCrossRepository,headRepositoryOwner,author' "$4" | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -)
  out=$(cd "$root" && gh pr list "${head_opt[@]}" --state "$state" --json "$fields" --limit "$( [[ -n $branch ]] && echo 20 || echo 100)") || return 1
  trusted=$(github_trusted "$root" | jq -R 'split(" ") | map(select(. != ""))')
  local owner; owner=$(github_owner "$root")   # its head in this repository: not a fork's, whatever GitHub's flag says
  ignored=$(jq -r --argjson t "$trusted" --arg o "$owner" '[.[] | select((.isCrossRepository // false) or ($o != "" and (.headRepositoryOwner.login // $o) != $o)
            or ((.author.login // "") as $a | ($t | index($a)) == null))
            | "#\(.number) (\(.author.login // "?"))"] | join(", ")' <<< "$out")
  [[ -z $ignored ]] || log_warn pr_untrusted_ignored "branch=$branch" "prs=$ignored" "trusted=$(jq -r 'join(" ")' <<< "$trusted")"
  jq -c --argjson t "$trusted" --arg o "$owner" '[.[] | select((.isCrossRepository // false) == false and ($o == "" or (.headRepositoryOwner.login // $o) == $o)
            and ((.author.login // "") as $a | ($t | index($a)) != null))]' <<< "$out"
}

# round_pr_for task fields — the round's PR of a coordinator's task, as trusted_prs gives it (a JSON array, [] for
# none): the PR of its branch; else the round's PR it was given (ROUND_PR), open; else an open PR whose head is its
# branch's commit — a team that pushed its work to another team's PR. How it was found is logged.
round_pr_for() {
  local id=$1 fields=$2 root branch pr num sha
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH)
  pr=$(trusted_prs "$root" "$branch" all "$fields") || return 1
  [[ $(jq 'length' <<< "$pr") == 0 ]] || { printf '%s' "$pr"; return 0; }
  num=$(task_field "$id" ROUND_PR)
  if [[ -n $num ]]; then
    pr=$(trusted_prs "$root" "" open "$fields,number" | jq -c --argjson n "$num" '[.[] | select(.number == $n)]') || return 1
    if [[ $(jq 'length' <<< "$pr") != 0 ]]; then
      log_info round_pr_found "task=$id" "pr=$num" "by=round_pr"
      printf '%s' "$pr"; return 0
    fi
  fi
  sha=$(git -C "$root" rev-parse --verify --quiet "refs/heads/$branch^{commit}") || { echo '[]'; return 0; }
  pr=$(trusted_prs "$root" "" open "$fields,headRefOid" | jq -c --arg s "$sha" '[.[] | select(.headRefOid == $s)]') || return 1
  [[ $(jq 'length' <<< "$pr") == 0 ]] || log_info round_pr_found "task=$id" "pr=$(jq -r '.[0].number' <<< "$pr")" "by=commit" "sha=$sha"
  printf '%s' "$pr"
}

pr_format_issues() { # body [repo-url] — what a PR description writes against the GitHub conventions, one item per
  # line: a commit or a PR in code format without a link (GitHub links neither inside backticks), a code block that
  # does not name its language, RED or GREEN as plain words. Nothing inside code blocks is checked.
  local body=$1 url=${2:-https://github.com/<owner>/<repo>} line fence=0 lang rest m
  local re_sha='(^|[^[])`([0-9a-f]{7,40})`(.*)$' re_pr='(^|[^[])`#([0-9]+)`(.*)$' re_tdd='(^|[^a-zA-Z{])(\*\*)?(RED|GREEN)(\*\*)?:'
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*\`\`\`(.*)$ ]]; then
      if ((fence)); then fence=0; continue; fi
      fence=1
      lang=${BASH_REMATCH[1]//[[:space:]]/}
      [[ -n $lang ]] || printf 'a code block without its language: open it with ```go, ```bash, ```json…\n'
      continue
    fi
    ((fence == 0)) || continue
    rest=$line
    while [[ $rest =~ $re_sha ]]; do
      m=${BASH_REMATCH[2]}; rest=${BASH_REMATCH[3]}
      [[ $m == *[a-f]* ]] || continue   # digits only: a number, not a commit
      printf 'commit `%s` without a link: write [`%s`](%s/commit/<its full SHA>)\n' "$m" "${m:0:7}" "$url"
    done
    rest=$line
    while [[ $rest =~ $re_pr ]]; do
      m=${BASH_REMATCH[2]}; rest=${BASH_REMATCH[3]}
      printf 'PR `#%s` without a link: write [#%s](%s/pull/%s)\n' "$m" "$m" "$url" "$m"
    done
    if [[ $line =~ $re_tdd && $line != *'\color'* ]]; then
      printf '%s as a plain word: write $\\color{red}{\\textbf{RED}}$ and $\\color{green}{\\textbf{GREEN}}$ (bold, in colour)\n' "${BASH_REMATCH[3]}"
    fi
  done <<< "$body"
}

merge_blockers() { # repo base head round-tests — what keeps --autopilot from merging by itself, one reason per line
  local repo=$1 base=$2 head=$3 tests=$4 f p changed
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    for p in $AUTO_MERGE_HUMAN_PATHS; do
      # shellcheck disable=SC2053  # $p is unquoted on purpose: a pattern may be a glob
      if [[ $p == */ && $f == "$p"* ]] || [[ $p != */ && $f == $p ]]; then
        printf 'it touches %s (AUTO_MERGE_HUMAN_PATHS)\n' "$f"
        break
      fi
    done
  done < <(git -C "$repo" diff --name-only "$base" "$head")
  changed=$(sed -n 's/.*changed=\([0-9]*\).*/\1/p' <<< "$tests")
  if [[ $AUTO_MERGE_HOLD_TEST_CHANGES == yes ]] && ((${changed:-0} > 0)); then
    printf 'it changes existing tests (%s file(s)): only you may allow that\n' "$changed"
  fi
}

gate_at() { # repo rev log [from] — runs the repository's gate at a revision in a temporary worktree; its exit status (0
  # when the repository has no gate). With from, the gate of the change from...rev (review_gate_cmd)
  local repo=$1 rev=$2 log=$3 from=${4:-} gate wt rc=0
  gate=$(review_gate_cmd "$repo" "$from" "${from:+$rev}")
  [[ -n $gate ]] || return 0
  wt=$(mktemp -d)
  git -C "$repo" worktree add -q --detach "$wt" "$rev" 10>&- || { rmdir "$wt"; echo "cannot check out $rev" > "$log"; return 1; }
  (cd "$wt" && AGENT_GATE_RUN=$rev timeout "${AGENT_REVIEW_GATE_MIN}m" bash -c "$gate") > "$log" 2>&1 10>&- || rc=$?
  git -C "$repo" worktree remove --force "$wt" 10>&- || log_warn gate_worktree_left "worktree=$wt"
  return "$rc"
}

# task_stop_requested id — explicit stop intent also covers work delegated by a stopped ancestor.
# A visited set makes malformed legacy parent cycles safe to read.
task_stop_requested() {
  local id=$1
  local -A visited=()
  while [[ -n $id && -f $TASKS/$id/meta.env && -z ${visited[$id]:-} ]]; do
    if [[ -f $TASKS/$id/stop-requested || $(task_field "$id" TEAM_STOPPED) == 1 ]]; then
      return 0
    fi
    visited[$id]=1
    id=$(task_field "$id" PARENT_TASK)
  done
  return 1
}

# blocking_investigation id — prints the independent investigation (--investigation) in progress in that normal team
# task's project; 1 when there is none. Ordinary agent-requested investigations, unrelated repositories and a finished
# cohort whose handoff still shows as waiting (investigation_completed_wait) never block.
blocking_investigation() {
  local id=$1 root repo m inv inv_root inv_repo
  [[ -n $(task_field "$id" TEAM) && -z $(task_field "$id" INVESTIGATION_TEAM) ]] || return 1
  case $(task_field "$id" KIND) in worker|remote-member|"") ;; *) return 1 ;; esac
  root=$(task_field "$id" REPO_ROOT)
  repo=$(task_field "$id" REPO_NAME)
  [[ -n $root || -n $repo ]] || return 1
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    inv=${m%/meta.env}; inv=${inv##*/}
    if [[ $(task_field "$inv" KIND) != investigation_team && -z $(task_field "$inv" INVESTIGATION_TEAM) ]]; then
      continue
    fi
    inv_root=$(task_field "$inv" REPO_ROOT)
    inv_repo=$(task_field "$inv" REPO_NAME)
    if [[ -n $root && -n $inv_root ]]; then
      [[ $inv_root == "$root" ]] || continue
    elif [[ -n $repo && -n $inv_repo ]]; then
      [[ $inv_repo == "$repo" ]] || continue
    else
      continue
    fi
    case $(task_field "$inv" STATUS) in done|failed|stopped) continue ;; esac
    if [[ $(task_field "$inv" KIND) == investigation_team ]] && investigation_completed_wait "$inv"; then continue; fi
    printf '%s\n' "$inv"
    return 0
  done
  return 1
}

# normal_resume_allowed id — top-level investigations reserve their project against normal team resumption: 1, with
# the reason on stderr, while blocking_investigation finds one.
normal_resume_allowed() {
  local id=$1 inv
  [[ $AGENT_INVESTIGATION_EXCLUSIVE == yes ]] || return 0   # only when investigations are to hold their project
  inv=$(blocking_investigation "$id") || return 0
  log_info resume_blocked_investigation "task=$id" "investigation=$inv"
  printf 'agent: normal team resumption is blocked by independent investigation %s (--investigation) in this project; finish or stop it first.\n' "$inv" >&2
  return 1
}

# automation_allowed task — 0 unless the human stopped the task (agent stop, agent team --stop: every member and its
# delegated descendants carry the mark): then its automatic follow-up (wake, review, precheck, fix pass, merge) is
# dropped. An --investigation's priority is not checked here — a team already at work keeps its checks and reviews:
# resume_run refuses to resume a normal team (normal_resume_allowed: with AGENT_INVESTIGATION_EXCLUSIVE=yes only)
automation_allowed() {
  local id=$1
  [[ -n $id && -f $TASKS/$id/meta.env ]] || return 1
  ! task_stop_requested "$id" && [[ $(task_field "$id" STATUS) != stopped ]]
}

# human_resume_allowed id — agent answer / agent resume: refused, with the reason, for a task the human stopped, and
# while an --investigation is in progress in its project
human_resume_allowed() {
  automation_allowed "$1" \
    || die "task $1 was stopped by the human — it is not resumed; start it again with: agent run --resume <team|task>"
}

start_task_unit() { # task subcommand — runs `agent <subcommand> <task>` in its own unit (it may take minutes)
  automation_allowed "$1" || return 0
  systemd-run --user --quiet --collect --unit="agent-$1-${2#_}-$(date +%s)" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" "$2" "$1" 3>&- 7>&- 8>&- 9>&- 10>&-
}

cmd__merge() { # coordinator task — --autopilot after two ready-to-merge reviews: the merge (unless something needs the
  # human), the gate on the merged base, then the next round of the plan
  local id=$1 root branch base head mb url num why out wr wrs ref
  automation_allowed "$id" || return 0
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH); base=$(task_field "$id" BASE); base=${base:-main}
  url=$(task_field "$id" PR_URL); num=$(task_field "$id" PR_NUMBER)
  if [[ $(task_field "$id" AUTOPILOT_OFF) == 1 ]]; then
    auto_stage "$id" "waits for you: the autopilot is off — merge the PR yourself"
    notify "$id" approved "" "both reviews: ready to merge — the autopilot is off: merge PR #$num yourself: $url"
    return 0
  fi
  auto_stage "$id" "merging the round's PR (both reviews: ready to merge)"
  git -C "$root" fetch -q origin 10>&- || log_warn merge_fetch_failed "task=$id"   # then the local refs are checked
  head=$(git -C "$root" rev-parse -q --verify "origin/$branch^{commit}" 10>&-) || head=$(git -C "$root" rev-parse -q --verify "$branch^{commit}" 10>&-) || head=""
  mb=$(git -C "$root" merge-base "origin/$base" "${head:-HEAD}" 10>&-) || mb=""
  if [[ -n $head && -n $mb ]]; then why=$(merge_blockers "$root" "$mb" "$head" "$(task_field "$id" ROUND_TESTS)"); fi
  if [[ -n $why ]]; then
    auto_stage "$id" "waits for you: PR #$num is yours to merge (both reviews: ready to merge)"
    notify "$id" approved "" "both reviews: ready to merge, but PR #$num waits for you — $(tr '\n' ';' <<< "$why") $url"
    log_info autopilot_merge_held "task=$id" "reason=${why:0:200}"
    return 0
  fi
  if [[ $(cd "$root" && gh pr view "$url" --json isDraft --jq .isDraft 2>/dev/null) == true ]]; then   # a draft is made ready first
    (cd "$root" && try pr_ready_failed gh pr ready "$url" >/dev/null)
  fi
  local match=() checked   # only the commit the checks and the reviews had: anything pushed since stops the merge
  checked=$(task_field "$id" PRECHECK_HEAD)
  [[ -z $checked ]] || match=(--match-head-commit "$checked")
  automation_allowed "$id" || return 0
  meta_set "$id" PR_MERGE_OWN 1   # this merge is the autopilot's own: supervise_merged_rounds leaves the round alone
  if ! out=$(cd "$root" && gh pr merge "$url" --merge "${match[@]}" 2>&1); then
    meta_set "$id" PR_MERGE_OWN ""
    auto_stage "$id" "waits for you: merging PR #$num failed"
    notify "$id" failed "" "⛔ autopilot stopped: merging PR #$num failed — your decision is needed: ${out:0:300} $url"
    log_error autopilot_merge_failed "task=$id" "reason=${out:0:300}"
    return 0
  fi
  log_info autopilot_merged "task=$id" "pr=$num"
  auto_stage "$id" "PR #$num merged — the gate on the merged $base"
  act "$id" info "--autopilot: PR #$num merged (both reviews: ready to merge)"
  git -C "$root" fetch -q origin "$base" 10>&- || log_warn merge_fetch_failed "task=$id" "base=$base"
  if ! gate_at "$root" "origin/$base" "$TASKS/$id/postmerge.log" "origin/$base^1"; then   # the PR's merge commit
    auto_stage "$id" "waits for you: the gate fails on $base after the merge"
    notify "$id" failed "" "⛔ autopilot stopped: PR #$num is merged, but the gate fails on $base — your decision is needed: $(tail -n 15 "$TASKS/$id/postmerge.log" | tr '\n' ' ')"
    log_warn autopilot_postmerge_gate_failed "task=$id" "base=$base"
    return 0
  fi
  wr=$(task_field "$id" WORK_ROUND); wrs=$(task_field "$id" WORK_ROUNDS)
  if [[ -z $wr || -z $wrs ]] || ((wr >= wrs)); then
    auto_stage "$id" ""   # the task is done
    notify "$id" merged "" "PR #$num merged by --autopilot — both reviews: ready to merge ($(pair_reviewers "$(task_field "$id" REVIEW_PAIR)")); ${wr:+round $wr/$wrs was the last: }the task is done — $url"
    return 0
  fi
  auto_stage "$id" "PR #$num merged — round $((wr + 1))/$wrs starts"
  notify "$id" merged "" "PR #$num merged by --autopilot — both reviews: ready to merge ($(pair_reviewers "$(task_field "$id" REVIEW_PAIR)")); round $wr/$wrs is done — $url"
  team_wait_settled "$id" || log_warn team_not_settled "task=$id" "before=next-round"   # a busy team cannot be resumed
  automation_allowed "$id" || return 0
  ref=$(task_field "$id" TEAM); ref=${ref:-$id}
  if ! out=$(cd "$root" && "$SELF" run --resume "$ref" --autopilot \
       "Round $((wr + 1)) of $wrs: the PR of round $wr (#$num) is merged — go on with the next round of the plan." </dev/null 2>&1); then
    auto_stage "$id" "waits for you: round $((wr + 1))/$wrs could not start"
    notify "$id" failed "" "⛔ autopilot stopped: round $((wr + 1))/$wrs could not start — your decision is needed: ${out:0:300}"
    log_error autopilot_next_round_failed "task=$id" "reason=${out:0:300}"
    return 0
  fi
  log_info autopilot_next_round "task=$id" "round=$((wr + 1))/$wrs" "output=${out:0:300}"
  notify "$id" round-start "" "round $((wr + 1))/$wrs starts on fresh branches from the merged $base — team ${ref}"
  auto_stage "$id" ""   # the next round's team has the work
}

cmd_autopilot() { # team [on|off] — a team's --autopilot, shown or switched; off: its reviews go on, but nothing is
  # merged nor started by itself (the human decides); on: the next round's reviews are a pair, and it merges again
  local team=${1:-} t lead
  [[ -n $team ]] || die "usage: agent autopilot <team> [on|off]"
  bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null || die "no team $team on the bus (agent team)"
  case ${2:-} in
    on|off)
      for t in $(team_tasks "$team"); do
        [[ $(task_field "$t" KIND) != remote-member ]] || continue
        if [[ $2 == on ]]; then meta_set "$t" AUTOPILOT 1; meta_set "$t" AUTOPILOT_OFF ""; else meta_set "$t" AUTOPILOT_OFF 1; fi
      done
      log_info autopilot_switched "team=$team" "state=$2"
      echo "Autopilot of team $team: $2." ;;
    "")
      lead=$(team_tasks "$team" | head -1)
      if [[ $(task_field "$lead" AUTOPILOT) == 1 && $(task_field "$lead" AUTOPILOT_OFF) != 1 ]]; then echo "Autopilot of team $team: on."
      else echo "Autopilot of team $team: off."; fi ;;
    *) die "usage: agent autopilot <team> [on|off]" ;;
  esac
}

supervise_review_waits() { # an --autopilot review pair waiting longer than AGENT_REVIEW_WAIT_MIN for two free
  # investigators: the human is told once (it goes on waiting — never one reviewer instead of two)
  local m id since
  for m in "$TASKS"/*/meta.env; do
    grep -qx 'REVIEW_PAIR_PENDING=1' "$m" || continue
    id=${m%/meta.env}; id=${id##*/}
    task_held "$id" && continue   # its team is paused by the human
    [[ -z $(task_field "$id" REVIEW_WAIT_TOLD) ]] || continue
    since=$(task_field "$id" REVIEW_PAIR_SINCE)
    (($(date +%s) - ${since:-0} >= AGENT_REVIEW_WAIT_MIN * 60)) || continue
    notify "$id" review-wait "" "the two reviews of PR #$(task_field "$id" PR_NUMBER) wait for two free investigators (since $(date -d "@${since:-0}" '+%H:%M')): free one, or wait"
    meta_set "$id" REVIEW_WAIT_TOLD 1   # after the notification: one that failed is sent again
  done
}

# gate_change_paths repo base [head] — the paths a change touches, one a line, counted from its merge base with base
# (what the base gained since is not the change's): base...head, or with no head the worktree, its uncommitted and
# untracked files too. Renames count both paths. Fails when git cannot tell
gate_change_paths() {
  local repo=$1 base=$2 head=${3:-} mb
  if [[ -n $head ]]; then
    git -C "$repo" diff --name-only --no-renames "$base...$head" || return 1
    return 0
  fi
  mb=$(git -C "$repo" merge-base "$base" HEAD) || return 1
  git -C "$repo" diff --name-only --no-renames "$mb" || return 1
  git -C "$repo" ls-files --others --exclude-standard || return 1
}

# gate_scope_for paths — the command of the first AGENT_GATE_SCOPES entry whose patterns match every one of the
# paths (one a line, at least one); status 1: none. An entry without " => ", patterns or a command is skipped, logged
gate_scope_for() {
  local entry pats cmd p ok
  local -a scope_patterns
  [[ -n ${1//[[:space:]]/} ]] || return 1
  for entry in "${AGENT_GATE_SCOPES[@]}"; do
    pats=${entry%% => *}; cmd=${entry#* => }
    if [[ $entry != *' => '* || -z ${pats//[[:space:]]/} || -z ${cmd//[[:space:]]/} ]]; then
      log_warn gate_scope_invalid "entry=$entry" "reason=not \"patterns => command\""
      continue
    fi
    read -r -a scope_patterns <<< "$pats"
    ok=1
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      rule_path_matches "$p" "${scope_patterns[@]}" || { ok=0; break; }
    done <<< "$1"
    if ((ok)); then printf '%s' "$cmd"; return 0; fi
  done
  return 1
}

# review_gate_cmd repo [base [head]] — the gate a change must pass (nothing: none): with a range, the first
# AGENT_GATE_SCOPES entry covering every path the change touches (gate_change_paths); otherwise — no range, no
# scope covering it, a change of nothing — the full gate
review_gate_cmd() {
  local paths scoped
  if [[ -n ${2:-} ]] && ((${#AGENT_GATE_SCOPES[@]})); then
    if paths=$(gate_change_paths "$1" "$2" "${3:-}"); then
      if scoped=$(gate_scope_for "$paths"); then printf '%s' "$scoped"; return 0; fi
    else
      log_warn gate_scope_paths_failed "repo=$1" "base=$2" "head=${3:-worktree}"
    fi
  fi
  case $AGENT_REVIEW_GATE in
    off|"") ;;
    auto) if make -C "$1" -n gate >/dev/null 2>&1; then printf 'make gate'; fi ;;   # a repository without a gate target: none
    *) printf '%s' "$AGENT_REVIEW_GATE" ;;
  esac
}

# auto_stage task text — what --verify/--autopilot does for the round now, kept on its coordinator's task (AUTO_STAGE,
# the dashboard's stage); "" once the work is back with the team, or with the human after "waits for you: …"
auto_stage() { # task text [no-comment]
  [[ $(task_field "$1" AUTO_STAGE) != "$2" ]] || return 0
  meta_set "$1" AUTO_STAGE "$2"
  # a decision handed to the human is said on the round's PR too: GitHub notifies them there, whatever becomes of the
  # notification command
  if [[ $2 == "waits for you:"* && -z ${3:-} ]]; then human_on_pr "$1" "$2"; fi
}

# human_on_pr task text [mode] — a comment on the task's PR to its repository's owner (mentioned, when on GitHub),
# after the mode that wrote it (default --autopilot)
human_on_pr() {
  local url root owner mode=${3:---autopilot}
  url=$(task_field "$1" PR_URL)
  [[ -n $url ]] || return 0
  root=$(task_field "$1" REPO_ROOT)
  owner=$(github_owner "$root")
  (cd "$root" && try handover_comment_failed gh pr comment "$url" --body "${owner:+@$owner }$mode $2") || return 0
  log_info handover_commented "task=$1" "pr=$url"
}

# round_open_prs task — the open PRs (trusted) of its team's branches: "#N (branch) url" lines
round_open_prs() {
  local id=$1 team root m b out
  team=$(task_field "$id" TEAM); root=$(task_field "$id" REPO_ROOT)
  [[ -n $team ]] || return 0
  for m in "$TASKS"/*/meta.env; do
    grep -qx "TEAM=$team" "$m" || continue
    b=$(sed -n 's/^BRANCH=//p' "$m")
    [[ -n $b ]] || continue
    out=$(try pr_lookup_failed trusted_prs "$root" "$b" open number,url,headRefName,state) || continue
    jq_soft pr_lookup_parse -r '.[] | select((.state // "OPEN") == "OPEN") | "#\(.number) (\(.headRefName)) \(.url)"' <<< "${out:-[]}"
  done | sort -u
}

# round_pr_of_tasks task… — the round's PR, from the round's tasks: "<number> <branch>" — the PR_NUMBER and branch of
# the task that opened it, or the ROUND_PR carried (no branch); nothing for none
round_pr_of_tasks() {
  local t p
  for t in "$@"; do
    p=$(task_field "$t" PR_NUMBER)
    if [[ -n $p ]]; then printf '%s %s' "$p" "$(task_field "$t" BRANCH)"; return 0; fi
  done
  for t in "$@"; do
    p=$(task_field "$t" ROUND_PR)
    if [[ -n $p ]]; then printf '%s' "$p"; return 0; fi
  done
}

# round_pr_merged number task… — whether the round's PR of that number is merged, from the PRs of the round's branches
# (a branch can have an earlier round's merged PR too); GitHub not answering counts as not merged (logged)
round_pr_merged() {
  local num=$1 t b out state; shift
  for t in "$@"; do
    b=$(task_field "$t" BRANCH)
    [[ -n $b ]] || continue
    out=$(try pr_lookup_failed trusted_prs "$(task_field "$t" REPO_ROOT)" "$b" all number,state) || continue
    state=$(jq_soft pr_lookup_parse -r --argjson n "$num" '.[] | select(.number == $n) | .state' <<< "${out:-[]}")
    [[ $state != MERGED ]] || return 0
  done
  return 1
}

# round_pr_note merged task… — what a resumed round's text says of its PR (round_pr_of_tasks), and where the round's
# commits go: through its coordinator, who alone merges the members' branches; merged=1: the PR is merged already,
# and its follow-up gets one new PR
round_pr_note() {
  local merged=$1 num branch; shift
  read -r num branch <<< "$(round_pr_of_tasks "$@")"
  [[ -n $num ]] || return 0
  if ((merged)); then
    printf "This round's PR #%s%s is merged. Its follow-up goes in one new PR, opened by the coordinator from its branch; a member pushes its own branch and tells the coordinator what is on it (a board item or a message), and the coordinator merges it. A member never pushes to the coordinator's branch, and never opens, merges or closes a PR.\n" \
      "$num" "${branch:+ (branch $branch)}"
    return 0
  fi
  printf "This round's PR is #%s%s. Every commit of this round goes there, through the coordinator: a member pushes its own branch and tells the coordinator what is on it (a board item or a message); the coordinator merges the members' branches into its own and pushes it there (git push origin HEAD:%s) — a new coordinator first merges %s into its branch. A member never pushes to the coordinator's branch, and never opens, merges or closes a PR. Never open another PR for this round: the checks send a round with two open PRs back.\n" \
    "$num" "${branch:+ (branch $branch)}" "${branch:-<its branch>}" "${branch:+origin/$branch}"
}

# round_pr_of_team team — the round's PR its coordinator had: its PR_NUMBER, or the ROUND_PR it carried; "" for none
round_pr_of_team() {
  [[ -n $1 ]] || return 0
  local lt p
  lt=$(team_lead_task "$1" "$(team_lead "$1")")
  [[ -n $lt ]] || return 0
  p=$(task_field "$lt" PR_NUMBER)
  printf '%s' "${p:-$(task_field "$lt" ROUND_PR)}"
}

# round_pr_supersede task pr-number pr-url — the round's PR is now this one (ROUND_PR); the round's earlier PR, when
# another (a new coordinator's branch), is closed as superseded by it, and each links to the other
round_pr_supersede() {
  local id=$1 num=$2 url=$3 old root
  old=$(task_field "$id" ROUND_PR)
  meta_set "$id" ROUND_PR "$num"
  [[ -n $old && $old != "$num" ]] || return 0
  root=$(task_field "$id" REPO_ROOT)
  (cd "$root" && try round_pr_close_failed gh pr close "$old" --comment "Superseded by #$num: the round's coordinator changed, and its work continues there ($url).") || return 0
  (cd "$root" && try round_pr_link_failed gh pr comment "$num" --body "Continues #$old (closed as superseded by this PR).") || true
  act "$id" info "PR #$old of this round closed: superseded by #$num"
  log_info round_pr_superseded "task=$id" "old=$old" "new=$num"
}

# gate_progress log — " — K of N steps passed (the last)" from tools/gate.sh's output so far, or " — <step> failed";
# "" for another gate command, whose output has no such lines
gate_progress() {
  local n k last failed
  n=$(sed -nE 's/^gate: ([0-9]+) steps?,.*/\1/p' "$1" 2>/dev/null | head -n 1)
  [[ -n $n ]] || return 0
  failed=$( { grep -E '^FAIL +[^ ]' "$1" || (($? == 1)); } | head -n 1 | awk '{print $2}')
  if [[ -n $failed ]]; then printf ' — %s failed' "$failed"; return 0; fi
  k=$(grep -cE '^ok +[^ ]' "$1" || (($? == 1)))   # grep -c prints 0 when none has passed yet
  last=$( { grep -E '^ok +[^ ]' "$1" || (($? == 1)); } | tail -n 1 | awk '{print $2}')
  printf ' — %s of %s steps passed%s' "$k" "$n" "${last:+ ($last)}"
}

# pair_stage pair-dir — the two reviews of an --autopilot pair, for the dashboard: each investigator with its
# verdict (✅ 🔧 🧩 ❌), or its investigation's number while it works
pair_stage() {
  local s out="" a v
  for s in A B; do
    a=$(cat "$1/$s.agent" 2>/dev/null) || a="?"
    v=$(cat "$1/$s.verdict" 2>/dev/null) || v=""
    case $v in
      ready-to-merge) v="✅" ;;
      needs-fixes) v="🔧" ;;
      incomplete) v="🧩" ;;
      none) v="❌" ;;
      *) v="(#$(cat "$1/$s.inv" 2>/dev/null || printf '?')) …" ;;
    esac
    out+="${out:+, }$a $v"
  done
  printf 'two reviews: %s' "$out"
}

start_precheck() { # coordinator task — the checks before its review run in their own unit: the gate may take minutes,
  # and the team's members must settle before the round can go back to them
  local id=$1
  automation_allowed "$id" || return 0
  if systemd-run --user --quiet --collect --unit="agent-$id-precheck-$(date +%s)" \
       --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
       "$SELF" _precheck "$id" 3>&- 7>&- 8>&- 9>&- 10>&-; then
    act "$id" info "before the review: the checks started"
    auto_stage "$id" "checks before review: waiting for the team's runs to end"
  else
    log_error precheck_unit_failed "task=$id"   # then here, in this run
    if review_precheck "$id"; then request_review "$id"; dispatch; fi
  fi
}

team_wait_settled() { # task — waits until the local members of its team have no run going (10 minutes at most): a
  # team is resumed only then; 1 = still busy
  local team t active i
  team=$(task_field "$1" TEAM)
  [[ -n $team ]] || return 0
  for ((i = 0; i < 120; i++)); do
    active=0
    for t in $(team_tasks "$team"); do
      [[ $(task_field "$t" KIND) != remote-member ]] || continue
      case $(task_field "$t" STATUS) in starting|running|waiting|investigating) active=1 ;; esac
    done
    ((active)) || return 0
    sleep 5
  done
  return 1
}

cmd__precheck() { # coordinator task — once its team's members have settled: the checks, then the review — or the
  # round goes back to the team
  local id=$1
  automation_allowed "$id" || return 0
  if [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then
    [[ $(task_field "$id" STATUS) != stopped && ! -f $TASKS/$id/stop-requested ]] || return 0
    local check_passed=0
    if review_precheck "$id"; then check_passed=1; fi
    [[ $(task_field "$id" STATUS) != stopped && ! -f $TASKS/$id/stop-requested ]] || return 0
    local allow
    allow=$(investigation_field "$id" INVESTIGATION_PRECHECK_ALLOW)
    if ((check_passed)); then meta_set "$id" INVESTIGATION_PRECHECK passed
    elif [[ -n $allow ]]; then investigation_wait_allow "$id" "$allow"
    else meta_set "$id" INVESTIGATION_PRECHECK failed; fi
    dispatch
    return
  fi
  team_wait_settled "$id" || log_warn team_not_settled "task=$id" "before=precheck"
  automation_allowed "$id" || return 0
  if review_precheck "$id"; then
    request_review "$id"
    dispatch   # the review queued here starts on a free investigator now, not at some later run's end
  fi
}

review_precheck() { # coordinator task id — before a review: the round's head adds tests for a change of code and passes
  # the gate; else the team goes on with the reason (AGENT_PRECHECK_MAX times), then the human decides. 0 = review it
  local id=$1 root branch base head mb tc gate wt rc why="" pass ref repo args=() out allow_cmd=""
  automation_allowed "$id" || return 1
  if [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then meta_set "$id" INVESTIGATION_PRECHECK_ALLOW ""; fi
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH); base=$(task_field "$id" BASE)
  git -C "$root" fetch -q origin 10>&- || log_warn precheck_fetch_failed "task=$id"   # then the local refs are checked
  head=$(git -C "$root" rev-parse -q --verify "origin/$branch^{commit}" 10>&-) \
    || head=$(git -C "$root" rev-parse -q --verify "$branch^{commit}" 10>&-) \
    || { log_warn precheck_no_head "task=$id" "branch=$branch"; if [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then
      meta_set "$id" INVESTIGATION_PRECHECK_REASON "The published merge branch is unavailable for checks."
      return 1
    fi
    return 0; }   # nothing to check: the review decides
  meta_set "$id" PRECHECK_HEAD "$head"   # the commit checked (and then reviewed): the only one --autopilot merges
  auto_stage "$id" "checks before review: the round's tests and its PR's description"
  mb=$(git -C "$root" merge-base "origin/${base:-main}" "$head" 10>&-) || mb=$(git -C "$root" merge-base "${base:-main}" "$head" 10>&-) \
    || { log_warn precheck_no_base "task=$id" "base=$base"; if [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then
      meta_set "$id" INVESTIGATION_PRECHECK_REASON "The target base is unavailable for checks."
      return 1
    fi
    return 0; }
  tc=$(round_test_changes "$root" "$mb" "$head")
  meta_set "$id" ROUND_TESTS "$tc"
  local no_new_tests
  no_new_tests=$(grep -m 1 -iE '^[[:space:]>*-]*No new tests:[[:space:]]*[^[:space:]]' "$TASKS/$id/task.md" 2> /dev/null) || no_new_tests=""
  if [[ $tc == "code=1 added=0 "* && $AGENT_PRECHECK_TESTS == off ]]; then   # the human turned the rule off
    log_info precheck_tests_off "task=$id"
  elif [[ $tc == "code=1 added=0 "* && -n $no_new_tests ]]; then   # the human's task says why none: a refactoring
    log_info precheck_no_new_tests "task=$id" "reason=${no_new_tests:0:200}"
  elif [[ $tc == "code=1 added=0 "* ]]; then
    why="the round changes code but adds no test — every change of behaviour needs its test, written first (a task that changes no behaviour says so on a line \"No new tests: <why>\")"
  fi
  local rules rpr rbody="" rbody_read=0 human disc rtext=""   # AGENTS.md's rules on the round's diff, with the others'
  rpr=$(trusted_prs "$root" "$branch" open url | jq -r '.[0].url // empty') || rpr=""
  if [[ -n $rpr ]]; then
    if rbody=$(cd "$root" && gh pr view "$rpr" --json body --jq .body); then rbody_read=1; else rbody=""; fi
  fi
  # the round's size into its PR description — only over a description just read: never one written over blind
  ((rbody_read)) && pr_write_round_size "$id" "$root" "$rpr" "$rbody"
  # an investigation's task first in its PR description: what its reviewers check, what the human sees
  if ((rbody_read)) && [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then
    pr_write_task "$id" "$root" "$rpr"
  fi
  rbody=$(pr_body_without_task "$rbody")   # the rules read the agents' text, not the task
  rules=$(round_rule_issues "$root" "$mb" "$head" "$(rule_allow_key "$id")" "$rbody")
  if [[ -n $rules ]]; then
    human=$(sed -n 's/^human: /- /p' <<< "$rules")
    disc=$(sed -n 's/^disclose: /- /p' <<< "$rules")
    [[ -z $human ]] || rtext+="the round changes what only the human may allow (AGENTS.md \"Never\"): revert it, or ask the human, who allows it with: $(rule_allow_command "$(rule_allow_key "$id")" "$human")
$human
"
    [[ -z $disc ]] || rtext+="the round adds suppressions its PR description does not name: name each file and why in the description, or remove it
$disc
"
    # only the human's allowance missing: what the team cannot fix — an investigation waits for the human on it
    if [[ -n $human && -z $disc && -z $why ]]; then allow_cmd=$(rule_allow_command "$(rule_allow_key "$id")" "$human"); fi
    why="${why:+$why

}$rtext"
    log_warn precheck_rules "task=$id" "issues=$(grep -c . <<< "$rules")"
  fi
  if [[ -z $why ]]; then   # a round has one PR: the others' commits belong on the round's PR branch
    local round_prs n_prs
    round_prs=$(round_open_prs "$id")
    n_prs=$(grep -c . <<< "$round_prs") || n_prs=0   # none: grep's "no match"
    if ((n_prs > 1)); then
      why="the round has $n_prs open PRs ($(paste -sd, <<< "$round_prs" | sed 's/,/, /g')) — a round has one PR: bring the others' commits onto the round's PR branch (the coordinator's), push it, and close the others with a link to it"
    fi
  fi
  local format_bounce pr_url body issues
  format_bounce=$(task_field "$id" FORMAT_BOUNCED)
  if [[ -z $why && $format_bounce != 1 ]]; then   # the PR description's form, once a round
    pr_url=$(trusted_prs "$root" "$branch" open url | jq -r '.[0].url // empty') || pr_url=""
    if [[ -n $pr_url ]]; then
      body=$(cd "$root" && gh pr view "$pr_url" --json body --jq .body) || body=""
      issues=$(pr_format_issues "$(pr_body_without_task "$body")" "$(github_repo_url "$root")")
      if [[ -n $issues ]]; then
        why="the PR description does not follow the conventions for texts on GitHub (sent back once) — fix:
$issues"
        format_bounce=1
      fi
    fi
  fi
  gate=$(review_gate_cmd "$root" "$mb" "$head")
  if [[ -z $why && -n $gate ]]; then
    wt=$(mktemp -d)
    git -C "$root" worktree add -q --detach "$wt" "$head" 10>&- || { log_warn precheck_worktree_failed "task=$id"; rmdir "$wt"; if [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then
      meta_set "$id" INVESTIGATION_PRECHECK_REASON "The isolated check worktree could not be created."
      return 1
    fi
    return 0; }
    rc=0
    auto_stage "$id" "checks before review: waiting for the machine's gate lock"
    gate_lock 1 "$id" "$wt"   # one gate run at a time on the machine: the agents' and this one
    auto_stage "$id" "checks before review: $gate"
    local gstart; gstart=$(date +%s)
    set -m
    # AGENT_GATE_RUN: run under the gate lock it holds — a repository's own tool must not send it to agent gate again
    (cd "$wt" && AGENT_GATE_RUN=$id timeout "${AGENT_REVIEW_GATE_MIN}m" bash -c "$gate") < /dev/null \
      > "$TASKS/$id/precheck.log" 2>&1 10>&- &
    local gpid=$!
    set +m
    gate_lock_pgid "$gpid"
    while kill -0 "$gpid" 2>/dev/null; do   # its progress on the dashboard while it runs ("no such process": it ended)
      auto_stage "$id" "checks before review: $gate$(gate_progress "$TASKS/$id/precheck.log")"
      sleep "$AGENT_STAGE_POLL_SEC"
    done
    wait "$gpid" || rc=$?
    gate_unlock
    gate_record "$id" "$head" true "$rc" "$(($(date +%s) - gstart))" "$gate" "$TASKS/$id/precheck.log"
    git -C "$root" worktree remove --force "$wt" 10>&- || log_warn precheck_worktree_left "worktree=$wt"
    act "$id" info "before the review: the gate ($gate) at ${head:0:7} — exit $rc"
    ((rc == 0)) || why="the gate (\`$gate\`) fails at ${head:0:7} (exit $rc); its output ends with:
\`\`\`
$(tail -n 40 "$TASKS/$id/precheck.log")
\`\`\`"
  fi
  automation_allowed "$id" || return 1
  [[ -n $why ]] || return 0
  if [[ $(investigation_field "$id" INVESTIGATION_PIPELINE) == 1 ]]; then
    meta_set "$id" INVESTIGATION_PRECHECK_REASON "$why"
    meta_set "$id" INVESTIGATION_PRECHECK_ALLOW "$allow_cmd"
    log_warn review_precheck_failed "task=$id" "reason=${why:0:200}"
    return 1
  fi
  pass=$(task_field "$id" PRECHECK_PASS); pass=${pass:-0}
  ref=$(task_field "$id" TEAM); ref=${ref:-$id}; repo=$(task_field "$id" REPO_NAME)
  log_warn review_precheck_failed "task=$id" "pass=$pass" "reason=${why:0:200}"
  if ((pass < AGENT_PRECHECK_MAX)); then
    args=(run --resume "$ref" --same-round)
    if [[ $(task_field "$id" AUTOPILOT) == 1 ]]; then args+=(--autopilot); else args+=(--verify); fi
    if handback "$id" "the round" \
         "AGENT_PRECHECK_PASS=$((pass + 1)) AGENT_FIX_PASS=$(task_field "$id" FIX_PASS) AGENT_FORMAT_BOUNCED=$format_bounce" \
         "${args[@]}" "Not reviewed yet ($((pass + 1)) of $AGENT_PRECHECK_MAX): $why
Fix it on the same branches and finish as before; the round goes to review once its head passes."; then
      if [[ $(task_field "$id" HANDBACK_PENDING) != 1 ]]; then   # else it waits for the team's runs to end
        act "$id" info "before the review: the team goes on ($((pass + 1)) of $AGENT_PRECHECK_MAX) — ${why:0:120}"
        auto_stage "$id" ""   # the team has the work
      fi
    else
      log_error review_precheck_resume_failed "task=$id" "reason=${HANDBACK_OUT:0:500}"
      handover_failed "$id" "the round" "$HANDBACK_OUT"
    fi
    return 1
  fi
  auto_stage "$id" "waits for you: the round still fails its checks after $pass returns"
  notify "$id" failed "" "not reviewed: after $pass returns the round still fails before its review (the gate or its tests) — your decision is needed: ${why:0:400}"
  return 1
}

review_followup() { # investigator-task-id final — after a --verify review: critical or major findings wake the team
  # with them (VERIFY_MAX_FIX_PASSES times at most); after that the human is mentioned on the PR and notified
  local id=$1 text=$2 parent n pass ref repo root add out owner args=()
  parent=$(task_field "$id" PARENT_TASK)
  [[ -n $parent ]] || return 0
  automation_allowed "$parent" || return 0
  # the counts are in the final message ("Problems: …") and in the result file; the larger is the one that counts
  local n2=0
  n=$(findings_count "$text")
  if [[ -s $TASKS/$id/result.md ]]; then
    n2=$(findings_count "$(cat "$TASKS/$id/result.md")")
    text=$(cat "$TASKS/$id/result.md")
  fi
  ((n2 > n)) && n=$n2
  local verdict pair
  verdict=$(review_task_verdict "$id" "$2")
  meta_set "$id" REVIEW_VERDICT "${verdict:-none}"
  pass=$(task_field "$parent" FIX_PASS); pass=${pass:-0}
  log_info review_findings "task=$parent" "review=$id" "critical_or_major=$n" "fix_pass=$pass" "verdict=${verdict:-none}"
  pair=$(task_field "$parent" REVIEW_PAIR)
  if [[ -n $pair ]]; then review_pair_done "$id" "$parent" "$pair" "${verdict:-none}" "$text"; return 0; fi
  [[ $verdict == needs-fixes || $verdict == incomplete ]] || return 0
  review_fix_pass "$parent" "$n" "$text"
}

review_fix_pass() { # parent findings text — the fix pass runs in its own unit, once the team's members have settled (a
  # member woken by the team's last messages may still run when the reviews end, and a busy team cannot be resumed)
  automation_allowed "$1" || return 0
  printf '%s' "$2" > "$TASKS/$1/fix-pass.n"
  printf '%s' "$3" > "$TASKS/$1/fix-pass.md"
  if start_task_unit "$1" _fixpass; then return 0; fi
  log_error fix_pass_unit_failed "task=$1"   # then here
  team_wait_settled "$1" || log_warn team_not_settled "task=$1" "before=fix-pass"
  do_fix_pass "$1" "$2" "$3"
}

cmd__fixpass() { # coordinator task — the fix pass recorded by review_fix_pass, once the team's members have settled
  local id=$1
  automation_allowed "$id" || return 0
  auto_stage "$id" "fix pass: the team goes on with the reviews' findings once its runs end"
  team_wait_settled "$id" || log_warn team_not_settled "task=$id" "before=fix-pass"
  automation_allowed "$id" || return 0
  do_fix_pass "$id" "$(<"$TASKS/$id/fix-pass.n")" "$(<"$TASKS/$id/fix-pass.md")"
  [[ $(task_field "$id" AUTO_STAGE) != "fix pass:"* ]] || auto_stage "$id" ""   # the team has the work, unless the human has
}

do_fix_pass() { # parent findings text — the team goes on with the review(s) that found problems, VERIFY_MAX_FIX_PASSES
  # times at most; after that the human is mentioned on the PR and notified
  local parent=$1 n=$2 text=$3 pass ref repo root add out owner args=()
  automation_allowed "$parent" || return 0
  pass=$(task_field "$parent" FIX_PASS); pass=${pass:-0}
  PR_NUMBER=$(task_field "$parent" PR_NUMBER); PR_URL=$(task_field "$parent" PR_URL)
  ref=$(task_field "$parent" TEAM); ref=${ref:-$parent}
  repo=$(task_field "$parent" REPO_NAME); root=$(task_field "$parent" REPO_ROOT)
  if ((pass < VERIFY_MAX_FIX_PASSES)); then
    add="Fix pass $((pass + 1)) of $VERIFY_MAX_FIX_PASSES after the --verify review of PR #$PR_NUMBER ($PR_URL): $n critical or major finding(s).
Fix every critical and major finding — or dispute one, with a justification, as a reply on the PR; fix minor ones only if trivial. Each item the reviews list is already on the board, for one member each — a minor one also with a worker, whose result goes to that member: integrate the items as they are done, and redo none. Then finish as before (the PR ready; STATUS: DONE or STATUS: ROUND_DONE N/M): the PR is reviewed again.

The review:

${text:0:8000}"
    args=(run --resume "$ref")
    if [[ $(task_field "$parent" AUTOPILOT) == 1 ]]; then args+=(--autopilot); else args+=(--verify); fi
    if [[ -n $(task_field "$parent" WORK_ROUND) ]]; then args+=(--same-round); fi
    if handback "$parent" "the fix pass" "AGENT_FIX_PASS=$((pass + 1))" "${args[@]}" "$add"; then
      act "$id" info "--verify: $n critical/major finding(s) — fix pass $((pass + 1))$(
        [[ $(task_field "$parent" HANDBACK_PENDING) != 1 ]] || printf ' waits for the team'"'"'s runs to end')"
      log_info review_fix_pass "task=$parent" "pass=$((pass + 1))" "findings=$n"
    else
      log_error review_fix_resume_failed "task=$parent" "reason=${HANDBACK_OUT:0:500}"
      handover_failed "$parent" "the fix pass" "$HANDBACK_OUT"
      push_text "$repo" "⛔ --verify: the review of PR #$PR_NUMBER found $n critical or major finding(s), but the team could not be resumed:" "${HANDBACK_OUT:0:500}"
    fi
    return 0
  fi
  owner=${AGENT_HUMAN_GITHUB:-$(github_owner "$root")}
  auto_stage "$parent" "waits for you: the reviews still find problems after $pass fix passes" no-comment   # the mention below says it
  (cd "$root" && try review_mention_failed gh pr comment "$PR_URL" --body "${owner:+@$owner }The fixes are still not done: after $pass fix passes the review still finds $n critical or major problem(s) (see the review above). The team has stopped; your decision is needed.")
  push_text "$repo" "⛔ --verify: PR #$PR_NUMBER still has $n critical or major problem(s) after $pass fix passes — your decision is needed: $PR_URL"
  log_warn review_fixes_exhausted "task=$parent" "passes=$pass" "findings=$n"
}

# pause_until_from_note note — when a node's pause ends, from its note ("resumes at 14:35": today or tomorrow;
# "resumes at 31.10 14:35": this year, or next once it has passed): seconds since the epoch, "" when it says none
pause_until_from_note() {
  local now t y
  now=$(date +%s)
  if [[ $1 =~ resumes\ at\ ([0-9]{2})\.([0-9]{2})\ ([0-9]{2}):([0-9]{2}) ]]; then
    y=$(date +%Y)
    t=$(date -d "$y-${BASH_REMATCH[2]}-${BASH_REMATCH[1]} ${BASH_REMATCH[3]}:${BASH_REMATCH[4]}" +%s) || return 0
    ((t >= now - 86400)) || t=$(date -d "$((y + 1))-${BASH_REMATCH[2]}-${BASH_REMATCH[1]} ${BASH_REMATCH[3]}:${BASH_REMATCH[4]}" +%s) || return 0
  elif [[ $1 =~ resumes\ at\ ([0-9]{2}):([0-9]{2}) ]]; then
    t=$(date -d "today ${BASH_REMATCH[1]}:${BASH_REMATCH[2]}" +%s) || return 0
    ((t > now)) || t=$((t + 86400))
  else
    return 0
  fi
  printf '%s' "$t"
}

# pause_reason_from_note note — the kind of a node's pause, from its note: quota, rate_limit, overloaded, network,
# or paused when it does not say
pause_reason_from_note() {
  case ${1,,} in
    *"quota or usage limit"*|*"out of quota"*) printf 'quota' ;;
    *"rate limit"*) printf 'rate_limit' ;;
    *overloaded*|*"at capacity"*) printf 'overloaded' ;;
    *network*|*unreachable*) printf 'network' ;;
    *) printf 'paused' ;;
  esac
}

# supervise_answer_watches — stops an answers watch (agent-<task>-answers-<round>.path) whose task no longer waits for
# the human's answers: answered another way, ended, or gone
supervise_answer_watches() {
  local units u tid
  units=$(systemctl --user list-units --all --plain --no-legend 'agent-*-answers-*.path') \
    || { log_warn answers_watch_list_failed; return 0; }
  while read -r u _; do
    [[ $u =~ ^agent-(.+)-answers-[0-9]+\.path$ ]] || continue
    tid=${BASH_REMATCH[1]}
    if [[ $tid == *@* ]] && remote_question_context "$tid"; then continue; fi
    [[ -f $TASKS/$tid/meta.env && $(task_field "$tid" STATUS) == waiting ]] && continue
    try answers_watch_stop_failed systemctl --user stop "$u"
    try answers_watch_reset_failed systemctl --user reset-failed "${u%.path}.service"
    log_info answers_watch_stopped "task=$tid" "unit=$u"
  done <<< "$units"
}

# remote_start_check root base — the lead's commit is on origin's base, where a new remote member starts on its node,
# so that every member of a new team starts from the same commit
remote_start_check() {
  local sha
  sha=$(git -C "$1" rev-parse HEAD 10>&-) || return 1
  git -C "$1" merge-base --is-ancestor "$sha" "origin/$2" 10>&-
}

# handback task what envspec arg… — the team takes its work back: agent run arg… (a --resume) with the environment
# envspec ("NAME=value …"); the hand-back's text, its last argument, is kept in the task's handback.md. Refused because
# a run of the team still goes on, it waits (HANDBACK_PENDING): supervise_handbacks tries it again once the team's
# runs end, and stops a run that goes on past AGENT_HANDBACK_WAIT_MIN. 0: taken back, or waiting; 1: refused
# otherwise — the refusal's output is in HANDBACK_OUT
handback() {
  local id=$1 what=$2 envspec=$3 out root envs=()
  shift 3
  root=$(task_field "$id" REPO_ROOT)
  read -ra envs <<< "$envspec"
  envs+=("AGENT_HANDBACK_LEAD=$(task_field "$id" AGENT)")   # who coordinates: its text is for it alone
  printf '%s\n' "${@: -1}" > "$TASKS/$id/handback.md" || log_warn handback_text_failed "task=$id"
  HANDBACK_OUT=""
  if out=$(cd "${root:-.}" && env "${envs[@]}" "$SELF" "$@" < /dev/null 2>&1); then
    meta_set "$id" HANDBACK_PENDING ""
    meta_set "$id" HANDBACK_SINCE ""
    rm -f "$TASKS/$id/handback.args"
    return 0
  fi
  if grep -q 'is still active (' <<< "$out"; then   # a run of the team still goes on: the hand-back waits for it
    if printf '%s\0' "$what" "$envspec" "$@" > "$TASKS/$id/handback.args"; then
      [[ -n $(task_field "$id" HANDBACK_SINCE) ]] || meta_set "$id" HANDBACK_SINCE "$(date +%s)"
      meta_set "$id" HANDBACK_PENDING 1
      act "$id" info "$what waits to go back to the team: $(grep -m1 -o 'task [^ ]* is still active ([a-z]*)' <<< "$out")"
      auto_stage "$id" "$what goes back to the team once its runs end"
      log_info handback_waiting "task=$id" "what=$what"
      return 0
    fi
    log_warn handback_args_failed "task=$id"
  fi
  HANDBACK_OUT=$out
  return 1
}

# failover_due task reason seconds — whether a paused member of an --autopilot team is to be replaced: out of quota
# always; its model overloaded at the provider past AGENT_FAILOVER_MIN, or for the AGENT_FAILOVER_OVERLOADS-th time
# within an hour (its overloads kept in OVERLOAD_TIMES); never for a rate limit, the account's and short
failover_due() {
  local id=$1 reason=$2 secs=$3 now t times=() kept=()
  case $reason in
    quota) return 0 ;;
    overloaded) ;;
    *) return 1 ;;
  esac
  now=$(date +%s)
  read -ra times <<< "$(task_field "$id" OVERLOAD_TIMES)"
  for t in "${times[@]}" "$now"; do
    [[ $t =~ ^[0-9]+$ ]] && ((now - t < 3600)) && kept+=("$t")
  done
  meta_set "$id" OVERLOAD_TIMES "${kept[*]}"
  ((secs > AGENT_FAILOVER_MIN * 60 || ${#kept[@]} >= AGENT_FAILOVER_OVERLOADS))
}

# failover_agent agent member… — a free normal agent to take the agent's place: none of the team's members, not busy,
# not out of service itself (a task of it with FAILOVER_UNTIL to come); one of another CLI than the agent's if free
failover_agent() {
  local agent=$1 a m u other="" same="" now
  shift
  now=$(date +%s)
  for a in "${NORMAL_AGENTS[@]}"; do
    [[ $a != "$agent" ]] && ! is_one_of "$a" "$@" || continue
    [[ -z $(agent_running_task "$a") ]] || continue
    for m in $(grep -lx "AGENT=$a" "$TASKS"/*/meta.env 2> /dev/null); do
      u=$(sed -n 's/^FAILOVER_UNTIL=//p' "$m")
      [[ $u =~ ^[0-9]+$ ]] && ((u > now)) && continue 2
    done
    if [[ ${AGENT_TYPE[$a]:-} != "${AGENT_TYPE[$agent]:-}" ]]; then other=${other:-$a}; else same=${same:-$a}; fi
  done
  echo "${other:-$same}"
}

# helper_failover task — a worker request whose worker's model is out of service goes to another worker: the worker's
# task is stopped — quietly: agent stop finishes no request, so the requester hears no failure —, the request queued
# again, and dispatched at once to a free worker, never one out of service (free_worker skips FAILOVER_UNTIL)
helper_failover() {
  local id=$1 hid agent
  hid=$(task_field "$id" HELPER_ID); agent=$(task_field "$id" AGENT)
  [[ -n $hid ]] || return 0
  "$SELF" stop "$id" > /dev/null 2>&1 || log_warn helper_failover_stop_failed "task=$id"
  if ! try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status queued; then
    log_error helper_failover_failed "task=$id" "request=H$hid"
    return 0
  fi
  log_info helper_failover "task=$id" "request=H$hid" "worker=$agent"
  act "$id" info "■ the model of $agent is out of service: request H$hid goes to another worker"
  dispatch_helpers || log_warn helper_dispatch_failed "request=H$hid"
}

# supervise_failovers — a member of an --autopilot team marked FAILOVER_PENDING is replaced: its work in progress
# committed and pushed on its branch, its board items given back (member_out), its task stopped, and the round handed
# back to its team (handback, which waits for runs still going on) with a free normal agent in its place; a
# coordinator replaced, the team gets a new one. Without a free agent the member waits its pause out, and the human
# hears of it
supervise_failovers() {
  local m id team agent wt branch keeper new t text until team_agents=() args=()
  for m in "$TASKS"/*/meta.env; do
    grep -qx 'FAILOVER_PENDING=1' "$m" 2> /dev/null || continue
    id=$(basename "$(dirname "$m")")
    task_held "$id" && continue   # its team is paused by the human: decided after agent unpause
    meta_set "$id" FAILOVER_PENDING ""
    [[ $(task_field "$id" STATUS) == paused ]] || continue   # it went on meanwhile
    if [[ $(task_field "$id" KIND) == helper ]]; then helper_failover "$id"; continue; fi
    team=$(task_field "$id" TEAM); agent=$(task_field "$id" AGENT)
    team_agents=() keeper=""
    for t in $(grep -lx "TEAM=$team" "$TASKS"/*/meta.env 2> /dev/null | xargs -r -n1 dirname | xargs -r -n1 basename); do
      [[ $t != "$id" ]] || continue
      team_agents+=("$(task_field "$t" AGENT)")
      [[ -n $keeper || $(task_field "$t" STATUS) == stopped ]] || keeper=$t
    done
    new=$(failover_agent "$agent" "${team_agents[@]}")
    if [[ -z $new || -z $keeper ]]; then
      log_warn failover_no_agent "task=$id" "agent=$agent" "team=$team"
      notify "$id" paused "" "⏸ $agent is out of service in team $team, and no free normal agent can take its place: it waits its pause out"
      continue
    fi
    until=$(task_field "$id" FAILOVER_UNTIL)
    wt=$(task_field "$id" WORKTREE); branch=$(task_field "$id" BRANCH)
    if [[ -n $(git -C "$wt" status --porcelain 2> /dev/null) ]]; then   # its work in progress, for the team
      { git -C "$wt" add -A && git -C "$wt" -c user.name="$agent (team-agents)" -c user.email="$agent@team-agents.invalid" \
          commit -q --no-verify -m "wip: $agent hands its work over (its model is out of service)"; } 10>&- \
        || log_warn failover_wip_failed "task=$id"
    fi
    git -C "$wt" push -q origin "HEAD:$branch" 10>&- 2> /dev/null || log_warn failover_push_failed "task=$id" "branch=$branch"
    member_out "$id" "replaced by $new: its model is out of service"
    "$SELF" stop "$id" > /dev/null 2>&1 || log_warn failover_stop_failed "task=$id"
    team_agents+=("$new")
    args=(run --resume "$team" --same-round --autopilot --team "$(IFS=,; echo "${team_agents[*]}")")
    text="$agent is out of this round: its model is out of service (overloaded at the provider, or out of quota)$(
      [[ ! $until =~ ^[0-9]+$ ]] || date -d "@$until" '+ until %H:%M')). $new takes its place. $agent's work is on its branch $branch, its board items are back on the board: go on with the round's work."
    if handback "$keeper" "the round" "" "${args[@]}" "$text"; then
      log_info failover_done "task=$id" "agent=$agent" "by=$new" "team=$team"
      notify "$id" stopped "" "🔁 $agent is replaced by $new in team $team: its model is out of service"
    else
      log_error failover_failed "task=$id" "reason=${HANDBACK_OUT:0:300}"
      handover_failed "$keeper" "the round" "$HANDBACK_OUT"
    fi
  done
}

# supervise_board — the boards of the teams at work (their coordinator's automation allowed, a member asleep, one at
# work within AGENT_BOARD_RECENT_H). An easy item nobody owns, waiting AGENT_EASY_TO_WORKER_MIN, in a team
# with no worker member, goes to a worker: the script claims it for the coordinator and delegates it as the
# coordinator's request, whose result the coordinator gets. A team whose members all sleep while items wait
# AGENT_BOARD_STALL_MIN tells the human ⛔ — once for the same items (stall-<team> under the bus directory).
supervise_board() {
  local m team lead lt tj board now id upd title details age stale mark repo a mt last out
  local -A teams_seen=()
  now=$(date +%s)
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue   # no task at all: the pattern is left as it is
    team=$(sed -n 's/^TEAM=//p' "$m" 2> /dev/null) || continue
    [[ -n $team && -z ${teams_seen[$team]:-} ]] || continue
    teams_seen[$team]=1
    team_paused "$team" && continue   # paused by the human: its board waits with it
    tj=$(team_json "$team" 2> /dev/null) || continue
    [[ -n $tj && $(jq -r '.finished // false' <<< "$tj") != true ]] || continue
    lead=$(jq -r '.lead // empty' <<< "$tj")
    [[ -n $lead ]] || continue
    lt=$(jq -r --arg l "$lead" '.members[$l].task // empty' <<< "$tj")
    # only a team at work: not stopped by the human, and a member asleep waiting for work — not one stopped
    # (agent stop leaves its bus record open), nor an old one whose members are done
    automation_allowed "$lt" || continue
    [[ $(jq '[.members[] | select(.state == "sleeping")] | length' <<< "$tj") != 0 ]] || continue
    last=0   # and lately: a member at work within AGENT_BOARD_RECENT_H — not an old team never closed
    for a in $(jq -r '.members[].task // empty' <<< "$tj"); do
      mt=$(stat -c %Y "$TASKS/$a/activity.jsonl" 2> /dev/null) || continue
      ((mt <= last)) || last=$mt
    done
    ((now - last <= AGENT_BOARD_RECENT_H * 3600)) || continue
    board=$(bus board-dump --dir "$BUS_DIR" --team "$team" 2> /dev/null) || continue
    if [[ -n $lt && ${#WORKER_AGENTS[@]} -gt 0 && $(jq '[.members[] | select(.tier == "worker")] | length' <<< "$tj") == 0 ]]; then
      while IFS=$'\t' read -r id upd title details; do
        age=$((now - $(date -d "$upd" +%s 2> /dev/null || echo "$now")))
        ((age >= AGENT_EASY_TO_WORKER_MIN * 60)) || continue
        bus board-claim --dir "$BUS_DIR" --team "$team" --as "$lead" --id "$id" > /dev/null 2>&1 || continue
        if out=$(bus delegate --dir "$BUS_DIR" --team "$team" --as "$lead" --task "$lt" --repo "$(task_field "$lt" REPO_NAME)" \
            --branch "$(task_field "$lt" BRANCH)" --worktree "$(task_field "$lt" WORKTREE)" --agent-cmd "$SELF" --home "$AGENTS_HOME" \
            --request "$title — board item $id of team $team: $details" \
            --context "The coordinator $lead holds the item: your result goes to it." 2>&1); then
          log_info easy_item_to_worker "team=$team" "item=$id" "for=$lead"
        else   # the coordinator holds the item now: it hears why no worker got it
          log_warn easy_item_to_worker_failed "team=$team" "item=$id" "reason=${out:0:300}"
          try easy_item_message_failed bus send --dir "$BUS_DIR" --from agent --to "$lead" \
            "Easy board item $id ($title) is yours now: it could not go to a worker — ${out:0:400}. Do it yourself, or rewrite it as a request a worker can do and delegate it." > /dev/null
        fi
      done < <(jq -r '.board // {} | (if type == "object" then .[] else .[] end)
        | select(.status == "todo" and .level == "easy" and ((.for // "") == "")) | [.id, .updated, .title, ((.details // "") | gsub("[\t\n]"; " "))] | @tsv' <<< "$board")
      board=$(bus board-dump --dir "$BUS_DIR" --team "$team" 2> /dev/null) || continue
    fi
    mark=$BUS_DIR/stall-$team
    if [[ $(jq '[.members[] | select(.state == "active")] | length' <<< "$tj") != 0 ]]; then rm -f "$mark"; continue; fi
    stale=""
    while IFS=$'\t' read -r id upd; do
      age=$((now - $(date -d "$upd" +%s 2> /dev/null || echo "$now")))
      ((age >= AGENT_BOARD_STALL_MIN * 60)) && stale+="${stale:+ }$id"
    done < <(jq -r '.board // {} | (if type == "object" then .[] else .[] end) | select(.status == "todo") | [.id, .updated] | @tsv' <<< "$board")
    [[ -n $stale && $(cat "$mark" 2> /dev/null) != "$stale" ]] || continue
    echo "$stale" > "$mark"
    log_warn board_stall "team=$team" "items=$stale"
    repo=$(task_field "$lt" REPO_NAME)
    push_text "$repo" "⛔ Team $team is at a standstill: its members all sleep, and board items wait that nobody takes: $stale" \
      "Wake its coordinator with what to do: agent run --resume $team --same-round \"…\""
  done
}

# supervise_handbacks — a hand-back waiting for the team's runs (HANDBACK_PENDING) is tried again once they end; a
# run that goes on past AGENT_HANDBACK_WAIT_MIN is stopped first — that one alone. A hand-back the human stopped, or
# that has nothing to hand back, waits no more
supervise_handbacks() {
  local m id f what envspec team since now t a=() running_tasks=()
  now=$(date +%s)
  for m in "$TASKS"/*/meta.env; do
    grep -qx 'HANDBACK_PENDING=1' "$m" 2> /dev/null || continue
    id=$(basename "$(dirname "$m")"); f=$TASKS/$id/handback.args
    task_held "$id" && continue   # its team is paused by the human
    if [[ ! -s $f ]] || ! automation_allowed "$id"; then
      meta_set "$id" HANDBACK_PENDING ""
      continue
    fi
    mapfile -d '' -t a < "$f"
    what=${a[0]} envspec=${a[1]}
    team=$(task_field "$id" TEAM) running_tasks=()
    if [[ -n $team ]]; then
      for t in $(grep -lx "TEAM=$team" "$TASKS"/*/meta.env 2> /dev/null | xargs -r -n1 dirname | xargs -r -n1 basename); do
        case $(task_field "$t" STATUS) in new|starting|running|waiting|investigating|sleeping|paused) running_tasks+=("$t") ;; esac
      done
    fi
    since=$(task_field "$id" HANDBACK_SINCE); since=${since:-$now}
    if ((${#running_tasks[@]})); then
      ((now - since >= AGENT_HANDBACK_WAIT_MIN * 60)) || continue   # the team's runs still go on: it waits
      for t in "${running_tasks[@]}"; do
        if "$SELF" stop "$t" > /dev/null 2>&1; then
          log_warn handback_stopped_run "task=$t" "for=$id" "waited_min=$(( (now - since) / 60 ))"
        else
          log_warn handback_stop_failed "task=$t" "for=$id"
        fi
      done
    fi
    if handback "$id" "$what" "$envspec" "${a[@]:2}"; then
      if [[ $(task_field "$id" HANDBACK_PENDING) != 1 ]]; then
        act "$id" info "$what went back to the team"
        auto_stage "$id" ""
        log_info handback_done "task=$id" "what=$what"
      fi
    else
      log_error handback_failed "task=$id" "reason=${HANDBACK_OUT:0:300}"
      meta_set "$id" HANDBACK_PENDING ""
      handover_failed "$id" "$what" "$HANDBACK_OUT"
    fi
  done
}

# handover_failed task what output — the team could not take its work back (its resume was refused): the human
# decides, and hears why — the stage "waits for you: …" (also said on the PR, by auto_stage), and the notification
handover_failed() {
  local id=$1 what=$2 out=$3 why
  why=$( { grep -m1 '^agent: ' <<< "$out" || (($? == 1)); } | sed 's/^agent: //' | cut -c1-200)   # the refusal's own words
  [[ -n $why ]] || why=$(tail -n 1 <<< "$out" | cut -c1-200)
  auto_stage "$id" "waits for you: $what could not go back to the team — $why"
  local text=$TASKS/$id/handback.md   # what the team was to do: to resume it with
  notify "$id" failed "" "⛔ $what could not go back to the team: $why — once that is fixed: agent run --resume $(task_field "$id" TEAM) --same-round$(
    [[ ! -s $text ]] || printf ' — what the team was to do: %s' "$text")"
}

# team_lead_task team agent — the team's task of that agent (its coordinator), the newest; "" when there is none
team_lead_task() {
  local m d best=""
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    grep -qx "TEAM=$1" "$m" && grep -qx "AGENT=$2" "$m" || continue
    d=${m%/meta.env}; best=${d##*/}
  done
  printf '%s' "$best"
}

# review_without_verdict review-task why — a review run ended without a verdict (failed, hung, stopped). In an
# --autopilot pair it is a review with no verdict (review_pair_done decides what follows); a single review stays
# the human's, as its notification says.
review_without_verdict() {
  local id=$1 why=$2 parent pair
  parent=$(task_field "$id" PARENT_TASK); [[ -n $parent ]] || return 0
  pair=$(task_field "$parent" REVIEW_PAIR); [[ -n $pair ]] || return 0
  log_warn review_without_verdict "task=$parent" "review=$id" "reason=${why:0:200}"
  review_pair_done "$id" "$parent" "$pair" none ""
}

# review_hands_over reason seconds — whether a pair's review paused for this reason this long goes to another
# investigator at once: on an exhausted quota always; on a model overloaded at the provider past
# AGENT_REVIEW_OVERLOAD_WAIT_MIN; not on a rate limit (the account's, short) nor on a short overload
review_hands_over() {
  case $1 in
    quota) return 0 ;;
    overloaded) (($2 > AGENT_REVIEW_OVERLOAD_WAIT_MIN * 60)) ;;
    *) return 1 ;;
  esac
}

# retry_review_slot parent pair-dir slot — that review again, by a free investigator other than the pair's two; with
# none free it waits (REVIEW_SLOT_PENDING, started by a later dispatch)
retry_review_slot() {
  local parent=$1 dir=$2 slot=$3 name
  automation_allowed "$parent" || return 0
  name=$(free_investigator_list | { grep -vxF -e "$(cat "$dir/A.agent" 2>/dev/null)" -e "$(cat "$dir/B.agent" 2>/dev/null)" || (($? == 1)); } | head -n 1)
  if [[ -z $name ]]; then
    meta_set "$parent" REVIEW_SLOT_PENDING "$slot"
    act "$parent" info "--autopilot: review $slot gave no verdict — it is done again once a third investigator is free"
    auto_stage "$parent" "two reviews: review $slot waits for a third free investigator"
    return 0
  fi
  start_review_slot "$parent" "$dir" "$slot" "$name" fresh || return 1
  meta_set "$parent" REVIEW_SLOT_PENDING ""
  act "$parent" info "--autopilot: review $slot gave no verdict — done again by $name"
  auto_stage "$parent" "$(pair_stage "$dir")"
}

review_pair_done() { # review-task parent pair-dir verdict text — one review of an --autopilot pair has ended; when
  # both have: both ready-to-merge = the PR is ready; a review without a verdict = the human decides; else the team
  # goes on with the review(s) that found problems
  local id=$1 parent=$2 dir=$3 verdict=$4 text=$5 slot other va vb combined="" s n=0
  automation_allowed "$parent" || return 0
  local myinv; myinv=$(task_field "$id" INV_ID)
  if [[ $(cat "$dir/A.inv" 2>/dev/null) == "$myinv" ]]; then slot=A
  elif [[ $(cat "$dir/B.inv" 2>/dev/null) == "$myinv" ]]; then slot=B
  else   # a review the pair no longer waits for (done again by another investigator since): not this pair's
    log_warn review_pair_stale "task=$parent" "review=$id" "investigation=$myinv"
    return 0
  fi
  other=B; [[ $slot == A ]] || other=A
  # the two reviews end in two runners, often in the same second: recording a verdict and taking the decision are
  # done under the pair's lock, so that exactly one of them decides (two merges or two fix passes would race)
  local decide
  if ! decide=$(
      exec 9>"$dir/pair.lock"
      flock -w 60 9 || exit 1
      printf '%s' "$verdict" > "$dir/$slot.verdict"
      [[ -z $text ]] || printf '%s' "$text" > "$dir/$slot.md"   # a run without a verdict leaves no review text
      if [[ -f $dir/$other.verdict && ! -f $dir/decided ]]; then : > "$dir/decided"; printf yes; fi
    ); then
    log_error review_pair_lock_failed "task=$parent" "pair=$dir"
    return 0
  fi
  if [[ $decide != yes ]]; then
    log_info review_pair_waiting "task=$parent" "done=$slot" "verdict=$verdict"
    auto_stage "$parent" "$(pair_stage "$dir")"
    return 0
  fi
  va=$(<"$dir/A.verdict"); vb=$(<"$dir/B.verdict")
  log_info review_pair_done "task=$parent" "A=$va" "B=$vb"
  if [[ $va == ready-to-merge && $vb == ready-to-merge ]]; then
    meta_set "$parent" REVIEW_RESULT approved
    if start_task_unit "$parent" _merge; then   # the merge, the gate on the base, the next round: minutes
      act "$parent" info "--autopilot: both reviews ready to merge — the merge started"
    else
      notify "$parent" approved "" "both reviews: ready to merge — the merge could not start: merge PR #$(task_field "$parent" PR_NUMBER) yourself: $(task_field "$parent" PR_URL)"
    fi
    return 0
  fi
  if [[ $va == none || $vb == none ]]; then
    local fs=A vo=$vb   # the review without a verdict, and the other's verdict
    [[ $va == none ]] || { fs=B; vo=$va; }
    # the other ready to merge: the review without a verdict is done again, once, by another investigator
    if [[ $vo == ready-to-merge && ! -f $dir/$fs.retried ]]; then
      : > "$dir/$fs.retried"
      rm -f "$dir/decided" "$dir/$fs.verdict"
      if retry_review_slot "$parent" "$dir" "$fs"; then return 0; fi
    fi
    # the other asks for changes: that decides — the fix pass goes on with its findings
    if [[ $vo != needs-fixes && $vo != incomplete ]]; then
      meta_set "$parent" REVIEW_RESULT failed
      auto_stage "$parent" "waits for you: a review gave no verdict"
      notify "$parent" failed "" "a review of PR #$(task_field "$parent" PR_NUMBER) gave no verdict${vo:+ (the other: $vo)} — your decision is needed: $(task_field "$parent" PR_URL)"
      return 0
    fi
  fi
  meta_set "$parent" REVIEW_RESULT fixes
  for s in A B; do
    case $(<"$dir/$s.verdict") in ready-to-merge|none) continue ;; esac
    combined+="## Review by $(<"$dir/$s.agent") — $(<"$dir/$s.verdict")"$'\n\n'"$(<"$dir/$s.md")"$'\n\n'
    n=$((n + $(findings_count "$(<"$dir/$s.md")")))
  done
  review_fix_pass "$parent" "$n" "$combined"
}

free_investigator_list() { # every free investigator (not working, not waiting for the human's answers, its provider's
  # quota not spent), one per line
  local inv d busy qu now
  now=$(date +%s)
  while read -r inv; do
    busy=0
    for d in "$TASKS"/*/; do
      [[ -f $d/meta.env ]] || continue
      d=${d%/}; d=${d##*/}
      if [[ $(task_field "$d" KIND) == investigation_team && $(task_field "$d" INVESTIGATION_LEASE) == 1 ]]; then
        if [[ ,$(task_field "$d" INVESTIGATION_TEAM), == *",$inv,"* ]]; then busy=1; break; fi
      fi
      [[ $(task_field "$d" AGENT) == "$inv" && $(task_field "$d" KIND) == investigation ]] || continue
      case $(task_field "$d" STATUS) in new|starting|running|waiting) busy=1; break ;; esac
      qu=$(task_field "$d" QUOTA_UNTIL)
      if [[ -n $qu ]] && ((qu > now)); then busy=1; break; fi   # out of quota until then
    done
    ((busy)) || printf '%s\n' "$inv"
  done < <(investigator_names)
}

# review_history_add a b — appends a pair that started its reviews to the review history ($AGENTS_HOME/reviews/history:
# one pair a line, "a b" in name order, oldest first, the last REVIEW_HISTORY_MAX kept), in every AGENT_REVIEW_DRAW
# mode, so that a switch to rotate starts from the real history; called under the dispatch lock (one writer). A
# failure to write it is logged: the reviews have started, and the next pair is then only less well rotated.
review_history_add() {
  local f="$AGENTS_HOME/reviews/history"
  mkdir -p "$AGENTS_HOME/reviews"
  if ! { { [[ ! -f $f ]] || tail -n $((REVIEW_HISTORY_MAX - 1)) "$f"; } && review_pair_key "$1" "$2"; } > "$f.tmp.$$" \
    || ! mv "$f.tmp.$$" "$f"; then
    log_warn review_history_failed "pair=$1,$2"
    rm -f "$f.tmp.$$"
  fi
}

# review_pair_key a b — a pair as the history writes it: its two names in name order, "a b"
review_pair_key() { if [[ $1 < $2 ]]; then printf '%s %s\n' "$1" "$2"; else printf '%s %s\n' "$2" "$1"; fi; }

# review_pair_reviewed pair-dir — 0 when the PR's last pair has reviewed it (a verdict of its last pass is there, as
# review_pair_done writes it): that pair does not review the PR again while another pair can
review_pair_reviewed() { [[ -f $1/A.verdict || -f $1/B.verdict ]]; }

# review_model_key name — an investigator's CLI and model ("codex/gpt-6-astra"), so that a pair can avoid the models
# of the last one; a name the configuration does not have (an old history's): "name:<name>", its own model
review_model_key() {
  if [[ -n ${INVESTIGATORS_TYPE[$1]:-} ]]; then
    printf '%s/%s\n' "${INVESTIGATORS_TYPE[$1]}" "${INVESTIGATORS_MODEL[$1]:-default}"
  else
    printf 'name:%s\n' "$1"
  fi
}

# review_pair_candidates level avoid name... — the pairs of those investigators (given in list order) that a review
# may take at that level, one "ov mo pl ms a b" line each, in list order: strict = neither avoid (the pair that
# reviewed the PR last, "a b" in name order; empty: none) nor, except AGENT_REVIEW_DRAW=list, one of the last two
# pairs of the review history; avoid = not avoid; any = every pair. ov = its members in avoid or in the history's last
# pair, mo = its members whose model (review_model_key) one of those has, pl = the newest history line (1-based) with
# the pair, ms = the sum of the newest lines with each member (0 = never). AGENT_REVIEW_DRAW=list reads no history.
review_pair_candidates() {
  local level=$1 avoid=$2 hist=() n i j k a b key last="" prev="" ov mo pl ma mb x used=" "
  shift 2
  if [[ $AGENT_REVIEW_DRAW != list && -f $AGENTS_HOME/reviews/history ]]; then mapfile -t hist < "$AGENTS_HOME/reviews/history"; fi
  n=${#hist[@]}
  ((n < 1)) || last=${hist[n - 1]}
  ((n < 2)) || prev=${hist[n - 2]}
  for x in $last $avoid; do used+="$(review_model_key "$x") "; done
  for ((i = 1; i <= $#; i++)); do
    for ((j = i + 1; j <= $#; j++)); do
      a=${!i} b=${!j}
      key=$(review_pair_key "$a" "$b")
      [[ $level == any || $key != "$avoid" ]] || continue
      [[ $level != strict || ($key != "$last" && $key != "$prev") ]] || continue
      ov=0
      [[ " $last $avoid " != *" $a "* ]] || ov=$((ov + 1))
      [[ " $last $avoid " != *" $b "* ]] || ov=$((ov + 1))
      mo=0
      [[ $used != *" $(review_model_key "$a") "* ]] || mo=$((mo + 1))
      [[ $used != *" $(review_model_key "$b") "* ]] || mo=$((mo + 1))
      pl=0 ma=0 mb=0
      for ((k = 0; k < n; k++)); do
        [[ ${hist[k]} != "$key" ]] || pl=$((k + 1))
        [[ " ${hist[k]} " != *" $a "* ]] || ma=$((k + 1))
        [[ " ${hist[k]} " != *" $b "* ]] || mb=$((k + 1))
      done
      printf '%d %d %d %d %s %s\n' "$ov" "$mo" "$pl" $((ma + mb)) "$a" "$b"
    done
  done
}

# review_pair_select level avoid name... — the pair of those investigators a review takes at that level
# (review_pair_candidates), "a b" in list order; 1 = none. Of the pairs with the fewest members of the last pair, then
# the fewest of its models: AGENT_REVIEW_DRAW=rotate the pair used least recently (or never), then its members' reviews
# least recent, then the list's order; random of the pairs used least recently (or never) one drawn at random
# (AGENT_REVIEW_SEED fixes the draw, for the tests), so that four investigators make all six pairs before one repeats;
# list the first.
review_pair_select() {
  local lines=() tops=() min line a b keys=1,2
  mapfile -t lines < <(review_pair_candidates "$@")
  ((${#lines[@]})) || return 1
  [[ $AGENT_REVIEW_DRAW != random ]] || keys=1-3   # random: the pair's recency too
  if [[ $AGENT_REVIEW_DRAW == rotate ]]; then
    line=$(printf '%s\n' "${lines[@]}" | sort -s -n -k1,1 -k2,2 -k3,3 -k4,4 | head -n 1)
  else
    min=$(printf '%s\n' "${lines[@]}" | sort -s -n -k1,1 -k2,2 -k3,3 | head -n 1 | cut -d' ' -f"$keys")
    for line in "${lines[@]}"; do [[ $(cut -d' ' -f"$keys" <<< "$line") != "$min" ]] || tops+=("$line"); done
    line=${tops[0]}
    if [[ $AGENT_REVIEW_DRAW == random ]]; then
      [[ -z ${AGENT_REVIEW_SEED:-} ]] || RANDOM=$AGENT_REVIEW_SEED
      line=${tops[RANDOM % ${#tops[@]}]}
    fi
  fi
  read -r _ _ _ _ a b <<< "$line"
  printf '%s %s\n' "$a" "$b"
}

# review_pair_next coordinator-task avoid free-investigator... — the next pair among the free investigators: never the
# pair that reviewed the PR last (avoid) nor (rotate, random) one of the last two pairs. When only a busy investigator
# makes such a pair it waits (1) AGENT_REVIEW_ROTATE_WAIT_MIN from the pair's request, then takes the best free pair
# that is not the PR's (logged as review_pair_repeated). The PR's own pair it waits for as long as it takes: with
# three or more investigators the PR's pair never reviews it again. With two investigators their pair at once
review_pair_next() {
  local id=$1 avoid=$2 all=() since level pair
  shift 2
  mapfile -t all < <(investigator_names)
  for level in strict avoid; do
    if pair=$(review_pair_select "$level" "$avoid" "$@"); then
      [[ $level == strict ]] || log_warn review_pair_repeated "task=$id" "free=$*"
      printf '%s\n' "$pair"
      return 0
    fi
    review_pair_select "$level" "$avoid" "${all[@]}" > /dev/null || continue
    [[ $level == strict ]] || return 1   # a pair other than the PR's exists, with a busy investigator: wait for it
    since=$(task_field "$id" REVIEW_PAIR_SINCE)
    (($(date +%s) - ${since:-0} >= AGENT_REVIEW_ROTATE_WAIT_MIN * 60)) || return 1
  done
  log_warn review_pair_repeated "task=$id" "free=$*"   # no pair but the PR's own: two investigators
  review_pair_select any "$avoid" "$@"
}

start_review_pairs() { # under the dispatch lock: a pending --autopilot review pair starts once two investigators are free
  local m
  for m in "$TASKS"/*/meta.env; do
    if grep -qE '^REVIEW_SLOT_PENDING=[AB]$' "$m"; then   # one review of a pair to do again
      m=${m%/meta.env}
      retry_review_slot "${m##*/}" "$(task_field "${m##*/}" REVIEW_PAIR)" "$(task_field "${m##*/}" REVIEW_SLOT_PENDING)" \
        || log_error review_retry_failed "task=${m##*/}"
      continue
    fi
    grep -qx 'REVIEW_PAIR_PENDING=1' "$m" || continue
    m=${m%/meta.env}
    start_review_pair "${m##*/}" || return 0   # not two free investigators yet: the next dispatch tries again
  done
}

start_review_pair() { # coordinator task — both reviews of its PR at once, on two different free investigators: the
  # next pair (review_pair_next: never the pair that reviewed this PR last, nor one of the last two pairs; drawn at
  # random, the first free ones of the list, or AGENT_REVIEW_DRAW=rotate the rotation's next). A pass whose pair never
  # ended its reviews keeps it, when free (random, list). 1 = not two free ones yet, or the pair waits for a busy one
  local id=$1 free=() dir a="" b="" pa="" pb="" avoid="" f slot name j num
  if ! automation_allowed "$id"; then meta_set "$id" REVIEW_PAIR_PENDING ""; return 0; fi
  mapfile -t free < <(free_investigator_list)
  ((${#free[@]} >= 2)) || return 1
  num=$(task_field "$id" PR_NUMBER)
  dir="$AGENTS_HOME/reviews/$(task_field "$id" REPO_NAME)-$num"
  [[ ! -f $dir/A.agent ]] || pa=$(<"$dir/A.agent")
  [[ ! -f $dir/B.agent ]] || pb=$(<"$dir/B.agent")
  if [[ -n $pa && -n $pb ]] && review_pair_reviewed "$dir"; then avoid=$(review_pair_key "$pa" "$pb"); fi
  if [[ $AGENT_REVIEW_DRAW != rotate && -z $avoid ]]; then
    for f in "${free[@]}"; do [[ $f != "$pa" ]] || a=$f; [[ $f != "$pb" ]] || b=$f; done
  fi
  if [[ -z $a && -z $b ]]; then   # both chosen, in list order
    f=$(review_pair_next "$id" "$avoid" "${free[@]}") || return 1
    read -r a b <<< "$f"
  else   # one kept: the other is drawn at random among the free ones (list: the first)
    local pool=()
    for f in "${free[@]}"; do [[ $f == "$a" || $f == "$b" ]] || pool+=("$f"); done
    [[ -z ${AGENT_REVIEW_SEED:-} ]] || RANDOM=$AGENT_REVIEW_SEED   # a fixed draw, for the tests
    if ((${#pool[@]})) && [[ -z $a || -z $b ]]; then
      j=0
      [[ $AGENT_REVIEW_DRAW == list ]] || j=$((RANDOM % ${#pool[@]}))
      if [[ -z $a ]]; then a=${pool[j]}; else b=${pool[j]}; fi
    fi
  fi
  mkdir -p "$dir"
  [[ -n $a && -n $b && $a != "$b" ]] || return 1
  for slot in A B; do
    name=$a; [[ $slot == A ]] || name=$b
    rm -f "$dir/$slot.retried"   # a new pair: each review may be done again once
    start_review_slot "$id" "$dir" "$slot" "$name" || return 1
  done
  rm -f "$dir/decided"   # a new pair decides anew
  review_history_add "$a" "$b"
  meta_set "$id" REVIEW_PAIR_PENDING ""
  meta_set "$id" REVIEW_SLOT_PENDING ""
  meta_set "$id" REVIEW_PAIR "$dir"
  act "$id" info "--autopilot: two reviews of PR #$num started — $a and $b, each on its own"
  auto_stage "$id" "two reviews: $a (#$(cat "$dir/A.inv")), $b (#$(cat "$dir/B.inv"))"
}

# start_review_slot coordinator-task pair-dir slot investigator [fresh] — one review of the pair (A or B) on that
# investigator; a re-review after a fix pass gets its slot's previous review (its own, or — rotated — another
# investigator's), unless fresh (a review done again)
start_review_slot() {
  local id=$1 dir=$2 slot=$3 name=$4 fresh=${5:-} num url q inv j by=""
  num=$(task_field "$id" PR_NUMBER); url=$(task_field "$id" PR_URL)
    q="Review PR #$num ($url) — one of two independent reviews: do not read other reviews or review comments on this PR before your own is published."
    if [[ -z $fresh && -s $dir/$slot.md && -n $(task_field "$id" FIX_PASS) && $(task_field "$id" FIX_PASS) != 0 ]]; then
      [[ ! -f $dir/$slot.agent ]] || by=$(<"$dir/$slot.agent")   # who wrote it: the slot's investigator until now
      if [[ -z $by || $by == "$name" ]]; then
        q+=" Re-review after fix pass $(task_field "$id" FIX_PASS): first check whether the findings of your previous review below are fixed (or disputed convincingly on the PR), then the rest of the change only for new problems.

Your previous review:
$(head -c 6000 "$dir/$slot.md")"
      else
        q+=" Re-review after fix pass $(task_field "$id" FIX_PASS): first check whether the findings of the previous review below, by $by, are fixed (or disputed convincingly on the PR), then the rest of the change only for new problems.

The previous review, by $by:
$(head -c 6000 "$dir/$slot.md")"
      fi
    fi
    inv=$(bus inv-add --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --kind review \
            --from-agent "$(task_field "$id" AGENT)" --from-task "$id" --repo "$(task_field "$id" REPO_NAME)" \
            --branch "$(task_field "$id" BRANCH)" --tasks-dir "$TASKS" --question "$q" --pr-url "$url" --pr-number "$num") \
      || { log_error review_pair_add_failed "task=$id" "slot=$slot"; return 1; }
    bus inv-set --dir "$BUS_DIR" --id "$inv" --status starting >/dev/null || { log_error review_pair_start_failed "task=$id" "investigation=$inv"; return 1; }
    j=$(bus inv-get --dir "$BUS_DIR" --id "$inv")
    printf '%s' "$name" > "$dir/$slot.agent"; printf '%s' "$inv" > "$dir/$slot.inv"; rm -f "$dir/$slot.verdict"
    remember_investigator "$name"
    start_investigation "$j" "$name" || log_error investigation_start_failed "investigation=$inv" "investigator=$name"
}

request_review() { # coordinator task id — --verify: queue a PR review by an investigator
  local id=$1 root branch pr url num inv
  automation_allowed "$id" || return 0
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH)
  pr=$(try pr_lookup_failed round_pr_for "$id" number,url)
  url=$(jq_soft pr_lookup_parse -r '.[0].url // empty' <<< "${pr:-[]}")
  num=$(jq_soft pr_lookup_parse -r '.[0].number // empty' <<< "${pr:-[]}")
  if [[ -z $url ]]; then
    act "$id" err "--verify: the round has no PR — none on branch $branch, none given, none at its commit: no review"
    log_warn review_no_pr "task=$id" "branch=$branch"
    push_text "$(task_field "$id" REPO_NAME)" "⛔ Team $(task_field "$id" TEAM): --verify — the round ended with no PR, so it is not reviewed: none on its branch $branch, no round's PR given, no open PR at its commit." \
      "Open its PR (gh pr create --base $(task_field "$id" BASE) --head $branch), or resume the team that owns the round's PR with --same-round, or start a team on that PR with --pr <number>."
    return 0
  fi
  meta_set "$id" PR_NUMBER "$num"; meta_set "$id" PR_URL "$url"
  round_pr_supersede "$id" "$num" "$url"   # a round's earlier PR (another coordinator's) is closed for this one
  if [[ $(task_field "$id" AUTOPILOT) == 1 ]]; then   # two reviews at once, when two investigators are free
    meta_set "$id" REVIEW_PAIR_PENDING 1
    auto_stage "$id" "two reviews: waiting for two free investigators"
    meta_set "$id" REVIEW_PAIR_SINCE "$(date +%s)"
    act "$id" info "--autopilot: two reviews of PR #$num wait for two free investigators"
    dispatch
    return 0
  fi
  local pass question
  pass=$(task_field "$id" FIX_PASS); question="Review PR #$num ($url)"
  if ((${pass:-0} > 0)); then
    question+=" — re-review after fix pass $pass: first check whether the critical and major findings of the previous review are fixed (or disputed convincingly on the PR), then the rest of the change only for new problems"
  fi
  inv=$(bus inv-add --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --kind review \
          --from-agent "$(task_field "$id" AGENT)" --from-task "$id" --repo "$(task_field "$id" REPO_NAME)" \
          --branch "$branch" --tasks-dir "$TASKS" --question "$question" \
          --pr-url "$url" --pr-number "$num") || return 0
  meta_set "$id" REVIEW_INV "$inv"
  act "$id" info "--verify: review of PR #$num queued for an investigator (#$inv)"
}

team_after_run() { # id status final note — team logic after a member's run ends
  local id=$1 status=$2 final=$3 note=$4
  if task_stop_requested "$id"; then
    meta_set "$id" STATUS stopped
    [[ -z ${TEAM:-} ]] || try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state stopped >/dev/null
    return 0
  fi
  [[ $(task_field "$id" REMOTE_TEAM) != 1 ]] || return 0   # its team lives on the lead, which follows its state
  local team=$TEAM lead state
  lead=$(team_lead "$team")
  case $status in
    sleeping) state=sleeping ;;
    paused) state=paused ;;
    excluded) state=excluded ;;
    hung) state=hung ;;
    done|failed) state=done ;;
    stopped) state=stopped ;;
    *) state=active ;;
  esac
  try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$AGENT" --state "$state" >/dev/null

  if [[ $status == paused ]]; then
    local to until; to=$lead
    [[ -z $to || $to == "$AGENT" ]] && to="team:$team"
    local wake
    wake=$(task_field "$id" WAKE_AT)
    if [[ -z $wake ]]; then until="an unknown time"   # a remote member's note that gave none
    elif ((wake - $(date +%s) > 20 * 3600)); then until=$(date -d "@$wake" '+%d.%m %H:%M')
    else until=$(date -d "@$wake" '+%H:%M'); fi
    local released=""
    if [[ -n $wake ]] && ((wake - $(date +%s) > AGENT_RELEASE_PAUSE_MIN * 60)); then   # a long pause: the work goes on without it
      released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$AGENT" | paste -sd,)
      [[ -z $released ]] || meta_set "$id" PAUSE_RELEASED "$released"
    fi
    if [[ -n $released ]]; then
      notice member_paused agentbus "$to" "$AGENT IS PAUSED until $until: $note. Its items ($released) are back on the board with its progress notes — take them over; it resumes by itself at $until and takes new work from the board." \
        "agent=$AGENT" "team=$team" "until=$until" "reason=$(task_field "$id" PAUSE_REASON)" "released=$released"
    else
      notice member_paused agentbus "$to" "$AGENT IS PAUSED until $until: $note. Messages and board items do not wake it; it resumes by itself at $until and its claimed board items stay with it. If the work cannot wait, plan without it." \
        "agent=$AGENT" "team=$team" "until=$until" "reason=$(task_field "$id" PAUSE_REASON)"
    fi
    notify "$id" paused "$final" "$note"
    return 0
  fi

  if [[ $status == hung ]]; then
    local released tj nm
    released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$AGENT" | paste -sd,)
    tj=$(bus team-get --dir "$BUS_DIR" --team "$team")
    if [[ $(jq -r '[.members[] | select(.tier != "worker" and .state != "excluded")] | all(.state == "hung")' <<< "$tj") == true ]]; then
      finish_team "$team" "the coordinator and all normal models are hung"
      push_text "$REPO_NAME" "❌ Team $team aborted: the coordinator and all normal models are hung ($AGENT_HANG_STRIKES times in a row without progress)." \
        "Work state: pushed branches and checkpoints — to resume: agent run --resume $team" "$(team_summary "$team")"
      return 0
    fi
    for nm in $(jq -r '.members[] | select(.tier != "worker" and (.state == "active" or .state == "sleeping" or .state == "waking")) | .agent' <<< "$tj"); do
      if [[ $AGENT == "$lead" ]]; then
        notice coordinator_hung agentbus "$nm" "COORDINATOR $AGENT IS HUNG ($AGENT_HANG_STRIKES times without progress) and was switched off. Normal model: take over coordination (claim_lead), check the last checkpoint and the board, continue.${released:+ Its items ($released) are back on the board.}" \
          "agent=$AGENT" "team=$team" "released=$released"
      else
        notice agent_hung agentbus "$nm" "$AGENT IS HUNG ($AGENT_HANG_STRIKES times without progress) and was switched off.${released:+ Its items ($released) are back on the board.} Take over its work." \
          "agent=$AGENT" "team=$team" "released=$released"
      fi
    done
    return 0
  fi

  if [[ $AGENT == "$lead" ]]; then
    case $status in
      waiting) notify "$id" waiting "$final" "questions from the coordinator of team $team (members sleep until answered)" ;;
      failed)   # a failure is not the end of the team's work: the coordinator is out, the others go on
        local next   # the role handed over first: the news wakes the members, and one may claim it before the script
        next=$(coordinator_takeover "$team" "$AGENT" "its run failed${note:+ ($note)}") || next=""
        member_out "$id" "the coordinator's run failed${note:+ ($note)}" "$next"
        push_text "$REPO_NAME" "⚠ The coordinator $AGENT of team $team failed${note:+ ($note)}. The team stays open: ${next:+$next coordinates it now.}${next:-its members were told to take over coordination.}" \
          "To resume it yourself: agent run --resume $team --same-round \"…\""
        return 0 ;;
      done)
        finish_team "$team" "team task finished by the coordinator ($AGENT)"
        if [[ $status == done && $(task_field "$id" VERIFY) == 1 ]]; then
          start_precheck "$id"   # the checks before the review, then the review — in their own unit
          note="${note:+$note; }the round goes to review once its head passes the checks"
        fi
        notify "$id" "$status" "$final" "${note:+$note; }team $team:
$(team_summary "$team")" ;;
    esac
  else
    case $status in
      waiting) notify "$id" waiting "$final" "a member of team $team asked you directly (should have asked the coordinator)" ;;
      failed) member_out "$id" "its run failed${note:+ ($note)}; its last message: ${final:0:300}" ;;
      done)
        local back   # out of the team: its items, claimed or designated, go back to the board
        back=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$AGENT" | paste -sd,)
        [[ -z $back ]] || log_info member_items_back "task=$id" "agent=$AGENT" "items=$back"
        if [[ -n $lead && $(team_done_flag "$team") != true ]]; then
          notice member_finished agentbus "$lead" "TEAM: member $AGENT finished (STATUS: DONE).${back:+ Its items ($back) are back on the board.}" "agent=$AGENT" "team=$team"
        fi ;;
    esac
  fi

  # everyone finished without the coordinator closing the team / everyone sleeps = the team is stuck — unless a
  # member waits for a worker or an investigation it asked for: that result wakes it
  [[ $(team_done_flag "$team") == true ]] && return 0
  local stuck_file="$TASKS/.team-$team.stuck"
  team_all() { # done|sleep — are all members in the given set of states
    local t st
    for t in $(team_tasks "$team"); do
      st=$(task_field "$t" STATUS)
      case $1:$st in
        done:done|done:failed|done:stopped|done:excluded|done:hung) ;;
        sleep:sleeping|sleep:done|sleep:failed|sleep:stopped|sleep:excluded|sleep:hung) ;;
        *) return 1 ;;
      esac
    done
  }
  if team_all done; then
    finish_team "$team" "all members finished"
    local ltask
    ltask=$(team_lead_task "$team" "$lead")
    if [[ -n $ltask && $(task_field "$ltask" VERIFY) == 1 ]]; then   # its coordinator out: the round still goes to review
      start_precheck "$ltask"
      act "$ltask" info "all members finished — the round goes to review once its head passes the checks"
    fi
    push_text "$REPO_NAME" "⚠ Team $team finished without being closed by its coordinator:" "$(team_summary "$team")"
  elif team_all sleep && ! team_waits_on_others "$team" && { sleep 3   # a pending wake-up gets a moment; re-check
         [[ $(team_done_flag "$team") != true ]] && team_all sleep && ! team_all done; }; then
    local n=1
    [[ -f $stuck_file ]] && n=$(( $(<"$stuck_file") + 1 ))
    echo "$n" > "$stuck_file"
    if ((n == 1)) && [[ -n $lead ]]; then
      notice team_stuck agentbus "$lead" \
        "TEAM STUCK: all members are asleep. As the coordinator, check the state (team_status, read_messages) and either assign work or finish the team task (STATUS: DONE). Waiting for the human to merge a PR? Then end the round instead of sleeping: STATUS: ROUND_DONE N/M." \
        "team=$team"
    elif ((n == 2)); then
      push_text "$REPO_NAME" "⛔ Team $team is stuck: all members are asleep and waking the coordinator did not help." \
        "See: agent live. Nudge them with a message (m / agent say) or stop: agent stop <coordinator task id>. If the coordinator waits for you to merge a PR: merge it, then tell it so (agent say)." \
        "$(team_summary "$team")"
    fi
  else
    rm -f "$stuck_file"
  fi
}

cmd__wake() { # id — a sleeping team member received a message, or the timer of a paused task fired
  stopping && return 0
  local id; id=$(resolve_id "${1:?}")
  exec 8>"$TASKS/$id/wake.lock"
  flock -w 30 8 || exit 0
  meta_load "$id"
  if task_stop_requested "$id"; then
    [[ $STATUS == stopped ]] || meta_set "$id" STATUS stopped
    [[ -z ${TEAM:-} ]] || try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state stopped >/dev/null
    log_info automation_stopped "task=$id" "reason=human stop"
    exit 0
  fi
  automation_allowed "$id" || return 0
  [[ -z ${WAKE_DEFERRED:-} ]] || meta_set "$id" WAKE_DEFERRED ""
  if [[ ${KIND:-} == remote-member ]]; then   # the member works on its node: the lead asks the node to wake it
    try remote_wake_failed bus lead-member --dir "$BUS_DIR" --wake --member "$AGENT" >/dev/null
    exit 0
  fi
  if [[ ${REMOTE_TEAM:-} == 1 ]]; then   # this node's member of a team on the lead: the lead woke it
    if [[ $STATUS == sleeping || $STATUS == interrupted ]]; then   # interrupted: its machine restarted
      meta_set "$id" WAKE_PENDING 1
      start_runner "$id" resume || log_error resume_failed "task=$id" "reason=a wake from the lead"
    fi
    exit 0
  fi
  if [[ $STATUS == paused ]]; then
    resume_paused "$id"
    exit 0
  fi
  [[ -n ${TEAM:-} ]] || exit 0
  log_info wake_requested "task=$id" "agent=$AGENT" "team=$TEAM"
  local mstate
  mstate=$(team_json "$TEAM" | jq -r --arg a "$AGENT" '.members[$a].state // empty')
  if [[ $mstate == excluded && $STATUS == sleeping ]]; then
    meta_set "$id" STATUS excluded
    meta_set "$id" FINISHED "$(date -Is)"
    act "$id" info "■ excluded from the team by the coordinator"
    exit 0
  fi
  if [[ $STATUS == sleeping && $(team_done_flag "$TEAM") != true ]]; then
    meta_set "$id" WAKE_PENDING 1
    start_runner "$id" resume || bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state sleeping >/dev/null
  else
    local state=active
    case $STATUS in done|failed) state=done ;; stopped) state=stopped ;; sleeping) state=done ;; esac
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state "$state" >/dev/null
  fi
}

# Words in a CLI error that mean the provider stopped the run because a quota or usage limit is exhausted.
# Provider limits in a run's errors: an exhausted quota, usage limit or credits (a long pause until the reset), and
# a rate limit — HTTP 429, the provider throttling requests (a short pause; credits may be fine).
QUOTA_PATTERN='quota (reached|exceeded|exhausted)|usage limit|limit reached|resource[ _]exhausted|out of credits|insufficient (credits|balance)|budget (of [^ ]+ )?(is )?(exceeded|exhausted|reached)|spend(ing)? limit (reached|exceeded)|(^|[^0-9])402([^0-9]|$)'
RATE_LIMIT_PATTERN='rate[ _-]?limit|too many requests|(^|[^0-9])429([^0-9]|$)'
# A model overloaded at the provider ("Selected model is at capacity", HTTP 503/529): a short pause like a rate limit.
OVERLOAD_PATTERN='at capacity|overloaded|temporarily unavailable|(^|[^0-9])(503|529)([^0-9]|$)'
# The network or the provider's host unreachable (DNS, a refused or reset connection, a timeout): nothing the agent did
# — a pause of AGENT_NETWORK_PAUSE_MIN, then the run goes on.
NETWORK_PATTERN='network (issue|error|is unreachable)|could not resolve|no such host|temporary failure in name resolution|name or service not known|lookup [^ ]+ on [^ ]+:[0-9]+|i/o timeout|dial tcp|connection (refused|reset|timed out)|tls handshake timeout|econnreset|econnrefused|etimedout|enotfound|eai_again|socket hang up|fetch failed'

# limit_lines dir run final pattern — this run's error lines that match a pattern: the end of the CLI's stderr
# (AGENT_LIMIT_TAIL_LINES lines: an early error the CLI retried does not count), the error events at the end of its
# output, the last error entries of the activity, and the final message when it has no STATUS (the agent's own
# report is never read as a provider error)
# A local error of the machine — out of processes, memory or file descriptors, a full disk, a unix socket — is no
# provider's limit nor a network failure, even when its words look like one ("Resource temporarily unavailable",
# "read unix …: i/o timeout"): such lines are left out before the patterns are matched.
LOCAL_ERROR_PATTERN='resource temporarily unavailable|fork: |cannot allocate memory|too many open files|no space left on device|(dial|read|write|connect) unix|unix:?[ /@]|[.]sock[: ]'

# limit_keep pattern — the lines of stdin that match the pattern and are no local error of the machine
limit_keep() {
  { grep -iE "$1" || (($? == 1)); } | { grep -viE "$LOCAL_ERROR_PATTERN" || (($? == 1)); }   # 1: none matches
}

limit_lines() {
  local dir=$1 run=$2 final=$3 pat=$4 f
  # every grep below exits 1 when nothing matches — that is the expected "no limit"
  if [[ -f $dir/err-$run.log ]]; then
    tail -n "$AGENT_LIMIT_TAIL_LINES" "$dir/err-$run.log" | limit_keep "$pat"
  fi
  for f in "$dir/events-$run.jsonl" "$dir/out-$run.jsonl"; do
    [[ -f $f ]] || continue
    tail -n 200 "$f" | { grep -iE '"(type|level|subtype)": ?"[a-z_]*error|"is_error": ?true|"error":' || (($? == 1)); } \
      | limit_keep "$pat"
  done
  if [[ -f $dir/activity.jsonl ]]; then
    tail -n 50 "$dir/activity.jsonl" | { grep -F '"k":"err"' || (($? == 1)); } | limit_keep "$pat"
  fi
  if [[ -z $(final_status "$final") ]]; then
    limit_keep "$pat" <<< "$final"
  fi
}

# last_error_line dir run — the CLI's last line on stderr in this run, its noise aside, at most 200 characters
last_error_line() {
  [[ -f $1/err-$2.log ]] || return 0
  tail -n 30 "$1/err-$2.log" | sed -E 's/^[[:space:]]+//' \
    | { grep -vE '^$|^Reading additional input from stdin' || (($? == 1)); } | tail -n 1 | cut -c1-200
}

# limit_kind dir run final — quota (an exhausted quota, usage limit or credits) or rate_limit (HTTP 429: the
# provider throttles requests — not the same as running out); exit 1 when the run did not stop on a provider limit
limit_kind() {
  if [[ -n $(limit_lines "$1" "$2" "$3" "$QUOTA_PATTERN" | tr -d '[:space:]') ]]; then
    echo quota
  elif [[ -n $(limit_lines "$1" "$2" "$3" "$RATE_LIMIT_PATTERN" | tr -d '[:space:]') ]]; then
    echo rate_limit
  elif [[ -n $(limit_lines "$1" "$2" "$3" "$OVERLOAD_PATTERN" | tr -d '[:space:]') ]]; then
    echo overloaded
  elif [[ -n $(limit_lines "$1" "$2" "$3" "$NETWORK_PATTERN" | tr -d '[:space:]') ]]; then
    echo network
  else
    return 1
  fi
}

# limit_line dir run final kind — the first line that showed the limit, at most 200 characters (for the note)
limit_line() {
  local pat=$QUOTA_PATTERN
  [[ $4 == rate_limit ]] && pat=$RATE_LIMIT_PATTERN
  [[ $4 == overloaded ]] && pat=$OVERLOAD_PATTERN
  [[ $4 == network ]] && pat=$NETWORK_PATTERN
  limit_lines "$1" "$2" "$3" "$pat" | sed -E 's/^[[:space:]]+//' | { grep -m1 . || (($? == 1)); } | cut -c1-200
}

# quota_reset_seconds dir run final — when the run stopped on a provider limit: the seconds until it may go on.
# The reset time comes from the message if it gives one; otherwise AGENT_QUOTA_PAUSE_MIN for an exhausted quota and
# AGENT_RATE_LIMIT_PAUSE_MIN for a rate limit. Exit 1: not a provider limit.
quota_reset_seconds() {
  local kind text pat=$QUOTA_PATTERN default=$AGENT_QUOTA_PAUSE_MIN
  kind=$(limit_kind "$1" "$2" "$3") || return 1
  if [[ $kind == rate_limit ]]; then pat=$RATE_LIMIT_PATTERN; default=$AGENT_RATE_LIMIT_PAUSE_MIN; fi
  if [[ $kind == overloaded ]]; then pat=$OVERLOAD_PATTERN; default=$AGENT_RATE_LIMIT_PAUSE_MIN; fi
  if [[ $kind == network ]]; then pat=$NETWORK_PATTERN; default=$AGENT_NETWORK_PAUSE_MIN; fi
  text=$(limit_lines "$1" "$2" "$3" "$pat")

  local secs=0 now at t epoch dur
  now=$(date +%s)
  # "limit reached|1761120000" (Claude Code): the reset as a Unix time
  epoch=$(grep -oE 'limit reached\|[0-9]{10}' <<< "$text" | head -1 | cut -d'|' -f2 || (($? == 1)))
  if [[ -n $epoch ]] && ((epoch > now)); then secs=$((epoch - now)); fi
  # "Resets in 24m46s", "try again in 2 hours 13 minutes", "retry after 90s"
  if ((secs == 0)); then
    dur=$(grep -ioE '(resets?|try again|retry|available again)( it)?( in| after)? [0-9][0-9hms ,:a-z]*' <<< "$text" | head -1 || (($? == 1)))
    [[ -n $dur ]] && secs=$(duration_seconds "$dur")
  fi
  # "resets 2026-11-01T00:00:00.000Z": the reset as an ISO time (before the clock times below read its year as one)
  if ((secs == 0)); then
    local iso
    iso=$(grep -ioE 'resets? (at |on )?[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?' <<< "$text" \
            | head -1 | sed -E 's/^resets? (at |on )?//I' || (($? == 1)))
    # date reports an unparsable time on stderr; that only means the time is unknown (the default pause applies)
    if [[ -n $iso ]] && t=$(date -d "$iso" +%s 2>/dev/null) && ((t > now)); then secs=$((t - now)); fi
  fi
  # "resets 3pm", "will reset at 15:30"
  if ((secs == 0)); then
    at=$(grep -ioE 'resets? (at )?[0-9]{1,2}(:[0-9]{2})? ?([ap]m)?' <<< "$text" | head -1 | sed -E 's/^resets? (at )?//I' || (($? == 1)))
    # date reports an unparsable time on stderr; that only means the time is unknown (the default pause applies)
    if [[ -n $at ]] && t=$(date -d "$at" +%s 2>/dev/null); then
      ((t <= now)) && t=$((t + 86400))
      secs=$((t - now))
    fi
  fi
  ((secs > 0)) || secs=$((default * 60))
  echo $((secs + 60))
}

# duration_seconds text — the duration in a text ("24m46s", "2 hours 13 minutes", "1h 5m", "90s") in seconds
duration_seconds() {
  local s=0 n u
  while read -r n u; do
    case ${u,,} in
      h*) s=$((s + n * 3600)) ;;
      m*) s=$((s + n * 60)) ;;
      s*) s=$((s + n)) ;;
    esac
  done < <(grep -oE '[0-9]+ ?[a-zA-Z]+' <<< "$1" | sed -E 's/^([0-9]+) ?/\1 /' || (($? == 1)))
  echo "$s"
}

# bus_messages_from agent — how many bus messages the agent has posted (a progress signal of the wake-loop guard)
bus_messages_from() {
  local f="$BUS_DIR/messages.jsonl"
  [[ -f $f ]] || { echo 0; return 0; }
  # grep -c exits 1 when nothing matches; it still prints the count (0)
  grep -cF "\"from\":\"$1\"" "$f" || (($? == 1))
}

# recent_run_starts list now — the run start times (Unix seconds) of the last 10 minutes, plus now
recent_run_starts() {
  local t out=()
  for t in $1; do (( $2 - t < 600 )) && out+=("$t"); done
  out+=("$2")
  printf '%s' "${out[*]}"
}

wake_loop_applies() { # status — the wake-loop guard watches a local team member whose run ended SLEEPING; a remote
  # member's work (its messages, its board items) is on the lead's bus, which its node cannot see
  [[ $1 == sleeping && -n ${TEAM:-} && ${REMOTE_TEAM:-} != 1 ]]
}

# wake_loop_check id start head0 msgs0 — the wake-loop guard, for a team member whose run ended SLEEPING. When the
# member keeps being woken without doing anything — AGENT_WAKE_LOOP_MAX idle runs in a row (shorter than
# AGENT_IDLE_RUN_SEC, no new commit, no bus message) or more than AGENT_WAKE_RATE_MAX runs within 10 minutes —
# prints the pause in seconds and returns 0; otherwise records the idle streak and returns 1.
wake_loop_check() {
  local id=$1 start=$2 head0=$3 msgs0=$4 now head msgs idle recent=0 t
  now=$(date +%s)
  head=$(git -C "$WORKTREE" rev-parse HEAD) || head="unknown"
  msgs=$(bus_messages_from "$AGENT")
  idle=$(task_field "$id" IDLE_RUNS); idle=${idle:-0}
  if (( now - start < AGENT_IDLE_RUN_SEC )) && [[ $head == "$head0" && $msgs == "$msgs0" ]]; then
    idle=$((idle + 1))
  else
    idle=0
  fi
  for t in $(task_field "$id" RUN_STARTS); do (( now - t < 600 )) && recent=$((recent + 1)); done
  if (( idle >= AGENT_WAKE_LOOP_MAX || recent > AGENT_WAKE_RATE_MAX )); then
    meta_set "$id" IDLE_RUNS 0
    meta_set "$id" RUN_STARTS ""
    log_warn wake_loop_detected "task=$id" "idle_runs=$idle" "runs_10min=$recent"
    echo $((AGENT_WAKE_LOOP_PAUSE_MIN * 60))
    return 0
  fi
  meta_set "$id" IDLE_RUNS "$idle"
  return 1
}

# schedule_wake id seconds — runs `agent _wake <id>` after that many seconds (a transient systemd timer)
schedule_wake() {
  systemd-run --user --quiet --collect --unit="agent-$1-wake-$(date +%s)" \
    --on-active="${2}s" --timer-property=AccuracySec=10s \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _wake "$1" 3>&- 7>&- 8>&- 9>&- 10>&-
}

# pause_task id seconds reason — the task waits (no run, not woken by messages) until a timer resumes it
pause_task() {
  local id=$1 secs=$2 reason=$3 at
  at=$(( $(date +%s) + secs ))
  meta_set "$id" WAKE_AT "$at"
  meta_set "$id" PAUSE_REASON "$reason"
  if ! schedule_wake "$id" "$secs"; then
    # without the timer the task stays paused until `agent _wake <id>` or `agent run --resume`
    log_error pause_timer_failed "task=$id" "seconds=$secs"
  fi
  log_warn task_paused "task=$id" "reason=$reason" "seconds=$secs" "until=$(date -d "@$at" '+%H:%M')"
}

# resume_paused id — the timer of a paused task fired (meta loaded): resume it, or defer an early wake-up
resume_paused() {
  local id=$1
  if (( $(date +%s) < ${WAKE_AT:-0} )); then
    log_info wake_deferred "task=$id" "wake_at=$WAKE_AT"
    return 0
  fi
  meta_set "$id" WAKE_AT ""
  if [[ -n ${TEAM:-} ]]; then
    if [[ $(team_done_flag "$TEAM") == true ]]; then
      meta_set "$id" STATUS done
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state done >/dev/null
      return 0
    fi
    meta_set "$id" WAKE_PENDING 1
  fi
  log_info resumed_after_pause "task=$id" "reason=${PAUSE_REASON:-}"
  start_runner "$id" resume || log_error resume_failed "task=$id" "reason=resume after a pause"
}

# git_identity — exports the commit identity of this run's agent (and commit signing) for every git command the
# agent runs. Environment variables override the user's git config, so the identity does not depend on the agent
# following the prompt — and never is the human's: not their e-mail, not their signing key.
git_identity() {
  local name=${GIT_NAME_FORMAT//%a/$AGENT} email=${GIT_EMAIL//%a/$AGENT} signing=no
  # never the human's address from git config: GitHub would put the agents' commits on the human's account
  [[ -n $email ]] || email="$AGENT@team-agents.invalid"
  export GIT_AUTHOR_NAME="$name" GIT_COMMITTER_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email"
  if [[ -n $GIT_SIGNING_KEY && -r $GIT_SIGNING_KEY ]]; then
    export GIT_CONFIG_COUNT=4 \
      GIT_CONFIG_KEY_0=gpg.format GIT_CONFIG_VALUE_0=ssh \
      GIT_CONFIG_KEY_1=user.signingkey GIT_CONFIG_VALUE_1="$GIT_SIGNING_KEY" \
      GIT_CONFIG_KEY_2=commit.gpgsign GIT_CONFIG_VALUE_2=true \
      GIT_CONFIG_KEY_3=tag.gpgsign GIT_CONFIG_VALUE_3=true
    signing=yes
  else
    if [[ -n $GIT_SIGNING_KEY ]]; then
      log_warn signing_key_unreadable "key=$GIT_SIGNING_KEY" "effect=commits of this run are not signed"
    fi
    # no key of the agents' own: they do not sign — not even with the human's key from git config
    export GIT_CONFIG_COUNT=2 \
      GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false \
      GIT_CONFIG_KEY_1=tag.gpgsign GIT_CONFIG_VALUE_1=false
  fi
  log_info git_identity "name=$name" "email=$email" "signing=$signing"
}

# commit_trailers — the trailers that end every commit message of this run's agent
commit_trailers() {
  printf 'Agent: %s\nAgent-Model: %s%s\nTask: %s' "$AGENT" "$TYPE" "${MODEL:+/$MODEL}" "$1"
  [[ -n ${TEAM:-} ]] && printf '\nTeam: %s' "$TEAM"
  [[ -n ${INV_ID:-} ]] && printf '\nInvestigation: #%s' "$INV_ID"
  return 0
}

# agents_md_text — what the prompt says about the repository instructions (AGENTS.md) in this run's worktree
agents_md_text() {
  if [[ -f $WORKTREE/AGENTS.md ]]; then
    cat <<'TXT'
**Repository instructions.** Before you start, read `AGENTS.md` in the repository root and every `AGENTS.md`
in the directories you work in (the nearest one applies to its directory). They describe the repository, its
conventions and how to build, lint and test it; they are binding. Where they conflict with these instructions,
these instructions decide how you communicate with the human and the other agents, and `AGENTS.md` decides how
the code is written and checked; if unsure, ask. Do not change any `AGENTS.md` (or `CLAUDE.md`, `GEMINI.md`)
unless the task explicitly asks for it — record what you learned in the repository notebook (`notebook_append`;
without the agentbus tools: in your report).
TXT
  else
    cat <<'TXT'
**Repository instructions.** This repository has no `AGENTS.md`. Follow the conventions you see in the existing
code, its build files and CI configuration, and say in your report that an `AGENTS.md` would help. Do not
create one unless the task asks for it.
TXT
  fi
}

# privileges_text — what the prompt tells the agent about installing missing tools; decided on every run,
# because sudo rights can change between runs
privileges_text() {
  # "sudo -n true" asks without a password prompt; its "a password is required" message is the expected answer
  if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
    echo "you have passwordless sudo. Use it only to install a tool you need that is missing (with the system package manager), and list every package you installed in your report. Do not use sudo for anything else."
  else
    echo "you have no sudo. If a tool you need is missing, do not work around it silently: use what is available and say in your report (or in your questions, if it blocks you) what was missing."
  fi
}

peers_list() {
  local a out=()
  for a in "${!AGENT_TYPE[@]}"; do out+=("$a (${AGENT_TYPE[$a]})"); done
  local IFS=,; printf '%s' "${out[*]}" | sed 's/,/, /g'
}

# serena_note — the prompt's part on navigating code with Serena, when AGENT_SERENA is set (prompts/serena.md)
serena_note() {
  [[ -n $AGENT_SERENA && -f $PROMPTS/serena.md ]] || return 0
  printf '\n'
  render "$PROMPTS/serena.md"
}

# pr_ownership_note — the prompt's rule on PRs by the run's role, naming the PR the script knows: a task that owns its
# PR (a solo task, an investigation's merger) keeps every commit in it, or opens one; a team's round has one PR, its
# coordinator's. Nothing for a run that opens no PR (a reviewer, a helper, an investigator)
pr_ownership_note() {
  local num=${PR_NUMBER:-} lead
  [[ -n $num || -z ${PR_URL:-} ]] || num=${PR_URL##*/}
  if [[ -n ${TEAM:-} ]]; then
    printf "\n**Pull requests.** A team's round has one PR, opened by its coordinator: a member opens none — it pushes its branch and tells the coordinator, which merges its work into the round's PR."
    lead=$(team_pr_task "$TEAM")
    if [[ -n $lead ]]; then num=$(task_field "$lead" PR_NUMBER); num=${num:-$(task_field "$lead" ROUND_PR)}; fi
    [[ -z $num ]] || printf " This round's PR is #%s: every commit of this round goes there; open no other." "$num"
    if [[ -n $num && -n $lead && -n $(task_field "$lead" ROUND_PR_BRANCH) ]]; then   # a team started on that PR (--pr)
      printf " Its branch is %s: the coordinator pushes the round's work there (git push origin HEAD:%s)." \
        "$(task_field "$lead" ROUND_PR_BRANCH)" "$(task_field "$lead" ROUND_PR_BRANCH)"
    fi
    printf '\n'
    return 0
  fi
  case ${KIND:-worker} in
    worker) ;;
    investigation) [[ ${INVESTIGATION_PHASE:-} == 2 ]] || return 0 ;;   # an investigation's merger opens its PR
    *) return 0 ;;
  esac
  if [[ -n $num && -n ${ROUND_PR_BRANCH:-} && ${ROUND_PR_BRANCH:-} != "${BRANCH:-}" ]]; then   # a solo task on --pr
    printf "\n**Pull requests.** This task's PR is #%s, branch %s: push every commit of this task there (git push origin HEAD:%s), and keep its description up to date. Open no other PR — a second one is refused.\n" \
      "$num" "$ROUND_PR_BRANCH" "$ROUND_PR_BRANCH"
  elif [[ -n $num ]]; then
    printf "\n**Pull requests.** This task's PR is #%s%s: every commit of this task goes to its branch, and its description is the one you keep up to date. Open no other PR — a second one is refused.\n" \
      "$num" "${BRANCH:+ (branch $BRANCH)}"
  else
    printf "\n**Pull requests.** This task opens one PR, from its branch, as its steps say, and keeps every commit there. Open no other — a second one is refused.\n"
  fi
}

# gh_own_pr task — the PR a task owns (a solo task, an investigation's merger), for the agents' gh to refuse it a
# second one while that PR is open; empty for anyone else
gh_own_pr() {
  local id=$1 num
  [[ -n $id && -f $TASKS/$id/meta.env && -z $(task_field "$id" TEAM) ]] || return 0
  case $(task_field "$id" KIND) in
    worker|'') ;;
    investigation) [[ $(task_field "$id" INVESTIGATION_PHASE) == 2 ]] || return 0 ;;
    *) return 0 ;;
  esac
  num=$(task_field "$id" PR_NUMBER)
  [[ -n $num ]] || num=$(task_field "$id" PR_URL | sed -n 's|.*/pull/\([0-9]*\).*|\1|p')
  [[ -z $num ]] || echo "$num"
}

# continuation_rules — repeat role-independent rules even when a session resumes after a watchdog hang.
continuation_rules() {
  pr_ownership_note
  serena_note
  printf '\n'
}

build_prompt() { # id mode qfile next_round
  local id=$1 mode=$2 qfile=$3 next_round=$4
  declare -gA R=(
    [AGENT]=$AGENT [AGENT_TYPE]=$TYPE [TASK_ID]=$id [REPO]=$REPO_NAME
    [WORKTREE]=$WORKTREE [BRANCH]=$BRANCH [BASE]=$BASE [REPO_URL]="$(github_repo_url "$REPO_ROOT")"
    [GITHUB_TRUSTED]="$(github_trusted "$REPO_ROOT")"
    [HARDWARE_FILE]="$ENV_NOTES_FILE" [PEERS]="$(peers_list)" [LANGUAGE]="$AGENT_LANGUAGE"
    [REPO_LANGUAGE]="$REPO_LANGUAGE" [COMMIT_TRAILERS]="$(commit_trailers "$id")"
    [GIT_NAME]="${GIT_NAME_FORMAT//%a/$AGENT}" [ATTRIBUTION]="\`$AGENT\` ($TYPE${MODEL:+, model $MODEL})"
    [PRIVILEGES]="$(privileges_text)" [AGENTS_MD]="$(agents_md_text)"
    [QUESTIONS_FILE]=$qfile [ROUND]=$next_round [CONSULT_MIN]=$AGENT_CONSULT_MIN
    [ROUND_LIMIT_TEXT]="$(round_limit_text "$REPO_NAME")" [ROUND_SOFT]="$(round_soft "$REPO_NAME")"
    [ROUND_SIZE_CMD]="agent round-size $id"
    [REPORT_FILE]=".agents/reports/$id.md"
    [RESULT_FILE]="$TASKS/$id/result.md"
    [INV_ID]=${INV_ID:-} [PARENT_TASK]=${PARENT_TASK:-} [PARENT_WORKTREE]=${PARENT_WORKTREE:-}
    [INVESTIGATION_TOPIC_SLUG]=${INVESTIGATION_TOPIC_SLUG:-topic}
    [FROM_AGENT]=${FROM_AGENT:-}
    [TEAM_ID]=${TEAM:-} [TEAM_MEMBERS]="$(team_members_list)"
    [ATTRIBUTION_BLOCK]="$(attribution_block "")" [TEAM_ATTRIBUTION_BLOCK]="$(attribution_block "   ")"
    [TIER]=$( [[ ${TIER:-normal} == worker ]] && echo "worker (a cheap model for simple tasks)" || echo "normal model" )
    [WORKERS]="$( ((${#WORKER_AGENTS[@]})) && (IFS=,; printf '%s' "${WORKER_AGENTS[*]}" | sed 's/,/, /g') || echo "(none configured)")"
    [HELPER_ID]=${HELPER_ID:-}
    [PR_URL]=${PR_URL:-} [PR_NUMBER]=${PR_NUMBER:-}
    [RESUMED_FROM]=${RESUMED_FROM:-} [HANG_MIN]=$AGENT_HANG_MIN
  )
  if [[ $mode != fresh ]]; then continuation_rules; fi
  if [[ $mode != fresh ]] && is_independent_investigation "$id"; then
    if [[ $mode == new ]]; then   # a later run's session has this already: it gets only what is new
      case ${INVESTIGATION_PHASE:-1} in
        2)
          R[INVESTIGATION_BASE_SHA]=${INVESTIGATION_BASE_SHA:-}
          R[INVESTIGATION_TARGET_BRANCH]=${INVESTIGATION_TARGET_BRANCH:-main}
          R[INVESTIGATION_PHASE1_MANIFEST]=${INVESTIGATION_PHASE1_MANIFEST:-}
          render "$PROMPTS/inv-merge.md" ;;
        3|5) render "$PROMPTS/review.md" ;;
        *) render "$PROMPTS/inv-work.md" ;;
      esac
      render "$PROMPTS/writing.md"
      case ${INVESTIGATION_PHASE:-1} in   # a reviewer gets the task as the task under review, with what to check
        3|5) printf '\n'; render "$PROMPTS/inv-review-task.md"; printf '\n' ;;
        *) printf '\n# TOPIC\n\n' ;;
      esac
      cat "$TASKS/$id/task.md"
      return
    fi
    local said=0
    if [[ -n ${ANSWERS_PENDING:-} ]]; then
      R[ANSWERED_ROUND]=$ANSWERS_PENDING
      R[ANSWERED_FILE]="$TASKS/$id/questions-$ANSWERS_PENDING.md"
      render "$PROMPTS/inv-resume.md"
      printf '\n---\n\n'
      expand_answers "$TASKS/$id/questions-$ANSWERS_PENDING.md"
      said=1
    fi
    if [[ -s $TASKS/$id/note-$RUN.md ]]; then
      printf '\n---\n\n## Additional note from the human\n\n'
      cat "$TASKS/$id/note-$RUN.md"
      said=1
    fi
    local sent size added=""
    sent=$(task_field "$id" TASK_SENT_BYTES)
    size=$(wc -c < "$TASKS/$id/task.md" 2> /dev/null || echo 0)
    if [[ $sent =~ ^[0-9]+$ ]] && ((size > sent)); then
      added=$(tail -c +"$((sent + 1))" "$TASKS/$id/task.md")
    elif [[ -z $sent ]]; then   # a task from before this was recorded: the last section the script added
      added=$(awk '/^# (Checks to fix|Review findings to fix)/ { buf = ""; on = 1 } on { buf = buf $0 "\n" } END { printf "%s", buf }' \
        "$TASKS/$id/task.md" 2> /dev/null)
    fi
    if [[ -n ${added//[[:space:]]/} ]]; then
      printf '\n---\n\n## Added to your task since your last run\n\nDo what it asks, following the rules from the first message of this session.\n\n%s\n' "$added"
      said=1
    fi
    ((said)) || printf 'Continue task %s following the rules from the first message of this session.\n' "$id"
    return
  fi
  if [[ $mode == fresh ]]; then   # a fresh session: the new run's prompt, the handoff, then why it was woken
    build_prompt "$id" new "$qfile" "$next_round"
    printf '\n\n'
    R[FRESH_WHY]=$FRESH_WHY
    R[LAST_REPORT]="(none)"
    [[ -s $TASKS/$id/final.md ]] && R[LAST_REPORT]=$(cat "$TASKS/$id/final.md")
    local fork
    fork=$(git -C "$WORKTREE" merge-base HEAD "${BASE:-main}" 10>&- 2>/dev/null) || fork=HEAD   # no base: nothing listed
    R[CHANGED_FILES]=$(git -C "$WORKTREE" diff --stat "$fork" 10>&- 2>/dev/null | tail -n 40)
    render "$PROMPTS/fresh-session.md"
    if [[ -n ${TEAM:-} && -z ${RESUMED_FROM:-} ]]; then   # a resumed team's new prompt has its checkpoints already
      printf '\n### The team'"'"'s checkpoint\n\n'
      try checkpoint_read_failed checkpoints_latest "team-$TEAM"
    fi
    printf '\n\n---\n\n'
    build_prompt "$id" resume "$qfile" "$next_round"
    return
  fi
  if [[ $mode == new ]]; then
    if [[ ${KIND:-worker} == investigation && ${REVIEW:-} == 1 ]]; then
      render "$PROMPTS/review.md"
      render "$PROMPTS/writing.md"
      printf '\n# PR REVIEW REQUEST #%s\n\n' "${R[PR_NUMBER]}"
    elif [[ ${KIND:-worker} == investigation ]]; then
      render "$PROMPTS/investigator.md"
      printf '\n# INVESTIGATION REQUEST #%s\n\n' "${R[INV_ID]}"
    elif [[ ${KIND:-worker} == helper ]]; then
      render "$PROMPTS/helper.md"
      printf '\n# REQUEST H%s\n\n' "${R[HELPER_ID]}"
    elif [[ -n ${TEAM:-} ]]; then
      render "$PROMPTS/team.md"
      render "$PROMPTS/tdd-rounds.md"
      render "$PROMPTS/writing.md"
      printf '\n# TEAM TASK\n\n'
    else
      render "$PROMPTS/protocol.md"
      render "$PROMPTS/tdd-rounds.md"
      render "$PROMPTS/writing.md"
      printf '\n# TASK\n\n'
    fi
    cat "$TASKS/$id/task.md"
    if [[ -n ${RESUMED_FROM:-} ]]; then
      printf '\n\n'
      render "$PROMPTS/resume-checkpoint.md"
      printf '\n## Checkpoints (the newest, oldest first)\n'
      local ck="task-$id"; [[ -n ${TEAM:-} ]] && ck="team-$TEAM"
      try checkpoint_read_failed checkpoints_latest "$ck"
      if [[ -s $TASKS/$id/history.md ]]; then
        printf '\n## Earlier questions and answers from the human (settled — do not ask again)\n'
        cat "$TASKS/$id/history.md"
      fi
    fi
    printf '\n\n'
    cat "$PROMPTS/clarification.md"
    # what "asking a question" means in this system — depends on the role (optional files)
    if [[ -n ${TEAM:-} && -f $PROMPTS/ask-team.md ]]; then
      render "$PROMPTS/ask-team.md"
    elif [[ ${KIND:-worker} != helper && -f $PROMPTS/ask-solo.md ]]; then
      render "$PROMPTS/ask-solo.md"
    fi
    skip_note "$id"
    return
  fi

  local any=0
  if [[ -n ${BOUNCE_PENDING:-} ]]; then
    R[BOUNCE]=$BOUNCE_PENDING
    render "$PROMPTS/verify-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${RBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[ROUND_PROBLEMS]=$RBOUNCE_PENDING
    render "$PROMPTS/round-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${QBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[QUESTIONS_WITHOUT_REC]=$QBOUNCE_PENDING
    render "$PROMPTS/questions-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${UNPAUSE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[MINUTES]=$UNPAUSE_PENDING
    render "$PROMPTS/unpaused.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${DBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[HELD]=$DBOUNCE_PENDING
    render "$PROMPTS/done-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${NSBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    render "$PROMPTS/nostatus-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${SBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[BAD_STATUS]=$SBOUNCE_PENDING
    render "$PROMPTS/status-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${UBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    render "$PROMPTS/unclear-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${ABOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[DECIDED_FILE]=$ABOUNCE_PENDING
    render "$PROMPTS/autopilot-questions.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${RESTART_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[RESTARTED_AT]=$RESTART_PENDING
    render "$PROMPTS/restart-resume.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${PAUSE_RELEASED:-} ]]; then
    ((any)) && printf '\n---\n\n'
    printf 'While you were paused, your board items (%s) went back to the board for others to take over. Do not continue them unless the board shows them free again: take your next work from the board.\n' "$PAUSE_RELEASED"
    any=1
  fi
  if [[ -n ${WAKE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    render "$PROMPTS/team-wake.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${ANSWERS_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'

    R[ANSWERED_ROUND]=$ANSWERS_PENDING
    R[ANSWERED_FILE]="$TASKS/$id/questions-$ANSWERS_PENDING.md"
    render "$PROMPTS/resume.md"
    printf '\n---\n\n'
    expand_answers "$TASKS/$id/questions-$ANSWERS_PENDING.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${INV_PENDING_DELIVERY:-} ]]; then
    local j inv_task
    j=$(bus inv-get --dir "$BUS_DIR" --id "$INV_PENDING_DELIVERY")
    inv_task=$(jq -r '.inv_task // empty' <<< "$j")
    R[INV_ID]=$INV_PENDING_DELIVERY
    R[INV_STATUS]=$(jq -r .status <<< "$j")
    R[INV_FILE]=$(jq -r .file <<< "$j")
    R[INV_BRANCH]=$( [[ -n $inv_task ]] && task_field "$inv_task" BRANCH || echo "none")
    ((any)) && printf '\n---\n\n'
    render "$PROMPTS/inv-result.md"
    printf '\n'
    if [[ -n $inv_task && -s $TASKS/$inv_task/result.md ]]; then
      cat "$TASKS/$inv_task/result.md"
    elif [[ -n $inv_task && -s $TASKS/$inv_task/final.md ]]; then
      cat "$TASKS/$inv_task/final.md"
    else
      echo "(the investigator delivered no result — details in ${R[INV_FILE]})"
    fi
    any=1
  fi
  if [[ -s $TASKS/$id/note-$RUN.md ]]; then
    printf '\n---\n\n## Additional note from the human\n\n'
    cat "$TASKS/$id/note-$RUN.md"
    any=1
  fi
  if ((any == 0)); then
    printf 'Continue task %s following the rules from the first message of this session.\n' "$id"
  fi
  skip_note "$id"
}

bus_args_json() { # id → JSON (also valid TOML) array of `agentbus serve` arguments
  if [[ ${REMOTE_TEAM:-} == 1 ]]; then   # a remote team member: its tools run on the lead, through the relay
    printf '%s\n' serve --relay "$JOB_LEAD" --member "$MEMBER" --home "$AGENTS_HOME" | jq -R . | jq -sc .
    return 0
  fi
  local peers
  peers=$(IFS=,; printf '%s' "${!AGENT_TYPE[*]}")
  local role=worker
  [[ ${KIND:-worker} == investigation ]] && role=investigator
  printf '%s\n' serve --dir "$BUS_DIR" --agent "$AGENT" --task "$1" --task-dir "$TASKS/$1" \
    --repo "$REPO_NAME" --branch "$BRANCH" --worktree "$WORKTREE" --peers "$peers,$(investigator_names | paste -sd,)" \
    --role "$role" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --tasks-dir "$TASKS" \
    ${TEAM:+--team "$TEAM"} --tier "${TIER:-normal}" --agent-cmd "$SELF" --home "$AGENTS_HOME" \
    | jq -R . | jq -sc .
}

# ------------------------------------------------------------------ running agent CLIs

act() { # id kind text — activity log entry (read by `agent live` and `agent transcript`)
  local line
  line=$(jq -nc --arg ts "$(date '+%F %T')" --arg k "$2" --arg t "$3" '{ts:$ts,k:$k,t:$t}')
  printf '%s\n' "$line" >> "$TASKS/$1/activity.jsonl"
  printf '%s\n' "$line" >> "$TASKS/$1/activity-full.jsonl"
}

last_event() { # jsonl-file jq-filter — the last event matching the filter
  [[ -f $1 ]] || return 0   # no events yet
  jq_soft event_scan_failed -ncR "last(inputs | fromjson? | select($2))" < "$1"
}

killtree() { # pid — kills a process and all its descendants
  local c
  local c
  for c in $(pgrep -P "$1" || (($? == 1))); do killtree "$c"; done   # pgrep exits 1 when there are no children
  kill -TERM "$1" 2>/dev/null || :   # the process may already have exited — nothing to kill
}

watch_run() { # pid dir n — waits for a CLI run; kills it after AGENT_HANG_MIN min without any event (sets HUNG=1)
  local pid=$1 dir=$2 n=$3 last now f m
  local limit=${AGENT_HANG_SECS:-$((AGENT_HANG_MIN * 60))} poll=${AGENT_HANG_POLL:-15}
  local hard=${AGENT_RUN_HARD_AT:-0} from=0 steps   # a team member's step limit (0: none)
  local solo=${AGENT_RUN_SOLO_AT:-0} solo_checked=0   # a coordinator alone is ended at this step (0: never)
  HUNG=0 LONG_CUT=0 SOLO_CUT=0
  if ((hard > 0 || solo > 0)) && [[ -f $dir/activity.jsonl ]]; then from=$(wc -l < "$dir/activity.jsonl"); fi
  while kill -0 "$pid" 2>/dev/null; do   # kill -0 only asks whether the process still exists
    sleep "$poll"
    last=$(date +%s)
    [[ -f $dir/prompt-$n.md ]] && last=$(stat -c %Y "$dir/prompt-$n.md")
    for f in "$dir/activity.jsonl" "$dir/out-$n.jsonl" "$dir/events-$n.jsonl" "$dir/err-$n.log"; do
      [[ -f $f ]] || continue
      m=$(stat -c %Y "$f"); (( m > last )) && last=$m
    done
    now=$(date +%s)
    if (( now - last > limit )) && kill -0 "$pid" 2>/dev/null; then
      HUNG=1
      act "$RUNNER_ID" err "■ watchdog: no activity at all for $AGENT_HANG_MIN min — killing the run"
      killtree "$pid"
      sleep 2
      killtree "$pid"
      break
    fi
    if ((hard > 0 || solo > 0)) && [[ -f $dir/activity.jsonl ]]; then   # this run's steps: the activity since it started
      steps=$(tail -n +"$((from + 1))" "$dir/activity.jsonl" \
        | jq_soft activity_parse -c 'select(.k != "info" and .k != "text" and .k != "err")' | awk 'NF {n++} END {print n + 0}')
      # a run whose own gate runs or waits for the lock is not ended: the gate would end with it — asked at the next
      # poll again
      if ((solo > 0 || hard > 0)) && gate_busy_for "$RUNNER_ID"; then continue; fi
      if ((solo > 0 && !solo_checked && steps >= solo)) && kill -0 "$pid" 2>/dev/null; then
        solo_checked=1   # asked once a run
        if coordinator_alone "$RUNNER_ID"; then
          LONG_CUT=1 SOLO_CUT=1
          act "$RUNNER_ID" info "■ the coordinator worked alone $steps steps — its members not at work, its board with nothing for them: the runner ends the run, and the next starts with the work to split"
          log_info solo_coordinator_cut "task=$RUNNER_ID" "steps=$steps"
          killtree "$pid"
          sleep 2
          killtree "$pid"
          break
        fi
      fi
      if ((hard > 0 && steps >= hard)) && kill -0 "$pid" 2>/dev/null; then
        LONG_CUT=1
        act "$RUNNER_ID" info "■ the run reached its limit of $hard steps: the runner ends it, and the next starts a fresh session"
        killtree "$pid"
        sleep 2
        killtree "$pid"
        break
      fi
    fi
  done
  wait "$pid"
}

activity_progress() { # id — number of the agent's own activity entries (excluding entries written by this script)
  [[ -f $TASKS/$1/activity.jsonl ]] || { echo 0; return; }
  jq_soft activity_parse -c 'select(.k != "info" and .k != "err")' "$TASKS/$1/activity.jsonl" | wc -l
}

# The CLI runs in a session (and process group) of its own: a CLI that signals its whole group on its way out —
# some clean up their children so — does not take its runner with it; the runner sees its exit code.
CLI_SESSION=()
if command -v setsid > /dev/null 2>&1; then CLI_SESSION=(setsid -w); fi

# cli_prompt prompt-file — what the CLI gets as its prompt argument: the prompt itself, or, when it is too long for one
# command-line argument (AGENT_PROMPT_ARG_MAX), a request to read it from .agent-prompt.md in the working directory,
# where it is written and kept out of git (info/exclude)
cli_prompt() {
  local pf=$1 size f excl
  size=$(wc -c < "$pf")
  if ((size <= AGENT_PROMPT_ARG_MAX)); then
    cat "$pf"
    return 0
  fi
  f="$WORKTREE/.agent-prompt.md"
  if ! cp "$pf" "$f"; then   # the prompt as it is: the CLI will say what is wrong with it
    log_error prompt_file_failed "task=${RUNNER_ID:-}" "file=$f"
    cat "$pf"
    return 0
  fi
  excl="$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  if ! grep -qxF '/.agent-prompt.md' "$excl" 2>/dev/null; then   # not there yet ("no such file" included)
    mkdir -p "$(dirname "$excl")" && echo '/.agent-prompt.md' >> "$excl" || log_warn prompt_file_exclude_failed "file=$excl"
  fi
  log_info prompt_by_file "task=${RUNNER_ID:-}" "bytes=$size"
  printf 'Your instructions for this run are too long for the command line (%s bytes). They are in the file .agent-prompt.md at the root of your working directory (%s). Read the whole file now, then follow it exactly, as if it were this message.\n' "$size" "$f"
}

# is_independent_investigation id — returns 0 if task is an independent investigator child in an investigation team
is_independent_investigation() {
  local id=${1:-}
  if [[ ${KIND:-worker} == investigation && -n ${INVESTIGATION_TEAM:-} ]]; then
    return 0
  fi
  if [[ -n $id && -d $TASKS/$id ]]; then
    [[ $(task_field "$id" KIND) == investigation && -n $(task_field "$id" INVESTIGATION_TEAM) ]] && return 0
  fi
  return 1
}

# serena_args cli — the arguments of Serena's MCP server for that CLI (claude, codex, gemini, opencode), a JSON array:
# on the run's own worktree (not the checkout Serena may know from elsewhere), with Serena's context for that client
# (which tools it leaves to the CLI), no browser opened for its dashboard
serena_args() {
  local ctx
  case $1 in
    claude) ctx=claude-code ;;
    codex) ctx=codex ;;
    gemini) ctx=antigravity ;;
    *) ctx=ide ;;
  esac
  jq -nc --arg c "$ctx" --arg w "$WORKTREE" '["start-mcp-server", "--context", $c, "--project", $w, "--open-web-dashboard", "false"]'
}

# worktree_exclude path — that path of the worktree never committed: a line in the repository's info/exclude (shared
# by its worktrees), added once. For .serena/, also copies REPO_ROOT's .serena/project.yml over the worktree's when
# they differ: the repository's is the one the human edits (a language added reaches the worktrees already made)
worktree_exclude() {
  local excl
  excl="$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir)/info/exclude" || return 1
  mkdir -p "$(dirname "$excl")"
  if [[ ! -f $excl ]] || ! grep -qxF "$1" "$excl"; then
    echo "$1" >> "$excl"
  fi
  if [[ $1 == .serena/ && -n ${REPO_ROOT:-} && $REPO_ROOT != "$WORKTREE" && -f $REPO_ROOT/.serena/project.yml ]] \
    && ! cmp -s "$REPO_ROOT/.serena/project.yml" "$WORKTREE/.serena/project.yml"; then
    mkdir -p "$WORKTREE/.serena" || return 1
    cp "$REPO_ROOT/.serena/project.yml" "$WORKTREE/.serena/project.yml" || return 1
    log_info serena_project_synced "task=${RUNNER_ID:-}" "worktree=$WORKTREE"
  fi
}

# mcp_add_serena file cli — Serena added to that MCP file ({"mcpServers": …}, claude's and Antigravity's format) when
# AGENT_SERENA is set; its project folder (.serena/ in the worktree) excluded from git. A failure is logged: the run
# goes on without Serena
mcp_add_serena() {
  [[ -n $AGENT_SERENA ]] || return 0
  try serena_exclude_failed worktree_exclude .serena/
  if ! jq --arg c "$AGENT_SERENA" --argjson a "$(serena_args "$2")" '.mcpServers.serena = {command: $c, args: $a}' "$1" > "$1.tmp" \
    || ! mv "$1.tmp" "$1"; then
    rm -f "$1.tmp"
    log_warn serena_config_failed "task=${RUNNER_ID:-}" "file=$1"
  fi
}

run_claude() { # id mode n prompt_file dir ; sets RC, FINAL
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  local args=(-p --output-format stream-json --verbose --dangerously-skip-permissions
              --mcp-config "$dir/mcp.json" --max-turns "$CLAUDE_MAX_TURNS")
  if is_independent_investigation "$id"; then
    echo '{"mcpServers":{}}' > "$dir/mcp.json"
    args+=(--strict-mcp-config)
  else
    jq -n --arg cmd "$AGENTBUS_BIN" --argjson args "$(bus_args_json "$id")" \
      '{mcpServers: {agentbus: {command: $cmd, args: $args}}}' > "$dir/mcp.json"
  fi
  mcp_add_serena "$dir/mcp.json" claude
  # Claude Code's own attribution off: the commit trailers and the PR's attribution are the script's; its tool
  # search as CLAUDE_TOOL_SEARCH says (a setting's env wins over the human's own settings). Its background tasks
  # off: a headless run ends with its turn and kills what runs in the background; its Bash timeout long enough for
  # a command to run in the foreground — the gate included
  jq -n --arg ts "$CLAUDE_TOOL_SEARCH" --arg ms "$((CLAUDE_BASH_TIMEOUT_MIN * 60000))" \
    '{includeCoAuthoredBy: false, attribution: {commit: "", pr: ""},
      env: ({CLAUDE_CODE_DISABLE_BACKGROUND_TASKS: "1", BASH_DEFAULT_TIMEOUT_MS: $ms, BASH_MAX_TIMEOUT_MS: $ms}
        + (if $ts == "default" then {} else {ENABLE_TOOL_SEARCH: $ts} end))}' > "$dir/claude-settings.json"
  args+=(--settings "$dir/claude-settings.json")
  if [[ -n ${MODEL:-} ]]; then args+=(--model "$MODEL"); fi
  if [[ $mode == new ]]; then args+=(--session-id "$SESSION_ID"); else args+=(--resume "$SESSION_ID"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  RC=0
  ( cd "$WORKTREE" || exit 1
    "${CLI_SESSION[@]}" "$CLAUDE_BIN" "${args[@]}" "$(cli_prompt "$pf")" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/out-$n.jsonl" | "$AGENTBUS_BIN" normalize --type claude --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  local res; res=$(last_event "$dir/out-$n.jsonl" '.type == "result"')
  FINAL=$(jq_soft cli_result_parse -r '.result // empty' <<< "${res:-null}")
  if [[ $(jq_soft cli_result_parse -r '.is_error // false' <<< "${res:-null}") == true ]] && ((RC == 0)); then
    RC=1
  fi
}

# codex_mcp_args task — codex's settings of the agentbus server, one a line: the server; for an independent investigator
# the same server switched off — codex refuses a server it is told of without its command ("invalid transport"). Then
# Serena's, when AGENT_SERENA is set
codex_mcp_args() {
  printf '%s\n' -c "mcp_servers.agentbus.command=\"$AGENTBUS_BIN\""
  if is_independent_investigation "$1"; then
    printf '%s\n' -c "mcp_servers.agentbus.enabled=false"
  else
    printf '%s\n' -c "mcp_servers.agentbus.args=$(bus_args_json "$1")" -c "mcp_servers.agentbus.tool_timeout_sec=900"
  fi
  [[ -n $AGENT_SERENA ]] || return 0
  try serena_exclude_failed worktree_exclude .serena/
  # Serena starts its language servers first: more than codex's default 10 s
  printf '%s\n' -c "mcp_servers.serena.command=$(jq -nc --arg c "$AGENT_SERENA" '$c')" \
    -c "mcp_servers.serena.args=$(serena_args codex)" -c "mcp_servers.serena.startup_timeout_sec=120" \
    -c "mcp_servers.serena.tool_timeout_sec=300"
}

run_codex() { # id mode n prompt_file dir ; sets RC, FINAL
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  local args=(exec --json --dangerously-bypass-approvals-and-sandbox
              -C "$WORKTREE" -o "$dir/last-$n.md")
  local mcp=()
  mapfile -t mcp < <(codex_mcp_args "$id")
  args+=("${mcp[@]}")
  if [[ -n ${MODEL:-} ]]; then args+=(-m "$MODEL"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  if [[ $mode == resume ]]; then args+=(resume "$SESSION_ID"); fi
  args+=("$(cli_prompt "$pf")")
  RC=0
  ( cd "$WORKTREE" || exit 1
    "${CLI_SESSION[@]}" "$CODEX_BIN" "${args[@]}" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/events-$n.jsonl" | "$AGENTBUS_BIN" normalize --type codex --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  FINAL=""
  [[ -f $dir/last-$n.md ]] && FINAL=$(<"$dir/last-$n.md")   # codex writes it only when the turn produced a message
  if [[ $mode == new ]]; then
    SESSION_ID=""
    [[ -f $dir/events-$n.jsonl ]] && SESSION_ID=$(jq_soft cli_result_parse -nrR \
      'first(inputs | fromjson? | select(.type == "thread.started") | .thread_id) // empty' < "$dir/events-$n.jsonl")
    meta_set "$id" SESSION_ID "$SESSION_ID"
    [[ -n $SESSION_ID ]] || log_warn session_id_missing "cli=codex" "effect=resume will not work"
  fi
}

run_gemini() { # id mode n prompt_file dir ; sets RC, FINAL  (Antigravity CLI: agy)
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  # agentbus MCP: workspace config (.agents/mcp_config.json), excluded from git locally
  mkdir -p "$WORKTREE/.agents"
  if is_independent_investigation "$id"; then
    echo '{"mcpServers":{}}' > "$WORKTREE/.agents/mcp_config.json"
  else
    jq -n --arg cmd "$AGENTBUS_BIN" --argjson args "$(bus_args_json "$id")" \
      '{mcpServers: {agentbus: {command: $cmd, args: $args}}}' > "$WORKTREE/.agents/mcp_config.json"
  fi
  worktree_exclude .agents/mcp_config.json
  mcp_add_serena "$WORKTREE/.agents/mcp_config.json" gemini

  local args=(--output-format stream-json --dangerously-skip-permissions --print-timeout "$AGY_PRINT_TIMEOUT")
  if [[ -n ${MODEL:-} ]]; then args+=(--model "$MODEL"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  if [[ $mode != new ]]; then args+=(--conversation "$SESSION_ID"); fi
  RC=0
  ( cd "$WORKTREE" || exit 1
    "${CLI_SESSION[@]}" "$AGY_BIN" "${args[@]}" -p "$(cli_prompt "$pf")" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/out-$n.jsonl" | "$AGENTBUS_BIN" normalize --type gemini --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  local res; res=$(last_event "$dir/out-$n.jsonl" '.event == "result"')
  FINAL=$(jq_soft cli_result_parse -r '.result.response // empty' <<< "${res:-null}")
  if [[ $(jq_soft cli_result_parse -r '.result.status // empty' <<< "${res:-null}") != SUCCESS ]] && ((RC == 0)); then
    RC=1
  fi
  if [[ $mode == new ]]; then
    SESSION_ID=$(jq_soft cli_result_parse -r '.result.conversation_id // empty' <<< "${res:-null}")
    [[ -n $SESSION_ID ]] || SESSION_ID=$(jq_soft cli_result_parse -nrR \
      'first(inputs | fromjson? | select(.event == "init") | .conversation_id) // empty' < "$dir/out-$n.jsonl")
    meta_set "$id" SESSION_ID "$SESSION_ID"
    [[ -n $SESSION_ID ]] || log_warn session_id_missing "cli=agy" "effect=resume will not work"
  fi
}

opencode_config() { # id — per-run configuration (agentbus MCP, Serena when AGENT_SERENA is set, providers)
  local indep=false sargs=null
  is_independent_investigation "$1" && indep=true
  if [[ -n $AGENT_SERENA ]]; then
    sargs=$(serena_args opencode)
    try serena_exclude_failed worktree_exclude .serena/
  fi
  jq -n --arg cmd "$AGENTBUS_BIN" --argjson args "$(bus_args_json "$1")" --arg model "${MODEL:-}" --argjson indep "$indep" \
    --arg serena "$AGENT_SERENA" --argjson sargs "$sargs" '
    {
      "$schema": "https://opencode.ai/config.json",
      autoupdate: false,
      mcp: { agentbus: { type: "local", command: ([$cmd] + $args), enabled: ($indep | not) } },   # off: still whole, as opencode wants
      provider: {
        openrouter: { options: { apiKey: "{env:OPENROUTER_API_KEY}" } },
        deepinfra: {
          npm: "@ai-sdk/openai-compatible", name: "DeepInfra",
          options: { baseURL: "https://api.deepinfra.com/v1/openai", apiKey: "{env:DEEPINFRA_API_KEY}" }
        }
      }
    }
    # a model outside the models.dev catalog (e.g. an OpenRouter preset) must be registered with the provider
    | ($model | split("/")) as $p
    | if ($p | length) > 1 and (.provider[$p[0]] != null)
      then .provider[$p[0]].models[($p[1:] | join("/"))] = { name: ($p[1:] | join("/")) }
      else . end
    | if $serena != "" then .mcp.serena = { type: "local", command: ([$serena] + $sargs), enabled: true } else . end'
}

run_opencode() { # id mode n prompt_file dir ; sets RC, FINAL  (OpenRouter, DeepInfra and other API providers)
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  local cfg; cfg=$(opencode_config "$id")
  printf '%s\n' "$cfg" > "$dir/opencode-config.json"
  local args=(run --standalone --format json --auto)
  if [[ -n ${MODEL:-} ]]; then args+=(-m "$MODEL"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  if [[ $mode != new ]]; then args+=(--session "$SESSION_ID"); fi
  RC=0
  ( cd "$WORKTREE" || exit 1
    OPENCODE_CONFIG_CONTENT="$cfg" OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS="$OPENCODE_BASH_TIMEOUT_MS" \
      "${CLI_SESSION[@]}" "$OPENCODE_BIN" "${args[@]}" -- "$(cli_prompt "$pf")" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/out-$n.jsonl" | "$AGENTBUS_BIN" normalize --type opencode --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  if [[ $mode == new ]]; then
    SESSION_ID=$(jq_soft cli_result_parse -nrR 'first(inputs | fromjson? | .sessionID // empty)' < "$dir/out-$n.jsonl")
    meta_set "$id" SESSION_ID "$SESSION_ID"
    [[ -n $SESSION_ID ]] || log_warn session_id_missing "cli=opencode" "effect=resume will not work"
  fi
  FINAL=$(jq_soft cli_result_parse -nrR 'last(inputs | fromjson? | select(.type == "text") | .part.text) // empty' < "$dir/out-$n.jsonl")
  if [[ -z $FINAL && -n ${SESSION_ID:-} ]]; then
    # known opencode issue: in resumed sessions the result is sometimes stored but not printed to stdout
    # older opencode versions have no --standalone (an expected failure); a failure of the fallback is logged
    FINAL=$( (cd "$WORKTREE" && { "$OPENCODE_BIN" session export --standalone "$SESSION_ID" 2>/dev/null \
                                  || try opencode_export_failed "$OPENCODE_BIN" session export "$SESSION_ID"; }) \
      | jq_soft opencode_export_parse -r '[.messages[]? | select(.info.role == "assistant") | .parts[]? | select(.type == "text") | .text] | last // empty')
    [[ -n $FINAL ]] && act "$id" info "result read via opencode session export (stdout was empty)"
  fi
  if [[ -z $FINAL && -f $dir/out-$n.jsonl ]] && grep -q '"type":"error"' "$dir/out-$n.jsonl" && ((RC == 0)); then
    RC=1
  fi
}

# pair_reviewers pair-dir — a review pair's two reviewers, with their CLI and model: "inv-a (codex · gpt-6), inv-b (…)"
# leading_icon text — the icon a text starts with: its first word, when that has no letter, digit or ASCII punctuation
# and is no dash or dot ("⛔", "✅✅", "🟣"); nothing else
leading_icon() {
  local LC_ALL=C w=${1%% *}   # ASCII classes only: in a UTF-8 locale an emoji is [[:punct:]]
  [[ -n $w && $w != *[[:alnum:]]* && $w != *[[:punct:]]* ]] || return 0
  case $w in "—"|"–"|"·"|"…") return 0 ;; esac   # a dash or a dot, not an icon
  printf '%s' "$w"
}

pair_reviewers() {
  local s a out=()
  for s in A B; do
    a=$(cat "$1/$s.agent" 2> /dev/null) || continue
    [[ -n $a ]] || continue
    out+=("$a (${INVESTIGATORS_TYPE[$a]:-?}${INVESTIGATORS_MODEL[$a]:+ · ${INVESTIGATORS_MODEL[$a]}})")
  done
  local IFS=,
  printf '%s' "${out[*]}" | sed 's/,/, /g'
}

notify() { # id status final note
  local id=$1 status=$2 final=$3 note=${4:-}
  stopping && return 0
  local question_path
  if [[ $id == *@* ]]; then
    remote_question_context "$id" || return 1
    local REPO_NAME=$REMOTE_REPO AGENT TYPE MODEL RUN ROUND=$REMOTE_ROUND KIND=worker
    local WORK_ROUND='' WORKTREE='' REVIEW=0 AGENTS_MD=''
    AGENT="$(jq -r '.AGENT' "$REMOTE_MIRROR/metadata.json")@$REMOTE_NODE"
    TYPE=$(jq -r '.TYPE // ""' "$REMOTE_MIRROR/metadata.json")
    MODEL=$(jq -r '.MODEL // ""' "$REMOTE_MIRROR/metadata.json")
    RUN=$(jq -r '.RUN // "0"' "$REMOTE_MIRROR/metadata.json")
    question_path=$REMOTE_FILE
  else
    meta_load "$id"
    # Jobs with a configured lead notify through their reports and mirrored questions, never twice.
    if [[ -n ${JOB_ID:-} && -n ${JOB_LEAD:-${LEAD_URL:-}} ]]; then return 0; fi
    question_path="$TASKS/$id/questions-${ROUND:-0}.md"
  fi
  log_info notification "task=$id" "status=$status" "note=$note"
  local label
  case $status in
    done)    label="✅ done"
             if [[ -n ${WORK_ROUND:-} ]]; then label="🔁 round $WORK_ROUND/$WORK_ROUNDS done"; fi ;;
    waiting) label="❓ waiting for answers" ;;
    failed)  label="❌ failed" ;;
    hung)    label="⚠ hung (watchdog)" ;;
    paused)  label="⏸ paused" ;;
    abandoned) label="⚠ team left without members" ;;
    approved) label="✅✅ both reviews: ready to merge" ;;
    merged) label="🟣 PR merged" ;;
    started) label="🚀 started" ;;
    round-start) label="🚀 a new round starts" ;;
    review-wait) label="⏳ reviews waiting" ;;
    *)       label=$status ;;
  esac
  if [[ ${REVIEW:-} == 1 && $status == done ]]; then   # a PR review: its verdict
    case $(review_task_verdict "$id" "$final") in
      ready-to-merge) label="✅ ready to merge" ;;
      needs-fixes) label="🔧 needs fixes" ;;
      incomplete) label="🧩 incomplete" ;;
      *) label="❌ review without a verdict" ;;
    esac
  fi
  [[ -n $final ]] || final="(no final message from the agent — see: agent log $id)"
  mkdir -p "$NOTIFY_DIR"
  local icons note_icon   # the status's icon, and the note's when it is another: first in the title
  icons=$(leading_icon "$label"); note_icon=$(leading_icon "$note")
  [[ -z $note_icon || $note_icon == "$icons" ]] || icons+=$note_icon
  if [[ $status == done && -n ${TEAM:-} && -n ${WORK_ROUND:-} ]]; then   # a round's end: its card, in one line
    note="${note:+$note · }$(round_check_line "$TEAM")"
  fi
  local kind=""   # a merge or a start: a file of its own, beside the run's own notification
  case $status in merged|started|round-start) kind="-$status" ;; esac
  local f="$NOTIFY_DIR/${id}-r${RUN}${kind}-summary.md"
  {
    printf '%s\n' "${icons:+$icons }$REPO_NAME"    # first line = title/thread: the icons first, seen at once
    printf 'Repo: %s\n' "$REPO_NAME"
    if [[ ${KIND:-worker} == investigation ]] && ! is_independent_investigation "$id"; then
      printf 'Agent: %s (%s%s) — investigation #%s for %s\n' "${AGENT:-?}" "${TYPE:-?}" "${MODEL:+, $MODEL}" "$INV_ID" "$FROM_AGENT"
    else
      printf 'Agent: %s (%s%s)\n' "${AGENT:-?}" "${TYPE:-?}" "${MODEL:+, $MODEL}"
    fi
    printf 'Time: %s\n' "$(date '+%Y-%m-%d %H:%M')"
    printf 'Task: %s\n' "$id"
    printf 'Status: %s\n' "$label"
    if [[ -n $note ]]; then printf 'Note: %s\n' "$note"; fi
    if [[ ${AGENTS_MD:-} == missing ]]; then printf 'Note: the repository has no AGENTS.md\n'; fi
    if [[ $status == done && -n ${WORK_ROUND:-} ]]; then
      local rref=${TEAM:-$id} rurl
      rurl=$(round_pr_url "$id")
      if [[ -n $rurl ]]; then printf 'PR: %s\n' "$rurl"; fi
      if [[ $(task_field "$id" AUTOPILOT) == 1 && $(task_field "$id" AUTOPILOT_OFF) != 1 ]]; then
        if ((WORK_ROUND < WORK_ROUNDS)); then
          printf 'Next (--autopilot): the checks, then two reviews; with both ready to merge it merges it and starts round %s by itself — to stop that: agent autopilot %s off\n' $((WORK_ROUND + 1)) "$rref"
        else
          printf 'Next (--autopilot): the checks, then two reviews; with both ready to merge it merges it and the task is complete — to stop that: agent autopilot %s off\n' "$rref"
        fi
      elif ((WORK_ROUND < WORK_ROUNDS)); then
        printf 'Next: merge the PR of round %s, then: agent run --resume %s (round %s)\n' "$WORK_ROUND" "$rref" $((WORK_ROUND + 1))
        printf 'Review fixes on the same PR first: agent run --resume %s --same-round "…"\n' "$rref"
      else
        printf 'This was the last round (%s/%s): merge the PR and the task is complete.\n' "$WORK_ROUND" "$WORK_ROUNDS"
      fi
    fi
    if [[ $status == waiting ]]; then
      printf 'Questions: %s — answer with: agent answer %s\n' \
        "$(count_questions "$question_path")" "$id"
      # A task link works with both read-only and interactive remote views.
      if [[ -n $AGENT_WEB_URL && $id == *@* ]]; then
        printf 'Open: %s/task/%s\n' "${AGENT_WEB_URL%/}" "$id"
      elif [[ -n $AGENT_WEB_URL ]]; then
        printf 'Answer: %s/questions/%s?max=1\n' "${AGENT_WEB_URL%/}" "$id"
      fi
    elif [[ -n $AGENT_WEB_URL ]]; then
      printf 'Open: %s/task/%s\n' "${AGENT_WEB_URL%/}" "$id"
    fi
    if [[ -n ${WORKTREE:-} && -f $WORKTREE/.agents/reports/$id.md ]]; then   # a proxy task has no worktree
      printf 'Report: .agents/reports/%s.md (branch %s)\n' "$id" "$BRANCH"
    fi
    if [[ ${KIND:-worker} == worker && $status != waiting ]]; then
      local invs
      invs=$(try inv_list_failed bus inv-list --dir "$BUS_DIR" --task "$id")
      if [[ -n $invs ]]; then printf 'Investigations:\n%s\n' "$invs"; fi
    fi
    printf '\n%s\n' "${final:0:$NOTIFY_MAX_CHARS}"
  } > "$f"
  notify_send "$f"
}

# ------------------------------------------------------------------ investigations

pick_investigator() { # last free... — the next investigator in the rotation (sorted names) after the last one,
  # preferring another provider than the last one's; when every free one shares it, the next free one anyway.
  # Exit 1: none is free.
  local last=$1 names=() i k n start=0 cand first="" lastp=""
  shift
  (($#)) || return 1
  mapfile -t names < <(investigator_names)
  n=${#names[@]}
  for i in "${!names[@]}"; do
    if [[ ${names[i]} == "$last" ]]; then start=$((i + 1)); fi
  done
  [[ -n $last && -n ${INVESTIGATORS_TYPE[$last]:-} ]] && lastp=$(agent_auth_target "$last" | cut -f1)
  for ((k = 0; k < n; k++)); do
    cand=${names[(start + k) % n]}
    is_one_of "$cand" "$@" || continue
    [[ -n $first ]] || first=$cand
    if [[ -z $lastp || $(agent_auth_target "$cand" | cut -f1) != "$lastp" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  printf '%s' "$first"
}

is_one_of() { # word words... — is the word among the words?
  local w=$1 x
  shift
  for x in "$@"; do [[ $x == "$w" ]] && return 0; done
  return 1
}

remember_investigator() { # name — the investigator that got the last request (the rotation starts after it)
  printf '%s\n' "$1" > "$AGENTS_HOME/last-investigator.tmp.$$"
  mv "$AGENTS_HOME/last-investigator.tmp.$$" "$AGENTS_HOME/last-investigator"
}

free_investigator() { # the next free investigator in the rotation (not working, not waiting for the human's answers)
  local free=() last=""
  mapfile -t free < <(free_investigator_list)
  ((${#free[@]})) || return 1
  if [[ -f $AGENTS_HOME/last-investigator ]]; then last=$(<"$AGENTS_HOME/last-investigator"); fi
  pick_investigator "$last" "${free[@]}"
}

# investigation_resume_write parent members-json atomically records advisory outcomes separately from phase one.
investigation_resume_write() {
  local parent=$1 members=$2 tmp="$TASKS/$1/resume.json.tmp.$$"
  jq -n --argjson members "$members" '{version:1,members:$members}' > "$tmp"
  mv "$tmp" "$TASKS/$parent/resume.json"
}

# investigation_resume_tick parent recovers interrupted admission and waits for every advisory reviewer.
investigation_resume_tick() {
  local parent=$1 child member state verdict text members='[]' active=0 failed=0 stage ids=() names=() i
  if [[ ! -f $TASKS/$parent/resume.json ]]; then
    IFS=, read -r -a ids <<< "$(investigation_field "$parent" INVESTIGATION_RESUME_TASKS)"
    IFS=, read -r -a names <<< "$(task_field "$parent" INVESTIGATION_TEAM)"
    for i in "${!ids[@]}"; do
      [[ -n ${ids[i]} ]] || continue
      members=$(jq -c --arg agent "${names[i]:-unknown}" --arg task "${ids[i]}" \
        '. + [{agent:$agent,task:$task,status:"new",verdict:""}]' <<< "$members")
    done
    investigation_resume_write "$parent" "$members"
  fi
  members='[]'
  while IFS= read -r member; do
    child=$(jq -r .task <<< "$member"); verdict=''; text=''
    state=failed
    if [[ -f $TASKS/$child/meta.env ]]; then state=$(task_field "$child" STATUS); fi
    case $state in
      starting|running|waiting|sleeping|paused|interrupted|investigating) active=$((active + 1)) ;;
      done)
        [[ ! -f $TASKS/$child/final.md ]] || text=$(<"$TASKS/$child/final.md")
        [[ ! -f $TASKS/$child/result.md ]] || text+=$'\n'$(<"$TASKS/$child/result.md")
        # Advisory review requires an explicit verdict; legacy findings-only inference is insufficient.
        verdict=$(review_verdict "$text")
        if [[ -n $verdict ]]; then verdict=$(review_task_verdict "$child" "$text"); else state=failed; fi ;;
      *) state=failed ;;
    esac
    if [[ $state == failed ]]; then
      failed=$((failed + 1))
      if [[ -f $TASKS/$child/meta.env ]]; then meta_set "$child" STATUS failed; fi
    fi
    member=$(jq -c --arg status "$state" --arg verdict "$verdict" '.status=$status | .verdict=$verdict' <<< "$member")
    members=$(jq -c --argjson member "$member" '. + [$member]' <<< "$members")
  done < <(jq -c '.members[]' "$TASKS/$parent/resume.json")
  investigation_resume_write "$parent" "$members"
  if ((active)); then
    auto_stage "$parent" "review: $active investigators reviewing (#$(investigation_field "$parent" PR_NUMBER))" no-comment
    return
  fi
  stage="waits for you: advisory reviews ready (#$(investigation_field "$parent" PR_NUMBER)"
  if ((failed)); then stage+=", $failed failed"; fi
  stage+=')'
  if ((failed)); then investigation_handoff "$parent" "$stage" failed
  else investigation_handoff "$parent" "$stage" done; fi
}

# investigation_resume_admit parent reserves the whole original cohort before creating all review worktrees.
investigation_resume_admit() {
  local parent=$1 names=() roots=() repos=() available=() launchable=() name root repo base stamp text child children='' members='[]' state kv target round
  local -A AGENT_TYPE=() AGENT_MODEL=() AGENT_EXTRA_ARGS=()
  IFS=, read -r -a names <<< "$(task_field "$parent" INVESTIGATION_TEAM)"
  mapfile -t available < <(free_investigator_list)
  for name in "${names[@]}"; do
    if ! is_one_of "$name" "${available[@]}"; then
      auto_stage "$parent" 'waiting: capacity queue' no-comment
      return 0
    fi
  done
  root=$(task_field "$parent" REPO_ROOT); repo=$(task_field "$parent" REPO_NAME)
  base=$(investigation_field "$parent" INVESTIGATION_RESUME_HEAD)
  target=$(task_field "$parent" BRANCH)
  text="Advisory review of the existing PR: propose improvements and other points of view, with an explicit VERDICT. Do not apply changes, commit suggestions, merge, delegate, or contact other investigators. The human decides what to apply.
$(cat "$TASKS/$parent/task.md")"
  if [[ -f $TASKS/$parent/resume-request.md ]]; then text+=$'\n\n'$(<"$TASKS/$parent/resume-request.md"); fi
  # the round the resume text named (agent run --resume), else the investigation team's
  round=$(investigation_field "$parent" INVESTIGATION_RESUME_ROUND_ID); round=${round:-$(task_round_id "$parent")}
  for name in "${names[@]}"; do
    roots+=("$root"); repos+=("$repo")
    AGENT_TYPE[$name]=${INVESTIGATORS_TYPE[$name]}
    AGENT_MODEL[$name]=${INVESTIGATORS_MODEL[$name]:-}
    AGENT_EXTRA_ARGS[$name]=${INVESTIGATORS_EXTRA_ARGS[$name]:-}
  done
  lock_task_ids
  stamp=$(allocate_run_ids 0 names roots repos)
  for name in "${names[@]}"; do
    child="$stamp-$name"; children="${children:+$children,}$child"
    members=$(jq -c --arg agent "$name" --arg task "$child" \
      '. + [{agent:$agent,task:$task,status:"new",verdict:""}]' <<< "$members")
  done
  meta_set "$parent" INVESTIGATION_RESUME_TASKS "$children"
  investigation_resume_write "$parent" "$members"
  meta_set "$parent" INVESTIGATION_LEASE 1
  meta_set "$parent" STATUS running
  for name in "${names[@]}"; do
    child="$stamp-$name"
    if create_task "$name" "$text" "$root" "$root" "$target" "$stamp" "" "$base" "$round"; then
      for kv in 'KIND=investigation' "INVESTIGATION_TEAM=$parent" 'INVESTIGATION_PHASE=5' \
          "PARENT_TASK=$parent" 'PARENT_WORKTREE=' "INV_ID=$child" 'TEAM=' 'TIER=normal' 'REVIEW=1' \
          "PR_URL=$(investigation_field "$parent" PR_URL)" "PR_NUMBER=$(investigation_field "$parent" PR_NUMBER)"; do
        meta_set "$child" "${kv%%=*}" "${kv#*=}"
      done
      launchable+=("$child")
    else
      log_error investigation_start_failed "task=$parent" "investigator=$name" "reason=$CREATE_TASK_ERROR"
    fi
  done
  unlock_task_ids
  for child in "${launchable[@]}"; do
    if ! start_runner "$child" new; then meta_set "$child" STATUS failed; fi
  done
  investigation_resume_tick "$parent"
}

# investigation_resume parent verify same-round addition [round] validates the recorded PR before scheduling advisory
# reviews; round: the one the addition names ("" none: the reviews take the investigation team's)
investigation_resume() {
  local parent=$1 verify=$2 same_round=$3 addition=$4 round=${5:-} root branch url prs pr state head count resume_fd
  ((verify == 0 && same_round == 0)) || die 'investigation resume cannot use --verify or --same-round'
  ((${#RESUME_MEMBERS[@]} == 0)) || die 'investigation resume uses every original investigator; --team cannot change membership'
  exec {resume_fd}>"$AGENTS_HOME/dispatch.lock"
  flock "$resume_fd"
  local parent_status
  parent_status=$(task_field "$parent" STATUS)
  [[ ( $parent_status == done || $parent_status == failed || $parent_status == waiting ) \
    && $(investigation_field "$parent" INVESTIGATION_LEASE) != 1 \
    && $(investigation_field "$parent" INVESTIGATION_HANDOFF_PENDING) != 1 ]] || die 'investigation team is still active; resume its PR only after the investigation finishes'
  validate_investigation_team "$(task_field "$parent" INVESTIGATION_TEAM)"
  root=$(task_field "$parent" REPO_ROOT); branch=$(task_field "$parent" BRANCH)
  url=$(investigation_field "$parent" PR_URL)
  [[ -n $url && -n $branch ]] || die 'investigation team has no pull request; a new topic is a new run'
  prs=$(trusted_prs "$root" "$branch" all 'url,state,headRefOid,headRefName') || die 'cannot verify investigation PR; retry resume later'
  pr=$(jq -c --arg url "$url" --arg branch "$branch" '.[] | select(.url==$url and .headRefName==$branch)' <<< "$prs")
  [[ -n $pr ]] || die 'recorded investigation PR is missing or untrusted; a new topic is a new run'
  state=$(jq -r .state <<< "$pr")
  case $state in
    MERGED) die 'investigation PR is merged; a new topic is a new run' ;;
    CLOSED) die 'investigation PR is closed; a new topic is a new run' ;;
    OPEN) ;;
    *) die 'cannot verify investigation PR state; retry resume later' ;;
  esac
  head=$(jq -r .headRefOid <<< "$pr")
  [[ $head =~ ^[0-9a-f]{40}$ ]] || die 'cannot verify investigation PR head; retry resume later'
  git -C "$root" fetch origin "$branch" || die 'cannot fetch investigation PR; retry resume later'
  git -C "$root" cat-file -e "$head^{commit}" || die 'investigation PR head is unavailable; retry resume later'
  count=$(investigation_field "$parent" INVESTIGATION_RESUME_COUNT); count=${count:-0}
  printf '%s\n' "$addition" > "$TASKS/$parent/resume-request.md"
  meta_set "$parent" INVESTIGATION_RESUME_COUNT "$((count + 1))"
  meta_set "$parent" INVESTIGATION_RESUME_HEAD "$head"
  meta_set "$parent" INVESTIGATION_RESUME_ROUND_ID "$round"
  meta_set "$parent" INVESTIGATION_COMMENTED ''
  meta_set "$parent" INVESTIGATION_NOTIFIED ''
  meta_set "$parent" INVESTIGATION_HANDOFF_PENDING ''
  meta_set "$parent" INVESTIGATION_HANDOFF_STAGE ''
  meta_set "$parent" INVESTIGATION_HANDOFF_RESULT ''
  meta_set "$parent" INVESTIGATION_PHASE 5
  rm -f "$TASKS/$parent/stop-requested"
  meta_set "$parent" STATUS new
  flock -u "$resume_fd"
  exec {resume_fd}>&-
  dispatch
  printf '%s\n' "$parent"
}

# investigation_phase1_write parent members-json atomically replaces the parent's outcome snapshot.
investigation_phase1_write() {
  local parent=$1 members=$2 tmp="$TASKS/$1/phase1.json.tmp.$$"
  jq -n --argjson members "$members" '{version:1,members:$members}' > "$tmp"
  mv "$tmp" "$TASKS/$parent/phase1.json"
}

# investigation_published child base verifies a nonempty descendant published on its assigned branch.
# Returns 0 for a verified result, 1 for an invalid result, or 2 when publication cannot be checked.
# Sets INVESTIGATION_RESULT_COMMIT and INVESTIGATION_RESULT_ERROR for the parent's snapshot.
investigation_published() {
  local child=$1 base=$2 wt branch remote rc
  wt=$(task_field "$child" WORKTREE)
  branch=$(task_field "$child" BRANCH)
  INVESTIGATION_RESULT_COMMIT=""
  INVESTIGATION_RESULT_ERROR="the run has no published nonempty result on its assigned branch"
  if ! INVESTIGATION_RESULT_COMMIT=$(git -C "$wt" rev-parse --verify HEAD 2>&1); then
    INVESTIGATION_RESULT_COMMIT=""
    return 1
  fi
  # an investigation on an open PR (--pr) whose investigator had nothing to change: its result is the PR as it is (its
  # head, the base of this run, already on origin) — the checks and the review follow
  local parent
  parent=$(task_field "$child" PARENT_TASK)
  if [[ -n $parent && -n $(investigation_field "$parent" INVESTIGATION_PR_BRANCH) ]] \
    && [[ $(git -C "$wt" rev-parse --verify "$base^{commit}" 2> /dev/null) == "$INVESTIGATION_RESULT_COMMIT" ]] \
    && git -C "$wt" diff --quiet HEAD -- 2> /dev/null; then
    INVESTIGATION_RESULT_ERROR=""
    return 0
  fi
  if ! git -C "$wt" merge-base --is-ancestor "$base" "$INVESTIGATION_RESULT_COMMIT"; then return 1; fi
  if git -C "$wt" diff --quiet "$base" "$INVESTIGATION_RESULT_COMMIT" --; then
    return 1
  else
    rc=$?
    # A changed tree is diff's expected status 1; other failures cannot prove a result.
    if ((rc != 1)); then return 1; fi
  fi
  if ! remote=$(git -C "$wt" ls-remote origin "refs/heads/$branch" 2>&1); then
    INVESTIGATION_RESULT_ERROR="publication lookup failed; verification will be retried"
    log_warn investigation_publication_check_failed "task=$child" "reason=$remote"
    return 2
  fi
  [[ ${remote%%$'\t'*} == "$INVESTIGATION_RESULT_COMMIT" ]] || return 1
  INVESTIGATION_RESULT_ERROR=""
}

# investigation_phase1_recover parent reconstructs a missing legacy manifest under dispatch.lock.
investigation_phase1_recover() {
  local parent=$1 child file agent branch members='[]' recovered_tasks=()
  local -A recovered_children=()
  # Optional fields must not inherit metadata from the runner dispatching this recovery.
  IFS=, read -r -a recovered_tasks <<< "$(INVESTIGATION_PHASE1_TASKS="" task_field "$parent" INVESTIGATION_PHASE1_TASKS)"
  for file in "$TASKS"/*/meta.env; do
    [[ -f $file ]] || continue
    child=${file%/meta.env}; child=${child##*/}
    [[ $(KIND="" task_field "$child" KIND) == investigation ]] || continue
    if [[ $(INVESTIGATION_TEAM="" task_field "$child" INVESTIGATION_TEAM) == "$parent" ||
          $(PARENT_TASK="" task_field "$child" PARENT_TASK) == "$parent" ]]; then
      recovered_tasks+=("$child")
    fi
  done
  for child in "${recovered_tasks[@]}"; do
    [[ -n $child ]] || continue
    [[ -z ${recovered_children[$child]:-} ]] || continue
    recovered_children[$child]=1
    agent=${child#*-}; agent=${agent#*-}; branch=""
    if [[ -f $TASKS/$child/meta.env ]]; then
      agent=$(AGENT="" task_field "$child" AGENT)
      branch=$(BRANCH="" task_field "$child" BRANCH)
    fi
    members=$(jq -c --arg agent "$agent" --arg task "$child" --arg branch "$branch" \
      '. + [{agent:$agent,task:$task,branch:$branch,status:"new",commit:""}]' <<< "$members")
  done
  investigation_phase1_write "$parent" "$members"
  log_warn investigation_manifest_recovered "task=$parent" "children=${#recovered_children[@]}"
}

# investigation_team_tick parent records terminal children and releases the cohort only after all end.
# The caller owns dispatch.lock; results are task files, never bus investigations or peer messages.
investigation_team_tick() {
  local parent=$1 member child state agent members='[]' active=0 successful=0 verifying=0 working="" checking="" stage base note commit rc
  [[ $(task_field "$parent" STATUS) != stopped && ! -f $TASKS/$parent/stop-requested ]] || return 0
  if [[ $(investigation_field "$parent" INVESTIGATION_PIPELINE) == 1 && $(investigation_field "$parent" INVESTIGATION_PHASE) != 1 ]]; then
    if [[ $(investigation_field "$parent" INVESTIGATION_PHASE) == 5 ]]; then investigation_resume_tick "$parent"
    else investigation_pipeline_tick "$parent"; fi
    return
  fi
  if [[ ! -f $TASKS/$parent/phase1.json ]]; then investigation_phase1_recover "$parent"; fi
  base=$(task_field "$parent" INVESTIGATION_BASE_SHA)
  while IFS= read -r member; do
    state=$(jq -r .status <<< "$member")
    agent=$(jq -r .agent <<< "$member")
    if [[ $state != done && $state != failed ]]; then
      child=$(jq -r .task <<< "$member")
      note=""; commit=""
      if [[ -f $TASKS/$child/meta.env ]]; then state=$(task_field "$child" STATUS); else state=failed; fi
      case $state in
        new)
          state=failed; note="admission was interrupted before the independent runner started"
          meta_set "$child" NOTE "$note"
          meta_set "$child" STATUS failed ;;
        starting|running|waiting)
          active=$((active + 1)); working="${working:+$working, }$agent" ;;
        done)
          if investigation_published "$child" "$base"; then
            state=done; commit=$INVESTIGATION_RESULT_COMMIT
          else
            rc=$?; note=$INVESTIGATION_RESULT_ERROR
            if ((rc == 2)); then
              state=verifying; verifying=$((verifying + 1)); checking="${checking:+$checking, }$agent"
            else
              state=failed
              meta_set "$child" NOTE "$note"
              meta_set "$child" STATUS failed
            fi
          fi ;;
        *)
          state=failed; note="the independent run ended without a successful result"
          if [[ -f $TASKS/$child/meta.env ]]; then meta_set "$child" STATUS failed; fi ;;
      esac
      member=$(jq -c --arg status "$state" --arg commit "$commit" --arg note "$note" \
        '.status=$status | .commit=$commit | .note=$note' <<< "$member")
    fi
    [[ $state != done ]] || successful=$((successful + 1))
    members=$(jq -c --argjson member "$member" '. + [$member]' <<< "$members")
  done < <(jq -c '.members[]' "$TASKS/$parent/phase1.json")
  investigation_phase1_write "$parent" "$members"
  if ((active || verifying)); then
    if ((active)); then
      stage="phase 1: $active investigators working ($working)"
      if ((verifying)); then stage+="; verifying published results ($checking)"; fi
    else
      stage="phase 1: verifying published results ($checking)"
    fi
    auto_stage "$parent" "$stage"
    return
  fi
  if ((successful)) && [[ $(investigation_field "$parent" INVESTIGATION_PIPELINE) == 1 ]]; then
    meta_set "$parent" INVESTIGATION_PHASE 2
    if investigation_solo "$parent"; then investigation_solo_owner "$parent"; return; fi
    investigation_phase_choose "$parent" 2
    return
  fi
  if [[ $(investigation_field "$parent" INVESTIGATION_PIPELINE) == 1 ]]; then
    investigation_handoff "$parent" 'waits for you: all phase 1 runs failed' failed
    return
  fi
  if ((successful)); then stage='complete: phase 1 complete (merge not available yet)'
  else stage='failed: all phase 1 runs failed'; fi
  meta_set "$parent" INVESTIGATION_LEASE ""
  meta_set "$parent" FINISHED "$(date -Is)"
  auto_stage "$parent" "$stage" no-comment
  if ((successful)); then
    meta_set "$parent" STATUS done
    notify "$parent" done "$stage" "Independent phase one finished; no merge or PR was attempted."
  else
    meta_set "$parent" STATUS failed
    notify "$parent" failed "$stage" "No investigator published a successful result."
  fi
}

# investigation_field task key reads optional metadata without inheriting the dispatching task's value.
investigation_field() { ( unset "$2"; task_field "$1" "$2"; ) }

# investigation_completed_wait parent identifies an old completed handoff still marked waiting.
# Only a recorded terminal result in Phase 4 proves completion; clarification and capacity waits stay active.
investigation_completed_wait() {
  local parent=$1 result
  [[ $(task_field "$parent" STATUS) == waiting \
    && $(investigation_field "$parent" INVESTIGATION_PIPELINE) == 1 \
    && $(investigation_field "$parent" INVESTIGATION_PHASE) == 4 ]] || return 1
  result=$(investigation_field "$parent" INVESTIGATION_HANDOFF_RESULT)
  [[ $result == done || $result == failed ]]
}

# investigation_handoff parent stage result records terminal completion and delivers the PR summary once.
investigation_handoff() {
  local parent=$1 stage=$2 result=$3 PR_URL='' REVIEW=0 WORK_ROUND='' WORK_ROUNDS='' JOB_ID='' JOB_LEAD='' LEAD_URL=''
  # Older interrupted hand-offs persist a decision-wait stage; normalize it on recovery too.
  stage="${stage#waits for you: }"
  if [[ $stage != complete:* && $stage != failed:* ]]; then
    if [[ $result == done ]]; then stage="complete: $stage"; else stage="failed: $stage"; fi
  fi
  meta_set "$parent" INVESTIGATION_HANDOFF_STAGE "$stage"
  meta_set "$parent" INVESTIGATION_HANDOFF_RESULT "$result"
  meta_set "$parent" INVESTIGATION_HANDOFF_PENDING 1
  meta_set "$parent" INVESTIGATION_PHASE 4
  meta_set "$parent" FINISHED "$(date -Is)"
  auto_stage "$parent" "$stage" no-comment
  meta_set "$parent" INVESTIGATION_LEASE ""
  if [[ $(investigation_field "$parent" INVESTIGATION_COMMENTED) != 1 ]]; then
    human_on_pr "$parent" "$stage; investigation finished; nothing was merged" --investigation
    meta_set "$parent" INVESTIGATION_COMMENTED 1
  fi
  if [[ $(investigation_field "$parent" INVESTIGATION_NOTIFIED) != 1 ]]; then
    ( notify "$parent" "$result" "$stage" 'Investigation finished. Nothing was merged automatically.' )
    meta_set "$parent" INVESTIGATION_NOTIFIED 1
  fi
  # Publish the terminal status only after delivery, so interrupted completion remains recoverable.
  meta_set "$parent" STATUS "$result"
  meta_set "$parent" INVESTIGATION_HANDOFF_PENDING ""
}

# investigation_phase_start parent phase investigator creates a recoverable independent merger or review run.
investigation_phase_start() {
  local parent=$1 phase=$2 name=$3 root repo base stamp child text key kv target merger checked rc
  local names=("$name") roots=() repos=()
  local -A AGENT_TYPE=() AGENT_MODEL=() AGENT_EXTRA_ARGS=()
  root=$(task_field "$parent" REPO_ROOT); repo=$(task_field "$parent" REPO_NAME)
  base=$(task_field "$parent" INVESTIGATION_BASE_SHA)
  target=$(investigation_field "$parent" INVESTIGATION_TARGET_BRANCH); target=${target:-main}
  text="Investigate the topic independently."
  if [[ -f $TASKS/$parent/task.md ]]; then text=$(<"$TASKS/$parent/task.md"); fi
  key=MERGER
  if [[ $phase == 3 ]]; then
    checked=$(investigation_field "$parent" PRECHECK_HEAD)
    merger=$(investigation_field "$parent" INVESTIGATION_MERGER_TASK)
    # Capacity may have delayed review admission; the published result must still match the checked head.
    if [[ -n $checked && -n $merger ]]; then
      if investigation_published "$merger" "$(task_field "$parent" INVESTIGATION_BASE_SHA)"; then
        if [[ $INVESTIGATION_RESULT_COMMIT != "$checked" ]]; then
          meta_set "$parent" INVESTIGATION_PHASE 2
          meta_set "$parent" INVESTIGATION_PRECHECK_REASON 'The published merger result changed after its checks.'
          meta_set "$parent" INVESTIGATION_PRECHECK failed
          return
        fi
      else
        rc=$?
        if ((rc != 2)); then
          meta_set "$parent" INVESTIGATION_PHASE 2
          meta_set "$parent" INVESTIGATION_PRECHECK_REASON 'The published merger result no longer matches its checks.'
          meta_set "$parent" INVESTIGATION_PRECHECK failed
        fi
        return
      fi
    fi
    key=REVIEWER
    target=$(investigation_field "$parent" BRANCH); target=${target:-main}
    base=$(investigation_field "$parent" PRECHECK_HEAD); base=${base:-$(task_field "$parent" INVESTIGATION_BASE_SHA)}
    text="Review this PR independently. Propose improvements or other points of view and publish your verdict using the review protocol. Do not apply changes, merge, delegate, or contact other investigators.
$text"
  fi
  AGENT_TYPE[$name]=${INVESTIGATORS_TYPE[$name]}
  AGENT_MODEL[$name]=${INVESTIGATORS_MODEL[$name]:-}
  AGENT_EXTRA_ARGS[$name]=${INVESTIGATORS_EXTRA_ARGS[$name]:-}
  roots=("$root"); repos=("$repo")
  lock_task_ids
  stamp=$(allocate_run_ids 0 names roots repos); child="$stamp-$name"
  # A crash after this record leaves an unstarted child that the next dispatch can fail and replace.
  meta_set "$parent" "INVESTIGATION_${key}" "$name"
  meta_set "$parent" "INVESTIGATION_${key}_TASK" "$child"
  if create_task "$name" "$text" "$root" "$root" "$target" "$stamp" "" "$base" "$(task_round_id "$parent")"; then
    for kv in 'KIND=investigation' "INVESTIGATION_TEAM=$parent" "INVESTIGATION_PHASE=$phase" \
        "PARENT_TASK=$parent" 'PARENT_WORKTREE=' "INV_ID=$child" 'TEAM=' 'TIER=normal' \
        "REVIEW=$(if [[ $phase == 3 ]]; then printf 1; fi)" \
        "PR_URL=$(investigation_field "$parent" PR_URL)" "PR_NUMBER=$(investigation_field "$parent" PR_NUMBER)" \
        "INVESTIGATION_BASE_SHA=$(task_field "$parent" INVESTIGATION_BASE_SHA)" \
        "INVESTIGATION_TARGET_BRANCH=$target" "INVESTIGATION_PHASE1_MANIFEST=$TASKS/$parent/phase1.json" \
        "INVESTIGATION_TOPIC_SLUG=$(task_field "$parent" INVESTIGATION_TOPIC_SLUG)"; do
      meta_set "$child" "${kv%%=*}" "${kv#*=}"
    done
    if [[ $phase == 2 ]]; then meta_set "$parent" INVESTIGATION_MERGER_BRANCH "$(task_field "$child" BRANCH)"; fi
    if [[ $phase == 2 && -n $(investigation_field "$parent" INVESTIGATION_PR_BRANCH) ]]; then
      investigation_pr_merger_note "$parent" "$child"
    fi
    unlock_task_ids
    if ! start_runner "$child" new; then meta_set "$child" STATUS failed; fi
  else
    unlock_task_ids
    log_error investigation_start_failed "task=$parent" "investigator=$name" "reason=$CREATE_TASK_ERROR"
    auto_stage "$parent" "waiting: $name could not start phase $phase"
    return
  fi
  if [[ $phase == 2 ]]; then auto_stage "$parent" "merging: $name"
  else auto_stage "$parent" "review: $name (#$(investigation_field "$parent" PR_NUMBER))"; fi
}

# investigation_phase_choose parent phase starts one available candidate, queues capacity, or hands off exhausted work.
investigation_phase_choose() {
  local parent=$1 phase=$2
  if ! investigation_phase_pick "$parent" "$phase"; then
    if [[ $phase == 2 ]]; then
      investigation_handoff "$parent" 'waits for you: merge failed' failed
    else
      investigation_handoff "$parent" 'waits for you: review failed' failed
    fi
    return
  fi
  if [[ -n $INVESTIGATION_PICK ]]; then
    investigation_phase_start "$parent" "$phase" "$INVESTIGATION_PICK"
  elif ((INVESTIGATION_ELIGIBLE)); then
    auto_stage "$parent" 'waiting: capacity queue'
  elif [[ $phase == 2 ]]; then
    investigation_handoff "$parent" 'waits for you: merge failed' failed
  else
    investigation_handoff "$parent" 'waits for you: review failed' failed
  fi
}

# investigation_solo parent — whether the investigation's team is one investigator: its result is the only one,
# there is nothing to merge
investigation_solo() {
  local team
  team=$(investigation_field "$1" INVESTIGATION_TEAM); team=${team// /}
  [[ -n $team && $team != *,* ]]
}

# investigation_solo_owner parent — a team of one: no merger runs. Its investigator owns the PR (its phase-one task
# stands for the merger's): the PR is opened from its branch, and it fixes what the checks and the reviews find
investigation_solo_owner() {
  local parent=$1 agent task
  agent=$(jq_soft investigation_phase_parse -r '[.members[] | select(.status == "done")][0].agent // empty' "$TASKS/$parent/phase1.json")
  task=$(jq_soft investigation_phase_parse -r '[.members[] | select(.status == "done")][0].task // empty' "$TASKS/$parent/phase1.json")
  if [[ -z $agent || -z $task ]]; then investigation_handoff "$parent" 'waits for you: no result to open a PR from' failed; return; fi
  meta_set "$parent" INVESTIGATION_MERGER "$agent"
  meta_set "$parent" INVESTIGATION_MERGER_TASK "$task"
  log_info investigation_solo_owner "task=$parent" "agent=$agent" "child=$task"
  auto_stage "$parent" "opening the PR of $agent's branch (one investigator: nothing to merge)"
}

# investigation_pr_merger_note parent merger-task — the merger of an investigation on an open PR (--pr) opens none:
# its task says so, and that the script brings its commits onto the PR
investigation_pr_merger_note() {
  local parent=$1 child=$2 num pr_branch
  num=$(investigation_field "$parent" PR_NUMBER); pr_branch=$(investigation_field "$parent" INVESTIGATION_PR_BRANCH)
  printf "\n# This investigation's PR\n\nThis investigation continues PR #%s (branch %s), which exists already. Do not open a pull request. Push your branch: the script brings your commits onto PR #%s's branch. Write your merge rationale as a comment on PR #%s instead of a new description.\n" \
    "$num" "$pr_branch" "$num" "$num" >> "$TASKS/$child/task.md"
}

# investigation_pr_sync parent child — an investigation on an open PR (--pr): the child's published commit (its
# branch, started from the PR's head) goes onto the PR's branch. When that branch moved meanwhile (often: main merged
# into it on GitHub), its head is merged into the result in the child's own worktree — its run is over — and the merge
# goes onto both branches, so the child's published result and the PR's head stay one commit (the review checks
# that). False on a conflict, or when git refuses: logged with git's words; the human decides
investigation_pr_sync() {
  local parent=$1 child=$2 root pr_branch commit wt out head merged num
  root=$(task_field "$parent" REPO_ROOT); pr_branch=$(investigation_field "$parent" INVESTIGATION_PR_BRANCH)
  num=$(investigation_field "$parent" PR_NUMBER); wt=$(task_field "$child" WORKTREE)
  commit=${INVESTIGATION_RESULT_COMMIT:-}
  [[ -n $commit ]] || commit=$(git -C "$root" rev-parse -q --verify "origin/$(task_field "$child" BRANCH)^{commit}") || return 1
  if out=$(git -C "$root" push -q origin "$commit:refs/heads/$pr_branch" 2>&1 10>&-); then
    log_info investigation_pr_synced "task=$parent" "child=$child" "commit=$commit" "branch=$pr_branch"
    return 0
  fi
  log_info investigation_pr_moved "task=$parent" "branch=$pr_branch" "push=${out:0:300}"
  if [[ ! -d $wt || -n $(git -C "$wt" status --porcelain 2> /dev/null) ]]; then
    log_warn investigation_pr_sync_failed "task=$parent" "child=$child" "error=the result's worktree is missing or not clean"
    return 1
  fi
  if ! out=$(git -C "$wt" fetch -q origin "refs/heads/$pr_branch" 2>&1 10>&-) || ! head=$(git -C "$wt" rev-parse FETCH_HEAD); then
    log_warn investigation_pr_sync_failed "task=$parent" "child=$child" "error=fetch: ${out:0:300}"
    return 1
  fi
  if ! out=$(cd "$wt" && AGENT=$(task_field "$child" AGENT) && git_identity > /dev/null \
      && git merge -q --no-edit -m "Merge the head of PR #$num ($pr_branch) into the work of $AGENT" "$head" 2>&1 10>&-); then
    git -C "$wt" merge --abort 2> /dev/null || log_warn investigation_pr_merge_abort_failed "task=$parent" "worktree=$wt"
    log_warn investigation_pr_sync_failed "task=$parent" "child=$child" "error=merge of $head: ${out:0:300}"
    return 1
  fi
  merged=$(git -C "$wt" rev-parse HEAD) || return 1
  if ! out=$(git -C "$wt" push -q origin "HEAD:refs/heads/$(task_field "$child" BRANCH)" "HEAD:refs/heads/$pr_branch" 2>&1 10>&-); then
    log_warn investigation_pr_sync_failed "task=$parent" "child=$child" "error=push of the merge: ${out:0:300}"
    return 1
  fi
  INVESTIGATION_RESULT_COMMIT=$merged
  meta_set "$parent" PRECHECK_HEAD "$merged"
  log_info investigation_pr_synced "task=$parent" "child=$child" "commit=$merged" "branch=$pr_branch" "merged=$head"
}

# investigation_solo_pr parent child base — opens the PR of a team of one investigator, from its branch; the checks and
# the reviews follow as for a merged PR
investigation_solo_pr() {
  local parent=$1 child=$2 base=$3 root branch agent round line title
  root=$(task_field "$parent" REPO_ROOT); branch=$(task_field "$child" BRANCH); agent=$(task_field "$child" AGENT)
  round=$(round_id_of "$(<"$TASKS/$parent/task.md")" 2> /dev/null) || round=""
  line=$(grep -m 1 -vE '^[[:space:]]*($|Round:)' "$TASKS/$parent/task.md")
  title="${round:+$round: }${line:-investigation by $agent}"
  title=${title:0:72}
  if (cd "$root" && gh pr create --base "$base" --head "$branch" --title "$title" \
      --body "The work of $agent for this investigation. A team of one investigator has nothing to merge: the script opened this PR from its branch; investigators from outside the team review it, and $agent fixes what they find, on this branch." > /dev/null); then
    log_info investigation_solo_pr_opened "task=$parent" "branch=$branch"
    return 0
  fi
  log_warn investigation_solo_pr_failed "task=$parent" "branch=$branch"
  return 1
}

# investigation_fix_pass parent review-task review-text — the review asks for changes: the merger fixes them on its
# branch, the same PR (phase 2 again: its checks, then a new review), up to VERIFY_MAX_FIX_PASSES passes; after them
# the human decides. The reviewer joins the past reviewers, most recent last: the next pass is reviewed by another
investigation_fix_pass() {
  local parent=$1 review=$2 text=$3 passes merger reviewer past p rest=""
  passes=$(investigation_field "$parent" INVESTIGATION_FIX_PASSES)
  if ((${passes:-0} >= VERIFY_MAX_FIX_PASSES)); then
    investigation_handoff "$parent" \
      "waits for you: the review still asks for changes after ${passes:-0} fix passes (#$(investigation_field "$parent" PR_NUMBER))" done
    return
  fi
  passes=$((${passes:-0} + 1))
  merger=$(investigation_field "$parent" INVESTIGATION_MERGER_TASK)
  reviewer=$(task_field "$review" AGENT)
  past=$(investigation_field "$parent" INVESTIGATION_PAST_REVIEWERS)
  local -a past_list=()
  IFS=, read -r -a past_list <<< "$past"
  for p in "${past_list[@]}"; do [[ -z $p || $p == "$reviewer" ]] || rest+="${rest:+,}$p"; done
  meta_set "$parent" INVESTIGATION_PAST_REVIEWERS "${rest:+$rest,}$reviewer"
  meta_set "$parent" INVESTIGATION_FIX_PASSES "$passes"
  meta_set "$parent" INVESTIGATION_PHASE 2
  meta_set "$parent" INVESTIGATION_PRECHECK ""
  meta_set "$parent" INVESTIGATION_MERGE_RETRIES ""
  meta_set "$parent" INVESTIGATION_REVIEWER ""
  meta_set "$parent" INVESTIGATION_REVIEWER_TASK ""
  meta_set "$parent" INVESTIGATION_TRIED_REVIEWERS ""
  meta_set "$parent" INVESTIGATION_REVIEW_RETRIES ""
  printf '\n# Review findings to fix (pass %s of %s)\n\nThe review of PR #%s by %s asks for changes. Fix them on this branch and push it: the PR updates. Do not open another pull request, and do not close this one. Where a finding is wrong, say why in a comment on the PR instead of changing the code.\n\n%s\n' \
    "$passes" "$VERIFY_MAX_FIX_PASSES" "$(investigation_field "$parent" PR_NUMBER)" "$reviewer" "$text" >> "$TASKS/$merger/task.md"
  log_info investigation_fix_pass "task=$parent" "pass=$passes" "merger=$merger" "reviewer=$reviewer"
  if ! start_runner "$merger" resume; then meta_set "$merger" STATUS failed; fi
  auto_stage "$parent" "merging: $(task_field "$merger" AGENT) (fix pass $passes/$VERIFY_MAX_FIX_PASSES after review)"
}

# investigation_phase_failed parent phase permits one different investigator to replace a failed run. A merger is not
# replaced once its PR exists: the replacement would open another PR — the human decides
investigation_phase_failed() {
  local parent=$1 phase=$2 key count role prior tried
  if [[ $phase == 2 && -n $(investigation_field "$parent" INVESTIGATION_PR) ]]; then
    investigation_handoff "$parent" "waits for you: merge failed on PR #$(investigation_field "$parent" PR_NUMBER)" failed
    return
  fi
  if [[ $phase == 2 ]]; then key=INVESTIGATION_MERGER_REPLACEMENTS; role=MERGER
  else key=INVESTIGATION_REVIEW_RETRIES; role=REVIEWER; fi
  count=$(investigation_field "$parent" "$key")
  if ((${count:-0} >= 1)); then
    if [[ $phase == 2 ]]; then investigation_handoff "$parent" 'waits for you: merge failed' failed
    else investigation_handoff "$parent" 'waits for you: review failed' failed; fi
    return
  fi
  meta_set "$parent" "$key" 1
  prior=$(investigation_field "$parent" "INVESTIGATION_$role")
  tried=$(investigation_field "$parent" "INVESTIGATION_TRIED_${role}S")
  meta_set "$parent" "INVESTIGATION_TRIED_${role}S" "${tried:+$tried,}$prior"
  meta_set "$parent" "INVESTIGATION_${role}_TASK" ""
  meta_set "$parent" INVESTIGATION_PRECHECK ""
  investigation_phase_choose "$parent" "$phase"
}

# investigation_pipeline_tick parent observes terminal independent runs and advances phases without automatic merging.
investigation_pipeline_tick() {
  local parent=$1 phase child state rc root branch prs url number check retries verdict text unit check_run expected_base
  phase=$(investigation_field "$parent" INVESTIGATION_PHASE)
  if [[ $phase == 4 ]]; then
    investigation_handoff "$parent" "$(investigation_field "$parent" INVESTIGATION_HANDOFF_STAGE)" "$(investigation_field "$parent" INVESTIGATION_HANDOFF_RESULT)"
    return
  fi
  if [[ $phase == 2 ]]; then child=$(investigation_field "$parent" INVESTIGATION_MERGER_TASK)
  else child=$(investigation_field "$parent" INVESTIGATION_REVIEWER_TASK); fi
  if [[ -z $child ]]; then investigation_phase_choose "$parent" "$phase"; return; fi
  state=failed
  if [[ -f $TASKS/$child/meta.env ]]; then state=$(task_field "$child" STATUS); fi
  case $state in
    starting|running|sleeping|waiting|paused|investigating|interrupted) return ;;
    done) ;;
    new)
      # Dispatch owns admission: this recorded child never reached its runner.
      meta_set "$child" STATUS failed
      investigation_phase_failed "$parent" "$phase"; return ;;
    *) investigation_phase_failed "$parent" "$phase"; return ;;
  esac
  if [[ $phase == 3 ]]; then
    text=""
    if [[ -s $TASKS/$child/final.md ]]; then text=$(<"$TASKS/$child/final.md"); fi
    if [[ -s $TASKS/$child/result.md ]]; then text+=$'\n'$(cat "$TASKS/$child/result.md"); fi
    # This pipeline requires an explicit verdict; legacy finding-only reviews cannot complete it.
    verdict=$(review_verdict "$text")
    if [[ -n $verdict ]]; then verdict=$(review_task_verdict "$child" "$text"); fi
    case $verdict in
      ready-to-merge)
        meta_set "$parent" INVESTIGATION_VERDICT "$verdict"
        investigation_handoff "$parent" "waits for you: review ready (#$(investigation_field "$parent" PR_NUMBER))" done ;;
      needs-fixes|incomplete)
        meta_set "$parent" INVESTIGATION_VERDICT "$verdict"
        investigation_fix_pass "$parent" "$child" "$text" ;;
      *) investigation_phase_failed "$parent" 3 ;;
    esac
    return
  fi
  check=$(investigation_field "$parent" INVESTIGATION_PRECHECK)
  case $check in
    running)
      unit=$(investigation_field "$parent" INVESTIGATION_PRECHECK_UNIT)
      if [[ -n $unit ]] && systemctl --user is-active --quiet "$unit.service"; then return; fi
      # Dispatch owns the admission lock, so an inactive recorded unit cannot still be launching.
      meta_set "$parent" INVESTIGATION_PRECHECK_REASON 'The check runner was interrupted before recording its result.'
      meta_set "$parent" INVESTIGATION_PRECHECK failed
      log_warn investigation_precheck_interrupted "task=$parent" "unit=$unit"
      return ;;
    human) return ;;   # waits for the human's allowance (investigation_wait_allow): agent allow runs the checks again
    passed)
      meta_set "$parent" INVESTIGATION_PHASE 3
      investigation_phase_choose "$parent" 3
      return ;;
    failed)
      retries=$(investigation_field "$parent" INVESTIGATION_MERGE_RETRIES)
      if ((${retries:-0} == 0)); then
        meta_set "$parent" INVESTIGATION_MERGE_RETRIES 1
        meta_set "$parent" INVESTIGATION_PRECHECK ""
        printf '\n# Checks to fix\n\n%s\n' "$(investigation_field "$parent" INVESTIGATION_PRECHECK_REASON)" >> "$TASKS/$child/task.md"
        if ! start_runner "$child" resume; then meta_set "$child" STATUS failed; fi
        auto_stage "$parent" "merging: $(task_field "$child" AGENT) (fix checks)"
      else
        investigation_phase_failed "$parent" 2
      fi
      return ;;
  esac
  if investigation_published "$child" "$(task_field "$parent" INVESTIGATION_BASE_SHA)"; then
    meta_set "$parent" PRECHECK_HEAD "$INVESTIGATION_RESULT_COMMIT"
  else
    rc=$?
    if ((rc == 2)); then return; fi
    investigation_phase_failed "$parent" 2; return
  fi
  root=$(task_field "$parent" REPO_ROOT); branch=$(task_field "$child" BRANCH)
  local pr_branch
  pr_branch=$(investigation_field "$parent" INVESTIGATION_PR_BRANCH)
  if [[ -n $pr_branch ]]; then   # an investigation on an open PR (--pr): its work goes onto that PR, no other opens
    if ! investigation_pr_sync "$parent" "$child"; then
      investigation_handoff "$parent" \
        "waits for you: the work could not be brought onto PR #$(investigation_field "$parent" PR_NUMBER) (a conflict with what its branch got meanwhile, or git refused: see the log)" failed
      return
    fi
    url=$(investigation_field "$parent" PR_URL); number=$(investigation_field "$parent" PR_NUMBER); branch=$pr_branch
    expected_base=$(investigation_field "$parent" INVESTIGATION_TARGET_BRANCH)
  else
    if ! prs=$(trusted_prs "$root" "$branch" open 'url,number,baseRefName'); then
      log_warn investigation_pr_lookup_failed "task=$parent" "child=$child"
      return
    fi
    expected_base=$(task_field "$child" BASE)
    if investigation_solo "$parent"; then expected_base=$(investigation_field "$parent" INVESTIGATION_TARGET_BRANCH); fi
    prs=$(jq --arg base "$expected_base" '[.[] | select(.baseRefName == $base)]' <<< "$prs")
    url=$(jq -r '.[0].url // empty' <<< "$prs"); number=$(jq -r '.[0].number // empty' <<< "$prs")
    if [[ -z $url || -z $number ]] && investigation_solo "$parent"; then   # a team of one: its PR, from its branch
      if ! investigation_solo_pr "$parent" "$child" "$expected_base"; then
        investigation_handoff "$parent" "waits for you: the PR of $branch could not be opened" failed
      fi
      return   # the next pass finds it
    fi
    if [[ -z $url || -z $number ]]; then investigation_phase_failed "$parent" 2; return; fi
  fi
  meta_set "$parent" INVESTIGATION_PR "$url"
  meta_set "$parent" PR_URL "$url"; meta_set "$parent" PR_NUMBER "$number"
  meta_set "$parent" BRANCH "$branch"
  if [[ -n $pr_branch ]] || investigation_solo "$parent"; then   # the whole PR is checked, against its base branch
    meta_set "$parent" BASE "$expected_base"
  else
    meta_set "$parent" BASE "$(task_field "$child" BASE)"
  fi
  check_run=$(investigation_field "$parent" INVESTIGATION_PRECHECK_RUN)
  check_run=$((${check_run:-0} + 1))
  unit="agent-$parent-precheck-$check_run"
  meta_set "$parent" INVESTIGATION_PRECHECK_RUN "$check_run"
  meta_set "$parent" INVESTIGATION_PRECHECK_UNIT "$unit"
  meta_set "$parent" INVESTIGATION_PRECHECK running
  if ! systemd-run --user --quiet --collect --unit="$unit" \
      --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
      "$SELF" _precheck "$parent" 3>&- 7>&- 8>&- 9>&- 10>&-; then
    meta_set "$parent" INVESTIGATION_PRECHECK_REASON 'The check runner could not start.'
    meta_set "$parent" INVESTIGATION_PRECHECK failed
    log_error precheck_unit_failed "task=$parent"
  fi
}

# investigation_wait_allow parent command — the investigation's checks found only what the human must allow: it
# waits for the human (INVESTIGATION_PRECHECK=human), told the command; the merger is not sent back, no retry is
# spent. agent allow for it runs the checks again
investigation_wait_allow() {
  local parent=$1 cmd=$2
  meta_set "$parent" INVESTIGATION_PRECHECK human
  auto_stage "$parent" "waits for you: $cmd"
  log_info investigation_waits_for_allow "task=$parent" "command=$cmd"
  ( notify "$parent" paused "" "PR #$(investigation_field "$parent" PR_NUMBER) changes what only you may allow (AGENTS.md \"Never\") — review it, then run: $cmd — its checks run again, then its review" )
}

# Helpers for investigation team phase 2 (merger) and phase 3 (reviewer) candidate selection.

# _investigator_is_busy parent agent now checks if investigator is held by an external lease, active, or quota-paused.
_investigator_is_busy() {
  local parent=$1 inv=$2 now=$3 d tid ext_team st qu
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    tid=${d%/}; tid=${tid##*/}
    if [[ $tid != "$parent" && $(task_field "$tid" KIND) == investigation_team && $(investigation_field "$tid" INVESTIGATION_LEASE) == 1 ]]; then
      ext_team=$(investigation_field "$tid" INVESTIGATION_TEAM)
      if [[ ,${ext_team}, == *",$inv,"* ]]; then return 0; fi
    fi
    [[ $(task_field "$tid" AGENT) == "$inv" && $(task_field "$tid" KIND) == investigation ]] || continue
    st=$(task_field "$tid" STATUS)
    case $st in new|starting|running|sleeping|waiting|paused|investigating|interrupted) return 0 ;; esac
    qu=$(investigation_field "$tid" QUOTA_UNTIL)
    if [[ -n $qu ]] && (( qu > now )); then return 0; fi
  done
  return 1
}

# investigation_phase_pick parent phase selects an eligible investigator for phase 2 (merger) or phase 3 (reviewer):
# the merger from outside the team (a team of every investigator: one of it that finished phase 1); the reviewer
# from outside the team while one is left, else from the team — never the merger. Drawn at random among the free.
# Sets shell globals INVESTIGATION_PICK (chosen name or empty) and INVESTIGATION_ELIGIBLE (count of untried candidates).
investigation_phase_pick() {
  local parent=$1 phase=$2
  INVESTIGATION_PICK=""
  INVESTIGATION_ELIGIBLE=0

  local eligible=() m file
  if [[ $phase -eq 2 ]]; then
    file="$TASKS/$parent/phase1.json"
    [[ -f $file ]] || return 0
    local p1_done=()
    mapfile -t p1_done < <(jq_soft investigation_phase_parse -r '.members[] | select(.status == "done") | .agent' "$file")
    local team_raw cur_merger tried_mergers
    team_raw=$(investigation_field "$parent" INVESTIGATION_TEAM); team_raw=${team_raw// /}
    cur_merger=$(investigation_field "$parent" INVESTIGATION_MERGER)
    tried_mergers=$(investigation_field "$parent" INVESTIGATION_TRIED_MERGERS)
    tried_mergers+=",${cur_merger:-}"
    # the merger comes from outside the team: an investigator that did not take part in phase 1
    for m in "${!INVESTIGATORS_TYPE[@]}"; do
      [[ ,${team_raw}, == *",$m,"* || ,${tried_mergers}, == *",$m,"* ]] && continue
      eligible+=("$m")
    done
    if ((${#eligible[@]} == 0)); then   # a team of every investigator: one of it that finished phase 1
      for m in "${p1_done[@]}"; do
        [[ -n $m ]] || continue
        [[ -n ${INVESTIGATORS_TYPE[$m]:-} ]] || continue
        [[ ,${team_raw}, == *",$m,"* ]] || continue
        [[ ,${tried_mergers}, == *",$m,"* ]] && continue
        eligible+=("$m")
      done
    fi
  elif [[ $phase -eq 3 ]]; then
    local team_raw cur_merger cur_reviewer tried_reviewers
    team_raw=$(investigation_field "$parent" INVESTIGATION_TEAM)
    cur_merger=$(investigation_field "$parent" INVESTIGATION_MERGER)
    cur_reviewer=$(investigation_field "$parent" INVESTIGATION_REVIEWER)
    tried_reviewers=$(investigation_field "$parent" INVESTIGATION_TRIED_REVIEWERS)
    tried_reviewers+=",${cur_reviewer:-}"
    # the reviewer comes from outside the team while one is left, and is never the merger (who may be an outsider);
    # each fix pass by one who has not reviewed yet, else by the one whose review is the oldest
    local past_reviewers outside=() past_list=()
    past_reviewers=$(investigation_field "$parent" INVESTIGATION_PAST_REVIEWERS)
    for m in "${!INVESTIGATORS_TYPE[@]}"; do
      [[ ,${team_raw// /}, == *",$m,"* || $m == "$cur_merger" || ,${tried_reviewers}, == *",$m,"* ]] && continue
      outside+=("$m")
      [[ ,${past_reviewers}, == *",$m,"* ]] && continue
      eligible+=("$m")
    done
    if ((${#eligible[@]} == 0 && ${#outside[@]} > 0)); then
      IFS=, read -r -a past_list <<< "$past_reviewers"
      for m in "${past_list[@]}"; do
        [[ " ${outside[*]} " == *" $m "* ]] || continue
        eligible=("$m")
        break
      done
    fi
    local raw_members=()
    IFS=, read -r -a raw_members <<< "$team_raw"
    ((${#eligible[@]} == 0)) || raw_members=()   # someone outside the team reviews: the team is not drawn from
    for m in "${raw_members[@]}"; do
      m=$(echo "$m" | tr -d ' ')
      [[ -n $m ]] || continue
      [[ -n ${INVESTIGATORS_TYPE[$m]:-} ]] || continue
      # A sole investigator still reviews; larger cohorts use an independent reviewer.
      [[ ${#raw_members[@]} -gt 1 && $m == "$cur_merger" ]] && continue
      [[ ,${tried_reviewers}, == *",$m,"* ]] && continue
      eligible+=("$m")
    done
  else
    return 1
  fi

  # Sort eligible candidates for reproducibility
  mapfile -t eligible < <(printf '%s\n' "${eligible[@]}" | sort -u | sed '/^$/d')
  INVESTIGATION_ELIGIBLE=${#eligible[@]}
  (( INVESTIGATION_ELIGIBLE )) || return 0

  # Filter eligible candidates for capacity: exclude external leases, active children, and quota pauses
  local now available=()
  now=$(date +%s)
  for m in "${eligible[@]}"; do
    _investigator_is_busy "$parent" "$m" "$now" && continue
    available+=("$m")
  done

  local n=${#available[@]}
  (( n )) || return 0

  local seed attempt idx=0 limit=$(( (4294967296 / n) * n ))
  seed=$(investigation_field "$parent" INVESTIGATION_SEED)
  [[ -n $seed ]] || seed=${AGENT_INVESTIGATION_SEED:-}

  if [[ $phase -eq 2 ]]; then
    attempt=$(investigation_field "$parent" INVESTIGATION_MERGER_REPLACEMENTS)
  else
    attempt=$(investigation_field "$parent" INVESTIGATION_REVIEW_RETRIES)
  fi
  attempt=${attempt:-0}

  if [[ -n $seed ]]; then
    if [[ ! $seed =~ ^[0-9]+$ ]]; then
      log_warn investigation_seed_invalid "task=$parent" "phase=$phase" "seed=$seed"
      return 1
    fi
    local state r
    if ! state=$(printf '%s:%s:%s' "$seed" "$phase" "$attempt" | cksum | awk '{print $1}') || [[ -z $state ]]; then
      log_warn investigation_seed_failed "task=$parent" "phase=$phase" "seed=$seed"
      return 1
    fi
    # Linear congruential generator (LCG) with multiplier 1664525, increment 1013904223, and modulus 2^32.
    # By Hull-Dobell theorem, increment is coprime to modulus and (multiplier-1) is divisible by 4, guaranteeing full period 2^32.
    # Discard samples >= limit = (2^32 / n) * n to eliminate modulo bias across n candidates.
    while :; do
      state=$(( (1664525 * state + 1013904223) & 0xffffffff ))
      r=$state
      if (( r < limit )); then
        idx=$(( r % n ))
        break
      fi
    done
  else
    local r
    # Rejection sampling with /dev/urandom: discard samples >= limit to eliminate modulo bias across n candidates.
    while :; do
      r=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ') || r=""
      if [[ -z $r ]]; then
        log_warn investigation_random_failed "task=$parent" "phase=$phase"
        return 1
      fi
      if (( r < limit )); then
        idx=$(( r % n ))
        break
      fi
    done
  fi

  INVESTIGATION_PICK=${available[idx]}
}

# investigation_team_stop parent cancels owned work outside dispatch.lock and releases its lease last.
investigation_team_stop() (
  local parent=$1 child crun cst file precheck_unit stop_fd parent_status lock_rc=0
  exec {stop_fd}>"$TASKS/$parent/stop.lock"
  # A stopped child's exit handler dispatches again; the outer cleanup owns cancellation.
  if flock -n "$stop_fd"; then lock_rc=0; else lock_rc=$?; fi
  case $lock_rc in
    0) ;;
    1) return 0 ;; # Contention means another cleanup still owns the lease.
    *) log_warn dispatch_lock_timeout "lock=$TASKS/$parent/stop.lock" "effect=retry investigation cleanup"; return 0 ;;
  esac
  parent_status=$(task_field "$parent" STATUS)
  # Admission can still be creating children; release the barrier before cancelling units and their exit handlers.
  (
    exec 9>"$AGENTS_HOME/dispatch.lock"
    flock 9
  )
  # An admission already in flight may have overwritten the terminal status while we waited.
  if [[ -f $TASKS/$parent/stop-requested ]]; then parent_status=stopped; fi
  meta_set "$parent" STATUS "$parent_status"
  precheck_unit=$(investigation_field "$parent" INVESTIGATION_PRECHECK_UNIT)
  if [[ -n $precheck_unit ]]; then
    try unit_stop_failed systemctl --user stop "$precheck_unit.service"
    meta_set "$parent" INVESTIGATION_PRECHECK stopped
  fi
  local -A seen_tasks=()
  local -a task_list=()
  if [[ -f $TASKS/$parent/phase1.json ]]; then
    while IFS= read -r child; do
      [[ -n $child ]] && task_list+=("$child")
    done < <(jq_soft investigation_phase_parse -r '.members[]?.task' "$TASKS/$parent/phase1.json")
  fi
  if [[ -f $TASKS/$parent/resume.json ]]; then
    while IFS= read -r child; do
      [[ -n $child ]] && task_list+=("$child")
    done < <(jq_soft investigation_phase_parse -r '.members[]?.task' "$TASKS/$parent/resume.json")
  fi
  local resume_tasks=()
  IFS=, read -r -a resume_tasks <<< "$(investigation_field "$parent" INVESTIGATION_RESUME_TASKS)"
  task_list+=("${resume_tasks[@]}")
  child=$(investigation_field "$parent" INVESTIGATION_MERGER_TASK)
  [[ -n $child ]] && task_list+=("$child")
  child=$(investigation_field "$parent" INVESTIGATION_REVIEWER_TASK)
  [[ -n $child ]] && task_list+=("$child")
  for file in "$TASKS"/*/meta.env; do
    [[ -f $file ]] || continue
    child=${file%/meta.env}; child=${child##*/}
    if [[ $(investigation_field "$child" INVESTIGATION_TEAM) == "$parent" || $(investigation_field "$child" PARENT_TASK) == "$parent" ]]; then
      task_list+=("$child")
    fi
  done
  for child in "${task_list[@]}"; do
    [[ -n $child && -z ${seen_tasks[$child]:-} && -f $TASKS/$child/meta.env ]] || continue
    seen_tasks[$child]=1
    cst=$(task_field "$child" STATUS)
    case $cst in
      new|starting|running|waiting|investigating|sleeping|paused|interrupted)
        touch "$TASKS/$child/stop-requested"
        crun=$(task_field "$child" RUN)
        try unit_stop_failed systemctl --user stop "$(unit_name "$child" "$crun").service"
        meta_set "$child" STATUS stopped
        meta_set "$child" FINISHED "$(date -Is)"
        act "$child" info "■ stopped (investigation team stopped)"
        log_info task_stopped "task=$child" "parent=$parent"
        ;;
    esac
  done
  meta_set "$parent" INVESTIGATION_LEASE ""
  meta_set "$parent" INVESTIGATION_HANDOFF_PENDING ""
)

# investigation_teams_cleanup cancels terminal cohorts before dispatch takes its global lock.
investigation_teams_cleanup() {
  local m parent st
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    parent=${m%/meta.env}; parent=${parent##*/}
    [[ $(task_field "$parent" KIND) == investigation_team ]] || continue
    st=$(task_field "$parent" STATUS)
    if [[ $st =~ ^(stopped|done|failed)$ || -f $TASKS/$parent/stop-requested ]]; then
      if [[ $(investigation_field "$parent" INVESTIGATION_LEASE) == 1 || $(investigation_field "$parent" INVESTIGATION_HANDOFF_PENDING) == 1 ]]; then
        investigation_team_stop "$parent"
      fi
    fi
  done
}

# investigation_teams_tick runs under dispatch.lock and finalizes each active independent cohort.
investigation_teams_tick() {
  local m parent st
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    parent=${m%/meta.env}; parent=${parent##*/}
    [[ $(task_field "$parent" KIND) == investigation_team ]] || continue
    st=$(task_field "$parent" STATUS)
    if [[ $st =~ ^(stopped|done|failed)$ || -f $TASKS/$parent/stop-requested ]]; then continue; fi
    if [[ $(investigation_field "$parent" INVESTIGATION_LEASE) == 1 || $(investigation_field "$parent" INVESTIGATION_HANDOFF_PENDING) == 1 ]] \
        || investigation_completed_wait "$parent"; then
      investigation_team_tick "$parent"
    fi
  done
}

# investigation_team_admit parent reserves every requested investigator before creating or starting children.
investigation_team_admit() {
  local parent=$1 names=() roots=() repos=() available=() launchable=() name root repo base stamp text child children="" members='[]' state branch kv
  [[ $(task_field "$parent" STATUS) != stopped && ! -f $TASKS/$parent/stop-requested ]] || return 0
  # create_task deliberately reads these dynamically scoped arrays, so investigator configuration wins.
  local -A AGENT_TYPE=() AGENT_MODEL=() AGENT_EXTRA_ARGS=()
  IFS=, read -r -a names <<< "$(task_field "$parent" INVESTIGATION_TEAM)"
  mapfile -t available < <(free_investigator_list)
  for name in "${names[@]}"; do
    if ! is_one_of "$name" "${available[@]}"; then
      auto_stage "$parent" 'waiting: capacity queue'
      return 0
    fi
  done
  root=$(task_field "$parent" REPO_ROOT); repo=$(task_field "$parent" REPO_NAME)
  base=$(task_field "$parent" INVESTIGATION_BASE_SHA); text=$(<"$TASKS/$parent/task.md")
  for name in "${names[@]}"; do
    roots+=("$root"); repos+=("$repo")
    AGENT_TYPE[$name]=${INVESTIGATORS_TYPE[$name]}
    AGENT_MODEL[$name]=${INVESTIGATORS_MODEL[$name]:-}
    AGENT_EXTRA_ARGS[$name]=${INVESTIGATORS_EXTRA_ARGS[$name]:-}
  done
  lock_task_ids
  stamp=$(allocate_run_ids 0 names roots repos)
  # Predeclare every child before taking capacity, including tasks not yet initialized or tagged.
  for name in "${names[@]}"; do
    child="$stamp-$name"; branch="$BRANCH_PREFIX/$name/$stamp"
    children="${children:+$children,}$child"
    members=$(jq -c --arg agent "$name" --arg task "$child" --arg branch "$branch" \
      '. + [{agent:$agent,task:$task,branch:$branch,status:"new",commit:""}]' <<< "$members")
  done
  meta_set "$parent" INVESTIGATION_PHASE1_TASKS "$children"
  investigation_phase1_write "$parent" "$members"
  meta_set "$parent" INVESTIGATION_LEASE 1
  meta_set "$parent" STATUS running
  members='[]'
  for name in "${names[@]}"; do
    child="$stamp-$name"; state=new; branch="$BRANCH_PREFIX/$name/$stamp"
    if create_task "$name" "$text" "$root" "$root" "$base" "$stamp" "" "$base" "$(task_round_id "$parent")"; then
      for kv in 'KIND=investigation' "INVESTIGATION_TEAM=$parent" 'INVESTIGATION_PHASE=1' \
          "PARENT_TASK=$parent" 'PARENT_WORKTREE=' 'INV_ID=' 'TEAM=' 'REVIEW=' 'TIER=normal' \
          "INVESTIGATION_TOPIC_SLUG=$(task_field "$parent" INVESTIGATION_TOPIC_SLUG)"; do
        meta_set "$child" "${kv%%=*}" "${kv#*=}"
      done
      launchable+=("$child")
    else
      state=failed
      log_error investigation_start_failed "task=$parent" "investigator=$name" "reason=$CREATE_TASK_ERROR"
    fi
    members=$(jq -c --arg agent "$name" --arg task "$child" --arg branch "$branch" --arg status "$state" \
      '. + [{agent:$agent,task:$task,branch:$branch,status:$status,commit:""}]' <<< "$members")
  done
  investigation_phase1_write "$parent" "$members"
  unlock_task_ids
  # All worktrees and the complete snapshot exist before any independent CLI can inspect its task.
  for child in "${launchable[@]}"; do
    if ! start_runner "$child" new; then
      meta_set "$child" STATUS failed
      log_error investigation_start_failed "task=$parent" "investigator=$(task_field "$child" AGENT)" "reason=runner launch"
    fi
  done
  investigation_team_tick "$parent"
}

# investigation_teams_admit starts queued cohorts under dispatch.lock after existing review pairs.
investigation_teams_admit() {
  local m parent
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    parent=${m%/meta.env}; parent=${parent##*/}
    if [[ $(task_field "$parent" KIND) == investigation_team && $(task_field "$parent" STATUS) == new \
        ]]; then
      case $(task_field "$parent" INVESTIGATION_PHASE) in
        1) investigation_team_admit "$parent" ;;
        5) investigation_resume_admit "$parent" ;;
      esac
    fi
  done
}

# cmd__investigation_team [--pipeline] --team names [-f topic-file] [--] [topic] starts a cohort.
cmd__investigation_team() {
  local csv="" file="" text="" root common repo base slug stamp parent kv pipeline=0 target round
  local pin_pr="" pin_json="" pin_branch="" pin_url="" earlier=""
  local names=(investigation-team) roots=() repos=()
  while (($#)); do
    case $1 in
      --pipeline) pipeline=1; shift ;;
      --pr) pin_pr=${2:-}; [[ $pin_pr =~ ^[0-9]+$ ]] || die "--pr takes the number of an open PR"; shift 2 ;;
      --team) (($# >= 2)) || die "--team needs investigator names"; csv=$2; shift 2 ;;
      -f) (($# >= 2)) || die "-f needs a topic file"; file=$2; shift 2 ;;
      --) shift; text="${text:+$text }$*"; break ;;
      *) text="${text:+$text }$1"; shift ;;
    esac
  done
  validate_investigation_team "$csv"
  csv=$(printf '%s' "$csv" | sed 's/[[:space:]]*,[[:space:]]*/,/g; s/^[[:space:]]*//; s/[[:space:]]*$//')
  if [[ -n $file ]]; then text=$(cat "$file"); elif [[ -z $text && ! -t 0 ]]; then text=$(cat); fi
  [[ -n ${text//[[:space:]]/} ]] || die "an investigation topic is required"
  round=$(round_id_of "$text") || die "$round"   # before anything starts
  root=$(git rev-parse --show-toplevel)
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
  root=$(dirname "$common"); repo=$(basename "$root")
  base=$(git rev-parse HEAD)
  target=$(git symbolic-ref --quiet --short HEAD) || target=main
  if [[ -n $pin_pr ]]; then   # an investigation on an open PR: from its head, on its base, its work onto that PR
    [[ $pipeline == 1 ]] || die "--pr needs the investigation pipeline"
    pin_json=$(trusted_prs "$root" "" open number,url,headRefName,headRefOid,baseRefName \
      | jq -c --argjson n "$pin_pr" '[.[] | select(.number == $n)][0] // empty') || die "could not look up PR #$pin_pr"
    [[ -n $pin_json ]] || die "PR #$pin_pr is not an open PR of this repository from a trusted account"
    pin_branch=$(jq -r .headRefName <<< "$pin_json"); pin_url=$(jq -r .url <<< "$pin_json")
    base=$(jq -r .headRefOid <<< "$pin_json"); target=$(jq -r '.baseRefName // "main"' <<< "$pin_json")
    git -C "$root" fetch -q origin "$pin_branch" || die "could not fetch PR #$pin_pr's branch $pin_branch"
    git -C "$root" cat-file -e "$base^{commit}" || die "PR #$pin_pr's head $base is not here after a fetch"
    # the task the PR was opened for stays the reviewers' too: the new task comes first, that one after it
    if earlier=$(cd "$root" && gh pr view "$pin_pr" --json body --jq .body 2> /dev/null); then
      earlier=$(pr_body_task_text "$earlier" | grep -v '^Round:')
    else
      earlier=""
    fi
  fi
  slug=$(printf '%s\n' "${text%%$'\n'*}" | LC_ALL=C tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//' | cut -c1-64)
  roots=("$root"); repos=("$repo")
  lock_task_ids
  stamp=$(allocate_run_ids 0 names roots repos); parent="$stamp-investigation-team"
  : > "$TASKS/$parent/meta.env"
  printf '%s\n' "$text" > "$TASKS/$parent/task.md"
  if [[ -n ${earlier//[[:space:]]/} ]]; then
    printf '\n## The task PR #%s was opened for\n\n%s\n' "$pin_pr" "$earlier" >> "$TASKS/$parent/task.md"
  fi
  for kv in "ID=$parent" 'AGENT=investigation-team' 'KIND=investigation_team' 'TYPE=internal' 'MODEL=' 'EXTRA_ARGS=' \
      'TEAM=' 'TIER=normal' 'SESSION_ID=' 'ROUND=0' "ROUND_ID=$round" 'RUN=0' 'RUNNER_DONE=1' 'STATUS=new' "CREATED=$(date -Is)" \
      "REPO_NAME=$repo" "REPO_ROOT=$root" "WORKTREE=$root" 'BRANCH=' "BASE=$base" \
      'INVESTIGATION_PHASE=1' "INVESTIGATION_TEAM=$csv" "INVESTIGATION_BASE_SHA=$base" \
      "INVESTIGATION_TOPIC_SLUG=${slug:-topic}" 'INVESTIGATION_PHASE1_TASKS=' 'INVESTIGATION_LEASE=' \
      "PR_URL=$pin_url" "PR_NUMBER=$pin_pr" "INVESTIGATION_PR=$pin_url" "INVESTIGATION_PR_BRANCH=$pin_branch" \
      "INVESTIGATION_PIPELINE=$pipeline" "INVESTIGATION_SEED=${AGENT_INVESTIGATION_SEED:-}" \
      "INVESTIGATION_TARGET_BRANCH=$target"; do
    meta_set "$parent" "${kv%%=*}" "${kv#*=}"
  done
  unlock_task_ids
  dispatch
  printf '%s\n' "$parent"
}

dispatch() { # starts queued requests on free investigators
  stopping && return 0
  investigation_teams_cleanup
  (
    exec 9>"$AGENTS_HOME/dispatch.lock"
    flock -w 120 9 || { log_warn dispatch_lock_timeout "lock=$AGENTS_HOME/dispatch.lock" "effect=queued investigations wait for the next dispatch"; exit 0; }
    local inv j
    investigation_teams_tick
    start_review_pairs
    investigation_teams_admit
    while inv=$(free_investigator); do
      j=$(bus inv-next --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS") || break
      [[ -n $j ]] || break
      remember_investigator "$inv"
      start_investigation "$j" "$inv" || log_error investigation_start_failed "investigation=$(jq -r .id <<< "$j")" "investigator=$inv"
    done
  )
}

# investigation_task_text job-json from-task from-agent — the task.md of an investigation or a review: a review gets
# its PR, its request when it says more than "Review PR #N (url)" (one of two independent reviews, a re-review after
# a fix pass with the previous review) and the team's task; an investigation its question and context
investigation_task_text() {
  local j=$1 from_task=$2 from_agent=$3 pr_url pr_num q
  if [[ $(jq -r '.kind // empty' <<< "$j") == review ]]; then
    pr_url=$(jq -r '.pr_url // empty' <<< "$j"); pr_num=$(jq -r '.pr_number // empty' <<< "$j")
    q=$(jq -r '.question // empty' <<< "$j")
    printf '## Review PR #%s\n\n%s\n\n' "$pr_num" "$pr_url"
    if [[ -n $q && $q != "Review PR #$pr_num ($pr_url)" ]]; then printf '## The request\n\n%s\n\n' "$q"; fi
    printf '## The task the team worked on\n\n'
    if [[ -f $TASKS/$from_task/task.md ]]; then cat "$TASKS/$from_task/task.md"; else echo "—"; fi
    return 0
  fi
  printf '## Question from %s\n\n%s\n\n' "$from_agent" "$(jq -r .question <<< "$j")"
  printf '## Context from the agent\n\n%s\n' "$(jq -r '.context // "—"' <<< "$j")"
}

start_investigation() { # request-json (status "starting") investigator-name
  local j=$1 iname=$2 inv_id from_task from_agent
  inv_id=$(jq -r .id <<< "$j"); from_task=$(jq -r .from_task <<< "$j"); from_agent=$(jq -r .from_agent <<< "$j")
  if task_stop_requested "$from_task"; then
    bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status failed --summary "requesting task stopped by the human"
    return 0
  fi
  log_info investigation_starting "investigation=$inv_id" "investigator=$iname" "requester=$from_agent" "requesting_task=$from_task"
  local p_root p_repo p_branch p_wt
  p_root=$(task_field "$from_task" REPO_ROOT); p_repo=$(task_field "$from_task" REPO_NAME)
  p_branch=$(task_field "$from_task" BRANCH);  p_wt=$(task_field "$from_task" WORKTREE)
  local ts id branch wt dir
  ts=$(date +%Y%m%d-%H%M%S)
  id="$ts-inv$inv_id"
  branch="$BRANCH_PREFIX/$iname/inv$inv_id-$ts"
  wt="$AGENTS_HOME/worktrees/$p_repo/$id"
  dir="$TASKS/$id"
  mkdir -p "$dir" "$(dirname "$wt")"
  if ! git -C "$p_root" worktree add --quiet -b "$branch" "$wt" "$p_branch"; then
    bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status failed --summary "could not create the investigator worktree"
    meta_set "$from_task" INV_PENDING_DELIVERY "$inv_id"
    maybe_resume_worker "$from_task"
    return 1
  fi
  local kind pr_url pr_num
  kind=$(jq -r '.kind // empty' <<< "$j"); pr_url=$(jq -r '.pr_url // empty' <<< "$j"); pr_num=$(jq -r '.pr_number // empty' <<< "$j")
  investigation_task_text "$j" "$from_task" "$from_agent" > "$dir/task.md"
  : > "$dir/meta.env"
  local sid=""
  [[ ${INVESTIGATORS_TYPE[$iname]} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
  local kv
  for kv in "ID=$id" "AGENT=$iname" "KIND=investigation" "INV_ID=$inv_id" \
            "PARENT_TASK=$from_task" "FROM_AGENT=$from_agent" "PARENT_WORKTREE=$p_wt" \
            "TYPE=${INVESTIGATORS_TYPE[$iname]}" "MODEL=${INVESTIGATORS_MODEL[$iname]:-}" "EXTRA_ARGS=${INVESTIGATORS_EXTRA_ARGS[$iname]:-}" \
            "REPO_NAME=$p_repo" "REPO_ROOT=$p_root" "WORKTREE=$wt" "BRANCH=$branch" \
            "BASE=$p_branch" "SESSION_ID=$sid" "ROUND=0" "ROUND_ID=$(task_round_id "$from_task")" "RUN=0" "STATUS=new" \
            "CREATED=$(date -Is)" "REQUESTER_PR=$(run_pr "$from_task")"; do
    meta_set "$id" "${kv%%=*}" "${kv#*=}"
  done
  if [[ $kind == review ]]; then
    meta_set "$id" REVIEW 1; meta_set "$id" PR_URL "$pr_url"; meta_set "$id" PR_NUMBER "$pr_num"
  fi
  bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status running --inv-task "$id"
  if ! start_runner "$id" new; then
    inv_finish "$id" failed "STATUS: FAILED
Answer: the investigator could not be started"
    return 1
  fi
}

inv_finish() { # investigator-task-id status result-text
  local id=$1 status=$2 text=$3
  local inv_id parent j file summary
  inv_id=$(task_field "$id" INV_ID); parent=$(task_field "$id" PARENT_TASK)
  j=$(bus inv-get --dir "$BUS_DIR" --id "$inv_id")
  file=$(jq -r .file <<< "$j")
  # the investigator's answer line; absent in a malformed result (then the fallbacks below apply)
  summary=$(grep -m1 -E '^(Answer|Odpowiedź):' <<< "$text" | sed -E 's/^(Answer|Odpowiedź):[[:space:]]*//') || summary=""
  if [[ -z $summary ]]; then
    [[ -f $TASKS/$id/result.md ]] && summary=$(awk '/^## (Answer|Odpowiedź)/{f=1;next} /^## /{f=0} f&&NF{print;exit}' "$TASKS/$id/result.md")
  fi
  [[ -n $summary ]] || summary=$(printf '%s' "$text" | grep -m1 -v '^STATUS:') || summary="(no answer line in the result)"
  {
    printf '\n## Investigator result (%s, %s)\n\n' "$status" "$(date '+%Y-%m-%d %H:%M')"
    printf -- '- Investigator task: %s, branch: %s\n\n' "$id" "$(task_field "$id" BRANCH)"
    if [[ -s $TASKS/$id/result.md ]]; then cat "$TASKS/$id/result.md"; else printf '%s\n' "$text"; fi
  } >> "$file"
  bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status "$status" --summary "${summary:0:300}"
  meta_set "$parent" INV_PENDING_DELIVERY "$inv_id"
  maybe_resume_worker "$parent"
}

maybe_resume_worker() { # resumes the requesting agent if the investigation was the only thing it waited for
  stopping && return 0
  local t=$1
  [[ $(task_field "$t" STATUS) == investigating ]] || return 0
  [[ -z $(bus inv-pending --dir "$BUS_DIR" --task "$t") ]] || return 0
  local ag busy
  ag=$(task_field "$t" AGENT)
  if busy=$(agent_running_task "$ag"); then
    log_warn resume_postponed "task=$t" "agent=$ag" "busy_with=$busy" "action=resume manually: agent resume $t"
    return 0
  fi
  start_runner "$t" resume || log_error resume_failed "task=$t" "reason=after investigation"
}

# ------------------------------------------------------------------ worker requests (delegate)

# worker_out_of_service worker — whether a task of the worker was replaced while its model is out of service, and its
# pause has not ended yet (FAILOVER_UNTIL)
worker_out_of_service() {
  local m u now
  now=$(date +%s)
  for m in $(grep -lx "AGENT=$1" "$TASKS"/*/meta.env 2> /dev/null); do
    u=$(sed -n 's/^FAILOVER_UNTIL=//p' "$m")
    [[ $u =~ ^[0-9]+$ ]] && ((u > now)) && return 0
  done
  return 1
}

free_worker() { # a free worker, drawn at random among the free ones of another provider than the last one drawn
  # (worker-last, written by worker_drawn) — among all the free ones when none of another provider is free
  local w last others=() all=()
  last=$(cat "$AGENTS_HOME/worker-last" 2> /dev/null)   # none yet: any provider
  for w in "${WORKER_AGENTS[@]}"; do
    [[ -n ${AGENT_TYPE[$w]:-} ]] || continue
    agent_running_task "$w" > /dev/null && continue
    worker_out_of_service "$w" && continue
    all+=("$w")
    [[ $(agent_provider "$w") == "$last" ]] || others+=("$w")
  done
  if ((${#others[@]})); then printf '%s' "${others[RANDOM % ${#others[@]}]}"; return 0; fi
  if ((${#all[@]})); then printf '%s' "${all[RANDOM % ${#all[@]}]}"; return 0; fi
  return 1
}

# worker_drawn worker — the worker got work: its provider is the last one drawn, which the next draw avoids
worker_drawn() {
  agent_provider "$1" > "$AGENTS_HOME/worker-last.tmp" && mv "$AGENTS_HOME/worker-last.tmp" "$AGENTS_HOME/worker-last" \
    || log_warn worker_last_failed "worker=$1"
}

dispatch_helpers() { # assigns queued requests to free workers
  stopping && return 0
  (
    exec 7>"$AGENTS_HOME/helpers.lock"
    flock -w 60 7 || exit 0
    local caps='[]'
    if ((${#INSTANCE_CAPABILITIES[@]})); then caps=$(printf '%s\n' "${INSTANCE_CAPABILITIES[@]}" | jq -R . | jq -s .); fi
    if [[ -z ${LEAD_URL:-} ]]; then
      local remote_open rows
      if remote_open=$(bus helper-remote-list --dir "$BUS_DIR" --capabilities "$caps"); then
        if rows=$(jq -c '.[]' <<< "$remote_open"); then
          local rh rh_id
          while read -r rh; do
            [[ -n $rh ]] || continue
            if [[ $(jq -r '.status // empty' <<< "$rh") == "queued" ]]; then
              rh_id=$(jq -r '.id' <<< "$rh")
              try helper_finish_failed bus helper-remote-finish --dir "$BUS_DIR" --id "$rh_id" --state failed --node "" --branch "" --result "remote delegation requires LEAD_URL in config/agents.conf"
            fi
          done <<< "$rows"
        else
          log_warn helper_remote_list_parse_failed
        fi
      else
        log_warn helper_remote_list_failed
      fi
    fi
    ((${#WORKER_AGENTS[@]})) || exit 0
    local w j
    while w=$(free_worker); do
      j=$(bus helper-next --dir "$BUS_DIR" --worker "$w" --capabilities "$caps") || break
      [[ -n $j ]] || break
      worker_drawn "$w"   # it gets work: the next draw takes another provider
      start_helper "$j" "$w" || log_error helper_start_failed "request=$(jq -r .id <<< "$j")" "worker=$w"
    done
  )
}

start_helper() { # request-json worker
  local j=$1 w=$2 hid from from_task
  hid=$(jq -r .id <<< "$j"); from=$(jq -r .from <<< "$j"); from_task=$(jq -r .from_task <<< "$j")
  if task_stop_requested "$from_task"; then
    bus helper-set --dir "$BUS_DIR" --id "$hid" --status failed --summary "requesting task stopped by the human"
    return 0
  fi
  log_info helper_starting "request=H$hid" "worker=$w" "requester=$from" "requesting_task=$from_task"
  local p_root p_repo p_branch p_wt
  p_root=$(task_field "$from_task" REPO_ROOT); p_repo=$(task_field "$from_task" REPO_NAME)
  p_branch=$(task_field "$from_task" BRANCH);  p_wt=$(task_field "$from_task" WORKTREE)
  local ts id branch wt dir
  ts=$(date +%Y%m%d-%H%M%S)
  id="$ts-$w-h$hid"
  branch="$BRANCH_PREFIX/$w/h$hid-$ts"
  wt="$AGENTS_HOME/worktrees/$p_repo/$id"
  dir="$TASKS/$id"
  mkdir -p "$dir" "$(dirname "$wt")"
  if [[ -z $p_root ]] || ! git -C "$p_root" worktree add --quiet -b "$branch" "$wt" "$p_branch"; then
    try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status failed --summary "could not create the worktree"
    notice helper_start_failed agentbus "$from" "RESULT H$hid: failed — the worker could not be started (worktree)." "request=H$hid" "worker=$w"
    rm -rf "$dir"
    return 1
  fi
  {
    printf '## Request H%s from %s\n\n%s\n\n' "$hid" "$from" "$(jq -r .request <<< "$j")"
    printf '## Context\n\n%s\n' "$(jq -r '.context // "—"' <<< "$j")"
  } > "$dir/task.md"
  : > "$dir/meta.env"
  local sid=""
  [[ ${AGENT_TYPE[$w]} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
  local kv
  for kv in "ID=$id" "AGENT=$w" "KIND=helper" "TIER=worker" "HELPER_ID=$hid" "PARENT_TASK=$from_task" \
            "FROM_AGENT=$from" "PARENT_WORKTREE=$p_wt" "TYPE=${AGENT_TYPE[$w]}" "MODEL=${AGENT_MODEL[$w]:-}" \
            "EXTRA_ARGS=${AGENT_EXTRA_ARGS[$w]:-}" "REPO_NAME=$p_repo" "REPO_ROOT=$p_root" "WORKTREE=$wt" \
            "BRANCH=$branch" "BASE=$p_branch" "SESSION_ID=$sid" "ROUND=0" "ROUND_ID=$(task_round_id "$from_task")" \
            "RUN=0" "STATUS=new" "CREATED=$(date -Is)" "REQUESTER_PR=$(run_pr "$from_task")"; do
    meta_set "$id" "${kv%%=*}" "${kv#*=}"
  done
  bus helper-set --dir "$BUS_DIR" --id "$hid" --status running --task "$id"
  if ! start_runner "$id" new; then
    helper_finish "$id" failed "the worker could not be started"
    return 1
  fi
}

helper_finish() { # worker-task-id status text — the result goes back to the requester as a message; status: done,
  # unclear (the worker's questions: the request needs answers, not a failure), anything else failed
  local id=$1 status=$2 text=$3
  local hid from
  hid=$(task_field "$id" HELPER_ID); from=$(task_field "$id" FROM_AGENT)
  [[ -n $text ]] || text="(no result — see: agent log $id)"
  local st
  case $status in done | unclear) st=$status ;; *) st=failed ;; esac
  try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status "$st" --summary "${text:0:2000}"
  notice helper_result "$(task_field "$id" AGENT)" "$from" "RESULT H$hid [$st]: ${text:0:3500}" "request=H$hid" "status=$st"
  act "$id" info "■ result H$hid sent to $from ($st)"
}

pl_commits() { # number → "1 commit" / "N commits"
  local n=$1
  if ((n == 1)); then echo "1 commit"; else echo "$n commits"; fi
}

verify_gaps() { # coordinator-id — gaps before closing a --verify team (empty = all good)
  local br=$BRANCH wt=$WORKTREE pr cnt m mb
  local errf; errf=$(mktemp)
  if pr=$(round_pr_for "$1" number,isDraft,state 2>"$errf"); then   # its branch's, the given one, or the one at its commit
    if [[ $(jq_soft pr_lookup_parse 'length' <<< "$pr") == 0 ]]; then
      echo "- no PR from your branch $br — open it (gh pr create --base $BASE --head $br)"
    elif [[ $(jq -r '.[0].isDraft' <<< "$pr") == true ]]; then
      echo "- PR #$(jq -r '.[0].number' <<< "$pr") is still a draft — when the work is complete: gh pr ready"
    fi
  else
    # without GitHub access the PR check cannot run; the other checks still apply
    log_warn verify_pr_check_failed "branch=$br" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  if git -C "$wt" rev-parse --verify -q "origin/$br" >/dev/null; then
    cnt=$(git -C "$wt" rev-list --count "origin/$br..$br")
    ((cnt > 0)) && echo "- unpushed changes on $br ($(pl_commits "$cnt")) — git push"
  fi
  while IFS=$'\t' read -r m mb; do
    [[ -n $mb && $m != "$AGENT" ]] || continue
    if ! git -C "$wt" rev-parse --verify -q "$mb" >/dev/null; then
      log_warn verify_member_branch_missing "member=$m" "branch=$mb"
      continue
    fi
    cnt=$(git -C "$wt" rev-list --count "$br..$mb")
    ((cnt > 0)) && echo "- member $m's branch ($mb) has unmerged changes ($(pl_commits "$cnt")) relative to $br — merge them or explain in the report why they are not needed"
  done < <(team_json "$TEAM" | jq -r '.members[]? | select(.state != "excluded") | "\(.agent)\t\(.branch)"')
  return 0
}

# verify_gaps_new task gaps — the gaps less the member-branch ones a coordinator this task was resumed from was sent
# back for already, word for word: its report explains them, and the same unmerged commits need no second explanation
# in each resumed task's report (new commits change the line, and it counts again)
verify_gaps_new() {
  local id=$1 gaps=$2 t known="" line n=0
  t=$(task_field "$id" RESUMED_FROM)
  while [[ -n $t && -d $TASKS/$t ]] && ((n++ < 100)); do
    [[ -f $TASKS/$t/verify-gaps.md ]] && known+=$(cat "$TASKS/$t/verify-gaps.md")$'\n'
    t=$(task_field "$t" RESUMED_FROM)
  done
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    if [[ $line == "- member "* ]] && grep -qxF -- "$line" <<< "$known"; then
      log_info verify_gap_settled "task=$id" "gap=$line"
      continue
    fi
    printf '%s\n' "$line"
  done <<< "$gaps"
}

# verify_bounce_gaps task — the gaps that send a closing --verify coordinator back (empty: none), recorded in its
# verify-gaps.md for the coordinators resumed from it
verify_bounce_gaps() {
  local id=$1 gaps
  gaps=$(verify_gaps_new "$id" "$(verify_gaps "$id")")
  if [[ -n $gaps ]] && ! printf '%s\n' "$gaps" > "$TASKS/$id/verify-gaps.md"; then
    log_warn verify_gaps_record_failed "task=$id"
  fi
  printf '%s' "$gaps"
}

final_status() { # last message → DONE|ROUND_DONE|FAILED|QUESTIONS|INVESTIGATING|SLEEPING|EXCLUDED or nothing
  # no STATUS line → empty output (grep exits 1, which is the expected "not found")
  sed 's/[*`]//g' <<< "$1" | { grep -oE '^[[:space:]]*STATUS:[[:space:]]*[A-Z_]+' || (($? == 1)); } | head -1 | sed -E 's/.*STATUS:[[:space:]]*//'
}

# nostatus_autopilot task — whether a turn without STATUS goes back to the agent instead of to the human: the task
# runs --autopilot, or the task that asked for it does (an investigator's or a reviewer's has no AUTOPILOT of its
# own), and the human has not turned it off
nostatus_autopilot() {
  local t p
  p=$(task_field "$1" PARENT_TASK)
  for t in "$1" ${p:+"$p"}; do
    [[ $(task_field "$t" AUTOPILOT) == 1 && $(task_field "$t" AUTOPILOT_OFF) != 1 ]] && return 0
  done
  return 1
}

questions_from_nostatus() { # message id round — questions file used when the agent ended its turn without a STATUS line
  printf '# Questions — %s (round %s)\n\n' "$2" "$3"
  printf '_The agent ended its turn without a STATUS line — most likely it stopped halfway or is waiting for permission. Its last message is below._\n\n'
  printf '## 1. What should the agent do next? (e.g. "continue as planned", "finish", or a specific instruction)\n\n'
  sed 's/^/> /' <<< "$1"
  printf '\n**Verdict:**\n'
}

questions_from_final() { # last-message-text id round → questions file on stdout (when the agent did not write the file)
  printf '%s\n' "$1" | awk -v id="$2" -v round="$3" '
    /^[[:space:]]*STATUS:/ { stop = 1 }
    stop { next }
    {
      line = $0
      if (match(line, /^[[:space:]]*(\*\*)?[0-9]+[.)][[:space:]]+/)) {
        n++; head = substr(line, RLENGTH + 1); gsub(/\*\*/, "", head)
        q[n] = head; body[n] = ""; next
      }
      if (n == 0) { pre = pre line "\n"; next }
      body[n] = body[n] line "\n"
    }
    END {
      printf "# Questions — %s (round %s)\n\n", id, round
      printf "_The agent asked these in its last message instead of the file — the script moved them here._\n\n"
      if (n == 0) {
        gsub(/\n+$/, "", pre)
        printf "## 1. Answer the questions from the agent\n\n%s\n\n**Verdict:**\n", pre
        exit
      }
      for (i = 1; i <= n; i++) {
        b = body[i]; gsub(/\n+$/, "", b)
        printf "## %d. %s\n", i, q[i]
        if (b != "") printf "%s\n", b
        printf "\n**Verdict:**\n\n"
      }
    }'
}

# ------------------------------------------------------------------ runner (background)

# runner_exit rc — the EXIT trap of a runner that did not finish normally (killed, stopped or crashed).
# Every step runs through try: one failing step must not prevent the others (status, queues, notification).
runner_exit() {
  local rc=$1
  # A persisted outcome can still have an interrupted local result delivery.
  if ((RUNNER_DONE)); then
    [[ -n ${JOB_ID:-} && -f $TASKS/$RUNNER_ID/node-stop-requested && ${RUNNER_DELIVERED:-0} == 0 ]] || return 0
  fi
  RUNNER_DONE=1
  if [[ -f $TASKS/$RUNNER_ID/hold-requested ]]; then   # agent pause: held with its team — not failed, not out
    try meta_write_failed meta_set "$RUNNER_ID" STATUS held
    try activity_write_failed act "$RUNNER_ID" info "⏸ paused with its team by the human — agent unpause resumes it where it stopped"
    log_info run_held "reason=team paused"
    return
  fi
  if stopping; then   # agent stop --running: no notifications, queues or messages
    try meta_write_failed meta_set "$RUNNER_ID" STATUS stopped
    try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
    try activity_write_failed act "$RUNNER_ID" info "■ stopped (agent stop --running)"
    log_info run_stopped "reason=agent stop --running"
    return
  fi
  if [[ -n ${JOB_ID:-} && -n ${RUN:-} && $(task_field "$RUNNER_ID" LEAD_KICK_RUN) == "$RUN" ]]; then
    # A lead kick owns this run's exit; never journal an intermediate failed outcome for the node.
    local kick_state=stopped
    [[ -z ${TEAM:-} ]] || kick_state=sleeping
    try meta_write_failed meta_set "$RUNNER_ID" STATUS "$kick_state" "$RUN"
    try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)" "$RUN"
    log_info run_stopped "reason=lead_job_kick" "status=$kick_state"
    RUNNER_DELIVERED=1
    return
  fi
  if [[ -n ${JOB_ID:-} && -f $TASKS/$RUNNER_ID/node-stop-requested ]]; then
    local node_status node_finished node_final="${FINAL:-}"
    node_status=$(task_field "$RUNNER_ID" STATUS)
    node_finished=$(task_field "$RUNNER_ID" FINISHED)
    # Completion may have persisted its outcome just before SIGTERM interrupted final delivery.
    if [[ ! $node_status =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
      node_status=stopped
      node_finished=""
      try meta_write_failed meta_set "$RUNNER_ID" STATUS "$node_status"
    fi
    if [[ -z $node_finished ]]; then
      try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
    fi
    if [[ -f $TASKS/$RUNNER_ID/final.md ]]; then node_final=$(<"$TASKS/$RUNNER_ID/final.md"); fi
    log_info run_stopped "reason=node_job_cancel" "status=$node_status"
    try notification_failed notify "$RUNNER_ID" "$node_status" "$node_final" "node job cancellation"
    RUNNER_DELIVERED=1
    try dispatch_failed dispatch
    try dispatch_failed dispatch_helpers
    return
  fi
  if task_stop_requested "$RUNNER_ID"; then
    try meta_write_failed meta_set "$RUNNER_ID" STATUS stopped
    try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
    try activity_write_failed act "$RUNNER_ID" info "■ stopped by the human"
    log_info run_stopped "reason=human stop"
    return
  fi
  local why="runner interrupted (exit code $rc) — see: agent log $RUNNER_ID"
  log_warn run_interrupted "exit_code=$rc" "reason=$why"
  try meta_write_failed meta_set "$RUNNER_ID" STATUS failed
  try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
  try activity_write_failed act "$RUNNER_ID" err "■ $why"
  if [[ ${KIND:-worker} == investigation ]] && ! is_independent_investigation "$RUNNER_ID"; then
    try investigation_finish_failed inv_finish "$RUNNER_ID" failed "STATUS: FAILED
Answer: investigation interrupted ($why)"
    if [[ ${REVIEW:-} == 1 ]]; then try review_followup_failed review_without_verdict "$RUNNER_ID" "$why"; fi
  fi
  if [[ ${KIND:-worker} == helper ]]; then
    try helper_finish_failed helper_finish "$RUNNER_ID" failed "interrupted: $why"
  elif [[ -n ${TEAM:-} ]]; then
    try team_update_failed team_after_run "$RUNNER_ID" failed "" "$why"
  elif ! is_independent_investigation "$RUNNER_ID"; then
    try notification_failed notify "$RUNNER_ID" failed "" "$why"
  fi
  try dispatch_failed dispatch
  if ! is_independent_investigation "$RUNNER_ID"; then try dispatch_failed dispatch_helpers; fi
}

cmd__runner() {
  local id=$1 mode=$2
  local dir="$TASKS/$id"
  exec >>"$dir/runner.log" 2>&1 3>&1   # fd 3: structured log records (log_event)
  export LC_ALL=C.UTF-8 MCP_TOOL_TIMEOUT=900000
  RUNNER_ID=$id
  export AGENT_RUN_TASK=$id   # the agent's commands know their run's task: agent gate refuses its own uncommitted tree
  meta_load "$id"
  if [[ -f $dir/hold-requested ]] || task_held "$id"; then   # paused with its team before this run got going: it waits
    meta_set "$id" HOLD_START "$mode"
    meta_set "$id" STATUS held
    act "$id" info "⏸ paused with its team by the human before this run started — agent unpause starts it"
    log_info run_held "reason=team paused before the run started" "mode=$mode"
    exit 0
  fi
  local n=$RUN
  if [[ $mode == resume ]] && fresh_session_due "$id"; then   # not the old session: a fresh one with the handoff
    mode=fresh
    meta_set "$id" LONG_RUN ""
    local fresh_sid=()
    if [[ $TYPE == claude ]]; then   # a fresh session is a new one: Claude Code refuses the old one's ID ("already in use")
      SESSION_ID=$(cat /proc/sys/kernel/random/uuid)
      meta_set "$id" SESSION_ID "$SESSION_ID"
      fresh_sid=("session=$SESSION_ID")
    fi
    log_info fresh_session "task=$id" "reason=$FRESH_WHY" "${fresh_sid[@]}"
  fi
  log_info run_started "run=$n" "mode=$mode" "agent=$AGENT" "cli=$TYPE" "kind=${KIND:-worker}" "model=${MODEL:-}"
  local start_note
  start_note=$(task_field "$id" START_NOTIFY)
  if [[ -n $start_note ]]; then   # a new task or team: its first run says it starts — once for a team (agent run)
    meta_set "$id" START_NOTIFY ""
    notify "$id" started "" "$start_note"
  fi

  if [[ -f $AGENTS_HOME/secrets.env ]]; then
    set -a; source "$AGENTS_HOME/secrets.env"; set +a
  fi
  local v
  for v in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY CODEX_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY DEEPINFRA_API_KEY; do
    if [[ -z ${!v:-} ]]; then unset "$v"; fi
  done

  git_identity
  # Bounce paths owe no delivery; normal finalization opens the delivery window below.
  RUNNER_ID=$id RUNNER_DONE=0 RUNNER_DELIVERED=1
  echo $$ > "$dir/runner.pid"
  rm -f "$dir/acked" "$dir/long-run"
  local sub_pr   # the run's marker: the round and the PR it goes into (agent tokens --round sums sub-rounds by it)
  sub_pr=$(run_pr "$id")
  act "$id" info "▶ run $n ($mode) round $(task_round_id "$id") pr ${sub_pr:+#}${sub_pr:--}"
  [[ $mode != fresh ]] || act "$id" info "■ fresh session: $FRESH_WHY"
  AGENT_RUN_LONG_AT=0   # the steps after which a team member's run is long (the normalizer marks it)
  AGENT_RUN_HARD_AT=0   # the steps at which the watchdog ends a team member's run
  AGENT_RUN_SOLO_AT=0   # the steps at which the watchdog asks whether a coordinator works alone (coordinator_alone)
  if [[ -n ${TEAM:-} && ${KIND:-worker} == worker ]]; then
    AGENT_RUN_LONG_AT=$AGENT_LONG_RUN_STEPS AGENT_RUN_HARD_AT=$AGENT_LONG_RUN_HARD AGENT_RUN_SOLO_AT=$AGENT_SOLO_COORD_STEPS
  fi
  export AGENT_RUN_LONG_AT
  trap 'runner_exit $?' EXIT
  trap 'exit 143' TERM INT HUP
  if task_stop_requested "$id"; then return 0; fi
  # the boot ID before the run shows as running: a later boot ID means its machine restarted under this run, and a run
  # seen as running without one would be taken for a dead runner after a restart at its very start
  meta_set "$id" RUN_BOOT "$(boot_id)"
  meta_set "$id" STATUS running
  # for the wake-loop guard: when the run started, the commit it started from, the agent's bus messages so far
  local run_start run_head0 run_msgs0
  run_start=$(date +%s)
  run_head0=$(git -C "$WORKTREE" rev-parse HEAD) || run_head0="unknown"
  if is_independent_investigation "$id"; then run_msgs0=0; else run_msgs0=$(bus_messages_from "$AGENT"); fi
  meta_set "$id" RUN_STARTS "$(recent_run_starts "$(task_field "$id" RUN_STARTS)" "$run_start")"

  if [[ $mode == new && -f $WORKTREE/.gitmodules ]]; then
    try submodule_update_failed git -C "$WORKTREE" submodule update --init --recursive
  fi

  local next_round=$((ROUND + 1))
  local qfile="$dir/questions-$next_round.md"
  local pf="$dir/prompt-$n.md"
  build_prompt "$id" "$mode" "$qfile" "$next_round" > "$pf"
  prompt_for_role "$id" "$pf" "$mode" || log_warn prompt_role_failed "task=$id" "file=$pf"
  # how much of task.md the session has now: a resumed run gets what the script adds after it (checks or review
  # findings to fix)
  meta_set "$id" TASK_SENT_BYTES "$(wc -c < "$dir/task.md" 2> /dev/null || echo 0)"
  meta_set "$id" ANSWERS_PENDING ""
  meta_set "$id" INV_PENDING_DELIVERY ""
  meta_set "$id" WAKE_PENDING ""
  meta_set "$id" RESTART_PENDING ""
  meta_set "$id" ABOUNCE_PENDING ""
  meta_set "$id" BOUNCE_PENDING ""
  meta_set "$id" QBOUNCE_PENDING ""
  meta_set "$id" SBOUNCE_PENDING ""
  meta_set "$id" UBOUNCE_PENDING ""
  meta_set "$id" NSBOUNCE_PENDING ""
  meta_set "$id" DBOUNCE_PENDING ""
  meta_set "$id" UNPAUSE_PENDING ""
  meta_set "$id" PAUSE_RELEASED ""
  meta_set "$id" RBOUNCE_PENDING ""
  if [[ -n ${TEAM:-} && ${REMOTE_TEAM:-} != 1 ]]; then   # a remote member's state is set by the lead
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state active >/dev/null
  fi

  # Watchdog: a hang (no activity for AGENT_HANG_MIN min) kills the run. Normal models,
  # coordinators, investigators and solo tasks are resumed in the same session (up to AGENT_HANG_STRIKES
  # consecutive hangs without progress). Workers in a team or on a delegate request are not auto-resumed.
  local nrun=$n attempt=0 hangs=${HANGS:-0} prog hang_final=0
  local auto_resume=1
  [[ ${TIER:-normal} == worker && ( ${KIND:-worker} == helper || -n ${TEAM:-} ) ]] && auto_resume=0
  if is_independent_investigation "$id"; then auto_resume=0; fi
  while :; do
    prog=$(activity_progress "$id")
    RC=0 FINAL="" HUNG=0
    agents_gh_env || die "the agents' gh (agent as gh) could not be set up: no run without it"
    case $TYPE in
      claude) run_claude "$id" "${mode/#fresh/new}" "$nrun" "$pf" "$dir" ;;
      codex)  run_codex  "$id" "${mode/#fresh/new}" "$nrun" "$pf" "$dir" ;;
      gemini) run_gemini "$id" "${mode/#fresh/new}" "$nrun" "$pf" "$dir" ;;
      opencode) run_opencode "$id" "${mode/#fresh/new}" "$nrun" "$pf" "$dir" ;;
      *)      echo "unknown agent type: $TYPE"; RC=2 ;;
    esac
    AGENT_GH_COORDINATOR="" AGENT_GH_TEAM=""   # the member's PR commands only: this runner's own (e.g. a fallback review) go on
    log_info cli_finished "run=$nrun" "exit_code=$RC" "hung=$HUNG"
    if ((LONG_CUT)); then   # ended at its step limit: it sleeps, and is woken at once in a fresh session (long_run_end)
      RC=0
      FINAL=$(printf 'STATUS: SLEEPING\nRole: member\nDone:\n- The run reached its limit of %s steps and was ended by the runner.\nNot done: what the checkpoint and the board say.\nUnclear: None.\n' "$AGENT_LONG_RUN_HARD")
      [[ -f $dir/long-run ]] || echo "$AGENT_LONG_RUN_HARD" > "$dir/long-run"
      ((SOLO_CUT == 0)) || : > "$dir/solo-cut"   # its next run starts with the work to split (fresh_session_due)
      log_info long_run_cut "task=$id" "steps=$AGENT_LONG_RUN_HARD"
    fi
    if ((HUNG == 0)); then
      meta_set "$id" HANGS 0
      break
    fi
    if (( $(activity_progress "$id") > prog )); then hangs=1; else hangs=$((hangs + 1)); fi
    meta_set "$id" HANGS "$hangs"
    if ((auto_resume == 0)); then break; fi
    if (( hangs >= AGENT_HANG_STRIKES )) || [[ -z ${SESSION_ID:-} ]]; then hang_final=1; break; fi
    attempt=$((attempt + 1)); nrun="$n.h$attempt"; mode=resume
    pf="$dir/prompt-$nrun.md"
    R[HANG_MIN]=$AGENT_HANG_MIN
    automation_allowed "$id" || return 1
    { continuation_rules; render "$PROMPTS/hang-resume.md"; } > "$pf"
    act "$id" info "↻ resumed after a hang ($hangs/$AGENT_HANG_STRIKES)"
  done
  printf '%s\n' "$FINAL" > "$dir/final.md"

  local status note="" pending="" member_q=0 member_ns=0 fst pause_secs=0 pause_reason="" qgen=0 norec="" nsb=0
  [[ ${KIND:-worker} == worker ]] && pending=$(bus inv-pending --dir "$BUS_DIR" --task "$id")
  fst=$(final_status "$FINAL")
  [[ $fst == DONE || -z $(task_field "$id" DONE_BOUNCED) ]] || meta_set "$id" DONE_BOUNCED ""   # a DONE again: not in a row
  [[ -z $fst || -z $(task_field "$id" NOSTATUS_BOUNCED) ]] || meta_set "$id" NOSTATUS_BOUNCED ""   # a STATUS again
  local is_member=0
  [[ -n ${TEAM:-} && ${KIND:-worker} == worker && $AGENT != "$(team_lead "$TEAM")" ]] && is_member=1

  # A turn without STATUS (e.g. "may I continue?") does not mean the work is done: the human decides
  # (a team member asks the coordinator instead; a worker's text is returned as its result).
  if ! is_independent_investigation "$id" && [[ ! -s $qfile && -z $fst && -n ${FINAL//[[:space:]]/} && $RC == 0 && $HUNG == 0 && -z $pending ]]; then
    if ((is_member)); then
      member_ns=1
    elif [[ ${KIND:-worker} != helper ]] && nostatus_autopilot "$id" && [[ -z $(task_field "$id" NOSTATUS_BOUNCED) ]]; then
      nsb=1   # --autopilot: back to the agent, "continue as planned"; a second turn in a row asks the human
    elif [[ ${KIND:-worker} != helper ]]; then
      questions_from_nostatus "$FINAL" "$id" "$next_round" > "$qfile"; qgen=1
      act "$id" info "turn without STATUS — the last message was passed to you as a question ($qfile)"
    fi
  fi

  # The agent asked its questions only in its last message (no file): do not lose them.
  if [[ ! -s $qfile && $fst == QUESTIONS ]]; then
    if ((is_member)); then
      member_q=1   # team member → questions go to the coordinator (below)
    elif [[ ${KIND:-worker} != helper ]]; then
      local question_final=$FINAL
      if is_independent_investigation "$id"; then
        # Independent final messages may put STATUS before their questions; retain the questions too.
        question_final=$(sed '/^STATUS:/d' <<< "$FINAL")
      fi
      if is_independent_investigation "$id" && grep -qE '^##[[:space:]]+[0-9]+\.' <<< "$question_final"; then
        # Keep already formatted questions and their recommendations/verdict slots intact.
        printf '# Questions — %s (round %s)\n\n%s\n' "$id" "$next_round" "$question_final" > "$qfile"
      else
        questions_from_final "$question_final" "$id" "$next_round" > "$qfile"
      fi
      qgen=1
      act "$id" info "questions from the last message moved to $qfile"
    fi
  fi

  if is_independent_investigation "$id"; then
    # Independent phases may pause for clarification, but cannot ask peers or start helpers or retries.
    status=failed; note="the independent run ended without DONE"
    if [[ $fst == DONE && $RC == 0 && $HUNG == 0 && ! -s $qfile ]]; then
      status=done; note=""
    elif [[ $fst == QUESTIONS && $RC == 0 && $HUNG == 0 && -s $qfile ]]; then
      status=waiting; note="the investigator needs clarification"
      meta_set "$id" ROUND "$next_round"
    elif { ((RC != 0)) || [[ -z $fst ]]; } && [[ $(limit_kind "$dir" "$nrun" "$FINAL") == quota ]] \
        && pause_secs=$(quota_reset_seconds "$dir" "$nrun" "$FINAL"); then
      # End this independent attempt, but retain the provider's reset time for capacity admission.
      meta_set "$id" QUOTA_UNTIL "$(( $(date +%s) + pause_secs ))"
      note="the investigator exhausted its provider quota"
    fi
  elif ((HUNG)) && ((auto_resume == 0)); then
    # hung worker: stopped; normal models are told and can start it again
    if [[ ${KIND:-worker} == helper ]]; then
      status=failed; note="the worker hung"
      FINAL="STATUS: FAILED
Result: THE WORKER HUNG — there was no activity for $AGENT_HANG_MIN min, so it was stopped. Delegate the task again — it goes to a free worker; if possible split it into smaller steps."
    else
      status=sleeping; note="the worker hung — stopped"
      local released lead nm
      released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" | paste -sd,)
      lead=$(team_lead "$TEAM")
      for nm in $(bus team-get --dir "$BUS_DIR" --team "$TEAM" | jq -r '.members[] | select(.tier != "worker" and (.state == "active" or .state == "sleeping" or .state == "waking")) | .agent'); do
        notice worker_hung agentbus "$nm" "WORKER $AGENT HUNG (no activity for $AGENT_HANG_MIN min) and was stopped.${released:+ Its items ($released) are back on the board.} Try starting it again — a message to it or a new board item wakes it — or give the work to someone else.${lead:+ Coordinator: $lead.}" \
          "agent=$AGENT" "team=$TEAM" "released=$released"
      done
    fi
  elif ((hang_final)); then
    status=hung; note="the agent hung $hangs times in a row without progress"
  elif { ((RC != 0)) || [[ -z $fst ]]; } && pause_secs=$(quota_reset_seconds "$dir" "$nrun" "$FINAL"); then
    status=paused
    pause_reason=$(limit_kind "$dir" "$nrun" "$FINAL")
    local why resume_at
    why=$(limit_line "$dir" "$nrun" "$FINAL" "$pause_reason")
    resume_at=$(date -d "@$(( $(date +%s) + pause_secs ))" '+%H:%M')
    ((pause_secs <= 20 * 3600)) || resume_at=$(date -d "@$(( $(date +%s) + pause_secs ))" '+%d.%m %H:%M')
    if [[ $pause_reason == rate_limit ]]; then
      note="the provider is rate-limiting requests (HTTP 429) — not out of credits; resumes at $resume_at${why:+ — $why}"
    elif [[ $pause_reason == overloaded ]]; then
      note="the model is overloaded at the provider (at capacity) — not your account; resumes at $resume_at${why:+ — $why}"
    elif [[ $pause_reason == network ]]; then
      local np last
      np=1
      last=$(task_field "$id" NETWORK_RUN)
      if [[ $last == "$((nrun - 1))" ]]; then   # the run before ended on the network too: in a row
        np=$(task_field "$id" NETWORK_PAUSES); np=$(( ${np:-0} + 1 ))
      fi
      meta_set "$id" NETWORK_PAUSES "$np"
      meta_set "$id" NETWORK_RUN "$nrun"
      if ((np > AGENT_NETWORK_MAX_PAUSES)); then   # not a passing outage: the human looks
        status=failed
        note="the network or the provider has been unreachable $np times in a row (AGENT_NETWORK_MAX_PAUSES=$AGENT_NETWORK_MAX_PAUSES)${why:+ — $why}"
      else
        note="the network or the provider was unreachable — nothing the agent did; resumes at $resume_at (attempt $np of $AGENT_NETWORK_MAX_PAUSES)${why:+ — $why}"
      fi
    else
      note="the provider's quota or usage limit is exhausted — resumes at $resume_at${why:+ — $why}"
    fi
    # a pair does not wait days for one review: out of quota, or its model overloaded past
    # AGENT_REVIEW_OVERLOAD_WAIT_MIN, it ends without a verdict (the pair has it done again by an investigator outside
    # the pair), and its investigator is not chosen until then (QUOTA_UNTIL)
    if [[ ${REVIEW:-} == 1 && -n $(task_field "$(task_field "$id" PARENT_TASK)" REVIEW_PAIR) ]] \
        && review_hands_over "$pause_reason" "$pause_secs"; then
      status=failed
      meta_set "$id" QUOTA_UNTIL "$(( $(date +%s) + pause_secs ))"
      if [[ $pause_reason == quota ]]; then
        note="the investigator's provider is out of quota until $resume_at — the review goes to another investigator${why:+ — $why}"
      else
        note="the model is overloaded at the provider until $resume_at — the review goes to another investigator, outside its pair${why:+ — $why}"
      fi
    fi
    # an --autopilot team does not wait out a member's model out of service: _supervise replaces it (supervise_failovers)
    # … nor a worker request's: another worker takes it (supervise_failovers, helper_failover)
    if [[ $status == paused ]] && { [[ ${KIND:-} == helper ]] || [[ -n ${TEAM:-} && ${REVIEW:-} != 1 && $(task_field "$id" AUTOPILOT) == 1 ]]; } \
        && failover_due "$id" "$pause_reason" "$pause_secs"; then
      meta_set "$id" FAILOVER_UNTIL "$(( $(date +%s) + pause_secs ))"
      meta_set "$id" FAILOVER_PENDING 1
    fi
  elif ((nsb)); then
    status=nsbounce
  elif [[ -s $qfile ]]; then
    # every question the agent wrote must carry a recommendation; without one it gets the file back once
    if ((qgen == 0)) && [[ $(task_field "$id" QUESTIONS_BOUNCED) != "$next_round" ]]; then
      norec=$(questions_missing_recommendations "$qfile")
    fi
    if [[ -n $norec ]]; then
      status=qbounce
    elif [[ ${AUTOPILOT:-} == 1 && ${AUTOPILOT_OFF:-} != 1 && $(task_field "$id" AUTOPILOT_QBOUNCED) != "$next_round" ]]; then
      status=abounce   # --autopilot: nobody answers — the agent decides, once a round
    else
      meta_set "$id" ROUND "$next_round"
      status=waiting
    fi
  elif [[ -n $pending ]]; then
    status=investigating
  elif [[ -n ${TEAM:-} ]] && { [[ $fst == EXCLUDED ]] || \
       [[ $(team_json "$TEAM" | jq -r --arg a "$AGENT" '.members[$a].state // empty') == excluded ]]; }; then
    status=excluded
  elif [[ -n ${TEAM:-} && $fst == SLEEPING ]]; then
    if [[ $(team_done_flag "$TEAM") == true ]]; then
      status=done; note="team already finished"
    else
      status=sleeping
    fi
  elif ((member_q || member_ns)); then
    # a team member asks the coordinator (or the whole team when there is no coordinator yet) and sleeps until answered
    local to head kind=member_questions; to=$(team_lead "$TEAM"); to=${to:-team:$TEAM}
    head="QUESTIONS from $AGENT (forwarded by the script; members ask the coordinator, not the human)"
    if ((member_ns)); then
      kind=member_no_status
      head="$AGENT ended its turn without STATUS (waiting for a decision — reply with an instruction)"
    fi
    notice "$kind" "$AGENT" "$to" "$head: $(sed '/^[[:space:]]*STATUS:/,$d' <<< "$FINAL" | head -c 3500)" "agent=$AGENT" "team=$TEAM"
    if [[ $(team_done_flag "$TEAM") == true ]]; then status=done; else status=sleeping; fi
    note="forwarded to ${to}"
  elif [[ $fst == QUESTIONS ]]; then
    if [[ ${KIND:-worker} == helper ]]; then   # a worker's questions: its request is unclear, not done
      status=done; HELPER_UNCLEAR=1; note="the worker returned questions instead of a result"
    else
      status=failed; note="the agent reported questions but they could not be saved ($qfile)"
    fi
  elif [[ $fst == INVESTIGATING ]]; then
    status=failed; note="the agent reported INVESTIGATING but no investigation was accepted"
  elif [[ ${KIND:-worker} == helper ]] && ((RC == 0)) && { [[ $fst == UNCLEAR ]] ||
      { [[ $fst == FAILED ]] && grep -qE '^[[:space:]]*Result:[[:space:]]*UNCLEAR' <<< "$FINAL"; }; }; then
    # a worker that cannot do the request without answers (the former shape: FAILED with Result: UNCLEAR): its task
    # is done — a valid answer; its request is unclear, the questions the requester's result — not a failure
    status=done; HELPER_UNCLEAR=1; note="the worker cannot do it without answers: its questions go to the requester"
  elif ((RC != 0)) || [[ $fst == FAILED || -z ${FINAL//[[:space:]]/} ]]; then
    status=failed
    if ((RC != 0)); then
      note="CLI exit code: $RC"
      local eline; eline=$(last_error_line "$dir" "$nrun")
      [[ -z $eline ]] || note+=" — $eline"
    fi
  elif [[ $fst == DONE || $fst == ROUND_DONE ]]; then
    status=done
    if [[ $fst == ROUND_DONE ]]; then   # "STATUS: ROUND_DONE N/M": round N of M is finished (in a team with a coordinator, only the coordinator's counts)
      local rn rlead=""
      [[ -z ${TEAM:-} ]] || rlead=$(team_lead "$TEAM")
      rn=$(sed 's/[*`]//g' <<< "$FINAL" | { grep -oE 'STATUS:[[:space:]]*ROUND_DONE[[:space:]]+[0-9]+/[0-9]+' || (($? == 1)); } \
             | head -1 | { grep -oE '[0-9]+/[0-9]+$' || (($? == 1)); })
      if [[ -n $rn ]] && ((${rn%/*} >= 1 && ${rn%/*} <= ${rn#*/})); then
        if [[ -z $rlead || $AGENT == "$rlead" ]]; then
          meta_set "$id" WORK_ROUND "${rn%/*}"; meta_set "$id" WORK_ROUNDS "${rn#*/}"
          note="round $rn"
        fi
      else
        status=failed; note="STATUS: ROUND_DONE needs the round as N/M (e.g. ROUND_DONE 2/5)"
      fi
    fi
  elif [[ ${KIND:-worker} == helper ]]; then
    status=done; note="the worker gave no STATUS — its text was returned as the result"
  elif [[ -n $fst && $(task_field "$id" STATUS_BOUNCED) != "$(( $(task_field "$id" RUN) - 1 ))" ]]; then
    status=sbounce   # an unknown STATUS goes back to the agent once, with the statuses it may use
  else
    status=failed; note="unrecognised STATUS: ${fst:-none}"
  fi
  # the wake-loop guard: a member that keeps waking up without doing anything is paused instead of put to sleep
  if wake_loop_applies "$status" && pause_secs=$(wake_loop_check "$id" "$run_start" "$run_head0" "$run_msgs0"); then
    status=paused; pause_reason=wake_loop
    note="woken again and again without anything to do (wake-loop guard) — paused until $(date -d "@$(( $(date +%s) + pause_secs ))" '+%H:%M')"
  fi
  # questions without recommendations go back to the agent once (the same questions file, the same round)
  # a worker's UNCLEAR from a run with no action — no command, no edit, no tool call: it asked without looking at
  # anything — goes back to it once (H1121: four of its five questions were answered by the files the request named)
  if ((${HELPER_UNCLEAR:-0})) && [[ -z ${UNCLEAR_BOUNCED:-} ]] && (($(run_actions "$id") == 0)); then
    status=ubounce; HELPER_UNCLEAR=0
  fi
  if [[ $status == qbounce ]]; then
    meta_set "$id" QUESTIONS_BOUNCED "$next_round"
    meta_set "$id" QBOUNCE_PENDING "$norec"
    RUNNER_DONE=1
    act "$id" info "↩ questions without a recommendation ($norec) — sent back to the agent once"
    log_info questions_bounced "task=$id" "questions=$norec"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=questions without recommendations"
    dispatch; dispatch_helpers
    return 0
  fi
  # --autopilot: the questions go back to the agent once — it decides and lists its decisions in the PR; the file is
  # put aside, so that the next run's end does not take the same questions for new ones
  if [[ $status == abounce ]]; then
    local decided="${qfile%.md}-decided.md"
    mv "$qfile" "$decided"
    meta_set "$id" AUTOPILOT_QBOUNCED "$next_round"
    meta_set "$id" ABOUNCE_PENDING "$decided"
    RUNNER_DONE=1
    act "$id" info "↩ --autopilot: nobody answers questions — they go back to the agent once; it decides and lists its decisions in the PR"
    log_info questions_autopilot_bounced "task=$id" "file=$decided"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=--autopilot questions"
    dispatch; dispatch_helpers
    return 0
  fi
  # a member's DONE while it holds claimed board items: back to it once, in a fresh session (a second DONE finishes it)
  local held=""
  # (not a remote member: its board lives on the lead, which follows its state)
  if [[ $status == done && $fst == DONE && $is_member == 1 && ${REMOTE_TEAM:-} != 1 \
      && -z $(task_field "$id" DONE_BOUNCED) && $(team_done_flag "$TEAM") != true ]]; then
    held=$(member_claimed_items "$TEAM" "$AGENT")
    if [[ -n $held ]]; then
      meta_set "$id" DONE_BOUNCED 1
      meta_set "$id" DBOUNCE_PENDING "$held"
      RUNNER_DONE=1
      act "$id" info "↩ STATUS: DONE while holding board items ($held) — sent back to the agent once, in a fresh session"
      log_info member_done_bounced "task=$id" "agent=$AGENT" "items=$held"
      start_runner "$id" resume || log_error resume_failed "task=$id" "reason=a member's DONE while holding board items"
      dispatch; dispatch_helpers
      return 0
    fi
  fi
  # --autopilot: a turn without STATUS goes back to the agent — continue as planned; a second in a row asks the human
  if [[ $status == nsbounce ]]; then
    meta_set "$id" NOSTATUS_BOUNCED 1
    meta_set "$id" NSBOUNCE_PENDING 1
    RUNNER_DONE=1
    act "$id" info "↩ --autopilot: a turn without STATUS — sent back to the agent: continue as planned"
    log_info nostatus_autopilot_bounced "task=$id" "agent=$AGENT" "model=${MODEL:-}"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=a turn without STATUS"
    dispatch; dispatch_helpers
    return 0
  fi
  # a worker's UNCLEAR without looking at anything goes back to it once, with what to do; not sent to the requester
  if [[ $status == ubounce ]]; then
    meta_set "$id" UNCLEAR_BOUNCED "$(task_field "$id" RUN)"
    meta_set "$id" UBOUNCE_PENDING 1
    RUNNER_DONE=1
    act "$id" info "↩ UNCLEAR without looking at anything — sent back once: read what the request names, ask only what it leaves open"
    log_info unclear_bounced "task=$id" "agent=$AGENT" "model=${MODEL:-}"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=an UNCLEAR without looking at anything"
    dispatch; dispatch_helpers
    return 0
  fi
  # an unknown STATUS goes back to the agent once (a second one fails the run)
  if [[ $status == sbounce ]]; then
    meta_set "$id" STATUS_BOUNCED "$(task_field "$id" RUN)"
    meta_set "$id" SBOUNCE_PENDING "$fst"
    RUNNER_DONE=1
    act "$id" info "↩ unknown STATUS: $fst — sent back to the agent once"
    log_info status_bounced "task=$id" "status=$fst"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=an unknown STATUS"
    dispatch; dispatch_helpers
    return 0
  fi
  # rounds: a finished round must fit the limit and leave none of its own pending tests behind (README "Rounds")
  if [[ $status == done && ${KIND:-worker} == worker ]] && { [[ -z ${TEAM:-} ]] || [[ $AGENT == "$(team_lead "$TEAM")" ]]; }; then
    local problems bounced=${ROUND_BOUNCED:-0}
    problems=$(round_check "$id")
    if [[ -n $problems ]]; then
      if ((bounced < ROUND_BOUNCES)); then
        meta_set "$id" ROUND_BOUNCED $((bounced + 1))
        meta_set "$id" RBOUNCE_PENDING "$problems"
        RUNNER_DONE=1
        act "$id" info "↩ the round cannot close yet: $(tr '\n' ' ' <<< "$problems")"
        log_info round_bounced "task=$id" "bounce=$((bounced + 1))"
        start_runner "$id" resume || log_error resume_failed "task=$id" "reason=round bounce"
        dispatch; dispatch_helpers
        return 0
      fi
      note="${note:+$note; }closed after $ROUND_BOUNCES corrections although: $(tr '\n' ' ' <<< "$problems")"
      act "$id" err "the round closed with problems: $(tr '\n' ' ' <<< "$problems")"
      log_warn round_closed_with_problems "task=$id"
    fi
  fi
  # --verify: the coordinator may not close a team with gaps — send it back once with the list of gaps
  if [[ $status == done && -n ${TEAM:-} && ${VERIFY:-} == 1 && ${VERIFY_BOUNCED:-} != 1 \
        && ${KIND:-worker} == worker && $AGENT == "$(team_lead "$TEAM")" ]]; then
    local gaps; gaps=$(verify_bounce_gaps "$id")
    if [[ -n $gaps ]]; then
      meta_set "$id" VERIFY_BOUNCED 1
      meta_set "$id" BOUNCE_PENDING "$gaps"
      RUNNER_DONE=1
      act "$id" info "↩ closing the team held back (--verify), gaps: $(tr '\n' ' ' <<< "$gaps")"
      start_runner "$id" resume || log_error resume_failed "task=$id" "reason=--verify bounce"
      dispatch; dispatch_helpers
      return 0
    fi
  fi

  # the wake-up time and its timer exist before anyone can see the task as paused
  [[ $status == paused ]] && pause_task "$id" "$pause_secs" "$pause_reason"
  # likewise the answering instructions, the watch and the editor before the task shows as waiting
  [[ $status == waiting ]] && questions_ready "$id" "$qfile"
  meta_set "$id" NOTE "$note"   # what the run ended on, for the dashboard and for a node's report to its lead
  meta_set "$id" STATUS "$status"
  meta_set "$id" FINISHED "$(date -Is)"
  RUNNER_DELIVERED=0
  RUNNER_DONE=1
  act "$id" info "■ end of run $n: $status${note:+ ($note)}"
  log_info run_finished "run=$n" "status=$status" "note=$note"
  long_run_end "$id" "$status"

  if is_independent_investigation "$id"; then
    # Clarifications need an immediate answer; completed results are notified once by the parent.
    if [[ $status == waiting ]]; then notify "$id" waiting "$FINAL" "$note"; fi
    log_info independent_run_finished "task=$id" "status=$status"
  elif [[ ${KIND:-worker} == investigation ]]; then
    case $status in
      paused)
        notify "$id" paused "$FINAL" "$note" ;;
      waiting)
        bus inv-set --dir "$BUS_DIR" --id "$INV_ID" --status waiting_human
        notify "$id" waiting "$FINAL" "investigation #$INV_ID paused — its investigator waits for your answers" ;;
      hung)
        inv_finish "$id" failed "STATUS: FAILED
Answer: the investigator hung ($AGENT_HANG_STRIKES times without progress) — no result"
        notify "$id" hung "$FINAL" "$note" ;;
      *)
        inv_finish "$id" "$status" "$FINAL"      # no push notification (the result goes to the requesting agent)…
        if [[ ${REVIEW:-} == 1 ]]; then          # …except PR reviews (--verify): those go to the human
          notify "$id" "$status" "$FINAL" "review of PR #$PR_NUMBER: $PR_URL"
          if [[ $status == done ]]; then
            review_followup "$id" "$FINAL"
          elif [[ $status =~ ^(failed|hung|stopped)$ ]]; then
            review_without_verdict "$id" "the review run ended $status${note:+ ($note)}"
          fi
        fi ;;
    esac
  elif [[ ${KIND:-worker} == helper && $status != waiting && $status != investigating && $status != paused ]]; then
    helper_finish "$id" "$( ((${HELPER_UNCLEAR:-0})) && echo unclear || echo "$status")" "$FINAL"
  elif [[ -n ${TEAM:-} ]]; then
    team_after_run "$id" "$status" "$FINAL" "$note"
  elif [[ $status == investigating ]]; then
    log_info waiting_for_investigation "investigation=$pending"
  else
    notify "$id" "$status" "$FINAL" "$note"
  fi
  RUNNER_DELIVERED=1
  dispatch
  if ! is_independent_investigation "$id"; then dispatch_helpers; fi
}

start_runner() { # id mode
  local id=$1 mode=$2 run
  if task_stop_requested "$id"; then
    log_info automation_stopped "task=$id" "reason=human stop"
    meta_set "$id" STATUS stopped
    meta_set "$id" FINISHED "$(date -Is)"
    return 0   # cancellation is a completed no-op, not a launch failure for admission to overwrite
  fi
  pause_lock || log_warn pause_lock_failed "task=$id"
  if task_held "$id"; then   # its team is paused by the human: the start waits for agent unpause
    meta_set "$id" HOLD_START "$mode"
    log_info start_held "task=$id" "mode=$mode"
    pause_unlock
    return 0
  fi
  pause_unlock
  run=$(( $(task_field "$id" RUN) + 1 ))
  meta_set "$id" RUN "$run"
  meta_set "$id" STATUS starting
  log_info runner_starting "task=$id" "run=$run" "mode=$mode" "unit=$(unit_name "$id" "$run")"
  systemd-run --user --quiet --collect \
    --unit="$(unit_name "$id" "$run")" \
    --working-directory="$(task_field "$id" WORKTREE)" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _runner "$id" "$mode" 3>&- 7>&- 8>&- 9>&- 10>&- && return 0
  meta_set "$id" STATUS failed
  log_error runner_start_failed "task=$id" "run=$run"
  echo "agent: systemd-run could not start $id (is lingering enabled? sudo loginctl enable-linger $(id -un))" >&2
  return 1
}

# ------------------------------------------------------------------ commands

# lock_task_ids serializes ordinary start/resume admission, before checking agents or touching predecessors.
lock_task_ids() {
  local mask
  mask=$(umask)
  umask 077
  exec 10>"$AGENTS_HOME/task-ids.lock" || die "cannot open the task ID allocation lock"
  umask "$mask"
  flock -w 60 10 || die "cannot lock task ID allocation within 60 seconds; retry the run"
}

# unlock_task_ids releases admission before launching children, which must never retain this lock.
unlock_task_ids() {
  flock -u 10 || die "cannot release the task ID allocation lock"
  exec 10>&-
}

# allocate_run_ids team names-array roots-array repos-array claims the entire cohort; prints its timestamp.
# The caller holds task-ids.lock through team registration. Failed partial claims remove only our empty dirs.
allocate_run_ids() {
  local with_team=$1
  local -n allocation_names=$2 allocation_roots=$3 allocation_repos=$4
  local stamp epoch collision i target claimed_dir detail rc
  local claimed=()
  stamp=$(date +%Y%m%d-%H%M%S) || die "cannot read the task ID timestamp"
  # Advance the encoded label in UTC so a local daylight-saving change cannot repeat candidates.
  epoch=$(TZ=UTC date -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s) \
    || die "cannot parse the task ID timestamp: $stamp"
  while :; do
    stamp=$(TZ=UTC date -d "@$epoch" +%Y%m%d-%H%M%S) || die "cannot advance the task ID timestamp"
    collision=0
    if ((with_team)); then
      # A crash before team-create can leave a claimed cohort with no bus record.
      for target in "$TASKS/$stamp-"*; do
        if [[ -e $target || -L $target ]]; then collision=1; break; fi
      done
    fi
    for ((i = 0; i < ${#allocation_names[@]} && collision == 0; i++)); do
      for target in "$TASKS/$stamp-${allocation_names[i]}" \
          "$AGENTS_HOME/worktrees/${allocation_repos[i]}/$stamp-${allocation_names[i]}"; do
        if [[ -e $target || -L $target ]]; then collision=1; break; fi
      done
      ((collision == 0)) || break
      if git -C "${allocation_roots[i]}" show-ref --verify --quiet \
          "refs/heads/$BRANCH_PREFIX/${allocation_names[i]}/$stamp" 10>&-; then
        collision=1
      else
        rc=$?
        # show-ref returns 1 for an absent branch; any other failure prevents safe allocation.
        ((rc == 1)) || die "cannot check branch availability for ${allocation_names[i]} ($rc)"
      fi
    done
    if ((with_team && collision == 0)); then
      if detail=$(bus team-get --dir "$BUS_DIR" --team "$stamp-team" 2>&1); then
        collision=1
      else
        rc=$?
        # Archived tasks may be absent while their team remains: only NotFound means available.
        if ((rc != BUS_NOT_FOUND)); then
          # Preserve ordinary run's abandonment event and diagnostic when bus storage is invalid.
          # No cohort directories have been claimed yet, so cleanup has no new tasks to remove.
          abandon_run "could not create the team on the bus (cannot check team ID availability: $detail)"
        fi
      fi
    fi
    if ((collision == 0)); then
      claimed=()
      for target in "${allocation_names[@]}"; do
        target="$TASKS/$stamp-$target"
        if detail=$(mkdir -- "$target" 2>&1); then
          claimed+=("$target")
        else
          for claimed_dir in "${claimed[@]}"; do
            rmdir -- "$claimed_dir" || die "cannot release an empty task ID claim: $claimed_dir"
          done
          # Another filesystem writer can race our preflight; exclusive mkdir decides ownership.
          if [[ -e $target || -L $target ]]; then collision=1; break; fi
          die "cannot claim task ID directory $target: $detail"
        fi
      done
      if ((collision == 0)); then
        printf '%s\n' "$stamp" || die "cannot return the allocated task timestamp"
        return 0
      fi
    fi
    epoch=$((epoch + 1))
  done
}

create_task() { # name text root main_root base ts [team [start [round]]] — uses a claimed task directory; sets NEW_ID; start defaults to HEAD, round (ROUND_ID) to "?"; returns 1 with nothing left behind when a step fails
  local name=$1 task=$2 root=$3 main_root=$4 base=$5 ts=$6 team=${7:-} start=${8:-HEAD} round=${9:-?}
  local id repo_name branch wt dir err
  id="$ts-$name"
  repo_name=$(basename "$main_root")
  branch="$BRANCH_PREFIX/$name/$ts"
  wt="$AGENTS_HOME/worktrees/$repo_name/$id"
  dir="$TASKS/$id"
  NEW_ID=""
  CREATE_TASK_ERROR=""
  if ! err=$(mkdir -p "$(dirname "$wt")" 2>&1); then
    rm -rf "${dir:?}"
    log_error task_create_failed "task=$id" "step=worktree_directory"
    CREATE_TASK_ERROR="${err:-cannot create worktree parent directory}"
    return 1
  fi
  if ! err=$(git -C "$root" worktree add --quiet -b "$branch" "$wt" "$start" 10>&- 2>&1); then
    drop_unstarted_task "$root" "$wt" "$branch" "$dir"
    log_error task_create_failed "task=$id" "step=worktree"
    CREATE_TASK_ERROR="${err:-git worktree add failed}"
    return 1
  fi
  # From here on the worktree exists: any failure removes it again, so no task is left half-made.
  if ! printf '%s\n' "$task" > "$dir/task.md"; then
    drop_unstarted_task "$root" "$wt" "$branch" "$dir"
    log_error task_create_failed "task=$id" "step=task_text"
    CREATE_TASK_ERROR="cannot write task.md"
    return 1
  fi
  local agents_md=missing
  [[ -f $wt/AGENTS.md ]] && agents_md=present
  if ! : > "$dir/meta.env"; then
    drop_unstarted_task "$root" "$wt" "$branch" "$dir"
    log_error task_create_failed "task=$id" "step=meta_file"
    CREATE_TASK_ERROR="cannot create meta.env"
    return 1
  fi
  local sid=""
  [[ ${AGENT_TYPE[$name]} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
  local kv
  for kv in "ID=$id" "AGENT=$name" "KIND=worker" "TEAM=$team" "TIER=$(agent_tier "$name")" "TYPE=${AGENT_TYPE[$name]}" "MODEL=${AGENT_MODEL[$name]:-}" \
            "EXTRA_ARGS=${AGENT_EXTRA_ARGS[$name]:-}" \
            "REPO_NAME=$repo_name" "REPO_ROOT=$main_root" "WORKTREE=$wt" "BRANCH=$branch" \
            "BASE=$base" "SESSION_ID=$sid" "ROUND=0" "ROUND_ID=$round" "RUN=0" "STATUS=new" "CREATED=$(date -Is)" \
            "AGENTS_MD=$agents_md"; do
    if ! meta_set "$id" "${kv%%=*}" "${kv#*=}"; then
      drop_unstarted_task "$root" "$wt" "$branch" "$dir"
      log_error task_create_failed "task=$id" "step=meta"
      CREATE_TASK_ERROR="cannot set meta $kv"
      return 1
    fi
  done
  log_info task_created "task=$id" "agent=$name" "repo=$repo_name" "branch=$branch" "team=$team" "agents_md=$agents_md"
  NEW_ID=$id
}

# drop_unstarted_task root wt branch dir — undoes a create_task that failed: the worktree, its branch and the task
# directory. Nothing ran in it, so nothing is archived. Each removal reports its own failure (the task is not started).
drop_unstarted_task() {
  local root=$1 wt=$2 branch=$3 dir=$4
  if [[ -e $wt ]] && ! git -C "$root" worktree remove --force "$wt" 10>&-; then
    log_error task_cleanup_failed "step=worktree" "path=$wt"
  fi
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && ! git -C "$root" branch -D "$branch" >/dev/null 10>&-; then
    log_error task_cleanup_failed "step=branch" "branch=$branch"
  fi
  rm -rf "${dir:?}"
}

# job_refusal agent → why a node job cannot start on this agent now, with the admission checks of agent run
# (configured, not an investigator, not busy); prints nothing when the agent is free. Call it under the task lock.
job_refusal() {
  local name=$1 busy
  if is_investigator "$name"; then
    printf 'agent %s is an investigator' "$name"; return 0
  fi
  if [[ -z ${AGENT_TYPE[$name]:-} ]]; then
    printf 'unknown agent %s' "$name"; return 0
  fi
  if busy=$(agent_running_task "$name"); then
    printf 'agent %s is busy (task %s)' "$name" "$busy"
  fi
  return 0
}

# prepare_job_task job agent repo base sha task — prepares a node job's task: the agent must be free (job_refusal),
# agentbus node-checkout resolves the repository (NODE_REPOS allow-list) and the commit, then create_task starts the
# worktree there, as agent run does. Sets NEW_ID. On failure nothing is created, the reason is logged, returns 1.
# The admission check runs twice: before the checkout and again under the task-ID lock before the task is created,
# because the checkout fetches over the network and an agent can take a task meanwhile. The fetch runs without the
# lock: node-checkout fetches into a private ref, so concurrent checkouts do not interfere.
prepare_job_task() {
  local job=$1 name=$2 repo=$3 base=$4 sha=$5 task=$6
  NODE_PREPARE_ERROR=""
  local -a args=() names roots repos
  local k out root commit ts reason
  for k in "${!NODE_REPOS[@]}"; do args+=(--repo-path "$k=${NODE_REPOS[$k]}"); done
  args+=(--repo "$repo" --base "$base")
  [[ -z $sha ]] || args+=(--sha "$sha")
  lock_task_ids
  reason=$(job_refusal "$name")
  unlock_task_ids
  if [[ -n $reason ]]; then
    NODE_PREPARE_ERROR=$reason
    log_error node_checkout_failed "job=$job" "agent=$name" "reason=$reason"
    return 1
  fi
  if ! out=$(bus node-checkout "${args[@]}" 2>&1); then
    NODE_PREPARE_ERROR=$out
    log_error node_checkout_failed "job=$job" "repo=$repo" "base=$base" "reason=$out"
    return 1
  fi
  root=$(jq -er '.root' <<< "$out") && commit=$(jq -er '.commit' <<< "$out") \
    || die "node-checkout returned an unreadable result for job $job: $out"
  lock_task_ids
  reason=$(job_refusal "$name")
  if [[ -n $reason ]]; then
    NODE_PREPARE_ERROR=$reason
    unlock_task_ids
    log_error node_checkout_failed "job=$job" "agent=$name" "reason=$reason"
    return 1
  fi
  names=("$name"); roots=("$root"); repos=("$(basename "$root")")
  ts=$(allocate_run_ids 0 names roots repos)
  if ! create_task "$name" "$task" "$root" "$root" "$base" "$ts" "" "$commit" "$(job_round_id "$job" "$task")"; then
    NODE_PREPARE_ERROR=${CREATE_TASK_ERROR:-task worktree could not be created}
    unlock_task_ids
    log_error node_checkout_failed "job=$job" "repo=$repo" "base=$base" "reason=${CREATE_TASK_ERROR:-task worktree could not be created}"
    return 1
  fi
  if ! {
    meta_set "$NEW_ID" JOB_ID "$job" &&
    { [[ -z ${7:-} ]] || meta_set "$NEW_ID" JOB_ASSIGNMENT "$7"; } &&
    { [[ -z ${LEAD_URL:-} ]] || meta_set "$NEW_ID" JOB_LEAD "$LEAD_URL"; } &&
    { [[ -z ${8:-} ]] || { meta_set "$NEW_ID" TEAM "$8" && meta_set "$NEW_ID" MEMBER "$9" && meta_set "$NEW_ID" REMOTE_TEAM 1 && meta_set "$NEW_ID" TIER "$(agent_tier "$name")"; }; }
  }; then
    NODE_PREPARE_ERROR="cannot record node job identity metadata"
    drop_unstarted_task "$root" "$AGENTS_HOME/worktrees/$(basename "$root")/$NEW_ID" "$BRANCH_PREFIX/$name/$ts" "$TASKS/$NEW_ID"
    unlock_task_ids
    log_error node_checkout_failed "job=$job" "reason=$NODE_PREPARE_ERROR"
    return 1
  fi
  unlock_task_ids
}

# discard_task id — removes a task that never ran: its worktree, its branch and its task directory. Nothing of
# value exists yet (no run, no commits), so nothing is archived.
discard_task() {
  local id=$1 root wt branch
  root=$(task_field "$id" REPO_ROOT)
  wt=$(task_field "$id" WORKTREE)
  branch=$(task_field "$id" BRANCH)
  if [[ -d $wt ]]; then
    try discard_worktree_failed git -C "$root" worktree remove --force "$wt"
  fi
  # show-ref exits 1 when the branch does not exist — then there is nothing to delete
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    try discard_branch_failed git -C "$root" branch -D "$branch" >/dev/null
  fi
  rm -rf "${TASKS:?}/$id"
  log_info task_discarded "task=$id" "branch=$branch"
}

# abandon_run message id... — a run could not start after its tasks were created: removes them and exits
abandon_run() {
  local msg=$1 id
  shift
  for id in "$@"; do
    discard_task "$id"
  done
  log_error run_abandoned "message=$msg" "tasks=$*"
  die "$msg — the tasks it had created were removed"
}

resume_history() { # task → the human's answers from this task and its predecessors (the --resume chain)
  local t=$1 f
  while [[ -n $t && -d $TASKS/$t ]]; do
    for f in "$TASKS/$t"/questions-*.md; do
      [[ -f $f ]] || continue
      printf '\n### %s (%s)\n\n' "${f##*/}" "$t"; cat "$f"
    done
    t=$(task_field "$t" RESUMED_FROM)
  done
}

# fix_items text — the items to fix the reviews in the text list under their Recommendation, one a line, each once:
# "<level>\t<item>" — easy for one tagged [minor], normal for any other
fix_items() {
  awk '
    /^##[[:space:]]+Recommendation/ {inrec = 1; next}
    /^##[[:space:]]/ {inrec = 0}
    inrec && /^[[:space:]]*([-*]|[0-9]+[.)])[[:space:]]+/ {
      line = $0; sub(/^[[:space:]]*([-*]|[0-9]+[.)])[[:space:]]+/, "", line)
      key = tolower(line); gsub(/[^a-z0-9]/, "", key)
      if (key == "" || key in seen) next
      seen[key] = 1
      print (tolower(line) ~ /^\[minor\]/ ? "easy" : "normal") "\t" line
    }' <<< "$1"
}

# split_fix_items team text task… — a fix pass's work on its new team's board before any of its runs starts, so that
# no member waits for its coordinator to split it: each item the reviews list (fix_items) for a member in turn — never
# the coordinator, who integrates, unless it is alone; an easy one also goes to a worker at once, as its member's
# request: the worker's result comes to that member as a message. A failure is logged and leaves the item to the team.
split_fix_items() {
  local team=$1 text=$2 t lead=${split_lead:-} members=() tasks=() i=0 lvl item who wid bid out
  shift 2
  for t in "$@"; do
    [[ $(task_field "$t" AGENT) != "$lead" ]] || continue
    members+=("$(task_field "$t" AGENT)"); tasks+=("$t")
  done
  if ((${#members[@]} == 0)); then members=("$(task_field "$1" AGENT)"); tasks=("$1"); fi
  while IFS=$'\t' read -r lvl item; do
    [[ -n $item ]] || continue
    who=${members[i % ${#members[@]}]}; wid=${tasks[i % ${#tasks[@]}]}; i=$((i + 1))
    if ! bid=$(bus board-add --dir "$BUS_DIR" --team "$team" --as "${lead:-$who}" --title "${item:0:160}" --details "$item" \
        --level "$lvl" --for "$who" 2>&1); then
      log_warn fix_item_failed "team=$team" "item=${item:0:80}" "reason=${bid:0:300}"
      continue
    fi
    bid=$(grep -oE '\bB[0-9]+\b' <<< "$bid" | head -n 1)   # board-add says "Added B3 (easy). …"
    log_info fix_item "team=$team" "item=$bid" "for=$who" "level=$lvl"
    [[ $lvl == easy && ${#WORKER_AGENTS[@]} -gt 0 ]] || continue
    if out=$(bus delegate --dir "$BUS_DIR" --team "$team" --as "$who" --task "$wid" --repo "$(task_field "$wid" REPO_NAME)" \
        --branch "$(task_field "$wid" BRANCH)" --worktree "$(task_field "$wid" WORKTREE)" --agent-cmd "$SELF" --home "$AGENTS_HOME" \
        --request "$item — board item $bid of team $team, a fix after a review of the round's PR" \
        --context "$who owns the item and checks your result before pushing it." 2>&1); then
      log_info fix_item_to_worker "team=$team" "item=$bid" "for=$who"
    else
      log_warn fix_item_to_worker_failed "team=$team" "item=$bid" "reason=${out:0:300}"
    fi
  done < <(fix_items "$text")
}

resume_run() {
  local carry # ref verify same_round [addition...] — resumes an interrupted team or task from its last checkpoint
  local ref=$1 verify=$2 same_round=$3; shift 3
  local add=""
  if [[ ${1:-} == -f ]]; then [[ -r ${2:-} ]] || die "file not found: ${2:-}"; add=$(<"$2")
  elif (($#)); then add="$*"
  elif [[ ! -t 0 ]]; then add=$(cat); fi
  # the round of the new tasks: the one the human's addition names, else the previous team's (below). A hand-back's
  # text (a fix pass, a check before the review, a failover: AGENT_HANDBACK_LEAD) is the system's: it names none
  local add_round=""
  if [[ -z ${AGENT_HANDBACK_LEAD:-} ]]; then
    add_round=$(round_id_of "$add") || die "$add_round"
    [[ $add_round != '?' ]] || add_round=""
  fi

  lock_task_ids

  # Investigation parents have a separate advisory resume protocol and never recreate normal teams.
  local candidate parent_ref=''
  for candidate in "$TASKS"/*/meta.env; do
    [[ -f $candidate ]] || continue
    candidate=${candidate%/meta.env}; candidate=${candidate##*/}
    [[ $candidate == "$ref" ]] || continue
    if [[ $(task_field "$candidate" KIND) == investigation_team ]]; then parent_ref=$candidate
    elif [[ -n $(investigation_field "$candidate" INVESTIGATION_TEAM) ]]; then
      parent_ref=$(investigation_field "$candidate" INVESTIGATION_TEAM)
    fi
  done
  if [[ -n $parent_ref ]]; then
    unlock_task_ids
    investigation_resume "$parent_ref" "$verify" "$same_round" "$add" "$add_round"
    return
  fi
  # find the interrupted team (by team ID or a member's task ID) or a single task
  local d first="" old_team=""
  for d in "$TASKS"/*/; do
    d=${d%/}; d=${d##*/}
    [[ -f $TASKS/$d/meta.env ]] || continue
    [[ $(task_field "$d" KIND) == worker ]] || continue
    if [[ $(task_field "$d" TEAM) == *"$ref"* || $d == *"$ref"* ]]; then first=$d; old_team=$(task_field "$d" TEAM); fi
  done
  [[ -n $first ]] || die "no team or task matches: $ref"
  if ! normal_resume_allowed "$first"; then unlock_task_ids; return 1; fi

  local olds=() t
  if [[ -n $old_team ]]; then
    local tj; tj=$(bus team-get --dir "$BUS_DIR" --team "$old_team") || die "team $old_team not found on the bus"
    while read -r t; do olds+=("$t"); done < <(jq -r '.members[] | select(.state != "excluded") | .task' <<< "$tj")
  else
    olds=("$first")
  fi
  local remote_olds=() local_olds=()
  for t in "${olds[@]}"; do   # remote members come back on their nodes, through the lead — not as local tasks
    if [[ $(task_field "$t" KIND) == remote-member ]]; then remote_olds+=("$t"); else local_olds+=("$t"); fi
  done
  olds=("${local_olds[@]}")
  local joiners=() tpl="" m t2 found kept=() rkept=()
  if ((${#RESUME_MEMBERS[@]})); then   # --team: these members only — the ones not listed are left out, new ones join
    for t in "${olds[@]}"; do is_one_of "$(task_field "$t" AGENT)" "${RESUME_MEMBERS[@]}" && kept+=("$t"); done
    for t in "${remote_olds[@]}"; do is_one_of "$(task_field "$t" AGENT)" "${RESUME_MEMBERS[@]}" && rkept+=("$t"); done
    for m in "${RESUME_MEMBERS[@]}"; do
      found=0
      for t2 in "${olds[@]}" "${remote_olds[@]}"; do [[ $(task_field "$t2" AGENT) != "$m" ]] || found=1; done
      ((found)) && continue
      [[ $m != *@* ]] || die "--team: $m was not a member of the interrupted team — a remote member cannot join on a resume"
      agent_running_task "$m" > /dev/null && die "agent $m is busy with another task"
      joiners+=("+$m")
    done
    ((${#kept[@]})) || die "--team: none of the interrupted team's local members is listed — at least one goes on"
    tpl=${kept[0]}   # a new member's template: the coordinator's task when it goes on
    local lead_name=""
    [[ -z ${tj:-} ]] || lead_name=$(jq -r '.lead // empty' <<< "$tj")
    for t in "${kept[@]}"; do [[ $(task_field "$t" AGENT) != "$lead_name" ]] || tpl=$t; done
    olds=("${kept[@]}")
    remote_olds=("${rkept[@]}")
  fi
  for t in "${olds[@]}"; do
    case $(task_field "$t" STATUS) in
      new|starting|running|waiting|investigating|sleeping|paused)
        die "task $t is still active ($(task_field "$t" STATUS)) — wait for its run to end, or stop it: agent stop $t" ;;
    esac
    agent_running_task "$(task_field "$t" AGENT)" >/dev/null && die "agent $(task_field "$t" AGENT) is busy with another task"
  done

  # rounds: after STATUS: ROUND_DONE the next round starts only once its PR is merged, on fresh branches from the
  # updated base; --same-round continues the same round on the same branches (e.g. for review fixes)
  local rtask="" wr="" wrs="" fresh=0 round_title="" round_head="" round_merged=0 rlead=""
  [[ -z ${tj:-} ]] || rlead=$(jq -r '.lead // empty' <<< "$tj")
  for t in "${olds[@]}"; do
    if [[ -n $(task_field "$t" WORK_ROUND) ]]; then
      [[ -n $rtask && -n $rlead && $(task_field "$rtask" AGENT) == "$rlead" ]] || rtask=$t
    fi
  done
  if [[ -n $rtask ]]; then
    wr=$(task_field "$rtask" WORK_ROUND); wrs=$(task_field "$rtask" WORK_ROUNDS)
    if ((same_round)); then
      local rnum next=""
      read -r rnum _ <<< "$(round_pr_of_tasks "${olds[@]}")"
      ((wr >= wrs)) || next=" Round $((wr + 1)) has not started: do none of its work — it starts on fresh branches when the round is resumed after its merge."
      round_title="Round $wr of $wrs continues"
      if [[ -n $rnum ]] && round_pr_merged "$rnum" "${olds[@]}"; then   # merged: what comes now is its follow-up
        round_merged=1
        round_head="Round $wr of $wrs continues, and its PR #$rnum is merged: do only the follow-up the text below asks for, on the same branches, then end with STATUS: ROUND_DONE $wr/$wrs again.$next"
      else
        round_head="Round $wr of $wrs continues: its PR is not merged — keep working on the same branches (e.g. on the review findings), then end with STATUS: ROUND_DONE $wr/$wrs again.$next"
      fi
    else
      ((wr < wrs)) || die "all $wrs rounds are done (round $wr/$wrs was the last) — start a new task for more work"
      local pr state="" url="" t2 b heads=() open=() st u
      for t2 in "${olds[@]}"; do   # the round's PR was opened from the branch of whoever ended the round
        b=$(task_field "$t2" BRANCH)
        [[ -n $b ]] || continue
        heads+=("$b")
        pr=$(trusted_prs "$(task_field "$t2" REPO_ROOT)" "$b" all number,url,state) \
          || die "cannot check the PR of round $wr/$wrs (gh pr list failed) — merge it and retry, or continue the round: agent run --resume $ref --same-round"
        while IFS=$'\t' read -r st u; do   # every PR of the round's branches: one merged, and none left open
          [[ -n $u ]] || continue
          if [[ $st == MERGED ]]; then state=MERGED; url=$u
          elif [[ $state != MERGED && -z $url ]]; then state=$st; url=$u
          fi
          [[ $st != OPEN ]] || open+=("$u")
        done < <(jq -r '.[] | [(.state // ""), (.url // "")] | @tsv' <<< "$pr")
      done
      if [[ -z $url ]]; then   # none from its branches: the PR the round was reviewed on (another team's branch, --pr)
        local rn rj
        read -r rn _ <<< "$(round_pr_of_tasks "${olds[@]}")"
        if [[ -n $rn ]]; then
          rj=$(trusted_prs "$(task_field "${olds[0]}" REPO_ROOT)" "" all number,url,state \
            | jq -r --argjson n "$rn" '.[] | select(.number == $n) | [(.state // ""), (.url // "")] | @tsv') \
            || die "cannot check PR #$rn of round $wr/$wrs (gh pr list failed) — retry, or continue the round: agent run --resume $ref --same-round"
          if [[ -n $rj ]]; then
            IFS=$'\t' read -r state url <<< "$rj"
            [[ $state != OPEN ]] || open+=("$url")
            log_info round_pr_found "task=${olds[0]}" "pr=$rn" "by=round_pr" "state=$state"
          fi
        fi
      fi
      [[ -n $url ]] || die "round $wr/$wrs has no PR (branches ${heads[*]}) — open and merge it, or continue the round: agent run --resume $ref --same-round"
      [[ $state == MERGED ]] || die "the PR of round $wr/$wrs ($url) is not merged yet ($state). Merge it and run this again — or keep working on round $wr (e.g. review fixes): agent run --resume $ref --same-round"
      ((${#open[@]} == 0)) || die "round $wr/$wrs still has an open PR (${open[*]}) — a round has one PR: merge or close it first; or finish the round: agent run --resume $ref --same-round"
      fresh=1
    fi
  elif ((same_round)); then   # no round was ended: resuming keeps the branches anyway
    echo "--same-round: no round was ended — continuing on the same branches"
  fi

  local ts new_team="" ids=() id old root wt name branch prev start base sha
  local names=() roots=() repos=() with_team=0
  for old in "${olds[@]}"; do
    names+=("$(task_field "$old" AGENT)")
    roots+=("$(task_field "$old" REPO_ROOT)")
    repos+=("$(task_field "$old" REPO_NAME)")
  done
  [[ -n $old_team ]] && with_team=1
  ts=$(allocate_run_ids "$with_team" names roots repos)
  [[ -n $old_team ]] && new_team="$ts-team"
  local round=$add_round
  if [[ -z $round ]]; then   # the previous team's: its coordinator's task's, else the first task's that has one
    for t in "${olds[@]}" "${remote_olds[@]}"; do
      [[ -n $(task_field "$t" ROUND_ID) ]] || continue
      if [[ -z $round || $(task_field "$t" AGENT) == "$rlead" ]]; then round=$(task_field "$t" ROUND_ID); fi
    done
    round=${round:-?}
  fi
  local remote_ids=() r rtext
  for r in "${remote_olds[@]}"; do   # the old members' jobs end first: their agents must be free to come back
    "$SELF" jobs --cancel "$(task_field "$r" JOB_ID)" >/dev/null 2>&1 \
      || log_info remote_member_cancel_skipped "task=$r"   # a job that already ended cannot be cancelled
    bus lead-member --dir "$BUS_DIR" --remove --member "$(task_field "$r" AGENT)" >/dev/null 2>&1 \
      || log_info remote_member_revoke_skipped "task=$r"   # revoked already when its team finished
    remote_agent_wait_free "$(task_field "$r" AGENT)" 60 \
      || die "remote member $(task_field "$r" AGENT): its agent is still busy on its node — retry in a minute"
  done
  RESUME_NEW_IDS=(); RESUME_NEW_WT=()   # what this resume makes; removed again if it fails (resume_abandon)
  trap 'resume_abandon "$?" "$BASH_COMMAND"' EXIT   # the status and the command that ended it, for the log
  for r in "${remote_olds[@]}"; do   # node online, agent free, base on origin — before any local task exists
    rtext=$(cat "$TASKS/$r/task.md"
      if [[ -n ${add//[[:space:]]/} ]]; then
        printf '\n\n## Addition from the human (resumed %s)\n\n%s\n' "$(date '+%Y-%m-%d %H:%M')" "$add"
      fi)
    remote_ids+=("$(remote_member_task "$(task_field "$r" AGENT)" "$rtext" "$new_team" "$(task_field "$r" BASE)" \
      "$(task_field "$r" REPO_ROOT)" "$ts" resume "$round")")
  done
  RESUME_NEW_IDS+=("${remote_ids[@]}")
  local split_lead=""   # the coordinator: what the checks and reviews send back is its alone (the bus, else handback)
  split_lead=$(jq -r '.lead // empty' <<< "${tj:-}" 2> /dev/null) || split_lead=""
  split_lead=${split_lead:-${AGENT_HANDBACK_LEAD:-}}
  local split_line="Your coordinator splits this work on the board: take only the board items assigned to you — with none, sleep."
  local round_pr_text=""   # the same round: which is its PR, said to every member
  ((fresh)) || round_pr_text=$(round_pr_note "$round_merged" "${olds[@]}")
  for old in "${olds[@]}" "${joiners[@]}"; do
    local joiner=""
    if [[ $old == +* ]]; then joiner=${old#+}; old=$tpl; fi   # a new member: the coordinator's task is its template
    name=${joiner:-$(task_field "$old" AGENT)}; root=$(task_field "$old" REPO_ROOT)
    id="$ts-$name"; wt="$AGENTS_HOME/worktrees/$(task_field "$old" REPO_NAME)/$id"
    mkdir -p "$TASKS/$id"   # a new member's task directory (the others' exist already)
    RESUME_NEW_IDS+=("$id"); RESUME_NEW_WT[$id]=$wt
    mkdir -p "$(dirname "$wt")"
    # the same branch (with its commits and draft PR) — the old worktree releases it
    carry=""
    if [[ -z $joiner && -d $(task_field "$old" WORKTREE) ]]; then
      # uncommitted changes are never thrown away: they go to the stash and on into the new worktree
      if [[ -n $(git -C "$(task_field "$old" WORKTREE)" status --porcelain 10>&-) ]]; then
        local why
        why=$(worktree_stash "$(task_field "$old" WORKTREE)" "agent resume of $old: uncommitted work" "$old") \
          || die "the worktree of $old has uncommitted changes that git could not stash (${why:-no reason given}) — commit them first"
        carry=$(git -C "$root" rev-parse --verify --quiet refs/stash 10>&-)
      fi
      try worktree_remove_failed git -C "$root" worktree remove --force "$(task_field "$old" WORKTREE)" 10>&-
    fi
    git -C "$root" worktree prune 10>&-
    prev=$(task_field "$old" BRANCH); branch=$prev
    if ((fresh)); then   # the next round: a new branch from the base, which now contains the merged round
      base=$(task_field "$old" BASE); start=$base
      if git -C "$root" remote get-url origin >/dev/null 2>&1; then   # a query: no origin = no remote to update from
        try round_fetch_failed git -C "$root" fetch --quiet origin "$base" 10>&-
        if git -C "$root" rev-parse --verify --quiet "origin/$base" >/dev/null; then start="origin/$base"; fi
      fi
      branch="$BRANCH_PREFIX/$name/$ts"
      git -C "$root" worktree add --quiet -b "$branch" "$wt" "$start" 10>&- || die "could not create branch $branch from $start"
      sha=$(git -C "$root" rev-parse --short "$start")
      round_title="Round $((wr + 1)) of $wrs"
      round_head="Round $((wr + 1)) of $wrs. Round $wr is merged into $base: your branch $branch starts from there ($sha). Your previous branch $prev is kept — take from it only what the round plan puts into this round."
    elif [[ -n $joiner ]]; then   # a new member: its own branch from the coordinator's, with the round's work so far
      branch="$BRANCH_PREFIX/$name/$ts"
      git -C "$root" worktree add --quiet -b "$branch" "$wt" "$prev" 10>&- || die "could not create branch $branch from $prev"
      echo "  $name joins the team: branch $branch from $prev"
    else
      git -C "$root" worktree add --quiet "$wt" "$branch" 10>&- || die "could not recreate the worktree of branch $branch"
    fi
    if [[ -n $carry ]] && ((fresh)); then   # a new round starts clean: the old round's leftovers stay in the stash
      echo "  $name: the uncommitted changes of $old stay in the stash ($carry) — the new round starts clean"
    elif [[ -n $carry ]]; then
      if git -C "$wt" stash apply --quiet "$carry" 10>&-; then
        git -C "$root" stash drop --quiet "$(git -C "$root" stash list --format='%gd %H' | awk -v h="$carry" '$2 == h {print $1; exit}')" 10>&- \
          || log_warn stash_drop_failed "stash=$carry"
        echo "  $name: the uncommitted changes of $old are carried into the new worktree"
      else
        log_error stash_apply_failed "task=$old" "stash=$carry"
        echo "  WARNING $name: the uncommitted changes of $old could not be applied — they stay in the stash: git stash apply $carry"
      fi
    fi
    { if ((fresh)); then round_text_strip < "$TASKS/$old/task.md"
      else round_text_restate "$([[ -n $round_head ]] && echo 1)" "$([[ -n $round_pr_text ]] && echo 1)" < "$TASKS/$old/task.md"
      fi
      if [[ -n $round_head ]]; then   # this round's own heading: for this round only
        printf '\n\n%s\n## %s (resumed %s)\n\n%s\n%s\n' "$ROUND_ONLY_OPEN" "$round_title" "$(date '+%Y-%m-%d %H:%M')" \
          "$round_head" "$ROUND_ONLY_CLOSE"
      fi
      if [[ -n $round_pr_text ]]; then
        printf '\n\n%s\n## The round'"'"'s PR\n\n%s\n%s\n' "$ROUND_ONLY_OPEN" "$round_pr_text" "$ROUND_ONLY_CLOSE"
      fi
      if [[ -n ${add//[[:space:]]/} ]] && ((${AGENT_FIX_PASS:-0} > 0 || ${AGENT_PRECHECK_PASS:-0} > 0)); then
        # what the checks and the reviews send back (a fix pass, a bounce): for this round only, the coordinator's
        if [[ -n $split_lead && $(task_field "$old" AGENT 2> /dev/null) != "$split_lead" ]]; then
          printf '\n\n%s\n## For this round only: your work (resumed %s)\n\n%s\n%s\n' "$ROUND_ONLY_OPEN" \
            "$(date '+%Y-%m-%d %H:%M')" "$split_line" "$ROUND_ONLY_CLOSE"
        else
          printf '\n\n%s\n## For this round only: from its checks and reviews (resumed %s)\n\n%s\n%s\n' "$ROUND_ONLY_OPEN" \
            "$(date '+%Y-%m-%d %H:%M')" "$add" "$ROUND_ONLY_CLOSE"
        fi
      elif [[ -n ${add//[[:space:]]/} ]]; then
        printf '\n\n## Addition from the human (resumed %s)\n\n%s\n' "$(date '+%Y-%m-%d %H:%M')" "$add"
        if [[ $(task_field "$old" AGENT 2> /dev/null) != "${split_lead:-}" ]]; then printf '\n%s\n' "$split_line"; fi
      fi; } > "$TASKS/$id/task.md"
    for t in "${olds[@]}"; do resume_history "$t"; done > "$TASKS/$id/history.md"   # every member sees all answers
    : > "$TASKS/$id/meta.env"
    local sid="" kv
    [[ ${AGENT_TYPE[$name]:-} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
    for kv in "ID=$id" "AGENT=$name" "KIND=worker" "TEAM=$new_team" "TIER=$(agent_tier "$name")" \
              "TYPE=${AGENT_TYPE[$name]}" "MODEL=${AGENT_MODEL[$name]:-}" "EXTRA_ARGS=${AGENT_EXTRA_ARGS[$name]:-}" \
              "REPO_NAME=$(task_field "$old" REPO_NAME)" "REPO_ROOT=$root" "WORKTREE=$wt" \
              "BRANCH=$branch" "PREV_BRANCH=$( ((fresh)) && echo "$prev")" "BASE=$(task_field "$old" BASE)" "SESSION_ID=$sid" \
              "ROUND=0" "ROUND_ID=$round" "RUN=0" "STATUS=new" "CREATED=$(date -Is)" "RESUMED_FROM=$old" "FIX_PASS=${AGENT_FIX_PASS:-0}" \
              "VERIFY=$( ((verify)) && echo 1 || task_field "$old" VERIFY)" \
              "AUTOPILOT=$( ((${autopilot:-0})) && echo 1 || task_field "$old" AUTOPILOT)" "PRECHECK_PASS=${AGENT_PRECHECK_PASS:-0}" \
              "AUTOPILOT_OFF=$( ((${autopilot:-0})) || task_field "$old" AUTOPILOT_OFF)" \
              "FORMAT_BOUNCED=${AGENT_FORMAT_BOUNCED:-$( ((fresh)) || task_field "$old" FORMAT_BOUNCED)}" \
              "ROUND_PR=$( ((fresh)) || round_pr_of_team "$old_team")"; do
      meta_set "$id" "${kv%%=*}" "${kv#*=}"
    done
    ids+=("$id")
  done

  mkdir -p "$BUS_DIR/checkpoints"
  if [[ -n $old_team ]]; then
    local json='{}' lead
    lead=$(jq -r '.lead // empty' <<< "$tj")
    if ((${#RESUME_MEMBERS[@]})) && ! is_one_of "$lead" "${RESUME_MEMBERS[@]}"; then lead=""; fi   # left out: a new coordinator
    [[ $(jq -r --arg l "$lead" '.members[$l].state // empty' <<< "$tj") == hung ]] && lead=""
    for id in "${ids[@]}"; do
      name=$(task_field "$id" AGENT)
      json=$(jq --arg a "$name" --arg t "$id" --arg b "$(task_field "$id" BRANCH)" --arg w "$(task_field "$id" WORKTREE)" \
               --arg tier "$(agent_tier "$name")" --arg prov "$(agent_provider "$name")" \
               '.[$a] = {agent:$a, task:$t, branch:$b, worktree:$w, state:"active", tier:$tier, provider:$prov}' <<< "$json")
    done
    for r in "${remote_ids[@]}"; do
      json=$(jq --arg a "$(task_field "$r" AGENT)" --arg t "$r" --arg w "remote:$(task_field "$r" REMOTE_NODE)" \
               --arg tier "$(task_field "$r" TIER)" \
               '.[$a] = {agent:$a, task:$t, branch:"", worktree:$w, state:"active", tier:$tier, provider:"remote"}' <<< "$json")
    done
    # the old team on jq's input, not as an argument: with its board it can be past the kernel's limit for one
    jq --arg id "$new_team" --arg repo "$(task_field "${ids[0]}" REPO_NAME)" --arg wake "$SELF" --arg home "$AGENTS_HOME" \
      --argjson members "$json" --arg from "$old_team" \
      --arg lead "${lead:-$(jq -r 'keys[]' <<< "$json" | { mapfile -t a; preferred_coordinator "${a[@]}"; })}" '
      . as $old
      | {id:$id, repo:$repo, wake_cmd:$wake, home:$home, members:$members, lead:$lead, resumed_from:$from,
       next_board_id: ($old.next_board_id // 0),
       board: (($old.board // {}) | map_values(if .status == "claimed" then .status = "todo" | .assignee = "" else . end))}' <<< "$tj" \
      | bus team-create --dir "$BUS_DIR" || die "could not create the resumed team"
    try team_close_failed bus team-done --dir "$BUS_DIR" --team "$old_team"
    for r in "${remote_ids[@]}"; do
      remote_member_start "$r" || die "could not start remote member $(task_field "$r" AGENT) (see ~/agents/logs/agent.jsonl)"
    done
    if [[ -f $BUS_DIR/checkpoints/team-$old_team.md ]]; then
      try checkpoint_copy_failed cp "$BUS_DIR/checkpoints/team-$old_team.md" "$BUS_DIR/checkpoints/team-$new_team.md"
    fi
  else
    if [[ -f $BUS_DIR/checkpoints/task-$first.md ]]; then
      try checkpoint_copy_failed cp "$BUS_DIR/checkpoints/task-$first.md" "$BUS_DIR/checkpoints/task-${ids[0]}.md"
    fi
  fi

  trap - EXIT; RESUME_NEW_IDS=()   # made: from here on the tasks run (a runner that fails to start is its own failure)
  unlock_task_ids
  if [[ -n $new_team ]] && ((${AGENT_FIX_PASS:-0} > 0)); then   # the work split before anyone runs
    split_fix_items "$new_team" "$add" "${ids[@]}"
  fi
  for id in "${ids[@]}"; do start_runner "$id" new || exit 1; done
  log_info resumed "from=${old_team:-$first}" "new_team=$new_team" "tasks=${ids[*]}"
  echo "Resumed ${old_team:-$first} from the last checkpoint:"
  for id in "${ids[@]}"; do echo "  $id  →  $(task_field "$id" BRANCH)"; done
  [[ -n $new_team ]] && echo "  new team: $new_team${lead:+, coordinator: $lead}"
  [[ -n ${add//[[:space:]]/} ]] && echo "  addition appended to the task"
  return 0
}

# validate_investigation_team checks a comma-separated investigator list without allocating any run resources.
validate_investigation_team() {
  local remaining="$1," member configured seen=" " count=0
  configured=$(investigator_names)
  configured=${configured//$'\n'/, }
  while [[ $remaining == *,* ]]; do
    member=${remaining%%,*}; remaining=${remaining#*,}
    member=${member#"${member%%[![:space:]]*}"}
    member=${member%"${member##*[![:space:]]}"}
    [[ -n $member ]] || die "--team needs at least one investigator and no empty names. Configured investigators: $configured"
    [[ $member != *@* ]] || die "--investigation runs on the lead only; remote members are not allowed ($member)"
    is_investigator "$member" || die "unknown investigator '$member'. Configured investigators: $configured"
    [[ $seen != *" $member "* ]] || die "duplicate investigator $member is listed twice. Configured investigators: $configured"
    seen+="$member "; count=$((count + 1))
  done
  ((count >= 1)) || die "an investigation team needs at least one investigator. Configured investigators: $configured"
}

# validate_investigation_topic prints validated argument, file or stdin text for one-time consumption.
validate_investigation_topic() {
  local topic
  if [[ ${1:-} == -f ]]; then
    [[ -r ${2:-} ]] || die "file not found: ${2:-}"
    topic=$(<"$2") || die "cannot read topic file: ${2:-}"
  elif (($#)); then
    topic="$*"
  elif [[ ! -t 0 ]]; then
    topic=$(cat) || die "cannot read topic from stdin"
  else
    die "give the task text (argument, -f file or stdin)"
  fi
  [[ -n ${topic//[[:space:]]/} ]] || die "empty task"
  local round
  round=$(round_id_of "$topic") || die "$round"
  printf '%s\n' "$topic"
}

# cmd_run parses run options and starts ordinary runs or the investigator-only pipeline.
cmd_run() {
  local members=() verify=0 autopilot=0 same_round=0 team_list="" resume_ref="" need_caps=() target_node=""
  local investigation=0 team_requested=0 last_team_requested=0 resolve_last_team=0
  while [[ ${1:-} == --need || ${1:-} == --pr || ${1:-} == --on || ${1:-} == --team || ${1:-} == --verify || ${1:-} == --autopilot || ${1:-} == --resume || ${1:-} == --same-round || ${1:-} == --last-team || ${1:-} == --investigation ]]; do
    case $1 in
      --investigation) investigation=1; shift ;;
      --need)
        [[ -n ${2:-} && ${2:-} != --* ]] || die "usage: agent run --need cap1,cap2 <agent|normal|worker> \"task\""
        IFS=, read -ra need_caps <<< "$2"; shift 2 ;;
      --on)
        [[ -n ${2:-} && ${2:-} != --* ]] || die "usage: agent run --on instance <agent> \"task\""
        target_node=$2; shift 2 ;;
      --last-team)
        last_team_requested=1; resolve_last_team=1
        shift ;;
      --verify) verify=1; shift ;;
      --autopilot) verify=1; autopilot=1; shift ;;   # --verify, then the merge and the next round by themselves
      --same-round) same_round=1; shift ;;
      --pr) pin_pr=${2:-}; [[ $pin_pr =~ ^[0-9]+$ ]] || die "--pr takes the number of an open PR"; shift 2 ;;   # a team on that PR
      --resume)
        [[ -n ${2:-} ]] || die "usage: agent run --resume <team|task> [\"addition\" | -f file.md]"
        resume_ref=$2; resolve_last_team=0; shift 2 ;;
      --team)
        (($# >= 2)) && [[ $2 != --* ]] || die "usage: agent run --team agent1[,agent2,...] [--verify] [-f file.md | \"task text\"]"
        team_requested=1; team_list=$2; shift 2 ;;
    esac
  done
  if ((investigation)); then
    ((autopilot == 0)) || die "--investigation cannot be combined with --autopilot"
    ((verify == 0)) || die "--investigation cannot be combined with --verify"
    ((${#need_caps[@]} == 0)) || die "--investigation cannot be combined with --need"
    [[ -z $target_node ]] || die "--investigation cannot be combined with --on"
    ((last_team_requested == 0)) || die "--investigation cannot be combined with --last-team"
    [[ -z $resume_ref ]] || die "--investigation cannot be combined with --resume"
    ((same_round == 0)) || die "--investigation cannot be combined with --same-round"
    validate_investigation_team "$team_list"
    local topic
    topic=$(validate_investigation_topic "$@") || return
    cmd__investigation_team --pipeline --team "$team_list" ${pin_pr:+--pr "$pin_pr"} -- "$topic"
    return
  fi
  if ((resolve_last_team)); then
    resume_ref=$(last_team_id)
    [[ -n $resume_ref ]] || die "--last-team: no team of this repository (outside a repository: no team at all)"
  fi
  ((team_requested == 0)) || [[ -n $team_list ]] || die "usage: agent run --team agent1,agent2[,...] [--verify] [-f file.md | \"task text\"]"
  if ((${#need_caps[@]} > 0)) || [[ -n $target_node ]]; then
    [[ -z $team_list ]] || die "--need/--on cannot be combined with --team"
    ((verify == 0)) || die "--need/--on cannot be combined with --verify"
    [[ -z $resume_ref ]] || die "--need/--on cannot be combined with --resume"
    local selector=${1:-}
    [[ -n $selector ]] || die "usage: agent run --need <caps> | --on <node> <agent|normal|worker> \"task\""
    shift
    local task
    if [[ ${1:-} == -f ]]; then
      [[ -r ${2:-} ]] || die "file not found: ${2:-}"
      task=$(<"$2")
    elif (($#)); then
      task="$*"
    elif [[ ! -t 0 ]]; then
      task=$(cat)
    else
      die "give the task text (argument, -f file or stdin)"
    fi
    [[ -n ${task//[[:space:]]/} ]] || die "empty task"
    local round   # the node reads it from the job's text (job_round_id): a text it would not take is refused here
    round=$(round_id_of "$task") || die "$round"
    submit_remote_job "$selector" "$target_node" "$task" "${need_caps[@]}"
    return
  fi
  ((same_round == 0)) || [[ -n $resume_ref ]] || die "--same-round only works with --resume"
  if [[ -n $resume_ref ]]; then
    RESUME_MEMBERS=()   # --team with --resume: the resumed team's members (the others are left out, new ones join)
    if [[ -n $team_list ]]; then
      local m
      for m in ${team_list//,/ }; do   # "a, b,c": split on commas and spaces
        [[ $m == *@* || -n ${AGENT_TYPE[$m]:-} ]] || die "--team: $m is not a configured agent (agents.conf: AGENT_TYPE)"
        RESUME_MEMBERS+=("$m")
      done
    fi
    resume_run "$resume_ref" "$verify" "$same_round" "$@"
    return
  fi
  if ((verify)) && [[ -z $team_list ]]; then
    die "--verify only works with --team (PR review of the team's work by an investigator)"
  fi
  if [[ -n $team_list ]]; then
    IFS=, read -ra members <<< "$team_list"
    ((${#members[@]} >= 2)) || die "a team needs at least two agents"
  else
    local name=${1:-}
    [[ -n $name ]] || die "usage: agent run <agent> | --team a,b [-f file.md | \"task text\"]"
    shift
    members=("$name")
  fi
  local m seen=" " locals=() remotes=()
  for m in "${members[@]}"; do
    if [[ $m == *@* ]]; then   # a remote member, <agent>@<node>: it works on its node, in this lead's team
      [[ $seen != *" $m "* ]] || die "agent $m is listed twice"
      seen+="$m "; remotes+=("$m")
      continue
    fi
    locals+=("$m")
    ! is_investigator "$m" || die "investigators are not started directly — agents request them (request_investigation); --investigation --team validates investigation teams"
    [[ -n ${AGENT_TYPE[$m]:-} ]] || die "unknown agent '$m'. Configured: ${!AGENT_TYPE[*]}"
    [[ $seen != *" $m "* ]] || die "agent $m is listed twice"
    seen+="$m "
  done
  if ((${#remotes[@]})); then
    ((${#members[@]} > 1)) || die "a remote member works in a team: agent run --team <local agents>,<agent>@<node> …"
    members=("${locals[@]}")
  fi

  local task
  if [[ ${1:-} == -f ]]; then
    [[ -r ${2:-} ]] || die "file not found: ${2:-}"
    task=$(<"$2")
  elif (($#)); then
    task="$*"
  elif [[ ! -t 0 ]]; then
    task=$(cat)
  else
    die "give the task text (argument, -f file or stdin)"
  fi
  [[ -n ${task//[[:space:]]/} ]] || die "empty task"
  local round   # every task of the run records it (ROUND_ID)
  round=$(round_id_of "$task") || die "$round"

  local root common main_root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run this inside a git repository"
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
  main_root=$(dirname "$common")

  if ((${#members[@]} > 1)); then
    local has_normal=0
    for m in "${members[@]}"; do [[ $(agent_tier "$m") == normal ]] && has_normal=1; done
    ((has_normal)) || die "a team needs at least one local agent outside WORKER_AGENTS (workers cannot coordinate; remote members neither)"
  fi
  lock_task_ids
  local busy
  for m in "${members[@]}"; do
    if busy=$(agent_running_task "$m"); then
      die "agent $m is busy (task $busy). Wait, or add another agent in $CONF."
    fi
  done

  local ts base team="" ids=() roots=() repos=() with_team=0
  for m in "${members[@]}"; do roots+=("$root"); repos+=("$(basename "$main_root")"); done
  ((${#members[@]} + ${#remotes[@]} > 1)) && with_team=1
  local pin_start=HEAD pin_branch="" pin_url="" pin_base="" pin_json named owner_team
  if [[ -n ${pin_pr:-} ]]; then   # a team on an open PR: from its head, on its base, the PR its round's
    pin_json=$(trusted_prs "$main_root" "" open number,url,headRefName,headRefOid,baseRefName \
      | jq -c --argjson n "$pin_pr" '[.[] | select(.number == $n)][0] // empty') || die "could not look up PR #$pin_pr"
    [[ -n $pin_json ]] || die "PR #$pin_pr is not an open PR of this repository from a trusted account"
    pin_branch=$(jq -r .headRefName <<< "$pin_json"); pin_url=$(jq -r .url <<< "$pin_json")
    pin_start=$(jq -r .headRefOid <<< "$pin_json"); pin_base=$(jq -r '.baseRefName // "main"' <<< "$pin_json")
    git -C "$root" fetch -q origin "$pin_branch" || die "could not fetch PR #$pin_pr's branch $pin_branch"
    git -C "$root" cat-file -e "$pin_start^{commit}" || die "PR #$pin_pr's head $pin_start is not here after a fetch"
  elif [[ $task =~ PR[[:space:]]*\#([0-9]+) ]]; then   # it names a PR: if that one is open here, say how to continue it
    named=${BASH_REMATCH[1]}
    if trusted_prs "$main_root" "" open number 2> /dev/null | jq -e --argjson n "$named" 'any(.[]; .number == $n)' > /dev/null; then
      owner_team=$(grep -lx "PR_NUMBER=$named" "$TASKS"/*/meta.env 2> /dev/null | head -n 1 | xargs -r sed -n 's/^TEAM=//p') \
        || owner_team=""   # no task yet, or none of that PR
      echo "WARNING: the task names PR #$named, an open PR of this repository — this run starts on its own branches." >&2
      echo "  To continue that PR: agent run --pr $named …${owner_team:+, or resume its team: agent run --resume $owner_team --same-round …}" >&2
      log_warn task_names_open_pr "pr=$named" "team=${owner_team:-}"
    fi
  fi
  ts=$(allocate_run_ids "$with_team" members roots repos)
  base=$(git -C "$root" symbolic-ref --quiet --short HEAD || git -C "$root" rev-parse --short HEAD)
  [[ -z $pin_base ]] || base=$pin_base   # a team on a PR (--pr): the PR's base
  ((${#members[@]} + ${#remotes[@]} > 1)) && team="$ts-team"
  for m in "${members[@]}"; do
    if ! create_task "$m" "$task" "$root" "$main_root" "$base" "$ts" "$team" "$pin_start" "$round"; then
      abandon_run "could not create task for $m: ${CREATE_TASK_ERROR:-worktree creation failed}" "${ids[@]}"
    fi
    ids+=("$NEW_ID")
  done

  if [[ -n ${pin_pr:-} ]]; then   # the round's PR from the first run, and its branch, in every task
    local pt
    for pt in "${ids[@]}"; do meta_set "$pt" ROUND_PR "$pin_pr"; meta_set "$pt" ROUND_PR_BRANCH "$pin_branch"; done
    [[ -n $team ]] || { meta_set "${ids[0]}" PR_NUMBER "$pin_pr"; meta_set "${ids[0]}" PR_URL "$pin_url"; }
  fi
  if [[ -n $team ]]; then
    local json='{}' i
    for i in "${ids[@]}"; do
      json=$(jq --arg a "$(task_field "$i" AGENT)" --arg t "$i" --arg b "$(task_field "$i" BRANCH)" \
               --arg w "$(task_field "$i" WORKTREE)" \
               --arg tier "$(agent_tier "$(task_field "$i" AGENT)")" --arg prov "$(agent_provider "$(task_field "$i" AGENT)")" \
               '.[$a] = {agent:$a, task:$t, branch:$b, worktree:$w, state:"active", tier:$tier, provider:$prov}' <<< "$json")
    done
    local r rid remote_ids=()
    for r in "${remotes[@]}"; do   # a remote member: its proxy task here, a member like any other in the team
      rid=$(remote_member_task "$r" "$task" "$team" "$base" "$main_root" "$ts" "" "$round") || abandon_run "could not prepare remote member $r" "${ids[@]}"
      remote_ids+=("$rid")
      json=$(jq --arg a "$r" --arg t "$rid" --arg w "remote:${r#*@}" --arg tier "$(task_field "$rid" TIER)" \
               '.[$a] = {agent:$a, task:$t, branch:"", worktree:$w, state:"active", tier:$tier, provider:"remote"}' <<< "$json")
    done
    jq -n --arg id "$team" --arg repo "$(basename "$main_root")" --arg wake "$SELF" --arg home "$AGENTS_HOME" \
      --arg lead "$(preferred_coordinator "${members[@]}")" \
      --argjson members "$json" '{id:$id, repo:$repo, wake_cmd:$wake, home:$home, members:$members, lead:$lead}' \
      | bus team-create --dir "$BUS_DIR" ||
      abandon_run "could not create the team on the bus (see ~/agents/logs/agentbus.jsonl)" "${ids[@]}"
    for rid in "${remote_ids[@]}"; do
      remote_member_start "$rid" || abandon_run "could not start remote member $(task_field "$rid" AGENT)" "${ids[@]}"
    done
  fi

  if [[ -n $(git -C "$root" status --porcelain 10>&-) ]]; then
    echo "Note: uncommitted changes in $root were NOT copied to the agents' worktrees (they start from HEAD)."
  fi
  if ((verify)); then
    for i in "${ids[@]}"; do meta_set "$i" VERIFY 1; done
    if ((autopilot)); then for i in "${ids[@]}"; do meta_set "$i" AUTOPILOT 1; done; fi
  fi
  unlock_task_ids
  # its runner says it, once for a team — marked before any runner starts, or a quick one would miss the mark
  meta_set "${ids[0]}" START_NOTIFY "work starts: ${team:+team $team, }${members[*]} — from $base"
  for i in "${ids[@]}"; do
    start_runner "$i" new || exit 1
  done
  if [[ -n $team ]]; then
    echo "Started team $team: ${members[*]} (from $base)"
    for i in "${ids[@]}"; do echo "  $i  →  $(task_field "$i" BRANCH)"; done
    echo "  watch: agent live   |   team: agent team $team"
    if ((verify)); then echo "  --verify: once the PR is ready an investigator reviews it on GitHub"; fi
  else
    echo "Started: ${ids[0]}"
    echo "  agent:    ${members[0]} (${AGENT_TYPE[${members[0]}]})"
    echo "  branch:   $(task_field "${ids[0]}" BRANCH) (from $base)"
    echo "  worktree: $(task_field "${ids[0]}" WORKTREE)"
    echo "  watch:    agent log ${ids[0]}"
  fi
  if [[ $(task_field "${ids[0]}" AGENTS_MD) == missing ]]; then
    echo "WARNING: $(task_field "${ids[0]}" REPO_NAME) has no AGENTS.md (at $base) — the agents do not know its"
    echo "  conventions, build, lint and test commands (see README, \"Repository instructions\")."
    log_warn agents_md_missing "repo=$(task_field "${ids[0]}" REPO_NAME)" "base=$base"
  fi
}

cmd_answer() {
  if [[ ${1:-} == *@* ]]; then
    remote_question_context "$1" || die "no waiting mirrored task $1 on this lead"
    [[ -f $REMOTE_FILE ]] || cmd__remote_questions_ready "$1"
    "${EDITOR:-nano}" "$REMOTE_FILE"
    # A path unit can deliver the save before the editor exits, just like an ordinary local answer.
    if ! remote_question_context "$1"; then echo "$1 no longer waits for answers."; return 0; fi
    if ! validate_answers "$REMOTE_FILE"; then
      echo "Not all questions are answered. Complete them and run: agent answer $1"
      return 1
    fi
    if ! answers_marked "$REMOTE_FILE"; then
      local yn
      read -rp "All questions are answered. Resume now? [Y/n] " yn || return 1
      [[ ${yn,,} != n* ]] || return 0
      printf '\n**ANSWERED**\n' >> "$REMOTE_FILE"
    fi
    remote_answers_saved "$1" "$REMOTE_ROUND"
    return
  fi
  local id; id=$(resolve_id "${1:?usage: agent answer <id>}")
  if [[ $(task_field "$id" KIND) == remote-member && -n $LEAD_LISTEN ]]; then
    local job target
    job=$(task_field "$id" JOB_ID)
    target=$(jq -er --arg job "$job" '.Jobs[] | select(.Request.ID==$job) | .TaskID+"@"+.Node' "$BUS_DIR/jobs.json")
    cmd_answer "$target"
    return
  fi
  meta_load "$id"
  human_resume_allowed "$id" || return 1
  [[ $STATUS == waiting ]] || die "task $id has status '$STATUS' — it is not waiting for answers"
  local q="$TASKS/$id/questions-$ROUND.md"
  "${EDITOR:-nano}" "$q"
  if validate_answers "$q"; then
    local yn
    read -rp "All questions are answered. Resume now? [Y/n] " yn
    [[ ${yn,,} == n* ]] || cmd_resume "$id"
  else
    echo "Not all questions are answered. Complete them and run: agent answer $id"
  fi
}

cmd__answers_saved() { # id round — the human saved a questions file (systemd path unit)
  stopping && return 0
  if [[ ${1:-} == *@* ]]; then remote_answers_saved "$1" "${2:?}"; return; fi
  local id; id=$(resolve_id "${1:?}")
  local round=${2:?} f out errs
  exec 8>"$TASKS/$id/answers.lock"
  flock -w 30 8 || exit 0
  meta_load "$id"
  f="$TASKS/$id/questions-$round.md"
  if [[ $STATUS != waiting || $ROUND != "$round" ]]; then
    stop_answers_watch "$id" "$round"     # answered another way, or the task no longer waits
    return 0
  fi
  # Verified lead delivery is a save even when it shares the question's filesystem timestamp.
  if [[ ${3:-} != lead && $(file_mtime "$f") == "${QUESTIONS_MTIME:-}" ]]; then return 0; fi
  if ! answers_marked "$f"; then
    log_info answers_saved "task=$id" "round=$round" "marked=false"
    return 0
  fi
  if ! errs=$(validate_answers "$f" 2>&1); then
    log_warn answers_incomplete "task=$id" "round=$round"
    notify "$id" waiting "Questions file: $f" "the answers are marked ANSWERED but not complete:
$errs
Complete them and save the file again."
    return 0
  fi
  if out=$(cmd_resume "$id" 2>&1); then
    log_info answers_sent "task=$id" "round=$round"
  else
    log_warn answers_resume_failed "task=$id" "round=$round" "reason=$out"
    notify "$id" waiting "Questions file: $f" "the answers are complete, but the task could not be resumed: $out
Save the file again later, or run: agent resume $id"
  fi
}

cmd_resume() {
  local id; id=$(resolve_id "${1:?usage: agent resume <id> [additional note]}")
  shift
  meta_load "$id"
  human_resume_allowed "$id" || return 1
  [[ $STATUS == waiting ]] || die "task $id has status '$STATUS' (resume only works for 'waiting')"
  local q="$TASKS/$id/questions-$ROUND.md"
  validate_answers "$q" || die "not all questions are answered — complete: $q"
  [[ -n $SESSION_ID ]] || die "no agent session ID — cannot resume (see: agent log $id)"
  if (($#)); then printf '%s\n' "$*" > "$TASKS/$id/note-$((RUN + 1)).md"; fi
  meta_set "$id" ANSWERS_PENDING "$ROUND"
  stop_answers_watch "$id" "$ROUND"

  if [[ ${KIND:-worker} == worker ]]; then
    local pending
    pending=$(bus inv-pending --dir "$BUS_DIR" --task "$id")
    if [[ -n $pending ]]; then
      meta_set "$id" STATUS investigating
      echo "Answers accepted. $id resumes automatically when investigation #$pending finishes."
      return
    fi
    local busy
    if busy=$(agent_running_task "$AGENT"); then
      die "agent $AGENT is busy with $busy — resume when it finishes"
    fi
  elif ! is_independent_investigation "$id"; then
    # Independent cohort members have no queued-investigation bus ID.
    bus inv-set --dir "$BUS_DIR" --id "$INV_ID" --status running
  fi
  start_runner "$id" resume || exit 1
  echo "Resumed $id (run $((RUN + 1)))."
}

cmd_status() {
  printf '%-30s %-12s %-13s %-6s %-5s %s\n' TASK AGENT STATUS ROUND RUN REPO
  local d
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    (
      INVESTIGATION_TEAM=''   # older tasks lack it: never inherit it from the caller
      source "$d/meta.env"
      st=${STATUS:-?}
      # Remote proxies and internal investigation coordinators do not own local runner units.
      if [[ ${KIND:-worker} != remote-member && ${KIND:-worker} != investigation_team \
          && ( $st == running || $st == starting ) ]] && ! unit_active "${ID:-}" "${RUN:-0}"; then
        st="$st?"
      fi
      # an investigator of an --investigation team has no investigation number: it is shown by its name
      ag=${AGENT:-?}; [[ ${KIND:-worker} == investigation && -z $INVESTIGATION_TEAM ]] && ag="inv#${INV_ID:-?}"
      d=${d%/}
      printf '%-30s %-12s %-13s %-6s %-5s %s\n' "${ID:-${d##*/}}" "$ag" "$st" "${ROUND:--}" "${RUN:--}" "${REPO_NAME:-}"
    )
  done
}

cmd_show() {
  local id; id=$(resolve_id "${1:?usage: agent show <id>}")
  local dir="$TASKS/$id"
  meta_load "$id"
  echo "== $id"
  sed 's/^/  /' "$dir/meta.env"
  echo; echo "== task"; cat "$dir/task.md"
  if ((ROUND > 0)); then echo; echo "== questions (round $ROUND): $dir/questions-$ROUND.md"; fi
  local last=""
  [[ -f $dir/final.md ]] && last=$(<"$dir/final.md")
  if [[ ${KIND:-worker} == worker ]]; then
    local invs; invs=$(try inv_list_failed bus inv-list --dir "$BUS_DIR" --task "$id")
    if [[ -n $invs ]]; then echo; echo "== investigations"; printf '%s\n' "$invs"; fi
  elif is_independent_investigation "$id"; then
    echo; echo "== investigation team $(task_field "$id" INVESTIGATION_TEAM) (phase $(investigation_field "$id" INVESTIGATION_PHASE))"
    [[ -s $dir/result.md ]] && echo "   result: $dir/result.md"
  else
    echo; echo "== investigation #$INV_ID for $FROM_AGENT (task $PARENT_TASK)"
    [[ -s $dir/result.md ]] && echo "   result: $dir/result.md"
  fi
  if [[ -n $last ]]; then echo; echo "== the agent's last message"; printf '%s\n' "$last"; fi
  if [[ -f $WORKTREE/.agents/reports/$id.md ]]; then
    echo; echo "== report: $WORKTREE/.agents/reports/$id.md"
  fi
}

# render_log — renders log lines readably: structured records (JSON with an "event") become
# "HH:MM:SS LEVEL event key=value ...", any other line (output of git, the CLIs, tail headers) passes unchanged.
render_log() {
  jq --unbuffered -Rr '. as $line | (try fromjson catch null) as $r
    | if ($r | type) == "object" and ($r | has("event")) then
        "\(($r.ts // "")[11:19]) \(($r.level // "info") | ascii_upcase | .[0:5]) \($r.event)"
        + ([$r | to_entries[]
            | select(.key | IN("ts", "level", "event", "component", "pid", "subcommand", "task") | not)
            | select(.value != "")
            | " \(.key)=\(.value | tostring | if test("[[:space:]]") then @json else . end)"] | join(""))
      else $line end'
}

cmd_log() { # <id> [--raw] — follows the runner log of a task (structured records rendered unless --raw)
  local id; id=$(resolve_id "${1:?usage: agent log <id> [--raw]}")
  local dir="$TASKS/$id" run
  run=$(task_field "$id" RUN)
  # the error log of the current run may not exist yet; tail -F waits for it (its "cannot open" notice is noise)
  if [[ ${2:-} == --raw ]]; then
    tail -n 60 -F "$dir/runner.log" "$dir/err-$run.log" 2>/dev/null
  else
    tail -n 60 -F "$dir/runner.log" "$dir/err-$run.log" 2>/dev/null | render_log
  fi
}

stop_all() { # agent stop --running: stops everything that is active, whatever its state
  local flag="$AGENTS_HOME/.stop-all" d id st run units=() stopped=()
  : > "$flag"
  try cancel_pending_failed bus cancel-pending --dir "$BUS_DIR"
  for d in "$TASKS"/*/; do
    d=${d%/}; id=${d##*/}
    [[ -f $d/meta.env ]] || continue
    st=$(task_field "$id" STATUS)
    case $st in
      new|starting|running|waiting|investigating|sleeping|paused)
        touch "$d/stop-requested"
        meta_set "$id" STATUS stopped
        meta_set "$id" FINISHED "$(date -Is)"
        run=$(task_field "$id" RUN)
        units+=("$(unit_name "$id" "$run").service")
        stopped+=("$id ($st)") ;;
    esac
  done
  if ((${#units[@]})); then
    try unit_stop_failed systemctl --user stop "${units[@]}"
  fi
  for d in "${stopped[@]}"; do   # a runner may have overwritten the status while stopping
    id=${d%% *}
    meta_set "$id" STATUS stopped
    local team
    team=$(task_field "$id" TEAM)
    if [[ -n $team ]]; then
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$id" AGENT)" --state stopped >/dev/null
    fi
    if [[ $(task_field "$id" KIND) == investigation_team ]]; then
      investigation_team_stop "$id"
    fi
    act "$id" info "■ stopped (agent stop --running)"
  done
  rm -f "$flag"
  if ((${#stopped[@]})); then
    local n=${#stopped[@]} w=tasks
    ((n == 1)) && w=task
    log_info stop_all "stopped=$n" "tasks=${stopped[*]}"
    echo "Stopped $n $w:"
    printf '  %s\n' "${stopped[@]}"
  else
    echo "Nothing was running."
  fi
}

cmd_stop() {
  if [[ ${1:-} == --running ]]; then stop_all; return; fi
  local id; id=$(resolve_id "${1:?usage: agent stop <id> | --running}")
  local run st team agent is_job=0
  [[ -n $(task_field "$id" JOB_ID) ]] && is_job=1
  ((is_job)) && lock_task_ids
  touch "$TASKS/$id/stop-requested"
  run=$(task_field "$id" RUN); st=$(task_field "$id" STATUS)
  team=$(task_field "$id" TEAM); agent=$(task_field "$id" AGENT)
  ((is_job)) && unlock_task_ids
  try unit_stop_failed systemctl --user stop "$(unit_name "$id" "$run").service"
  meta_set "$id" STATUS stopped
  meta_set "$id" FINISHED "$(date -Is)"
  if [[ $(task_field "$id" KIND) == investigation_team ]]; then
    investigation_team_stop "$id"
  fi
  if [[ -n $team ]]; then
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$agent" --state stopped >/dev/null
    if [[ $agent == "$(team_lead "$team")" ]]; then
      finish_team "$team" "team stopped by the user"
    elif [[ $st == sleeping ]]; then
      notice member_stopped "${USER:-human}" "$(team_lead "$team")" "TEAM: member $agent was stopped by the human." "agent=$agent" "team=$team"
    fi
  fi
  log_info task_stopped "task=$id"
  echo "Stopped $id."
}

# prompt_role task — the role a task's prompt is made for (prompt_for_role): reviewer (a review: REVIEW=1, or an
# investigation's phase 3 or 5) or writer (every other run). Not task_role, which names a task's role in the token
# accounting
prompt_role() {
  local id=$1 phase
  if [[ $(task_field "$id" REVIEW) == 1 ]]; then echo reviewer; return; fi
  phase=$(task_field "$id" INVESTIGATION_PHASE)
  if [[ $(task_field "$id" KIND) == investigation && ($phase == 3 || $phase == 5) ]]; then echo reviewer; return; fi
  echo writer
}

# prompt_for_role task file mode — a run's prompt made fit for its role (prompt_role): every line naming what the role
# must not be pointed at (AGENT_WRITER_HIDE / AGENT_REVIEWER_HIDE, fixed strings) left out, and, in a new session
# (not a resumed one), the role's introduction (AGENT_WRITER_INTRO / AGENT_REVIEWER_INTRO) first. Nothing configured:
# the prompt as it was
prompt_for_role() {
  local id=$1 file=$2 mode=$3 role intro tmp removed=0 h
  local -a hide=() patterns=()
  role=$(prompt_role "$id")
  if [[ $role == reviewer ]]; then
    intro=$AGENT_REVIEWER_INTRO; hide=("${AGENT_REVIEWER_HIDE[@]}")
  else
    intro=$AGENT_WRITER_INTRO; hide=("${AGENT_WRITER_HIDE[@]}")
  fi
  [[ $mode != resume ]] || intro=""
  for h in "${hide[@]}"; do [[ -z $h ]] || patterns+=(-e "$h"); done
  [[ -n $intro || ${#patterns[@]} -gt 0 ]] || return 0
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if ! {
    [[ -z $intro ]] || printf '%s\n\n' "$intro"
    if ((${#patterns[@]})); then
      grep -vF "${patterns[@]}" "$file" || (($? == 1))   # 1: every line was left out
    else
      cat "$file"
    fi
  } > "$tmp"; then
    rm -f -- "$tmp" || log_warn prompt_role_cleanup_failed "path=$tmp"
    return 1
  fi
  if ((${#patterns[@]})); then removed=$({ grep -cF "${patterns[@]}" "$file" || (($? == 1)); }); fi
  mv -f -- "$tmp" "$file" || return 1
  log_info prompt_for_role "task=$id" "role=$role" "intro=$([[ -n $intro ]] && echo yes || echo no)" "lines_left_out=$removed"
}

# rule_allow_key task — the key the human's allowances for a task's rounds are kept under (agent allow): its team,
# or for a task of no team (an --investigation, a solo task) the task itself
rule_allow_key() {
  local team
  team=$(task_field "$1" TEAM)
  printf '%s' "${team:-$1}"
}

# rule_allow_command key human-lines — the agent allow command that lets the flagged paths pass: "- <path> — why"
# lines (a "<path>:<line>" counts as its path), each path once
rule_allow_command() {
  local key=$1 line p
  local -a allow_paths=()
  while IFS= read -r line; do
    [[ $line == "- "* ]] || continue
    p=${line#- }; p=${p%% — *}
    [[ $p =~ ^(.+):[0-9]+$ ]] && p=${BASH_REMATCH[1]}
    [[ -n $p && " ${allow_paths[*]} " != *" $p "* ]] && allow_paths+=("$p")
  done <<< "$2"
  printf 'agent allow %s' "$key"
  if ((${#allow_paths[@]})); then printf ' %q' "${allow_paths[@]}"; fi
}

# cmd_allow team|task [path...] — the human allows a team's rounds, or a task's of no team (an --investigation, a
# solo task), to change these paths against AGENTS.md's rules (an existing test, a file that judges a round): the
# precheck lets them pass. No path: the paths allowed so far
cmd_allow() {
  local team=${1:?usage: agent allow <team|task> [path...]} f what=team owner
  shift
  if [[ -z $(team_json "$team") ]]; then
    [[ -f $TASKS/$team/meta.env ]] || die "no team or task $team (see: agent status)"
    owner=$(task_field "$team" TEAM)
    [[ -z $owner ]] || die "task $team is of team $owner: its allowances are the team's — agent allow $owner <path>"
    what=task
  fi
  if (($# == 0)); then team_allowed_paths "$team"; return 0; fi
  mkdir -p "$AGENTS_HOME/allowed" || die "cannot create $AGENTS_HOME/allowed"
  for f in "$@"; do
    grep -qxF -- "$f" "$AGENTS_HOME/allowed/$team" 2> /dev/null && continue
    printf '%s\n' "$f" >> "$AGENTS_HOME/allowed/$team" || die "cannot write $AGENTS_HOME/allowed/$team"
  done
  log_info rules_allowed "team=$team" "paths=$*"
  echo "Allowed for $what $team: $*"
  if [[ $what == task && $(investigation_field "$team" INVESTIGATION_PRECHECK) == human ]]; then
    meta_set "$team" INVESTIGATION_PRECHECK ""
    meta_set "$team" INVESTIGATION_PRECHECK_ALLOW ""
    auto_stage "$team" "checks before review: again, after your allowance"
    log_info investigation_precheck_again "task=$team"
    echo "The investigation's checks run again, then its review."
    dispatch
  fi
}

# cmd_pause team — the human pauses a team: its runs are stopped at once — its members', its coordinator's, its
# workers' and investigators' — and held, not failed: they stay members of the team. Nothing of it starts until
# agent unpause; the supervisor leaves it alone. (A remote member's run, on its node, is not stopped: only its wakes.)
cmd_pause() {
  local team=${1:?usage: agent pause <team>} t st stopped=() since
  [[ -n $(team_json "$team") ]] || die "no team $team (see: agent status)"
  [[ $(team_done_flag "$team") != true ]] || die "team $team is finished: nothing to pause"
  if team_paused "$team"; then
    since=$(sed -n 's/^since=//p' "$AGENTS_HOME/paused/$team")
    echo "Team $team is paused already (since $(date -d "@${since:-0}" '+%H:%M')): agent unpause $team"
    return 0
  fi
  mkdir -p "$AGENTS_HOME/paused" || die "cannot create $AGENTS_HOME/paused"
  pause_lock || die "cannot lock $AGENTS_HOME/.pause.lock"
  printf 'since=%s\nby=%s\n' "$(date +%s)" "${USER:-human}" > "$AGENTS_HOME/paused/$team" \
    || die "cannot write $AGENTS_HOME/paused/$team"
  pause_unlock
  for t in $(team_related_tasks "$team"); do
    st=$(task_field "$t" STATUS)
    [[ $st == running || $st == starting ]] || continue
    [[ $(task_field "$t" KIND) != remote-member ]] || continue   # its member runs on its node
    touch "$TASKS/$t/hold-requested" || die "cannot mark $t for the pause"
    try unit_stop_failed systemctl --user stop "$(unit_name "$t" "$(task_field "$t" RUN)").service"
    [[ $(task_field "$t" STATUS) == held ]] || meta_set "$t" STATUS held   # no runner yet to write it
    stopped+=("$t")
  done
  log_info team_paused "team=$team" "stopped=$(IFS=,; echo "${stopped[*]}")"
  echo "Paused team $team. Stopped: ${stopped[*]:-nothing was running}. Nothing of it starts until: agent unpause $team"
}

# cmd_unpause team — the paused team goes on: the runs the pause stopped are resumed where they stopped (the same
# session, told they were paused), and the starts that waited are made
cmd_unpause() {
  local team=${1:?usage: agent unpause <team>} t mode since min resumed=() started=()
  if ! team_paused "$team"; then
    echo "Team $team is not paused."
    return 0
  fi
  since=$(sed -n 's/^since=//p' "$AGENTS_HOME/paused/$team")
  min=$(( ($(date +%s) - ${since:-$(date +%s)}) / 60 ))
  local -a starts=()   # "task mode" — collected under the lock, with the pause lifted: no start falls between
  pause_lock || die "cannot lock $AGENTS_HOME/.pause.lock"
  rm -f "$AGENTS_HOME/paused/$team" || { pause_unlock; die "cannot remove the pause of team $team"; }
  for t in $(team_related_tasks "$team"); do
    mode=$(task_field "$t" HOLD_START)
    if [[ -n $mode ]]; then   # a start that waited — or a run paused before it got going: in its own mode
      rm -f "$TASKS/$t/hold-requested"
      meta_set "$t" HOLD_START ""
      starts+=("$t $mode")
      started+=("$t")
    elif [[ -f $TASKS/$t/hold-requested || $(task_field "$t" STATUS) == held ]]; then   # stopped by the pause
      rm -f "$TASKS/$t/hold-requested"
      meta_set "$t" UNPAUSE_PENDING "$min"
      starts+=("$t resume")
      resumed+=("$t")
    fi
  done
  pause_unlock
  for t in "${starts[@]}"; do
    start_runner "${t%% *}" "${t#* }" || log_error runner_start_failed "task=${t%% *}" "reason=agent unpause"
  done
  log_info team_unpaused "team=$team" "minutes=$min" "resumed=$(IFS=,; echo "${resumed[*]}")" \
    "started=$(IFS=,; echo "${started[*]}")"
  dispatch
  dispatch_helpers
  echo "Unpaused team $team after $min min. Resumed: ${resumed[*]:-none}. Started: ${started[*]:-none}."
}

cmd_clean() {
  local id; id=$(resolve_id "${1:?usage: agent clean <id>}")
  meta_load "$id"
  [[ $STATUS != running && $STATUS != starting ]] || die "task $id is still running (agent stop $id)"
  if [[ -d $WORKTREE ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKTREE"
    echo "Removed worktree $WORKTREE (branch $BRANCH is kept)."
  else
    echo "The worktree no longer exists."
  fi
}

cmd_agents() {
  local a busy
  for a in "${!AGENT_TYPE[@]}"; do
    if busy=$(agent_running_task "$a"); then busy="busy: $busy"; else busy="free"; fi
    printf '%-12s %-7s model=%-24s %s\n' "$a" "${AGENT_TYPE[$a]}" "${AGENT_MODEL[$a]:-default}" "$busy"
  done
  local inv
  while read -r inv; do
    printf '%-12s %-7s model=%-24s investigator\n' "$inv" "${INVESTIGATORS_TYPE[$inv]}" "${INVESTIGATORS_MODEL[$inv]:-default}"
  done < <(investigator_names)
  bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" | head -1
}

cmd_inv() { # [number] — the queue, or the full record of one investigation
  if [[ -z ${1:-} ]]; then
    bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS"
    echo
    echo "All: agent inv --all   |   details: agent inv <number>"
  elif [[ $1 == --all ]]; then
    bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --all
  else
    local f; f=$(bus inv-get --dir "$BUS_DIR" --id "${1#\#}" | jq -r .file)
    cat "$f"
  fi
}

cmd_dispatch() { dispatch; bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS"; }

cmd_live() {
  local remind=$LIVE_REMIND_MIN feed=()
  while (($#)); do
    case $1 in
      --remind) remind=${2:?give a number of minutes}; shift ;;
      --feed)   feed+=(--feed) ;;
      --light)  feed+=(--light) ;;
      *) die "usage: agent live [--feed] [--remind MINUTES] [--light]" ;;
    esac
    shift
  done
  [[ -x $AGENTLIVE_BIN ]] || die "$AGENTLIVE_BIN not found — run ./install.sh again"
  [[ -z $LEAD_LISTEN ]] || feed+=(--remote-controls)
  exec "$AGENTLIVE_BIN" --home "$AGENTS_HOME" --bus "$BUS_DIR" --agent "$SELF" \
    --remind "$remind" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" "${feed[@]}"
}

member_out() { # id reason [coordinator] — a team member is out of the team's work: its board items go back (with their progress
  # notes) and the coordinator and the normal members hear who, why, which items and where its work is
  local id=$1 why=$2 team agent branch wt released head="" nm text
  team=$(task_field "$id" TEAM)
  [[ -n $team ]] || return 0
  agent=$(task_field "$id" AGENT); branch=$(task_field "$id" BRANCH); wt=$(task_field "$id" WORKTREE)
  released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$agent" | paste -sd,)
  if [[ -d $wt ]]; then
    head=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null) || head=""   # no commit yet: no head to name
  fi
  text="MEMBER $agent IS OUT: $why.${released:+ Its items ($released) are back on the board with its progress notes — take them over.} Its work is on branch $branch${head:+ at $head}: continue from there (merge it) unless its notes say the approach failed."
  if [[ -n ${3:-} ]]; then   # its role already handed over (coordinator_takeover)
    text="COORDINATOR $agent IS OUT: $why. $3 coordinates the team now: wait for its assignment (sleep if you have nothing to do).${released:+ Its items ($released) are back on the board.}"
  elif [[ $agent == "$(team_lead "$team")" ]]; then
    text="COORDINATOR $agent IS OUT: $why. Normal model: take over coordination (claim_lead), read the last checkpoint, the board and the PR, and continue.${released:+ Its items ($released) are back on the board.} Its integrated work is on branch $branch${head:+ at $head} — the PR's branch."
  fi
  for nm in $(bus team-get --dir "$BUS_DIR" --team "$team" | jq -r --arg a "$agent" '.members[] | select(.agent != $a and .tier != "worker" and (.state == "active" or .state == "sleeping" or .state == "waking")) | .agent'); do
    notice member_out agentbus "$nm" "$text" "agent=$agent" "team=$team" "released=$released"
  done
  log_warn member_out "task=$id" "team=$team" "released=$released" "reason=${why:0:200}"
}

# supervise_deferred_wakes — a wake that an --investigation held back (WAKE_DEFERRED, cmd__wake) runs again once no
# investigation blocks its task any more: the bus wakes a sleeping member once per message, so a wake dropped here
# would leave its team waiting. A task the human stopped since loses its deferred wake
supervise_deferred_wakes() {
  local m id
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    id=${m%/meta.env}; id=${id##*/}
    [[ $(task_field "$id" WAKE_DEFERRED) == 1 ]] || continue
    task_held "$id" && continue   # its team is paused by the human: replayed after agent unpause
    if ! automation_allowed "$id"; then meta_set "$id" WAKE_DEFERRED ""; continue; fi
    if blocking_investigation "$id" >/dev/null; then continue; fi   # still in progress: the next tick looks again
    log_info wake_replayed "task=$id"
    try wake_replay_failed "$SELF" _wake "$id"
  done
}

cmd__supervise() { # (a systemd timer) ends the tasks whose runner died: running or starting, but no unit is active —
  # unless their machine restarted under the run (restart_interrupted)
  local d id st run rb kind phase1_pending=0
  supervise_answer_watches   # watches of answers nobody waits for any more
  supervise_remote_questions
  supervise_deferred_wakes
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    id=${d%/}; id=${id##*/}
    st=$(task_field "$id" STATUS)
    kind=$(task_field "$id" KIND)
    if [[ $kind == investigation_team ]]; then
      # A coordinator has no runner; the timer also retries cohorts after quota expiry without a runner exit.
      if [[ $st == new || $st == running || $(investigation_field "$id" INVESTIGATION_HANDOFF_PENDING) == 1 || $(investigation_field "$id" INVESTIGATION_LEASE) == 1 ]] \
          || investigation_completed_wait "$id"; then phase1_pending=1; fi
      continue
    fi
    [[ $st == running || $st == starting ]] || continue
    # a remote member's proxy task has no local unit: its member runs on its node, followed through its heartbeat
    [[ $(task_field "$id" KIND) != remote-member ]] || continue
    (($(date +%s) - $(stat -c %Y "$d/meta.env") >= AGENT_SUPERVISE_GRACE_SEC)) || continue   # a fresh run: its unit may come
    run=$(task_field "$id" RUN)
    systemctl --user is-active --quiet "$(unit_name "$id" "$run").service" && continue   # inactive is the case looked for
    rb=$(task_field "$id" RUN_BOOT)
    if [[ -n $rb && $rb != "$(boot_id)" ]]; then   # its machine restarted under the run: not a dead runner
      restart_interrupted "$id"
      continue
    fi
    meta_set "$id" STATUS failed
    act "$id" err "✗ the runner died (no running unit) — the task is ended"
    log_warn runner_died "task=$id" "run=$run"
    if [[ -n $(task_field "$id" TEAM) ]]; then
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$(task_field "$id" TEAM)" --agent "$(task_field "$id" AGENT)" --state done >/dev/null
      member_out "$id" "its runner died (no running unit)"
    fi
    if ! is_independent_investigation "$id"; then
      notify "$id" failed "" "the runner died (no running unit) — the task is ended"
    fi
  done
  supervise_member_jobs
  supervise_teams
  supervise_merged_rounds
  supervise_failovers
  supervise_board
  supervise_handbacks
  supervise_review_waits
  if ((phase1_pending)) || review_rotation_waits; then dispatch; fi
}

# review_rotation_waits — 0 when a review pair may wait for a busy investigator (AGENT_REVIEW_DRAW=rotate: any pending
# pair; random and list: one whose PR's last pair has reviewed it): the timer's dispatch starts it once its busy
# investigator is free or (one of the last two pairs) AGENT_REVIEW_ROTATE_WAIT_MIN has passed, with no run ending to
# dispatch it
review_rotation_waits() {
  local m id
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    grep -qx 'REVIEW_PAIR_PENDING=1' "$m" || continue
    [[ $AGENT_REVIEW_DRAW != rotate ]] || return 0
    id=${m%/meta.env}; id=${id##*/}
    if review_pair_reviewed "$AGENTS_HOME/reviews/$(task_field "$id" REPO_NAME)-$(task_field "$id" PR_NUMBER)"; then return 0; fi
  done
  return 1
}

supervise_member_jobs() { # the lead: a remote member's job whose team is closed or unknown to the bus is cancelled
  # (and its grant revoked) — whatever way its team ended without it
  [[ -n ${LEAD_LISTEN:-} && -f $BUS_DIR/jobs.json ]] || return 0
  local job team member out
  while IFS=$'\t' read -r job team member; do
    [[ -n $job ]] || continue
    if bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null 2>&1 && [[ $(team_done_flag "$team") != true ]]; then
      continue   # its team goes on (a team the bus does not know fails team-get: it does not go on)
    fi
    if out=$("$SELF" jobs --cancel "$job" 2>&1); then
      log_warn member_job_orphaned "job=$job" "team=$team" "member=$member"
    else
      log_warn member_job_cancel_failed "job=$job" "team=$team" "reason=${out:0:300}"
    fi
    bus lead-member --dir "$BUS_DIR" --remove --member "$member" >/dev/null 2>&1 \
      || log_info member_grant_already_gone "member=$member"   # revoked when its team finished, or never granted
  done < <(jq -r '.Jobs[] | select((.Request.Team // "") != "" and (.State | IN("queued", "assigned", "running", "waiting")))
                  | [.Request.ID, .Request.Team, .Request.Member] | @tsv' "$BUS_DIR/jobs.json")
}

# team_pr_task team — the task of the team that holds its round's PR: the one that opened it (PR_NUMBER), else one
# that carries it from the round before (ROUND_PR); the bus need not know the coordinator yet
team_pr_task() {
  local m first=""
  for m in "$TASKS"/*/meta.env; do
    grep -qx "TEAM=$1" "$m" 2> /dev/null || continue
    if grep -q '^PR_NUMBER=.' "$m"; then basename "$(dirname "$m")"; return 0; fi
    [[ -n $first ]] || ! grep -q '^ROUND_PR=.' "$m" || first=$(basename "$(dirname "$m")")
  done
  [[ -z $first ]] || echo "$first"
}

# pr_merged_info root number — "headRefOid headRefName baseRefName mergedAt" (tab-separated) of a merged PR: the commit
# GitHub froze it at, its branch, its base, when; empty when it is not merged or cannot be read
pr_merged_info() {
  local out
  out=$(cd "$1" && gh pr view "$2" --json state,headRefOid,headRefName,baseRefName,mergedAt 2> /dev/null) || return 0
  jq -r 'select(.state == "MERGED") | [.headRefOid, .headRefName, .baseRefName, (.mergedAt // "")] | @tsv' <<< "$out" \
    2> /dev/null || return 0
}

# supervise_merged_rounds — what still works on a round whose PR someone else merged (by hand, while its fix pass or
# its reviews went on) is stopped: the round's open team, the reviews of the PR, the coordinator last. The human is
# told once, with the commits pushed to the PR's branch after the merge (on no PR, not on its base). The autopilot's
# own merge (PR_MERGE_OWN on the coordinator's task) is left alone.
supervise_merged_rounds() {
  local m id st team lead num key info oid head base at t n after mark root
  local -A coord=() work=()
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    id=$(basename "$(dirname "$m")")
    task_held "$id" && continue   # its team is paused by the human
    st=$(task_field "$id" STATUS)
    case $st in running|starting|sleeping|waiting|paused|queued) ;; *) continue ;; esac
    lead="" team=$(task_field "$id" TEAM)
    if [[ $(task_field "$id" KIND) == investigation && $(task_field "$id" REVIEW) == 1 ]]; then
      lead=$(task_field "$id" PARENT_TASK)                          # a review: its PR is its coordinator's
    elif [[ -n $team ]] && ! grep -qx 'REMOTE_TEAM=1' "$m"; then
      lead=$(team_pr_task "$team")                                  # a member: its team's round PR
    fi
    [[ -n $lead && -f $TASKS/$lead/meta.env ]] || continue
    num=$(task_field "$lead" PR_NUMBER); num=${num:-$(task_field "$lead" ROUND_PR)}
    [[ -n $num && $(task_field "$lead" PR_MERGE_OWN) != 1 ]] || continue
    key="$(task_field "$lead" REPO_ROOT)|$num"
    coord[$key]=$lead
    [[ $id == "$lead" ]] || work[$key]+="$id "
  done
  for key in "${!coord[@]}"; do
    root=${key%|*} num=${key##*|} lead=${coord[$key]}
    info=$(pr_merged_info "$root" "$num")
    [[ -n $info ]] || continue
    IFS=$'\t' read -r oid head base at <<< "$info"
    n=0
    for t in ${work[$key]:-} "$lead"; do   # the coordinator last: stopping it closes its team
      case $(task_field "$t" STATUS) in running|starting|sleeping|waiting|paused|queued) ;; *) continue ;; esac
      if "$SELF" stop "$t" > /dev/null 2>&1; then n=$((n + 1)); else log_warn merged_round_stop_failed "task=$t" "pr=$num"; fi
    done
    mark="$BUS_DIR/merged-elsewhere/$(basename "$root")-$num"
    [[ ! -e $mark ]] || continue   # reported already
    mkdir -p "${mark%/*}" && : > "$mark" || log_warn merged_round_mark_failed "mark=$mark"
    git -C "$root" fetch -q origin "$head" 10>&- || log_warn merged_round_fetch_failed "task=$lead" "branch=$head"
    after=$(git -C "$root" log --format='%h %s' "$oid..origin/$head" 2> /dev/null | head -n 10)
    log_warn round_pr_merged_elsewhere "task=$lead" "pr=$num" "merged_at=$at" "stopped=$n" \
      "after=$(grep -c . <<< "$after" || true)"
    auto_stage "$lead" "⏸ waits for you: PR #$num was merged while its round went on — stopped"
    notify "$lead" stopped "" "⛔ PR #$num was merged (${at:-just now}) while its round went on: $n task(s) of it stopped. $(
      if [[ -n $after ]]; then printf 'Commits pushed to %s after the merge — on no PR, not on %s:\n%s' "$head" "$base" "$after"
      else printf 'Nothing was pushed to %s after the merge.' "$head"; fi)"
  done
}

supervise_teams() { # an open team with no local member at work or asleep for AGENT_TEAM_ABANDON_MIN is reported to the
  # human, once: it waits for a resume (a coordinator's failure keeps a team open) or to be closed — never by itself
  local m team t alive last tm mark first
  local -A seen=()
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    team=$(sed -n 's/^TEAM=//p' "$m")
    [[ -n $team && -z ${seen[$team]:-} ]] || continue
    seen[$team]=1
    grep -qx 'REMOTE_TEAM=1' "$m" && continue                 # a remote member's task: its team lives on the lead
    team_paused "$team" && continue                            # paused by the human: not abandoned
    [[ $(team_done_flag "$team") == false ]] || continue        # closed, or unknown to the bus
    mark="$BUS_DIR/abandoned-teams/$team"
    [[ ! -e $mark ]] || continue                                # reported already
    alive=0 last=0 first=""
    for t in $(team_tasks "$team"); do
      [[ $(task_field "$t" KIND) != remote-member ]] || continue
      [[ -n $first ]] || first=$t
      case $(task_field "$t" STATUS) in
        new|starting|running|sleeping|waiting|paused|investigating|interrupted) alive=1 ;;
      esac
      tm=$(stat -c %Y "$TASKS/$t/meta.env")
      ((tm <= last)) || last=$tm
    done
    ((alive == 0)) && [[ -n $first ]] || continue
    (($(date +%s) - last >= AGENT_TEAM_ABANDON_MIN * 60)) || continue
    log_warn team_abandoned "team=$team"
    notify "$first" abandoned "" "team $team has no local member at work or asleep. Resume it: agent run --resume $team \"…\" — or close it: agent team $team --close"
    mkdir -p "${mark%/*}"
    : > "$mark"   # after the notification: one that failed is sent again at the next run
  done
}

remote_member_task() { # member task team base main-root ts [resuming [round]] — a remote member's proxy task on the lead (no worktree, no
  # runner: the member runs on its node); checks first that this is a lead, the node is online with the agent free,
  # and the base is on origin (the node starts from there). Prints the task ID.
  local member=$1 task=$2 team=$3 base=$4 root=$5 ts=$6 resuming=${7:-} round=${8:-?} agent node nodes row tier sha id
  agent=${member%@*}; node=${member#*@}
  [[ -n ${LEAD_LISTEN:-} ]] || die "remote member $member: this installation is not a lead (LEAD_LISTEN)"
  nodes=$(bus node-request --url "$(lead_url)" --path /v1/nodes --get) || die "remote member $member: cannot list the nodes"
  row=$(jq -c --arg n "$node" '.[] | select(.Node == $n)' <<< "$nodes")
  [[ -n $row ]] || die "remote member $member: no node $node (agent nodes)"
  [[ $(jq -r '.Offline // false' <<< "$row") != true ]] || die "remote member $member: node $node is offline"
  tier=$(jq -r --arg a "$agent" '.FreeAgents // [] | .[] | select(.Name == $a) | .Tier' <<< "$row")
  [[ -n $tier ]] || die "remote member $member: $agent is not a free agent of $node (agent nodes)"
  git -C "$root" fetch -q origin "$base" 10>&- || die "remote member $member: cannot fetch $base from origin"
  # a new team's members start from one commit; a member coming back on a resume continues its round, whatever the
  # lead's own checkout holds just now
  if [[ -z $resuming ]]; then
    remote_start_check "$root" "$base" || die "remote member $member starts from origin: push $base first (git push origin $base)"
    sha=$(git -C "$root" rev-parse HEAD 10>&-)
  else
    sha=$(git -C "$root" rev-parse "origin/$base" 10>&-) || die "remote member $member: no origin/$base to come back from"
  fi
  id="$ts-$agent-at-$node"
  mkdir -p "$TASKS/$id"
  : > "$TASKS/$id/meta.env"
  meta_set "$id" ID "$id"; meta_set "$id" AGENT "$member"; meta_set "$id" KIND remote-member
  meta_set "$id" REMOTE_NODE "$node"; meta_set "$id" REMOTE_AGENT "$agent"; meta_set "$id" TEAM "$team"
  meta_set "$id" TIER "$tier"; meta_set "$id" STATUS remote; meta_set "$id" CREATED "$(date -Is)"
  meta_set "$id" ROUND 0; meta_set "$id" ROUND_ID "$round"; meta_set "$id" RUN 0   # what every task has (agent status reads them)
  meta_set "$id" REPO_NAME "$(basename "$root")"; meta_set "$id" REPO_ROOT "$root"
  meta_set "$id" BASE "$base"; meta_set "$id" BASE_SHA "$sha"; meta_set "$id" BRANCH ""; meta_set "$id" WORKTREE ""
  meta_set "$id" JOB_ID "member-$id"
  printf '%s\n' "$task" > "$TASKS/$id/task.md"
  act "$id" info "remote member $member: it works on $node, in team $team"
  printf '%s' "$id"
}

node_stop_doorbell() { # the node daemon ends: so does its doorbell (a coprocess would outlive it)
  if [[ -n ${DOORBELL_PID:-} ]]; then
    kill "$DOORBELL_PID" 2>/dev/null || log_info node_doorbell_already_gone   # it may have ended by itself
  fi
}

boot_id() { # this machine's boot ID (another after each restart); AGENT_BOOT_ID_FILE in tests
  local f=${AGENT_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}
  if [[ -r $f ]]; then cat "$f"; fi   # none where the system has no boot ID: restarts are not told apart then
}

restart_interrupted() { # id — a run its machine's restart interrupted: the task goes on, told what happened (a local
  # task or a job's at once; a remote team member when its lead wakes it), up to AGENT_RESTART_MAX restarts
  local id=$1 n note
  n=$(task_field "$id" RESTARTS); n=$(( ${n:-0} + 1 ))
  meta_set "$id" RESTARTS "$n"
  if (( n > AGENT_RESTART_MAX )); then
    note="its machine restarted $n times during this task (AGENT_RESTART_MAX=$AGENT_RESTART_MAX)"
    meta_set "$id" STATUS failed
    meta_set "$id" NOTE "$note"
    act "$id" err "✗ $note — the task is ended"
    log_warn restart_limit "task=$id" "restarts=$n"
    if [[ -n $(task_field "$id" TEAM) && $(task_field "$id" REMOTE_TEAM) != 1 ]]; then
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$(task_field "$id" TEAM)" --agent "$(task_field "$id" AGENT)" --state done >/dev/null
      member_out "$id" "$note"
    fi
    if ! is_independent_investigation "$id"; then
      notify "$id" failed "" "$note"
    fi
    return 0
  fi
  meta_set "$id" STATUS interrupted
  meta_set "$id" RESTART_PENDING "$(date '+%H:%M')"
  meta_set "$id" NOTE "interrupted by a restart of its machine ($n/$AGENT_RESTART_MAX)"
  act "$id" info "↻ interrupted by a restart of the machine ($n/$AGENT_RESTART_MAX)"
  log_warn run_interrupted_by_restart "task=$id" "restarts=$n"
  [[ $(task_field "$id" REMOTE_TEAM) != 1 ]] || return 0   # its lead decides, and wakes it (memberActivity)
  start_runner "$id" resume || log_error resume_failed "task=$id" "reason=after a restart of its machine"
}

cmd__remote_member() { # proxy status branch note — a remote member's change, handed over by the lead's bus: the
  # proxy task's status (what the team's checks read), then the team's logic for it, as after a local member's run
  local id status=${2:?} branch=${3:-} note=${4:-}
  id=$(resolve_id "${1:?}")
  meta_load "$id"
  [[ ${KIND:-} == remote-member ]] || die "task $id is not a remote member's proxy task"
  case $status in
    sleeping|running|paused|done|failed|stopped) ;;
    out) status=failed ;;   # its node was away longer than the grace: out of its team, as a failed member
    *) die "unknown remote member status: $status" ;;
  esac
  [[ -z $branch ]] || meta_set "$id" BRANCH "$branch"
  [[ -z $note ]] || meta_set "$id" NOTE "$note"   # what it stopped or ended on, for the dashboard
  meta_set "$id" STATUS "$status"
  case $status in done|failed|stopped) meta_set "$id" FINISHED "$(date -Is)" ;; esac
  act "$id" info "remote member $AGENT: $status${note:+ — ${note:0:200}}"
  log_info remote_member_status "task=$id" "member=$AGENT" "status=$status"
  if [[ $status == paused ]]; then   # on its node, until its timer resumes it: the human and its team hear why, until when
    meta_set "$id" PAUSE_REASON "$(pause_reason_from_note "$note")"
    meta_set "$id" WAKE_AT "$(pause_until_from_note "$note")"
    notify "$id" paused "" "remote member $AGENT${note:+: ${note:0:300}}"
    meta_load "$id"
    team_after_run "$id" paused "$note" "$note"   # as a local member's pause: the coordinator's notice; a long one frees its items
    return 0
  fi
  if [[ $status == running ]]; then   # at work again (after a pause too): active in its team
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state active > /dev/null
    return 0
  fi
  [[ $status != running ]] || return 0
  meta_load "$id"   # BRANCH for member_out
  team_after_run "$id" "$status" "$note" "$note"
}

remote_agent_wait_free() { # member seconds — waits until the node offers the member's agent as free again
  local agent=${1%@*} node=${1#*@} i
  for ((i = 0; i < $2; i++)); do
    if bus node-request --url "$(lead_url)" --path /v1/nodes --get | jq -e --arg n "$node" --arg a "$agent" \
         '.[] | select(.Node == $n) | .FreeAgents // [] | .[] | select(.Name == $a)' >/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

RESUME_NEW_IDS=()           # the tasks a resume in progress has made (removed again if it fails)
declare -A RESUME_NEW_WT=() # their worktrees, by task

resume_abandon() { # [status command] a resume that failed: its new tasks go — changes it carried are committed (WIP) on
  # their branch, their worktrees and task files removed, its remote members' jobs and grants ended — so nothing
  # half-made blocks the branches or --last-team
  local id wt name status=${1:-} cmd=${2:-}
  ((${#RESUME_NEW_IDS[@]})) || return 0
  for id in "${RESUME_NEW_IDS[@]}"; do
    name=${id#*-}; name=${name#*-}   # <date>-<time>-<agent>
    if [[ -f $TASKS/$id/meta.env && $(task_field "$id" KIND) == remote-member ]]; then
      "$SELF" jobs --cancel "$(task_field "$id" JOB_ID)" >/dev/null 2>&1 \
        || log_info remote_member_cancel_skipped "task=$id"   # its job may not have been submitted yet
      bus lead-member --dir "$BUS_DIR" --remove --member "$(task_field "$id" AGENT)" >/dev/null 2>&1 \
        || log_info remote_member_revoke_skipped "task=$id"   # nor granted
    fi
    wt=${RESUME_NEW_WT[$id]:-}
    if [[ -n $wt && -d $wt ]]; then
      if [[ -n $(git -C "$wt" status --porcelain) ]]; then
        { git -C "$wt" add -A &&
          GIT_AUTHOR_NAME="$name (team-agents)" GIT_AUTHOR_EMAIL="$name@team-agents.invalid" \
          GIT_COMMITTER_NAME="$name (team-agents)" GIT_COMMITTER_EMAIL="$name@team-agents.invalid" \
            git -C "$wt" commit -q -m "WIP: uncommitted work carried by an interrupted resume"; } \
          || log_warn resume_wip_commit_failed "task=$id" "worktree=$wt"
      fi
      git -C "$wt" worktree remove --force "$wt" || log_warn resume_worktree_remove_failed "task=$id" "worktree=$wt"
    fi
    rm -rf "${TASKS:?}/$id"
  done
  log_warn resume_abandoned "tasks=${RESUME_NEW_IDS[*]}" "status=$status" "command=${cmd:0:300}"
  echo "agent: the resume failed — its new tasks were removed; changes it carried are committed (WIP) on their branches" >&2
}

remote_member_start() { # proxy-task — grants the remote member on the lead and submits the job that runs it on its
  # node (its tools reach the team through the relay; its task text is the team's)
  local id=$1 member agent node body out
  member=$(task_field "$id" AGENT); agent=$(task_field "$id" REMOTE_AGENT); node=$(task_field "$id" REMOTE_NODE)
  bus lead-member --dir "$BUS_DIR" --add --member "$member" --agent "$agent" --node "$node" --team "$(task_field "$id" TEAM)" \
    --task "$id" --tier "$(task_field "$id" TIER)" --repo "$(task_field "$id" REPO_NAME)" --job "$(task_field "$id" JOB_ID)" >/dev/null \
    || { log_error remote_member_grant_failed "member=$member"; return 1; }
  body=$(jq -n --arg id "$(task_field "$id" JOB_ID)" --arg repo "$(task_field "$id" REPO_NAME)" --arg base "$(task_field "$id" BASE)" \
    --arg sha "$(task_field "$id" BASE_SHA)" --arg agent "$agent" --arg node "$node" --rawfile task "$TASKS/$id/task.md" \
    --arg team "$(task_field "$id" TEAM)" --arg member "$member" --arg repo_url "$(github_repo_url "$(task_field "$id" REPO_ROOT)")" \
    '{ID:$id, Repository:$repo, BaseRef:$base, BaseSHA:$sha, Selector:$agent, Target:$node, Task:$task, Requester:"human", Team:$team, Member:$member, RepoURL:$repo_url, RequesterTask:""}')
  if ! out=$(printf '%s' "$body" | bus node-request --url "$(lead_url)" --path /v1/jobs); then
    log_error remote_member_job_failed "member=$member" "reason=${out:0:300}"
    return 1
  fi
  meta_set "$id" STATUS remote
  log_info remote_member_started "member=$member" "task=$id" "job=$(task_field "$id" JOB_ID)"
}

# runs_usage task — per run of the task, from its activity: run steps(tool calls) in cached out cost mode (tab-separated;
# mode: new, resume or fresh)
runs_usage() {
  local id=$1
  [[ -f $TASKS/$id/activity.jsonl ]] || return 0   # an investigation team's parent has none of its own
  jq -rn --arg cli "$(task_field "$id" TYPE)" '
    reduce inputs as $l ({run: 0, rows: {}, prev: {in: 0, cached: 0, out: 0}};
      ($l.t // "") as $t
      | if $l.k == "info" and ($t | test("^▶ run [0-9]+")) then
          ($t | capture("^▶ run (?<n>[0-9]+)( \\((?<m>[a-z]+))?")) as $c
          | .run = ($c.n | tonumber) | .modes[$c.n] = ($c.m // "?")
          | if ($t | test("\\(resume\\)")) then . else .prev = {in: 0, cached: 0, out: 0} end   # a new session: from zero
        elif $l.k == "info" then
          ((($t | capture("^usage: in (?<in>[0-9]+) \\(cached (?<cached>[0-9]+)\\), out (?<out>[0-9]+)(, cost \\$(?<cost>[0-9.]+))?"))
            // ($t | capture("tokens in/out (?<in>[0-9]+)/(?<out>[0-9]+), cost \\$(?<cost>[0-9.]+)")) // null) as $u
          | if $u == null then . else
              {in: ($u.in | tonumber), cached: (($u.cached // "0") | tonumber), out: ($u.out | tonumber)} as $v
              | (if $cli == "codex" and $v.in >= .prev.in   # codex: the session so far — this run is the difference
                 then {in: ($v.in - .prev.in), cached: ($v.cached - .prev.cached), out: ($v.out - .prev.out)}
                 else $v end) as $d
              | .prev = (if $cli == "codex" then $v else .prev end)
              | .rows[.run | tostring] |= ((. // {steps: 0, in: 0, cached: 0, out: 0, cost: 0})
                | .in += $d.in | .cached += $d.cached | .out += $d.out | .cost += (($u.cost // "0") | tonumber))
            end)
        elif ($l.k == "text" or $l.k == "err") then .
        else .rows[.run | tostring] |= ((. // {steps: 0, in: 0, cached: 0, out: 0, cost: 0}) | .steps += 1)
        end)
    | .modes as $modes | .rows | to_entries | sort_by(.key | tonumber) | .[]
    | [.key, .value.steps, .value.in, .value.cached, .value.out, .value.cost, ($modes[.key] // "?")] | @tsv' \
    "$TASKS/$id/activity.jsonl"
}

# worktree_stash worktree message task — the worktree's uncommitted changes (untracked files too) to the stash; when git
# refuses them as they are — a file added with --intent-to-add: "Entry … not uptodate. Cannot merge" — they are
# staged and stashed again (resume_stash_retry). Prints git's refusal when it still refuses.
worktree_stash() {
  local wt=$1 msg=$2 task=$3 err
  err=$(git -C "$wt" stash push --include-untracked --quiet -m "$msg" 2>&1 10>&-) && return 0
  log_warn resume_stash_retry "task=$task" "error=${err:0:300}"
  if ! err=$(git -C "$wt" add -A 2>&1 10>&-) || ! err=$(git -C "$wt" stash push --include-untracked --quiet -m "$msg" 2>&1 10>&-); then
    printf '%s' "$(head -n 2 <<< "$err" | tr '\n' ' ' | cut -c1-200)"
    return 1
  fi
}

# The marks of a task's text that is for one round only (its heading, what its checks and reviews sent back): the
# next round's text leaves it out (round_text_strip).
ROUND_ONLY_OPEN="<!-- round only: left out of the next round -->"
ROUND_ONLY_CLOSE="<!-- /round only -->"

# round_text_strip — a task's text (stdin) without what was for its round only
round_text_strip() {
  awk -v op="$ROUND_ONLY_OPEN" -v cl="$ROUND_ONLY_CLOSE" '$0 == op {skip = 1; next} $0 == cl {skip = 0; next} !skip'
}

# round_text_restate heads notes — the task's text without the round-only blocks a resume of the same round writes
# anew, as only the newest is true (a PR merged since, the round number moved on): its heading ("## Round …") when
# heads=1, its PR note ("## The round's PR") when notes=1, each with the blank lines before it. What the checks and
# the reviews sent back stays, as does everything outside the round-only marks
round_text_restate() {
  awk -v op="$ROUND_ONLY_OPEN" -v cl="$ROUND_ONLY_CLOSE" -v heads="${1:-0}" -v notes="${2:-0}" -v pr="## The round's PR" '
    function flush() { while (blank > 0) { print ""; blank-- } }
    !inb && $0 == "" { blank++; next }
    !inb && $0 == op { inb = 1; pre = blank; blank = 0; buf = $0 ORS; head = ""; next }
    inb && $0 == cl {
      inb = 0; buf = buf $0 ORS
      if ((heads == 1 && head ~ /^## Round [0-9]/) || (notes == 1 && head == pr)) next
      while (pre > 0) { print ""; pre-- }
      printf "%s", buf; next
    }
    inb { buf = buf $0 ORS; if (head == "" && $0 ~ /^## /) head = $0; next }
    { flush(); print }
    END { if (inb) printf "%s", buf; flush() }'
}

# checkpoints_latest key — the key's newest AGENT_PROMPT_CHECKPOINTS checkpoints (all: 0), and where the earlier ones are
checkpoints_latest() {
  local key=$1 all n skip
  all=$(bus checkpoint-get --dir "$BUS_DIR" --key "$key") || return 1
  n=$(grep -c '^## Checkpoint ' <<< "$all") || n=0   # none: grep's "no match" is the answer
  if ((AGENT_PROMPT_CHECKPOINTS <= 0 || n <= AGENT_PROMPT_CHECKPOINTS)); then
    printf '%s\n' "$all"
    return 0
  fi
  skip=$((n - AGENT_PROMPT_CHECKPOINTS))
  printf '\n(%d earlier checkpoints are in %s — read them only if you need them)\n' "$skip" "$BUS_DIR/checkpoints/$key.md"
  awk -v skip="$skip" '/^## Checkpoint /{c++} c > skip' <<< "$all"
}

# fresh_session_due task — its next run starts a fresh session (FRESH_WHY says why): its last run was marked long, or
# read more than AGENT_FRESH_SESSION_TOKENS of context a step
# fresh_session_max cli — the context a step past which a resumed run of that CLI goes to a fresh session
# (AGENT_FRESH_SESSION_MAX), 0 when none is set for it
fresh_session_max() {
  local kv
  for kv in $AGENT_FRESH_SESSION_MAX; do
    [[ ${kv%%=*} == "$1" && ${kv#*=} =~ ^[0-9]+$ ]] && { printf '%s' "${kv#*=}"; return 0; }
  done
  printf 0
}

# member_claimed_items team agent — the board items the agent holds claimed in the team, comma-separated; none when
# the board cannot be read (logged, unless the bus does not have the team) — a reading is no reason to end a runner
member_claimed_items() {
  local board rc=0
  board=$(bus board-dump --dir "$BUS_DIR" --team "$1" 2> /dev/null) || rc=$?
  if ((rc != 0)); then
    ((rc == BUS_NOT_FOUND)) || log_warn board_read_failed "team=$1" "exit_code=$rc"
    return 0
  fi
  jq -r --arg a "$2" '.board // {} | (if type == "object" then .[] else .[] end)
    | select(.status == "claimed" and (.assignee // "") == $a) | .id' <<< "$board" | paste -sd, - \
    || log_warn board_parse_failed "team=$1"
}

fresh_session_due() {
  local id=$1 rows last lrun steps in median lmode max
  FRESH_WHY=""
  if [[ -n $(task_field "$id" DBOUNCE_PENDING) ]]; then   # a member's DONE while holding items: back with a small context
    FRESH_WHY="you ended your last run with STATUS: DONE while you hold board items ($(task_field "$id" DBOUNCE_PENDING))"
    return 0
  fi
  if [[ $(task_field "$id" SOLO_CUT) == 1 ]]; then   # ended for working alone: the work to split comes first
    meta_set "$id" SOLO_CUT ""
    FRESH_WHY="you worked alone while your members slept and your board had nothing for them, and the runner ended your run. Before anything else now, put the work on the board — items that do not overlap, each for one member (a worker for a small one), with its area, its size and when it is done — and wake each member once; implement only the items you give yourself"
    return 0
  fi
  if [[ $(task_field "$id" LONG_RUN) == 1 ]]; then
    FRESH_WHY="your last run was long, and you were asked to end it"
    return 0
  fi
  ((AGENT_FRESH_SESSION_TOKENS > 0)) || return 1
  rows=$(runs_usage "$id")
  last=$(tail -n 1 <<< "$rows")
  [[ -n $last ]] || return 1
  IFS=$'\t' read -r lrun steps in _ <<< "$last"
  ((steps > 0 && in / steps > AGENT_FRESH_SESSION_TOKENS)) || return 1
  # a CLI with a small context window: a resumed session past its ceiling goes, whatever its start (not a fresh one:
  # a session that starts past it would go fresh every run)
  lmode=$(awk -F'\t' '{print $7}' <<< "$last")
  max=$(fresh_session_max "$(task_field "$id" TYPE)")
  if [[ $lmode == resume ]] && ((max > 0 && in / steps > max)); then
    FRESH_WHY="your last run read some $((in / steps)) tokens of context a step — past the $max its CLI's context window allows before it fills"
    return 0
  fi
  # a fresh session reads much from its start: only a context grown past AGENT_FRESH_SESSION_RATIO times the median
  # of the task's other session starts (its new and fresh runs) is worth leaving
  median=$(awk -F'\t' -v last="$lrun" '$1 != last && ($7 == "new" || $7 == "fresh") && $2 > 0 && $3 > 0 {print int($3 / $2)}' \
    <<< "$rows" | sort -n | awk '{v[NR] = $1} END {if (NR) print v[int((NR + 1) / 2)]}')
  if [[ -n $median ]] && ((AGENT_FRESH_SESSION_RATIO > 0 && in / steps <= AGENT_FRESH_SESSION_RATIO * median)); then
    return 1
  fi
  FRESH_WHY="your last run read some $((in / steps)) tokens of context a step${median:+ — over $AGENT_FRESH_SESSION_RATIO times the $median of a fresh session}"
}

# coordinator_alone task — whether a team's coordinator works alone: the task coordinates its team, which has other
# members, none of them at work (running), and its board has nothing open for anyone but the coordinator
coordinator_alone() {
  local id=$1 team agent t n_others=0 open
  team=$(task_field "$id" TEAM); agent=$(task_field "$id" AGENT)
  [[ -n $team && $(team_lead "$team") == "$agent" ]] || return 1
  for t in $(grep -lx "TEAM=$team" "$TASKS"/*/meta.env 2> /dev/null | xargs -r -n1 dirname | xargs -r -n1 basename); do
    [[ $t != "$id" ]] || continue
    n_others=$((n_others + 1))
    [[ $(task_field "$t" STATUS) != running ]] || return 1
  done
  ((n_others > 0)) || return 1
  open=$(bus board-dump --dir "$BUS_DIR" --team "$team" 2> /dev/null | jq --arg me "$agent" \
    '[.board // {} | (if type == "object" then .[] else .[] end) | select(.status != "done" and (.for // "") != $me)] | length' 2> /dev/null) \
    || return 1   # the board unknown: not taken as empty
  [[ $open == 0 ]]
}

# preferred_coordinator agent… — of the agents, the first AGENT_COORDINATOR_PREFER names; nothing for none (the team
# elects its coordinator as before)
preferred_coordinator() {
  local p a
  for p in $AGENT_COORDINATOR_PREFER; do
    for a in "$@"; do
      [[ $a != "$p" ]] || { printf '%s' "$p"; return 0; }
    done
  done
}

# long_run_end task status — a run marked long (its long-run file) has ended: a team member gone to sleep is woken at
# once, and its next run starts a fresh session
long_run_end() {
  local id=$1 status=$2 f="$TASKS/$1/long-run"
  [[ -f $f ]] || return 0
  rm -f "$f"
  if [[ -f $TASKS/$id/solo-cut ]]; then rm -f "$TASKS/$id/solo-cut"; meta_set "$id" SOLO_CUT 1; fi
  [[ $status == sleeping ]] || return 0
  meta_set "$id" LONG_RUN 1
  log_info long_run_ended "task=$id"
  act "$id" info "■ a long run ended on request: the next run starts a fresh session"
  schedule_wake "$id" 5 || log_warn long_run_wake_failed "task=$id"
}

# round_card team — the round's card, one fact a line, tab-separated: "pr <number> <branch>"; "board <items> <done>
# <without an owner>"; "member <agent> <commits not in the PR> <their lines> <tokens in>" for every branch but the
# PR's; "shared <file> <agents>" for a file more than one branch changed; "workers <helpers' items>". From the tasks and
# branches the round left: a finished round too
round_card() {
  local team=$1 t f b agent pr_task root base pr_branch num items n lines tokens w=()
  local -a tasks=()
  local -A seen=()
  mapfile -t tasks < <(grep -lx "TEAM=$team" "$TASKS"/*/meta.env 2> /dev/null | xargs -r -n1 dirname | xargs -r -n1 basename)
  ((${#tasks[@]})) || return 1
  pr_task=$(team_pr_task "$team"); pr_task=${pr_task:-${tasks[0]}}
  root=$(task_field "$pr_task" REPO_ROOT); base=$(task_field "$pr_task" BASE); pr_branch=$(task_field "$pr_task" BRANCH)
  num=$(task_field "$pr_task" PR_NUMBER); num=${num:-$(task_field "$pr_task" ROUND_PR)}
  printf 'pr\t%s\t%s\n' "${num:--}" "$pr_branch"
  items=$(bus board-dump --dir "$BUS_DIR" --team "$team" 2> /dev/null | jq -r '(.board // []) | (if type == "object" then [.[]] else . end)
    | "\(length)\t\([.[] | select(.status == "done")] | length)\t\([.[] | select((.for // "") == "" and (.assignee // "") == "")] | length)"' \
    2> /dev/null) || items=""
  printf 'board\t%s\n' "${items:-?	?	?}"   # the bus may no longer know a finished team
  for t in "${tasks[@]}"; do
    case $(task_field "$t" KIND) in worker|'') ;; *) continue ;; esac
    b=$(task_field "$t" BRANCH); agent=$(task_field "$t" AGENT)
    [[ -n $b && -n $root ]] || continue
    while IFS= read -r f; do [[ -z $f ]] || seen[$f]+="$agent "; done < <(git -C "$root" diff --name-only "$base...$b" 2> /dev/null)
    [[ $b != "$pr_branch" ]] || continue
    n=$(git -C "$root" rev-list --count "$pr_branch..$b" 2> /dev/null) || n=0
    lines=$(git -C "$root" diff --shortstat "$pr_branch...$b" 2> /dev/null | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+')
    tokens=$(runs_usage "$t" 2> /dev/null | awk -F'\t' '{s += $3} END {print s + 0}')
    printf 'member\t%s\t%s\t%s\t%s\n' "$agent" "$n" "${lines:-0}" "$tokens"
  done
  for f in "${!seen[@]}"; do
    read -ra w <<< "${seen[$f]}"
    ((${#w[@]} < 2)) || printf 'shared\t%s\t%s\n' "$f" "${w[*]}"
  done
  n=0
  for t in "${tasks[@]}"; do
    n=$((n + $(grep -lx "PARENT_TASK=$t" "$TASKS"/*/meta.env 2> /dev/null | xargs -r grep -lx 'KIND=helper' | wc -l)))
  done
  printf 'workers\t%s\n' "$n"
}

# round_check_line team — the round's card in one line, for the coordinator's notification of the round
round_check_line() {
  local card lost shared workers board
  card=$(round_card "$1") || return 0
  lost=$(awk -F'\t' '$1 == "member" && $3 > 0 {printf "%s%s %s commits", (n++ ? ", " : ""), $2, $3}' <<< "$card")
  shared=$(grep -c '^shared' <<< "$card") || shared=0
  workers=$(awk -F'\t' '$1 == "workers" {print $2}' <<< "$card")
  board=$(awk -F'\t' '$1 == "board" {print $2 " items, " $3 " done, " $4 " without an owner"}' <<< "$card")
  printf '📋 round-check: board %s · not in the PR: %s · files changed by more than one branch: %s · workers'"'"' items: %s — agent round-check %s' \
    "$board" "${lost:-none}" "$shared" "$workers" "$1"
}

# cmd_round_check <team|task> — the round's card: was its work split as planned, done once, merged
cmd_round_check() {
  local ref=${1:?usage: agent round-check <team|task>} team card line
  team=$ref
  [[ ! -f $TASKS/$ref/meta.env ]] || team=$(task_field "$ref" TEAM)
  card=$(round_card "$team") || die "no task of team $team"
  echo "Round card — team $team"
  awk -F'\t' '$1 == "pr" {print "PR: " ($2 == "-" ? "none yet" : "#" $2) " (branch " $3 ")"}
    $1 == "board" {print "board: " $2 " items, " $3 " done, " $4 " without an owner"}' <<< "$card"
  echo "members' work not in the round's PR:"
  line=$(awk -F'\t' '$1 == "member" && $3 > 0 {print "  " $2 ": " $3 " commits, " $4 " lines, " $5 " tokens in"}' <<< "$card")
  echo "${line:-  none}"
  echo "files changed by more than one branch:"
  line=$(awk -F'\t' '$1 == "shared" {print "  " $2 " (" $3 ")"}' <<< "$card" | sort)
  echo "${line:-  none}"
  awk -F'\t' '$1 == "workers" {print "workers: " $2}' <<< "$card"
}

# run_days task — per run of the task, the day it started: "<run>\t<YYYY-MM-DD>", from its activity
run_days() {
  [[ -f $TASKS/$1/activity.jsonl ]] || return 0
  jq -r 'select(.k == "info" and ((.t // "") | test("^▶ run [0-9]+"))) | [(.t | capture("^▶ run (?<n>[0-9]+)").n), .ts[0:10]] | @tsv' \
    "$TASKS/$1/activity.jsonl" 2> /dev/null || log_warn run_days_failed "task=$1"
}

# task_model task — the model a task's runs used: its MODEL, else its agent's configured model, else its CLI
task_model() {
  local m agent
  m=$(task_field "$1" MODEL); agent=$(task_field "$1" AGENT)
  printf '%s' "${m:-${AGENT_MODEL[$agent]:-${INVESTIGATORS_MODEL[$agent]:-$(task_field "$1" TYPE)}}}"
}

# cmd_spend [--days N] [--daily] — where the money goes: every task's runs of the last N days (7), by model — a line a
# day and model with --daily. A model paid by the token (its CLI in AGENT_PAID_CLIS) shows what it spent: its
# provider's cost, else MODEL_PRICES'. A subscription's model shows what it would have cost at its API rates
# (MODEL_PRICES, else its CLI's own cost) as an equivalent — not money spent, but what eats its limit.
cmd_spend() {
  local days=7 daily=0 since m id type billing prices="" k usage="usage: agent spend [--days N] [--daily]"
  while (($#)); do
    case $1 in
      --days) days=${2:?$usage}; shift 2 ;;
      --daily) daily=1; shift ;;
      *) die "$usage" ;;
    esac
  done
  [[ $days =~ ^[0-9]+$ ]] || die "--days takes a number of days: $usage"
  since=$(date -d "-$days days" +%F)
  for k in "${!MODEL_PRICES[@]}"; do prices+="$k=${MODEL_PRICES[$k]};"; done
  printf '%s%-36s %-9s %-12s %5s %12s %12s %10s %10s %10s\n' "$( ((daily)) && printf '%-11s' DAY)" \
    MODEL CLI BILLING RUNS IN CACHED OUT 'SPENT$' 'EQUIV$'
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    id=$(basename "$(dirname "$m")")
    type=$(task_field "$id" TYPE)
    billing=subscription
    [[ " $AGENT_PAID_CLIS " != *" $type "* ]] || billing=paid
    join -t$'\t' <(run_days "$id" | sort -t$'\t' -k1,1) <(runs_usage "$id" | sort -t$'\t' -k1,1) \
      | awk -F'\t' -v s="$since" -v m="$(task_model "$id")" -v c="$type" -v b="$billing" \
          '$2 >= s {print $2 "\t" m "\t" c "\t" b "\t" $4 "\t" $5 "\t" $6 "\t" $7}'
  done | awk -F'\t' -v D="$daily" -v P="$prices" '
    BEGIN {n = split(P, a, ";"); for (i = 1; i <= n; i++) if (index(a[i], "=")) price[substr(a[i], 1, index(a[i], "=") - 1)] = substr(a[i], index(a[i], "=") + 1)}
    {k = (D ? $1 : "") "\t" $2; cli[k] = $3; bill[k] = $4; runs[k]++; tin[k] += $5; ca[k] += $6; out[k] += $7; cost[k] += $8}
    END {
      for (k in runs) {
        split(k, kd, "\t"); m = kd[2]; priced = -1
        if (m in price) {split(price[m], p, " "); priced = ((tin[k] - ca[k]) * p[1] + ca[k] * p[2] + out[k] * p[3]) / 1e6}
        if (bill[k] == "paid") {v = (cost[k] > 0 ? cost[k] : (priced >= 0 ? priced : 0)); sp = sprintf("%.4f", v); eq = "-"; ts += v}
        else {sp = "-"; if (priced >= 0) v = priced; else v = cost[k]; eq = (priced >= 0 || cost[k] > 0 ? sprintf("%.4f", v) : "?"); te += v}
        printf "1\t%s\t%s%-36s %-9s %-12s %5d %12d %12d %10d %10s %10s\n", k, (D ? sprintf("%-11s", kd[1]) : ""), m, cli[k], bill[k], runs[k], tin[k], ca[k], out[k], sp, eq
      }
      printf "2\t\t\t%s%-36s %-9s %-12s %5s %12s %12s %10s %10.4f %10.4f\n", (D ? sprintf("%-11s", "") : ""), "total", "", "", "", "", "", "", ts, te
    }' | sort -t$'\t' -k1,1 -k2,2 -k3,3 | cut -f4- | spend_note
}

# spend_note — agent spend's table, then the note on opencode's short usage when a row is opencode's
spend_note() {
  local table
  table=$(cat)
  printf '%s\n' "$table"
  ! grep -qE '[[:space:]]opencode[[:space:]]' <<< "$table" || echo "$OPENCODE_SHORT"
}

# debug_redact — the debug file without secrets: the values of secrets.env (six characters or more), and anything
# that looks like a GitHub, OpenAI-style, Slack or bearer token, become [redacted]
debug_redact() {
  local values
  values=$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=//p' "$AGENTS_HOME/secrets.env" 2> /dev/null \
    | sed -E "s/^\"(.*)\"\$/\\1/; s/^'(.*)'\$/\\1/" | awk 'length($0) >= 6') || values=""   # no secrets.env: nothing of it
  sed -E 's/(ghp|gho|ghs|ghu|github_pat)_[A-Za-z0-9_]{10,}/[redacted]/g; s/sk-[A-Za-z0-9_-]{16,}/[redacted]/g;
          s/xox[abpr]-[A-Za-z0-9-]{10,}/[redacted]/g; s/(Bearer )[A-Za-z0-9._~+\/-]{16,}/\1[redacted]/g' \
    | awk -v vals="$values" 'BEGIN {n = split(vals, v, "\n")}
        {for (i = 1; i <= n; i++) if (v[i] != "") while ((p = index($0, v[i])) > 0) $0 = substr($0, 1, p - 1) "[redacted]" substr($0, p + length(v[i]))
         print}'
}

# cmd_debug <team|task> [--full] [--out file] — everything to diagnose a team or a task, in one file: the team on the
# bus, its board, its worker requests, every task's metadata, activity, errors, final report and checks, the script's
# log, the bus messages, the branches, the round's PR, its card and tokens. Read-only. The last lines of each source
# by default, all of them with --full; secrets redacted (debug_redact). It prints the file and its length.
# cmd_debug_agent agent|model name days last full out — agent debug --agent / --model: a model's whole record in one
# file — a summary of its tasks of the last days (by kind and status, failures and their reasons, turns without
# STATUS, pauses, long runs cut, failovers, durations, tokens and cost), the worker requests that failed before a
# task, the results its requesters rejected (an approximation from their messages), and the details of its last
# tasks. Read-only; secrets redacted (debug_redact); archived tasks are not in it.
cmd_debug_agent() {
  local by=$1 name=$2 days=$3 last=$4 full=$5 out=$6 field=AGENT t c since total=0 failed=0 secs=0 timed=0 hid
  local -a ids=() hids=() acts=()
  [[ $by == model ]] && field=MODEL
  since=$(date -d "$days days ago" +%s) || die "--days: a number of days"
  for t in "$TASKS"/*/meta.env; do
    [[ -f $t ]] || continue
    t=$(basename "$(dirname "$t")")
    [[ $(task_field "$t" "$field") == "$name" ]] || continue
    c=$(task_field "$t" CREATED)
    [[ -z $c ]] || (($(date -d "$c" +%s 2> /dev/null || echo 0) >= since)) || continue
    ids+=("$t")
  done
  mapfile -t ids < <(for t in "${ids[@]}"; do printf '%s\t%s\n' "$(task_field "$t" CREATED)" "$t"; done | sort -r | cut -f2)
  total=${#ids[@]}
  for t in "${ids[@]}"; do acts+=("$TASKS/$t/activity.jsonl"); done
  out=${out:-$AGENTS_HOME/debug/debug-$by-${name//[^A-Za-z0-9._-]/_}-$(date +%Y%m%d-%H%M%S).txt}
  mkdir -p "$(dirname "$out")" || die "cannot create $(dirname "$out")"
  {
    set +e   # a missing or empty source is shown as such: it stops nothing
    echo "agent debug --$by $name — $(date -Is) — tasks of the last $days days$( ((full)) && echo ' — full')"
    echo; echo "== summary"
    echo "tasks: $total"
    ((total)) || echo "(none in this window: --days N widens it)"
    if [[ $by == agent ]]; then echo "models: $(for t in "${ids[@]}"; do task_field "$t" MODEL; echo; done | sort -u | paste -sd' ')"
    else echo "agents: $(for t in "${ids[@]}"; do task_field "$t" AGENT; echo; done | sort -u | paste -sd' ')"; fi
    echo "by kind and status:"
    for t in "${ids[@]}"; do echo "$(task_field "$t" KIND) $(task_field "$t" STATUS)"; done | sort | uniq -c
    for t in "${ids[@]}"; do [[ $(task_field "$t" STATUS) != failed ]] || failed=$((failed + 1)); done
    ((total == 0)) || printf 'failed: %d (%d%%)\n' "$failed" "$((100 * failed / total))"
    # the runs in which the agent did nothing — no command, edit or tool call: it answered from its prompt alone
    read -r idle runs < <(for t in "${ids[@]}"; do run_idle_counts "$t"; done | awk '{i += $1; r += $2} END {print i + 0, r + 0}')
    ((runs == 0)) || printf 'runs without an action (no command, edit or tool call): %d of %d (%d%%)\n' "$idle" "$runs" \
      "$((100 * idle / runs))"
    echo "failure reasons (the notes of the failed tasks):"
    for t in "${ids[@]}"; do
      [[ $(task_field "$t" STATUS) == failed ]] || continue
      c=$(task_field "$t" NOTE); echo "${c:-(no note)}"
    done | sort | uniq -c | sort -rn | head -n 10
    c=0
    ((total == 0)) || c=$(cat "${acts[@]}" 2> /dev/null | grep -c 'turn without STATUS')
    echo "turns without STATUS: ${c:-0}"
    local logged
    logged=$( ((total)) && grep -hF -f <(printf '"task":"%s"\n' "${ids[@]}") "$AGENTS_HOME/logs/agent.jsonl" 2> /dev/null)
    c=$(jq -r 'select(.event == "task_paused") | .reason // "?"' <<< "$logged" 2> /dev/null | sort | uniq -c | awk '{printf "%s%s %s", (NR > 1 ? ", " : ""), $1, $2}')
    echo "pauses: ${c:-none}"
    echo "long runs cut: $(jq -r 'select(.event == "long_run_cut") | .task' <<< "$logged" 2> /dev/null | grep -c .)"
    echo "failovers: $(jq -r 'select(.event == "helper_failover" or .event == "failover_done") | .task' <<< "$logged" 2> /dev/null | grep -c .)"
    for t in "${ids[@]}"; do
      c=$(task_field "$t" CREATED); local f; f=$(task_field "$t" FINISHED)
      [[ -n $c && -n $f ]] || continue
      secs=$((secs + $(date -d "$f" +%s) - $(date -d "$c" +%s))); timed=$((timed + 1))
    done
    ((timed == 0)) || echo "average duration: $((secs / timed / 60)) min ($timed tasks)"
    if ((total)); then
      local tin tcached tout tcost
      read -r tin tcached tout tcost < <(cat "${acts[@]}" 2> /dev/null | jq -rs '
        [.[] | select(.k == "info") | (.t // "") | capture("^usage: in (?<in>[0-9]+) \\(cached (?<cached>[0-9]+)\\), out (?<out>[0-9]+)(, cost \\$(?<cost>[0-9.]+))?")?]
        | [(map(.in | tonumber) | add // 0), (map(.cached | tonumber) | add // 0), (map(.out | tonumber) | add // 0),
           (map(.cost // "0" | tonumber) | add // 0)] | @tsv')
      printf 'tokens: in %d (cached %d), out %d, cost $%.4f\n' "${tin:-0}" "${tcached:-0}" "${tout:-0}" "${tcost:-0}"
    fi
    if [[ $by == agent ]]; then
      echo; echo "== worker requests that failed before a task"
      c=$(bus helper-list --dir "$BUS_DIR" --all 2> /dev/null | while IFS= read -r c; do
        [[ $c =~ ^H([0-9]+)\ \[failed\ →\ $name\] ]] || continue
        grep -qx "HELPER_ID=${BASH_REMATCH[1]}" "$TASKS"/*/meta.env 2> /dev/null || echo "${c:0:240}"
      done)
      echo "${c:-(none)}"
      # what its done results were worth, as the requesters rated them (delegation_feedback)
      echo; echo "== its results, as their requesters rated them"
      c=$(bus helper-list --dir "$BUS_DIR" --all 2> /dev/null | { grep -E "^H[0-9]+ \[done → $name\]" || (($? == 1)); } \
        | sed -E 's/^H[0-9]+ \[[^]]*\]( rated ([a-z]+))?.*/\2/; s/^$/unrated/' | sort | uniq -c \
        | awk '{ printf "%s%s %d", (NR > 1 ? ", " : ""), $2, $1 } END { if (NR) print "" }')
      echo "${c:-(none)}"
      # an honest question is no failure: counted apart (a model that asks looks worse when it is counted as one)
      echo; echo "== worker requests it answered with questions (unclear)"
      c=$(bus helper-list --dir "$BUS_DIR" --all 2> /dev/null | { grep -E "^H[0-9]+ \[unclear → $name\]" || (($? == 1)); } \
        | cut -c1-240)   # grep's 1 is "none", not a failure
      echo "${c:-(none)}"
    fi
    for t in "${ids[@]}"; do hid=$(task_field "$t" HELPER_ID); [[ -z $hid ]] || hids+=("$hid"); done
    echo; echo "== results the requesters rejected (an approximation, from their messages)"
    c=$(for hid in "${hids[@]}"; do
      grep -hE "\\bH$hid\\b" "$BUS_DIR/messages.jsonl" 2> /dev/null \
        | jq -r 'select((.text // "") | test("reject|not accepted|invalid|wrong"; "i")) | "\(.ts) \(.from): \((.text // "") | .[0:300])"' 2> /dev/null
    done)
    echo "${c:-(none)}"
    for t in "${ids[@]:0:$( ((full)) && echo "$total" || echo "$last")}"; do
      local d=$TASKS/$t n=$(( full ? 1000000 : 30 )) run
      run=$(task_field "$t" RUN)
      echo; echo "== task $t"
      for c in AGENT KIND MODEL TYPE STATUS NOTE CREATED FINISHED RUN HELPER_ID PARENT_TASK TEAM; do
        [[ -z $(task_field "$t" "$c") ]] || echo "$c=$(task_field "$t" "$c")"
      done
      echo "-- what it got"; head -n "$((full ? 1000000 : 40))" "$d/task.md" 2>&1
      echo "-- what it returned"; tail -n "$n" "$d/final.md" 2>&1
      [[ -z $run ]] || { echo "-- err-$run.log"; tail -n 10 "$d/err-$run.log" 2>&1; }
      echo "-- activity"; tail -n "$((full ? 1000000 : 20))" "$d/activity.jsonl" 2> /dev/null | jq -r '.ts + " " + .k + " " + (.t // "")' 2>&1
      ((full == 0)) || { echo "-- prompts"; cat "$d"/prompt-*.md 2> /dev/null; }
    done
    true
  } 2>&1 | debug_redact > "$out"
  echo "$out ($(wc -l < "$out") lines)"
}

# run_actions task — how many actions (a command, an edit, a tool call) its agent took in its current run: the
# activity entries after the run's start line
run_actions() {
  awk '/"k":"info"/ && /"t":"▶ run / { n = 0; next } /"k":"(cmd|edit|mcp|tool)"/ { n++ } END { print n + 0 }' \
    "$TASKS/$1/activity.jsonl" 2> /dev/null || echo 0
}

# debug_task_text file — the task's own text in a prompt: from its heading (# TASK, # TEAM TASK, # REQUEST H<n>,
# # INVESTIGATION REQUEST #<n>, # PR REVIEW REQUEST #<n>) to the clarification rules; the whole file without one
debug_task_text() {
  awk '/^# (TASK|TEAM TASK|REQUEST H[0-9]+|INVESTIGATION REQUEST #[0-9]+|PR REVIEW REQUEST #[0-9]+)$/ { on = 1; found = 1 }
    on && /CLARIFICATION RULES \(apply to everything above\)/ { on = 0 }
    on { print }
    END { exit !found }' "$1" || cat "$1"
}

# debug_task task lines full — one task's section of agent debug: everything to diagnose it — its metadata, its text
# (with full: the whole task.md and every run's prompt), its request on the bus and the requests it made, its
# questions and the human's answers, its checkpoint, its gate results, its activity, logs and other files, and the
# bus messages to and from its agent since it was made. lines: how much of a long source (its end); full: all of it
debug_task() {
  local t=$1 n=$2 full=$3 d=$TASKS/$1 f run agent hid since cut=600
  local -a files=()
  ((full == 0)) || cut=1000000
  run=$(task_field "$t" RUN); agent=$(task_field "$t" AGENT); hid=$(task_field "$t" HELPER_ID)
  echo; echo "== task $t"
  cat "$d/meta.env"
  if ((full)); then
    echo "-- task.md"; cat "$d/task.md"
  else
    echo "-- the task: its own text in task.md (all of task.md and every run's prompt: --full)"; debug_task_text "$d/task.md"
  fi
  mapfile -t files < <(compgen -G "$d/prompt-*.md" | sort -V)
  for f in "${files[@]}"; do
    f=${f##*/}
    echo "-- prompt of run $(sed 's/^prompt-//; s/\.md$//' <<< "$f"): $f, $(wc -l < "$d/$f") lines"
    ((full == 0)) || cat "$d/$f"
  done
  if [[ -n $hid ]]; then
    echo "-- its request on the bus (H$hid)"
    jq --arg k "$hid" '.helpers[$k] // "the bus does not know it"' "$BUS_DIR/state.json"
  fi
  echo "-- requests it made"
  jq --arg t "$t" --argjson cut "$cut" '[.helpers[]? | select(.from_task == $t)
    | .summary = ((.summary // "") | .[0:$cut]) | .context = ((.context // "") | .[0:$cut])]
    | if length == 0 then "none" else . end' "$BUS_DIR/state.json"
  mapfile -t files < <(compgen -G "$d/questions-*.md" | sort -V)
  for f in "${files[@]}"; do echo "-- ${f##*/}"; cat "$f"; done
  if [[ -f $BUS_DIR/checkpoints/task-$t.md ]]; then
    echo "-- its checkpoints (task-$t.md)"; tail -n "$((n * 2))" "$BUS_DIR/checkpoints/task-$t.md"
  fi
  echo "-- gate results"
  jq -rs --arg t "$t" 'map(select(.task == $t)) as $h | ($h | map(select(.status != "refused"))) as $r
    | select($h | length > 0)
    | "gate runs: \($r | length) (on an uncommitted tree: \($r | map(select(.clean == false)) | length)); refused on an uncommitted tree: \($h | map(select(.status == "refused")) | length)"' \
    "$AGENTS_HOME/gates/history.jsonl" 2> /dev/null
  if [[ -f $AGENTS_HOME/gates/$t.json ]]; then
    jq -c . "$AGENTS_HOME/gates/$t.json"
    grep -F "\"$t\"" "$AGENTS_HOME/gates/history.jsonl" | tail -n "$n"
  else
    echo "none"
  fi
  echo "-- activity"; tail -n "$n" "$d/activity.jsonl" | jq -r '.ts + " " + .k + " " + (.t // "")'
  ((full == 0)) || { echo "-- activity-full.jsonl"; cat "$d/activity-full.jsonl"; }
  if ((full)); then
    mapfile -t files < <(compgen -G "$d/err-*.log" | sort -V)
    for f in "${files[@]}"; do echo "-- ${f##*/}"; cat "$f"; done
  else
    echo "-- err-$run.log"; tail -n "$n" "$d/err-$run.log"
  fi
  echo "-- final.md"; tail -n "$n" "$d/final.md"
  mapfile -t files < <(compgen -G "$d/last-*.md" | sort -V)
  for f in "$d/result.md" "$d/history.md" "$d/handback.md" "$d/fix-pass.md" "$d/resume-request.md" "${files[@]}" \
    "$d/precheck.log" "$d/postmerge.log"; do
    [[ ! -f $f ]] || { echo "-- ${f##*/}"; tail -n "$n" "$f"; }
  done
  echo "-- runner.log"; tail -n "$n" "$d/runner.log"
  if [[ -n $agent ]]; then
    # the bus stamps its messages in local time, "2006-01-02 15:04:05": compared in the same form
    since=$(date -d "$(task_field "$t" CREATED)" '+%Y-%m-%d %H:%M:%S' 2> /dev/null) || since=""
    echo "-- bus messages to and from $agent${since:+ since $since}"
    jq -c --arg a "$agent" --arg since "$since" --argjson cut "$cut" 'select((.from == $a or .to == $a)
      and ((.ts // "") >= $since)) | {ts, from, to, text: ((.text // .body // "") | .[0:$cut])}' \
      "$BUS_DIR/messages.jsonl" | tail -n "$n"
  fi
}

cmd_debug() {
  local ref="" full=0 out="" team="" n=40 t d run by="" name="" days=30 last=20
  local usage="usage: agent debug <team|task> | --agent NAME | --model NAME [--days N] [--last N] [--full|--all] [--out file]"
  local -a ids=()
  while (($#)); do
    case $1 in
      --full | --all) full=1; shift ;;
      --out) out=${2:?$usage}; shift 2 ;;
      --agent | --model) by=${1#--}; name=${2:?$usage}; shift 2 ;;
      --days) days=${2:?$usage}; shift 2 ;;
      --last) last=${2:?$usage}; shift 2 ;;
      -*) die "$usage" ;;
      *) ref=$1; shift ;;
    esac
  done
  [[ ! $days =~ [^0-9] && ! $last =~ [^0-9] ]] || die "$usage"
  if [[ -n $by ]]; then cmd_debug_agent "$by" "$name" "$days" "$last" "$full" "$out"; return; fi
  [[ -n $ref ]] || die "$usage"
  if [[ -f $TASKS/$ref/meta.env ]]; then team=$(task_field "$ref" TEAM); else team=$ref; fi
  # the team's tasks, or the task, and every task made for them — workers, investigations, reviews — at any depth
  mapfile -t ids < <(team_task_closure "${team:-$ref}")
  ((${#ids[@]})) || die "no team or task $ref"
  ((full == 0)) || n=1000000
  out=${out:-$AGENTS_HOME/debug/debug-${team:-$ref}-$(date +%Y%m%d-%H%M%S).txt}
  mkdir -p "$(dirname "$out")" || die "cannot create $(dirname "$out")"
  {
    set +e   # a source that is missing or empty (no request, no precheck) is shown as such: it stops nothing
    echo "agent debug ${team:-$ref} — $(date -Is) — tasks: ${ids[*]}${full:+$( ((full)) && echo ' — full')}"
    if [[ -n $team ]]; then
      echo; echo "== team on the bus"
      team_json "$team" | jq '{lead, finished, members}' 2>&1 || echo "(the bus does not know it)"
      echo; echo "== board"
      bus board-dump --dir "$BUS_DIR" --team "$team" 2>&1 | jq -r '.board // {} | (if type == "object" then .[] else .[] end)
        | "\(.id)  \(.status)  \(.level)  for:\(.for // "-")  by:\(.assignee // "-")  \(.updated)  \(.title)\(if (.progress // "") != "" then "\n      progress: " + .progress else "" end)"' 2>&1
    fi
    echo; echo "== worker requests"
    bus helper-list --dir "$BUS_DIR" --all 2>&1 | grep -F -f <(printf '%s\n' "${ids[@]}") | tail -n "$n"
    if [[ -n $team && -f $BUS_DIR/checkpoints/team-$team.md ]]; then
      echo; echo "== the team's checkpoints"; tail -n "$((n * 2))" "$BUS_DIR/checkpoints/team-$team.md"
    fi
    for t in "${ids[@]}"; do debug_task "$t" "$n" "$full"; done
    echo; echo "== the script's log"
    grep -hF -f <(printf '%s\n' "${ids[@]}" ${team:+"$team"}) "$AGENTS_HOME/logs/agent.jsonl" 2> /dev/null | tail -n "$((n * 3))" \
      | jq -c '{ts, level, event, task} + (del(.ts, .level, .event, .task, .component, .pid, .subcommand))' 2>&1
    if [[ -n $team ]]; then
      echo; echo "== bus messages"
      grep -hF "$team" "$BUS_DIR/messages.jsonl" 2> /dev/null | tail -n "$n" | jq -c '{ts, from, to, text: ((.text // .body // "") | .[0:600])}' 2>&1
    fi
    echo; echo "== git"
    for t in "${ids[@]}"; do
      d=$(task_field "$t" WORKTREE)
      [[ -d $d ]] || { echo "$t: no worktree"; continue; }
      echo "$t: $(task_field "$t" BRANCH) at $(git -C "$d" rev-parse --short HEAD 2>&1), $(git -C "$d" status --porcelain 2> /dev/null | wc -l) changes$( [[ ! -f $(git -C "$d" rev-parse --git-path MERGE_HEAD 2> /dev/null) ]] || echo ', a merge in progress')"
    done
    echo; echo "== round"
    round_pr_for "${ids[0]}" number,url,state 2>&1 | jq -c '.[]' 2>&1
    if [[ -n $team ]]; then (cmd_round_check "$team") 2>&1; (cmd_tokens "$team") 2>&1 | tail -n 15; else
      echo; echo "== tokens"; (cmd_tokens "$ref") 2>&1 | tail -n 15
    fi
    true
  } 2>&1 | debug_redact > "$out"
  echo "$out ($(wc -l < "$out") lines)"
}

# ------------------------------------------------------------------ rounds of work (Round: <id>, ROUND_ID)

# round_id_of text — the round of a task text: its one line "Round: <id>", blanks around the ID ignored; "?" when it
# has none. An ID is parts of letters, digits, ".", "_" and "-" separated by "/" (R12, R12/A); a round includes the
# rounds whose ID starts with its own and "/". Two such lines, or an ID that breaks the pattern: prints which line is
# wrong and returns 1 — agent run refuses the text.
round_id_of() {
  local line n=0 at=0 id="" v
  while IFS= read -r line; do
    n=$((n + 1))
    [[ $line == Round:* ]] || continue
    line=${line%$'\r'}
    if ((at)); then
      printf 'line %s of the text, "%s", is a second Round: line (the first is line %s) — a task has one round' "$n" "$line" "$at"
      return 1
    fi
    at=$n
    v=${line#Round:}
    v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
    if [[ ! $v =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]]; then
      printf 'line %s of the text, "%s", names no round: a round ID is parts of letters, digits, ".", "_" and "-" separated by "/" (Round: R12/A)' "$n" "$line"
      return 1
    fi
    id=$v
  done <<< "$1"
  printf '%s' "${id:-?}"
}

# task_round_id task — the round a task made for this one inherits: its ROUND_ID; "?" when it has none (a task made
# before rounds were recorded, or no task)
task_round_id() {
  local r=""
  [[ -z $1 || ! -f $(meta_file "$1") ]] || r=$(task_field "$1" ROUND_ID)
  printf '%s' "${r:-?}"
}

# run_pr task — the PR a run of the task goes into, its sub-round: its own (PR_NUMBER), else its team's round PR
# (round_pr_of_team), else the round's PR it carries (ROUND_PR), else — a worker, an investigation — the PR of the task
# it was made for when it was made (REQUESTER_PR); "" before there is one
run_pr() {
  local p team
  p=$(task_field "$1" PR_NUMBER)
  team=$(task_field "$1" TEAM)
  [[ -n $p || -z $team ]] || p=$(round_pr_of_team "$team")
  [[ -n $p ]] || p=$(task_field "$1" ROUND_PR)
  [[ -n $p ]] || p=$(task_field "$1" REQUESTER_PR)
  printf '%s' "$p"
}

# job_round_id job text — the round of a node job's task: from its text, as agent run reads it on the lead; a text the
# lead's agent run would refuse (an older lead; a resumed remote member's text with the human's own Round: line) is
# no reason to refuse the job: its round is "?", and the log says why
job_round_id() {
  local r
  if ! r=$(round_id_of "$2"); then
    log_warn job_round_unreadable "job=$1" "reason=${r:0:300}"
    r='?'
  fi
  printf '%s' "$r"
}

# team_task_closure team — a team's tasks: those whose TEAM is the team (none: the team ID as a task, an investigation
# team), and every task reachable from them through PARENT_TASK or INVESTIGATION_TEAM, at any depth; never a task of
# another team. Each task once — a cycle in the links ends where it closes —, the team's own first.
team_task_closure() {
  local team=$1 f key val id t
  local -A team_of=() kids=() seen=()
  local -a queue=() metas=()
  for f in "$TASKS"/*/meta.env; do [[ ! -f $f ]] || metas+=("$f"); done
  ((${#metas[@]})) || return 0
  # one read of all metadata: who points to whom. Task and team IDs carry no character %q quotes; an empty value
  # is written as ''
  while IFS= read -r f; do
    key=${f#*:}; val=${key#*=}; key=${key%%=*}
    [[ $val != "''" ]] || val=""
    id=${f%%:*}; id=${id%/meta.env}; id=${id##*/}
    case $key in
      TEAM) team_of[$id]=$val; [[ $val != "$team" ]] || queue+=("$id") ;;
      PARENT_TASK | INVESTIGATION_TEAM) [[ -z $val ]] || kids[$val]+=" $id" ;;
    esac
  done < <(grep -H -E '^(TEAM|PARENT_TASK|INVESTIGATION_TEAM)=' "${metas[@]}" \
    || (($? == 1)) || log_warn team_tasks_read_failed "team=$team")   # 1: no task has one of them — no error
  ((${#queue[@]})) || [[ ! -f $TASKS/$team/meta.env ]] || queue=("$team")
  local i=0
  while ((i < ${#queue[@]})); do
    id=${queue[i]}; i=$((i + 1))
    [[ -z ${seen[$id]:-} ]] || continue
    seen[$id]=1
    printf '%s\n' "$id"
    for t in ${kids[$id]:-}; do
      [[ -z ${seen[$t]:-} ]] || continue
      [[ -z ${team_of[$t]:-} || ${team_of[$t]} == "$team" ]] || continue   # another team's task: not this team's
      queue+=("$t")
    done
  done
}

# task_role task — what the task was in its work: review (REVIEW=1), worker (KIND=helper), investigation (an
# investigation or an investigation team), coordinator (its team's coordinator, on the bus; a task without a team
# leads its own work), member (another task of a team). A team's coordinator is looked up once, kept in the caller's
# associative array TOKENS_LEADS (team → its coordinator's task; "" none)
task_role() {
  local id=$1 team lead
  if [[ $(task_field "$id" REVIEW) == 1 ]]; then echo review; return; fi
  case $(task_field "$id" KIND) in
    helper) echo worker; return ;;
    investigation | investigation_team) echo investigation; return ;;
  esac
  team=$(task_field "$id" TEAM)
  if [[ -z $team ]]; then echo coordinator; return; fi
  if [[ -v TOKENS_LEADS[$team] ]]; then lead=${TOKENS_LEADS[$team]}
  else
    lead=$(team_lead "$team"); [[ -z $lead ]] || lead=$(team_lead_task "$team" "$lead")
    TOKENS_LEADS[$team]=$lead
  fi
  if [[ $id == "$lead" ]]; then echo coordinator; else echo member; fi
}

# run_subrounds task runs — the task's usage per run, labelled with the run's sub-round from its start line's marker
# ("▶ run N (mode) round <id> pr #<n>" or "pr -"): "<id>/#<n>", "<id>/(no PR)" before a PR, "<the task's round>/?"
# for a run without a marker (made before the marker, or usage before the first run). runs: runs_usage's rows. One
# line per run: label, in, cached, out, cost (tab-separated)
run_subrounds() {
  local id=$1 runs=$2 base markers n l run steps in cached out cost mode
  local -A label=()
  base=$(task_field "$id" ROUND_ID); base=${base:-?}
  markers=$(jq_soft run_markers_unreadable -r 'select(.k == "info" and ((.t // "") | test("^▶ run [0-9]+")))
      | (.t | capture("^▶ run (?<n>[0-9]+)").n) as $n
      | ((.t | capture(" round (?<r>[^ ]+) pr (?<p>#[0-9]+|-)$")) // null) as $m
      | select($m != null) | [$n, $m.r + "/" + (if $m.p == "-" then "(no PR)" else $m.p end)] | @tsv' \
    < "$TASKS/$id/activity.jsonl")
  while IFS=$'\t' read -r n l; do [[ -z $n ]] || label[$n]=$l; done <<< "$markers"
  while IFS=$'\t' read -r run steps in cached out cost mode; do
    [[ -n $run ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "${label[$run]:-$base/?}" "$in" "$cached" "$out" "$cost"
  done <<< "$runs"
}

# tokens_table [--sums] task… — agent tokens' table: per task its runs' sums (in, cached, out, cost; a task without
# usage says so), then its ROLE and ROUND ("-": a task made before rounds were recorded), and the total; --sums: the
# sums per role, per model and per sub-round (run_subrounds) before the total
# OPENCODE_SHORT — the note on opencode's usage: it never reports the usage of a run's last step (2.1.3: 596 of 622
# runs lacked exactly that step_finish), so its numbers are short — a run that answered at once reported nothing
OPENCODE_SHORT="opencode does not report the usage of a run's last step: its IN, OUT and costs are short — a run that answered at once, by all of it"

# model_price_cost model in cached out — what MODEL_PRICES puts on that usage ("input cached output" in $ per 1M
# tokens; cached tokens are part of in), as agent spend prices a run its provider reported no cost for; status 1:
# the model has no price
model_price_cost() {
  local price=${MODEL_PRICES[$1]:-}
  [[ -n $price ]] || return 1
  awk -v p="$price" -v i="$2" -v c="$3" -v o="$4" 'BEGIN {split(p, a, " "); printf "%.6f", ((i - c) * a[1] + c * a[2] + o * a[3]) / 1e6}'
}

# run_idle_counts task — its runs in which the agent did nothing (no command, edit or tool call: it answered from its
# prompt alone) and all its runs, from its activity: "<idle> <runs>"
run_idle_counts() {
  awk '/"k":"info"/ && /"t":"▶ run / { if (on && n == 0) idle++; runs++; on = 1; n = 0; next }
    /"k":"(cmd|edit|mcp|tool)"/ { n++ }
    END { if (on && n == 0) idle++; print idle + 0, runs + 0 }' "$TASKS/$1/activity.jsonl" 2> /dev/null || echo "0 0"
}

tokens_table() {
  local sums=0 id usage runs row in cached out cost role round all="" subs="" mark priced=0 short=0 p
  [[ ${1:-} != --sums ]] || { sums=1; shift; }
  local -A TOKENS_LEADS=()
  printf '%-40s %-24s %-13s %12s %12s %10s %10s %-13s %s\n' TASK AGENT KIND IN CACHED OUT COST ROLE ROUND
  for id in "$@"; do   # in the order given; a task without usage says so
    role=$(task_role "$id"); round=$(task_field "$id" ROUND_ID); round=${round:--}
    usage=""
    if [[ -f $TASKS/$id/activity.jsonl ]]; then   # the sum of its runs (runs_usage — codex's per-run difference included)
      runs=$(runs_usage "$id")
      usage=$(awk -F'\t' '{i += $3; c += $4; o += $5; k += $6} END {if (i + o > 0) printf "%d\t%d\t%d\t%.6f", i, c, o, k}' <<< "$runs")
      if ((sums)) && [[ -n $usage ]]; then subs+=$(run_subrounds "$id" "$runs")$'\n'; fi
    fi
    if [[ -z $usage ]]; then
      printf '%-40s %-24s %-13s %-47s %-13s %s\n' "$id" "$(task_field "$id" AGENT)" "$(task_field "$id" KIND)" "no usage reported" "$role" "$round"
      continue
    fi
    IFS=$'\t' read -r in cached out cost <<< "$usage"
    mark=""   # *: priced from MODEL_PRICES — the provider reported no cost (as agent spend prices it)
    if [[ $(awk -v c="$cost" 'BEGIN {print (c == 0)}') == 1 ]] && p=$(model_price_cost "$(task_model "$id")" "$in" "$cached" "$out"); then
      cost=$p; mark="*"; priced=1
    fi
    [[ $(task_field "$id" TYPE) != opencode ]] || short=1
    printf '%-40s %-24s %-13s %12s %12s %10s %10s %-13s %s\n' "$id" "$(task_field "$id" AGENT)" "$(task_field "$id" KIND)" "$in" "$cached" "$out" "$(printf '%.4f%s' "$cost" "$mark")" "$role" "$round"
    all+=$(jq -nc --arg role "$role" --arg model "$(task_model "$id")" --argjson in "$in" --argjson cached "$cached" \
      --argjson out "$out" --argjson cost "$cost" '{role: $role, model: $model, in: $in, cached: $cached, out: $out, cost: $cost}')$'\n'
  done
  if ((sums)); then
    jq -rs '(group_by(.role) | map("role " + .[0].role)), (group_by(.model) | map("model " + .[0].model)) | .[]' <<< "$all" \
      | while IFS= read -r row; do
          jq -rs --arg k "${row%% *}" --arg v "${row#* }" \
            'map(select(.[$k] == $v)) | [(map(.in) | add), (map(.cached) | add), (map(.out) | add), (map(.cost) | add)] | @tsv' <<< "$all" \
            | { IFS=$'\t' read -r in cached out cost; printf '%-40s %-24s %-13s %12s %12s %10s %10.4f\n' "$row" "" "" "$in" "$cached" "$out" "$cost"; }
        done
    awk -F'\t' 'NF >= 5 {i[$1] += $2; c[$1] += $3; o[$1] += $4; k[$1] += $5}
      END {for (l in i) printf "%-40s %-24s %-13s %12d %12d %10d %10.4f\n", "sub-round " l, "", "", i[l], c[l], o[l], k[l]}' <<< "$subs" \
      | sort
  fi
  jq -rs '[(map(.in) | add // 0), (map(.cached) | add // 0), (map(.out) | add // 0), (map(.cost) | add // 0)] | @tsv' <<< "$all" \
    | { IFS=$'\t' read -r in cached out cost; printf '%-40s %-24s %-13s %12s %12s %10s %10.4f\n' total "" "" "$in" "$cached" "$out" "$cost"; }
  ((priced == 0)) || echo "* priced from MODEL_PRICES: the provider reported no cost"
  ((short == 0)) || echo "$OPENCODE_SHORT"
}

cmd_tokens() { # <team|task> | --round <id> | --runs <task> — the tokens the runs used, from their activity's usage
  # lines (and opencode's step lines): per task — a team's tasks (team_task_closure), a round's — and in all
  local q=${1:?usage: agent tokens <team|task> | --round <id> | --runs <task>} ids=() m d id per want r
  if [[ $q == --runs ]]; then   # one task, per run: its steps (tool calls) and tokens
    id=$(resolve_id "${2:?usage: agent tokens --runs <task>}")
    printf '%-5s %7s %12s %12s %10s %10s %10s  %s\n' RUN STEPS IN CACHED OUT COST IN/STEP MODE
    runs_usage "$id" \
      | while IFS=$'\t' read -r run steps in cached out cost mode; do
          per=-   # the input per step: about the size of the run's context
          ((steps > 0)) && per=$((in / steps))
          printf '%-5s %7s %12s %12s %10s %10.4f %10s  %s\n' "$run" "$steps" "$in" "$cached" "$out" "$cost" "$per" "$mode"
        done
    return 0
  fi
  if [[ $q == --round ]]; then   # every task of the round or of a round inside it (<id>/…), then its sums
    want=${2:-}
    [[ -n $want ]] || die "usage: agent tokens --round <id> (the ID of a task text's Round: line, or ? for none)"
    for m in "$TASKS"/*/meta.env; do
      [[ -f $m ]] || continue
      d=${m%/meta.env}; id=${d##*/}
      r=$(task_field "$id" ROUND_ID)   # none: made before rounds were recorded, of no round
      [[ -n $r && ( $r == "$want" || $r == "$want"/* ) ]] && ids+=("$id")
    done
    ((${#ids[@]})) || die "no task of round $want (ROUND_ID $want or $want/…)"
    tokens_table --sums "${ids[@]}"
    return 0
  fi
  if [[ $q == *-team ]]; then
    mapfile -t ids < <(team_task_closure "$q")
    ((${#ids[@]})) || die "no task of team $q"
  else
    ids=("$(resolve_id "$q")")
  fi
  tokens_table "${ids[@]}"
}

cmd_wake() { # <task> — a paused task resumes now, not at its pause's end (its provider's limit lifted early, a bigger
  # plan bought); a remote member's proxy task on the lead asks the member's node, which resumes it at once
  local id
  id=$(resolve_id "${1:?usage: agent wake <task>}")
  meta_load "$id"
  [[ ${STATUS:-} == paused ]] || die "task $id is not paused (status: ${STATUS:-unknown}) — nothing to resume"
  if [[ ${KIND:-} == remote-member ]]; then
    bus lead-member --dir "$BUS_DIR" --wake-now --member "$AGENT" > /dev/null \
      || die "cannot ask ${AGENT#*@} to resume $AGENT: the lead's registry refused it"
    act "$id" info "asked ${AGENT#*@} to resume $AGENT now (agent wake)"
    log_info wake_now_requested "task=$id" "member=$AGENT"
    echo "asked ${AGENT#*@} to resume $AGENT now: it starts as soon as the node hears its doorbell"
    return 0
  fi
  meta_set "$id" WAKE_AT "$(date +%s)"
  act "$id" info "■ resumed by hand before its pause's end (${PAUSE_REASON:-paused})"
  log_info wake_by_hand "task=$id" "reason=${PAUSE_REASON:-}"
  "$SELF" _wake "$id"
  echo "resumed $id"
}

cmd_kick() { # <task> [from] [expected-run] — cuts only the intended run short: a team member
  # goes to sleep, so its team can wake it again, and the coordinator is told; a solo task is stopped
  local id run st team agent lead from_lead=0
  if [[ ${1:-} == *@* ]]; then
    remote_identity "$1" || die "remote kicks require a configured lead and <task>@<node>"
    local attempt
    # A start report precedes the first artifact sync. Wait outside all locks for actual run evidence.
    for ((attempt=0; attempt<25; attempt++)); do
      [[ ! -f $BUS_DIR/remote/$REMOTE_NODE/$REMOTE_TASK/metadata.json ]] || break
      sleep 0.2
    done
    bus lead-kick --dir "$BUS_DIR" --ttl "${NODE_TTL_SEC}s" --node "$REMOTE_NODE" --task "$REMOTE_TASK" >/dev/null
    echo "Kick queued for $1."
    return
  fi
  id=$(resolve_id "${1:?usage: agent kick <task>}")
  if [[ $(task_field "$id" KIND) == remote-member && -n $LEAD_LISTEN ]]; then
    local target job
    job=$(task_field "$id" JOB_ID)
    target=$(jq -er --arg job "$job" '.Jobs[] | select(.Request.ID==$job) | .TaskID+"@"+.Node' "$BUS_DIR/jobs.json")
    cmd_kick "$target" "${2:-cli}"
    return
  fi
  run=$(task_field "$id" RUN); st=$(task_field "$id" STATUS); team=$(task_field "$id" TEAM); agent=$(task_field "$id" AGENT)
  if [[ -n ${3:-} && $run != "${3:-}" ]]; then
    log_info node_kick_stale "task=$id" "run=$3"
    return 0
  fi
  [[ $st == running || $st == starting ]] || die "task $id is not running ($st) — nothing to stop"
  if [[ ${2:-} == lead && -n $(task_field "$id" JOB_ID) ]]; then
    # Persist intent before SIGTERM; the runner can exit before this command sets its final local status.
    meta_set "$id" LEAD_KICK_RUN "$run" "$run"
    from_lead=1
  fi
  # A stale guarded intent write must not stop an old unit without its exit marker.
  [[ $(task_field "$id" RUN) == "$run" ]] || return 0
  if ! systemctl --user stop "$(unit_name "$id" "$run").service"; then
    log_warn unit_stop_failed "task=$id" "run=$run"
    if ((from_lead)); then meta_set "$id" LEAD_KICK_RUN "" "$run"; fi
    return 1
  fi
  # The captured unit is safe to stop, but a newer run owns its status and timestamps.
  [[ $(task_field "$id" RUN) == "$run" ]] || return 0
  meta_set "$id" KICKED "$(date -Is)" "$run"
  if [[ -n $team && $(team_done_flag "$team") != true && ! -f $TASKS/$id/stop-requested && $(task_field "$id" TEAM_STOPPED) != 1 ]]; then
    [[ $(task_field "$id" STATUS) == sleeping ]] || meta_set "$id" STATUS sleeping "$run"
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$agent" --state sleeping >/dev/null
    lead=$(team_lead "$team")
    if [[ -n $lead && $lead != "$agent" ]]; then
      notice member_stopped "${USER:-human}" "$lead" "TEAM: member $agent was stopped by the human (its current run only); it sleeps — wake it if its work is still needed." "agent=$agent" "team=$team"
    fi
  else
    [[ $(task_field "$id" STATUS) == stopped ]] || meta_set "$id" STATUS stopped "$run"
    meta_set "$id" FINISHED "$(date -Is)" "$run"
    if [[ -n $team ]]; then
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$agent" --state stopped >/dev/null
    fi
  fi
  act "$id" info "■ stopped by the human${2:+ (from the $2 interface)}"
  log_info task_kicked "task=$id" "team=$team" "from=${2:-cli}"
  echo "stopped $id${team:+ — it sleeps; team $team can wake it}"
}

cmd_web() { # runs the web interface in the foreground (agentweb.service runs this)
  [[ -x $AGENTLIVE_BIN ]] || die "$AGENTLIVE_BIN not found — run ./install.sh again"
  local controls=()
  [[ -z $LEAD_LISTEN ]] || controls+=(--remote-controls)
  exec "$AGENTLIVE_BIN" web --home "$AGENTS_HOME" --bus "$BUS_DIR" --agent "$SELF" \
    --listen "$AGENT_WEB_LISTEN" --users "$AGENT_WEB_USERS" --devices "$AGENT_WEB_DEVICES" \
    --tailscale "$(command -v tailscale || echo tailscale)" \
    --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --node-ttl "$NODE_TTL_SEC" "${controls[@]}"
}

cmd_lead() { # runs the lead's listener in the foreground (agentlead.service runs this); needs LEAD_LISTEN
  [[ -n $LEAD_LISTEN ]] || die "LEAD_LISTEN is not set in agents.conf — a lead needs its Tailscale address, e.g. 100.x.y.z:7780"
  local args=(lead --dir "$BUS_DIR" --listen "$LEAD_LISTEN" --node "$INSTANCE_NAME" --ttl "${NODE_TTL_SEC}s")
  args+=(--questions-cmd "$SELF")
  [[ -n ${NOTIFY_DIR:-} ]] && args+=(--notify-dir "$NOTIFY_DIR")
  args+=(--member-grace "${AGENT_RESTART_GRACE_MIN}m")
  [[ -n ${NOTIFY_CMD:-} ]] && args+=(--notify-cmd "$NOTIFY_CMD")
  local dev
  for dev in $LEAD_NODES; do args+=(--allow "$dev"); done
  exec "$AGENTBUS_BIN" "${args[@]}"
}

# node_jobs_file returns the node's durable local mapping and latest reports.
node_jobs_file() { printf '%s/node-jobs.json' "$BUS_DIR"; }

# node_jobs_load fails closed on damaged storage; only an absent path denotes a fresh installation.
node_jobs_load() {
  local f content
  f=$(node_jobs_file)
  if [[ ! -e $f && ! -L $f ]]; then printf '{"jobs":{},"outbox":[]}\n'; return; fi
  [[ -f $f ]] || die "node state is not a regular file: $f"
  content=$(cat -- "$f") || die "cannot read node state: $f"
  jq -e 'type == "object" and (.jobs|type == "object") and (.outbox|type == "array")' <<< "$content" >/dev/null \
    || die "corrupt node state: $f"
  printf '%s\n' "$content"
}

# node_jobs_save atomically replaces state without losing the previous snapshot on a write failure.
node_jobs_save() {
  local data=$1 tmp
  tmp=$(umask 077; mktemp "$BUS_DIR/node-jobs.XXXXXX") || die "cannot allocate node state temporary file"
  if ! { printf '%s\n' "$data" > "$tmp" && mv -- "$tmp" "$(node_jobs_file)"; }; then
    if ! rm -f -- "$tmp"; then log_error node_storage_failed "path=$tmp"; fi
    die "cannot save node state"
  fi
}

# node_save commits the current single-writer snapshot before any network or launch side effect.
node_save() { node_jobs_save "$NODE_STATE"; }

# node_lock excludes another daemon for this installation; runner children explicitly close descriptor 8.
node_lock() {
  mkdir -p "$BUS_DIR"
  exec 8>"$BUS_DIR/node-daemon.lock"
  flock -n 8 || die "another node daemon is already running"
}

# lead_url returns the configured LEAD_URL or the lead's loopback address.
lead_url() {
  if [[ -n ${LEAD_URL:-} ]]; then
    printf '%s' "${LEAD_URL%/}"
  elif [[ -n ${LEAD_LISTEN:-} ]]; then
    printf 'http://127.0.0.1:%s' "${LEAD_LISTEN##*:}"
  else
    die "neither LEAD_URL nor LEAD_LISTEN is configured"
  fi
}

# node_request sends only a coarse HTTP operation through the bounded Go transport.
node_request() { bus node-request --url "$LEAD_URL" "$@"; }

# submit_remote_job submits a job to the lead queue.
submit_remote_job() {
  local selector=$1 target_node=$2 task=$3; shift 3
  local caps=("$@")
  local root common repo_name base_ref job_id req_json body out state
  root=$(git rev-parse --show-toplevel) || die "cannot find the repository root; run this inside a git repository"
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir) || die "cannot resolve the repository common directory"
  repo_name=$(basename "$(dirname "$common")")
  base_ref=$(git -C "$root" rev-parse --abbrev-ref HEAD) || die "cannot resolve the current branch for the remote job"
  # A detached checkout deliberately uses main; failed git lookups must never submit a fallback job.
  [[ $base_ref != "HEAD" ]] || base_ref="main"
  job_id="$(date +%Y%m%d-%H%M%S)-${USER:-human}-$RANDOM"
  req_json='[]'
  if ((${#caps[@]})); then
    req_json=$(printf '%s\n' "${caps[@]}" | jq -R . | jq -s .)
  fi
  body=$(jq -cn \
    --arg id "$job_id" \
    --arg repo "$repo_name" \
    --arg base "$base_ref" \
    --argjson req "$req_json" \
    --arg sel "$selector" \
    --arg target "$target_node" \
    --arg task "$task" \
    --arg reqstr "human" --arg repo_url "$(github_repo_url "$root")" \
    '{ID:$id,Repository:$repo,BaseRef:$base,Requires:$req,Selector:$sel,Target:$target,Task:$task,Requester:$reqstr,RepoURL:$repo_url,RequesterTask:""}')
  out=$(printf '%s' "$body" | bus node-request --url "$(lead_url)" --path /v1/jobs) || die "failed to submit job to lead: $out"
  state=$(jq -r '.State // "queued"' <<< "$out")
  echo "Job $job_id submitted to lead ($state)"
  echo "Track with: agent jobs $job_id"
}

# cmd_jobs lists remote jobs, inspects a single job, or cancels a job on the lead.
cmd_jobs() {
  if [[ ${1:-} == --cancel ]]; then
    local id=${2:-}
    [[ -n $id ]] || die "usage: agent jobs --cancel <id>"
    [[ -n ${LEAD_LISTEN:-} ]] || die "cancelling a job is only supported on the lead"
    local cancel_args=(lead-cancel --dir "$BUS_DIR" --ttl "${NODE_TTL_SEC}s")
    [[ -n ${NOTIFY_DIR:-} ]] && cancel_args+=(--notify-dir "$NOTIFY_DIR")
    [[ -n ${NOTIFY_CMD:-} ]] && cancel_args+=(--notify-cmd "$NOTIFY_CMD")
    cancel_args+=("$id")
    local res state
    res=$(bus "${cancel_args[@]}") || die "cannot cancel job $id"
    state=$(jq -r '.State // "stopped"' <<< "$res")
    echo "Job $id cancelled ($state)"
    return
  fi
  local id=${1:-}
  if [[ -n $id ]]; then
    local job state node branch pr wait_reason offline task_text result reqs target
    job=$(bus node-request --url "$(lead_url)" --path "/v1/jobs/$id" --get) || die "job not found: $id"
    state=$(jq -r '.State // ""' <<< "$job")
    node=$(jq -r '.Node // ""' <<< "$job")
    branch=$(jq -r '.Branch // ""' <<< "$job")
    pr=$(jq -r '.PRURL // ""' <<< "$job")
    wait_reason=$(jq -r '.WaitReason // ""' <<< "$job")
    offline=$(jq -r '.NodeOffline // false' <<< "$job")
    task_text=$(jq -r '.Request.Task // ""' <<< "$job")
    result=$(jq -r '.Result // ""' <<< "$job")

    echo "Job: $id"
    if [[ $state == queued && -n $wait_reason ]]; then
      echo "State: queued (waiting: $wait_reason)"
    elif [[ $offline == true && $state == running ]]; then
      echo "State: running (node offline)"
    else
      echo "State: $state"
    fi
    echo "Repo: $(jq -r '.Request.Repository // ""' <<< "$job")"
    echo "Base: $(jq -r '.Request.BaseRef // ""' <<< "$job")"
    reqs=$(jq -r '.Request.Requires // [] | join(",")' <<< "$job")
    [[ -z $reqs ]] || echo "Requires: $reqs"
    echo "Selector: $(jq -r '.Request.Selector // ""' <<< "$job")"
    target=$(jq -r '.Request.Target // ""' <<< "$job")
    [[ -z $target ]] || echo "Target: $target"
    [[ -z $node ]] || echo "Node: $node"
    [[ -z $branch ]] || echo "Branch: $branch"
    [[ -z $pr ]] || echo "PR: $pr"
    if [[ -n $task_text ]]; then
      echo
      echo "Task:"
      echo "$task_text"
    fi
    if [[ -n $result ]]; then
      echo
      echo "Result:"
      echo "$result"
    fi
  else
    local jobs count
    jobs=$(bus node-request --url "$(lead_url)" --path "/v1/jobs" --get) || die "failed to list jobs from lead"
    if [[ -z ${LEAD_LISTEN:-} && -n ${LEAD_URL:-} ]]; then
      jobs=$(jq -c --arg node "$INSTANCE_NAME" '[.[] | select(.Node == $node)]' <<< "$jobs")
    fi
    count=$(jq 'length' <<< "$jobs")
    if ((count == 0)); then
      echo "No remote jobs found."
      return
    fi
    printf '%-26s %-12s %-12s %-10s %s\n' "JOB ID" "STATE" "NODE" "SELECTOR" "DETAILS"
    local i
    for ((i=0; i<count; i++)); do
      local row jid st nd sel wr off br details=""
      row=$(jq -c ".[$i]" <<< "$jobs")
      jid=$(jq -r '.Request.ID // ""' <<< "$row")
      st=$(jq -r '.State // ""' <<< "$row")
      nd=$(jq -r '.Node // "-"' <<< "$row")
      [[ -n $nd ]] || nd="-"
      sel=$(jq -r '.Request.Selector // ""' <<< "$row")
      wr=$(jq -r '.WaitReason // ""' <<< "$row")
      off=$(jq -r '.NodeOffline // false' <<< "$row")
      br=$(jq -r '.Branch // ""' <<< "$row")
      if [[ $st == queued && -n $wr ]]; then
        details="waiting: $wr"
      elif [[ $off == true && $st == running ]]; then
        details="node offline"
      elif [[ -n $br ]]; then
        details="$br"
      fi
      printf '%-26s %-12s %-12s %-10s %s\n' "$jid" "$st" "$nd" "$sel" "$details"
    done
  fi
}

# cmd_nodes lists the nodes registered on the lead.
cmd_nodes() {
  local nodes count
  nodes=$(bus node-request --url "$(lead_url)" --path "/v1/nodes" --get) || die "failed to list nodes from lead"
  count=$(jq 'length' <<< "$nodes")
  if ((count == 0)); then
    echo "No nodes registered yet."
    return
  fi
  printf '%-16s %-10s %-24s %-20s %-32s %s\n' "NODE" "STATUS" "CAPABILITIES" "FREE AGENTS" "LAST SEEN" "WEB URL"
  local i
  for ((i=0; i<count; i++)); do
    local row name off status="online" caps free last_seen web
    row=$(jq -c ".[$i]" <<< "$nodes")
    name=$(jq -r '.Node // ""' <<< "$row")
    off=$(jq -r '.Offline // false' <<< "$row")
    [[ $off != true ]] || status="offline"
    caps=$(jq -r '.Capabilities // [] | join(",")' <<< "$row")
    [[ -n $caps ]] || caps="-"
    free=$(jq -r '[.FreeAgents[]? | .Name] | join(",")' <<< "$row")
    [[ -n $free ]] || free="none"
    last_seen=$(jq -r '.LastSeen // "-"' <<< "$row")
    web=$(jq -r '.WebURL // "-"' <<< "$row")
    [[ -n $web ]] || web="-"
    printf '%-16s %-10s %-24s %-20s %-32s %s\n' "$name" "$status" "$caps" "$free" "$last_seen" "$web"
  done
}

# agent_cli_present agent — is the CLI of the agent's type installed? (a missing one is not offered as free)
agent_cli_present() {
  local bin=""
  case ${AGENT_TYPE[$1]:-} in
    claude) bin=$CLAUDE_BIN ;; codex) bin=$CODEX_BIN ;; gemini) bin=$AGY_BIN ;; opencode) bin=$OPENCODE_BIN ;;
  esac
  [[ -n $bin && -x $bin ]] || command -v "$bin" >/dev/null 2>&1   # a name on PATH; its output is not needed
}

declare -A NODE_MISSING_CLI=()   # agents already reported as lacking their CLI (once per daemon)

# node_activity_json — what the node's running jobs are doing: [{ID, Agent, Stage, Lines}], the latest 20 lines each
node_activity_json() {
  local jid tid lines out='[]'
  for jid in $(jq -r '.jobs | to_entries[] | select(.value.launched and (.value.obsolete|not) and (.value.state // "" | test("^(done|failed|stopped)$") | not)) | .key' <<< "${NODE_STATE:-"{\"jobs\":{}}"}"); do
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -n $tid && -f $TASKS/$tid/meta.env ]] || continue
    lines='[]'
    if [[ -f $TASKS/$tid/activity.jsonl ]]; then
      lines=$(tail -n 20 "$TASKS/$tid/activity.jsonl" | jq -sc '[.[] | ((.ts // "" | split(" ") | last) + " " + (.t // ""))]') \
        || lines='[]'   # a line being written may be cut: the next heartbeat sends it whole
    fi
    out=$(jq -c --arg id "$jid" --arg agent "$(task_field "$tid" AGENT)" --arg stage "$(task_field "$tid" STATUS)" \
      --argjson lines "$lines" '. + [{ID:$id, Agent:$agent, Stage:$stage, Lines:$lines}]' <<< "$out")
  done
  printf '%s' "$out"
}

# node_job_result task state — what a finished job reports: its final message, or the task's note when there is
# none (a CLI that did not start leaves no final message: "CLI exit code: 127")
node_job_result() {
  local tid=$1 state=$2
  [[ $state =~ ^(done|failed|stopped)$ ]] || return 0
  # a final message of blanks only (a failed run leaves one) is none: the run's note says what it ended on
  if [[ -f $TASKS/$tid/final.md && -n $(tr -d '[:space:]' < "$TASKS/$tid/final.md") ]]; then cat "$TASKS/$tid/final.md"; return 0; fi
  task_field "$tid" NOTE
}

# node_heartbeat_json advertises configured inventory and free capacity using ordinary admission rules.
node_heartbeat_json() {
  local a available_json='[]' configured_json='[]' caps='[]'
  for a in "${!AGENT_TYPE[@]}"; do
    is_investigator "$a" && continue
    configured_json=$(jq -c --arg name "$a" --arg type "${AGENT_TYPE[$a]}" --arg model "${AGENT_MODEL[$a]:-}" \
      --arg tier "$(agent_tier "$a")" '. + [{Name:$name,Type:$type,Model:$model,Tier:$tier}]' <<< "$configured_json")
    if ! agent_cli_present "$a"; then
      if [[ -z ${NODE_MISSING_CLI[$a]:-} ]]; then
        NODE_MISSING_CLI[$a]=1
        log_error node_agent_cli_missing "agent=$a" "type=${AGENT_TYPE[$a]}"
      fi
      continue
    fi
    if agent_running_task "$a" >/dev/null; then continue; fi # Exit 1 means the configured agent is free.
    available_json=$(jq -c --arg name "$a" --arg tier "$(agent_tier "$a")" '. + [{Name:$name,Tier:$tier}]' <<< "$available_json")
  done
  if ((${#INSTANCE_CAPABILITIES[@]})); then caps=$(printf '%s\n' "${INSTANCE_CAPABILITIES[@]}" | jq -R . | jq -s .); fi
  local state_json='{"jobs":{}}'
  [[ -z ${NODE_STATE:-} ]] || state_json=$NODE_STATE
  printf '%s' "$state_json" | jq -c --arg node "$INSTANCE_NAME" --argjson caps "$caps" --argjson free "$available_json" --arg web "$AGENT_WEB_URL" \
    --argjson agents "$configured_json" --argjson activity "$(node_activity_json)" '
    [(.jobs//{})[] | select(.obsolete|not) | .answer_ack // empty][:64] as $answers |
    [(.jobs//{})[] | select(.obsolete|not) | .kick_ack // empty][:64] as $kicks |
    {Node:$node,Capabilities:$caps,Agents:($agents|sort_by(.Name)),FreeAgents:$free,WebURL:$web,Activity:$activity}
    + (if ($answers|length)>0 then {AnswerAcks:$answers} else {} end)
    + (if ($kicks|length)>0 then {KickAcks:$kicks} else {} end)'
}

# node_select_agent uses provider rotation for workers, otherwise the configured normal-agent order.
node_select_agent() {
  local selector=$1 a
  case $selector in
    worker) if free_worker; then return; else return 1; fi ;; # No free worker is an expected answer.
    normal)
      for a in "${NORMAL_AGENTS[@]}"; do
        [[ -n ${AGENT_TYPE[$a]:-} ]] || continue
        if ! agent_running_task "$a" >/dev/null; then printf '%s' "$a"; return; fi
      done ;;
    *)
      [[ -n ${AGENT_TYPE[$selector]:-} ]] || return 1
      is_investigator "$selector" && return 1
      if ! agent_running_task "$selector" >/dev/null; then printf '%s' "$selector"; return; fi ;;
  esac
  return 1
}

# node_time normalizes a timestamp and clamps it to the last observed instant after clock rollback.
node_time() {
  local base=${1:-} candidate=${2:-} now
  if [[ -n $candidate ]]; then now=$(date -u -d "$candidate" +%Y-%m-%dT%H:%M:%S.%NZ); else now=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ); fi
  if [[ -n $base ]]; then
    base=$(date -u -d "$base" +%Y-%m-%dT%H:%M:%S.%NZ)
    [[ $now < $base ]] && now=$base
  fi
  printf '%s' "$now"
}

# node_map_state maps local statuses to the job lifecycle; transient local states are not separate job states.
node_map_state() {
  case $1 in
    waiting) printf waiting ;;
    done) printf done ;;
    failed|hung|excluded) printf failed ;;
    stopped) printf stopped ;;
    new|starting|running|paused|investigating|sleeping|interrupted) printf running ;;
    *) die "unknown local task status: $1" ;;
  esac
}

# node_transition persists a cumulative report; result text is a bounded UTF-8 prefix of the final message.
node_transition() {
  local jid=$1 state=$2 observed=${3:-} result=${4:-} previous at entry
  entry=$(jq -c --arg id "$jid" '.jobs[$id]' <<< "$NODE_STATE")
  previous=$(jq -r '.report.At // .assigned_at // empty' <<< "$entry")
  at=$(node_time "$previous" "$observed")
  # jq's UTF-8 byte length accounts for multibyte text; task output is text, not a transferred file.
  result=$(jq -nr --arg text "$result" '$text | until(utf8bytelength <= 65536 and (tojson|utf8bytelength) <= 65536; .[0:(length / 2 | floor)])')
  NODE_STATE=$(jq -c --arg id "$jid" --arg state "$state" --arg at "$at" --arg result "$result" --arg node "$INSTANCE_NAME" '
    .jobs[$id] |= (. as $j | .report = {
      ID:$id,Node:$node,Assignment:.assignment,State:$state,TaskID:(.task_id // ""),Branch:(.branch // ""),Agent:(.agent // ""),
      PRURL:(.pr_url // ""),Result:$result,At:$at,
      Transitions:((.report.Transitions // []) + [{State:$state,At:$at}])
    } | .state=$state | .pending=true | if ($state == "done" or $state == "failed" or $state == "stopped") then .preparing=false else . end)' <<< "$NODE_STATE")
  node_save
}

# node_reconcile fences a rejected old assignment without treating a transport failure as an acknowledgement.
node_reconcile() {
  local jid=$1 view assignment state
  if ! view=$(node_request --get --path "/v1/jobs/$jid" < /dev/null); then return; fi
  assignment=$(jq -r --arg id "$jid" '.jobs[$id].assignment' <<< "$NODE_STATE")
  if ! jq -e --arg id "$jid" '.Request.ID == $id and (.State|type == "string")' <<< "$view" >/dev/null; then
    log_warn node_reply_invalid "job=$jid"; return
  fi
  state=$(jq -r '.State' <<< "$view")
  if [[ $(jq -r '.Assignment' <<< "$view") != "$assignment" || $(jq -r '.Node' <<< "$view") != "$INSTANCE_NAME" || $state =~ ^(done|failed|stopped|queued)$ ]]; then
    NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].obsolete=true | .jobs[$id].pending=false' <<< "$NODE_STATE")
    node_save
    local prepared_task
    prepared_task=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    if [[ -n $prepared_task && -f $TASKS/$prepared_task/meta.env ]] && [[ $(task_field "$prepared_task" RUN) == 0 ]]; then
      meta_set "$prepared_task" STATUS stopped
    fi
    log_warn node_assignment_obsolete "job=$jid" "state=$state"
  fi
}

# node_start_ack retries the exact persisted start snapshot and requires matching assignment/task evidence.
node_start_ack() {
  local jid=$1 report reply rc
  report=$(jq -c --arg id "$jid" '.jobs[$id].report' <<< "$NODE_STATE")
  if reply=$(printf '%s' "$report" | node_request --path "/v1/jobs/$jid/state"); then
    if jq -e --argjson report "$report" '.Request.ID == $report.ID and .Assignment == $report.Assignment and .State == "running" and .TaskID == $report.TaskID and .Branch == $report.Branch' <<< "$reply" >/dev/null; then
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].start_acked=true | .jobs[$id].pending=false' <<< "$NODE_STATE")
      node_save
    else log_warn node_reply_invalid "job=$jid"; fi
  else
    rc=$?
    log_warn node_start_report_failed "job=$jid" "exit=$rc"
    if ((rc == BUS_PERMISSION)); then node_reconcile "$jid"; fi
  fi
}

# node_process_pending_launches progresses prepared tasks independently of the heartbeat's assignment reply.
node_process_pending_launches() {
  local jid tid busy run status ids
  ids=$(jq -r '.jobs | keys[]' <<< "$NODE_STATE")
  for jid in $ids; do
    [[ -n $jid ]] || continue
    if jq -e --arg id "$jid" '.jobs[$id] | .obsolete or .launched or (.task_id == "")' <<< "$NODE_STATE" >/dev/null; then continue; fi
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id' <<< "$NODE_STATE")
    if [[ -f $TASKS/$tid/meta.env ]]; then
      run=$(task_field "$tid" RUN)
      status=$(task_field "$tid" STATUS)
      if [[ $status =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
        # A stop can arrive after acknowledgement while local capacity delays launch.
        NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
        node_save
        continue
      elif ((run == 0)) && [[ -f $TASKS/$tid/stop-requested || -f $TASKS/$tid/node-stop-requested ]]; then
        meta_set "$tid" STATUS stopped
        meta_set "$tid" FINISHED "$(date -Is)"
        NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
        node_save
        continue
      fi
    fi
    if [[ ! -f $TASKS/$tid/meta.env ]]; then
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
      node_transition "$jid" failed '' 'CheckoutFailed: prepared task or worktree is missing during recovery'
      continue
    fi
    run=$(task_field "$tid" RUN)
    if ((run > 0)); then
      # A live runner stays independent even if its checkout was removed after launch.
      status=$(task_field "$tid" STATUS)
      if [[ $status =~ ^(starting|new)$ ]] && ! unit_active "$tid" "$run"; then
        meta_set "$tid" STATUS failed
        meta_set "$tid" FINISHED "$(date -Is)"
      fi
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE"); node_save
      continue
    fi
    if [[ ! -d $(task_field "$tid" WORKTREE) ]]; then
      meta_set "$tid" STATUS failed
      meta_set "$tid" FINISHED "$(date -Is)"
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
      node_transition "$jid" failed '' 'CheckoutFailed: prepared task or worktree is missing during recovery'
      continue
    fi
    if ! jq -e --arg id "$jid" '.jobs[$id].start_acked' <<< "$NODE_STATE" >/dev/null; then node_start_ack "$jid"; fi
    if ! jq -e --arg id "$jid" '.jobs[$id] | .start_acked and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then continue; fi
    lock_task_ids
    if busy=$(agent_running_task "$(task_field "$tid" AGENT)"); then
      if [[ $busy != "$tid" ]]; then unlock_task_ids; continue; fi
    fi
    status=$(task_field "$tid" STATUS)
    if [[ $status =~ ^(done|failed|stopped|hung|excluded)$ ]] || [[ -f $TASKS/$tid/stop-requested || -f $TASKS/$tid/node-stop-requested ]] || jq -e --arg id "$jid" '.jobs[$id] | .obsolete or (.state == "stopped")' <<< "$NODE_STATE" >/dev/null; then
      if [[ ! $status =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
        meta_set "$tid" STATUS stopped
        meta_set "$tid" FINISHED "$(date -Is)"
      fi
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
      node_save
      unlock_task_ids
      continue
    fi
    if start_runner "$tid" new; then :; else log_error node_launch_failed "job=$jid" "task=$tid"; fi
    unlock_task_ids
    NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE"); node_save
  done
}

# node_recover_tasks binds a preparation interrupted before its mapping save to its already tagged local task.
node_recover_tasks() {
  local jid tid assignment candidate found ids assigned run
  local -a matched partial started
  ids=$(jq -r '.jobs | keys[]' <<< "$NODE_STATE")
  for jid in $ids; do
    [[ -n $jid ]] || continue
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -z $tid ]] || continue
    if ! jq -e --arg id "$jid" '.jobs[$id].preparing and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then continue; fi
    assignment=$(jq -r --arg id "$jid" '.jobs[$id].assignment' <<< "$NODE_STATE")
    # Admission excludes a local resume while recovery classifies or removes unstarted checkouts.
    lock_task_ids
    found=''; matched=(); partial=(); started=()
    for candidate in "$TASKS"/*/; do
      [[ -f $candidate/meta.env ]] || continue
      candidate=${candidate%/}; candidate=${candidate##*/}
      [[ $(task_field "$candidate" JOB_ID) == "$jid" ]] || continue
      assigned=$(task_field "$candidate" JOB_ASSIGNMENT)
      run=$(task_field "$candidate" RUN)
      if [[ $assigned == "$assignment" ]]; then
        matched+=("$candidate")
        [[ $run == 0 ]] || started+=("$candidate")
      elif [[ -z $assigned && $run == 0 ]]; then
        partial+=("$candidate")
      fi
    done
    if ((${#started[@]} > 1)); then
      unlock_task_ids
      die "multiple started tasks match job $jid; inspect local tasks ${started[*]} before restarting the node"
    elif ((${#started[@]} == 1)); then
      found=${started[0]}
    elif ((${#matched[@]} == 1)); then
      found=${matched[0]}
    elif ((${#matched[@]} == 0 && ${#partial[@]} == 1)); then
      found=${partial[0]}
    fi
    # Other assignments were excluded above; every removable candidate has RUN=0.
    for candidate in "${matched[@]}" "${partial[@]}"; do
      [[ $candidate == "$found" ]] || discard_task "$candidate"
    done
    if [[ -n $found ]]; then
      if [[ -z $(task_field "$found" JOB_ASSIGNMENT) ]]; then meta_set "$found" JOB_ASSIGNMENT "$assignment"; fi
      if [[ -n ${LEAD_URL:-} && -z $(task_field "$found" JOB_LEAD) ]]; then meta_set "$found" JOB_LEAD "$LEAD_URL"; fi
      node_bind_task "$jid" "$found"
    else
      node_transition "$jid" failed '' 'CheckoutFailed: prepared task is missing or ambiguous during recovery'
    fi
    unlock_task_ids
  done
}

# node_bind_task persists a prepared checkout and its exact first running transition before asking permission to launch.
node_bind_task() {
  local jid=$1 tid=$2
  NODE_STATE=$(jq -c --arg id "$jid" --arg tid "$tid" --arg branch "$(task_field "$tid" BRANCH)" \
    '.jobs[$id].task_id=$tid | .jobs[$id].branch=$branch | .jobs[$id].preparing=false' <<< "$NODE_STATE")
  node_transition "$jid" running
}

# node_scan_tasks consumes the job-only transition journal under the same lock as task metadata writes.
node_scan_tasks() {
  local jid tid journal cursor total record state result current previous ids
  ids=$(jq -r '.jobs | keys[]' <<< "$NODE_STATE")
  for jid in $ids; do
    [[ -n $jid ]] || continue
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -n $tid && -f $TASKS/$tid/meta.env ]] || continue
    if ! jq -e --arg id "$jid" '.jobs[$id].launched and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then continue; fi
    journal='[]'
    if [[ -f $TASKS/$tid/job_transitions.jsonl ]]; then
      journal=$({ flock -s 9 && jq -sc . "$TASKS/$tid/job_transitions.jsonl"; } 9>"$TASKS/$tid/meta.env.lock") || die "cannot read job transitions for $tid"
    fi
    cursor=$(jq -r --arg id "$jid" '.jobs[$id].cursor // 0' <<< "$NODE_STATE")
    total=$(jq length <<< "$journal")
    while ((cursor < total)); do
      record=$(jq -c --argjson n "$cursor" '.[$n]' <<< "$journal")
      state=$(node_map_state "$(jq -r .state <<< "$record")")
      previous=$(jq -r --arg id "$jid" '.jobs[$id].state' <<< "$NODE_STATE")
      cursor=$((cursor+1))
      NODE_STATE=$(jq -c --arg id "$jid" --argjson cursor "$cursor" '.jobs[$id].cursor=$cursor' <<< "$NODE_STATE")
      if [[ ! $previous =~ ^(done|failed|stopped)$ ]]; then
        result=$(node_job_result "$tid" "$state")
        if [[ $state != "$previous" || $state == waiting ]]; then node_transition "$jid" "$state" "$(jq -r .at <<< "$record")" "$result"; fi
      fi
      node_save
    done
    # A crash after metadata replacement but before journal append still exposes the latest local state.
    current=$(node_map_state "$(task_field "$tid" STATUS)")
    previous=$(jq -r --arg id "$jid" '.jobs[$id].state' <<< "$NODE_STATE")
    if [[ $current != "$previous" && ! $previous =~ ^(done|failed|stopped)$ ]]; then
      result=$(node_job_result "$tid" "$current")
      node_transition "$jid" "$current" '' "$result"
    fi
  done
}

# node_flush_reports sends one latest snapshot per job with byte-bounded heartbeats, preserving it until acknowledgement.
node_flush_reports() {
  local jid declaration report payload reply rc ids
  declaration=$(node_heartbeat_json)
  # Start snapshots are acknowledged separately before launch; only launched/failed preparations use heartbeat reports.
  ids=$(jq -r '.jobs | to_entries[] | select(.value.pending and (.value.obsolete|not) and (.value.launched or .value.task_id == "")) | .key' <<< "$NODE_STATE")
  for jid in $ids; do
    report=$(jq -c --arg id "$jid" '.jobs[$id].report' <<< "$NODE_STATE")
    # Cumulative history can exceed Linux's per-argument limit while still fitting the protocol envelope.
    payload=$(printf '%s\n%s\n' "$declaration" "$report" | jq -cs '.[0] + {Reports:[.[1]]}')
    if (($(printf '%s' "$payload" | wc -c) > 262144)); then
      # Preserve both the report and receipts: the ordinary heartbeat sends these acknowledgements next.
      payload=$(jq -c 'del(.AnswerAcks,.KickAcks)' <<< "$payload")
    fi
    # Truncate only when constructing a transition, never after an attempted send: retries stay identical.
    if (($(printf '%s' "$payload" | wc -c) > 262144)); then die "job transition history exceeds heartbeat limit"; fi
    if reply=$(printf '%s' "$payload" | node_request --path /v1/heartbeat); then
      if ! jq -e 'has("Job") and (.Stops|type == "array")' <<< "$reply" >/dev/null; then log_warn node_reply_invalid "job=$jid"; continue; fi
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].pending=false' <<< "$NODE_STATE"); node_save
      node_clear_control_acks "$payload"
      node_handle_reply "$reply"
    else
      rc=$?; log_warn node_report_failed "job=$jid" "exit=$rc"
      if ((rc == BUS_PERMISSION)); then node_reconcile "$jid"; fi
    fi
  done
}

# node_clear_control_acks sent-body — clears only the acknowledgements in a successful request.
node_clear_control_acks() {
  if ! jq -e '((.AnswerAcks//[])|length)+((.KickAcks//[])|length)>0' <<< "$1" >/dev/null; then return 0; fi
  NODE_STATE=$(printf '%s\n%s\n' "$NODE_STATE" "$1" | jq -cs '
    .[1] as $sent | .[0] |
    reduce ($sent.AnswerAcks//[])[] as $ack (.;
      if .jobs[$ack.Job].answer_ack==$ack then del(.jobs[$ack.Job].answer_ack) else . end) |
    reduce ($sent.KickAcks//[])[] as $ack (.;
      if .jobs[$ack.Job].kick_ack==$ack then del(.jobs[$ack.Job].kick_ack) else . end)')
  node_save
}

# node_apply_answer answer-json — validates a closed payload and resumes only its assigned waiting task.
node_apply_answer() {
  local msg=$1 jid tid file sha round tmp digest state
  if ! jq -e 'type=="object" and keys==["Content","File","Job","SHA256","TaskID"] and (.Job|type=="string") and (.TaskID|type=="string") and (.File|type=="string") and (.Content|type=="string") and (.SHA256|type=="string")' <<< "$msg" >/dev/null; then
    log_warn node_answer_rejected cause=MalformedBody; return 0
  fi
  jid=$(jq -r .Job <<< "$msg"); tid=$(jq -r .TaskID <<< "$msg")
  file=$(jq -r .File <<< "$msg"); sha=$(jq -r .SHA256 <<< "$msg")
  if [[ ! $file =~ ^questions-([1-9][0-9]{0,8})\.md$ || ! $sha =~ ^[0-9a-f]{64}$ ]] || \
    ! jq -e --arg file "$file" --arg sha "$sha" '.File==$file and .SHA256==$sha' <<< "$msg" >/dev/null; then
    log_warn node_answer_rejected "job=$jid" cause=InvalidFile; return 0
  fi
  round=${file#questions-}; round=${round%.md}
  if ! jq -e --arg job "$jid" --arg task "$tid" '.Job==$job and .TaskID==$task' <<< "$msg" >/dev/null || \
    ! jq -e --arg job "$jid" --arg task "$tid" '.jobs[$job] | .task_id==$task and .launched and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then
    log_warn node_answer_rejected "job=$jid" cause=NoSuchJob; return 0
  fi
  # The path comes from the exact local assignment, never from an unchecked network identifier.
  tid=$(jq -r --arg job "$jid" '.jobs[$job].task_id' <<< "$NODE_STATE")
  if ! jq -e '.Content|utf8bytelength<=262144' <<< "$msg" >/dev/null; then
    log_warn node_answer_rejected "job=$jid" cause=InvalidContent; return 0
  fi
  if ! digest=$(jq -jr .Content <<< "$msg" | sha256sum); then
    log_warn node_answer_rejected "job=$jid" cause=Storage; return 0
  fi
  digest=${digest%% *}
  if [[ $digest != "$sha" ]]; then log_warn node_answer_rejected "job=$jid" cause=InvalidContent; return 0; fi
  state=$(task_field "$tid" STATUS)
  if [[ $state == waiting && $(task_field "$tid" ROUND) == "$round" ]]; then
    tmp=$(mktemp "$TASKS/$tid/lead-answer.XXXXXX")
    jq -jr .Content <<< "$msg" > "$tmp"
    if ! answers_marked "$tmp" || ! validate_answers "$tmp"; then
      rm -f "$tmp"
      log_warn node_answer_rejected "job=$jid" cause=InvalidContent; return 0
    fi
    mv "$tmp" "$TASKS/$tid/$file"
    NODE_STATE=$(jq -c --arg job "$jid" --argjson receipt "$(jq -c '{Job,TaskID,File,SHA256}' <<< "$msg")" '.jobs[$job].answer_received=$receipt' <<< "$NODE_STATE")
    node_save
    if ! "$SELF" _answers_saved "$tid" "$round" lead 8>&-; then
      log_warn node_answer_resume_failed "job=$jid"; return 0
    fi
    [[ $(task_field "$tid" STATUS) != waiting ]] || return 0  # a busy agent/session failure remains retryable
    log_info node_answer_applied "job=$jid" "task=$tid"
  else
    # An owned delivery for an ended round is acknowledged without touching either question file.
    log_info node_answer_stale "job=$jid" "task=$tid" "round=$round" "status=$state"
  fi
  NODE_STATE=$(jq -c --arg job "$jid" --argjson ack "$(jq -c '{Job,TaskID,File,SHA256}' <<< "$msg")" '.jobs[$job].answer_ack=$ack' <<< "$NODE_STATE")
  node_save
}

# node_apply_kick kick-json — kicks only the requested local run and records a durable scoped receipt.
node_apply_kick() {
  local msg=$1 jid tid run sha
  if ! jq -e 'type=="object" and keys==["Job","Run","SHA256","TaskID"] and (.Job|type=="string") and (.TaskID|type=="string") and (.Run|type=="number") and (.SHA256|type=="string")' <<< "$msg" >/dev/null; then
    log_warn node_kick_rejected cause=MalformedBody; return 0
  fi
  jid=$(jq -r .Job <<< "$msg"); tid=$(jq -r .TaskID <<< "$msg"); run=$(jq -r .Run <<< "$msg"); sha=$(jq -r .SHA256 <<< "$msg")
  if [[ ! $run =~ ^[1-9][0-9]{0,8}$ || ! $sha =~ ^[0-9a-f]{64}$ ]] || \
    ! jq -e --arg job "$jid" --arg task "$tid" --arg sha "$sha" '.Job==$job and .TaskID==$task and .SHA256==$sha' <<< "$msg" >/dev/null || \
    ! jq -e --arg job "$jid" --arg task "$tid" '.jobs[$job] | .task_id==$task and .launched and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then
    log_warn node_kick_rejected "job=$jid" cause=NoSuchJob; return 0
  fi
  tid=$(jq -r --arg job "$jid" '.jobs[$job].task_id' <<< "$NODE_STATE")
  if [[ $(task_field "$tid" RUN) == "$run" && $(task_field "$tid" STATUS) =~ ^(running|starting)$ ]]; then
    if ! "$SELF" kick "$tid" lead "$run" 8>&-; then log_warn node_kick_failed "job=$jid"; return 0; fi
  else
    log_info node_kick_stale "job=$jid" "run=$run"  # an ended run must not turn a later run into a stop
  fi
  NODE_STATE=$(jq -c --arg job "$jid" --argjson ack "$(jq -c '{Job,TaskID,Run,SHA256}' <<< "$msg")" '.jobs[$job].kick_ack=$ack' <<< "$NODE_STATE")
  node_save
}

# node_handle_controls reply — consumes only bounded answer/kick arrays; unrelated heartbeat work continues.
node_handle_controls() {
  local msg
  if ! jq -e '((.Answers//[])|type=="array" and length<=8) and ((.Kicks//[])|type=="array" and length<=64)' <<< "$1" >/dev/null; then
    log_warn node_controls_rejected cause=MalformedBody; return 0
  fi
  while IFS= read -r msg; do node_apply_answer "$msg"; done < <(jq -c '.Answers//[] | .[]' <<< "$1")
  while IFS= read -r msg; do node_apply_kick "$msg"; done < <(jq -c '.Kicks//[] | .[]' <<< "$1")
}

# node_handle_stop requires a successful local stop and keeps the actual result if completion won the race.
node_handle_stop() {
  local jid=$1 assignment=$2 tid state run detail
  if ! jq -e --arg id "$jid" --argjson assignment "$assignment" '.jobs[$id] | .assignment == $assignment and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then return; fi
  tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
  [[ -n $tid ]] || return 0
  state=$(task_field "$tid" STATUS)
  [[ ! $state =~ ^(done|failed|stopped|hung|excluded)$ ]] || return 0
  run=$(task_field "$tid" RUN)
  if ((run > 0)) && unit_active "$tid" "$run"; then   # a paused or sleeping task has no unit to stop
    touch "$TASKS/$tid/node-stop-requested"
    if ! detail=$(systemctl --user stop "$(unit_name "$tid" "$run").service" 2>&1); then
      rm -f "$TASKS/$tid/node-stop-requested"
      log_warn node_stop_failed "job=$jid" "error=$detail"; return
    fi
    if unit_active "$tid" "$run"; then
      rm -f "$TASKS/$tid/node-stop-requested"
      log_warn node_stop_failed "job=$jid" "error=unit remains active"; return
    fi
  fi
  state=$(task_field "$tid" STATUS)
  if [[ ! $state =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
    touch "$TASKS/$tid/stop-requested"
    meta_set "$tid" STATUS stopped
  fi
  node_scan_tasks
}

# node_handle_reply validates and handles only assignments and stop requests from this heartbeat.
node_handle_reply() {
  local reply=$1 stop job jid assignment existing agent at ids
  ids=$(jq -r '.Stops[].Request.ID' <<< "$reply")
  for stop in $ids; do
    node_handle_stop "$stop" "$(jq -r --arg id "$stop" '.Stops[] | select(.Request.ID == $id) | .Assignment' <<< "$reply")"
  done
  node_handle_controls "$reply"
  local wjid wtid   # wakes for this node's remote team members: each in its own process (_wake takes the task's lock)
  for wjid in $(jq -r '.Wakes // [] | .[]' <<< "$reply"); do
    wtid=$(jq -r --arg id "$wjid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    if [[ -n $wtid ]]; then "$SELF" _wake "$wtid" || log_warn node_wake_failed "job=$wjid" "task=$wtid"; fi
  done
  # paused members the lead's human resumes now (agent wake on its proxy task): each that is still paused
  for wjid in $(jq -r '.WakesNow // [] | .[]' <<< "$reply"); do
    wtid=$(jq -r --arg id "$wjid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -n $wtid && $(task_field "$wtid" STATUS) == paused ]] || continue
    "$SELF" wake "$wtid" > /dev/null || log_warn node_wake_now_failed "job=$wjid" "task=$wtid"
  done
  job=$(jq -c .Job <<< "$reply")
  [[ $job != null ]] || return 0
  jid=$(jq -r .Request.ID <<< "$job"); assignment=$(jq -r .Assignment <<< "$job")
  jq -e '.Request.ID | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")' <<< "$job" >/dev/null || die "invalid assignment ID"
  [[ $assignment =~ ^[1-9][0-9]*$ ]] || die "invalid assignment evidence"
  existing=$(jq -r --arg id "$jid" '.jobs[$id].assignment // 0' <<< "$NODE_STATE")
  [[ $existing != "$assignment" ]] || return 0
  at=$(jq -r '.History[-1].At // empty' <<< "$job")
  if agent=$(node_select_agent "$(jq -r .Request.Selector <<< "$job")"); then :; else agent=''; fi
  # Stream the request: escaped task text can exceed Linux's per-argument limit.
  NODE_STATE=$(printf '%s\n' "$job" "$NODE_STATE" | jq -cs --arg id "$jid" --argjson assignment "$assignment" --arg agent "$agent" --arg at "$at" \
    '.[1].jobs[$id]={assignment:$assignment,request:.[0].Request,agent:$agent,assigned_at:$at,task_id:"",branch:"",launched:false,start_acked:false,obsolete:false,pending:false,preparing:true,cursor:0} | .[1]'); node_save
  if [[ -z $agent ]]; then node_transition "$jid" failed '' 'no free local agent for assignment'; return; fi
  NODE_PREPARE_ERROR=''
  if prepare_job_task "$jid" "$agent" "$(jq -r .Request.Repository <<< "$job")" "$(jq -r .Request.BaseRef <<< "$job")" "$(jq -r '.Request.BaseSHA // ""' <<< "$job")" "$(jq -r .Request.Task <<< "$job")" "$assignment" "$(jq -r '.Request.Team // ""' <<< "$job")" "$(jq -r '.Request.Member // ""' <<< "$job")"; then
    node_bind_task "$jid" "$NEW_ID"
  else
    NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].preparing=false' <<< "$NODE_STATE")
    node_transition "$jid" failed '' "${NODE_PREPARE_ERROR:-node task preparation failed}"
  fi
}

# node_poll_remote_helpers submits queued remote helpers and polls terminal results.
node_poll_remote_helpers() {
  local caps='[]' list rows helper hid job_id req_json reply state node branch result pr rc diag
  if ((${#INSTANCE_CAPABILITIES[@]})); then caps=$(printf '%s\n' "${INSTANCE_CAPABILITIES[@]}" | jq -R . | jq -s .); fi
  if ! list=$(bus helper-remote-list --dir "$BUS_DIR" --capabilities "$caps"); then
    log_warn node_remote_helpers_list_failed
    return 0
  fi
  [[ -n $list && $list != "[]" ]] || return 0
  if ! rows=$(jq -c '.[]' <<< "$list"); then
    log_warn node_remote_helpers_parse_failed
    return 0
  fi

  while read -r helper; do
    [[ -n $helper ]] || continue
    hid=$(jq -r '.id' <<< "$helper")
    job_id=$(jq -r '.remote_job.ID // empty' <<< "$helper")
    local hstatus
    hstatus=$(jq -r '.status // empty' <<< "$helper")

    if [[ -z $job_id ]]; then
      rc=0
      req_json=$(bus helper-remote-prepare --dir "$BUS_DIR" --id "$hid" --instance "${INSTANCE_NAME:-node}" \
        --repo-url "$(github_repo_url "$(jq -r .worktree <<< "$helper")")" 2>&1) || rc=$?
      if ((rc != 0)); then
        if ((rc == BUS_STORAGE)); then
          log_warn node_helper_prepare_storage_failed "helper=$hid" "exit=$rc"
        else
          log_warn node_helper_prepare_failed "helper=$hid" "exit=$rc" "detail=$req_json"
          diag=${req_json:-remote preparation failed}
          try helper_finish_failed bus helper-remote-finish --dir "$BUS_DIR" --id "$hid" --state failed --node "" --branch "" --result "$diag"
        fi
        continue
      fi
      job_id=$(jq -r '.ID' <<< "$req_json")
    else
      req_json=$(jq -c '.remote_job' <<< "$helper")
    fi

    # Compare complete JSON documents via stdin so escaped maximum-size tasks fit.
    if [[ $hstatus == "queued" ]]; then
      if reply=$(printf '%s' "$req_json" | node_request --path /v1/jobs); then
        if ! printf '%s\n' "$req_json" "$reply" | jq -es 'length == 2 and .[1].Request == .[0] and (.[1].State|type == "string")' >/dev/null; then
          log_warn node_helper_reply_invalid "helper=$hid" "job=$job_id"
          continue
        fi
        log_info node_helper_submitted "helper=$hid" "job=$job_id"
        try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status running
      else
        rc=$?
        log_warn node_helper_submit_failed "helper=$hid" "job=$job_id" "exit=$rc"
        continue
      fi
    fi

    if reply=$(node_request --get --path "/v1/jobs/$job_id" < /dev/null); then
      if ! printf '%s\n' "$req_json" "$reply" | jq -es 'length == 2 and .[1].Request == .[0] and (.[1].State|type == "string")' >/dev/null; then
        log_warn node_helper_reply_invalid "helper=$hid" "job=$job_id"
        continue
      fi
      state=$(jq -r '.State' <<< "$reply")
      case "$state" in
        done|failed|stopped)
          node=$(jq -r '.Node // ""' <<< "$reply")
          branch=$(jq -r '.Branch // ""' <<< "$reply")
          result=$(jq -r '.Result // ""' <<< "$reply")
          pr=$(jq -r '.PRURL // ""' <<< "$reply")
          local finish_args=(helper-remote-finish --dir "$BUS_DIR" --id "$hid" --state "$state" --node "$node" --branch "$branch" --result "$result")
          [[ -z $pr ]] || finish_args+=(--pr "$pr")
          try helper_finish_failed bus "${finish_args[@]}"
          ;;
      esac
    else
      rc=$?
      log_warn node_helper_get_failed "helper=$hid" "job=$job_id" "exit=$rc"
    fi
  done <<< "$rows"
}

# Maximum wire payload size for POST /v1/sync in bytes (2 MiB).
NODE_SYNC_MAX_PAYLOAD_BYTES=2097152

# Soft budget threshold for batching files and logs in a single sync request (1,500,000 bytes).
NODE_SYNC_BATCH_BUDGET_BYTES=1500000

# Maximum file size sent in POST /v1/sync before tail truncation (256 KiB).
NODE_SYNC_MAX_FILE_BYTES=262144

# Maximum line count for activity.jsonl in POST /v1/sync.
NODE_SYNC_MAX_ACTIVITY_LINES=2000

# Maximum line count for err-*.log in POST /v1/sync.
NODE_SYNC_MAX_ERR_LOG_LINES=500

# Maximum log entries per sync request.
NODE_SYNC_MAX_LOG_ENTRIES=500

# Maximum single log entry size in bytes (64 KiB).
NODE_SYNC_MAX_LOG_ENTRY_BYTES=65536

# node_sync_save_json atomically writes JSON content to target path, optionally stamping mtime with ref_ts.
# It logs on failure without terminating node.
node_sync_save_json() {
  local target=$1 content=$2 ref_ts=${3:-}
  local tmpf
  # Suppress duplicate stderr diagnostics: the structured warning below reports a retryable save failure.
  # A sibling temporary file keeps replacement atomic even when the task directory is on another filesystem.
  if tmpf=$(mktemp "${target}.tmp.XXXXXX" 2>/dev/null); then
    if printf '%s\n' "$content" > "$tmpf" 2>/dev/null && \
       { [[ -z $ref_ts ]] || touch -d "$ref_ts" "$tmpf" 2>/dev/null; } && \
       mv -fT "$tmpf" "$target" 2>/dev/null; then
      return 0
    fi
    try node_sync_cleanup_failed rm -f "$tmpf"
  fi
  log_warn node_sync_save_failed "target=$target"
  return 0
}

# node_read_meta returns JSON object of allowed display metadata fields for a task.
node_read_meta() {
  local tid=$1 jid=$2
  local task_dir="$TASKS/$tid"
  local meta_f="$task_dir/meta.env"
  [[ -f $meta_f ]] || return 1
  (
    local run_start=""
    if [[ -f $task_dir/runner.pid ]]; then
      local errf rc=0
      if errf=$(mktemp); then
        run_start=$(date -Is -r "$task_dir/runner.pid" 2>"$errf") || rc=$?
        if ((rc != 0)); then
          # A finished runner can remove runner.pid between the existence check and stat.
          if [[ -e $task_dir/runner.pid ]]; then
            log_warn node_sync_run_start_failed "task=$tid" "exit=$rc"
          fi
          run_start=""
        fi
        rm -f "$errf"
      else
        log_warn node_sync_run_start_failed "task=$tid" "stage=temporary_file"
      fi
    fi
    local STATUS="" RUN="" AGENT="" TYPE="" MODEL="" NOTE="" PAUSE_REASON="" WAKE_AT="" CREATED="" FINISHED="" JOB_ID="" RESTARTS=""
    # shellcheck source=/dev/null
    source "$meta_f"
    local job_id=${JOB_ID:-$jid}
    jq -n \
      --arg STATUS "${STATUS:-}" \
      --arg RUN "${RUN:-}" \
      --arg AGENT "${AGENT:-}" \
      --arg TYPE "${TYPE:-}" \
      --arg MODEL "${MODEL:-}" \
      --arg NOTE "${NOTE:-}" \
      --arg PAUSE_REASON "${PAUSE_REASON:-}" \
      --arg WAKE_AT "${WAKE_AT:-}" \
      --arg CREATED "${CREATED:-}" \
      --arg FINISHED "${FINISHED:-}" \
      --arg RUN_START "$run_start" \
      --arg JOB_ID "$job_id" \
      --arg RESTARTS "${RESTARTS:-0}" \
      '{
        STATUS: $STATUS,
        RUN: $RUN,
        AGENT: $AGENT,
        TYPE: $TYPE,
        MODEL: $MODEL,
        NOTE: $NOTE,
        PAUSE_REASON: $PAUSE_REASON,
        WAKE_AT: $WAKE_AT,
        CREATED: $CREATED,
        FINISHED: $FINISHED,
        RUN_START: $RUN_START,
        JOB_ID: $JOB_ID,
        RESTARTS: $RESTARTS
      } | with_entries(select(.value != ""))'
  )
}

# node_mark_job_obsolete marks a job whose assignment or existence the lead rejected as obsolete.
node_mark_job_obsolete() {
  local jid=$1 rc=${2:-0}
  NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].obsolete=true | .jobs[$id].pending=false' <<< "$NODE_STATE")
  node_sync_save_json "$(node_jobs_file)" "$NODE_STATE"
  local prepared_task
  prepared_task=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
  if [[ -n $prepared_task && -f $TASKS/$prepared_task/meta.env ]] && [[ $(task_field "$prepared_task" RUN) == 0 ]]; then
    meta_set "$prepared_task" STATUS stopped
  fi
  log_warn node_assignment_obsolete "job=$jid" "exit=$rc"
}

# node_sync_terminal_unchanged checks a complete terminal snapshot without reading task artifacts.
node_sync_terminal_unchanged() {
  local task_dir=$1 manifest_file="$1/sync_manifest.json" newer
  [[ -f $manifest_file ]] || return 1
  if [[ $(jq_soft node_sync_manifest_invalid -r '.complete == true and (.metadata.STATUS | IN("done", "failed", "stopped", "hung", "excluded"))' "$manifest_file") != true ]]; then
    return 1
  fi
  if newer=$(find "$task_dir" -mindepth 1 -maxdepth 1 -type f ! -name '*.lock' ! -name 'sync_manifest.json*' -newer "$manifest_file" -print -quit); then
    [[ -z $newer ]]
  else
    log_warn node_sync_scan_failed "task=${task_dir##*/}"
    return 1
  fi
}

# node_sync_has_new_logs checks whether any local log file has unread lines beyond the saved sync cursor.
node_sync_has_new_logs() {
  local log_cursor_file="$BUS_DIR/sync_log_cursors.json"
  local cursors='{}'
  if [[ -f $log_cursor_file ]]; then
    cursors=$(jq_soft node_sync_cursor_invalid -c . "$log_cursor_file")
    [[ -n $cursors ]] || cursors='{}'
  fi
  local f log_p total_l cur
  for f in agent.jsonl agentbus.jsonl agentlive.jsonl; do
    log_p="$LOG_DIR/$f"
    [[ -f $log_p ]] || continue
    total_l=$(wc -l < "$log_p")
    cur=$(jq -r --arg f "$f" '.[$f] // 0' <<< "$cursors")
    [[ $cur =~ ^[0-9]+$ ]] || cur=0
    if (( total_l != cur )); then
      return 0
    fi
  done
  return 1
}

# node_send_sync sends one POST /v1/sync request payload bounded at 2 MiB.
node_send_sync() {
  local jid=$1 tid=$2 assignment=$3 meta_json=$4 files_json=$5 logs_json=$6
  local payload
  payload=$(jq -nc \
    --arg job "$jid" \
    --argjson assignment "$assignment" \
    --arg task "$tid" \
    --argjson meta "$meta_json" \
    '{
      Job: $job,
      Assignment: $assignment,
      TaskID: $task,
      Metadata: $meta
    }')

  payload=$(printf '%s\n%s\n%s\n' "$payload" "$files_json" "$logs_json" | jq -s \
    '.[0] + {Files: .[1], Logs: .[2]}')

  local byte_len
  byte_len=$(printf '%s' "$payload" | wc -c)
  if (( byte_len > NODE_SYNC_MAX_PAYLOAD_BYTES )); then
    log_warn node_sync_payload_oversized "job=$jid" "task=$tid" "bytes=$byte_len"
    return 1
  fi

  local reply rc=0
  if reply=$(printf '%s' "$payload" | node_request --path /v1/sync); then
    if ! jq -e 'has("OK") or has("Accepted") or (type == "object")' <<< "$reply" >/dev/null; then
      log_warn node_sync_invalid_reply "job=$jid" "task=$tid"
      return 1
    fi
    log_info node_sync_accepted "job=$jid" "target_task=$tid"
    return 0
  else
    rc=$?
    log_warn node_sync_failed "job=$jid" "task=$tid" "exit=$rc"
    return "$rc"
  fi
}

# node_sync_task sends incremental metadata, files and logs for one assigned job task.
node_sync_task() {
  local jid=$1 tid=$2 assignment=$3
  local task_dir="$TASKS/$tid"
  local manifest_file="$task_dir/sync_manifest.json"
  local prev_manifest='{"metadata":{},"files":{}}'
  local is_terminal_unchanged=false
  # A cleaned task still needs log-only delivery or reconciliation of its retained job.
  [[ -d $task_dir && -f $task_dir/meta.env ]] || is_terminal_unchanged=true
  if [[ -f $manifest_file ]]; then
    prev_manifest=$(jq_soft node_sync_manifest_invalid -c . "$manifest_file")
    [[ -n $prev_manifest ]] || prev_manifest='{"metadata":{},"files":{}}'
    if node_sync_terminal_unchanged "$task_dir"; then
      is_terminal_unchanged=true
    fi
  fi

  local current_meta='{}' prev_meta='{}' meta_diff='{}'
  local changed_files='[]' new_manifest_files='{}'
  local f fname cut byte_len sha256 prev_sha prev_cut base_num tmp_f tmp_cut file_obj total_l
  local content_raw decoded_len source_bytes
  local artifacts_complete=true

  prev_meta=$(jq -c '.metadata // {}' <<< "$prev_manifest")

  local snapshot_ts="" tmp_b epoch
  if [[ $is_terminal_unchanged == "true" ]]; then
    current_meta="$prev_meta"
    new_manifest_files=$(jq -c '.files // {}' <<< "$prev_manifest")
  else
    # Capture inode timestamp from sibling reference file before reading metadata or artifacts.
    # A conservative 1-second margin avoids missing same-tick writes under strict find -newer comparison.
    if tmp_b=$(mktemp "${manifest_file}.ref.XXXXXX" 2>/dev/null); then
      if epoch=$(date +%s -r "$tmp_b" 2>/dev/null); then
        snapshot_ts="@$((epoch - 1))"
      fi
      try node_sync_cleanup_failed rm -f "$tmp_b"
    fi
    if [[ -z $snapshot_ts ]]; then
      log_warn node_sync_artifact_failed "task=$tid" "stage=boundary"
      return 0
    fi
    current_meta=$(node_read_meta "$tid" "$jid") || return 0
    meta_diff=$(jq -nc --argjson cur "$current_meta" --argjson prev "$prev_meta" '
      (($cur | to_entries | map(select($prev[.key] != .value))) +
       ($prev | keys | map(select($cur[.] == null) | {key: ., value: ""}))) | from_entries
    ')

    for f in "$task_dir"/*; do
      [[ -f $f ]] || continue
      fname=$(basename "$f")
      case "$fname" in
        activity.jsonl|final.md|result.md) ;;
        prompt-[1-9]*.md|questions-[1-9]*.md|err-[1-9]*.log)
          base_num=${fname#*-}
          base_num=${base_num%.*}
          [[ $base_num =~ ^[1-9][0-9]*$ ]] || continue
          ;;
        *) continue ;;
      esac

      cut=false
      if ! source_bytes=$(wc -c < "$f"); then
        log_warn node_sync_artifact_failed "task=$tid" "file=$fname" "stage=size"
        artifacts_complete=false
        continue
      fi
      if ! tmp_f=$(mktemp "$BUS_DIR/sync_file.XXXXXX"); then
        log_warn node_sync_artifact_failed "task=$tid" "file=$fname" "stage=temporary_file"
        return 0
      fi
      # tail counts a partial final line; always applying it avoids wc -l's newline-only count.
      # Cap the stream before writing temporary data, then discard a split leading UTF-8 sequence.
      if {
        case $fname in
          activity.jsonl)
            tail -n "$NODE_SYNC_MAX_ACTIVITY_LINES" "$f" | tail -c "$NODE_SYNC_MAX_FILE_BYTES" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_f"
            ;;
          err-*.log)
            tail -n "$NODE_SYNC_MAX_ERR_LOG_LINES" "$f" | tail -c "$NODE_SYNC_MAX_FILE_BYTES" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_f"
            ;;
          *) tail -c "$NODE_SYNC_MAX_FILE_BYTES" "$f" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_f" ;;
        esac
      }; then
        byte_len=$(wc -c < "$tmp_f")
        if (( byte_len != source_bytes )); then cut=true; fi
      else
        log_warn node_sync_artifact_failed "task=$tid" "file=$fname" "stage=read"
        artifacts_complete=false
        try node_sync_cleanup_failed rm -f "$tmp_f"
        continue
      fi

      content_raw=$(jq -Rs . < "$tmp_f")
      decoded_len=$(printf '%s' "$content_raw" | jq -rj . | wc -c)
      if (( decoded_len > NODE_SYNC_MAX_FILE_BYTES )); then
        cut=true
        tmp_cut=$(mktemp "$BUS_DIR/sync_file.XXXXXX")
        printf '%s' "$content_raw" | jq -rj . | tail -c "$NODE_SYNC_MAX_FILE_BYTES" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_cut"
        mv "$tmp_cut" "$tmp_f"
        content_raw=$(jq -Rs . < "$tmp_f")
      fi

      if [[ $(wc -c < "$tmp_f") -ne $(printf '%s' "$content_raw" | jq -rj . | wc -c) ]]; then
        cut=true
      fi

      sha256=$(printf '%s' "$content_raw" | jq -rj . | sha256sum | awk '{print $1}')
      new_manifest_files=$(jq -c --arg name "$fname" --arg sha "$sha256" --argjson cut "$cut" \
        '. + {($name): {sha: $sha, cut: $cut}}' <<< "$new_manifest_files")

      prev_sha=$(jq -r --arg name "$fname" '.files[$name].sha // .files[$name] // empty' <<< "$prev_manifest")
      prev_cut=$(jq -r --arg name "$fname" '.files[$name].cut // false' <<< "$prev_manifest")
      if [[ $sha256 != "$prev_sha" || "$cut" != "$prev_cut" ]]; then
        file_obj=$(printf '%s' "$content_raw" | jq -c --arg name "$fname" --arg sha "$sha256" --argjson cut "$cut" \
          '{Name: $name, Content: ., SHA256: $sha, Cut: $cut}')
        changed_files=$(printf '%s\n%s\n' "$changed_files" "$file_obj" | jq -s '.[0] + [.[1]]')
      fi
      rm -f "$tmp_f"
    done
  fi

  local log_cursor_file="$BUS_DIR/sync_log_cursors.json"
  local cursors='{}'
  if [[ -f $log_cursor_file ]]; then
    cursors=$(jq_soft node_sync_cursor_invalid -c . "$log_cursor_file")
    [[ -n $cursors ]] || cursors='{}'
  fi

  local all_tids_json
  all_tids_json=$(jq_soft node_sync_jobs_invalid -c '[.jobs | to_entries[] | select((.value.obsolete|not) and .value.task_id) | .value.task_id]' <<< "$NODE_STATE")
  [[ -n $all_tids_json ]] || all_tids_json='[]'

  local logs_payload='[]'
  local new_cursors="$cursors"
  local log_bytes=0 log_count=0
  local log_p cur line entry entry_len
  for f in agent.jsonl agentbus.jsonl agentlive.jsonl; do
    log_p="$LOG_DIR/$f"
    [[ -f $log_p ]] || continue
    total_l=$(wc -l < "$log_p")
    cur=$(jq -r --arg f "$f" '.[$f] // 0' <<< "$cursors")
    [[ $cur =~ ^[0-9]+$ ]] || cur=0
    if (( total_l < cur )); then
      cur=0
    fi
    if (( total_l > cur )); then
      while IFS= read -r line; do
        cur=$((cur + 1))
        [[ -n $line ]] || continue
        entry=$(jq_soft node_sync_log_malformed -c --argjson tids "$all_tids_json" 'select(type == "object" and ((.level == "warn" or .level == "error") or (.task as $t | ($t != null and (any($tids[]; . == $t))))))' <<< "$line")
        if [[ -n $entry ]]; then
          entry_len=$(printf '%s' "$entry" | wc -c)
          if (( entry_len > NODE_SYNC_MAX_LOG_ENTRY_BYTES )); then
            log_warn node_sync_log_oversized "log=$f" "task=$tid"
            continue
          fi
          if (( log_bytes + entry_len > NODE_SYNC_BATCH_BUDGET_BYTES || log_count >= NODE_SYNC_MAX_LOG_ENTRIES )); then
            cur=$((cur - 1))
            break
          fi
          logs_payload=$(printf '%s\n%s\n' "$logs_payload" "$entry" | jq -s '.[0] + [.[1]]')
          log_bytes=$((log_bytes + entry_len))
          log_count=$((log_count + 1))
        fi
      done < <(tail -n +"$((cur + 1))" "$log_p")
      new_cursors=$(jq -c --arg f "$f" --argjson c "$cur" '. + {($f): $c}' <<< "$new_cursors")
      if (( log_count >= NODE_SYNC_MAX_LOG_ENTRIES || log_bytes > NODE_SYNC_BATCH_BUDGET_BYTES )); then
        break
      fi
    fi
  done

  if (( log_count == 0 )) && [[ $new_cursors != "$cursors" ]]; then
    node_sync_save_json "$log_cursor_file" "$new_cursors"
  fi

  local accepted_manifest_files
  accepted_manifest_files=$(jq -c '.files // {}' <<< "$prev_manifest")
  local current_manifest_meta
  current_manifest_meta="$prev_meta"

  local meta_diff_count changed_files_count
  meta_diff_count=$(jq 'length' <<< "$meta_diff")
  changed_files_count=$(jq 'length' <<< "$changed_files")

  if (( meta_diff_count == 0 && changed_files_count == 0 && log_count == 0 )); then
    # A clean comparison upgrades old manifests even when no upload is necessary.
    if [[ $is_terminal_unchanged != true ]]; then
      local complete_manifest
      complete_manifest=$(jq -nc --argjson metadata "$current_meta" --argjson files "$accepted_manifest_files" \
        --argjson complete "$artifacts_complete" '{metadata: $metadata, files: $files, complete: $complete}')
      node_sync_save_json "$manifest_file" "$complete_manifest" "$snapshot_ts"
    fi
    return 0
  fi

  local meta_len logs_len
  meta_len=$(printf '%s' "$meta_diff" | wc -c)
  logs_len=$(printf '%s' "$logs_payload" | wc -c)

  local req_files='[]' req_bytes=$(( meta_len + logs_len ))
  local sync_meta="$meta_diff"
  local sync_logs="$logs_payload"
  local num_files i f_obj f_bytes
  num_files=$(jq 'length' <<< "$changed_files")

  if (( num_files == 0 )); then
    if node_send_sync "$jid" "$tid" "$assignment" "$sync_meta" "[]" "$sync_logs"; then
      # Log-only delivery must not hide artifact changes made after the eligibility check.
      if [[ $is_terminal_unchanged != true ]]; then
        local final_manifest
        final_manifest=$(printf '%s\n%s\n' "$current_meta" "$accepted_manifest_files" | jq -s --argjson complete "$artifacts_complete" \
          '{metadata: .[0], files: .[1], complete: $complete}')
        node_sync_save_json "$manifest_file" "$final_manifest" "$snapshot_ts"
      fi
      if (( log_count > 0 )) || [[ $new_cursors != "$cursors" ]]; then
        node_sync_save_json "$log_cursor_file" "$new_cursors"
      fi
      return 0
    else
      local rc=$?
      if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
        node_mark_job_obsolete "$jid" "$rc"
      fi
      return "$rc"
    fi
  fi

  for (( i=0; i<num_files; i++ )); do
    f_obj=$(jq -c --argjson idx "$i" '.[$idx]' <<< "$changed_files")
    f_bytes=$(printf '%s' "$f_obj" | wc -c)

    # If adding this file would exceed budget and we already have items to send, flush current request
    if (( req_bytes + f_bytes > NODE_SYNC_BATCH_BUDGET_BYTES && ($(jq 'length' <<< "$req_files") > 0 || meta_diff_count > 0 || log_count > 0) )); then
      if node_send_sync "$jid" "$tid" "$assignment" "$sync_meta" "$req_files" "$sync_logs"; then
        current_manifest_meta="$current_meta"
        # Update accepted files from req_files
        local sent_f s_name s_sha s_cut j num_sent
        num_sent=$(jq 'length' <<< "$req_files")
        for (( j=0; j<num_sent; j++ )); do
          sent_f=$(jq -c --argjson idx "$j" '.[$idx]' <<< "$req_files")
          s_name=$(jq -r '.Name' <<< "$sent_f")
          s_sha=$(jq -r '.SHA256' <<< "$sent_f")
          s_cut=$(jq -r '.Cut' <<< "$sent_f")
          accepted_manifest_files=$(jq -c --arg n "$s_name" --arg s "$s_sha" --argjson c "$s_cut" \
            '. + {($n): {sha: $s, cut: $c}}' <<< "$accepted_manifest_files")
        done
        local partial_manifest
        partial_manifest=$(printf '%s\n%s\n' "$current_manifest_meta" "$accepted_manifest_files" | jq -s \
          '{metadata: .[0], files: .[1], complete: false}')
        node_sync_save_json "$manifest_file" "$partial_manifest" "$snapshot_ts"
        if (( log_count > 0 )); then
          node_sync_save_json "$log_cursor_file" "$new_cursors"
          log_count=0
        fi
        sync_meta='{}'
        sync_logs='[]'
        meta_diff_count=0
        req_files='[]'
        req_bytes=0
      else
        local rc=$?
        if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
          node_mark_job_obsolete "$jid" "$rc"
        fi
        return "$rc"
      fi
    fi

    req_files=$(printf '%s\n%s\n' "$req_files" "$f_obj" | jq -s '.[0] + [.[1]]')
    req_bytes=$(( req_bytes + f_bytes ))
  done

  # Flush final chunk if any items remain
  if (( $(jq 'length' <<< "$req_files") > 0 || meta_diff_count > 0 || log_count > 0 )); then
    if node_send_sync "$jid" "$tid" "$assignment" "$sync_meta" "$req_files" "$sync_logs"; then
      current_manifest_meta="$current_meta"
      local sent_f s_name s_sha s_cut j num_sent
      num_sent=$(jq 'length' <<< "$req_files")
      for (( j=0; j<num_sent; j++ )); do
        sent_f=$(jq -c --argjson idx "$j" '.[$idx]' <<< "$req_files")
        s_name=$(jq -r '.Name' <<< "$sent_f")
        s_sha=$(jq -r '.SHA256' <<< "$sent_f")
        s_cut=$(jq -r '.Cut' <<< "$sent_f")
        accepted_manifest_files=$(jq -c --arg n "$s_name" --arg s "$s_sha" --argjson c "$s_cut" \
          '. + {($n): {sha: $s, cut: $c}}' <<< "$accepted_manifest_files")
      done
      local final_manifest
      final_manifest=$(printf '%s\n%s\n' "$current_manifest_meta" "$accepted_manifest_files" | jq -s --argjson complete "$artifacts_complete" \
        '{metadata: .[0], files: .[1], complete: $complete}')
      node_sync_save_json "$manifest_file" "$final_manifest" "$snapshot_ts"
      if (( log_count > 0 )) || [[ $new_cursors != "$cursors" ]]; then
        node_sync_save_json "$log_cursor_file" "$new_cursors"
      fi
      return 0
    else
      local rc=$?
      if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
        node_mark_job_obsolete "$jid" "$rc"
      fi
      return "$rc"
    fi
  fi
  return 0
}

# node_sync_tasks syncs changed metadata, files and logs for assigned jobs.
node_sync_tasks() {
  local jid tid assignment ids pass=0 changed_state=false
  while (( pass < 2 )); do
    pass=$((pass + 1))
    changed_state=false
    ids=$(jq_soft node_sync_jobs_invalid -r '.jobs | to_entries[] | select((.value.obsolete|not) and .value.task_id and (.value.launched or .value.start_acked)) | .key' <<< "$NODE_STATE")
    for jid in $ids; do
      [[ -n $jid ]] || continue
      if jq -e --arg id "$jid" '.jobs[$id].obsolete // false' <<< "$NODE_STATE" >/dev/null; then
        continue
      fi
      tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
      assignment=$(jq -r --arg id "$jid" '.jobs[$id].assignment // 0' <<< "$NODE_STATE")
      [[ -n $tid && $assignment =~ ^[1-9][0-9]*$ ]] || continue

      if node_sync_terminal_unchanged "$TASKS/$tid" && ! node_sync_has_new_logs; then
        continue
      fi

      if node_sync_task "$jid" "$tid" "$assignment"; then
        :
      else
        local rc=$?
        if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
          changed_state=true
        fi
      fi
    done
    [[ $changed_state == true ]] || break
  done
}

# node_poll performs one durable recovery/report/assignment cycle without involving the ordinary MCP bus.
node_poll() {
  NODE_STATE=$(node_jobs_load)
  node_recover_tasks
  node_process_pending_launches
  node_scan_tasks
  node_flush_reports
  node_sync_tasks
  node_poll_remote_helpers
  local declaration reply
  declaration=$(node_heartbeat_json)
  if reply=$(printf '%s' "$declaration" | node_request --path /v1/heartbeat); then
    if jq -e 'has("Job") and (.Stops|type == "array")' <<< "$reply" >/dev/null; then
      log_info node_heartbeat_accepted
      node_clear_control_acks "$declaration"
      node_handle_reply "$reply"
      node_process_pending_launches
    else log_warn node_reply_invalid; fi
  else log_warn node_heartbeat_failed; fi
}

# cmd_node runs the configured node in the foreground; --once is a single recovery/poll cycle for diagnostics.
cmd_node() {
  [[ $# == 0 || ($# == 1 && $1 == --once) ]] || die "usage: agent node [--once]"
  exec 10>&-
  [[ -n $LEAD_URL ]] || die "LEAD_URL is not set: set it in config/agents.conf (e.g. LEAD_URL=http://lead-instance:7780)"
  [[ $NODE_POLL_SEC =~ ^[1-9][0-9]*$ ]] || die "NODE_POLL_SEC must be a positive integer"
  local repo declaration detail
  for repo in "${!NODE_REPOS[@]}"; do [[ ${NODE_REPOS[$repo]} == /* ]] || die "NODE_REPOS paths must be absolute: $repo"; done
  declaration=$(node_heartbeat_json)
  if ! detail=$(printf '%s' "$declaration" | node_request --validate 2>&1); then die "invalid capabilities: $detail"; fi
  node_lock
  log_info node_started "lead_url=$LEAD_URL" "poll_sec=$NODE_POLL_SEC"
  trap 'log_info node_stopped; exit 0' TERM INT
  trap 'node_stop_doorbell' EXIT
  local bell="" rc
  if [[ ${1:-} != --once ]]; then   # the lead's doorbell: when it rings, the next poll comes at once
    coproc DOORBELL { exec "$AGENTBUS_BIN" node-doorbell --url "$LEAD_URL" 8>&-; }
    bell=${DOORBELL[0]}
  fi
  while :; do
    node_poll
    [[ ${1:-} != --once ]] || break
    if [[ -n $bell ]]; then
      rc=0
      read -r -t "$NODE_POLL_SEC" -u "$bell" _ || rc=$?
      if ((rc == 0 || rc > 128)); then continue; fi   # rang, or the usual interval passed
      log_warn node_doorbell_lost; bell=""             # the doorbell ended: plain polling from now on
    fi
    sleep "$NODE_POLL_SEC" 8>&- &
    if wait $!; then :; else log_warn node_sleep_interrupted; fi
  done
}

cmd__agents_json() { # the configured agents and investigators as JSON lines (for agentlive web)
  local a tier inv
  for a in "${!AGENT_TYPE[@]}"; do
    tier=normal
    [[ " ${WORKER_AGENTS[*]} " == *" $a "* ]] && tier=worker
    jq -cn --arg name "$a" --arg type "${AGENT_TYPE[$a]}" --arg model "${AGENT_MODEL[$a]:-}" --arg tier "$tier" \
      --arg provider "$(agent_provider "$a")" '{name: $name, type: $type, model: $model, tier: $tier, provider: $provider}'
  done
  while read -r inv; do
    [[ -n $inv ]] || continue
    jq -cn --arg name "$inv" --arg type "${INVESTIGATORS_TYPE[$inv]}" --arg model "${INVESTIGATORS_MODEL[$inv]:-}" \
      '{name: $name, type: $type, model: $model, tier: "investigator", provider: ""}'
  done < <(investigator_names)
}

cmd_ack() { # <id | all> — acknowledges finished tasks (they disappear from agent live)
  local q=${1:?usage: agent ack <id|all>} d n=0
  if [[ $q == all ]]; then
    for d in "$TASKS"/*/; do
      [[ -f $d/meta.env ]] || continue
      case $(task_field "$(basename "$d")" STATUS) in
        done|failed|stopped|excluded|hung) : > "$d/acked"; n=$((n + 1)) ;;
      esac
    done
    echo "Acknowledged: $n"
  else
    local id; id=$(resolve_id "$q")
    case $(task_field "$id" STATUS) in
      done|failed|stopped|excluded|hung) : > "$TASKS/$id/acked"; echo "Acknowledged $id." ;;
      *) die "task $id is still running" ;;
    esac
  fi
}

# ------------------------------------------------------------------ account authentication

auth_classify() { # error-file → a category with the CLI's or provider's own words: "needs authentication — …",
  # "limit — …" (a quota, credits or a rate limit), "cannot reach the provider — …" or "other error: …"
  local text line
  text=$(tr '\n' ' ' < "$1" | tr -s ' ')
  line=$(grep -m1 -v '^[[:space:]]*$' "$1" | cut -c1-200)
  shopt -s nocasematch
  if [[ $text =~ (401|unauthori[sz]ed|authentication|not[[:space:]]logged[[:space:]]in|log[[:space:]]?in[[:space:]]again|/login|invalid[[:space:]](api|x-api)[[:space:]-]?key|oauth[[:space:]]token|token[[:space:]](has[[:space:]])?expired|expired[[:space:]]token|refresh[[:space:]]token|re-?authenticate|sign[[:space:]]in|credentials) ]]; then
    echo "needs authentication — ${line:-no message}"
  elif [[ $text =~ (rate[[:space:]_-]?limit|usage[[:space:]]limit|quota|429|too[[:space:]]many[[:space:]]requests|limit[[:space:]]reached|resource_exhausted|credits) ]]; then
    echo "limit — ${line:-no message}"
  elif [[ $text =~ (enotfound|econnrefused|econnreset|eai_again|could[[:space:]]not[[:space:]]resolve|network|connection[[:space:]](refused|reset)) ]]; then
    echo "cannot reach the provider — ${line:-no message}"
  else
    echo "other error: ${line:-unknown}"
  fi
  shopt -u nocasematch
}

api_error_text() { # body-file — the provider's own message from an API error body (not JSON: the raw body)
  local m=""
  # a body that is not JSON makes jq fail: then the raw body is the message
  m=$(jq -r '.error.message // .error.metadata.raw // .detail // .message // (.error | strings) // empty' "$1" 2>/dev/null) || m=""
  [[ -n $m ]] || m=$(tr -s '[:space:]' ' ' < "$1")
  printf '%s' "${m:0:200}"
}

agent_auth_target() { # agent → "provider<TAB>model": the model as its provider's API or CLI takes it ("" = CLI default)
  local type model
  if [[ -n ${AGENT_TYPE[$1]:-} ]]; then type=${AGENT_TYPE[$1]}; model=${AGENT_MODEL[$1]:-}
  else type=${INVESTIGATORS_TYPE[$1]:-}; model=${INVESTIGATORS_MODEL[$1]:-}; fi
  case $type in
    claude) printf 'anthropic\t%s' "$model" ;;
    codex) printf 'openai\t%s' "$model" ;;
    gemini) printf 'gemini\t%s' "$model" ;;
    opencode)
      case $model in
        openrouter/*) printf 'openrouter\t%s' "${model#openrouter/}" ;;
        deepinfra/*) printf 'deepinfra\t%s' "${model#deepinfra/}" ;;
        *) printf 'other\t%s' "$model" ;;
      esac ;;
    *) printf 'other\t%s' "$model" ;;
  esac
}

cmd__authcheck() { # provider | --agent NAME — one check, as a systemd --user unit (the agents' context)
  if [[ ${1:-} == --agent ]]; then
    local p model
    IFS=$'\t' read -r p model <<< "$(agent_auth_target "$2")"
    printf '%s\t%s\t%s\n' "$p" "${model:-(CLI default)}" "$(auth_probe "$p" "$model" agent)"
    return 0
  fi
  local m=""
  case $1 in
    anthropic) m=$AUTH_MODEL_ANTHROPIC ;;
    openai) m=$AUTH_MODEL_OPENAI ;;
    gemini) m=$AUTH_MODEL_GEMINI ;;
    openrouter) m=${AUTH_MODEL_OPENROUTER:-$(opencode_model_for openrouter)} ;;
    deepinfra) m=${AUTH_MODEL_DEEPINFRA:-$(opencode_model_for deepinfra)} ;;
  esac
  auth_probe "$1" "$m" provider
}

auth_probe() { # provider model mode(agent|provider) — one request to the provider; prints OK or what went wrong
  local p=$1 model=$2 tmp rc=0
  export LC_ALL=C.UTF-8
  if [[ -f $AGENTS_HOME/secrets.env ]]; then set -a; source "$AGENTS_HOME/secrets.env"; set +a; fi
  local v
  for v in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY CODEX_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY DEEPINFRA_API_KEY; do
    if [[ -z ${!v:-} ]]; then unset "$v"; fi
  done
  tmp=$(mktemp -d); cd "$tmp" || exit 1
  trap 'rm -rf "$tmp"' EXIT
  local q="Reply with the single word: OK"
  case $p in
    anthropic)
      [[ -x $CLAUDE_BIN ]] || { echo "other error: CLI not found ($CLAUDE_BIN)"; return; }
      timeout 180 "$CLAUDE_BIN" -p "$q" --output-format json --max-turns 1 \
        ${model:+--model "$model"} </dev/null >out 2>err || rc=$?
      # output that is not JSON is not an OK answer; it is kept as the error text (fallback: cat out)
      if ((rc == 0)) && [[ $(jq -r '.is_error | tostring' out 2>/dev/null) == false ]]; then echo OK; return; fi
      jq -r '.result // empty' out >> err 2>/dev/null || cat out >> err ;;
    openai)
      [[ -x $CODEX_BIN ]] || { echo "other error: CLI not found ($CODEX_BIN)"; return; }
      timeout 180 "$CODEX_BIN" exec --json --skip-git-repo-check \
        ${model:+-m "$model"} "$q" </dev/null >out 2>err || rc=$?
      if ((rc == 0)) && ! grep -q '"type":"\(turn.failed\|error\)"' out; then echo OK; return; fi
      jq_soft auth_check_parse -rR 'fromjson? | select(.type=="turn.failed" or .type=="error") | (.error.message // .message // empty)' < out >> err ;;
    gemini)
      [[ -x $AGY_BIN ]] || { echo "other error: CLI not found ($AGY_BIN)"; return; }
      timeout 180 "$AGY_BIN" -p "$q" --output-format json --print-timeout 2m \
        ${model:+--model "$model"} </dev/null >out 2>err || rc=$?
      # output that is not JSON is not an OK answer; it is kept as the error text (fallback: cat out)
      if ((rc == 0)) && [[ $(jq -r '.status // empty' out 2>/dev/null) == SUCCESS ]]; then echo OK; return; fi
      jq -r '.error // empty' out >> err 2>/dev/null || cat out >> err ;;
    openrouter|deepinfra)
      local key url code
      if [[ $p == openrouter ]]; then
        key=${OPENROUTER_API_KEY:-}; url=$AUTH_OPENROUTER_URL
      else
        key=${DEEPINFRA_API_KEY:-}; url=$AUTH_DEEPINFRA_URL
      fi
      [[ -n $key ]] || { echo "needs authentication — no ${p^^}_API_KEY in secrets.env"; return; }
      if [[ -z $model ]]; then
        if [[ $p == openrouter ]]; then   # no model configured: only check the key and its limit
          code=$(curl -sS -m 60 -o out -w '%{http_code}' -H "Authorization: Bearer $key" "$url/key" 2>err) || rc=$?
          if [[ $code == 200 ]]; then
            [[ $(jq -r '.data.limit_remaining // "x"' out) == 0 ]] && { echo "limit — the key's credit limit is used up (limit_remaining 0)"; return; }
            echo OK; return
          fi
        else
          echo "other error: no model to test (set AUTH_MODEL_DEEPINFRA or configure a deepinfra/... agent)"; return
        fi
      else
        code=$(jq -n --arg m "$model" --arg q "$q" '{model:$m, max_tokens:5, messages:[{role:"user", content:$q}]}' \
          | curl -sS -m 120 -o out -w '%{http_code}' -H "Authorization: Bearer $key" \
              -H 'Content-Type: application/json' -d @- "$url/chat/completions" 2>err) || rc=$?
        [[ $code == 200 ]] && { echo OK; return; }
      fi
      case $code in
        000|"") echo "cannot reach the provider — $(head -c 200 err)"; return ;;
        401|403) echo "needs authentication — HTTP $code: $(api_error_text out)"; return ;;
        *) echo "HTTP $code: $(api_error_text out)"; return ;;
      esac ;;
    *) echo "not checked — only claude, codex and gemini agents and opencode agents with openrouter/… or deepinfra/… models are"; return ;;
  esac
  if ((rc == 124)); then echo "other error: the request timed out"; return; fi
  auth_classify err
}

opencode_model_for() { # provider — the model (without prefix) of the first opencode agent using that provider
  local a
  for a in "${!AGENT_TYPE[@]}"; do
    if [[ ${AGENT_TYPE[$a]} == opencode && ${AGENT_MODEL[$a]:-} == "$1"/* ]]; then
      printf '%s' "${AGENT_MODEL[$a]#"$1"/}"; return
    fi
  done
}

cmd_authenticated() { # [--providers | agent...] — every agent with its own model (default), the given agents, or
  # one quick request per provider (--providers)
  [[ ${1:-} == --providers ]] && { auth_providers; return; }
  local agents=() a tmp r p model res
  if (($#)); then
    for a in "$@"; do
      [[ -n ${AGENT_TYPE[$a]:-} || -n ${INVESTIGATORS_TYPE[$a]:-} ]] || die "no agent '$a' in agents.conf (see: agent agents)"
      agents+=("$a")
    done
  else
    mapfile -t agents < <({ printf '%s\n' "${!AGENT_TYPE[@]}"; investigator_names; } | sort -u)
  fi
  tmp=$(mktemp -d)
  for a in "${agents[@]}"; do
    systemd-run --user --wait --pipe --quiet --collect --unit="agent-auth-$a-$$" \
      --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
      --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
      "$SELF" _authcheck --agent "$a" </dev/null >"$tmp/$a" 2>"$tmp/$a.err" &
  done
  wait
  printf '%-26s %-10s %-44s %s\n' AGENT PROVIDER MODEL RESULT
  for a in "${agents[@]}"; do
    r=""
    [[ -s $tmp/$a ]] && r=$(head -1 "$tmp/$a")
    if [[ -z $r ]]; then
      log_warn auth_check_failed "agent=$a" "stderr=$(head -c 2000 "$tmp/$a.err")"
      r=$'?\t?\tother error: could not run the check (systemd-run)'
    fi
    IFS=$'\t' read -r p model res <<< "$r"
    printf '%-26s %-10s %-44s %s\n' "$a" "$p" "$model" "$res"
  done
  rm -rf "$tmp"
}

auth_providers() { # one quick request per provider (agent authenticated --providers)
  local tmp p; tmp=$(mktemp -d)
  for p in anthropic openai gemini openrouter deepinfra; do
    systemd-run --user --wait --pipe --quiet --collect --unit="agent-auth-$p-$$" \
      --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
      --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
      "$SELF" _authcheck "$p" </dev/null >"$tmp/$p" 2>"$tmp/$p.err" &
  done
  wait
  for p in anthropic openai gemini openrouter deepinfra; do
    local r=""
    [[ -s $tmp/$p ]] && r=$(head -1 "$tmp/$p")
    if [[ -z $r ]]; then
      r="other error: could not run the check (systemd-run)"
      log_warn auth_check_failed "provider=$p" "stderr=$(head -c 2000 "$tmp/$p.err")"
    fi
    printf '%-10s %s\n' "$p" "$r"
  done
  rm -rf "$tmp"
}

cmd_team() { # [id [--close|--stop]] [--all]
  if [[ -n ${1:-} && $1 != --all && ${2:-} == --stop ]]; then
    team_stop "$1"
    return
  fi
  if [[ -n ${1:-} && $1 != --all && ${2:-} == --close ]]; then
    team_close "$1"
    return
  fi
  if [[ -n ${1:-} && $1 != --all ]]; then
    bus team-get --dir "$BUS_DIR" --team "$1" | jq -r '"\(.id) repo \(.repo), coordinator \(.lead // "—"), finished: \(.done)"'
    team_summary "$1"
  else
    bus team-list --dir "$BUS_DIR" "$@"
  fi
}

# team_stop team — persist stop intent for the whole team before any runner can react to another's exit.
# Include delegated descendants so a completed review cannot launch another round after this command. Only the tasks
# not finished before the stop become stopped: a done, failed, excluded or hung one keeps its result and time.
team_stop() {
  local team=$1 t m parent changed=1
  local -A owned=() was=()
  bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null || die "no team $team on the bus (agent team)"
  for t in $(team_tasks "$team"); do owned[$t]=1; done
  while ((changed)); do
    changed=0
    for m in "$TASKS"/*/meta.env; do
      [[ -f $m ]] || continue
      t=${m%/meta.env}; t=${t##*/}
      [[ -z ${owned[$t]:-} ]] || continue
      parent=$(task_field "$t" PARENT_TASK)
      if [[ -n $parent && -n ${owned[$parent]:-} ]]; then owned[$t]=1; changed=1; fi
    done
  done
  for t in "${!owned[@]}"; do
    was[$t]=$(task_field "$t" STATUS)
    touch "$TASKS/$t/stop-requested"
    meta_set "$t" TEAM_STOPPED 1
    meta_set "$t" AUTOPILOT_OFF 1
    meta_set "$t" REVIEW_PAIR_PENDING ""
    meta_set "$t" REVIEW_SLOT_PENDING ""
    meta_set "$t" AUTO_STAGE ""
  done
  finish_team "$team" "stopped by the human (agent team $team --stop)"
  for t in "${!owned[@]}"; do
    case ${was[$t]} in done|failed|stopped|excluded|hung) continue ;; esac   # finish_team keeps these too
    if [[ $(task_field "$t" KIND) == remote-member ]]; then
      meta_set "$t" STATUS stopped
      meta_set "$t" FINISHED "$(date -Is)"
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$t" AGENT)" --state stopped >/dev/null
    else
      cmd_stop "$t" >/dev/null
    fi
  done
  log_info team_stopped "team=$team"
  echo "Stopped team $team. Automatic resumption is disabled."
}

team_close() { # team — closes a team whatever its members do: local ones still at work or waiting are stopped,
  # then finish_team (sleeping ones done, its remote members' jobs ended, their grants revoked)
  local team=$1 t
  bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null || die "no team $team on the bus (agent team)"
  for t in $(team_tasks "$team"); do
    [[ $(task_field "$t" KIND) != remote-member ]] || continue
    case $(task_field "$t" STATUS) in
      new|starting|running|waiting|investigating|paused|interrupted)
        "$SELF" stop "$t" >/dev/null || log_warn team_close_stop_failed "task=$t" "team=$team" ;;
    esac
  done
  finish_team "$team" "closed by the human (agent team $team --close)"
  log_info team_closed "team=$team"
  echo "Closed team $team."
}

cmd_notes() { # [repo] [--section S] [--search Q] [-n N]
  local repo=""
  if [[ -n ${1:-} && $1 != -* ]]; then repo=$1; shift; fi
  if [[ -z $repo ]]; then
    local root; root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""   # outside a repository: no repository name
    [[ -n $root ]] && repo=$(basename "$(dirname "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)")")
  fi
  if [[ -z $repo ]]; then
    echo "Repository notebooks:"; bus notes --dir "$BUS_DIR" --list; return
  fi
  bus notes --dir "$BUS_DIR" --repo "$repo" "$@"
}

cmd_helpers() { bus helper-list --dir "$BUS_DIR" "$@"; }

cmd_transcript() { # <task|team|fragment> [--raw] — chronological log of a task or a team
  local q="" raw=0
  while (($#)); do
    case $1 in --raw) raw=1 ;; *) q=$1 ;; esac
    shift
  done
  [[ -n $q ]] || die "usage: agent transcript <task id | team id | fragment> [--raw]"
  local d first="" team=""
  for d in "$TASKS"/*/; do
    d=${d%/}; d=${d##*/}
    [[ -f $TASKS/$d/meta.env ]] || continue
    if [[ $d == *"$q"* || $(task_field "$d" TEAM) == *"$q"* ]]; then first=$d; team=$(task_field "$d" TEAM); break; fi
  done
  [[ -n $first ]] || die "no task or team matches: $q"

  # tasks: the given one or the whole team + investigations and worker requests made for them (recursively)
  local tasks=("$first") t p changed=1
  if [[ -n $team ]]; then
    tasks=()
    for d in "$TASKS"/*/; do
      d=${d%/}; d=${d##*/}
      [[ -f $TASKS/$d/meta.env && $(task_field "$d" TEAM) == "$team" ]] && tasks+=("$d")
    done
  fi
  while ((changed)); do
    changed=0
    for d in "$TASKS"/*/; do
      d=${d%/}; d=${d##*/}
      [[ -f $TASKS/$d/meta.env ]] || continue
      p=$(task_field "$d" PARENT_TASK)
      [[ -n $p ]] || continue
      [[ " ${tasks[*]} " == *" $d "* ]] && continue
      [[ " ${tasks[*]} " == *" $p "* ]] && { tasks+=("$d"); changed=1; }
    done
  done

  local names=() start="" end="" c f
  for t in "${tasks[@]}"; do
    names+=("$(task_field "$t" AGENT)")
    c=$(task_field "$t" CREATED | cut -c1-19 | tr T ' ')
    f=$(task_field "$t" FINISHED | cut -c1-19 | tr T ' ')
    [[ -z $start || $c < $start ]] && start=$c
    [[ -z $f ]] && f="9999-12-31 23:59:59"
    [[ -z $end || $f > $end ]] && end=$f
  done

  printf '# Transcript: %s%s\n# Tasks: %s\n# Window: %s — %s\n\n' "${team:-$first}" "$( ((raw)) && echo ' (full texts)')" \
    "${tasks[*]}" "$start" "${end/9999-12-31 23:59:59/still running}"
  {
    jq -rc --argjson n "$(printf '%s\n' "${names[@]}" | jq -R . | jq -sc .)" \
       --arg team "team:$team" --arg s "$start" --arg e "$end" '
       select(.ts >= $s and .ts <= $e)
       | select((.from as $f | $n | index($f)) or (.to as $t | $n | index($t)) or .to == $team)
       | "\(.ts)\t[bus] \(.from) → \(.to): \(.text | gsub("\n"; "\u001f    "))"' "$BUS_DIR/messages.jsonl" 2>/dev/null || log_warn transcript_bus_unreadable "file=$BUS_DIR/messages.jsonl"
    local label inv hid day file
    for t in "${tasks[@]}"; do
      file="$TASKS/$t/activity.jsonl"
      ((raw)) && [[ -s $TASKS/$t/activity-full.jsonl ]] && file="$TASKS/$t/activity-full.jsonl"
      [[ -f $file ]] || continue
      label=$(task_field "$t" AGENT)
      inv=$(task_field "$t" INV_ID); hid=$(task_field "$t" HELPER_ID)
      [[ -n $inv ]] && label="inv#$inv"
      [[ -n $hid ]] && label="$label/H$hid"
      day=$(task_field "$t" CREATED | cut -c1-10)
      jq -r '"\(.ts)\t\(.k)\t\(.t | gsub("\n"; "\u001f    "))"' "$file" | awk -F'\t' -v day="$day" -v who="$label" '
        { ts = $1
          if (length(ts) == 8) {            # old HH:MM:SS format — take the date from when the task was created
            if (prev != "" && ts < prev) { cmd = "date -d \"" day " +1 day\" +%F"; cmd | getline day; close(cmd) }
            prev = ts; ts = day " " ts
          }
          k = $2
          icon = (k=="text")?"»":(k=="cmd")?"$":(k=="edit")?"✎":(k=="mcp")?"⇄":(k=="err")?"✗":(k=="info")?"·":"⚙"
          printf "%s\t[%s] %s %s\n", ts, who, icon, $3 }'
    done
  } | sort -s -t$'\t' -k1,1 | sed 's/\t/  /' | tr '\037' '\n'
}

# ------------------------------------------------------------------ task archiving

archive_index() { # loads the metadata of all tasks into the IX_* arrays (a single pass)
  declare -gA IX_TEAM=() IX_RES=() IX_PAR=() IX_ST=() IX_KIND=()
  local d id team res par st kind
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    id=${d%/}; id=${id##*/}
    IFS=$'\t' read -r team res par st kind < <( source "$d/meta.env"
      printf '%s\t%s\t%s\t%s\t%s\n' "${TEAM:--}" "${RESUMED_FROM:--}" "${PARENT_TASK:--}" "${STATUS:--}" "${KIND:-worker}" )
    IX_TEAM[$id]=${team#-}; IX_RES[$id]=${res#-}; IX_PAR[$id]=${par#-}; IX_ST[$id]=${st#-}; IX_KIND[$id]=$kind
  done
}

archive_group() { # task → GROUP: the team/task with its whole resume chain, investigations and worker requests
  declare -gA GROUP=()
  local queue=("$1") t x
  while ((${#queue[@]})); do
    t=${queue[0]}; queue=("${queue[@]:1}")
    [[ -n ${GROUP[$t]:-} || -z ${IX_ST[$t]+x} ]] && continue
    GROUP[$t]=1
    [[ -n ${IX_RES[$t]} ]] && queue+=("${IX_RES[$t]}")
    [[ -n ${IX_PAR[$t]} ]] && queue+=("${IX_PAR[$t]}")
    for x in "${!IX_ST[@]}"; do
      [[ -n ${GROUP[$x]:-} ]] && continue
      if [[ ( -n ${IX_TEAM[$t]} && ${IX_TEAM[$x]} == "${IX_TEAM[$t]}" ) || ${IX_RES[$x]} == "$t" || ${IX_PAR[$x]} == "$t" ]]; then
        queue+=("$x")
      fi
    done
  done
}

sevenzip() { command -v 7z || command -v 7za || command -v 7zr; }

archive_one() { # start-task — packs the whole group into tasks-archived/<name>.7z and removes it from tasks/
  local start=$1 t
  archive_group "$start"
  local ids=() active=()
  for t in "${!GROUP[@]}"; do
    ids+=("$t")
    case ${IX_ST[$t]} in new|starting|running|waiting|investigating|sleeping|paused) active+=("$t (${IX_ST[$t]})") ;; esac
  done
  if ((${#active[@]})); then
    echo "agent: skipped — the group is still active: ${active[*]} (agent stop first)" >&2
    return 1
  fi
  mapfile -t ids < <(printf '%s\n' "${ids[@]}" | sort)
  local root=${ids[0]} name keys=() k
  name=${IX_TEAM[$root]:-$root}
  local zip; zip=$(sevenzip) || die "7z (p7zip) not found"
  local arch_dir="$AGENTS_HOME/tasks-archived"; mkdir -p "$arch_dir"
  local archive_file="$arch_dir/$name.7z" i=1
  while [[ -e $archive_file ]]; do archive_file="$arch_dir/$name-$((i++)).7z"; done
  local stage; stage=$(mktemp -d)
  mkdir -p "$stage/tasks" "$stage/checkpoints"

  # full transcripts (bus + activity) — while the task directories still exist
  for t in "${ids[@]}"; do
    [[ ${IX_KIND[$t]} == worker ]] || continue
    k=${IX_TEAM[$t]:-$t}
    [[ " ${keys[*]} " == *" $k "* ]] && continue
    keys+=("$k")
    ( cmd_transcript "$k" --raw ) > "$stage/transcript-$k.txt" || log_warn transcript_failed "key=$k" "effect=archive without a transcript of $k"
  done
  for k in "${keys[@]}"; do
    for t in team task; do
      [[ -f $BUS_DIR/checkpoints/$t-$k.md ]] && cp "$BUS_DIR/checkpoints/$t-$k.md" "$stage/checkpoints/"
    done
  done
  # A team member's own record is keyed by its task ID, not by the team ID used for the shared checkpoint.
  for t in "${ids[@]}"; do
    [[ -f $BUS_DIR/checkpoints/task-$t.md ]] && cp "$BUS_DIR/checkpoints/task-$t.md" "$stage/checkpoints/"
  done
  for t in "${ids[@]}"; do cp -a "$TASKS/$t" "$stage/tasks/"; done

  ( cd "$stage" && "$zip" a -t7z -mx=7 "$archive_file" . >/dev/null ) || { rm -rf "$stage"; die "packing failed"; }
  "$zip" t "$archive_file" >/dev/null || { rm -rf "$stage"; rm -f "$archive_file"; die "archive test of $archive_file failed — nothing was removed"; }
  rm -rf "$stage"

  # only after a successful test: worktrees (branches stay), task directories, checkpoints
  local wt root_repo n_wt=0
  for t in "${ids[@]}"; do
    wt=$(task_field "$t" WORKTREE); root_repo=$(task_field "$t" REPO_ROOT)
    if [[ -n $wt && -d $wt && -n $root_repo ]]; then
      if [[ -d $wt ]]; then
        try worktree_remove_failed git -C "$root_repo" worktree remove --force "$wt"
        [[ -d $wt ]] || n_wt=$((n_wt + 1))
      fi
      try worktree_prune_failed git -C "$root_repo" worktree prune
    fi
  done
  for t in "${ids[@]}"; do rm -rf "${TASKS:?}/$t"; done
  for k in "${keys[@]}"; do rm -f "$BUS_DIR/checkpoints/team-$k.md" "$BUS_DIR/checkpoints/task-$k.md" "$TASKS/.team-$k.stuck"; done
  for t in "${ids[@]}"; do rm -f "$BUS_DIR/checkpoints/task-$t.md"; done
  for t in "${ids[@]}"; do unset "IX_ST[$t]"; done
  log_info archived "archive=$archive_file" "tasks=${ids[*]}" "worktrees_removed=$n_wt"
  printf '%s  (%s, tasks: %d, worktrees removed: %d)\n' "$archive_file" "$(du -h "$archive_file" | cut -f1)" "${#ids[@]}" "$n_wt"
}

cmd_discard() { # <id>... — removes tasks that never started (status new): worktree, branch, task directory
  (($#)) || die "usage: agent discard <id>..."
  local ref id st
  for ref in "$@"; do
    id=$(resolve_id "$ref")
    st=$(task_field "$id" STATUS)
    [[ $st == new ]] || die "$id has already run (status $st): use agent archive for finished tasks"
    discard_task "$id"
    echo "discarded $id"
  done
}

cmd_archive() { # <task|team> | --finished
  local q=${1:?usage: agent archive <task|team> | --finished}
  archive_index
  if [[ $q == --finished ]]; then
    local t done_n=0 skip=0
    for t in $(printf '%s\n' "${!IX_ST[@]}" | sort); do
      [[ -n ${IX_ST[$t]+x} ]] || continue          # already archived in this pass
      archive_group "$t"
      local x all=1
      for x in "${!GROUP[@]}"; do
        case ${IX_ST[$x]} in done|failed|stopped|excluded|hung) ;; *) all=0 ;; esac
      done
      if ((all)); then archive_one "$t" && done_n=$((done_n + 1)); else
        for x in "${!GROUP[@]}"; do unset "IX_ST[$x]"; done; skip=$((skip + 1)); fi
    done
    echo "Archived: $done_n, skipped (still active): $skip"
    return
  fi
  local d start=""
  for d in "${!IX_ST[@]}"; do
    if [[ $d == *"$q"* || ${IX_TEAM[$d]} == *"$q"* ]]; then start=$d; break; fi
  done
  [[ -n $start ]] || die "no task or team matches: $q"
  archive_one "$start"
}

cmd_bus() { "$AGENTBUS_BIN" status --dir "$BUS_DIR"; echo; "$AGENTBUS_BIN" log --dir "$BUS_DIR" -n "${1:-30}"; }

cmd_say() {
  local to=${1:?usage: agent say <agent|all|team:ID> "text"}; shift
  (($#)) || die "give the message text"
  rm -f "$TASKS"/.team-*.stuck
  "$AGENTBUS_BIN" send --dir "$BUS_DIR" --from "${USER:-mat}" --to "$to" "$*"
}

usage() {
  cat <<'EOF'
agent run <agent> "task" | -f file.md      start a task (run inside the repository)
agent status                              task list
agent agents                              configured agents and whether they are busy
agent show <id>                           task details and the last message
agent answer <id>                         open the questions in $EDITOR, validate, resume
agent resume <id> ["note"]                resume after all questions are answered
agent log <id> [--raw]                    follow the runner log (structured records rendered)
agent stop <id>                           stop a run
agent pause <team>                        pause a team: its runs stop, held; nothing of it starts
agent allow <team> [path...]              let a team's rounds change an existing test or a check (AGENTS.md)
agent gate [task] [--wait]                run the repository's gate in a task's worktree, one at a time; recorded
agent gate-status [task]                  whether the task's HEAD has a recorded gate pass on a clean tree
agent unpause <team>                      go on: the paused runs resume where they stopped
agent stop --running                      stop EVERYTHING that is active (teams, agents, investigations, queues)
agent clean <id>                          remove the task's worktree (the branch is kept)
agent inv [number | --all]                investigation queue / full record of one
agent dispatch                            manually start the next queued investigation (fallback)
agent live [--feed] [--remind MIN]        live panel (or an event stream with --feed)
agent web                                 web interface in the foreground (normally: agentweb.service)
agent lead                                the lead's job listener in the foreground (normally: agentlead.service; LEAD_LISTEN)
agent node                                the node daemon in the foreground (normally: agentnode.service; LEAD_URL)
agent jobs [<id>]                         remote jobs on the lead (or this node's jobs)
agent jobs --cancel <id>                  cancel a remote job on the lead
agent nodes                               registered nodes on the lead
agent kick <task>                         cut a run short: a team member sleeps (the team can wake it), solo: stopped
agent round-check <team|task>             a round's card: its board, members' work not in its PR, files two branches changed, workers' items
agent spend [--days N] [--daily]          where the money goes, by model: a paid model's spending, a subscription's equivalent
agent debug <team|task> [--full] [--out file]  everything to diagnose a team or a task, in one file, secrets redacted
agent debug --agent NAME | --model NAME [--days N] [--last N] [--full] [--out file]  a model's whole record
agent tokens <team|task>                  the tokens its runs used: per task (a team's helpers and investigations too), in all
agent tokens --round <id>                 the tokens of a round's tasks (Round: <id>, and <id>/…): per task, role, model, in all
agent tokens --runs <task>                a task's tokens per run, its steps (tool calls) and input per step: the costly runs
agent wake <task>                         resume a paused task now, not at its pause's end (a remote member's: on its node)
agent round-size <task>                   size of a task's change against the round limit (README "Rounds")
agent run --need <caps> <agent|normal|worker> "task"   submit a remote job with required capabilities
agent run --on <instance> <agent> "task"               submit a remote job pinned to an instance
agent run --resume <team|task> --same-round  continue an unmerged round (e.g. review fixes) on the same branches
agent run --last-team [--same-round] ["…"]  resume the newest team of this repository (no ID to look up)
agent ack <id|all>                        acknowledge finished tasks (they leave the panel)
agent run --team a,b[,c] [--verify|--autopilot] "task"  team; --verify: an investigator reviews the PR at the end;
                                           --autopilot: two independent reviews, the merge, the next round
agent run --investigation --team "A" "topic"     one or more investigators create and review a PR, then finish
agent autopilot <team> [on|off]            a team's --autopilot: shown, or switched (off: no merge nor next round by itself)
agent run --resume <team|task> ["addition"]  resume from the last checkpoint (same branches)
agent team [id | --all]                   teams and their members
agent team <id> --close                                close a team: stop its local members, end its remote ones' jobs
agent team <id> --stop                    stop the whole team; disable automatic resumption
agent helpers [--all]                     worker requests made by normal models
agent transcript <id|team> [--raw]        full chronological log of a task/team (bus + activity)
agent archive <id|team> | --finished      pack a finished task (with its resume chain) into tasks-archived/*.7z
agent discard <id>...                     remove tasks that never started (worktree, branch, task directory)
agent notes [repo] [--section S] [--search Q] [-n N]   persistent repository notebook
agent authenticated [agent...]            check every agent's (or the given agents') model, with the provider's own message
agent authenticated --providers           one quick request per provider account
agent bus [N]                             bus state and the last N agent messages
agent say <agent|all|team:ID> "text"     message agents through the bus
<id> may be an unambiguous fragment of a task ID.
EOF
}

main() {
  local cmd=${1:-help}; (($#)) && shift
  case $cmd in
    run)     cmd_run "$@" ;;
    status|ls) cmd_status ;;
    agents)  cmd_agents ;;
    show)    cmd_show "$@" ;;
    answer)  cmd_answer "$@" ;;
    resume)  cmd_resume "$@" ;;
    log)     cmd_log "$@" ;;
    stop)    cmd_stop "$@" ;;
    pause)   cmd_pause "$@" ;;
    allow)   cmd_allow "$@" ;;
    gate)    cmd_gate "$@" ;;
    gate-status) cmd_gate_status "$@" ;;
    _board_done_check) cmd__board_done_check "$@" ;;
    _task_of_dir) task_of_dir "${1:-$PWD}"; echo ;;   # the task whose worktree a directory is in, or nothing
    unpause) cmd_unpause "$@" ;;
    clean)   cmd_clean "$@" ;;
    bus)     cmd_bus "$@" ;;
    inv)     cmd_inv "$@" ;;
    live)    cmd_live "$@" ;;
    web)     cmd_web ;;
    lead)    cmd_lead ;;
    node)    cmd_node "$@" ;;
    jobs)    cmd_jobs "$@" ;;
    nodes)   cmd_nodes ;;
    kick)    cmd_kick "$@" ;;
    wake)    cmd_wake "$@" ;;
    tokens)  cmd_tokens "$@" ;;
    debug)   cmd_debug "$@" ;;
    spend)   cmd_spend "$@" ;;
    round-check) cmd_round_check "$@" ;;
    round-size) cmd_round_size "$@" ;;
    _agents-json) cmd__agents_json ;;
    ack)     cmd_ack "$@" ;;
    authenticated) cmd_authenticated "$@" ;;
    team)    cmd_team "$@" ;;
    autopilot) cmd_autopilot "$@" ;;
    helpers) cmd_helpers "$@" ;;
    transcript) cmd_transcript "$@" ;;
    archive) cmd_archive "$@" ;;
    discard) cmd_discard "$@" ;;
    _dispatch-helpers) dispatch_helpers ;;
    notes)   cmd_notes "$@" ;;
    _wake)   cmd__wake "$@" ;;
    _remote_member) cmd__remote_member "$@" ;;
    _precheck) cmd__precheck "$@" ;;
    _merge) cmd__merge "$@" ;;
    _fixpass) cmd__fixpass "$@" ;;
    _supervise) cmd__supervise ;;
    _answers_saved) cmd__answers_saved "$@" ;;
    _remote_questions) cmd__remote_questions "$@" ;;
    _remote_questions_ready) cmd__remote_questions_ready "$@" ;;
    _authcheck) cmd__authcheck "$@" ;;
    dispatch) cmd_dispatch ;;
    say)     cmd_say "$@" ;;
    _runner) cmd__runner "$@" ;;
    _investigation-team) cmd__investigation_team "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

# run the command when executed; tests source the script to call its functions directly
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
