#!/usr/bin/env bash
# shellcheck disable=SC1010  # "status=done" assigns the word "done"; it is not a loop keyword
# agent — runs and coordinates LLM coding agents (Claude Code, Codex CLI, Antigravity, OpenCode) on this host.
# Every task gets its own git worktree + branch and runs in the background as a systemd --user unit;
# questions/answers live in .md files, and a notification is sent after every run.
set -euo pipefail
shopt -u patsub_replacement 2>/dev/null || :   # bash < 5.2 has no such option (nothing to disable)

# agent as gh — the agents' gh: the runner puts a link named gh to this script first on their CLI's PATH. Text on GitHub reaches them only from the trusted
# accounts (AGENT_GITHUB_TRUSTED_RESOLVED, set by the runner). Comments and reviews by anyone else — and the trusted
# accounts' own that begin with "ignore this mate" (a way to check this on GitHub's real data) — are left out and
# logged, on open, closed and merged PRs and issues alike. A fork's PR, or one opened by an unknown account, is not
# shown at all (its description, diff or checkout), nor listed — the lists are the trusted accounts' PRs and issues
# only. A GraphQL query for comments or reviews is refused: the agents
# read them through the ways filtered here. Everything else goes to the real gh (AGENT_REAL_GH).
agent_gh() {
  set +e   # each failure is handled where it happens

real=${AGENT_REAL_GH:-}
[[ -n $real && -x $real ]] || { echo "agent-gh: the real gh is not known (AGENT_REAL_GH)" >&2; exit 127; }
trusted_json=$(printf '%s' "${AGENT_GITHUB_TRUSTED_RESOLVED:-}" | jq -Rc 'split(" ") | map(select(. != ""))')
LOG="${AGENTS_HOME:-$HOME/agents}/logs/agent.jsonl"

# log event message key=value… — one warning line in the agents' log, as bin/agent writes them
gh_log() {
  local ev=$1 msg=$2; shift 2
  jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg ev "$ev" --arg msg "$msg" \
    '{ts: $ts, level: "warn", component: "agent-gh", event: $ev, message: $msg}
     + ([$ARGS.positional[] | capture("^(?<k>[^=]+)=(?<v>.*)$"; "s") | {(.k): .v}] | add // {})' --args "$@" >> "$LOG" \
    || echo "agent-gh: cannot write the log $LOG" >&2
}

# who wrote an entry; whether a trusted account marked it to be ignored; whether it is from a trusted account; kept
JQDEF='def who: (.author.login // .user.login // "");
def marked: ((.body // "") | test("^\\s*ignore this mate"; "i"));
def trusted: (who as $w | $t | index($w)) != null;
def keep: trusted and (marked | not);
def entries: if type == "array" then .[]
  elif type == "object" and has("body") and (has("user") or has("author")) and (has("comments") | not) then .
  elif type == "object" then (.comments // [])[], (.reviews // [])[], (.latestReviews // [])[]
  else empty end;'

# report json — logs each comment or review that is left out
gh_report() {
  local kind author id
  while IFS=$'\t' read -r kind author id; do
    if [[ $kind == unknown ]]; then
      gh_log github_comment_ignored "there is unknown comment from unknown user and it's ignored" "author=$author" "id=$id"
    else
      gh_log github_comment_marked_ignored "a comment that begins with \"ignore this mate\" is ignored" "author=$author" "id=$id"
    fi
  done < <(jq -r --argjson t "$trusted_json" "$JQDEF"'
    entries | select(keep | not) | [(if trusted then "marked" else "unknown" end), who, ((.id // .databaseId // "") | tostring)] | @tsv' <<< "$1")
}

# filter json — the same JSON without what is left out
gh_filter() {
  jq -c --argjson t "$trusted_json" "$JQDEF"'
    if type == "array" then map(select(keep))
    elif type == "object" and has("body") and (has("user") or has("author")) and (has("comments") | not) then (if keep then . else empty end)
    elif type == "object" then
      (if has("comments") then .comments |= map(select(keep)) else . end)
      | (if has("reviews") then .reviews |= map(select(keep)) else . end)
      | (if has("latestReviews") then .latestReviews |= map(select(keep)) else . end)
    else . end' <<< "$1"
}

# show json jq-expression — the filtered JSON, through the caller's --jq if any
gh_show() {
  if [[ -n $2 ]]; then jq -r "$2" <<< "$1"; else printf '%s\n' "$1"; fi
}

if [[ ${1:-} == api ]]; then
  shift
  args=() jqexpr="" path=""
  while (($#)); do
    case $1 in
      --jq|-q) jqexpr=${2:-}; shift 2 ;;
      --jq=*) jqexpr=${1#--jq=}; shift ;;
      -t|--template|--template=*) echo "agent-gh: --template is not available to the agents; use --jq" >&2; exit 2 ;;
      *) if [[ -z $path && $1 != -* ]]; then path=$1; fi; args+=("$1"); shift ;;
    esac
  done
  if [[ $path == graphql ]]; then
    if [[ " ${args[*]} " =~ (comments|reviews|reviewThreads|timelineItems|body) ]]; then
      gh_log github_graphql_refused "a GraphQL query for comments, reviews or bodies is refused: the agents read them through gh pr view --json or gh api …/comments"
      echo "agent-gh: a GraphQL query for comments, reviews or bodies is refused — use gh pr view --json comments,reviews or gh api …/comments" >&2
      exit 1
    fi
  elif [[ $path =~ (^|/)(issues|pulls)/([0-9]+/)?(comments|reviews)(/|$|\?) || $path =~ /reviews/[0-9]+/comments ]]; then
    out=$("$real" api "${args[@]}") || exit $?
    out=$(jq -sc 'if length == 1 then .[0] elif all(.[]; type == "array") then add else .[0] end' <<< "$out")   # --paginate
    gh_report "$out"
    gh_show "$(gh_filter "$out")" "$jqexpr"
    exit 0
  fi
  if [[ -n $jqexpr ]]; then exec "$real" api "${args[@]}" --jq "$jqexpr"; fi
  exec "$real" api "${args[@]}"
fi

if [[ ${1:-} == pr || ${1:-} == issue ]] && [[ ${2:-} == list ]]; then   # the lists: the trusted accounts' only
  kind=$1
  shift 2
  rest=() jsonf="" jqexpr=""
  while (($#)); do
    case $1 in
      --json) jsonf=${2:-}; shift 2 ;;
      --json=*) jsonf=${1#--json=}; shift ;;
      --jq|-q) jqexpr=${2:-}; shift 2 ;;
      --jq=*) jqexpr=${1#--jq=}; shift ;;
      -t|--template|--template=*) echo "agent-gh: --template is not available to the agents; use --jq" >&2; exit 2 ;;
      -w|--web) echo "agent-gh: --web is not available to the agents" >&2; exit 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  want=${jsonf:-number,title,state,url}
  if [[ $kind == pr ]]; then
    [[ -n $jsonf ]] || want+=,headRefName
    want+=,author,isCrossRepository
  else
    want+=,author
  fi
  want=$(tr ',' '\n' <<< "$want" | awk 'NF && !seen[$0]++' | paste -sd, -)
  out=$("$real" "$kind" list "${rest[@]}" --json "$want") || exit $?
  while IFS=$'\t' read -r fork num author; do
    if [[ $fork == true ]]; then
      gh_log "github_${kind}_ignored" "there is a $kind from a fork and it's ignored" "author=$author" "number=$num"
    else
      gh_log "github_${kind}_ignored" "there is unknown $kind from unknown user and it's ignored" "author=$author" "number=$num"
    fi
  done < <(jq -r --argjson t "$trusted_json" '.[] | select((.isCrossRepository // false) or (((.author.login // "") as $a | $t | index($a)) == null))
             | [((.isCrossRepository // false) | tostring), (.number | tostring), (.author.login // "")] | @tsv' <<< "$out")
  out=$(jq -c --argjson t "$trusted_json" 'map(select(((.isCrossRepository // false) | not) and (((.author.login // "") as $a | $t | index($a)) != null)))' <<< "$out")
  if [[ -n $jsonf ]]; then gh_show "$out" "$jqexpr"; exit 0; fi
  jq -r '.[] | ["#\(.number)", (.title // ""), (.headRefName // ""), (.state // "")] | @tsv' <<< "$out"
  exit 0
fi

if [[ ${1:-} == pr || ${1:-} == issue ]] && [[ ${2:-} == view || ${2:-} == diff || ${2:-} == checkout ]]; then
  kind=$1 verb=$2
  shift 2
  pos=() rest=() jsonf="" jqexpr="" comments=0
  while (($#)); do
    case $1 in
      --json) jsonf=${2:-}; shift 2 ;;
      --json=*) jsonf=${1#--json=}; shift ;;
      --jq|-q) jqexpr=${2:-}; shift 2 ;;
      --jq=*) jqexpr=${1#--jq=}; shift ;;
      -t|--template|--template=*) echo "agent-gh: --template is not available to the agents; use --jq" >&2; exit 2 ;;
      -c|--comments) comments=1; shift ;;
      -R|--repo) rest+=("$1" "${2:-}"); shift 2 ;;
      -*) rest+=("$1"); shift ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  idf=author
  [[ $kind == issue ]] || idf=author,isCrossRepository
  who=$("$real" "$kind" view "${pos[@]}" "${rest[@]}" --json "$idf") || exit $?
  if ! jq -e --argjson t "$trusted_json" '((.isCrossRepository // false) | not) and (((.author.login // "") as $a | $t | index($a)) != null)' <<< "$who" > /dev/null; then
    gh_log pr_untrusted_ignored "a $kind from a fork or opened by an unknown account is not shown to the agents" \
      "author=$(jq -r '.author.login // ""' <<< "$who")" "cross_repository=$(jq -r '.isCrossRepository // false' <<< "$who")" "ref=${pos[*]}"
    echo "agent-gh: this $kind is from a fork or opened by an account that is not trusted — it is not shown" >&2
    exit 1
  fi
  if [[ $verb != view ]]; then exec "$real" "$kind" "$verb" "${pos[@]}" "${rest[@]}"; fi
  if [[ -n $jsonf ]]; then
    out=$("$real" "$kind" view "${pos[@]}" "${rest[@]}" --json "$jsonf") || exit $?
    gh_report "$out"
    gh_show "$(gh_filter "$out")" "$jqexpr"
    exit 0
  fi
  if ((comments)); then
    "$real" "$kind" view "${pos[@]}" "${rest[@]}" || exit $?   # its description: a trusted account's
    cf=comments
    [[ $kind == issue ]] || cf=comments,reviews
    out=$("$real" "$kind" view "${pos[@]}" "${rest[@]}" --json "$cf") || exit $?
    gh_report "$out"
    printf '\n-- comments and reviews (the trusted accounts'"'"' only) --\n'
    jq -r '[(.comments // [])[], (.reviews // [])[] | select((.body // "") != "")] | .[] | "\(.author.login // .user.login): \(.body)\n"' <<< "$(gh_filter "$out")"
    exit 0
  fi
  exec "$real" "$kind" view "${pos[@]}" "${rest[@]}"
fi

exec "$real" "$@"
}
if [[ ${0##*/} == gh ]]; then agent_gh "$@"; exit $?; fi

AGENTS_HOME="${AGENTS_HOME:-$HOME/agents}"
CONF="$AGENTS_HOME/agents.conf"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
TASKS="$AGENTS_HOME/tasks"
PROMPTS="$AGENTS_HOME/prompts"
BUS_DIR="$AGENTS_HOME/bus"

# ------------------------------------------------------------------ structured logging
#
# Every event of the script is one JSON object per line in $AGENTS_HOME/logs/agent.jsonl (for Promtail,
# Vector, vmagent ...) and in the systemd journal (`logger`, SYSLOG_IDENTIFIER=agent). Inside a runner the
# record also goes to the task's runner.log, which `agent log` renders readably. Human-facing output of
# interactive commands stays plain text.

LOG_DIR="$AGENTS_HOME/logs"
AGENT_SUBCOMMAND="${1:-}"   # the subcommand being run (recorded in every log record)
RUNNER_ID=""                # task ID while running as a runner (set by cmd__runner)

# log_event level event [key=value ...] — writes one structured log record
log_event() {
  local level=$1 event=$2; shift 2
  local args=(--arg level "$level" --arg event "$event" --arg sub "$AGENT_SUBCOMMAND" --arg task "$RUNNER_ID")
  local prog='{ts: (now | todate), level: $level, component: "agent", event: $event,
               pid: '"$$"', subcommand: $sub} + (if $task != "" then {task: $task} else {} end)'
  local kv i=0
  for kv in "$@"; do
    args+=(--arg "k$i" "${kv%%=*}" --arg "v$i" "${kv#*=}")
    prog+=" + {(\$k$i): \$v$i}"
    i=$((i + 1))
  done
  local line
  if ! line=$(jq -nc "${args[@]}" "$prog" 2>&1); then
    echo "agent: cannot encode the log record '$event': $line" >&2
    return 0
  fi
  if ! { mkdir -p "$LOG_DIR" && printf '%s\n' "$line" >> "$LOG_DIR/agent.jsonl"; } 2>/dev/null; then
    echo "agent: cannot write $LOG_DIR/agent.jsonl" >&2
  fi
  if command -v logger >/dev/null; then
    local prio=info
    case $level in warn) prio=warning ;; error) prio=err ;; debug) prio=debug ;; esac
    logger -t agent -p "user.$prio" -- "$line" 2>/dev/null || echo "agent: cannot write to the system journal" >&2
  fi
  if [[ -n $RUNNER_ID ]]; then
    printf '%s\n' "$line" >&3   # fd 3 is the task's runner.log (opened by cmd__runner)
  elif [[ -z ${LOG_QUIET:-} && ( $level == warn || $level == error ) ]] && [[ -t 2 ]]; then
    echo "agent: $level: $event${*:+ ($*)}" >&2
  fi
}
log_info()  { log_event info "$@"; }
log_warn()  { log_event warn "$@"; }
log_error() { log_event error "$@"; }

# try event command [args...] — runs a command whose failure must not stop the caller (a side effect such as
# a bus notice or a cleanup step). A failure is logged as a warning with its exit code and stderr; stdout is
# passed through. Commands whose failure must stop the caller are not run through try.
try() {
  local event=$1; shift
  local errf rc=0
  errf=$(mktemp)
  "$@" 2>"$errf" || rc=$?
  if ((rc != 0)); then
    log_warn "$event" "exit_code=$rc" "command=$*" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  return 0
}

# jq_soft event jq-args... — jq for data that may legitimately lack a field (CLI outputs): a missing field yields
# empty output, but input that is not valid JSON is logged as a warning instead of being silently ignored.
jq_soft() {
  local event=$1; shift
  local errf rc=0 out
  errf=$(mktemp)
  out=$(jq "$@" 2>"$errf") || rc=$?
  if ((rc != 0)); then
    log_warn "$event" "exit_code=$rc" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  printf '%s' "$out"
}

die() { LOG_QUIET=1 log_error command_failed "message=$*"; echo "agent: $*" >&2; exit 1; }

[[ -f $CONF ]] || die "missing configuration: $CONF"
# shellcheck source=/dev/null
source "$CONF"
declare -p AGENT_EXTRA_ARGS &>/dev/null || declare -A AGENT_EXTRA_ARGS=()
declare -p AGENT_MODEL &>/dev/null || declare -A AGENT_MODEL=()
declare -p NORMAL_AGENTS &>/dev/null || NORMAL_AGENTS=()
declare -p WORKER_AGENTS &>/dev/null || WORKER_AGENTS=()

agent_provider() { # agent name → provider (for load balancing)
  case ${AGENT_TYPE[$1]:-${INVESTIGATORS_TYPE[$1]:-}} in
    claude) echo anthropic ;;
    codex) echo openai ;;
    gemini) echo google ;;
    opencode) local m=${AGENT_MODEL[$1]:-}; echo "${m%%/*}" ;;
    *) echo other ;;
  esac
}

agent_tier() { # agent name → normal | worker (cheap model)
  local a
  for a in "${WORKER_AGENTS[@]}"; do [[ $a == "$1" ]] && { echo worker; return; }; done
  echo normal
}
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
CODEX_BIN="${CODEX_BIN:-$HOME/.local/bin/codex}"
AGENTBUS_BIN="${AGENTBUS_BIN:-$HOME/.local/bin/agentbus}"
RUN_PATH="${RUN_PATH:-$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin}"
# Notifications: NOTIFY_CMD is called with the path of a notification file (first line = title/thread,
# the rest = body). Empty = notifications are only written to NOTIFY_DIR. Legacy configs that set
# NOTIFY_SCRIPT (run inside NOTIFY_DIR with the file name) keep working.
NOTIFY_CMD="${NOTIFY_CMD:-}"
# Questions for the human: a new questions file opens in the VS Code window connected to this host, if there is one
# (vscode | off); the VS Code server directories searched for its remote CLI; how long the coordinator waits for the
# members' recommendations before it asks the human.
QUESTIONS_EDITOR="${QUESTIONS_EDITOR:-vscode}"
VSCODE_SERVER_DIRS="${VSCODE_SERVER_DIRS:-$HOME/.vscode-server $HOME/.vscode-server-insiders $HOME/.cursor-server}"
AGENT_CONSULT_MIN="${AGENT_CONSULT_MIN:-5}"
NOTIFY_DIR="${NOTIFY_DIR:-$AGENTS_HOME/notifications}"
NOTIFY_SCRIPT="${NOTIFY_SCRIPT:-}"
NOTIFY_MAX_CHARS="${NOTIFY_MAX_CHARS:-1500}"
# Language of what only the human reads: questions and the final message of a run (the notification).
AGENT_LANGUAGE="${AGENT_LANGUAGE:-English}"
# Language of everything that ends up in the repository or on GitHub: commit messages, PR titles and
# descriptions, PR reviews, reports and code comments.
REPO_LANGUAGE="${REPO_LANGUAGE:-English}"
# Git identity of the agents' commits, set by the runner for every git command of a run. %a = agent name.
GIT_NAME_FORMAT="${GIT_NAME_FORMAT:-%a (team-agents)}"
# E-mail of the agents' commits — e.g. the noreply address of a GitHub account for the agents: GitHub attributes
# a commit to the account that owns its e-mail. %a = agent name. Empty = <agent>@team-agents.invalid (an address
# nobody owns) — never the human's e-mail from git config.
GIT_EMAIL="${GIT_EMAIL:-}"
# Private SSH key that signs the agents' commits (its public key added on GitHub as a signing key of the account
# that owns GIT_EMAIL shows the commits as "Verified"). Empty = commits are not signed — even if the human's git
# config signs every commit.
GIT_SIGNING_KEY="${GIT_SIGNING_KEY:-}"
# Environment notes for the agents: shared resources (probes, serial ports, test hosts), how to use them.
ENV_NOTES_FILE="${ENV_NOTES_FILE:-$AGENTS_HOME/hardware.md}"
BRANCH_PREFIX="${BRANCH_PREFIX:-agents}"
CLAUDE_MAX_TURNS="${CLAUDE_MAX_TURNS:-300}"
AGY_BIN="${AGY_BIN:-$HOME/.local/bin/agy}"
OPENCODE_BIN="${OPENCODE_BIN:-$HOME/.opencode/bin/opencode}"
OPENCODE_BASH_TIMEOUT_MS="${OPENCODE_BASH_TIMEOUT_MS:-600000}"
AGY_PRINT_TIMEOUT="${AGY_PRINT_TIMEOUT:-8h}"
INVESTIGATOR_NAME="${INVESTIGATOR_NAME:-investigator}"
INVESTIGATOR_TYPE="${INVESTIGATOR_TYPE:-claude}"
INVESTIGATOR_MODEL="${INVESTIGATOR_MODEL:-}"
INVESTIGATOR_EXTRA_ARGS="${INVESTIGATOR_EXTRA_ARGS:-}"
INVESTIGATION_QUEUE_MAX="${INVESTIGATION_QUEUE_MAX:-3}"
AGENT_HANG_MIN="${AGENT_HANG_MIN:-30}"          # watchdog: this many minutes without any activity = hang
AGENT_HANG_STRIKES="${AGENT_HANG_STRIKES:-3}"    # this many consecutive hangs without progress = agent is hung
# Wake-loop guard: a team member that keeps being woken without doing anything is paused (see wake_loop_check).
AGENT_IDLE_RUN_SEC="${AGENT_IDLE_RUN_SEC:-120}"           # a run shorter than this, without a commit or a bus message, is idle
AGENT_WAKE_LOOP_MAX="${AGENT_WAKE_LOOP_MAX:-4}"           # this many idle runs in a row pause the member
AGENT_WAKE_RATE_MAX="${AGENT_WAKE_RATE_MAX:-30}"          # more runs than this within 10 minutes pause the member
AGENT_WAKE_LOOP_PAUSE_MIN="${AGENT_WAKE_LOOP_PAUSE_MIN:-15}" # how long the guard pauses it
# A run stopped by an exhausted quota or usage limit pauses the task until the limit resets (see quota_reset_seconds);
# this is the pause when the CLI does not say when that is.
AGENT_QUOTA_PAUSE_MIN="${AGENT_QUOTA_PAUSE_MIN:-30}"
AGENT_RELEASE_PAUSE_MIN="${AGENT_RELEASE_PAUSE_MIN:-20}"     # a team member paused longer gives its board items back
AGENT_SUPERVISE_GRACE_SEC="${AGENT_SUPERVISE_GRACE_SEC:-120}" # agent _supervise: a run this young may not have its unit yet
AGENT_RESTART_MAX="${AGENT_RESTART_MAX:-2}"             # a task goes on after this many restarts of its machine; one more fails it
AGENT_RESTART_GRACE_MIN="${AGENT_RESTART_GRACE_MIN:-10}" # lead: a remote member whose node is away longer is put out of its team
AGENT_TEAM_ABANDON_MIN="${AGENT_TEAM_ABANDON_MIN:-60}"   # an open team with no local member at work or asleep this long is reported
AGENT_RATE_LIMIT_PAUSE_MIN="${AGENT_RATE_LIMIT_PAUSE_MIN:-5}"   # a rate limit (HTTP 429) without a reset time
AGENT_NETWORK_PAUSE_MIN="${AGENT_NETWORK_PAUSE_MIN:-15}"        # the network or the provider unreachable: wait, then go on
AGENT_NETWORK_MAX_PAUSES="${AGENT_NETWORK_MAX_PAUSES:-12}"      # that many such pauses in a row fail the task
AGENT_LIMIT_TAIL_LINES="${AGENT_LIMIT_TAIL_LINES:-30}"           # how much of the end of stderr shows a provider limit
# Investigators: list format (INVESTIGATORS_*) or the legacy single investigator (INVESTIGATOR_*)
declare -p INVESTIGATORS_TYPE &>/dev/null || declare -A INVESTIGATORS_TYPE=()
declare -p INVESTIGATORS_MODEL &>/dev/null || declare -A INVESTIGATORS_MODEL=()
declare -p INVESTIGATORS_EXTRA_ARGS &>/dev/null || declare -A INVESTIGATORS_EXTRA_ARGS=()
if ((${#INVESTIGATORS_TYPE[@]} == 0)); then
  INVESTIGATORS_TYPE[$INVESTIGATOR_NAME]=$INVESTIGATOR_TYPE
  INVESTIGATORS_MODEL[$INVESTIGATOR_NAME]=$INVESTIGATOR_MODEL
  INVESTIGATORS_EXTRA_ARGS[$INVESTIGATOR_NAME]=$INVESTIGATOR_EXTRA_ARGS
fi
INV_SLOTS=${#INVESTIGATORS_TYPE[@]}
investigator_names() { printf '%s\n' "${!INVESTIGATORS_TYPE[@]}" | sort; }
is_investigator() { [[ -n ${INVESTIGATORS_TYPE[$1]:-} ]]; }
AGENTLIVE_BIN="${AGENTLIVE_BIN:-$HOME/.local/bin/agentlive}"
LIVE_REMIND_MIN="${LIVE_REMIND_MIN:-1}"
# Web interface (agent web, agentweb.service): a loopback address only — remote access through `tailscale serve`;
# the Tailscale logins and the tagged devices (names or tag:…) let in that way; the URL under which you reach it
# (links in notifications, "" = none).
AGENT_WEB_LISTEN="${AGENT_WEB_LISTEN:-127.0.0.1:8787}"
AGENT_WEB_USERS="${AGENT_WEB_USERS:-}"
AGENT_WEB_DEVICES="${AGENT_WEB_DEVICES:-}"
AGENT_WEB_URL="${AGENT_WEB_URL:-}"
# Several instances (agentlead.service, `agent lead`; README "Several instances"): LEAD_LISTEN is this instance's
# Tailscale address when it is a lead ("" = not a lead); LEAD_NODES lists the devices allowed to take jobs (names or
# tag:…); INSTANCE_NAME is this instance's name on the lead; NODE_TTL_SEC is how long a silent node stays online.
LEAD_LISTEN="${LEAD_LISTEN:-}"
LEAD_NODES="${LEAD_NODES:-}"
INSTANCE_NAME="${INSTANCE_NAME:-${HOSTNAME%%.*}}"   # the short host name: bash sets HOSTNAME; no command is run
NODE_TTL_SEC="${NODE_TTL_SEC:-90}"
# Rounds (README "Rounds"): the change of a task — added + deleted lines against its base, tests included, without
# the files matched by ROUND_EXCLUDE — has a soft and a hard limit; ROUND_MAX_LINES_REPO overrides the hard limit
# per repository (0 = no limit). Over it, a finished round goes back to be split, at most ROUND_BOUNCES times.
ROUND_SOFT_LINES="${ROUND_SOFT_LINES:-2000}"
# The team reports the protocol writes into the worktree are not code to review: never counted, whatever
# ROUND_EXCLUDE says (agents.conf often sets ROUND_EXCLUDE itself).
ROUND_ALWAYS_EXCLUDE=".agents/reports/"
# --verify: a review with critical or major findings wakes the team with them, at most VERIFY_MAX_FIX_PASSES
# times; then the human (AGENT_HUMAN_GITHUB, default: the owner of the GitHub repository) is mentioned on the PR.
VERIFY_MAX_FIX_PASSES="${VERIFY_MAX_FIX_PASSES:-2}"
# Before a review (--verify, --autopilot): a round's head must pass the repository's gate and add tests for a change
# of code; else the team goes on with the reason, at most AGENT_PRECHECK_MAX times, then the human decides.
AGENT_REVIEW_GATE="${AGENT_REVIEW_GATE:-auto}"        # the gate's command: auto = `make gate` where the repository has it; off = none
AGENT_REVIEW_GATE_MIN="${AGENT_REVIEW_GATE_MIN:-30}"  # its time limit, in minutes
AGENT_STAGE_POLL_SEC="${AGENT_STAGE_POLL_SEC:-2}"     # how often the gate's progress is shown on the dashboard
AGENT_PRECHECK_MAX="${AGENT_PRECHECK_MAX:-2}"         # how many times a round goes back for its gate or its tests
# --autopilot: after two ready-to-merge reviews the script merges — not a PR touching one of these paths (a directory
# ends with /), nor one changing existing tests: those wait for the human
AUTO_MERGE_HUMAN_PATHS="${AUTO_MERGE_HUMAN_PATHS-install.sh .github/ systemd/ AGENTS.md}"
# --autopilot leaves to the human a round that changes existing tests (yes), or merges it as any other (no)
AUTO_MERGE_HOLD_TEST_CHANGES="${AUTO_MERGE_HOLD_TEST_CHANGES:-yes}"
AGENT_REVIEW_WAIT_MIN="${AGENT_REVIEW_WAIT_MIN:-30}"  # a review pair waiting longer for two free investigators is reported
AGENT_HUMAN_GITHUB="${AGENT_HUMAN_GITHUB:-}"
ROUND_MAX_LINES="${ROUND_MAX_LINES:-3000}"
ROUND_EXCLUDE="${ROUND_EXCLUDE:-*_gen.go go.sum package-lock.json vendor/}"
ROUND_BOUNCES="${ROUND_BOUNCES:-2}"
declare -p ROUND_MAX_LINES_REPO >/dev/null 2>&1 || declare -gA ROUND_MAX_LINES_REPO=()   # a query: set in agents.conf?
# NODE_REPOS: repositories a node may run jobs for, name → local clone path (empty: no job is accepted).
declare -p NODE_REPOS >/dev/null 2>&1 || declare -gA NODE_REPOS=()
# Node daemon (agentnode.service, `agent node`; README "Several instances"): LEAD_URL is the lead's HTTP address
# ("" = not a node); NODE_POLL_SEC is how often the node sends its heartbeat; INSTANCE_CAPABILITIES declares what this node
# can run (os:..., arch:..., build:..., test:..., hw:..., net:...).
LEAD_URL="${LEAD_URL:-}"
NODE_POLL_SEC="${NODE_POLL_SEC:-5}"
declare -p INSTANCE_CAPABILITIES >/dev/null 2>&1 || declare -ga INSTANCE_CAPABILITIES=()
AUTH_MODEL_ANTHROPIC="${AUTH_MODEL_ANTHROPIC:-haiku}"
AUTH_MODEL_OPENAI="${AUTH_MODEL_OPENAI:-gpt-6-luna}"
AUTH_MODEL_GEMINI="${AUTH_MODEL_GEMINI:-}"
AUTH_MODEL_OPENROUTER="${AUTH_MODEL_OPENROUTER:-}"   # empty = model of the first openrouter/... agent in agents.conf
AUTH_MODEL_DEEPINFRA="${AUTH_MODEL_DEEPINFRA:-}"
AUTH_OPENROUTER_URL="${AUTH_OPENROUTER_URL:-https://openrouter.ai/api/v1}"        # the APIs agent authenticated asks
AUTH_DEEPINFRA_URL="${AUTH_DEEPINFRA_URL:-https://api.deepinfra.com/v1/openai}"   # (tests: a fake on loopback)     # empty = model of the first deepinfra/... agent in agents.conf
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# bus forwards a local command without the admission lock, including any children it wakes.
bus() { "$AGENTBUS_BIN" "$@" 10>&-; }

# `agent stop --running` in progress: blocks waking, queues and notifications (flag valid for 2 min)
stopping() {
  local f="$AGENTS_HOME/.stop-all"
  [[ -f $f ]] && (( $(date +%s) - $(stat -c %Y "$f") < 120 ))
}

# ------------------------------------------------------------------ task metadata (meta.env)

meta_file() { printf '%s/%s/meta.env' "$TASKS" "$1"; }

meta_set() { # id key value — sets one KEY=value (printf %q) line; writers of one task are serialised by a lock
  local f; f=$(meta_file "$1")
  (
    # a run, agent stop and the bus's wake-ups write the same file: without the lock an update gets lost
    flock -w 30 9 || { log_error meta_lock_timeout "file=$f" "key=$2"; exit 1; }
    # Each step reports its own failure: a failed write must never be moved over the old file. Inside the
    # conditional the subshell does not stop at the first error, so the status is checked explicitly.
    local tmp="$f.tmp.$$"
    # grep exits 1 when no other line remains — that is not an error
    if ! { { grep -v "^$2=" "$f" || (($? == 1)); } && printf '%s=%q\n' "$2" "$3"; } > "$tmp"; then
      rm -f "$tmp"
      log_error meta_write_failed "file=$f" "key=$2"
      exit 1
    fi
    if ! mv "$tmp" "$f"; then
      rm -f "$tmp"
      log_error meta_write_failed "file=$f" "key=$2"
      exit 1
    fi
    if [[ $2 == STATUS ]]; then
      local jid="" journal_rc
      # Exit 1 means an ordinary task without a job marker; a read failure must not be hidden.
      if jid=$(grep "^JOB_ID=" "$f"); then
        jid=${jid#JOB_ID=}
        if [[ -n $jid ]]; then
          local now record
          now=$(date -u +"%Y-%m-%dT%H:%M:%S.%NZ")
          record=$(jq -cn --arg state "$3" --arg at "$now" '{state:$state,at:$at}') || exit 1
          if ! printf '%s\n' "$record" >> "$TASKS/$1/job_transitions.jsonl"; then
            log_error meta_write_failed "file=$f" "key=job_transitions"
            exit 1
          fi
        fi
      else
        journal_rc=$?
        if ((journal_rc != 1)); then
          log_error meta_write_failed "file=$f" "key=JOB_ID"
          exit 1
        fi
      fi
    fi
  ) 9> "$f.lock"
}

meta_load() { # loads the task's meta.env variables into the current shell
  local f; f=$(meta_file "$1")
  [[ -f $f ]] || die "no such task: $1"
  # shellcheck source=/dev/null
  # shellcheck source=/dev/null
  source "$f"
}

# shellcheck source=/dev/null
task_field() { ( source "$(meta_file "$1")"; printf '%s' "${!2:-}" ) }

resolve_id() { # exact task ID or an unambiguous fragment → task ID
  local q=$1 m=()
  [[ -d $TASKS/$q ]] && { printf '%s' "$q"; return; }
  local d
  for d in "$TASKS"/*/; do
    d=${d%/}; d=${d##*/}
    [[ $d == *"$q"* ]] && m+=("$d")
  done
  ((${#m[@]} == 1)) || die "no unique task matches '$q' (${#m[@]} matches)"
  printf '%s' "${m[0]}"
}

unit_name() { printf 'agent-%s-r%s' "$1" "$2"; }

unit_active() { # id run
  # a query: "inactive" and "no such unit" both mean the run is not active
  systemctl --user is-active --quiet "$(unit_name "$1" "$2").service" 2>/dev/null
}

agent_running_task() { # agent name → ID of the task it is running (or nothing)
  local d
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    local id st run ag
    id=${d%/}; id=${id##*/}
    ag=$(task_field "$id" AGENT); st=$(task_field "$id" STATUS); run=$(task_field "$id" RUN)
    if [[ $ag == "$1" && ($st == running || $st == starting) ]] && unit_active "$id" "$run"; then
      printf '%s' "$id"; return 0
    fi
    if [[ $ag == "$1" && $st == sleeping ]]; then   # a sleeping team member keeps its agent reserved
      printf '%s' "$id"; return 0
    fi
    # A prepared node job awaiting lead start acknowledgement keeps its agent reserved before run 1
    local jid
    jid=$(task_field "$id" JOB_ID)
    if [[ $ag == "$1" && -n $jid && $run -eq 0 && ($st == new || $st == starting || $st == running) ]]; then
      printf '%s' "$id"; return 0
    fi
  done
  return 1
}

# ------------------------------------------------------------------ questions

count_questions() { # file → number of "## N." questions (0 for a missing file)
  [[ -f $1 ]] || { echo 0; return; }
  grep -cE '^## [0-9]+\.' "$1" || (($? == 1))   # grep -c exits 1 when it counts 0
}

# The labels of a questions file. They are fixed English words whatever language the questions are in; spaces
# inside the asterisks are tolerated. "Answer" and "Odpowiedź" are the verdict labels of older versions.
Q_VERDICT_RE='^[*][*][[:space:]]*(Verdict|Answer|Odpowiedź)[[:space:]]*:[[:space:]]*[*][*]'
Q_RECOMMENDED_RE='^[*][*][[:space:]]*Recommended[[:space:]]*:[[:space:]]*[*][*]'
Q_LABEL_RE='^[*][*][[:space:]]*[[:alpha:]][[:alpha:] ]*:[[:space:]]*[*][*]'
Q_ANSWERED_RE='^[*][*][[:space:]]*ANSWERED[[:space:]]*[*][*][[:space:]]*$'

validate_answers() { # file → 0 when every question has a non-empty verdict
  [[ -s $1 ]] || { echo "questions file missing: $1" >&2; return 1; }
  awk -v ver="$Q_VERDICT_RE" -v lab="$Q_LABEL_RE" -v done_re="$Q_ANSWERED_RE" '
    function check() {
      if (!inq) return
      if (!mark) { bad++; printf "  question %s: missing **Verdict:** line\n", num > "/dev/stderr" }
      else if (ans ~ /^[[:space:]]*$/) { bad++; printf "  question %s: no verdict\n", num > "/dev/stderr" }
    }
    /^## [0-9]+\./ {
      check(); inq = 1; mark = 0; inv = 0; ans = ""; q++
      num = $2; sub(/\.$/, "", num); next
    }
    $0 ~ done_re { next }
    $0 ~ ver { if (inq) { mark = 1; inv = 1; line = $0; sub(ver, "", line); ans = ans line }; next }
    $0 ~ lab { inv = 0; next }   # another label (e.g. **Recommended:**) is not part of the verdict
    { if (inq && inv) ans = ans $0 }
    END {
      check()
      if (q == 0) { print "  no questions in the \"## N. ...\" format" > "/dev/stderr"; exit 1 }
      exit (bad > 0)
    }
  ' "$1"
}

# questions_missing_recommendations file — the numbers of the questions without a non-empty **Recommended:** part
questions_missing_recommendations() {
  awk -v rec="$Q_RECOMMENDED_RE" -v lab="$Q_LABEL_RE" '
    function check() { if (inq && txt ~ /^[[:space:]]*$/) out = out (out == "" ? "" : " ") num }
    /^## [0-9]+\./ { check(); inq = 1; txt = ""; inr = 0; num = $2; sub(/\.$/, "", num); next }
    $0 ~ rec { inr = 1; line = $0; sub(rec, "", line); txt = txt line; next }
    $0 ~ lab { inr = 0; next }
    { if (inr) txt = txt $0 }
    END { check(); printf "%s", out }
  ' "$1"
}

# expand_answers file — the answered questions file as the agent gets it: a verdict that is exactly "ok" becomes
# the recommendation it accepts; the ANSWERED marker and the answering instructions (questions_note) are dropped.
expand_answers() {
  awk -v ver="$Q_VERDICT_RE" -v rec="$Q_RECOMMENDED_RE" -v lab="$Q_LABEL_RE" -v done_re="$Q_ANSWERED_RE" '
    function trim(x) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x }
    function accepted() { return "**Verdict:** ok — the human accepts the recommendation: " trim(rect) }
    /^## [0-9]+\./ { rect = ""; inr = 0; pend = 0; print; next }
    $0 ~ done_re { next }
    /^> Answer every question after / { skip_blank = 1; next }
    skip_blank && /^[[:space:]]*$/ { skip_blank = 0; next }
    { skip_blank = 0 }
    $0 ~ rec { inr = 1; line = $0; sub(rec, "", line); rect = line; print; next }
    $0 ~ ver {
      inr = 0; line = $0; sub(ver, "", line)
      if (tolower(trim(line)) == "ok") { print accepted(); next }
      pend = (trim(line) == ""); print; next
    }
    $0 ~ lab { inr = 0; pend = 0; print; next }
    {
      if (inr && trim($0) != "") rect = rect " " $0
      if (pend && trim($0) != "") { pend = 0; if (tolower(trim($0)) == "ok") { print accepted(); next } }
      print
    }
  ' "$1"
}

# answers_marked file — 0 when the last non-empty line is the **ANSWERED** marker
answers_marked() {
  awk -v done_re="$Q_ANSWERED_RE" 'NF { last = $0 } END { exit !(last ~ done_re) }' "$1"
}

# questions_note id file — puts the answering instructions under the title of a new questions file (once)
questions_note() {
  local id=$1 f=$2 note tmp
  note="> Answer every question after **Verdict:** — \`ok\` accepts the recommendation. When you are done, put **ANSWERED** on the last line and save: the answers are sent at once (or run \`agent resume $id\`)."
  grep -qF -- '**ANSWERED** on the last line' "$f" && return 0
  tmp=$(mktemp)
  awk -v note="$note" 'NR == 1 && /^# / { print; print ""; print note; next } NR == 1 { print note; print "" } { print }' "$f" > "$tmp"
  cat "$tmp" > "$f"     # rewrite in place: the file keeps its inode
  rm -f "$tmp"
}

# file_mtime file — the modification time with sub-second precision
file_mtime() {
  # GNU stat first; BSD/macOS stat rejects -c (that error is expected) and the BSD form is used instead
  stat -c %.9Y "$1" 2>/dev/null || stat -f %Fm "$1"
}

# questions_ready id file — a questions file now waits for the human: answering instructions, the time it was asked,
# the watch that sends the answers when the file is saved marked ANSWERED, and the editor
questions_ready() {
  local id=$1 f=$2
  questions_note "$id" "$f"
  meta_set "$id" QUESTIONS_MTIME "$(file_mtime "$f")"
  watch_answers "$id" "$f"
  open_in_editor "$id" "$f"
}

# watch_answers id file — a systemd path unit runs `agent _answers_saved <id> <round>` whenever the file is saved
watch_answers() {
  local id=$1 f=$2 round
  round=${f##*/questions-}; round=${round%.md}
  systemd-run --user --quiet --collect --unit="agent-$id-answers-$round" \
    --path-property=PathModified="$f" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _answers_saved "$id" "$round" 3>&- 7>&- 8>&- 9>&- 10>&- \
    || log_error answers_watch_failed "task=$id" "file=$f"   # answering still works: agent resume <id>
}

# stop_answers_watch id round — removes the path unit of a questions file (if it still exists)
stop_answers_watch() {
  local unit="agent-$1-answers-$2.path"
  # a query: "inactive" and "no such unit" both mean there is nothing to stop
  systemctl --user is-active --quiet "$unit" || return 0
  try answers_watch_stop_failed systemctl --user stop "$unit"
}

# open_in_editor id file — opens a questions file in the VS Code window connected to this host, if there is one.
# A connected window leaves a socket (vscode-ipc-*.sock) and its server a remote CLI; sockets of closed windows stay
# behind and refuse connections, so the newest one that works is used.
open_in_editor() {
  [[ $QUESTIONS_EDITOR == vscode ]] || return 0
  local id=$1 f=$2 cli="" c d s out last=""
  for d in $VSCODE_SERVER_DIRS; do
    for c in "$d"/cli/servers/*/server/bin/remote-cli/* "$d"/bin/*/bin/remote-cli/*; do
      [[ -f $c && -x $c ]] || continue
      if [[ -z $cli || $c -nt $cli ]]; then cli=$c; fi
    done
  done
  [[ -n $cli ]] || return 0      # no VS Code server on this host
  local socks=() own=() fallback=() rundir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  for s in "$rundir"/vscode-ipc-*.sock; do   # this session's: where the server puts them
    if [[ -S $s && -O $s ]]; then own+=("$s"); socks+=("$s"); fi
  done
  if [[ $rundir != /tmp ]]; then
    for s in /tmp/vscode-ipc-*.sock; do      # other sessions' (or a server without XDG_RUNTIME_DIR)
      if [[ -S $s && -O $s ]]; then fallback+=("$s"); socks+=("$s"); fi
    done
  fi
  if ((${#socks[@]} == 0)); then
    log_info editor_not_connected "task=$id"
    return 0
  fi
  while IFS= read -r s; do
    if out=$(VSCODE_IPC_HOOK_CLI=$s timeout 10 "$cli" "$f" 2>&1); then
      log_info editor_opened "task=$id" "file=$f" "socket=$s"
      return 0
    fi
    last=$out
  done < <(   # this session's sockets before the other ones, each newest first
    {
      for s in "${own[@]}"; do printf '0 %s %s\n' "$(file_mtime "$s")" "$s"; done
      for s in "${fallback[@]}"; do printf '1 %s %s\n' "$(file_mtime "$s")" "$s"; done
    } | sort -k1,1n -k2,2rn | cut -d' ' -f3-)
  log_info editor_open_failed "task=$id" "file=$f" "error=$last"
}

# ------------------------------------------------------------------ prompts

render() { # template file → stdout, with {{KEY}} placeholders substituted from R
  local t; t=$(<"$1")
  local k
  for k in "${!R[@]}"; do t=${t//"{{$k}}"/${R[$k]}}; done
  printf '%s\n' "$t"
}

team_members_list() {
  [[ ${REMOTE_TEAM:-} != 1 ]] || { printf '%s' "(see team_status)"; return 0; }   # the team lives on the lead
  [[ -n ${TEAM:-} ]] || return 0
  local a out=()
  while read -r a; do
    [[ -n $a ]] && out+=("$a (${AGENT_TYPE[$a]:-?})")
  done < <(try peers_unavailable bus team-get --dir "$BUS_DIR" --team "$TEAM" | jq_soft peers_parse -r '.members[] | .agent')
  local IFS=,; printf '%s' "${out[*]}" | sed 's/,/, /g'
}

# ------------------------------------------------------------------ teams

# Exit codes of agentbus subcommands per error cause (ErrorCause.ExitCode in agentbus/errors.go).
BUS_NOT_FOUND=3
# BUS_PERMISSION is the typed Permission exit code used to reconcile a rejected node assignment.
BUS_PERMISSION=5
# BUS_STORAGE is the typed Storage exit code used to identify retryable local storage errors.
BUS_STORAGE=8

# team_json team — the team's JSON; nothing when the team does not exist (exit code BUS_NOT_FOUND), any
# other failure is logged.
team_json() {
  local errf rc=0 out
  errf=$(mktemp)
  out=$(bus team-get --dir "$BUS_DIR" --team "$1" 2>"$errf") || rc=$?
  if ((rc != 0 && rc != BUS_NOT_FOUND)); then
    log_warn team_read_failed "team=$1" "exit_code=$rc" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  printf '%s' "$out"
}
team_lead() { team_json "$1" | jq -r '.lead // empty'; }
team_done_flag() { team_json "$1" | jq -r '.done // false'; }
team_tasks() { team_json "$1" | jq -r '.members[]? | .task'; }

notify_send() { # file — delivers a notification file (first line = title/thread, rest = body). A failure is logged
  # and kept a day in $AGENTS_HOME/notify-failures.jsonl (notify_failure_keep): the dashboard counts them
  local f=$1 out rc=0 cmd
  if [[ -n $NOTIFY_CMD ]]; then
    cmd=$NOTIFY_CMD
    out=$($NOTIFY_CMD "$f" 2>&1) || rc=$?
  elif [[ -n $NOTIFY_SCRIPT ]]; then   # legacy: script run inside NOTIFY_DIR with the file name
    cmd=$NOTIFY_SCRIPT
    out=$(cd "$NOTIFY_DIR" && "$NOTIFY_SCRIPT" "${f##*/}" 2>&1) || rc=$?
  else
    return 0
  fi
  ((rc != 0)) || return 0
  log_warn notification_failed "exit_code=$rc" "command=$cmd ${f##*/}" "stderr=${out:0:300}"
  notify_failure_keep "$cmd" "exit $rc: $(tail -n 3 <<< "$out" | tr '\n' ' ' | cut -c1-300)"
  return 0
}

# notify_failure_keep command error — the failure, with this process's subcommand, kept a day in notify-failures.jsonl
# (older ones are left out on the way): a notification delivered by another process does not hide it
notify_failure_keep() {
  local f="$AGENTS_HOME/notify-failures.jsonl" now
  now=$(date +%s)
  (
    flock -w 10 9 || exit 1
    { if [[ -f $f ]]; then jq -c --argjson c "$((now - 86400))" 'select((.epoch // 0) > $c)' "$f"; fi
      jq -nc --arg at "$(date '+%Y-%m-%d %H:%M')" --argjson e "$now" --arg from "$AGENT_SUBCOMMAND" --arg command "$1" \
        --arg error "$2" '{at: $at, epoch: $e, from: $from, command: $command, error: $error}'; } > "$f.tmp.$$" \
      && mv "$f.tmp.$$" "$f"
  ) 9> "$f.lock" || log_warn notification_state_failed "file=$f"
}

# notice kind from to text [field=value ...] — publishes an event of this script on the bus (kinds: ScriptNotice in
# agentbus/events.go). Delivering it is a side effect of the calling step, so a failure is logged, not fatal.
notice() {
  local kind=$1 from=$2 to=$3 text=$4; shift 4
  local args=(--dir "$BUS_DIR" --from "$from" --to "$to" --notice "$kind") kv
  for kv in "$@"; do args+=(--field "$kv"); done
  try "notice_failed" bus send "${args[@]}" "$text" >/dev/null
  log_info notice_sent "notice=$kind" "to=$to"
}

push_text() { # repo line... — a notification outside the normal task cycle
  local repo=$1; shift
  mkdir -p "$NOTIFY_DIR"
  local f
  f="$NOTIFY_DIR/$(date +%Y%m%d-%H%M%S)-$RANDOM-summary.md"
  { printf '%s\n' "$repo"; printf '%s\n' "$@"; } > "$f"
  notify_send "$f"
}

team_summary() { # team — lines "agent: status (branch)"
  local t
  for t in $(team_tasks "$1"); do
    printf '  %s: %s (%s)\n' "$(task_field "$t" AGENT)" "$(task_field "$t" STATUS)" "$(task_field "$t" BRANCH)"
  done
}

finish_team() { # team reason — closes the team; sleeping members finish as done
  local team=$1 why=$2 t out
  [[ $(team_done_flag "$team") == true ]] && return 0
  log_info team_finished "team=$team" "reason=$why"
  bus team-done --dir "$BUS_DIR" --team "$team"
  for t in $(team_tasks "$team"); do   # remote members: their jobs end, their grants go
    [[ $(task_field "$t" KIND) == remote-member ]] || continue
    if ! out=$("$SELF" jobs --cancel "$(task_field "$t" JOB_ID)" 2>&1); then   # an ended job cannot be cancelled
      log_warn remote_member_cancel_failed "task=$t" "job=$(task_field "$t" JOB_ID)" "reason=${out:0:300}"
    fi
    try remote_member_revoke_failed bus lead-member --dir "$BUS_DIR" --remove --member "$(task_field "$t" AGENT)" >/dev/null
    meta_set "$t" STATUS done
  done
  for t in $(team_tasks "$team"); do
    if [[ $(task_field "$t" STATUS) == sleeping ]]; then
      meta_set "$t" STATUS done
      meta_set "$t" FINISHED "$(date -Is)"
      act "$t" info "■ $why"
    fi
    case $(task_field "$t" STATUS) in
      done|failed|stopped) bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$t" AGENT)" --state done >/dev/null ;;
      excluded) bus team-set --dir "$BUS_DIR" --team "$team" --agent "$(task_field "$t" AGENT)" --state excluded >/dev/null ;;
    esac
  done
}

# ------------------------------------------------------------------ rounds (README "Rounds")

team_waits_on_others() { # team — does a member wait for a worker request or an investigation it asked for?
  local out
  out=$(bus team-waiting --dir "$BUS_DIR" --team "$1") || return 1   # cannot tell (bus logs why): check as before
  [[ $(jq_soft team_waiting_parse -r '.waiting | length' <<< "$out") -gt 0 ]] || return 1
  log_info team_waiting "team=$1" "for=$(jq_soft team_waiting_parse -r '.waiting | join("; ")' <<< "$out")"
}

round_limit() { # repository name → its hard round limit (0 = none)
  printf '%s' "${ROUND_MAX_LINES_REPO[$1]:-$ROUND_MAX_LINES}"
}

round_limit_text() { # repository name → the round limit as the prompt states it
  local hard; hard=$(round_limit "$1")
  if ((hard > 0)); then
    printf 'may change at most %s lines (aim for %s)' "$hard" "$(round_soft "$1")"
  else
    printf 'has no line limit in this repository (still: split a big task into rounds the human can review)'
  fi
}

round_soft() { # repository name → its soft limit (never above the hard one)
  local hard; hard=$(round_limit "$1")
  if ((hard > 0 && ROUND_SOFT_LINES > hard)); then printf '%s' "$hard"; else printf '%s' "$ROUND_SOFT_LINES"; fi
}

round_base_ref() { # id → the ref a task's change is measured against: origin/<base> (fetched first) or <base>
  local wt base; wt=$(task_field "$1" WORKTREE); base=$(task_field "$1" BASE)
  if git -C "$wt" remote get-url origin >/dev/null 2>&1; then   # a query: no origin = a repository without a remote
    try round_fetch_failed git -C "$wt" fetch --quiet origin "$base"
    if git -C "$wt" rev-parse --verify --quiet "origin/$base" >/dev/null; then printf 'origin/%s' "$base"; return 0; fi
  fi
  printf '%s' "$base"
}

# Skipped tests (docs/tdd.md "Skipped tests"): for each kind of test file, the statements that skip a test — a
# statement starts its line, so assertions, comments and strings that only mention a skip do not count, and code
# of another language inside a test (a heredoc, a fixture) is not read with this file's pattern. No backslashes:
# the patterns are also given to awk.
SKIP_GLOBS=('*_test.go' '*.bats' 'test_*.py' '*_test.py' '*.test.*' '*.spec.*' '*.rs')
SKIP_PATTERNS=(
  '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[.]Skip(f|Now)?[(]'
  '^[[:space:]]*skip([[:space:]]|$)'
  '^[[:space:]]*(@pytest[.]mark[.]skip|@unittest[.]skip|pytest[.]skip[(]|self[.]skipTest[(])'
  '^[[:space:]]*(@pytest[.]mark[.]skip|@unittest[.]skip|pytest[.]skip[(]|self[.]skipTest[(])'
  '^[[:space:]]*((it|test|describe)[.]skip[(]|x(it|describe)[(])'
  '^[[:space:]]*((it|test|describe)[.]skip[(]|x(it|describe)[(])'
  '^[[:space:]]*#[[]ignore'
)

skips_in_repo() { # worktree → its skipped tests, "file:line: statement", at most 30 (sed, not head: no SIGPIPE)
  local i
  for i in "${!SKIP_GLOBS[@]}"; do
    { git -C "$1" grep -nE "${SKIP_PATTERNS[i]}" -- ":(glob)**/${SKIP_GLOBS[i]}" || (($? == 1)); }
  done | sort -t: -k1,1 -k2,2n -u | sed -E 's/[[:space:]]+/ /g' | cut -c1-200 | sed -n '1,30p'
}

skips_added() { # id → the skips this task's change adds against its base, "file: statement"
  local wt base i
  wt=$(task_field "$1" WORKTREE); base=$(round_base_ref "$1")
  for i in "${!SKIP_GLOBS[@]}"; do
    git -C "$wt" diff -U0 --no-color --no-ext-diff "$base...HEAD" -- ":(glob)**/${SKIP_GLOBS[i]}" \
      | awk -v pat="${SKIP_PATTERNS[i]}" '/^\+\+\+ b\// { file = substr($0, 7); next }
          /^\+/ && !/^\+\+\+/ { line = substr($0, 2); if (line ~ pat) { gsub(/[[:space:]]+/, " ", line); print file ":" line } }'
  done | sort -u
}

pr_skipped_section() { # id → the "## Skipped tests" section of the description of the task's PR (empty: none)
  local pr body
  pr=$(try pr_lookup_failed trusted_prs "$(task_field "$1" REPO_ROOT)" "$(task_field "$1" BRANCH)" all body)
  body=$(jq_soft pr_body_parse -r '.[0].body // empty' <<< "${pr:-[]}")
  awk '/^#+[[:space:]]*Skipped tests/ { on = 1; next } on && /^#+[[:space:]]/ { on = 0 } on { print }' <<< "$body"
}

skip_note() { # id — the skipped tests of the task's repository, appended to every run's prompt (nothing if none)
  [[ $(task_field "$1" KIND) != investigation ]] || return 0
  local wt list
  wt=$(task_field "$1" WORKTREE)
  [[ -d $wt ]] || return 0
  list=$(skips_in_repo "$wt")
  [[ -n $list ]] || return 0
  printf '\n---\n\n## Skipped tests in this repository (%s)\n\n' "$(wc -l <<< "$list")"
  printf 'Fill every one whose functionality exists now, test first; a skip is never a placeholder (see "Test first").\n\n'
  sed -E 's/^([^:]+:[0-9]+):[[:space:]]*(.*)$/- `\1`: \2/' <<< "$list"
}

agent_desc() { # agent → "`name` (type, model `model`)" for attributions
  local model=${AGENT_MODEL[$1]:-}
  printf '`%s` (%s%s)' "$1" "${AGENT_TYPE[$1]:-?}" "${model:+, model \`$model\`}"
}

attribution_block() { # indent — the lines that end the description of a PR: the agent, or the team, its coordinator and its members
  local ind=$1 a
  printf '%sOpened by team-agents:\n' "$ind"
  if [[ -z ${TEAM:-} ]]; then
    printf '%s- agent: %s\n' "$ind" "$(agent_desc "$AGENT")"
    return 0
  fi
  printf '%s- team: `%s`\n' "$ind" "$TEAM"
  printf '%s- coordinator: %s\n' "$ind" "$(agent_desc "$AGENT")"
  # the members from their task files: they all exist before any run starts (the bus may not know them all yet)
  local m
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] && grep -qxF "TEAM=$TEAM" "$m" || continue
    a=$(sed -n 's/^AGENT=//p' "$m")
    if [[ -n $a && $a != "$AGENT" ]]; then printf '%s- member: %s\n' "$ind" "$(agent_desc "$a")"; fi
  done
}

round_check() { # id → what keeps a finished round from closing, one "- …" line each (empty: nothing)
  local id=$1 limit size lines out=""
  limit=$(round_limit "$(task_field "$id" REPO_NAME)")
  if ((limit > 0)); then
    if size=$(bus round-size --repo "$(task_field "$id" WORKTREE)" --base "$(round_base_ref "$id")" --exclude "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE" --json); then
      lines=$(jq -r .lines <<< "$size")
      if ((lines > limit)); then
        out+="- The change has $lines lines (+$(jq -r .added <<< "$size") -$(jq -r .deleted <<< "$size")): over the round limit of $limit (aim for $(round_soft "$(task_field "$id" REPO_NAME)"))."$'\n'
      fi
    else
      log_warn round_size_failed "task=$id"   # the size cannot be measured: the round is not held back for that
    fi
  fi
  # every skip the round adds must be listed, with its reason, in the PR description's "## Skipped tests" section
  local added section f missing=""
  added=$(skips_added "$id")
  if [[ -n $added ]]; then
    section=$(pr_skipped_section "$id")
    while read -r f; do
      [[ -n $f ]] || continue
      if ! grep -qF -- "${f##*/}" <<< "$section"; then missing+="  - $(grep -F -- "$f:" <<< "$added" | head -1)"$'\n'; fi
    done < <(cut -d: -f1 <<< "$added" | sort -u)
    if [[ -n $missing ]]; then
      out+="- Skipped tests added in this round are not listed in the PR description's \"## Skipped tests\" section (each with its reason) — or fill them instead:"$'\n'"$missing"
    fi
  fi
  printf '%s' "$out"
}

round_pr_url() { # id → the URL of the PR of the task's branch ("" when there is none)
  local pr
  pr=$(try pr_lookup_failed trusted_prs "$(task_field "$1" REPO_ROOT)" "$(task_field "$1" BRANCH)" all url)
  jq_soft pr_lookup_parse -r '.[0].url // empty' <<< "${pr:-[]}"
}

cmd_round_size() { # <task> — the size of a task's change and its round limits
  local id repo limit
  id=$(resolve_id "${1:?usage: agent round-size <task>}")
  repo=$(task_field "$id" REPO_NAME); limit=$(round_limit "$repo")
  bus round-size --repo "$(task_field "$id" WORKTREE)" --base "$(round_base_ref "$id")" --exclude "$ROUND_EXCLUDE $ROUND_ALWAYS_EXCLUDE"
  if ((limit > 0)); then
    echo "limits: soft $(round_soft "$repo"), hard limit $limit lines (excluded from counting: $ROUND_EXCLUDE)"
  else
    echo "the repository $repo has no round limit"
  fi
}

last_team_id() { # the newest team of the repository in the current directory (outside one: the newest at all)
  local root="" m t best="" ; local -A teams=()
  if root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then   # fails outside a repository
    root=$(dirname "$root")
  fi
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    t=$(sed -n 's/^TEAM=//p' "$m")
    [[ -n $t ]] || continue
    if [[ -n $root && $(sed -n 's/^REPO_ROOT=//p' "$m") != "$root" ]]; then continue; fi
    teams[$t]=1
  done
  for t in $(printf '%s\n' "${!teams[@]}" | sort -r); do
    # a team the bus does not know was left by a resume that failed: the next older one is meant
    if bus team-get --dir "$BUS_DIR" --team "$t" >/dev/null 2>&1; then best=$t; break; fi
  done
  printf '%s' "$best"
}

# github_repo_url returns a canonical GitHub origin link, or empty for other/missing origins.
github_repo_url() {
  local url tail owner repo rc=0
  url=$(git -C "$1" remote get-url origin 2>&1) || rc=$?
  if ((rc == 2)); then return 0; fi # git reports a missing origin with exit 2
  if ((rc != 0)); then log_warn job_origin_lookup_failed "repository=$1" "exit=$rc" "reason=${url:0:300}"; return 0; fi
  case $url in
    https://github.com/*) tail=${url#https://github.com/} ;;
    git@github.com:*) tail=${url#git@github.com:} ;;
    ssh://git@github.com/*) tail=${url#ssh://git@github.com/} ;;
    *) return 0 ;;
  esac
  tail=${tail%.git}; owner=${tail%%/*}; repo=${tail#*/}
  if [[ $tail == */* && $owner =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ && $repo =~ ^[A-Za-z0-9_.-]{1,100}$ && $repo != . && $repo != .. ]]; then
    printf 'https://github.com/%s/%s' "$owner" "$repo"
  fi
}

github_owner() { # repository root → the owner of its GitHub origin ("" when origin is not on GitHub)
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 0   # no origin: no owner
  sed -nE 's#^(https://|git@|ssh://git@)github\.com[:/]([^/]+)/.*#\2#p' <<< "$url"
}

count_of() { # text words — the number next to the first of the words: "major 2", "major: 2", "major (2)" or "2 major"
  local n
  n=$({ grep -oiE "($2)[[:space:]]*[:=(]?[[:space:]]*[0-9]+" <<< "$1" || (($? == 1)); } | head -1 | grep -oE '[0-9]+$' || (($? == 1)))
  if [[ -z $n ]]; then
    n=$({ grep -oiE "[0-9]+[[:space:]]+($2)" <<< "$1" || (($? == 1)); } | head -1 | grep -oE '^[0-9]+' || (($? == 1)))
  fi
  echo "${n:-0}"
}

findings_count() { # text — the critical (blocker) + major problems a review reports, in any usual form: "critical 0,
  # major 2", "0 critical, 2 major", "**Major:** 2", "| Major | 2 |", "Major (2)" (Markdown emphasis and table bars
  # are dropped first)
  local plain
  plain=$(tr -d '*_`|' <<< "$1" | tr -s ' \t' '  ')
  echo $(( $(count_of "$plain" 'critical|blocker') + $(count_of "$plain" 'major') ))
}

review_verdict() { # text — the review's verdict (its last VERDICT line): ready-to-merge | needs-fixes | incomplete | nothing
  sed 's/[*`_]//g' <<< "$1" | { grep -oiE 'verdict:[[:space:]]*(ready-to-merge|needs-fixes|incomplete)' || (($? == 1)); } \
    | tail -1 | sed -E 's/^[^:]*:[[:space:]]*//' | tr '[:upper:]' '[:lower:]'
}

review_task_verdict() { # review-task final — its verdict; an old-style review (no VERDICT line) with critical or major
  # findings needs fixes; findings outweigh a "ready-to-merge"; nothing when the review gives no verdict
  local id=$1 text=$2 v n
  [[ ! -s $TASKS/$id/result.md ]] || text+=$'\n'$(cat "$TASKS/$id/result.md")
  v=$(review_verdict "$2"); [[ -n $v ]] || v=$(review_verdict "$text")
  n=$(findings_count "$text")
  if ((n > 0)) && [[ -z $v || $v == ready-to-merge ]]; then v=needs-fixes; fi
  printf '%s' "$v"
}

# the paths of test files (git pathspecs) in the languages the repositories use
TEST_PATHSPECS=(':(glob)**/*.bats' ':(glob)**/*_test.go' ':(glob)**/test_*.py' ':(glob)**/*_test.py'
  ':(glob)**/*.test.[jt]s' ':(glob)**/*.spec.[jt]s' ':(glob)**/tests/**/*.rs')

round_test_changes() { # repo base head — what a round did to the tests: "code=0|1 added=N changed=N" — code: a file
  # other than documentation changed; added: new test cases; changed: existing test files with lines taken away
  local repo=$1 base=$2 head=$3 f code=0 added changed
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    case $f in *.md|*.txt|*.rst|docs/*|LICENSE*) ;; *) code=1 ;; esac
  done < <(git -C "$repo" diff --name-only "$base" "$head")
  local plus minus diff
  diff=$(git -C "$repo" diff -U0 "$base" "$head" -- "${TEST_PATHSPECS[@]}")
  plus=$({ grep -cE '^\+[[:space:]]*(@test |func Test|def test_|#\[test\]|(it|test)\()' || (($? == 1)); } <<< "$diff")
  minus=$({ grep -cE '^-[[:space:]]*(@test |func Test|def test_|#\[test\]|(it|test)\()' || (($? == 1)); } <<< "$diff")
  added=$((plus > minus ? plus - minus : 0))   # a test whose declaring line changed is not a new one
  changed=$(git -C "$repo" diff --numstat "$base" "$head" -- "${TEST_PATHSPECS[@]}" | awk '$2 > 0 { n++ } END { print n + 0 }')
  printf 'code=%s added=%s changed=%s' "$code" "$added" "$changed"
}

# agents_gh_env — the agents' CLI gets this script as its gh (a link named gh, first on its PATH: agent_gh): text on GitHub reaches it only from
# the trusted accounts. AGENT_REAL_GH is the real gh; without gh there is nothing to put in front of
agents_gh_env() {
  local real dir="$AGENTS_HOME/run/gh-trusted"
  real=$(command -v gh) || { log_warn agents_gh_missing "task=${RUNNER_ID:-}"; return 0; }
  [[ $real != "$dir/gh" ]] || real=${AGENT_REAL_GH:-}   # set already in this process
  [[ -n $real ]] || return 1
  mkdir -p "$dir" && ln -sfn "$SELF" "$dir/gh" || return 1   # agent run as gh is the filter (agent_gh)
  export AGENT_REAL_GH=$real AGENT_GITHUB_TRUSTED_RESOLVED
  AGENT_GITHUB_TRUSTED_RESOLVED=$(github_trusted "${REPO_ROOT:-.}")
  [[ :$PATH: == *":$dir:"* ]] || export PATH="$dir:$PATH"
}

# github_trusted root — the GitHub accounts whose PRs and texts the round trusts, space-separated: AGENT_GITHUB_TRUSTED,
# or by default the repository's owner and the account gh is logged in as (the agents')
github_trusted() {
  if [[ -n ${AGENT_GITHUB_TRUSTED:-} ]]; then printf '%s' "$AGENT_GITHUB_TRUSTED"; return 0; fi
  if [[ -z ${GH_LOGIN_CACHE:-} ]]; then   # one question to GitHub per process; none answered: only the owner
    GH_LOGIN_CACHE=$(cd "$1" 2>/dev/null && gh api user --jq .login 2>/dev/null) || GH_LOGIN_CACHE=""
  fi
  printf '%s %s' "$(github_owner "$1")" "$GH_LOGIN_CACHE"
}

# trusted_prs root branch state fields — the round's PRs of that branch, newest first, as a JSON array: from this
# repository (a fork's PR with the same branch name is not — the agents' branch names are public) and opened by a
# trusted account (github_trusted); the others are logged (pr_untrusted_ignored) and left out
trusted_prs() {
  local root=$1 branch=$2 state=$3 fields out trusted ignored
  fields=$(printf '%s,number,isCrossRepository,headRepositoryOwner,author' "$4" | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -)
  out=$(cd "$root" && gh pr list --head "$branch" --state "$state" --json "$fields" --limit 20) || return 1
  trusted=$(github_trusted "$root" | jq -R 'split(" ") | map(select(. != ""))')
  local owner; owner=$(github_owner "$root")   # its head in this repository: not a fork's, whatever GitHub's flag says
  ignored=$(jq -r --argjson t "$trusted" --arg o "$owner" '[.[] | select((.isCrossRepository // false) or ($o != "" and (.headRepositoryOwner.login // $o) != $o)
            or ((.author.login // "") as $a | ($t | index($a)) == null))
            | "#\(.number) (\(.author.login // "?"))"] | join(", ")' <<< "$out")
  [[ -z $ignored ]] || log_warn pr_untrusted_ignored "branch=$branch" "prs=$ignored" "trusted=$(jq -r 'join(" ")' <<< "$trusted")"
  jq -c --argjson t "$trusted" --arg o "$owner" '[.[] | select((.isCrossRepository // false) == false and ($o == "" or (.headRepositoryOwner.login // $o) == $o)
            and ((.author.login // "") as $a | ($t | index($a)) != null))]' <<< "$out"
}

pr_format_issues() { # body [repo-url] — what a PR description writes against the GitHub conventions, one item per
  # line: a commit or a PR in code format without a link (GitHub links neither inside backticks), a code block that
  # does not name its language, RED or GREEN as plain words. Nothing inside code blocks is checked.
  local body=$1 url=${2:-https://github.com/<owner>/<repo>} line fence=0 lang rest m
  local re_sha='(^|[^[])`([0-9a-f]{7,40})`(.*)$' re_pr='(^|[^[])`#([0-9]+)`(.*)$' re_tdd='(^|[^a-zA-Z{])(\*\*)?(RED|GREEN)(\*\*)?:'
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*\`\`\`(.*)$ ]]; then
      if ((fence)); then fence=0; continue; fi
      fence=1
      lang=${BASH_REMATCH[1]//[[:space:]]/}
      [[ -n $lang ]] || printf 'a code block without its language: open it with ```go, ```bash, ```json…\n'
      continue
    fi
    ((fence == 0)) || continue
    rest=$line
    while [[ $rest =~ $re_sha ]]; do
      m=${BASH_REMATCH[2]}; rest=${BASH_REMATCH[3]}
      [[ $m == *[a-f]* ]] || continue   # digits only: a number, not a commit
      printf 'commit `%s` without a link: write [`%s`](%s/commit/<its full SHA>)\n' "$m" "${m:0:7}" "$url"
    done
    rest=$line
    while [[ $rest =~ $re_pr ]]; do
      m=${BASH_REMATCH[2]}; rest=${BASH_REMATCH[3]}
      printf 'PR `#%s` without a link: write [#%s](%s/pull/%s)\n' "$m" "$m" "$url" "$m"
    done
    if [[ $line =~ $re_tdd && $line != *'\color'* ]]; then
      printf '%s as a plain word: write $\\color{red}{\\textbf{RED}}$ and $\\color{green}{\\textbf{GREEN}}$ (bold, in colour)\n' "${BASH_REMATCH[3]}"
    fi
  done <<< "$body"
}

merge_blockers() { # repo base head round-tests — what keeps --autopilot from merging by itself, one reason per line
  local repo=$1 base=$2 head=$3 tests=$4 f p changed
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    for p in $AUTO_MERGE_HUMAN_PATHS; do
      # shellcheck disable=SC2053  # $p is unquoted on purpose: a pattern may be a glob
      if [[ $p == */ && $f == "$p"* ]] || [[ $p != */ && $f == $p ]]; then
        printf 'it touches %s (AUTO_MERGE_HUMAN_PATHS)\n' "$f"
        break
      fi
    done
  done < <(git -C "$repo" diff --name-only "$base" "$head")
  changed=$(sed -n 's/.*changed=\([0-9]*\).*/\1/p' <<< "$tests")
  if [[ $AUTO_MERGE_HOLD_TEST_CHANGES == yes ]] && ((${changed:-0} > 0)); then
    printf 'it changes existing tests (%s file(s)): only you may allow that\n' "$changed"
  fi
}

gate_at() { # repo rev log — runs the repository's gate at a revision in a temporary worktree; its exit status (0 when
  # the repository has no gate)
  local repo=$1 rev=$2 log=$3 gate wt rc=0
  gate=$(review_gate_cmd "$repo")
  [[ -n $gate ]] || return 0
  wt=$(mktemp -d)
  git -C "$repo" worktree add -q --detach "$wt" "$rev" 10>&- || { rmdir "$wt"; echo "cannot check out $rev" > "$log"; return 1; }
  (cd "$wt" && timeout "${AGENT_REVIEW_GATE_MIN}m" bash -c "$gate") > "$log" 2>&1 10>&- || rc=$?
  git -C "$repo" worktree remove --force "$wt" 10>&- || log_warn gate_worktree_left "worktree=$wt"
  return "$rc"
}

start_task_unit() { # task subcommand — runs `agent <subcommand> <task>` in its own unit (it may take minutes)
  systemd-run --user --quiet --collect --unit="agent-$1-${2#_}-$(date +%s)" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" "$2" "$1" 3>&- 7>&- 8>&- 9>&- 10>&-
}

cmd__merge() { # coordinator task — --autopilot after two ready-to-merge reviews: the merge (unless something needs the
  # human), the gate on the merged base, then the next round of the plan
  local id=$1 root branch base head mb url num why out wr wrs ref
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH); base=$(task_field "$id" BASE); base=${base:-main}
  url=$(task_field "$id" PR_URL); num=$(task_field "$id" PR_NUMBER)
  if [[ $(task_field "$id" AUTOPILOT_OFF) == 1 ]]; then
    auto_stage "$id" "waits for you: the autopilot is off — merge the PR yourself"
    notify "$id" approved "" "both reviews: ready to merge — the autopilot is off: merge PR #$num yourself: $url"
    return 0
  fi
  auto_stage "$id" "merging the round's PR (both reviews: ready to merge)"
  git -C "$root" fetch -q origin 10>&- || log_warn merge_fetch_failed "task=$id"   # then the local refs are checked
  head=$(git -C "$root" rev-parse -q --verify "origin/$branch^{commit}" 10>&-) || head=$(git -C "$root" rev-parse -q --verify "$branch^{commit}" 10>&-) || head=""
  mb=$(git -C "$root" merge-base "origin/$base" "${head:-HEAD}" 10>&-) || mb=""
  if [[ -n $head && -n $mb ]]; then why=$(merge_blockers "$root" "$mb" "$head" "$(task_field "$id" ROUND_TESTS)"); fi
  if [[ -n $why ]]; then
    auto_stage "$id" "waits for you: PR #$num is yours to merge (both reviews: ready to merge)"
    notify "$id" approved "" "both reviews: ready to merge, but PR #$num waits for you — $(tr '\n' ';' <<< "$why") $url"
    log_info autopilot_merge_held "task=$id" "reason=${why:0:200}"
    return 0
  fi
  if [[ $(cd "$root" && gh pr view "$url" --json isDraft --jq .isDraft 2>/dev/null) == true ]]; then   # a draft is made ready first
    (cd "$root" && try pr_ready_failed gh pr ready "$url" >/dev/null)
  fi
  local match=() checked   # only the commit the checks and the reviews had: anything pushed since stops the merge
  checked=$(task_field "$id" PRECHECK_HEAD)
  [[ -z $checked ]] || match=(--match-head-commit "$checked")
  if ! out=$(cd "$root" && gh pr merge "$url" --merge "${match[@]}" 2>&1); then
    auto_stage "$id" "waits for you: merging PR #$num failed"
    notify "$id" failed "" "⛔ autopilot stopped: merging PR #$num failed — your decision is needed: ${out:0:300} $url"
    log_error autopilot_merge_failed "task=$id" "reason=${out:0:300}"
    return 0
  fi
  log_info autopilot_merged "task=$id" "pr=$num"
  auto_stage "$id" "PR #$num merged — the gate on the merged $base"
  act "$id" info "--autopilot: PR #$num merged (both reviews: ready to merge)"
  git -C "$root" fetch -q origin "$base" 10>&- || log_warn merge_fetch_failed "task=$id" "base=$base"
  if ! gate_at "$root" "origin/$base" "$TASKS/$id/postmerge.log"; then
    auto_stage "$id" "waits for you: the gate fails on $base after the merge"
    notify "$id" failed "" "⛔ autopilot stopped: PR #$num is merged, but the gate fails on $base — your decision is needed: $(tail -n 15 "$TASKS/$id/postmerge.log" | tr '\n' ' ')"
    log_warn autopilot_postmerge_gate_failed "task=$id" "base=$base"
    return 0
  fi
  wr=$(task_field "$id" WORK_ROUND); wrs=$(task_field "$id" WORK_ROUNDS)
  if [[ -z $wr || -z $wrs ]] || ((wr >= wrs)); then
    auto_stage "$id" ""   # the task is done
    notify "$id" merged "" "merged PR #$num — both reviews: ready to merge; ${wr:+round $wr/$wrs was the last: }the task is done"
    return 0
  fi
  auto_stage "$id" "PR #$num merged — round $((wr + 1))/$wrs starts"
  notify "$id" merged "" "merged PR #$num — both reviews: ready to merge; round $((wr + 1))/$wrs starts"
  team_wait_settled "$id" || log_warn team_not_settled "task=$id" "before=next-round"   # a busy team cannot be resumed
  ref=$(task_field "$id" TEAM); ref=${ref:-$id}
  if ! out=$(cd "$root" && "$SELF" run --resume "$ref" --autopilot \
       "Round $((wr + 1)) of $wrs: the PR of round $wr (#$num) is merged — go on with the next round of the plan." </dev/null 2>&1); then
    auto_stage "$id" "waits for you: round $((wr + 1))/$wrs could not start"
    notify "$id" failed "" "⛔ autopilot stopped: round $((wr + 1))/$wrs could not start — your decision is needed: ${out:0:300}"
    log_error autopilot_next_round_failed "task=$id" "reason=${out:0:300}"
    return 0
  fi
  log_info autopilot_next_round "task=$id" "round=$((wr + 1))/$wrs" "output=${out:0:300}"
  auto_stage "$id" ""   # the next round's team has the work
}

cmd_autopilot() { # team [on|off] — a team's --autopilot, shown or switched; off: its reviews go on, but nothing is
  # merged nor started by itself (the human decides); on: the next round's reviews are a pair, and it merges again
  local team=${1:-} t lead
  [[ -n $team ]] || die "usage: agent autopilot <team> [on|off]"
  bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null || die "no team $team on the bus (agent team)"
  case ${2:-} in
    on|off)
      for t in $(team_tasks "$team"); do
        [[ $(task_field "$t" KIND) != remote-member ]] || continue
        if [[ $2 == on ]]; then meta_set "$t" AUTOPILOT 1; meta_set "$t" AUTOPILOT_OFF ""; else meta_set "$t" AUTOPILOT_OFF 1; fi
      done
      log_info autopilot_switched "team=$team" "state=$2"
      echo "Autopilot of team $team: $2." ;;
    "")
      lead=$(team_tasks "$team" | head -1)
      if [[ $(task_field "$lead" AUTOPILOT) == 1 && $(task_field "$lead" AUTOPILOT_OFF) != 1 ]]; then echo "Autopilot of team $team: on."
      else echo "Autopilot of team $team: off."; fi ;;
    *) die "usage: agent autopilot <team> [on|off]" ;;
  esac
}

supervise_review_waits() { # an --autopilot review pair waiting longer than AGENT_REVIEW_WAIT_MIN for two free
  # investigators: the human is told once (it goes on waiting — never one reviewer instead of two)
  local m id since
  for m in "$TASKS"/*/meta.env; do
    grep -qx 'REVIEW_PAIR_PENDING=1' "$m" || continue
    id=${m%/meta.env}; id=${id##*/}
    [[ -z $(task_field "$id" REVIEW_WAIT_TOLD) ]] || continue
    since=$(task_field "$id" REVIEW_PAIR_SINCE)
    (($(date +%s) - ${since:-0} >= AGENT_REVIEW_WAIT_MIN * 60)) || continue
    notify "$id" review-wait "" "the two reviews of PR #$(task_field "$id" PR_NUMBER) wait for two free investigators (since $(date -d "@${since:-0}" '+%H:%M')): free one, or wait"
    meta_set "$id" REVIEW_WAIT_TOLD 1   # after the notification: one that failed is sent again
  done
}

review_gate_cmd() { # repo — the gate a round's head must pass before a review (nothing: none)
  case $AGENT_REVIEW_GATE in
    off|"") ;;
    auto) if make -C "$1" -n gate >/dev/null 2>&1; then printf 'make gate'; fi ;;   # a repository without a gate target: none
    *) printf '%s' "$AGENT_REVIEW_GATE" ;;
  esac
}

# auto_stage task text — what --verify/--autopilot does for the round now, kept on its coordinator's task (AUTO_STAGE,
# the dashboard's stage); "" once the work is back with the team, or with the human after "waits for you: …"
auto_stage() { # task text [no-comment]
  [[ $(task_field "$1" AUTO_STAGE) != "$2" ]] || return 0
  meta_set "$1" AUTO_STAGE "$2"
  # a decision handed to the human is said on the round's PR too: GitHub notifies them there, whatever becomes of the
  # notification command
  if [[ $2 == "waits for you:"* && -z ${3:-} ]]; then human_on_pr "$1" "$2"; fi
}

# human_on_pr task text — a comment on the task's PR to its repository's owner (mentioned, when on GitHub)
human_on_pr() {
  local url root owner
  url=$(task_field "$1" PR_URL)
  [[ -n $url ]] || return 0
  root=$(task_field "$1" REPO_ROOT)
  owner=$(github_owner "$root")
  (cd "$root" && try handover_comment_failed gh pr comment "$url" --body "${owner:+@$owner }--autopilot $2") || return 0
  log_info handover_commented "task=$1" "pr=$url"
}

# round_pr_of_team team — the round's PR its coordinator had: its PR_NUMBER, or the ROUND_PR it carried; "" for none
round_pr_of_team() {
  [[ -n $1 ]] || return 0
  local lt p
  lt=$(team_lead_task "$1" "$(team_lead "$1")")
  [[ -n $lt ]] || return 0
  p=$(task_field "$lt" PR_NUMBER)
  printf '%s' "${p:-$(task_field "$lt" ROUND_PR)}"
}

# round_pr_supersede task pr-number pr-url — the round's PR is now this one (ROUND_PR); the round's earlier PR, when
# another (a new coordinator's branch), is closed as superseded by it, and each links to the other
round_pr_supersede() {
  local id=$1 num=$2 url=$3 old root
  old=$(task_field "$id" ROUND_PR)
  meta_set "$id" ROUND_PR "$num"
  [[ -n $old && $old != "$num" ]] || return 0
  root=$(task_field "$id" REPO_ROOT)
  (cd "$root" && try round_pr_close_failed gh pr close "$old" --comment "Superseded by #$num: the round's coordinator changed, and its work continues there ($url).") || return 0
  (cd "$root" && try round_pr_link_failed gh pr comment "$num" --body "Continues #$old (closed as superseded by this PR).") || true
  act "$id" info "PR #$old of this round closed: superseded by #$num"
  log_info round_pr_superseded "task=$id" "old=$old" "new=$num"
}

# gate_progress log — " — K of N steps passed (the last)" from tools/gate.sh's output so far, or " — <step> failed";
# "" for another gate command, whose output has no such lines
gate_progress() {
  local n k last failed
  n=$(sed -nE 's/^gate: ([0-9]+) steps?,.*/\1/p' "$1" 2>/dev/null | head -n 1)
  [[ -n $n ]] || return 0
  failed=$( { grep -E '^FAIL +[^ ]' "$1" || (($? == 1)); } | head -n 1 | awk '{print $2}')
  if [[ -n $failed ]]; then printf ' — %s failed' "$failed"; return 0; fi
  k=$(grep -cE '^ok +[^ ]' "$1" || (($? == 1)))   # grep -c prints 0 when none has passed yet
  last=$( { grep -E '^ok +[^ ]' "$1" || (($? == 1)); } | tail -n 1 | awk '{print $2}')
  printf ' — %s of %s steps passed%s' "$k" "$n" "${last:+ ($last)}"
}

# pair_stage pair-dir — the two reviews of an --autopilot pair, for the dashboard: each investigator with its
# verdict (✅ 🔧 🧩 ❌), or its investigation's number while it works
pair_stage() {
  local s out="" a v
  for s in A B; do
    a=$(cat "$1/$s.agent" 2>/dev/null) || a="?"
    v=$(cat "$1/$s.verdict" 2>/dev/null) || v=""
    case $v in
      ready-to-merge) v="✅" ;;
      needs-fixes) v="🔧" ;;
      incomplete) v="🧩" ;;
      none) v="❌" ;;
      *) v="(#$(cat "$1/$s.inv" 2>/dev/null || printf '?')) …" ;;
    esac
    out+="${out:+, }$a $v"
  done
  printf 'two reviews: %s' "$out"
}

start_precheck() { # coordinator task — the checks before its review run in their own unit: the gate may take minutes,
  # and the team's members must settle before the round can go back to them
  local id=$1
  if systemd-run --user --quiet --collect --unit="agent-$id-precheck-$(date +%s)" \
       --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
       "$SELF" _precheck "$id" 3>&- 7>&- 8>&- 9>&- 10>&-; then
    act "$id" info "before the review: the checks started"
    auto_stage "$id" "checks before review: waiting for the team's runs to end"
  else
    log_error precheck_unit_failed "task=$id"   # then here, in this run
    if review_precheck "$id"; then request_review "$id"; dispatch; fi
  fi
}

team_wait_settled() { # task — waits until the local members of its team have no run going (10 minutes at most): a
  # team is resumed only then; 1 = still busy
  local team t active i
  team=$(task_field "$1" TEAM)
  [[ -n $team ]] || return 0
  for ((i = 0; i < 120; i++)); do
    active=0
    for t in $(team_tasks "$team"); do
      [[ $(task_field "$t" KIND) != remote-member ]] || continue
      case $(task_field "$t" STATUS) in starting|running|waiting|investigating) active=1 ;; esac
    done
    ((active)) || return 0
    sleep 5
  done
  return 1
}

cmd__precheck() { # coordinator task — once its team's members have settled: the checks, then the review — or the
  # round goes back to the team
  local id=$1
  team_wait_settled "$id" || log_warn team_not_settled "task=$id" "before=precheck"
  if review_precheck "$id"; then
    request_review "$id"
    dispatch   # the review queued here starts on a free investigator now, not at some later run's end
  fi
}

review_precheck() { # coordinator task id — before a review: the round's head adds tests for a change of code and passes
  # the gate; else the team goes on with the reason (AGENT_PRECHECK_MAX times), then the human decides. 0 = review it
  local id=$1 root branch base head mb tc gate wt rc why="" pass ref repo args=() out
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH); base=$(task_field "$id" BASE)
  git -C "$root" fetch -q origin 10>&- || log_warn precheck_fetch_failed "task=$id"   # then the local refs are checked
  head=$(git -C "$root" rev-parse -q --verify "origin/$branch^{commit}" 10>&-) \
    || head=$(git -C "$root" rev-parse -q --verify "$branch^{commit}" 10>&-) \
    || { log_warn precheck_no_head "task=$id" "branch=$branch"; return 0; }   # nothing to check: the review decides
  meta_set "$id" PRECHECK_HEAD "$head"   # the commit checked (and then reviewed): the only one --autopilot merges
  auto_stage "$id" "checks before review: the round's tests and its PR's description"
  mb=$(git -C "$root" merge-base "origin/${base:-main}" "$head" 10>&-) || mb=$(git -C "$root" merge-base "${base:-main}" "$head" 10>&-) \
    || { log_warn precheck_no_base "task=$id" "base=$base"; return 0; }
  tc=$(round_test_changes "$root" "$mb" "$head")
  meta_set "$id" ROUND_TESTS "$tc"
  [[ $tc != "code=1 added=0 "* ]] || why="the round changes code but adds no test — every change of behaviour needs its test, written first"
  local format_bounce pr_url body issues
  format_bounce=$(task_field "$id" FORMAT_BOUNCED)
  if [[ -z $why && $format_bounce != 1 ]]; then   # the PR description's form, once a round
    pr_url=$(trusted_prs "$root" "$branch" open url | jq -r '.[0].url // empty') || pr_url=""
    if [[ -n $pr_url ]]; then
      body=$(cd "$root" && gh pr view "$pr_url" --json body --jq .body) || body=""
      issues=$(pr_format_issues "$body" "$(github_repo_url "$root")")
      if [[ -n $issues ]]; then
        why="the PR description does not follow the conventions for texts on GitHub (sent back once) — fix:
$issues"
        format_bounce=1
      fi
    fi
  fi
  gate=$(review_gate_cmd "$root")
  if [[ -z $why && -n $gate ]]; then
    wt=$(mktemp -d)
    git -C "$root" worktree add -q --detach "$wt" "$head" 10>&- || { log_warn precheck_worktree_failed "task=$id"; rmdir "$wt"; return 0; }
    rc=0
    auto_stage "$id" "checks before review: $gate"
    (cd "$wt" && timeout "${AGENT_REVIEW_GATE_MIN}m" bash -c "$gate") > "$TASKS/$id/precheck.log" 2>&1 10>&- &
    local gpid=$!
    while kill -0 "$gpid" 2>/dev/null; do   # its progress on the dashboard while it runs ("no such process": it ended)
      auto_stage "$id" "checks before review: $gate$(gate_progress "$TASKS/$id/precheck.log")"
      sleep "$AGENT_STAGE_POLL_SEC"
    done
    wait "$gpid" || rc=$?
    git -C "$root" worktree remove --force "$wt" 10>&- || log_warn precheck_worktree_left "worktree=$wt"
    act "$id" info "before the review: the gate ($gate) at ${head:0:7} — exit $rc"
    ((rc == 0)) || why="the gate (\`$gate\`) fails at ${head:0:7} (exit $rc); its output ends with:
\`\`\`
$(tail -n 40 "$TASKS/$id/precheck.log")
\`\`\`"
  fi
  [[ -n $why ]] || return 0
  pass=$(task_field "$id" PRECHECK_PASS); pass=${pass:-0}
  ref=$(task_field "$id" TEAM); ref=${ref:-$id}; repo=$(task_field "$id" REPO_NAME)
  log_warn review_precheck_failed "task=$id" "pass=$pass" "reason=${why:0:200}"
  if ((pass < AGENT_PRECHECK_MAX)); then
    args=(run --resume "$ref" --same-round)
    if [[ $(task_field "$id" AUTOPILOT) == 1 ]]; then args+=(--autopilot); else args+=(--verify); fi
    if out=$(cd "$root" && AGENT_PRECHECK_PASS=$((pass + 1)) AGENT_FIX_PASS=$(task_field "$id" FIX_PASS) \
         AGENT_FORMAT_BOUNCED=$format_bounce "$SELF" "${args[@]}" \
         "Not reviewed yet ($((pass + 1)) of $AGENT_PRECHECK_MAX): $why
Fix it on the same branches and finish as before; the round goes to review once its head passes." </dev/null 2>&1); then
      act "$id" info "before the review: the team goes on ($((pass + 1)) of $AGENT_PRECHECK_MAX) — ${why:0:120}"
      auto_stage "$id" ""   # the team has the work
    else
      log_error review_precheck_resume_failed "task=$id" "reason=${out:0:500}"
      handover_failed "$id" "the round" "$out"
    fi
    return 1
  fi
  auto_stage "$id" "waits for you: the round still fails its checks after $pass returns"
  notify "$id" failed "" "not reviewed: after $pass returns the round still fails before its review (the gate or its tests) — your decision is needed: ${why:0:400}"
  return 1
}

review_followup() { # investigator-task-id final — after a --verify review: critical or major findings wake the team
  # with them (VERIFY_MAX_FIX_PASSES times at most); after that the human is mentioned on the PR and notified
  local id=$1 text=$2 parent n pass ref repo root add out owner args=()
  parent=$(task_field "$id" PARENT_TASK)
  [[ -n $parent ]] || return 0
  # the counts are in the final message ("Problems: …") and in the result file; the larger is the one that counts
  local n2=0
  n=$(findings_count "$text")
  if [[ -s $TASKS/$id/result.md ]]; then
    n2=$(findings_count "$(cat "$TASKS/$id/result.md")")
    text=$(cat "$TASKS/$id/result.md")
  fi
  ((n2 > n)) && n=$n2
  local verdict pair
  verdict=$(review_task_verdict "$id" "$2")
  meta_set "$id" REVIEW_VERDICT "${verdict:-none}"
  pass=$(task_field "$parent" FIX_PASS); pass=${pass:-0}
  log_info review_findings "task=$parent" "review=$id" "critical_or_major=$n" "fix_pass=$pass" "verdict=${verdict:-none}"
  pair=$(task_field "$parent" REVIEW_PAIR)
  if [[ -n $pair ]]; then review_pair_done "$id" "$parent" "$pair" "${verdict:-none}" "$text"; return 0; fi
  [[ $verdict == needs-fixes || $verdict == incomplete ]] || return 0
  review_fix_pass "$parent" "$n" "$text"
}

review_fix_pass() { # parent findings text — the fix pass runs in its own unit, once the team's members have settled (a
  # member woken by the team's last messages may still run when the reviews end, and a busy team cannot be resumed)
  printf '%s' "$2" > "$TASKS/$1/fix-pass.n"
  printf '%s' "$3" > "$TASKS/$1/fix-pass.md"
  if start_task_unit "$1" _fixpass; then return 0; fi
  log_error fix_pass_unit_failed "task=$1"   # then here
  team_wait_settled "$1" || log_warn team_not_settled "task=$1" "before=fix-pass"
  do_fix_pass "$1" "$2" "$3"
}

cmd__fixpass() { # coordinator task — the fix pass recorded by review_fix_pass, once the team's members have settled
  local id=$1
  auto_stage "$id" "fix pass: the team goes on with the reviews' findings once its runs end"
  team_wait_settled "$id" || log_warn team_not_settled "task=$id" "before=fix-pass"
  do_fix_pass "$id" "$(<"$TASKS/$id/fix-pass.n")" "$(<"$TASKS/$id/fix-pass.md")"
  [[ $(task_field "$id" AUTO_STAGE) != "fix pass:"* ]] || auto_stage "$id" ""   # the team has the work, unless the human has
}

do_fix_pass() { # parent findings text — the team goes on with the review(s) that found problems, VERIFY_MAX_FIX_PASSES
  # times at most; after that the human is mentioned on the PR and notified
  local parent=$1 n=$2 text=$3 pass ref repo root add out owner args=()
  pass=$(task_field "$parent" FIX_PASS); pass=${pass:-0}
  PR_NUMBER=$(task_field "$parent" PR_NUMBER); PR_URL=$(task_field "$parent" PR_URL)
  ref=$(task_field "$parent" TEAM); ref=${ref:-$parent}
  repo=$(task_field "$parent" REPO_NAME); root=$(task_field "$parent" REPO_ROOT)
  if ((pass < VERIFY_MAX_FIX_PASSES)); then
    add="Fix pass $((pass + 1)) of $VERIFY_MAX_FIX_PASSES after the --verify review of PR #$PR_NUMBER ($PR_URL): $n critical or major finding(s).
Fix every critical and major finding — or dispute one, with a justification, as a reply on the PR; fix minor ones only if trivial. Then finish as before (the PR ready; STATUS: DONE or STATUS: ROUND_DONE N/M): the PR is reviewed again.

The review:

${text:0:8000}"
    args=(run --resume "$ref")
    if [[ $(task_field "$parent" AUTOPILOT) == 1 ]]; then args+=(--autopilot); else args+=(--verify); fi
    if [[ -n $(task_field "$parent" WORK_ROUND) ]]; then args+=(--same-round); fi
    if out=$(cd "$root" && AGENT_FIX_PASS=$((pass + 1)) "$SELF" "${args[@]}" "$add" </dev/null 2>&1); then
      act "$id" info "--verify: $n critical/major finding(s) — the team resumed for fix pass $((pass + 1))"
      log_info review_fix_pass "task=$parent" "pass=$((pass + 1))" "findings=$n"
    else
      log_error review_fix_resume_failed "task=$parent" "reason=${out:0:500}"
      handover_failed "$parent" "the fix pass" "$out"
      push_text "$repo" "--verify: the review of PR #$PR_NUMBER found $n critical or major finding(s), but the team could not be resumed:" "${out:0:500}"
    fi
    return 0
  fi
  owner=${AGENT_HUMAN_GITHUB:-$(github_owner "$root")}
  auto_stage "$parent" "waits for you: the reviews still find problems after $pass fix passes" no-comment   # the mention below says it
  (cd "$root" && try review_mention_failed gh pr comment "$PR_URL" --body "${owner:+@$owner }The fixes are still not done: after $pass fix passes the review still finds $n critical or major problem(s) (see the review above). The team has stopped; your decision is needed.")
  push_text "$repo" "--verify: PR #$PR_NUMBER still has $n critical or major problem(s) after $pass fix passes — your decision is needed: $PR_URL"
  log_warn review_fixes_exhausted "task=$parent" "passes=$pass" "findings=$n"
}

# pause_until_from_note note — when a node's pause ends, from its note ("resumes at 14:35": today or tomorrow;
# "resumes at 31.10 14:35": this year, or next once it has passed): seconds since the epoch, "" when it says none
pause_until_from_note() {
  local now t y
  now=$(date +%s)
  if [[ $1 =~ resumes\ at\ ([0-9]{2})\.([0-9]{2})\ ([0-9]{2}):([0-9]{2}) ]]; then
    y=$(date +%Y)
    t=$(date -d "$y-${BASH_REMATCH[2]}-${BASH_REMATCH[1]} ${BASH_REMATCH[3]}:${BASH_REMATCH[4]}" +%s) || return 0
    ((t >= now - 86400)) || t=$(date -d "$((y + 1))-${BASH_REMATCH[2]}-${BASH_REMATCH[1]} ${BASH_REMATCH[3]}:${BASH_REMATCH[4]}" +%s) || return 0
  elif [[ $1 =~ resumes\ at\ ([0-9]{2}):([0-9]{2}) ]]; then
    t=$(date -d "today ${BASH_REMATCH[1]}:${BASH_REMATCH[2]}" +%s) || return 0
    ((t > now)) || t=$((t + 86400))
  else
    return 0
  fi
  printf '%s' "$t"
}

# pause_reason_from_note note — the kind of a node's pause, from its note: quota, rate_limit, overloaded, network,
# or paused when it does not say
pause_reason_from_note() {
  case ${1,,} in
    *"quota or usage limit"*|*"out of quota"*) printf 'quota' ;;
    *"rate limit"*) printf 'rate_limit' ;;
    *overloaded*|*"at capacity"*) printf 'overloaded' ;;
    *network*|*unreachable*) printf 'network' ;;
    *) printf 'paused' ;;
  esac
}

# supervise_answer_watches — stops an answers watch (agent-<task>-answers-<round>.path) whose task no longer waits for
# the human's answers: answered another way, ended, or gone
supervise_answer_watches() {
  local units u tid
  units=$(systemctl --user list-units --all --plain --no-legend 'agent-*-answers-*.path') \
    || { log_warn answers_watch_list_failed; return 0; }
  while read -r u _; do
    [[ $u =~ ^agent-(.+)-answers-[0-9]+\.path$ ]] || continue
    tid=${BASH_REMATCH[1]}
    [[ -f $TASKS/$tid/meta.env && $(task_field "$tid" STATUS) == waiting ]] && continue
    try answers_watch_stop_failed systemctl --user stop "$u"
    try answers_watch_reset_failed systemctl --user reset-failed "${u%.path}.service"
    log_info answers_watch_stopped "task=$tid" "unit=$u"
  done <<< "$units"
}

# remote_start_check root base — the lead's commit is on origin's base, where a new remote member starts on its node,
# so that every member of a new team starts from the same commit
remote_start_check() {
  local sha
  sha=$(git -C "$1" rev-parse HEAD 10>&-) || return 1
  git -C "$1" merge-base --is-ancestor "$sha" "origin/$2" 10>&-
}

# handover_failed task what output — the team could not take its work back (its resume was refused): the human
# decides, and hears why — the stage "waits for you: …" (also said on the PR, by auto_stage), and the notification
handover_failed() {
  local id=$1 what=$2 out=$3 why
  why=$( { grep -m1 '^agent: ' <<< "$out" || (($? == 1)); } | sed 's/^agent: //' | cut -c1-200)   # the refusal's own words
  [[ -n $why ]] || why=$(tail -n 1 <<< "$out" | cut -c1-200)
  auto_stage "$id" "waits for you: $what could not go back to the team — $why"
  notify "$id" failed "" "⛔ $what could not go back to the team: $why — once that is fixed: agent run --resume $(task_field "$id" TEAM) --same-round"
}

# team_lead_task team agent — the team's task of that agent (its coordinator), the newest; "" when there is none
team_lead_task() {
  local m d best=""
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    grep -qx "TEAM=$1" "$m" && grep -qx "AGENT=$2" "$m" || continue
    d=${m%/meta.env}; best=${d##*/}
  done
  printf '%s' "$best"
}

# review_without_verdict review-task why — a review run ended without a verdict (failed, hung, stopped). In an
# --autopilot pair it is a review with no verdict (review_pair_done decides what follows); a single review stays
# the human's, as its notification says.
review_without_verdict() {
  local id=$1 why=$2 parent pair
  parent=$(task_field "$id" PARENT_TASK); [[ -n $parent ]] || return 0
  pair=$(task_field "$parent" REVIEW_PAIR); [[ -n $pair ]] || return 0
  log_warn review_without_verdict "task=$parent" "review=$id" "reason=${why:0:200}"
  review_pair_done "$id" "$parent" "$pair" none ""
}

# retry_review_slot parent pair-dir slot — that review again, by a free investigator other than the pair's two; with
# none free it waits (REVIEW_SLOT_PENDING, started by a later dispatch)
retry_review_slot() {
  local parent=$1 dir=$2 slot=$3 name
  name=$(free_investigator_list | { grep -vxF -e "$(cat "$dir/A.agent" 2>/dev/null)" -e "$(cat "$dir/B.agent" 2>/dev/null)" || (($? == 1)); } | head -n 1)
  if [[ -z $name ]]; then
    meta_set "$parent" REVIEW_SLOT_PENDING "$slot"
    act "$parent" info "--autopilot: review $slot gave no verdict — it is done again once a third investigator is free"
    auto_stage "$parent" "two reviews: review $slot waits for a third free investigator"
    return 0
  fi
  start_review_slot "$parent" "$dir" "$slot" "$name" fresh || return 1
  meta_set "$parent" REVIEW_SLOT_PENDING ""
  act "$parent" info "--autopilot: review $slot gave no verdict — done again by $name"
  auto_stage "$parent" "$(pair_stage "$dir")"
}

review_pair_done() { # review-task parent pair-dir verdict text — one review of an --autopilot pair has ended; when
  # both have: both ready-to-merge = the PR is ready; a review without a verdict = the human decides; else the team
  # goes on with the review(s) that found problems
  local id=$1 parent=$2 dir=$3 verdict=$4 text=$5 slot other va vb combined="" s n=0
  local myinv; myinv=$(task_field "$id" INV_ID)
  if [[ $(cat "$dir/A.inv" 2>/dev/null) == "$myinv" ]]; then slot=A
  elif [[ $(cat "$dir/B.inv" 2>/dev/null) == "$myinv" ]]; then slot=B
  else   # a review the pair no longer waits for (done again by another investigator since): not this pair's
    log_warn review_pair_stale "task=$parent" "review=$id" "investigation=$myinv"
    return 0
  fi
  other=B; [[ $slot == A ]] || other=A
  # the two reviews end in two runners, often in the same second: recording a verdict and taking the decision are
  # done under the pair's lock, so that exactly one of them decides (two merges or two fix passes would race)
  local decide
  if ! decide=$(
      exec 9>"$dir/pair.lock"
      flock -w 60 9 || exit 1
      printf '%s' "$verdict" > "$dir/$slot.verdict"
      [[ -z $text ]] || printf '%s' "$text" > "$dir/$slot.md"   # a run without a verdict leaves no review text
      if [[ -f $dir/$other.verdict && ! -f $dir/decided ]]; then : > "$dir/decided"; printf yes; fi
    ); then
    log_error review_pair_lock_failed "task=$parent" "pair=$dir"
    return 0
  fi
  if [[ $decide != yes ]]; then
    log_info review_pair_waiting "task=$parent" "done=$slot" "verdict=$verdict"
    auto_stage "$parent" "$(pair_stage "$dir")"
    return 0
  fi
  va=$(<"$dir/A.verdict"); vb=$(<"$dir/B.verdict")
  log_info review_pair_done "task=$parent" "A=$va" "B=$vb"
  if [[ $va == ready-to-merge && $vb == ready-to-merge ]]; then
    meta_set "$parent" REVIEW_RESULT approved
    if start_task_unit "$parent" _merge; then   # the merge, the gate on the base, the next round: minutes
      act "$parent" info "--autopilot: both reviews ready to merge — the merge started"
    else
      notify "$parent" approved "" "both reviews: ready to merge — the merge could not start: merge PR #$(task_field "$parent" PR_NUMBER) yourself: $(task_field "$parent" PR_URL)"
    fi
    return 0
  fi
  if [[ $va == none || $vb == none ]]; then
    local fs=A vo=$vb   # the review without a verdict, and the other's verdict
    [[ $va == none ]] || { fs=B; vo=$va; }
    # the other ready to merge: the review without a verdict is done again, once, by another investigator
    if [[ $vo == ready-to-merge && ! -f $dir/$fs.retried ]]; then
      : > "$dir/$fs.retried"
      rm -f "$dir/decided" "$dir/$fs.verdict"
      if retry_review_slot "$parent" "$dir" "$fs"; then return 0; fi
    fi
    # the other asks for changes: that decides — the fix pass goes on with its findings
    if [[ $vo != needs-fixes && $vo != incomplete ]]; then
      meta_set "$parent" REVIEW_RESULT failed
      auto_stage "$parent" "waits for you: a review gave no verdict"
      notify "$parent" failed "" "a review of PR #$(task_field "$parent" PR_NUMBER) gave no verdict${vo:+ (the other: $vo)} — your decision is needed: $(task_field "$parent" PR_URL)"
      return 0
    fi
  fi
  meta_set "$parent" REVIEW_RESULT fixes
  for s in A B; do
    case $(<"$dir/$s.verdict") in ready-to-merge|none) continue ;; esac
    combined+="## Review by $(<"$dir/$s.agent") — $(<"$dir/$s.verdict")"$'\n\n'"$(<"$dir/$s.md")"$'\n\n'
    n=$((n + $(findings_count "$(<"$dir/$s.md")")))
  done
  review_fix_pass "$parent" "$n" "$combined"
}

free_investigator_list() { # every free investigator (not working, not waiting for the human's answers, its provider's
  # quota not spent), one per line
  local inv d busy qu now
  now=$(date +%s)
  while read -r inv; do
    busy=0
    for d in "$TASKS"/*/; do
      [[ -f $d/meta.env ]] || continue
      d=${d%/}; d=${d##*/}
      [[ $(task_field "$d" AGENT) == "$inv" && $(task_field "$d" KIND) == investigation ]] || continue
      case $(task_field "$d" STATUS) in new|starting|running|waiting) busy=1; break ;; esac
      qu=$(task_field "$d" QUOTA_UNTIL)
      if [[ -n $qu ]] && ((qu > now)); then busy=1; break; fi   # out of quota until then
    done
    ((busy)) || printf '%s\n' "$inv"
  done < <(investigator_names)
}

start_review_pairs() { # under the dispatch lock: a pending --autopilot review pair starts once two investigators are free
  local m
  for m in "$TASKS"/*/meta.env; do
    if grep -qE '^REVIEW_SLOT_PENDING=[AB]$' "$m"; then   # one review of a pair to do again
      m=${m%/meta.env}
      retry_review_slot "${m##*/}" "$(task_field "${m##*/}" REVIEW_PAIR)" "$(task_field "${m##*/}" REVIEW_SLOT_PENDING)" \
        || log_error review_retry_failed "task=${m##*/}"
      continue
    fi
    grep -qx 'REVIEW_PAIR_PENDING=1' "$m" || continue
    m=${m%/meta.env}
    start_review_pair "${m##*/}" || return 0   # not two free investigators yet: the next dispatch tries again
  done
}

start_review_pair() { # coordinator task — both reviews of its PR at once, on two different free investigators (the
  # previous pair when free: each re-checks its own findings); 1 = not two free investigators yet
  local id=$1 free=() dir a="" b="" pa="" pb="" f slot name inv j q num url
  mapfile -t free < <(free_investigator_list)
  ((${#free[@]} >= 2)) || return 1
  num=$(task_field "$id" PR_NUMBER); url=$(task_field "$id" PR_URL)
  dir="$AGENTS_HOME/reviews/$(task_field "$id" REPO_NAME)-$num"
  mkdir -p "$dir"
  [[ ! -f $dir/A.agent ]] || pa=$(<"$dir/A.agent")
  [[ ! -f $dir/B.agent ]] || pb=$(<"$dir/B.agent")
  for f in "${free[@]}"; do [[ $f != "$pa" ]] || a=$f; [[ $f != "$pb" ]] || b=$f; done
  for f in "${free[@]}"; do
    if [[ -z $a && $f != "$b" ]]; then a=$f; fi
    if [[ -z $b && $f != "$a" ]]; then b=$f; fi
  done
  [[ -n $a && -n $b && $a != "$b" ]] || return 1
  for slot in A B; do
    name=$a; [[ $slot == A ]] || name=$b
    rm -f "$dir/$slot.retried"   # a new pair: each review may be done again once
    start_review_slot "$id" "$dir" "$slot" "$name" || return 1
  done
  rm -f "$dir/decided"   # a new pair decides anew
  meta_set "$id" REVIEW_PAIR_PENDING ""
  meta_set "$id" REVIEW_SLOT_PENDING ""
  meta_set "$id" REVIEW_PAIR "$dir"
  act "$id" info "--autopilot: two reviews of PR #$num started — $a and $b, each on its own"
  auto_stage "$id" "two reviews: $a (#$(cat "$dir/A.inv")), $b (#$(cat "$dir/B.inv"))"
}

# start_review_slot coordinator-task pair-dir slot investigator [fresh] — one review of the pair (A or B) on that
# investigator; a re-review after a fix pass gets its slot's previous review, unless fresh (a review done again)
start_review_slot() {
  local id=$1 dir=$2 slot=$3 name=$4 fresh=${5:-} num url q inv j
  num=$(task_field "$id" PR_NUMBER); url=$(task_field "$id" PR_URL)
    q="Recenzja PR #$num ($url) — one of two independent reviews: do not read other reviews or review comments on this PR before your own is published."
    if [[ -z $fresh && -s $dir/$slot.md && -n $(task_field "$id" FIX_PASS) && $(task_field "$id" FIX_PASS) != 0 ]]; then
      q+=" Re-review after fix pass $(task_field "$id" FIX_PASS): first check whether the findings of your previous review below are fixed (or disputed convincingly on the PR), then the rest of the change only for new problems.

Your previous review:
$(head -c 6000 "$dir/$slot.md")"
    fi
    inv=$(bus inv-add --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --kind review \
            --from-agent "$(task_field "$id" AGENT)" --from-task "$id" --repo "$(task_field "$id" REPO_NAME)" \
            --branch "$(task_field "$id" BRANCH)" --tasks-dir "$TASKS" --question "$q" --pr-url "$url" --pr-number "$num") \
      || { log_error review_pair_add_failed "task=$id" "slot=$slot"; return 1; }
    bus inv-set --dir "$BUS_DIR" --id "$inv" --status starting >/dev/null || { log_error review_pair_start_failed "task=$id" "investigation=$inv"; return 1; }
    j=$(bus inv-get --dir "$BUS_DIR" --id "$inv")
    printf '%s' "$name" > "$dir/$slot.agent"; printf '%s' "$inv" > "$dir/$slot.inv"; rm -f "$dir/$slot.verdict"
    remember_investigator "$name"
    start_investigation "$j" "$name" || log_error investigation_start_failed "investigation=$inv" "investigator=$name"
}

request_review() { # coordinator task id — --verify: queue a PR review by an investigator
  local id=$1 root branch pr url num inv
  root=$(task_field "$id" REPO_ROOT); branch=$(task_field "$id" BRANCH)
  pr=$(try pr_lookup_failed trusted_prs "$root" "$branch" all number,url)
  url=$(jq_soft pr_lookup_parse -r '.[0].url // empty' <<< "${pr:-[]}")
  num=$(jq_soft pr_lookup_parse -r '.[0].number // empty' <<< "${pr:-[]}")
  if [[ -z $url ]]; then
    act "$id" err "--verify: no PR found for branch $branch — review skipped"
    push_text "$(task_field "$id" REPO_NAME)" "Team $(task_field "$id" TEAM): --verify — no PR found for branch $branch, investigator review skipped."
    return 0
  fi
  meta_set "$id" PR_NUMBER "$num"; meta_set "$id" PR_URL "$url"
  round_pr_supersede "$id" "$num" "$url"   # a round's earlier PR (another coordinator's) is closed for this one
  if [[ $(task_field "$id" AUTOPILOT) == 1 ]]; then   # two reviews at once, when two investigators are free
    meta_set "$id" REVIEW_PAIR_PENDING 1
    auto_stage "$id" "two reviews: waiting for two free investigators"
    meta_set "$id" REVIEW_PAIR_SINCE "$(date +%s)"
    act "$id" info "--autopilot: two reviews of PR #$num wait for two free investigators"
    dispatch
    return 0
  fi
  local pass question
  pass=$(task_field "$id" FIX_PASS); question="Recenzja PR #$num ($url)"
  if ((${pass:-0} > 0)); then
    question+=" — re-review after fix pass $pass: first check whether the critical and major findings of the previous review are fixed (or disputed convincingly on the PR), then the rest of the change only for new problems"
  fi
  inv=$(bus inv-add --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --kind review \
          --from-agent "$(task_field "$id" AGENT)" --from-task "$id" --repo "$(task_field "$id" REPO_NAME)" \
          --branch "$branch" --tasks-dir "$TASKS" --question "$question" \
          --pr-url "$url" --pr-number "$num") || return 0
  meta_set "$id" REVIEW_INV "$inv"
  act "$id" info "--verify: review of PR #$num queued for an investigator (#$inv)"
}

team_after_run() { # id status final note — team logic after a member's run ends
  local id=$1 status=$2 final=$3 note=$4
  [[ $(task_field "$id" REMOTE_TEAM) != 1 ]] || return 0   # its team lives on the lead, which follows its state
  local team=$TEAM lead state
  lead=$(team_lead "$team")
  case $status in
    sleeping) state=sleeping ;;
    paused) state=paused ;;
    excluded) state=excluded ;;
    hung) state=hung ;;
    done|failed|stopped) state=done ;;
    *) state=active ;;
  esac
  try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$AGENT" --state "$state" >/dev/null

  if [[ $status == paused ]]; then
    local to until; to=$lead
    [[ -z $to || $to == "$AGENT" ]] && to="team:$team"
    local wake
    wake=$(task_field "$id" WAKE_AT)
    if [[ -z $wake ]]; then until="an unknown time"   # a remote member's note that gave none
    elif ((wake - $(date +%s) > 20 * 3600)); then until=$(date -d "@$wake" '+%d.%m %H:%M')
    else until=$(date -d "@$wake" '+%H:%M'); fi
    local released=""
    if [[ -n $wake ]] && ((wake - $(date +%s) > AGENT_RELEASE_PAUSE_MIN * 60)); then   # a long pause: the work goes on without it
      released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$AGENT" | paste -sd,)
      [[ -z $released ]] || meta_set "$id" PAUSE_RELEASED "$released"
    fi
    if [[ -n $released ]]; then
      notice member_paused agentbus "$to" "$AGENT IS PAUSED until $until: $note. Its items ($released) are back on the board with its progress notes — take them over; it resumes by itself at $until and takes new work from the board." \
        "agent=$AGENT" "team=$team" "until=$until" "reason=$(task_field "$id" PAUSE_REASON)" "released=$released"
    else
      notice member_paused agentbus "$to" "$AGENT IS PAUSED until $until: $note. Messages and board items do not wake it; it resumes by itself at $until and its claimed board items stay with it. If the work cannot wait, plan without it." \
        "agent=$AGENT" "team=$team" "until=$until" "reason=$(task_field "$id" PAUSE_REASON)"
    fi
    notify "$id" paused "$final" "$note"
    return 0
  fi

  if [[ $status == hung ]]; then
    local released tj nm
    released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$AGENT" | paste -sd,)
    tj=$(bus team-get --dir "$BUS_DIR" --team "$team")
    if [[ $(jq -r '[.members[] | select(.tier != "worker" and .state != "excluded")] | all(.state == "hung")' <<< "$tj") == true ]]; then
      finish_team "$team" "the coordinator and all normal models are hung"
      push_text "$REPO_NAME" "❌ Team $team aborted: the coordinator and all normal models are hung ($AGENT_HANG_STRIKES times in a row without progress)." \
        "Work state: pushed branches and checkpoints — to resume: agent run --resume $team" "$(team_summary "$team")"
      return 0
    fi
    for nm in $(jq -r '.members[] | select(.tier != "worker" and (.state == "active" or .state == "sleeping" or .state == "waking")) | .agent' <<< "$tj"); do
      if [[ $AGENT == "$lead" ]]; then
        notice coordinator_hung agentbus "$nm" "COORDINATOR $AGENT IS HUNG ($AGENT_HANG_STRIKES times without progress) and was switched off. Normal model: take over coordination (claim_lead), check the last checkpoint and the board, continue.${released:+ Its items ($released) are back on the board.}" \
          "agent=$AGENT" "team=$team" "released=$released"
      else
        notice agent_hung agentbus "$nm" "$AGENT IS HUNG ($AGENT_HANG_STRIKES times without progress) and was switched off.${released:+ Its items ($released) are back on the board.} Take over its work." \
          "agent=$AGENT" "team=$team" "released=$released"
      fi
    done
    return 0
  fi

  if [[ $AGENT == "$lead" ]]; then
    case $status in
      waiting) notify "$id" waiting "$final" "questions from the coordinator of team $team (members sleep until answered)" ;;
      failed)   # a failure is not the end of the team's work: the coordinator is out, the others go on
        member_out "$id" "the coordinator's run failed${note:+ ($note)}"
        push_text "$REPO_NAME" "⚠ The coordinator $AGENT of team $team failed${note:+ ($note)}. The team stays open: its members were told to take over coordination." \
          "To resume it yourself: agent run --resume $team --same-round \"…\""
        return 0 ;;
      done)
        finish_team "$team" "team task finished by the coordinator ($AGENT)"
        if [[ $status == done && $(task_field "$id" VERIFY) == 1 ]]; then
          start_precheck "$id"   # the checks before the review, then the review — in their own unit
          note="${note:+$note; }the round goes to review once its head passes the checks"
        fi
        notify "$id" "$status" "$final" "${note:+$note; }team $team:
$(team_summary "$team")" ;;
    esac
  else
    case $status in
      waiting) notify "$id" waiting "$final" "a member of team $team asked you directly (should have asked the coordinator)" ;;
      failed) member_out "$id" "its run failed${note:+ ($note)}; its last message: ${final:0:300}" ;;
      done)
        if [[ -n $lead && $(team_done_flag "$team") != true ]]; then
          notice member_finished agentbus "$lead" "TEAM: member $AGENT finished (STATUS: DONE)." "agent=$AGENT" "team=$team"
        fi ;;
    esac
  fi

  # everyone finished without the coordinator closing the team / everyone sleeps = the team is stuck — unless a
  # member waits for a worker or an investigation it asked for: that result wakes it
  [[ $(team_done_flag "$team") == true ]] && return 0
  local stuck_file="$TASKS/.team-$team.stuck"
  team_all() { # done|sleep — are all members in the given set of states
    local t st
    for t in $(team_tasks "$team"); do
      st=$(task_field "$t" STATUS)
      case $1:$st in
        done:done|done:failed|done:stopped|done:excluded|done:hung) ;;
        sleep:sleeping|sleep:done|sleep:failed|sleep:stopped|sleep:excluded|sleep:hung) ;;
        *) return 1 ;;
      esac
    done
  }
  if team_all done; then
    finish_team "$team" "all members finished"
    local ltask
    ltask=$(team_lead_task "$team" "$lead")
    if [[ -n $ltask && $(task_field "$ltask" VERIFY) == 1 ]]; then   # its coordinator out: the round still goes to review
      start_precheck "$ltask"
      act "$ltask" info "all members finished — the round goes to review once its head passes the checks"
    fi
    push_text "$REPO_NAME" "Team $team finished without being closed by its coordinator:" "$(team_summary "$team")"
  elif team_all sleep && ! team_waits_on_others "$team" && { sleep 3   # a pending wake-up gets a moment; re-check
         [[ $(team_done_flag "$team") != true ]] && team_all sleep && ! team_all done; }; then
    local n=1
    [[ -f $stuck_file ]] && n=$(( $(<"$stuck_file") + 1 ))
    echo "$n" > "$stuck_file"
    if ((n == 1)) && [[ -n $lead ]]; then
      notice team_stuck agentbus "$lead" \
        "TEAM STUCK: all members are asleep. As the coordinator, check the state (team_status, read_messages) and either assign work or finish the team task (STATUS: DONE). Waiting for the human to merge a PR? Then end the round instead of sleeping: STATUS: ROUND_DONE N/M." \
        "team=$team"
    elif ((n == 2)); then
      push_text "$REPO_NAME" "Team $team is stuck: all members are asleep and waking the coordinator did not help." \
        "See: agent live. Nudge them with a message (m / agent say) or stop: agent stop <coordinator task id>. If the coordinator waits for you to merge a PR: merge it, then tell it so (agent say)." \
        "$(team_summary "$team")"
    fi
  else
    rm -f "$stuck_file"
  fi
}

cmd__wake() { # id — a sleeping team member received a message, or the timer of a paused task fired
  stopping && return 0
  local id; id=$(resolve_id "${1:?}")
  exec 8>"$TASKS/$id/wake.lock"
  flock -w 30 8 || exit 0
  meta_load "$id"
  if [[ ${KIND:-} == remote-member ]]; then   # the member works on its node: the lead asks the node to wake it
    try remote_wake_failed bus lead-member --dir "$BUS_DIR" --wake --member "$AGENT" >/dev/null
    exit 0
  fi
  if [[ ${REMOTE_TEAM:-} == 1 ]]; then   # this node's member of a team on the lead: the lead woke it
    if [[ $STATUS == sleeping || $STATUS == interrupted ]]; then   # interrupted: its machine restarted
      meta_set "$id" WAKE_PENDING 1
      start_runner "$id" resume || log_error resume_failed "task=$id" "reason=a wake from the lead"
    fi
    exit 0
  fi
  if [[ $STATUS == paused ]]; then
    resume_paused "$id"
    exit 0
  fi
  [[ -n ${TEAM:-} ]] || exit 0
  log_info wake_requested "task=$id" "agent=$AGENT" "team=$TEAM"
  local mstate
  mstate=$(team_json "$TEAM" | jq -r --arg a "$AGENT" '.members[$a].state // empty')
  if [[ $mstate == excluded && $STATUS == sleeping ]]; then
    meta_set "$id" STATUS excluded
    meta_set "$id" FINISHED "$(date -Is)"
    act "$id" info "■ excluded from the team by the coordinator"
    exit 0
  fi
  if [[ $STATUS == sleeping && $(team_done_flag "$TEAM") != true ]]; then
    meta_set "$id" WAKE_PENDING 1
    start_runner "$id" resume || bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state sleeping >/dev/null
  else
    local state=active
    case $STATUS in done|failed|stopped) state=done ;; sleeping) state=done ;; esac
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state "$state" >/dev/null
  fi
}

# Words in a CLI error that mean the provider stopped the run because a quota or usage limit is exhausted.
# Provider limits in a run's errors: an exhausted quota, usage limit or credits (a long pause until the reset), and
# a rate limit — HTTP 429, the provider throttling requests (a short pause; credits may be fine).
QUOTA_PATTERN='quota (reached|exceeded|exhausted)|usage limit|limit reached|resource[ _]exhausted|out of credits|insufficient (credits|balance)|budget (of [^ ]+ )?(is )?(exceeded|exhausted|reached)|spend(ing)? limit (reached|exceeded)|(^|[^0-9])402([^0-9]|$)'
RATE_LIMIT_PATTERN='rate[ _-]?limit|too many requests|(^|[^0-9])429([^0-9]|$)'
# A model overloaded at the provider ("Selected model is at capacity", HTTP 503/529): a short pause like a rate limit.
OVERLOAD_PATTERN='at capacity|overloaded|temporarily unavailable|(^|[^0-9])(503|529)([^0-9]|$)'
# The network or the provider's host unreachable (DNS, a refused or reset connection, a timeout): nothing the agent did
# — a pause of AGENT_NETWORK_PAUSE_MIN, then the run goes on.
NETWORK_PATTERN='network (issue|error|is unreachable)|could not resolve|no such host|temporary failure in name resolution|name or service not known|lookup [^ ]+ on [^ ]+:[0-9]+|i/o timeout|dial tcp|connection (refused|reset|timed out)|tls handshake timeout|econnreset|econnrefused|etimedout|enotfound|eai_again|socket hang up|fetch failed'

# limit_lines dir run final pattern — this run's error lines that match a pattern: the end of the CLI's stderr
# (AGENT_LIMIT_TAIL_LINES lines: an early error the CLI retried does not count), the error events at the end of its
# output, the last error entries of the activity, and the final message when it has no STATUS (the agent's own
# report is never read as a provider error)
# A local error of the machine — out of processes, memory or file descriptors, a full disk, a unix socket — is no
# provider's limit nor a network failure, even when its words look like one ("Resource temporarily unavailable",
# "read unix …: i/o timeout"): such lines are left out before the patterns are matched.
LOCAL_ERROR_PATTERN='resource temporarily unavailable|fork: |cannot allocate memory|too many open files|no space left on device|(dial|read|write|connect) unix|unix:?[ /@]|[.]sock[: ]'

# limit_keep pattern — the lines of stdin that match the pattern and are no local error of the machine
limit_keep() {
  { grep -iE "$1" || (($? == 1)); } | { grep -viE "$LOCAL_ERROR_PATTERN" || (($? == 1)); }   # 1: none matches
}

limit_lines() {
  local dir=$1 run=$2 final=$3 pat=$4 f
  # every grep below exits 1 when nothing matches — that is the expected "no limit"
  if [[ -f $dir/err-$run.log ]]; then
    tail -n "$AGENT_LIMIT_TAIL_LINES" "$dir/err-$run.log" | limit_keep "$pat"
  fi
  for f in "$dir/events-$run.jsonl" "$dir/out-$run.jsonl"; do
    [[ -f $f ]] || continue
    tail -n 200 "$f" | { grep -iE '"(type|level|subtype)": ?"[a-z_]*error|"is_error": ?true|"error":' || (($? == 1)); } \
      | limit_keep "$pat"
  done
  if [[ -f $dir/activity.jsonl ]]; then
    tail -n 50 "$dir/activity.jsonl" | { grep -F '"k":"err"' || (($? == 1)); } | limit_keep "$pat"
  fi
  if [[ -z $(final_status "$final") ]]; then
    limit_keep "$pat" <<< "$final"
  fi
}

# last_error_line dir run — the CLI's last line on stderr in this run, its noise aside, at most 200 characters
last_error_line() {
  [[ -f $1/err-$2.log ]] || return 0
  tail -n 30 "$1/err-$2.log" | sed -E 's/^[[:space:]]+//' \
    | { grep -vE '^$|^Reading additional input from stdin' || (($? == 1)); } | tail -n 1 | cut -c1-200
}

# limit_kind dir run final — quota (an exhausted quota, usage limit or credits) or rate_limit (HTTP 429: the
# provider throttles requests — not the same as running out); exit 1 when the run did not stop on a provider limit
limit_kind() {
  if [[ -n $(limit_lines "$1" "$2" "$3" "$QUOTA_PATTERN" | tr -d '[:space:]') ]]; then
    echo quota
  elif [[ -n $(limit_lines "$1" "$2" "$3" "$RATE_LIMIT_PATTERN" | tr -d '[:space:]') ]]; then
    echo rate_limit
  elif [[ -n $(limit_lines "$1" "$2" "$3" "$OVERLOAD_PATTERN" | tr -d '[:space:]') ]]; then
    echo overloaded
  elif [[ -n $(limit_lines "$1" "$2" "$3" "$NETWORK_PATTERN" | tr -d '[:space:]') ]]; then
    echo network
  else
    return 1
  fi
}

# limit_line dir run final kind — the first line that showed the limit, at most 200 characters (for the note)
limit_line() {
  local pat=$QUOTA_PATTERN
  [[ $4 == rate_limit ]] && pat=$RATE_LIMIT_PATTERN
  [[ $4 == overloaded ]] && pat=$OVERLOAD_PATTERN
  [[ $4 == network ]] && pat=$NETWORK_PATTERN
  limit_lines "$1" "$2" "$3" "$pat" | sed -E 's/^[[:space:]]+//' | { grep -m1 . || (($? == 1)); } | cut -c1-200
}

# quota_reset_seconds dir run final — when the run stopped on a provider limit: the seconds until it may go on.
# The reset time comes from the message if it gives one; otherwise AGENT_QUOTA_PAUSE_MIN for an exhausted quota and
# AGENT_RATE_LIMIT_PAUSE_MIN for a rate limit. Exit 1: not a provider limit.
quota_reset_seconds() {
  local kind text pat=$QUOTA_PATTERN default=$AGENT_QUOTA_PAUSE_MIN
  kind=$(limit_kind "$1" "$2" "$3") || return 1
  if [[ $kind == rate_limit ]]; then pat=$RATE_LIMIT_PATTERN; default=$AGENT_RATE_LIMIT_PAUSE_MIN; fi
  if [[ $kind == overloaded ]]; then pat=$OVERLOAD_PATTERN; default=$AGENT_RATE_LIMIT_PAUSE_MIN; fi
  if [[ $kind == network ]]; then pat=$NETWORK_PATTERN; default=$AGENT_NETWORK_PAUSE_MIN; fi
  text=$(limit_lines "$1" "$2" "$3" "$pat")

  local secs=0 now at t epoch dur
  now=$(date +%s)
  # "limit reached|1761120000" (Claude Code): the reset as a Unix time
  epoch=$(grep -oE 'limit reached\|[0-9]{10}' <<< "$text" | head -1 | cut -d'|' -f2 || (($? == 1)))
  if [[ -n $epoch ]] && ((epoch > now)); then secs=$((epoch - now)); fi
  # "Resets in 24m46s", "try again in 2 hours 13 minutes", "retry after 90s"
  if ((secs == 0)); then
    dur=$(grep -ioE '(resets?|try again|retry|available again)( it)?( in| after)? [0-9][0-9hms ,:a-z]*' <<< "$text" | head -1 || (($? == 1)))
    [[ -n $dur ]] && secs=$(duration_seconds "$dur")
  fi
  # "resets 2026-11-01T00:00:00.000Z": the reset as an ISO time (before the clock times below read its year as one)
  if ((secs == 0)); then
    local iso
    iso=$(grep -ioE 'resets? (at |on )?[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?' <<< "$text" \
            | head -1 | sed -E 's/^resets? (at |on )?//I' || (($? == 1)))
    # date reports an unparsable time on stderr; that only means the time is unknown (the default pause applies)
    if [[ -n $iso ]] && t=$(date -d "$iso" +%s 2>/dev/null) && ((t > now)); then secs=$((t - now)); fi
  fi
  # "resets 3pm", "will reset at 15:30"
  if ((secs == 0)); then
    at=$(grep -ioE 'resets? (at )?[0-9]{1,2}(:[0-9]{2})? ?([ap]m)?' <<< "$text" | head -1 | sed -E 's/^resets? (at )?//I' || (($? == 1)))
    # date reports an unparsable time on stderr; that only means the time is unknown (the default pause applies)
    if [[ -n $at ]] && t=$(date -d "$at" +%s 2>/dev/null); then
      ((t <= now)) && t=$((t + 86400))
      secs=$((t - now))
    fi
  fi
  ((secs > 0)) || secs=$((default * 60))
  echo $((secs + 60))
}

# duration_seconds text — the duration in a text ("24m46s", "2 hours 13 minutes", "1h 5m", "90s") in seconds
duration_seconds() {
  local s=0 n u
  while read -r n u; do
    case ${u,,} in
      h*) s=$((s + n * 3600)) ;;
      m*) s=$((s + n * 60)) ;;
      s*) s=$((s + n)) ;;
    esac
  done < <(grep -oE '[0-9]+ ?[a-zA-Z]+' <<< "$1" | sed -E 's/^([0-9]+) ?/\1 /' || (($? == 1)))
  echo "$s"
}

# bus_messages_from agent — how many bus messages the agent has posted (a progress signal of the wake-loop guard)
bus_messages_from() {
  local f="$BUS_DIR/messages.jsonl"
  [[ -f $f ]] || { echo 0; return 0; }
  # grep -c exits 1 when nothing matches; it still prints the count (0)
  grep -cF "\"from\":\"$1\"" "$f" || (($? == 1))
}

# recent_run_starts list now — the run start times (Unix seconds) of the last 10 minutes, plus now
recent_run_starts() {
  local t out=()
  for t in $1; do (( $2 - t < 600 )) && out+=("$t"); done
  out+=("$2")
  printf '%s' "${out[*]}"
}

wake_loop_applies() { # status — the wake-loop guard watches a local team member whose run ended SLEEPING; a remote
  # member's work (its messages, its board items) is on the lead's bus, which its node cannot see
  [[ $1 == sleeping && -n ${TEAM:-} && ${REMOTE_TEAM:-} != 1 ]]
}

# wake_loop_check id start head0 msgs0 — the wake-loop guard, for a team member whose run ended SLEEPING. When the
# member keeps being woken without doing anything — AGENT_WAKE_LOOP_MAX idle runs in a row (shorter than
# AGENT_IDLE_RUN_SEC, no new commit, no bus message) or more than AGENT_WAKE_RATE_MAX runs within 10 minutes —
# prints the pause in seconds and returns 0; otherwise records the idle streak and returns 1.
wake_loop_check() {
  local id=$1 start=$2 head0=$3 msgs0=$4 now head msgs idle recent=0 t
  now=$(date +%s)
  head=$(git -C "$WORKTREE" rev-parse HEAD) || head="unknown"
  msgs=$(bus_messages_from "$AGENT")
  idle=$(task_field "$id" IDLE_RUNS); idle=${idle:-0}
  if (( now - start < AGENT_IDLE_RUN_SEC )) && [[ $head == "$head0" && $msgs == "$msgs0" ]]; then
    idle=$((idle + 1))
  else
    idle=0
  fi
  for t in $(task_field "$id" RUN_STARTS); do (( now - t < 600 )) && recent=$((recent + 1)); done
  if (( idle >= AGENT_WAKE_LOOP_MAX || recent > AGENT_WAKE_RATE_MAX )); then
    meta_set "$id" IDLE_RUNS 0
    meta_set "$id" RUN_STARTS ""
    log_warn wake_loop_detected "task=$id" "idle_runs=$idle" "runs_10min=$recent"
    echo $((AGENT_WAKE_LOOP_PAUSE_MIN * 60))
    return 0
  fi
  meta_set "$id" IDLE_RUNS "$idle"
  return 1
}

# schedule_wake id seconds — runs `agent _wake <id>` after that many seconds (a transient systemd timer)
schedule_wake() {
  systemd-run --user --quiet --collect --unit="agent-$1-wake-$(date +%s)" \
    --on-active="${2}s" --timer-property=AccuracySec=10s \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _wake "$1" 3>&- 7>&- 8>&- 9>&- 10>&-
}

# pause_task id seconds reason — the task waits (no run, not woken by messages) until a timer resumes it
pause_task() {
  local id=$1 secs=$2 reason=$3 at
  at=$(( $(date +%s) + secs ))
  meta_set "$id" WAKE_AT "$at"
  meta_set "$id" PAUSE_REASON "$reason"
  if ! schedule_wake "$id" "$secs"; then
    # without the timer the task stays paused until `agent _wake <id>` or `agent run --resume`
    log_error pause_timer_failed "task=$id" "seconds=$secs"
  fi
  log_warn task_paused "task=$id" "reason=$reason" "seconds=$secs" "until=$(date -d "@$at" '+%H:%M')"
}

# resume_paused id — the timer of a paused task fired (meta loaded): resume it, or defer an early wake-up
resume_paused() {
  local id=$1
  if (( $(date +%s) < ${WAKE_AT:-0} )); then
    log_info wake_deferred "task=$id" "wake_at=$WAKE_AT"
    return 0
  fi
  meta_set "$id" WAKE_AT ""
  if [[ -n ${TEAM:-} ]]; then
    if [[ $(team_done_flag "$TEAM") == true ]]; then
      meta_set "$id" STATUS done
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state done >/dev/null
      return 0
    fi
    meta_set "$id" WAKE_PENDING 1
  fi
  log_info resumed_after_pause "task=$id" "reason=${PAUSE_REASON:-}"
  start_runner "$id" resume || log_error resume_failed "task=$id" "reason=resume after a pause"
}

# git_identity — exports the commit identity of this run's agent (and commit signing) for every git command the
# agent runs. Environment variables override the user's git config, so the identity does not depend on the agent
# following the prompt — and never is the human's: not their e-mail, not their signing key.
git_identity() {
  local name=${GIT_NAME_FORMAT//%a/$AGENT} email=${GIT_EMAIL//%a/$AGENT} signing=no
  # never the human's address from git config: GitHub would put the agents' commits on the human's account
  [[ -n $email ]] || email="$AGENT@team-agents.invalid"
  export GIT_AUTHOR_NAME="$name" GIT_COMMITTER_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email"
  if [[ -n $GIT_SIGNING_KEY && -r $GIT_SIGNING_KEY ]]; then
    export GIT_CONFIG_COUNT=4 \
      GIT_CONFIG_KEY_0=gpg.format GIT_CONFIG_VALUE_0=ssh \
      GIT_CONFIG_KEY_1=user.signingkey GIT_CONFIG_VALUE_1="$GIT_SIGNING_KEY" \
      GIT_CONFIG_KEY_2=commit.gpgsign GIT_CONFIG_VALUE_2=true \
      GIT_CONFIG_KEY_3=tag.gpgsign GIT_CONFIG_VALUE_3=true
    signing=yes
  else
    if [[ -n $GIT_SIGNING_KEY ]]; then
      log_warn signing_key_unreadable "key=$GIT_SIGNING_KEY" "effect=commits of this run are not signed"
    fi
    # no key of the agents' own: they do not sign — not even with the human's key from git config
    export GIT_CONFIG_COUNT=2 \
      GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false \
      GIT_CONFIG_KEY_1=tag.gpgsign GIT_CONFIG_VALUE_1=false
  fi
  log_info git_identity "name=$name" "email=$email" "signing=$signing"
}

# commit_trailers — the trailers that end every commit message of this run's agent
commit_trailers() {
  printf 'Agent: %s\nAgent-Model: %s%s\nTask: %s' "$AGENT" "$TYPE" "${MODEL:+/$MODEL}" "$1"
  [[ -n ${TEAM:-} ]] && printf '\nTeam: %s' "$TEAM"
  [[ -n ${INV_ID:-} ]] && printf '\nInvestigation: #%s' "$INV_ID"
  return 0
}

# agents_md_text — what the prompt says about the repository instructions (AGENTS.md) in this run's worktree
agents_md_text() {
  if [[ -f $WORKTREE/AGENTS.md ]]; then
    cat <<'TXT'
**Repository instructions.** Before you start, read `AGENTS.md` in the repository root and every `AGENTS.md`
in the directories you work in (the nearest one applies to its directory). They describe the repository, its
conventions and how to build, lint and test it; they are binding. Where they conflict with these instructions,
these instructions decide how you communicate with the human and the other agents, and `AGENTS.md` decides how
the code is written and checked; if unsure, ask. Do not change any `AGENTS.md` (or `CLAUDE.md`, `GEMINI.md`)
unless the task explicitly asks for it — record what you learned in the repository notebook (`notebook_append`).
TXT
  else
    cat <<'TXT'
**Repository instructions.** This repository has no `AGENTS.md`. Follow the conventions you see in the existing
code, its build files and CI configuration, and say in your report that an `AGENTS.md` would help. Do not
create one unless the task asks for it.
TXT
  fi
}

# privileges_text — what the prompt tells the agent about installing missing tools; decided on every run,
# because sudo rights can change between runs
privileges_text() {
  # "sudo -n true" asks without a password prompt; its "a password is required" message is the expected answer
  if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
    echo "you have passwordless sudo. Use it only to install a tool you need that is missing (with the system package manager), and list every package you installed in your report. Do not use sudo for anything else."
  else
    echo "you have no sudo. If a tool you need is missing, do not work around it silently: use what is available and say in your report (or in your questions, if it blocks you) what was missing."
  fi
}

peers_list() {
  local a out=()
  for a in "${!AGENT_TYPE[@]}"; do out+=("$a (${AGENT_TYPE[$a]})"); done
  local IFS=,; printf '%s' "${out[*]}" | sed 's/,/, /g'
}

build_prompt() { # id mode qfile next_round
  local id=$1 mode=$2 qfile=$3 next_round=$4
  declare -gA R=(
    [AGENT]=$AGENT [AGENT_TYPE]=$TYPE [TASK_ID]=$id [REPO]=$REPO_NAME
    [WORKTREE]=$WORKTREE [BRANCH]=$BRANCH [BASE]=$BASE [REPO_URL]="$(github_repo_url "$REPO_ROOT")"
    [GITHUB_TRUSTED]="$(github_trusted "$REPO_ROOT")"
    [HARDWARE_FILE]="$ENV_NOTES_FILE" [PEERS]="$(peers_list)" [LANGUAGE]="$AGENT_LANGUAGE"
    [REPO_LANGUAGE]="$REPO_LANGUAGE" [COMMIT_TRAILERS]="$(commit_trailers "$id")"
    [GIT_NAME]="${GIT_NAME_FORMAT//%a/$AGENT}" [ATTRIBUTION]="\`$AGENT\` ($TYPE${MODEL:+, model $MODEL})"
    [PRIVILEGES]="$(privileges_text)" [AGENTS_MD]="$(agents_md_text)"
    [QUESTIONS_FILE]=$qfile [ROUND]=$next_round [CONSULT_MIN]=$AGENT_CONSULT_MIN
    [ROUND_LIMIT_TEXT]="$(round_limit_text "$REPO_NAME")" [ROUND_SOFT]="$(round_soft "$REPO_NAME")"
    [ROUND_SIZE_CMD]="agent round-size $id"
    [REPORT_FILE]=".agents/reports/$id.md"
    [RESULT_FILE]="$TASKS/$id/result.md"
    [INV_ID]=${INV_ID:-} [PARENT_TASK]=${PARENT_TASK:-} [PARENT_WORKTREE]=${PARENT_WORKTREE:-}
    [FROM_AGENT]=${FROM_AGENT:-}
    [TEAM_ID]=${TEAM:-} [TEAM_MEMBERS]="$(team_members_list)"
    [ATTRIBUTION_BLOCK]="$(attribution_block "")" [TEAM_ATTRIBUTION_BLOCK]="$(attribution_block "   ")"
    [TIER]=$( [[ ${TIER:-normal} == worker ]] && echo "worker (a cheap model for simple tasks)" || echo "normal model" )
    [WORKERS]="$( ((${#WORKER_AGENTS[@]})) && (IFS=,; printf '%s' "${WORKER_AGENTS[*]}" | sed 's/,/, /g') || echo "(none configured)")"
    [HELPER_ID]=${HELPER_ID:-}
    [PR_URL]=${PR_URL:-} [PR_NUMBER]=${PR_NUMBER:-}
    [RESUMED_FROM]=${RESUMED_FROM:-} [HANG_MIN]=$AGENT_HANG_MIN
  )
  if [[ $mode == new ]]; then
    if [[ ${KIND:-worker} == investigation && ${REVIEW:-} == 1 ]]; then
      render "$PROMPTS/review.md"
      printf '\n# PR REVIEW REQUEST #%s\n\n' "$PR_NUMBER"
    elif [[ ${KIND:-worker} == investigation ]]; then
      render "$PROMPTS/investigator.md"
      printf '\n# INVESTIGATION REQUEST #%s\n\n' "$INV_ID"
    elif [[ ${KIND:-worker} == helper ]]; then
      render "$PROMPTS/helper.md"
      printf '\n# REQUEST H%s\n\n' "$HELPER_ID"
    elif [[ -n ${TEAM:-} ]]; then
      render "$PROMPTS/team.md"
      render "$PROMPTS/tdd-rounds.md"
      render "$PROMPTS/writing.md"
      printf '\n# TEAM TASK\n\n'
    else
      render "$PROMPTS/protocol.md"
      render "$PROMPTS/tdd-rounds.md"
      render "$PROMPTS/writing.md"
      printf '\n# TASK\n\n'
    fi
    cat "$TASKS/$id/task.md"
    if [[ -n ${RESUMED_FROM:-} ]]; then
      printf '\n\n'
      render "$PROMPTS/resume-checkpoint.md"
      printf '\n## Checkpoints (oldest first)\n'
      local ck="task-$id"; [[ -n ${TEAM:-} ]] && ck="team-$TEAM"
      try checkpoint_read_failed bus checkpoint-get --dir "$BUS_DIR" --key "$ck"
      if [[ -s $TASKS/$id/history.md ]]; then
        printf '\n## Earlier questions and answers from the human (settled — do not ask again)\n'
        cat "$TASKS/$id/history.md"
      fi
    fi
    printf '\n\n'
    cat "$PROMPTS/clarification.md"
    # what "asking a question" means in this system — depends on the role (optional files)
    if [[ -n ${TEAM:-} && -f $PROMPTS/ask-team.md ]]; then
      render "$PROMPTS/ask-team.md"
    elif [[ ${KIND:-worker} != helper && -f $PROMPTS/ask-solo.md ]]; then
      render "$PROMPTS/ask-solo.md"
    fi
    skip_note "$id"
    return
  fi

  local any=0
  if [[ -n ${BOUNCE_PENDING:-} ]]; then
    R[BOUNCE]=$BOUNCE_PENDING
    render "$PROMPTS/verify-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${RBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[ROUND_PROBLEMS]=$RBOUNCE_PENDING
    render "$PROMPTS/round-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${QBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[QUESTIONS_WITHOUT_REC]=$QBOUNCE_PENDING
    render "$PROMPTS/questions-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${SBOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[BAD_STATUS]=$SBOUNCE_PENDING
    render "$PROMPTS/status-bounce.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${ABOUNCE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[DECIDED_FILE]=$ABOUNCE_PENDING
    render "$PROMPTS/autopilot-questions.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${RESTART_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    R[RESTARTED_AT]=$RESTART_PENDING
    render "$PROMPTS/restart-resume.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${PAUSE_RELEASED:-} ]]; then
    ((any)) && printf '\n---\n\n'
    printf 'While you were paused, your board items (%s) went back to the board for others to take over. Do not continue them unless the board shows them free again: take your next work from the board.\n' "$PAUSE_RELEASED"
    any=1
  fi
  if [[ -n ${WAKE_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'
    render "$PROMPTS/team-wake.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${ANSWERS_PENDING:-} ]]; then
    ((any)) && printf '\n---\n\n'

    R[ANSWERED_ROUND]=$ANSWERS_PENDING
    R[ANSWERED_FILE]="$TASKS/$id/questions-$ANSWERS_PENDING.md"
    render "$PROMPTS/resume.md"
    printf '\n---\n\n'
    expand_answers "$TASKS/$id/questions-$ANSWERS_PENDING.md"
    printf '\n'
    any=1
  fi
  if [[ -n ${INV_PENDING_DELIVERY:-} ]]; then
    local j inv_task
    j=$(bus inv-get --dir "$BUS_DIR" --id "$INV_PENDING_DELIVERY")
    inv_task=$(jq -r '.inv_task // empty' <<< "$j")
    R[INV_ID]=$INV_PENDING_DELIVERY
    R[INV_STATUS]=$(jq -r .status <<< "$j")
    R[INV_FILE]=$(jq -r .file <<< "$j")
    R[INV_BRANCH]=$( [[ -n $inv_task ]] && task_field "$inv_task" BRANCH || echo "none")
    ((any)) && printf '\n---\n\n'
    render "$PROMPTS/inv-result.md"
    printf '\n'
    if [[ -n $inv_task && -s $TASKS/$inv_task/result.md ]]; then
      cat "$TASKS/$inv_task/result.md"
    elif [[ -n $inv_task && -s $TASKS/$inv_task/final.md ]]; then
      cat "$TASKS/$inv_task/final.md"
    else
      echo "(the investigator delivered no result — details in ${R[INV_FILE]})"
    fi
    any=1
  fi
  if [[ -s $TASKS/$id/note-$RUN.md ]]; then
    printf '\n---\n\n## Additional note from the human\n\n'
    cat "$TASKS/$id/note-$RUN.md"
    any=1
  fi
  if ((any == 0)); then
    printf 'Continue task %s following the rules from the first message of this session.\n' "$id"
  fi
  skip_note "$id"
}

bus_args_json() { # id → JSON (also valid TOML) array of `agentbus serve` arguments
  if [[ ${REMOTE_TEAM:-} == 1 ]]; then   # a remote team member: its tools run on the lead, through the relay
    printf '%s\n' serve --relay "$JOB_LEAD" --member "$MEMBER" --home "$AGENTS_HOME" | jq -R . | jq -sc .
    return 0
  fi
  local peers
  peers=$(IFS=,; printf '%s' "${!AGENT_TYPE[*]}")
  local role=worker
  [[ ${KIND:-worker} == investigation ]] && role=investigator
  printf '%s\n' serve --dir "$BUS_DIR" --agent "$AGENT" --task "$1" \
    --repo "$REPO_NAME" --branch "$BRANCH" --worktree "$WORKTREE" --peers "$peers,$(investigator_names | paste -sd,)" \
    --role "$role" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --tasks-dir "$TASKS" \
    ${TEAM:+--team "$TEAM"} --tier "${TIER:-normal}" --agent-cmd "$SELF" --home "$AGENTS_HOME" \
    | jq -R . | jq -sc .
}

# ------------------------------------------------------------------ running agent CLIs

act() { # id kind text — activity log entry (read by `agent live` and `agent transcript`)
  local line
  line=$(jq -nc --arg ts "$(date '+%F %T')" --arg k "$2" --arg t "$3" '{ts:$ts,k:$k,t:$t}')
  printf '%s\n' "$line" >> "$TASKS/$1/activity.jsonl"
  printf '%s\n' "$line" >> "$TASKS/$1/activity-full.jsonl"
}

last_event() { # jsonl-file jq-filter — the last event matching the filter
  [[ -f $1 ]] || return 0   # no events yet
  jq_soft event_scan_failed -ncR "last(inputs | fromjson? | select($2))" < "$1"
}

killtree() { # pid — kills a process and all its descendants
  local c
  local c
  for c in $(pgrep -P "$1" || (($? == 1))); do killtree "$c"; done   # pgrep exits 1 when there are no children
  kill -TERM "$1" 2>/dev/null || :   # the process may already have exited — nothing to kill
}

watch_run() { # pid dir n — waits for a CLI run; kills it after AGENT_HANG_MIN min without any event (sets HUNG=1)
  local pid=$1 dir=$2 n=$3 last now f m
  local limit=${AGENT_HANG_SECS:-$((AGENT_HANG_MIN * 60))} poll=${AGENT_HANG_POLL:-15}
  HUNG=0
  while kill -0 "$pid" 2>/dev/null; do   # kill -0 only asks whether the process still exists
    sleep "$poll"
    last=$(date +%s)
    [[ -f $dir/prompt-$n.md ]] && last=$(stat -c %Y "$dir/prompt-$n.md")
    for f in "$dir/activity.jsonl" "$dir/out-$n.jsonl" "$dir/events-$n.jsonl" "$dir/err-$n.log"; do
      [[ -f $f ]] || continue
      m=$(stat -c %Y "$f"); (( m > last )) && last=$m
    done
    now=$(date +%s)
    if (( now - last > limit )) && kill -0 "$pid" 2>/dev/null; then
      HUNG=1
      act "$RUNNER_ID" err "■ watchdog: no activity at all for $AGENT_HANG_MIN min — killing the run"
      killtree "$pid"
      sleep 2
      killtree "$pid"
      break
    fi
  done
  wait "$pid"
}

activity_progress() { # id — number of the agent's own activity entries (excluding entries written by this script)
  [[ -f $TASKS/$1/activity.jsonl ]] || { echo 0; return; }
  jq_soft activity_parse -c 'select(.k != "info" and .k != "err")' "$TASKS/$1/activity.jsonl" | wc -l
}

# The CLI runs in a session (and process group) of its own: a CLI that signals its whole group on its way out —
# some clean up their children so — does not take its runner with it; the runner sees its exit code.
CLI_SESSION=()
if command -v setsid > /dev/null 2>&1; then CLI_SESSION=(setsid -w); fi

run_claude() { # id mode n prompt_file dir ; sets RC, FINAL
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  jq -n --arg cmd "$AGENTBUS_BIN" --argjson args "$(bus_args_json "$id")" \
    '{mcpServers: {agentbus: {command: $cmd, args: $args}}}' > "$dir/mcp.json"
  local args=(-p --output-format stream-json --verbose --dangerously-skip-permissions
              --mcp-config "$dir/mcp.json" --max-turns "$CLAUDE_MAX_TURNS")
  if [[ -n ${MODEL:-} ]]; then args+=(--model "$MODEL"); fi
  if [[ $mode == new ]]; then args+=(--session-id "$SESSION_ID"); else args+=(--resume "$SESSION_ID"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  RC=0
  ( cd "$WORKTREE" || exit 1
    "${CLI_SESSION[@]}" "$CLAUDE_BIN" "${args[@]}" "$(<"$pf")" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/out-$n.jsonl" | "$AGENTBUS_BIN" normalize --type claude --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  local res; res=$(last_event "$dir/out-$n.jsonl" '.type == "result"')
  FINAL=$(jq_soft cli_result_parse -r '.result // empty' <<< "${res:-null}")
  if [[ $(jq_soft cli_result_parse -r '.is_error // false' <<< "${res:-null}") == true ]] && ((RC == 0)); then
    RC=1
  fi
}

run_codex() { # id mode n prompt_file dir ; sets RC, FINAL
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  local args=(exec --json --dangerously-bypass-approvals-and-sandbox
              -C "$WORKTREE" -o "$dir/last-$n.md"
              -c "mcp_servers.agentbus.command=\"$AGENTBUS_BIN\""
              -c "mcp_servers.agentbus.args=$(bus_args_json "$id")"
              -c "mcp_servers.agentbus.tool_timeout_sec=900")
  if [[ -n ${MODEL:-} ]]; then args+=(-m "$MODEL"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  if [[ $mode == resume ]]; then args+=(resume "$SESSION_ID"); fi
  args+=("$(<"$pf")")
  RC=0
  ( cd "$WORKTREE" || exit 1
    "${CLI_SESSION[@]}" "$CODEX_BIN" "${args[@]}" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/events-$n.jsonl" | "$AGENTBUS_BIN" normalize --type codex --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  FINAL=""
  [[ -f $dir/last-$n.md ]] && FINAL=$(<"$dir/last-$n.md")   # codex writes it only when the turn produced a message
  if [[ $mode == new ]]; then
    SESSION_ID=""
    [[ -f $dir/events-$n.jsonl ]] && SESSION_ID=$(jq_soft cli_result_parse -nrR \
      'first(inputs | fromjson? | select(.type == "thread.started") | .thread_id) // empty' < "$dir/events-$n.jsonl")
    meta_set "$id" SESSION_ID "$SESSION_ID"
    [[ -n $SESSION_ID ]] || log_warn session_id_missing "cli=codex" "effect=resume will not work"
  fi
}

run_gemini() { # id mode n prompt_file dir ; sets RC, FINAL  (Antigravity CLI: agy)
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  # agentbus MCP: workspace config (.agents/mcp_config.json), excluded from git locally
  mkdir -p "$WORKTREE/.agents"
  jq -n --arg cmd "$AGENTBUS_BIN" --argjson args "$(bus_args_json "$id")" \
    '{mcpServers: {agentbus: {command: $cmd, args: $args}}}' > "$WORKTREE/.agents/mcp_config.json"
  local excl
  excl="$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$excl")"
  if [[ ! -f $excl ]] || ! grep -qxF '.agents/mcp_config.json' "$excl"; then
    echo '.agents/mcp_config.json' >> "$excl"
  fi

  local args=(--output-format stream-json --dangerously-skip-permissions --print-timeout "$AGY_PRINT_TIMEOUT")
  if [[ -n ${MODEL:-} ]]; then args+=(--model "$MODEL"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  if [[ $mode != new ]]; then args+=(--conversation "$SESSION_ID"); fi
  RC=0
  ( cd "$WORKTREE" || exit 1
    "${CLI_SESSION[@]}" "$AGY_BIN" "${args[@]}" -p "$(<"$pf")" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/out-$n.jsonl" | "$AGENTBUS_BIN" normalize --type gemini --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  local res; res=$(last_event "$dir/out-$n.jsonl" '.event == "result"')
  FINAL=$(jq_soft cli_result_parse -r '.result.response // empty' <<< "${res:-null}")
  if [[ $(jq_soft cli_result_parse -r '.result.status // empty' <<< "${res:-null}") != SUCCESS ]] && ((RC == 0)); then
    RC=1
  fi
  if [[ $mode == new ]]; then
    SESSION_ID=$(jq_soft cli_result_parse -r '.result.conversation_id // empty' <<< "${res:-null}")
    [[ -n $SESSION_ID ]] || SESSION_ID=$(jq_soft cli_result_parse -nrR \
      'first(inputs | fromjson? | select(.event == "init") | .conversation_id) // empty' < "$dir/out-$n.jsonl")
    meta_set "$id" SESSION_ID "$SESSION_ID"
    [[ -n $SESSION_ID ]] || log_warn session_id_missing "cli=agy" "effect=resume will not work"
  fi
}

opencode_config() { # id — per-run configuration (agentbus MCP + providers)
  jq -n --arg cmd "$AGENTBUS_BIN" --argjson args "$(bus_args_json "$1")" --arg model "${MODEL:-}" '
    {
      "$schema": "https://opencode.ai/config.json",
      autoupdate: false,
      mcp: { agentbus: { type: "local", command: ([$cmd] + $args), enabled: true } },
      provider: {
        openrouter: { options: { apiKey: "{env:OPENROUTER_API_KEY}" } },
        deepinfra: {
          npm: "@ai-sdk/openai-compatible", name: "DeepInfra",
          options: { baseURL: "https://api.deepinfra.com/v1/openai", apiKey: "{env:DEEPINFRA_API_KEY}" }
        }
      }
    }
    # a model outside the models.dev catalog (e.g. an OpenRouter preset) must be registered with the provider
    | ($model | split("/")) as $p
    | if ($p | length) > 1 and (.provider[$p[0]] != null)
      then .provider[$p[0]].models[($p[1:] | join("/"))] = { name: ($p[1:] | join("/")) }
      else . end'
}

run_opencode() { # id mode n prompt_file dir ; sets RC, FINAL  (OpenRouter, DeepInfra and other API providers)
  local id=$1 mode=$2 n=$3 pf=$4 dir=$5
  local cfg; cfg=$(opencode_config "$id")
  printf '%s\n' "$cfg" > "$dir/opencode-config.json"
  local args=(run --standalone --format json --auto)
  if [[ -n ${MODEL:-} ]]; then args+=(-m "$MODEL"); fi
  local extra=(); read -ra extra <<< "${EXTRA_ARGS:-}"
  args+=("${extra[@]}")
  if [[ $mode != new ]]; then args+=(--session "$SESSION_ID"); fi
  RC=0
  ( cd "$WORKTREE" || exit 1
    OPENCODE_CONFIG_CONTENT="$cfg" OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS="$OPENCODE_BASH_TIMEOUT_MS" \
      "${CLI_SESSION[@]}" "$OPENCODE_BIN" "${args[@]}" -- "$(<"$pf")" </dev/null 2>"$dir/err-$n.log" \
      | tee "$dir/out-$n.jsonl" | "$AGENTBUS_BIN" normalize --type opencode --full "$dir/activity-full.jsonl" >> "$dir/activity.jsonl"
    exit "${PIPESTATUS[0]}" ) &
  watch_run $! "$dir" "$n" || RC=$?
  if [[ $mode == new ]]; then
    SESSION_ID=$(jq_soft cli_result_parse -nrR 'first(inputs | fromjson? | .sessionID // empty)' < "$dir/out-$n.jsonl")
    meta_set "$id" SESSION_ID "$SESSION_ID"
    [[ -n $SESSION_ID ]] || log_warn session_id_missing "cli=opencode" "effect=resume will not work"
  fi
  FINAL=$(jq_soft cli_result_parse -nrR 'last(inputs | fromjson? | select(.type == "text") | .part.text) // empty' < "$dir/out-$n.jsonl")
  if [[ -z $FINAL && -n ${SESSION_ID:-} ]]; then
    # known opencode issue: in resumed sessions the result is sometimes stored but not printed to stdout
    # older opencode versions have no --standalone (an expected failure); a failure of the fallback is logged
    FINAL=$( (cd "$WORKTREE" && { "$OPENCODE_BIN" session export --standalone "$SESSION_ID" 2>/dev/null \
                                  || try opencode_export_failed "$OPENCODE_BIN" session export "$SESSION_ID"; }) \
      | jq_soft opencode_export_parse -r '[.messages[]? | select(.info.role == "assistant") | .parts[]? | select(.type == "text") | .text] | last // empty')
    [[ -n $FINAL ]] && act "$id" info "result read via opencode session export (stdout was empty)"
  fi
  if [[ -z $FINAL && -f $dir/out-$n.jsonl ]] && grep -q '"type":"error"' "$dir/out-$n.jsonl" && ((RC == 0)); then
    RC=1
  fi
}

notify() { # id status final note
  local id=$1 status=$2 final=$3 note=${4:-}
  stopping && return 0
  meta_load "$id"
  log_info notification "task=$id" "status=$status" "note=$note"
  local label
  case $status in
    done)    label="✅ done"
             if [[ -n ${WORK_ROUND:-} ]]; then label="🔁 round $WORK_ROUND/$WORK_ROUNDS done"; fi ;;
    waiting) label="❓ waiting for answers" ;;
    failed)  label="❌ failed" ;;
    hung)    label="⚠ hung (watchdog)" ;;
    paused)  label="⏸ paused" ;;
    abandoned) label="⚠ team left without members" ;;
    approved) label="✅✅ both reviews: ready to merge" ;;
    merged) label="🔀 merged" ;;
    review-wait) label="⏳ reviews waiting" ;;
    *)       label=$status ;;
  esac
  if [[ ${REVIEW:-} == 1 && $status == done ]]; then   # a PR review: its verdict
    case $(review_task_verdict "$id" "$final") in
      ready-to-merge) label="✅ ready to merge" ;;
      needs-fixes) label="🔧 needs fixes" ;;
      incomplete) label="🧩 incomplete" ;;
      *) label="❌ review without a verdict" ;;
    esac
  fi
  [[ -n $final ]] || final="(no final message from the agent — see: agent log $id)"
  mkdir -p "$NOTIFY_DIR"
  local f="$NOTIFY_DIR/${id}-r${RUN}-summary.md"
  {
    printf '%s\n' "$REPO_NAME"                      # first line = title/thread
    printf 'Repo: %s\n' "$REPO_NAME"
    if [[ ${KIND:-worker} == investigation ]]; then
      printf 'Agent: %s (%s%s) — investigation #%s for %s\n' "${AGENT:-?}" "${TYPE:-?}" "${MODEL:+, $MODEL}" "$INV_ID" "$FROM_AGENT"
    else
      printf 'Agent: %s (%s%s)\n' "${AGENT:-?}" "${TYPE:-?}" "${MODEL:+, $MODEL}"
    fi
    printf 'Time: %s\n' "$(date '+%Y-%m-%d %H:%M')"
    printf 'Task: %s\n' "$id"
    printf 'Status: %s\n' "$label"
    if [[ -n $note ]]; then printf 'Note: %s\n' "$note"; fi
    if [[ ${AGENTS_MD:-} == missing ]]; then printf 'Note: the repository has no AGENTS.md\n'; fi
    if [[ $status == done && -n ${WORK_ROUND:-} ]]; then
      local rref=${TEAM:-$id} rurl
      rurl=$(round_pr_url "$id")
      if [[ -n $rurl ]]; then printf 'PR: %s\n' "$rurl"; fi
      if [[ $(task_field "$id" AUTOPILOT) == 1 && $(task_field "$id" AUTOPILOT_OFF) != 1 ]]; then
        if ((WORK_ROUND < WORK_ROUNDS)); then
          printf 'Next (--autopilot): the checks, then two reviews; with both ready to merge it merges it and starts round %s by itself — to stop that: agent autopilot %s off\n' $((WORK_ROUND + 1)) "$rref"
        else
          printf 'Next (--autopilot): the checks, then two reviews; with both ready to merge it merges it and the task is complete — to stop that: agent autopilot %s off\n' "$rref"
        fi
      elif ((WORK_ROUND < WORK_ROUNDS)); then
        printf 'Next: merge the PR of round %s, then: agent run --resume %s (round %s)\n' "$WORK_ROUND" "$rref" $((WORK_ROUND + 1))
        printf 'Review fixes on the same PR first: agent run --resume %s --same-round "…"\n' "$rref"
      else
        printf 'This was the last round (%s/%s): merge the PR and the task is complete.\n' "$WORK_ROUND" "$WORK_ROUNDS"
      fi
    fi
    if [[ $status == waiting ]]; then
      printf 'Questions: %s — answer with: agent answer %s\n' \
        "$(count_questions "$TASKS/$id/questions-$ROUND.md")" "$id"
      if [[ -n $AGENT_WEB_URL ]]; then printf 'Answer: %s/questions/%s?max=1\n' "${AGENT_WEB_URL%/}" "$id"; fi
    elif [[ -n $AGENT_WEB_URL ]]; then
      printf 'Open: %s/task/%s\n' "${AGENT_WEB_URL%/}" "$id"
    fi
    if [[ -n ${WORKTREE:-} && -f $WORKTREE/.agents/reports/$id.md ]]; then   # a proxy task has no worktree
      printf 'Report: .agents/reports/%s.md (branch %s)\n' "$id" "$BRANCH"
    fi
    if [[ ${KIND:-worker} == worker && $status != waiting ]]; then
      local invs
      invs=$(try inv_list_failed bus inv-list --dir "$BUS_DIR" --task "$id")
      if [[ -n $invs ]]; then printf 'Investigations:\n%s\n' "$invs"; fi
    fi
    printf '\n%s\n' "${final:0:$NOTIFY_MAX_CHARS}"
  } > "$f"
  notify_send "$f"
}

# ------------------------------------------------------------------ investigations

pick_investigator() { # last free... — the next investigator in the rotation (sorted names) after the last one,
  # preferring another provider than the last one's; when every free one shares it, the next free one anyway.
  # Exit 1: none is free.
  local last=$1 names=() i k n start=0 cand first="" lastp=""
  shift
  (($#)) || return 1
  mapfile -t names < <(investigator_names)
  n=${#names[@]}
  for i in "${!names[@]}"; do
    if [[ ${names[i]} == "$last" ]]; then start=$((i + 1)); fi
  done
  [[ -n $last && -n ${INVESTIGATORS_TYPE[$last]:-} ]] && lastp=$(agent_auth_target "$last" | cut -f1)
  for ((k = 0; k < n; k++)); do
    cand=${names[(start + k) % n]}
    is_one_of "$cand" "$@" || continue
    [[ -n $first ]] || first=$cand
    if [[ -z $lastp || $(agent_auth_target "$cand" | cut -f1) != "$lastp" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  printf '%s' "$first"
}

is_one_of() { # word words... — is the word among the words?
  local w=$1 x
  shift
  for x in "$@"; do [[ $x == "$w" ]] && return 0; done
  return 1
}

remember_investigator() { # name — the investigator that got the last request (the rotation starts after it)
  printf '%s\n' "$1" > "$AGENTS_HOME/last-investigator.tmp.$$"
  mv "$AGENTS_HOME/last-investigator.tmp.$$" "$AGENTS_HOME/last-investigator"
}

free_investigator() { # the next free investigator in the rotation (not working, not waiting for the human's answers)
  local inv d busy free=() last=""
  while read -r inv; do
    busy=0
    for d in "$TASKS"/*/; do
      [[ -f $d/meta.env ]] || continue
      d=${d%/}; d=${d##*/}
      [[ $(task_field "$d" AGENT) == "$inv" && $(task_field "$d" KIND) == investigation ]] || continue
      case $(task_field "$d" STATUS) in new|starting|running|waiting) busy=1; break ;; esac
    done
    ((busy)) || free+=("$inv")
  done < <(investigator_names)
  ((${#free[@]})) || return 1
  if [[ -f $AGENTS_HOME/last-investigator ]]; then last=$(<"$AGENTS_HOME/last-investigator"); fi
  pick_investigator "$last" "${free[@]}"
}

dispatch() { # starts queued requests on free investigators
  stopping && return 0
  (
    exec 9>"$AGENTS_HOME/dispatch.lock"
    flock -w 120 9 || { log_warn dispatch_lock_timeout "lock=$AGENTS_HOME/dispatch.lock" "effect=queued investigations wait for the next dispatch"; exit 0; }
    local inv j
    start_review_pairs
    while inv=$(free_investigator); do
      j=$(bus inv-next --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS") || break
      [[ -n $j ]] || break
      remember_investigator "$inv"
      start_investigation "$j" "$inv" || log_error investigation_start_failed "investigation=$(jq -r .id <<< "$j")" "investigator=$inv"
    done
  )
}

start_investigation() { # request-json (status "starting") investigator-name
  local j=$1 iname=$2 inv_id from_task from_agent
  inv_id=$(jq -r .id <<< "$j"); from_task=$(jq -r .from_task <<< "$j"); from_agent=$(jq -r .from_agent <<< "$j")
  log_info investigation_starting "investigation=$inv_id" "investigator=$iname" "requester=$from_agent" "requesting_task=$from_task"
  local p_root p_repo p_branch p_wt
  p_root=$(task_field "$from_task" REPO_ROOT); p_repo=$(task_field "$from_task" REPO_NAME)
  p_branch=$(task_field "$from_task" BRANCH);  p_wt=$(task_field "$from_task" WORKTREE)
  local ts id branch wt dir
  ts=$(date +%Y%m%d-%H%M%S)
  id="$ts-inv$inv_id"
  branch="$BRANCH_PREFIX/$iname/inv$inv_id-$ts"
  wt="$AGENTS_HOME/worktrees/$p_repo/$id"
  dir="$TASKS/$id"
  mkdir -p "$dir" "$(dirname "$wt")"
  if ! git -C "$p_root" worktree add --quiet -b "$branch" "$wt" "$p_branch"; then
    bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status failed --summary "could not create the investigator worktree"
    meta_set "$from_task" INV_PENDING_DELIVERY "$inv_id"
    maybe_resume_worker "$from_task"
    return 1
  fi
  local kind pr_url pr_num
  kind=$(jq -r '.kind // empty' <<< "$j"); pr_url=$(jq -r '.pr_url // empty' <<< "$j"); pr_num=$(jq -r '.pr_number // empty' <<< "$j")
  if [[ $kind == review ]]; then
    {
      printf '## Recenzja PR #%s\n\n%s\n\n' "$pr_num" "$pr_url"
      printf '## The task the team worked on\n\n'
      if [[ -f $TASKS/$from_task/task.md ]]; then cat "$TASKS/$from_task/task.md"; else echo "—"; fi
    } > "$dir/task.md"
  else
    {
      printf '## Question from %s\n\n%s\n\n' "$from_agent" "$(jq -r .question <<< "$j")"
      printf '## Context from the agent\n\n%s\n' "$(jq -r '.context // "—"' <<< "$j")"
    } > "$dir/task.md"
  fi
  : > "$dir/meta.env"
  local sid=""
  [[ ${INVESTIGATORS_TYPE[$iname]} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
  local kv
  for kv in "ID=$id" "AGENT=$iname" "KIND=investigation" "INV_ID=$inv_id" \
            "PARENT_TASK=$from_task" "FROM_AGENT=$from_agent" "PARENT_WORKTREE=$p_wt" \
            "TYPE=${INVESTIGATORS_TYPE[$iname]}" "MODEL=${INVESTIGATORS_MODEL[$iname]:-}" "EXTRA_ARGS=${INVESTIGATORS_EXTRA_ARGS[$iname]:-}" \
            "REPO_NAME=$p_repo" "REPO_ROOT=$p_root" "WORKTREE=$wt" "BRANCH=$branch" \
            "BASE=$p_branch" "SESSION_ID=$sid" "ROUND=0" "RUN=0" "STATUS=new" "CREATED=$(date -Is)"; do
    meta_set "$id" "${kv%%=*}" "${kv#*=}"
  done
  if [[ $kind == review ]]; then
    meta_set "$id" REVIEW 1; meta_set "$id" PR_URL "$pr_url"; meta_set "$id" PR_NUMBER "$pr_num"
  fi
  bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status running --inv-task "$id"
  if ! start_runner "$id" new; then
    inv_finish "$id" failed "STATUS: FAILED
Answer: the investigator could not be started"
    return 1
  fi
}

inv_finish() { # investigator-task-id status result-text
  local id=$1 status=$2 text=$3
  local inv_id parent j file summary
  inv_id=$(task_field "$id" INV_ID); parent=$(task_field "$id" PARENT_TASK)
  j=$(bus inv-get --dir "$BUS_DIR" --id "$inv_id")
  file=$(jq -r .file <<< "$j")
  # the investigator's answer line; absent in a malformed result (then the fallbacks below apply)
  summary=$(grep -m1 -E '^(Answer|Odpowiedź):' <<< "$text" | sed -E 's/^(Answer|Odpowiedź):[[:space:]]*//') || summary=""
  if [[ -z $summary ]]; then
    [[ -f $TASKS/$id/result.md ]] && summary=$(awk '/^## (Answer|Odpowiedź)/{f=1;next} /^## /{f=0} f&&NF{print;exit}' "$TASKS/$id/result.md")
  fi
  [[ -n $summary ]] || summary=$(printf '%s' "$text" | grep -m1 -v '^STATUS:') || summary="(no answer line in the result)"
  {
    printf '\n## Investigator result (%s, %s)\n\n' "$status" "$(date '+%Y-%m-%d %H:%M')"
    printf -- '- Investigator task: %s, branch: %s\n\n' "$id" "$(task_field "$id" BRANCH)"
    if [[ -s $TASKS/$id/result.md ]]; then cat "$TASKS/$id/result.md"; else printf '%s\n' "$text"; fi
  } >> "$file"
  bus inv-set --dir "$BUS_DIR" --id "$inv_id" --status "$status" --summary "${summary:0:300}"
  meta_set "$parent" INV_PENDING_DELIVERY "$inv_id"
  maybe_resume_worker "$parent"
}

maybe_resume_worker() { # resumes the requesting agent if the investigation was the only thing it waited for
  stopping && return 0
  local t=$1
  [[ $(task_field "$t" STATUS) == investigating ]] || return 0
  [[ -z $(bus inv-pending --dir "$BUS_DIR" --task "$t") ]] || return 0
  local ag busy
  ag=$(task_field "$t" AGENT)
  if busy=$(agent_running_task "$ag"); then
    log_warn resume_postponed "task=$t" "agent=$ag" "busy_with=$busy" "action=resume manually: agent resume $t"
    return 0
  fi
  start_runner "$t" resume || log_error resume_failed "task=$t" "reason=after investigation"
}

# ------------------------------------------------------------------ worker requests (delegate)

free_worker() { # a free worker; balances providers: picks the provider with the fewest working workers
  local w d p best="" bestp=""
  declare -A busy=()
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    d=${d%/}; d=${d##*/}
    case $(task_field "$d" STATUS) in running|starting) ;; *) continue ;; esac
    [[ $(task_field "$d" TIER) == worker ]] || continue
    p=$(agent_provider "$(task_field "$d" AGENT)"); busy[$p]=$(( ${busy[$p]:-0} + 1 ))
  done
  for w in "${WORKER_AGENTS[@]}"; do   # within a provider the list order decides
    [[ -n ${AGENT_TYPE[$w]:-} ]] || continue
    agent_running_task "$w" >/dev/null && continue
    p=$(agent_provider "$w")
    if [[ -z $best ]] || (( ${busy[$p]:-0} < ${busy[$bestp]:-0} )); then best=$w; bestp=$p; fi
  done
  [[ -n $best ]] && { printf '%s' "$best"; return 0; }
  return 1
}

dispatch_helpers() { # assigns queued requests to free workers
  stopping && return 0
  (
    exec 7>"$AGENTS_HOME/helpers.lock"
    flock -w 60 7 || exit 0
    local caps='[]'
    if ((${#INSTANCE_CAPABILITIES[@]})); then caps=$(printf '%s\n' "${INSTANCE_CAPABILITIES[@]}" | jq -R . | jq -s .); fi
    if [[ -z ${LEAD_URL:-} ]]; then
      local remote_open rows
      if remote_open=$(bus helper-remote-list --dir "$BUS_DIR" --capabilities "$caps"); then
        if rows=$(jq -c '.[]' <<< "$remote_open"); then
          local rh rh_id
          while read -r rh; do
            [[ -n $rh ]] || continue
            if [[ $(jq -r '.status // empty' <<< "$rh") == "queued" ]]; then
              rh_id=$(jq -r '.id' <<< "$rh")
              try helper_finish_failed bus helper-remote-finish --dir "$BUS_DIR" --id "$rh_id" --state failed --node "" --branch "" --result "remote delegation requires LEAD_URL in config/agents.conf"
            fi
          done <<< "$rows"
        else
          log_warn helper_remote_list_parse_failed
        fi
      else
        log_warn helper_remote_list_failed
      fi
    fi
    ((${#WORKER_AGENTS[@]})) || exit 0
    local w j
    while w=$(free_worker); do
      j=$(bus helper-next --dir "$BUS_DIR" --worker "$w" --capabilities "$caps") || break
      [[ -n $j ]] || break
      start_helper "$j" "$w" || log_error helper_start_failed "request=$(jq -r .id <<< "$j")" "worker=$w"
    done
  )
}

start_helper() { # request-json worker
  local j=$1 w=$2 hid from from_task
  hid=$(jq -r .id <<< "$j"); from=$(jq -r .from <<< "$j"); from_task=$(jq -r .from_task <<< "$j")
  log_info helper_starting "request=H$hid" "worker=$w" "requester=$from" "requesting_task=$from_task"
  local p_root p_repo p_branch p_wt
  p_root=$(task_field "$from_task" REPO_ROOT); p_repo=$(task_field "$from_task" REPO_NAME)
  p_branch=$(task_field "$from_task" BRANCH);  p_wt=$(task_field "$from_task" WORKTREE)
  local ts id branch wt dir
  ts=$(date +%Y%m%d-%H%M%S)
  id="$ts-$w-h$hid"
  branch="$BRANCH_PREFIX/$w/h$hid-$ts"
  wt="$AGENTS_HOME/worktrees/$p_repo/$id"
  dir="$TASKS/$id"
  mkdir -p "$dir" "$(dirname "$wt")"
  if [[ -z $p_root ]] || ! git -C "$p_root" worktree add --quiet -b "$branch" "$wt" "$p_branch"; then
    try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status failed --summary "could not create the worktree"
    notice helper_start_failed agentbus "$from" "RESULT H$hid: failed — the worker could not be started (worktree)." "request=H$hid" "worker=$w"
    rm -rf "$dir"
    return 1
  fi
  {
    printf '## Request H%s from %s\n\n%s\n\n' "$hid" "$from" "$(jq -r .request <<< "$j")"
    printf '## Kontekst\n\n%s\n' "$(jq -r '.context // "—"' <<< "$j")"
  } > "$dir/task.md"
  : > "$dir/meta.env"
  local sid=""
  [[ ${AGENT_TYPE[$w]} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
  local kv
  for kv in "ID=$id" "AGENT=$w" "KIND=helper" "TIER=worker" "HELPER_ID=$hid" "PARENT_TASK=$from_task" \
            "FROM_AGENT=$from" "PARENT_WORKTREE=$p_wt" "TYPE=${AGENT_TYPE[$w]}" "MODEL=${AGENT_MODEL[$w]:-}" \
            "EXTRA_ARGS=${AGENT_EXTRA_ARGS[$w]:-}" "REPO_NAME=$p_repo" "REPO_ROOT=$p_root" "WORKTREE=$wt" \
            "BRANCH=$branch" "BASE=$p_branch" "SESSION_ID=$sid" "ROUND=0" "RUN=0" "STATUS=new" "CREATED=$(date -Is)"; do
    meta_set "$id" "${kv%%=*}" "${kv#*=}"
  done
  bus helper-set --dir "$BUS_DIR" --id "$hid" --status running --task "$id"
  if ! start_runner "$id" new; then
    helper_finish "$id" failed "the worker could not be started"
    return 1
  fi
}

helper_finish() { # worker-task-id status text — the result goes back to the requester as a message
  local id=$1 status=$2 text=$3
  local hid from
  hid=$(task_field "$id" HELPER_ID); from=$(task_field "$id" FROM_AGENT)
  [[ -n $text ]] || text="(no result — see: agent log $id)"
  local st=done
  [[ $status == done ]] || st=failed
  try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status "$st" --summary "${text:0:2000}"
  notice helper_result "$(task_field "$id" AGENT)" "$from" "RESULT H$hid [$st]: ${text:0:3500}" "request=H$hid" "status=$st"
  act "$id" info "■ result H$hid sent to $from ($st)"
}

pl_commits() { # number → "1 commit" / "N commits"
  local n=$1
  if ((n == 1)); then echo "1 commit"; else echo "$n commits"; fi
}

verify_gaps() { # coordinator-id — gaps before closing a --verify team (empty = all good)
  local br=$BRANCH wt=$WORKTREE pr cnt m mb
  local errf; errf=$(mktemp)
  if pr=$(trusted_prs "$wt" "$br" all number,isDraft,state 2>"$errf"); then
    if [[ $(jq_soft pr_lookup_parse 'length' <<< "$pr") == 0 ]]; then
      echo "- no PR from your branch $br — open it (gh pr create --base $BASE --head $br)"
    elif [[ $(jq -r '.[0].isDraft' <<< "$pr") == true ]]; then
      echo "- PR #$(jq -r '.[0].number' <<< "$pr") is still a draft — when the work is complete: gh pr ready"
    fi
  else
    # without GitHub access the PR check cannot run; the other checks still apply
    log_warn verify_pr_check_failed "branch=$br" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  if git -C "$wt" rev-parse --verify -q "origin/$br" >/dev/null; then
    cnt=$(git -C "$wt" rev-list --count "origin/$br..$br")
    ((cnt > 0)) && echo "- unpushed changes on $br ($(pl_commits "$cnt")) — git push"
  fi
  while IFS=$'\t' read -r m mb; do
    [[ -n $mb && $m != "$AGENT" ]] || continue
    if ! git -C "$wt" rev-parse --verify -q "$mb" >/dev/null; then
      log_warn verify_member_branch_missing "member=$m" "branch=$mb"
      continue
    fi
    cnt=$(git -C "$wt" rev-list --count "$br..$mb")
    ((cnt > 0)) && echo "- member $m's branch ($mb) has unmerged changes ($(pl_commits "$cnt")) relative to $br — merge them or explain in the report why they are not needed"
  done < <(team_json "$TEAM" | jq -r '.members[]? | select(.state != "excluded") | "\(.agent)\t\(.branch)"')
  return 0
}

final_status() { # last message → DONE|ROUND_DONE|FAILED|QUESTIONS|INVESTIGATING|SLEEPING|EXCLUDED or nothing
  # no STATUS line → empty output (grep exits 1, which is the expected "not found")
  sed 's/[*`]//g' <<< "$1" | { grep -oE '^[[:space:]]*STATUS:[[:space:]]*[A-Z_]+' || (($? == 1)); } | head -1 | sed -E 's/.*STATUS:[[:space:]]*//'
}

questions_from_nostatus() { # message id round — questions file used when the agent ended its turn without a STATUS line
  printf '# Questions — %s (round %s)\n\n' "$2" "$3"
  printf '_The agent ended its turn without a STATUS line — most likely it stopped halfway or is waiting for permission. Its last message is below._\n\n'
  printf '## 1. What should the agent do next? (e.g. "continue as planned", "finish", or a specific instruction)\n\n'
  sed 's/^/> /' <<< "$1"
  printf '\n**Verdict:**\n'
}

questions_from_final() { # last-message-text id round → questions file on stdout (when the agent did not write the file)
  printf '%s\n' "$1" | awk -v id="$2" -v round="$3" '
    /^[[:space:]]*STATUS:/ { stop = 1 }
    stop { next }
    {
      line = $0
      if (match(line, /^[[:space:]]*(\*\*)?[0-9]+[.)][[:space:]]+/)) {
        n++; head = substr(line, RLENGTH + 1); gsub(/\*\*/, "", head)
        q[n] = head; body[n] = ""; next
      }
      if (n == 0) { pre = pre line "\n"; next }
      body[n] = body[n] line "\n"
    }
    END {
      printf "# Questions — %s (round %s)\n\n", id, round
      printf "_The agent asked these in its last message instead of the file — the script moved them here._\n\n"
      if (n == 0) {
        gsub(/\n+$/, "", pre)
        printf "## 1. Answer the questions from the agent\n\n%s\n\n**Verdict:**\n", pre
        exit
      }
      for (i = 1; i <= n; i++) {
        b = body[i]; gsub(/\n+$/, "", b)
        printf "## %d. %s\n", i, q[i]
        if (b != "") printf "%s\n", b
        printf "\n**Verdict:**\n\n"
      }
    }'
}

# ------------------------------------------------------------------ runner (background)

# runner_exit rc — the EXIT trap of a runner that did not finish normally (killed, stopped or crashed).
# Every step runs through try: one failing step must not prevent the others (status, queues, notification).
runner_exit() {
  local rc=$1
  # A persisted outcome can still have an interrupted local result delivery.
  if ((RUNNER_DONE)); then
    [[ -n ${JOB_ID:-} && -f $TASKS/$RUNNER_ID/node-stop-requested && ${RUNNER_DELIVERED:-0} == 0 ]] || return 0
  fi
  RUNNER_DONE=1
  if stopping; then   # agent stop --running: no notifications, queues or messages
    try meta_write_failed meta_set "$RUNNER_ID" STATUS stopped
    try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
    try activity_write_failed act "$RUNNER_ID" info "■ stopped (agent stop --running)"
    log_info run_stopped "reason=agent stop --running"
    return
  fi
  if [[ -n ${JOB_ID:-} && -f $TASKS/$RUNNER_ID/node-stop-requested ]]; then
    local node_status node_finished node_final="${FINAL:-}"
    node_status=$(task_field "$RUNNER_ID" STATUS)
    node_finished=$(task_field "$RUNNER_ID" FINISHED)
    # Completion may have persisted its outcome just before SIGTERM interrupted final delivery.
    if [[ ! $node_status =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
      node_status=stopped
      node_finished=""
      try meta_write_failed meta_set "$RUNNER_ID" STATUS "$node_status"
    fi
    if [[ -z $node_finished ]]; then
      try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
    fi
    if [[ -f $TASKS/$RUNNER_ID/final.md ]]; then node_final=$(<"$TASKS/$RUNNER_ID/final.md"); fi
    log_info run_stopped "reason=node_job_cancel" "status=$node_status"
    try notification_failed notify "$RUNNER_ID" "$node_status" "$node_final" "node job cancellation"
    RUNNER_DELIVERED=1
    try dispatch_failed dispatch
    try dispatch_failed dispatch_helpers
    return
  fi
  local why="runner interrupted (exit code $rc) — see: agent log $RUNNER_ID"
  [[ -f $TASKS/$RUNNER_ID/stop-requested ]] && why="stopped by the user"
  log_warn run_interrupted "exit_code=$rc" "reason=$why"
  try meta_write_failed meta_set "$RUNNER_ID" STATUS failed
  try meta_write_failed meta_set "$RUNNER_ID" FINISHED "$(date -Is)"
  try activity_write_failed act "$RUNNER_ID" err "■ $why"
  if [[ ${KIND:-worker} == investigation ]]; then
    try investigation_finish_failed inv_finish "$RUNNER_ID" failed "STATUS: FAILED
Answer: investigation interrupted ($why)"
    if [[ ${REVIEW:-} == 1 ]]; then try review_followup_failed review_without_verdict "$RUNNER_ID" "$why"; fi
  fi
  if [[ ${KIND:-worker} == helper ]]; then
    try helper_finish_failed helper_finish "$RUNNER_ID" failed "interrupted: $why"
  elif [[ -n ${TEAM:-} ]]; then
    try team_update_failed team_after_run "$RUNNER_ID" failed "" "$why"
  else
    try notification_failed notify "$RUNNER_ID" failed "" "$why"
  fi
  try dispatch_failed dispatch
  try dispatch_failed dispatch_helpers
}

cmd__runner() {
  local id=$1 mode=$2
  local dir="$TASKS/$id"
  exec >>"$dir/runner.log" 2>&1 3>&1   # fd 3: structured log records (log_event)
  export LC_ALL=C.UTF-8 MCP_TOOL_TIMEOUT=900000
  RUNNER_ID=$id
  meta_load "$id"
  local n=$RUN
  log_info run_started "run=$n" "mode=$mode" "agent=$AGENT" "cli=$TYPE" "kind=${KIND:-worker}" "model=${MODEL:-}"

  if [[ -f $AGENTS_HOME/secrets.env ]]; then
    set -a; source "$AGENTS_HOME/secrets.env"; set +a
  fi
  local v
  for v in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY CODEX_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY DEEPINFRA_API_KEY; do
    if [[ -z ${!v:-} ]]; then unset "$v"; fi
  done

  git_identity
  # Bounce paths owe no delivery; normal finalization opens the delivery window below.
  RUNNER_ID=$id RUNNER_DONE=0 RUNNER_DELIVERED=1
  echo $$ > "$dir/runner.pid"
  rm -f "$dir/acked"
  act "$id" info "▶ run $n ($mode)"
  trap 'runner_exit $?' EXIT
  trap 'exit 143' TERM INT HUP
  rm -f "$dir/stop-requested"
  # the boot ID before the run shows as running: a later boot ID means its machine restarted under this run, and a run
  # seen as running without one would be taken for a dead runner after a restart at its very start
  meta_set "$id" RUN_BOOT "$(boot_id)"
  meta_set "$id" STATUS running
  # for the wake-loop guard: when the run started, the commit it started from, the agent's bus messages so far
  local run_start run_head0 run_msgs0
  run_start=$(date +%s)
  run_head0=$(git -C "$WORKTREE" rev-parse HEAD) || run_head0="unknown"
  run_msgs0=$(bus_messages_from "$AGENT")
  meta_set "$id" RUN_STARTS "$(recent_run_starts "$(task_field "$id" RUN_STARTS)" "$run_start")"

  if [[ $mode == new && -f $WORKTREE/.gitmodules ]]; then
    try submodule_update_failed git -C "$WORKTREE" submodule update --init --recursive
  fi

  local next_round=$((ROUND + 1))
  local qfile="$dir/questions-$next_round.md"
  local pf="$dir/prompt-$n.md"
  build_prompt "$id" "$mode" "$qfile" "$next_round" > "$pf"
  meta_set "$id" ANSWERS_PENDING ""
  meta_set "$id" INV_PENDING_DELIVERY ""
  meta_set "$id" WAKE_PENDING ""
  meta_set "$id" RESTART_PENDING ""
  meta_set "$id" ABOUNCE_PENDING ""
  meta_set "$id" BOUNCE_PENDING ""
  meta_set "$id" QBOUNCE_PENDING ""
  meta_set "$id" SBOUNCE_PENDING ""
  meta_set "$id" PAUSE_RELEASED ""
  meta_set "$id" RBOUNCE_PENDING ""
  if [[ -n ${TEAM:-} && ${REMOTE_TEAM:-} != 1 ]]; then   # a remote member's state is set by the lead
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state active >/dev/null
  fi

  # Watchdog: a hang (no activity for AGENT_HANG_MIN min) kills the run. Normal models,
  # coordinators, investigators and solo tasks are resumed in the same session (up to AGENT_HANG_STRIKES
  # consecutive hangs without progress). Workers in a team or on a delegate request are not auto-resumed.
  local nrun=$n attempt=0 hangs=${HANGS:-0} prog hang_final=0
  local auto_resume=1
  [[ ${TIER:-normal} == worker && ( ${KIND:-worker} == helper || -n ${TEAM:-} ) ]] && auto_resume=0
  while :; do
    prog=$(activity_progress "$id")
    RC=0 FINAL="" HUNG=0
    agents_gh_env || die "the agents' gh (agent as gh) could not be set up: no run without it"
    case $TYPE in
      claude) run_claude "$id" "$mode" "$nrun" "$pf" "$dir" ;;
      codex)  run_codex  "$id" "$mode" "$nrun" "$pf" "$dir" ;;
      gemini) run_gemini "$id" "$mode" "$nrun" "$pf" "$dir" ;;
      opencode) run_opencode "$id" "$mode" "$nrun" "$pf" "$dir" ;;
      *)      echo "unknown agent type: $TYPE"; RC=2 ;;
    esac
    log_info cli_finished "run=$nrun" "exit_code=$RC" "hung=$HUNG"
    if ((HUNG == 0)); then
      meta_set "$id" HANGS 0
      break
    fi
    if (( $(activity_progress "$id") > prog )); then hangs=1; else hangs=$((hangs + 1)); fi
    meta_set "$id" HANGS "$hangs"
    if ((auto_resume == 0)); then break; fi
    if (( hangs >= AGENT_HANG_STRIKES )) || [[ -z ${SESSION_ID:-} ]]; then hang_final=1; break; fi
    attempt=$((attempt + 1)); nrun="$n.h$attempt"; mode=resume
    pf="$dir/prompt-$nrun.md"
    R[HANG_MIN]=$AGENT_HANG_MIN
    render "$PROMPTS/hang-resume.md" > "$pf"
    act "$id" info "↻ resumed after a hang ($hangs/$AGENT_HANG_STRIKES)"
  done
  printf '%s\n' "$FINAL" > "$dir/final.md"

  local status note="" pending="" member_q=0 member_ns=0 fst pause_secs=0 pause_reason="" qgen=0 norec=""
  [[ ${KIND:-worker} == worker ]] && pending=$(bus inv-pending --dir "$BUS_DIR" --task "$id")
  fst=$(final_status "$FINAL")
  local is_member=0
  [[ -n ${TEAM:-} && ${KIND:-worker} == worker && $AGENT != "$(team_lead "$TEAM")" ]] && is_member=1

  # A turn without STATUS (e.g. "may I continue?") does not mean the work is done: the human decides
  # (a team member asks the coordinator instead; a worker's text is returned as its result).
  if [[ ! -s $qfile && -z $fst && -n ${FINAL//[[:space:]]/} && $RC == 0 && $HUNG == 0 && -z $pending ]]; then
    if ((is_member)); then
      member_ns=1
    elif [[ ${KIND:-worker} != helper ]]; then
      questions_from_nostatus "$FINAL" "$id" "$next_round" > "$qfile"; qgen=1
      act "$id" info "turn without STATUS — the last message was passed to you as a question ($qfile)"
    fi
  fi

  # The agent asked its questions only in its last message (no file): do not lose them.
  if [[ ! -s $qfile && $fst == QUESTIONS ]]; then
    if ((is_member)); then
      member_q=1   # team member → questions go to the coordinator (below)
    elif [[ ${KIND:-worker} != helper ]]; then
      questions_from_final "$FINAL" "$id" "$next_round" > "$qfile"; qgen=1
      act "$id" info "questions from the last message moved to $qfile"
    fi
  fi

  if ((HUNG)) && ((auto_resume == 0)); then
    # hung worker: stopped; normal models are told and can start it again
    if [[ ${KIND:-worker} == helper ]]; then
      status=failed; note="the worker hung"
      FINAL="STATUS: FAILED
Result: THE WORKER HUNG — there was no activity for $AGENT_HANG_MIN min, so it was stopped. Delegate the task again — it goes to a free worker; if possible split it into smaller steps."
    else
      status=sleeping; note="the worker hung — stopped"
      local released lead nm
      released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" | paste -sd,)
      lead=$(team_lead "$TEAM")
      for nm in $(bus team-get --dir "$BUS_DIR" --team "$TEAM" | jq -r '.members[] | select(.tier != "worker" and (.state == "active" or .state == "sleeping" or .state == "waking")) | .agent'); do
        notice worker_hung agentbus "$nm" "WORKER $AGENT HUNG (no activity for $AGENT_HANG_MIN min) and was stopped.${released:+ Its items ($released) are back on the board.} Try starting it again — a message to it or a new board item wakes it — or give the work to someone else.${lead:+ Coordinator: $lead.}" \
          "agent=$AGENT" "team=$TEAM" "released=$released"
      done
    fi
  elif ((hang_final)); then
    status=hung; note="the agent hung $hangs times in a row without progress"
  elif { ((RC != 0)) || [[ -z $fst ]]; } && pause_secs=$(quota_reset_seconds "$dir" "$nrun" "$FINAL"); then
    status=paused
    pause_reason=$(limit_kind "$dir" "$nrun" "$FINAL")
    local why resume_at
    why=$(limit_line "$dir" "$nrun" "$FINAL" "$pause_reason")
    resume_at=$(date -d "@$(( $(date +%s) + pause_secs ))" '+%H:%M')
    ((pause_secs <= 20 * 3600)) || resume_at=$(date -d "@$(( $(date +%s) + pause_secs ))" '+%d.%m %H:%M')
    if [[ $pause_reason == rate_limit ]]; then
      note="the provider is rate-limiting requests (HTTP 429) — not out of credits; resumes at $resume_at${why:+ — $why}"
    elif [[ $pause_reason == overloaded ]]; then
      note="the model is overloaded at the provider (at capacity) — not your account; resumes at $resume_at${why:+ — $why}"
    elif [[ $pause_reason == network ]]; then
      local np last
      np=1
      last=$(task_field "$id" NETWORK_RUN)
      if [[ $last == "$((nrun - 1))" ]]; then   # the run before ended on the network too: in a row
        np=$(task_field "$id" NETWORK_PAUSES); np=$(( ${np:-0} + 1 ))
      fi
      meta_set "$id" NETWORK_PAUSES "$np"
      meta_set "$id" NETWORK_RUN "$nrun"
      if ((np > AGENT_NETWORK_MAX_PAUSES)); then   # not a passing outage: the human looks
        status=failed
        note="the network or the provider has been unreachable $np times in a row (AGENT_NETWORK_MAX_PAUSES=$AGENT_NETWORK_MAX_PAUSES)${why:+ — $why}"
      else
        note="the network or the provider was unreachable — nothing the agent did; resumes at $resume_at (attempt $np of $AGENT_NETWORK_MAX_PAUSES)${why:+ — $why}"
      fi
    else
      note="the provider's quota or usage limit is exhausted — resumes at $resume_at${why:+ — $why}"
    fi
    # an --autopilot pair does not wait days for one review: out of quota, it ends without a verdict (the pair has it
    # done again by another investigator), and its investigator is not chosen until the quota resets (QUOTA_UNTIL)
    if [[ ${REVIEW:-} == 1 && $pause_reason == quota && -n $(task_field "$(task_field "$id" PARENT_TASK)" REVIEW_PAIR) ]]; then
      status=failed
      meta_set "$id" QUOTA_UNTIL "$(( $(date +%s) + pause_secs ))"
      note="the investigator's provider is out of quota until $resume_at — the review goes to another investigator${why:+ — $why}"
    fi
  elif [[ -s $qfile ]]; then
    # every question the agent wrote must carry a recommendation; without one it gets the file back once
    if ((qgen == 0)) && [[ $(task_field "$id" QUESTIONS_BOUNCED) != "$next_round" ]]; then
      norec=$(questions_missing_recommendations "$qfile")
    fi
    if [[ -n $norec ]]; then
      status=qbounce
    elif [[ ${AUTOPILOT:-} == 1 && ${AUTOPILOT_OFF:-} != 1 && $(task_field "$id" AUTOPILOT_QBOUNCED) != "$next_round" ]]; then
      status=abounce   # --autopilot: nobody answers — the agent decides, once a round
    else
      meta_set "$id" ROUND "$next_round"
      status=waiting
    fi
  elif [[ -n $pending ]]; then
    status=investigating
  elif [[ -n ${TEAM:-} ]] && { [[ $fst == EXCLUDED ]] || \
       [[ $(team_json "$TEAM" | jq -r --arg a "$AGENT" '.members[$a].state // empty') == excluded ]]; }; then
    status=excluded
  elif [[ -n ${TEAM:-} && $fst == SLEEPING ]]; then
    if [[ $(team_done_flag "$TEAM") == true ]]; then
      status=done; note="team already finished"
    else
      status=sleeping
    fi
  elif ((member_q || member_ns)); then
    # a team member asks the coordinator (or the whole team when there is no coordinator yet) and sleeps until answered
    local to head kind=member_questions; to=$(team_lead "$TEAM"); to=${to:-team:$TEAM}
    head="QUESTIONS from $AGENT (forwarded by the script; members ask the coordinator, not the human)"
    if ((member_ns)); then
      kind=member_no_status
      head="$AGENT ended its turn without STATUS (waiting for a decision — reply with an instruction)"
    fi
    notice "$kind" "$AGENT" "$to" "$head: $(sed '/^[[:space:]]*STATUS:/,$d' <<< "$FINAL" | head -c 3500)" "agent=$AGENT" "team=$TEAM"
    if [[ $(team_done_flag "$TEAM") == true ]]; then status=done; else status=sleeping; fi
    note="forwarded to ${to}"
  elif [[ $fst == QUESTIONS ]]; then
    if [[ ${KIND:-worker} == helper ]]; then
      status=done; note="the worker returned questions instead of a result"
    else
      status=failed; note="the agent reported questions but they could not be saved ($qfile)"
    fi
  elif [[ $fst == INVESTIGATING ]]; then
    status=failed; note="the agent reported INVESTIGATING but no investigation was accepted"
  elif ((RC != 0)) || [[ $fst == FAILED || -z ${FINAL//[[:space:]]/} ]]; then
    status=failed
    if ((RC != 0)); then
      note="CLI exit code: $RC"
      local eline; eline=$(last_error_line "$dir" "$nrun")
      [[ -z $eline ]] || note+=" — $eline"
    fi
  elif [[ $fst == DONE || $fst == ROUND_DONE ]]; then
    status=done
    if [[ $fst == ROUND_DONE ]]; then   # "STATUS: ROUND_DONE N/M": round N of M is finished
      local rn
      rn=$(sed 's/[*`]//g' <<< "$FINAL" | { grep -oE 'STATUS:[[:space:]]*ROUND_DONE[[:space:]]+[0-9]+/[0-9]+' || (($? == 1)); } \
             | head -1 | { grep -oE '[0-9]+/[0-9]+$' || (($? == 1)); })
      if [[ -n $rn ]] && ((${rn%/*} >= 1 && ${rn%/*} <= ${rn#*/})); then
        meta_set "$id" WORK_ROUND "${rn%/*}"; meta_set "$id" WORK_ROUNDS "${rn#*/}"
        note="round $rn"
      else
        status=failed; note="STATUS: ROUND_DONE needs the round as N/M (e.g. ROUND_DONE 2/5)"
      fi
    fi
  elif [[ ${KIND:-worker} == helper ]]; then
    status=done; note="the worker gave no STATUS — its text was returned as the result"
  elif [[ -n $fst && $(task_field "$id" STATUS_BOUNCED) != "$(( $(task_field "$id" RUN) - 1 ))" ]]; then
    status=sbounce   # an unknown STATUS goes back to the agent once, with the statuses it may use
  else
    status=failed; note="unrecognised STATUS: ${fst:-none}"
  fi
  # the wake-loop guard: a member that keeps waking up without doing anything is paused instead of put to sleep
  if wake_loop_applies "$status" && pause_secs=$(wake_loop_check "$id" "$run_start" "$run_head0" "$run_msgs0"); then
    status=paused; pause_reason=wake_loop
    note="woken again and again without anything to do (wake-loop guard) — paused until $(date -d "@$(( $(date +%s) + pause_secs ))" '+%H:%M')"
  fi
  # questions without recommendations go back to the agent once (the same questions file, the same round)
  if [[ $status == qbounce ]]; then
    meta_set "$id" QUESTIONS_BOUNCED "$next_round"
    meta_set "$id" QBOUNCE_PENDING "$norec"
    RUNNER_DONE=1
    act "$id" info "↩ questions without a recommendation ($norec) — sent back to the agent once"
    log_info questions_bounced "task=$id" "questions=$norec"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=questions without recommendations"
    dispatch; dispatch_helpers
    return 0
  fi
  # --autopilot: the questions go back to the agent once — it decides and lists its decisions in the PR; the file is
  # put aside, so that the next run's end does not take the same questions for new ones
  if [[ $status == abounce ]]; then
    local decided="${qfile%.md}-decided.md"
    mv "$qfile" "$decided"
    meta_set "$id" AUTOPILOT_QBOUNCED "$next_round"
    meta_set "$id" ABOUNCE_PENDING "$decided"
    RUNNER_DONE=1
    act "$id" info "↩ --autopilot: nobody answers questions — they go back to the agent once; it decides and lists its decisions in the PR"
    log_info questions_autopilot_bounced "task=$id" "file=$decided"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=--autopilot questions"
    dispatch; dispatch_helpers
    return 0
  fi
  # an unknown STATUS goes back to the agent once (a second one fails the run)
  if [[ $status == sbounce ]]; then
    meta_set "$id" STATUS_BOUNCED "$(task_field "$id" RUN)"
    meta_set "$id" SBOUNCE_PENDING "$fst"
    RUNNER_DONE=1
    act "$id" info "↩ unknown STATUS: $fst — sent back to the agent once"
    log_info status_bounced "task=$id" "status=$fst"
    start_runner "$id" resume || log_error resume_failed "task=$id" "reason=an unknown STATUS"
    dispatch; dispatch_helpers
    return 0
  fi
  # rounds: a finished round must fit the limit and leave none of its own pending tests behind (README "Rounds")
  if [[ $status == done && ${KIND:-worker} == worker ]] && { [[ -z ${TEAM:-} ]] || [[ $AGENT == "$(team_lead "$TEAM")" ]]; }; then
    local problems bounced=${ROUND_BOUNCED:-0}
    problems=$(round_check "$id")
    if [[ -n $problems ]]; then
      if ((bounced < ROUND_BOUNCES)); then
        meta_set "$id" ROUND_BOUNCED $((bounced + 1))
        meta_set "$id" RBOUNCE_PENDING "$problems"
        RUNNER_DONE=1
        act "$id" info "↩ the round cannot close yet: $(tr '\n' ' ' <<< "$problems")"
        log_info round_bounced "task=$id" "bounce=$((bounced + 1))"
        start_runner "$id" resume || log_error resume_failed "task=$id" "reason=round bounce"
        dispatch; dispatch_helpers
        return 0
      fi
      note="${note:+$note; }closed after $ROUND_BOUNCES corrections although: $(tr '\n' ' ' <<< "$problems")"
      act "$id" err "the round closed with problems: $(tr '\n' ' ' <<< "$problems")"
      log_warn round_closed_with_problems "task=$id"
    fi
  fi
  # --verify: the coordinator may not close a team with gaps — send it back once with the list of gaps
  if [[ $status == done && -n ${TEAM:-} && ${VERIFY:-} == 1 && ${VERIFY_BOUNCED:-} != 1 \
        && ${KIND:-worker} == worker && $AGENT == "$(team_lead "$TEAM")" ]]; then
    local gaps; gaps=$(verify_gaps "$id")
    if [[ -n $gaps ]]; then
      meta_set "$id" VERIFY_BOUNCED 1
      meta_set "$id" BOUNCE_PENDING "$gaps"
      RUNNER_DONE=1
      act "$id" info "↩ closing the team held back (--verify), gaps: $(tr '\n' ' ' <<< "$gaps")"
      start_runner "$id" resume || log_error resume_failed "task=$id" "reason=--verify bounce"
      dispatch; dispatch_helpers
      return 0
    fi
  fi

  # the wake-up time and its timer exist before anyone can see the task as paused
  [[ $status == paused ]] && pause_task "$id" "$pause_secs" "$pause_reason"
  # likewise the answering instructions, the watch and the editor before the task shows as waiting
  [[ $status == waiting ]] && questions_ready "$id" "$qfile"
  meta_set "$id" NOTE "$note"   # what the run ended on, for the dashboard and for a node's report to its lead
  meta_set "$id" STATUS "$status"
  meta_set "$id" FINISHED "$(date -Is)"
  RUNNER_DELIVERED=0
  RUNNER_DONE=1
  act "$id" info "■ end of run $n: $status${note:+ ($note)}"
  log_info run_finished "run=$n" "status=$status" "note=$note"

  if [[ ${KIND:-worker} == investigation ]]; then
    case $status in
      paused)
        notify "$id" paused "$FINAL" "$note" ;;
      waiting)
        bus inv-set --dir "$BUS_DIR" --id "$INV_ID" --status waiting_human
        notify "$id" waiting "$FINAL" "investigation #$INV_ID paused — its investigator waits for your answers" ;;
      hung)
        inv_finish "$id" failed "STATUS: FAILED
Answer: the investigator hung ($AGENT_HANG_STRIKES times without progress) — no result"
        notify "$id" hung "$FINAL" "$note" ;;
      *)
        inv_finish "$id" "$status" "$FINAL"      # no push notification (the result goes to the requesting agent)…
        if [[ ${REVIEW:-} == 1 ]]; then          # …except PR reviews (--verify): those go to the human
          notify "$id" "$status" "$FINAL" "review of PR #$PR_NUMBER: $PR_URL"
          if [[ $status == done ]]; then
            review_followup "$id" "$FINAL"
          elif [[ $status =~ ^(failed|hung|stopped)$ ]]; then
            review_without_verdict "$id" "the review run ended $status${note:+ ($note)}"
          fi
        fi ;;
    esac
  elif [[ ${KIND:-worker} == helper && $status != waiting && $status != investigating && $status != paused ]]; then
    helper_finish "$id" "$status" "$FINAL"
  elif [[ -n ${TEAM:-} ]]; then
    team_after_run "$id" "$status" "$FINAL" "$note"
  elif [[ $status == investigating ]]; then
    log_info waiting_for_investigation "investigation=$pending"
  else
    notify "$id" "$status" "$FINAL" "$note"
  fi
  RUNNER_DELIVERED=1
  dispatch
  dispatch_helpers
}

start_runner() { # id mode
  local id=$1 mode=$2 run
  run=$(( $(task_field "$id" RUN) + 1 ))
  meta_set "$id" RUN "$run"
  meta_set "$id" STATUS starting
  log_info runner_starting "task=$id" "run=$run" "mode=$mode" "unit=$(unit_name "$id" "$run")"
  systemd-run --user --quiet --collect \
    --unit="$(unit_name "$id" "$run")" \
    --working-directory="$(task_field "$id" WORKTREE)" \
    --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    "$SELF" _runner "$id" "$mode" 3>&- 7>&- 8>&- 9>&- 10>&- && return 0
  meta_set "$id" STATUS failed
  log_error runner_start_failed "task=$id" "run=$run"
  echo "agent: systemd-run could not start $id (is lingering enabled? sudo loginctl enable-linger $(id -un))" >&2
  return 1
}

# ------------------------------------------------------------------ commands

# lock_task_ids serializes ordinary start/resume admission, before checking agents or touching predecessors.
lock_task_ids() {
  local mask
  mask=$(umask)
  umask 077
  exec 10>"$AGENTS_HOME/task-ids.lock" || die "cannot open the task ID allocation lock"
  umask "$mask"
  flock -w 60 10 || die "cannot lock task ID allocation within 60 seconds; retry the run"
}

# unlock_task_ids releases admission before launching children, which must never retain this lock.
unlock_task_ids() {
  flock -u 10 || die "cannot release the task ID allocation lock"
  exec 10>&-
}

# allocate_run_ids team names-array roots-array repos-array claims the entire cohort; prints its timestamp.
# The caller holds task-ids.lock through team registration. Failed partial claims remove only our empty dirs.
allocate_run_ids() {
  local with_team=$1
  local -n allocation_names=$2 allocation_roots=$3 allocation_repos=$4
  local stamp epoch collision i target claimed_dir detail rc
  local claimed=()
  stamp=$(date +%Y%m%d-%H%M%S) || die "cannot read the task ID timestamp"
  # Advance the encoded label in UTC so a local daylight-saving change cannot repeat candidates.
  epoch=$(TZ=UTC date -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s) \
    || die "cannot parse the task ID timestamp: $stamp"
  while :; do
    stamp=$(TZ=UTC date -d "@$epoch" +%Y%m%d-%H%M%S) || die "cannot advance the task ID timestamp"
    collision=0
    if ((with_team)); then
      # A crash before team-create can leave a claimed cohort with no bus record.
      for target in "$TASKS/$stamp-"*; do
        if [[ -e $target || -L $target ]]; then collision=1; break; fi
      done
    fi
    for ((i = 0; i < ${#allocation_names[@]} && collision == 0; i++)); do
      for target in "$TASKS/$stamp-${allocation_names[i]}" \
          "$AGENTS_HOME/worktrees/${allocation_repos[i]}/$stamp-${allocation_names[i]}"; do
        if [[ -e $target || -L $target ]]; then collision=1; break; fi
      done
      ((collision == 0)) || break
      if git -C "${allocation_roots[i]}" show-ref --verify --quiet \
          "refs/heads/$BRANCH_PREFIX/${allocation_names[i]}/$stamp" 10>&-; then
        collision=1
      else
        rc=$?
        # show-ref returns 1 for an absent branch; any other failure prevents safe allocation.
        ((rc == 1)) || die "cannot check branch availability for ${allocation_names[i]} ($rc)"
      fi
    done
    if ((with_team && collision == 0)); then
      if detail=$(bus team-get --dir "$BUS_DIR" --team "$stamp-team" 2>&1); then
        collision=1
      else
        rc=$?
        # Archived tasks may be absent while their team remains: only NotFound means available.
        if ((rc != BUS_NOT_FOUND)); then
          # Preserve ordinary run's abandonment event and diagnostic when bus storage is invalid.
          # No cohort directories have been claimed yet, so cleanup has no new tasks to remove.
          abandon_run "could not create the team on the bus (cannot check team ID availability: $detail)"
        fi
      fi
    fi
    if ((collision == 0)); then
      claimed=()
      for target in "${allocation_names[@]}"; do
        target="$TASKS/$stamp-$target"
        if detail=$(mkdir -- "$target" 2>&1); then
          claimed+=("$target")
        else
          for claimed_dir in "${claimed[@]}"; do
            rmdir -- "$claimed_dir" || die "cannot release an empty task ID claim: $claimed_dir"
          done
          # Another filesystem writer can race our preflight; exclusive mkdir decides ownership.
          if [[ -e $target || -L $target ]]; then collision=1; break; fi
          die "cannot claim task ID directory $target: $detail"
        fi
      done
      if ((collision == 0)); then
        printf '%s\n' "$stamp" || die "cannot return the allocated task timestamp"
        return 0
      fi
    fi
    epoch=$((epoch + 1))
  done
}

create_task() { # name text root main_root base ts [team [start]] — uses a claimed task directory; sets NEW_ID; start defaults to HEAD; returns 1 with nothing left behind when a step fails
  local name=$1 task=$2 root=$3 main_root=$4 base=$5 ts=$6 team=${7:-} start=${8:-HEAD}
  local id repo_name branch wt dir err
  id="$ts-$name"
  repo_name=$(basename "$main_root")
  branch="$BRANCH_PREFIX/$name/$ts"
  wt="$AGENTS_HOME/worktrees/$repo_name/$id"
  dir="$TASKS/$id"
  NEW_ID=""
  CREATE_TASK_ERROR=""
  if ! err=$(mkdir -p "$(dirname "$wt")" 2>&1); then
    rm -rf "${dir:?}"
    log_error task_create_failed "task=$id" "step=worktree_directory"
    CREATE_TASK_ERROR="${err:-cannot create worktree parent directory}"
    return 1
  fi
  if ! err=$(git -C "$root" worktree add --quiet -b "$branch" "$wt" "$start" 10>&- 2>&1); then
    drop_unstarted_task "$root" "$wt" "$branch" "$dir"
    log_error task_create_failed "task=$id" "step=worktree"
    CREATE_TASK_ERROR="${err:-git worktree add failed}"
    return 1
  fi
  # From here on the worktree exists: any failure removes it again, so no task is left half-made.
  if ! printf '%s\n' "$task" > "$dir/task.md"; then
    drop_unstarted_task "$root" "$wt" "$branch" "$dir"
    log_error task_create_failed "task=$id" "step=task_text"
    CREATE_TASK_ERROR="cannot write task.md"
    return 1
  fi
  local agents_md=missing
  [[ -f $wt/AGENTS.md ]] && agents_md=present
  if ! : > "$dir/meta.env"; then
    drop_unstarted_task "$root" "$wt" "$branch" "$dir"
    log_error task_create_failed "task=$id" "step=meta_file"
    CREATE_TASK_ERROR="cannot create meta.env"
    return 1
  fi
  local sid=""
  [[ ${AGENT_TYPE[$name]} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
  local kv
  for kv in "ID=$id" "AGENT=$name" "KIND=worker" "TEAM=$team" "TIER=$(agent_tier "$name")" "TYPE=${AGENT_TYPE[$name]}" "MODEL=${AGENT_MODEL[$name]:-}" \
            "EXTRA_ARGS=${AGENT_EXTRA_ARGS[$name]:-}" \
            "REPO_NAME=$repo_name" "REPO_ROOT=$main_root" "WORKTREE=$wt" "BRANCH=$branch" \
            "BASE=$base" "SESSION_ID=$sid" "ROUND=0" "RUN=0" "STATUS=new" "CREATED=$(date -Is)" \
            "AGENTS_MD=$agents_md"; do
    if ! meta_set "$id" "${kv%%=*}" "${kv#*=}"; then
      drop_unstarted_task "$root" "$wt" "$branch" "$dir"
      log_error task_create_failed "task=$id" "step=meta"
      CREATE_TASK_ERROR="cannot set meta $kv"
      return 1
    fi
  done
  log_info task_created "task=$id" "agent=$name" "repo=$repo_name" "branch=$branch" "team=$team" "agents_md=$agents_md"
  NEW_ID=$id
}

# drop_unstarted_task root wt branch dir — undoes a create_task that failed: the worktree, its branch and the task
# directory. Nothing ran in it, so nothing is archived. Each removal reports its own failure (the task is not started).
drop_unstarted_task() {
  local root=$1 wt=$2 branch=$3 dir=$4
  if [[ -e $wt ]] && ! git -C "$root" worktree remove --force "$wt" 10>&-; then
    log_error task_cleanup_failed "step=worktree" "path=$wt"
  fi
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && ! git -C "$root" branch -D "$branch" >/dev/null 10>&-; then
    log_error task_cleanup_failed "step=branch" "branch=$branch"
  fi
  rm -rf "${dir:?}"
}

# job_refusal agent → why a node job cannot start on this agent now, with the admission checks of agent run
# (configured, not an investigator, not busy); prints nothing when the agent is free. Call it under the task lock.
job_refusal() {
  local name=$1 busy
  if is_investigator "$name"; then
    printf 'agent %s is an investigator' "$name"; return 0
  fi
  if [[ -z ${AGENT_TYPE[$name]:-} ]]; then
    printf 'unknown agent %s' "$name"; return 0
  fi
  if busy=$(agent_running_task "$name"); then
    printf 'agent %s is busy (task %s)' "$name" "$busy"
  fi
  return 0
}

# prepare_job_task job agent repo base sha task — prepares a node job's task: the agent must be free (job_refusal),
# agentbus node-checkout resolves the repository (NODE_REPOS allow-list) and the commit, then create_task starts the
# worktree there, as agent run does. Sets NEW_ID. On failure nothing is created, the reason is logged, returns 1.
# The admission check runs twice: before the checkout and again under the task-ID lock before the task is created,
# because the checkout fetches over the network and an agent can take a task meanwhile. The fetch runs without the
# lock: node-checkout fetches into a private ref, so concurrent checkouts do not interfere.
prepare_job_task() {
  local job=$1 name=$2 repo=$3 base=$4 sha=$5 task=$6
  NODE_PREPARE_ERROR=""
  local -a args=() names roots repos
  local k out root commit ts reason
  for k in "${!NODE_REPOS[@]}"; do args+=(--repo-path "$k=${NODE_REPOS[$k]}"); done
  args+=(--repo "$repo" --base "$base")
  [[ -z $sha ]] || args+=(--sha "$sha")
  lock_task_ids
  reason=$(job_refusal "$name")
  unlock_task_ids
  if [[ -n $reason ]]; then
    NODE_PREPARE_ERROR=$reason
    log_error node_checkout_failed "job=$job" "agent=$name" "reason=$reason"
    return 1
  fi
  if ! out=$(bus node-checkout "${args[@]}" 2>&1); then
    NODE_PREPARE_ERROR=$out
    log_error node_checkout_failed "job=$job" "repo=$repo" "base=$base" "reason=$out"
    return 1
  fi
  root=$(jq -er '.root' <<< "$out") && commit=$(jq -er '.commit' <<< "$out") \
    || die "node-checkout returned an unreadable result for job $job: $out"
  lock_task_ids
  reason=$(job_refusal "$name")
  if [[ -n $reason ]]; then
    NODE_PREPARE_ERROR=$reason
    unlock_task_ids
    log_error node_checkout_failed "job=$job" "agent=$name" "reason=$reason"
    return 1
  fi
  names=("$name"); roots=("$root"); repos=("$(basename "$root")")
  ts=$(allocate_run_ids 0 names roots repos)
  if ! create_task "$name" "$task" "$root" "$root" "$base" "$ts" "" "$commit"; then
    NODE_PREPARE_ERROR=${CREATE_TASK_ERROR:-task worktree could not be created}
    unlock_task_ids
    log_error node_checkout_failed "job=$job" "repo=$repo" "base=$base" "reason=${CREATE_TASK_ERROR:-task worktree could not be created}"
    return 1
  fi
  if ! {
    meta_set "$NEW_ID" JOB_ID "$job" &&
    { [[ -z ${7:-} ]] || meta_set "$NEW_ID" JOB_ASSIGNMENT "$7"; } &&
    { [[ -z ${LEAD_URL:-} ]] || meta_set "$NEW_ID" JOB_LEAD "$LEAD_URL"; } &&
    { [[ -z ${8:-} ]] || { meta_set "$NEW_ID" TEAM "$8" && meta_set "$NEW_ID" MEMBER "$9" && meta_set "$NEW_ID" REMOTE_TEAM 1 && meta_set "$NEW_ID" TIER "$(agent_tier "$name")"; }; }
  }; then
    NODE_PREPARE_ERROR="cannot record node job identity metadata"
    drop_unstarted_task "$root" "$AGENTS_HOME/worktrees/$(basename "$root")/$NEW_ID" "$BRANCH_PREFIX/$name/$ts" "$TASKS/$NEW_ID"
    unlock_task_ids
    log_error node_checkout_failed "job=$job" "reason=$NODE_PREPARE_ERROR"
    return 1
  fi
  unlock_task_ids
}

# discard_task id — removes a task that never ran: its worktree, its branch and its task directory. Nothing of
# value exists yet (no run, no commits), so nothing is archived.
discard_task() {
  local id=$1 root wt branch
  root=$(task_field "$id" REPO_ROOT)
  wt=$(task_field "$id" WORKTREE)
  branch=$(task_field "$id" BRANCH)
  if [[ -d $wt ]]; then
    try discard_worktree_failed git -C "$root" worktree remove --force "$wt"
  fi
  # show-ref exits 1 when the branch does not exist — then there is nothing to delete
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    try discard_branch_failed git -C "$root" branch -D "$branch" >/dev/null
  fi
  rm -rf "${TASKS:?}/$id"
  log_info task_discarded "task=$id" "branch=$branch"
}

# abandon_run message id... — a run could not start after its tasks were created: removes them and exits
abandon_run() {
  local msg=$1 id
  shift
  for id in "$@"; do
    discard_task "$id"
  done
  log_error run_abandoned "message=$msg" "tasks=$*"
  die "$msg — the tasks it had created were removed"
}

resume_history() { # task → the human's answers from this task and its predecessors (the --resume chain)
  local t=$1 f
  while [[ -n $t && -d $TASKS/$t ]]; do
    for f in "$TASKS/$t"/questions-*.md; do
      [[ -f $f ]] || continue
      printf '\n### %s (%s)\n\n' "${f##*/}" "$t"; cat "$f"
    done
    t=$(task_field "$t" RESUMED_FROM)
  done
}

resume_run() {
  local carry # ref verify same_round [addition...] — resumes an interrupted team or task from its last checkpoint
  local ref=$1 verify=$2 same_round=$3; shift 3
  local add=""
  if [[ ${1:-} == -f ]]; then [[ -r ${2:-} ]] || die "file not found: ${2:-}"; add=$(<"$2")
  elif (($#)); then add="$*"
  elif [[ ! -t 0 ]]; then add=$(cat); fi

  lock_task_ids

  # find the interrupted team (by team ID or a member's task ID) or a single task
  local d first="" old_team=""
  for d in "$TASKS"/*/; do
    d=${d%/}; d=${d##*/}
    [[ -f $TASKS/$d/meta.env ]] || continue
    [[ $(task_field "$d" KIND) == worker ]] || continue
    if [[ $(task_field "$d" TEAM) == *"$ref"* || $d == *"$ref"* ]]; then first=$d; old_team=$(task_field "$d" TEAM); fi
  done
  [[ -n $first ]] || die "no team or task matches: $ref"

  local olds=() t
  if [[ -n $old_team ]]; then
    local tj; tj=$(bus team-get --dir "$BUS_DIR" --team "$old_team") || die "team $old_team not found on the bus"
    while read -r t; do olds+=("$t"); done < <(jq -r '.members[] | select(.state != "excluded") | .task' <<< "$tj")
  else
    olds=("$first")
  fi
  local remote_olds=() local_olds=()
  for t in "${olds[@]}"; do   # remote members come back on their nodes, through the lead — not as local tasks
    if [[ $(task_field "$t" KIND) == remote-member ]]; then remote_olds+=("$t"); else local_olds+=("$t"); fi
  done
  olds=("${local_olds[@]}")
  for t in "${olds[@]}"; do
    case $(task_field "$t" STATUS) in
      new|starting|running|waiting|investigating|sleeping|paused)
        die "task $t is still active ($(task_field "$t" STATUS)) — first: agent stop --running" ;;
    esac
    agent_running_task "$(task_field "$t" AGENT)" >/dev/null && die "agent $(task_field "$t" AGENT) is busy with another task"
  done

  # rounds: after STATUS: ROUND_DONE the next round starts only once its PR is merged, on fresh branches from the
  # updated base; --same-round continues the same round on the same branches (e.g. for review fixes)
  local rtask="" wr="" wrs="" fresh=0 round_title="" round_head=""
  for t in "${olds[@]}"; do
    if [[ -n $(task_field "$t" WORK_ROUND) ]]; then rtask=$t; fi
  done
  if [[ -n $rtask ]]; then
    wr=$(task_field "$rtask" WORK_ROUND); wrs=$(task_field "$rtask" WORK_ROUNDS)
    if ((same_round)); then
      round_title="Round $wr of $wrs continues"
      round_head="Round $wr of $wrs continues: its PR is not merged — keep working on the same branches (e.g. on the review findings), then end with STATUS: ROUND_DONE $wr/$wrs again."
    else
      ((wr < wrs)) || die "all $wrs rounds are done (round $wr/$wrs was the last) — start a new task for more work"
      local pr state="" url="" t2 b heads=()
      for t2 in "${olds[@]}"; do   # the round's PR was opened from the branch of whoever ended the round
        b=$(task_field "$t2" BRANCH)
        [[ -n $b ]] || continue
        heads+=("$b")
        pr=$(trusted_prs "$(task_field "$t2" REPO_ROOT)" "$b" all number,url,state) \
          || die "cannot check the PR of round $wr/$wrs (gh pr list failed) — merge it and retry, or continue the round: agent run --resume $ref --same-round"
        [[ -n $(jq -r '.[0].url // empty' <<< "$pr") ]] || continue
        state=$(jq -r '.[0].state // empty' <<< "$pr"); url=$(jq -r '.[0].url // empty' <<< "$pr")
        [[ $state != MERGED ]] || break   # a merged PR of the round: the next one may start
      done
      [[ -n $url ]] || die "round $wr/$wrs has no PR (branches ${heads[*]}) — open and merge it, or continue the round: agent run --resume $ref --same-round"
      [[ $state == MERGED ]] || die "the PR of round $wr/$wrs ($url) is not merged yet ($state). Merge it and run this again — or keep working on round $wr (e.g. review fixes): agent run --resume $ref --same-round"
      fresh=1
    fi
  elif ((same_round)); then   # no round was ended: resuming keeps the branches anyway
    echo "--same-round: no round was ended — continuing on the same branches"
  fi

  local ts new_team="" ids=() id old root wt name branch prev start base sha
  local names=() roots=() repos=() with_team=0
  for old in "${olds[@]}"; do
    names+=("$(task_field "$old" AGENT)")
    roots+=("$(task_field "$old" REPO_ROOT)")
    repos+=("$(task_field "$old" REPO_NAME)")
  done
  [[ -n $old_team ]] && with_team=1
  ts=$(allocate_run_ids "$with_team" names roots repos)
  [[ -n $old_team ]] && new_team="$ts-team"
  local remote_ids=() r rtext
  for r in "${remote_olds[@]}"; do   # the old members' jobs end first: their agents must be free to come back
    "$SELF" jobs --cancel "$(task_field "$r" JOB_ID)" >/dev/null 2>&1 \
      || log_info remote_member_cancel_skipped "task=$r"   # a job that already ended cannot be cancelled
    bus lead-member --dir "$BUS_DIR" --remove --member "$(task_field "$r" AGENT)" >/dev/null 2>&1 \
      || log_info remote_member_revoke_skipped "task=$r"   # revoked already when its team finished
    remote_agent_wait_free "$(task_field "$r" AGENT)" 60 \
      || die "remote member $(task_field "$r" AGENT): its agent is still busy on its node — retry in a minute"
  done
  RESUME_NEW_IDS=(); RESUME_NEW_WT=()   # what this resume makes; removed again if it fails (resume_abandon)
  trap 'resume_abandon "$?" "$BASH_COMMAND"' EXIT   # the status and the command that ended it, for the log
  for r in "${remote_olds[@]}"; do   # node online, agent free, base on origin — before any local task exists
    rtext=$(cat "$TASKS/$r/task.md"
      if [[ -n ${add//[[:space:]]/} ]]; then
        printf '\n\n## Addition from the human (resumed %s)\n\n%s\n' "$(date '+%Y-%m-%d %H:%M')" "$add"
      fi)
    remote_ids+=("$(remote_member_task "$(task_field "$r" AGENT)" "$rtext" "$new_team" "$(task_field "$r" BASE)" \
      "$(task_field "$r" REPO_ROOT)" "$ts" resume)")
  done
  RESUME_NEW_IDS+=("${remote_ids[@]}")
  for old in "${olds[@]}"; do
    name=$(task_field "$old" AGENT); root=$(task_field "$old" REPO_ROOT)
    id="$ts-$name"; wt="$AGENTS_HOME/worktrees/$(task_field "$old" REPO_NAME)/$id"
    RESUME_NEW_IDS+=("$id"); RESUME_NEW_WT[$id]=$wt
    mkdir -p "$(dirname "$wt")"
    # the same branch (with its commits and draft PR) — the old worktree releases it
    carry=""
    if [[ -d $(task_field "$old" WORKTREE) ]]; then
      # uncommitted changes are never thrown away: they go to the stash and on into the new worktree
      if [[ -n $(git -C "$(task_field "$old" WORKTREE)" status --porcelain 10>&-) ]]; then
        git -C "$(task_field "$old" WORKTREE)" stash push --include-untracked --quiet -m "agent resume of $old: uncommitted work" 10>&- \
          || die "the worktree of $old has uncommitted changes that could not be stashed — commit them first"
        carry=$(git -C "$root" rev-parse --verify --quiet refs/stash 10>&-)
      fi
      try worktree_remove_failed git -C "$root" worktree remove --force "$(task_field "$old" WORKTREE)" 10>&-
    fi
    git -C "$root" worktree prune 10>&-
    prev=$(task_field "$old" BRANCH); branch=$prev
    if ((fresh)); then   # the next round: a new branch from the base, which now contains the merged round
      base=$(task_field "$old" BASE); start=$base
      if git -C "$root" remote get-url origin >/dev/null 2>&1; then   # a query: no origin = no remote to update from
        try round_fetch_failed git -C "$root" fetch --quiet origin "$base" 10>&-
        if git -C "$root" rev-parse --verify --quiet "origin/$base" >/dev/null; then start="origin/$base"; fi
      fi
      branch="$BRANCH_PREFIX/$name/$ts"
      git -C "$root" worktree add --quiet -b "$branch" "$wt" "$start" 10>&- || die "could not create branch $branch from $start"
      sha=$(git -C "$root" rev-parse --short "$start")
      round_title="Round $((wr + 1)) of $wrs"
      round_head="Round $((wr + 1)) of $wrs. Round $wr is merged into $base: your branch $branch starts from there ($sha). Your previous branch $prev is kept — take from it only what the round plan puts into this round."
    else
      git -C "$root" worktree add --quiet "$wt" "$branch" 10>&- || die "could not recreate the worktree of branch $branch"
    fi
    if [[ -n $carry ]] && ((fresh)); then   # a new round starts clean: the old round's leftovers stay in the stash
      echo "  $name: the uncommitted changes of $old stay in the stash ($carry) — the new round starts clean"
    elif [[ -n $carry ]]; then
      if git -C "$wt" stash apply --quiet "$carry" 10>&-; then
        git -C "$root" stash drop --quiet "$(git -C "$root" stash list --format='%gd %H' | awk -v h="$carry" '$2 == h {print $1; exit}')" 10>&- \
          || log_warn stash_drop_failed "stash=$carry"
        echo "  $name: the uncommitted changes of $old are carried into the new worktree"
      else
        log_error stash_apply_failed "task=$old" "stash=$carry"
        echo "  WARNING $name: the uncommitted changes of $old could not be applied — they stay in the stash: git stash apply $carry"
      fi
    fi
    { cat "$TASKS/$old/task.md"
      if [[ -n $round_head ]]; then
        printf '\n\n## %s (resumed %s)\n\n%s\n' "$round_title" "$(date '+%Y-%m-%d %H:%M')" "$round_head"
      fi
      if [[ -n ${add//[[:space:]]/} ]]; then
        printf '\n\n## Addition from the human (resumed %s)\n\n%s\n' "$(date '+%Y-%m-%d %H:%M')" "$add"
      fi; } > "$TASKS/$id/task.md"
    for t in "${olds[@]}"; do resume_history "$t"; done > "$TASKS/$id/history.md"   # every member sees all answers
    : > "$TASKS/$id/meta.env"
    local sid="" kv
    [[ ${AGENT_TYPE[$name]:-} == claude ]] && sid=$(cat /proc/sys/kernel/random/uuid)
    for kv in "ID=$id" "AGENT=$name" "KIND=worker" "TEAM=$new_team" "TIER=$(agent_tier "$name")" \
              "TYPE=${AGENT_TYPE[$name]}" "MODEL=${AGENT_MODEL[$name]:-}" "EXTRA_ARGS=${AGENT_EXTRA_ARGS[$name]:-}" \
              "REPO_NAME=$(task_field "$old" REPO_NAME)" "REPO_ROOT=$root" "WORKTREE=$wt" \
              "BRANCH=$branch" "PREV_BRANCH=$( ((fresh)) && echo "$prev")" "BASE=$(task_field "$old" BASE)" "SESSION_ID=$sid" \
              "ROUND=0" "RUN=0" "STATUS=new" "CREATED=$(date -Is)" "RESUMED_FROM=$old" "FIX_PASS=${AGENT_FIX_PASS:-0}" \
              "VERIFY=$( ((verify)) && echo 1 || task_field "$old" VERIFY)" \
              "AUTOPILOT=$( ((${autopilot:-0})) && echo 1 || task_field "$old" AUTOPILOT)" "PRECHECK_PASS=${AGENT_PRECHECK_PASS:-0}" \
              "AUTOPILOT_OFF=$( ((${autopilot:-0})) || task_field "$old" AUTOPILOT_OFF)" \
              "FORMAT_BOUNCED=${AGENT_FORMAT_BOUNCED:-$( ((fresh)) || task_field "$old" FORMAT_BOUNCED)}" \
              "ROUND_PR=$( ((fresh)) || round_pr_of_team "$old_team")"; do
      meta_set "$id" "${kv%%=*}" "${kv#*=}"
    done
    ids+=("$id")
  done

  mkdir -p "$BUS_DIR/checkpoints"
  if [[ -n $old_team ]]; then
    local json='{}' lead
    lead=$(jq -r '.lead // empty' <<< "$tj")
    [[ $(jq -r --arg l "$lead" '.members[$l].state // empty' <<< "$tj") == hung ]] && lead=""
    for id in "${ids[@]}"; do
      name=$(task_field "$id" AGENT)
      json=$(jq --arg a "$name" --arg t "$id" --arg b "$(task_field "$id" BRANCH)" --arg w "$(task_field "$id" WORKTREE)" \
               --arg tier "$(agent_tier "$name")" --arg prov "$(agent_provider "$name")" \
               '.[$a] = {agent:$a, task:$t, branch:$b, worktree:$w, state:"active", tier:$tier, provider:$prov}' <<< "$json")
    done
    for r in "${remote_ids[@]}"; do
      json=$(jq --arg a "$(task_field "$r" AGENT)" --arg t "$r" --arg w "remote:$(task_field "$r" REMOTE_NODE)" \
               --arg tier "$(task_field "$r" TIER)" \
               '.[$a] = {agent:$a, task:$t, branch:"", worktree:$w, state:"active", tier:$tier, provider:"remote"}' <<< "$json")
    done
    jq -n --arg id "$new_team" --arg repo "$(task_field "${ids[0]}" REPO_NAME)" --arg wake "$SELF" --arg home "$AGENTS_HOME" \
      --argjson members "$json" --arg lead "$lead" --arg from "$old_team" --argjson old "$tj" '
      {id:$id, repo:$repo, wake_cmd:$wake, home:$home, members:$members, lead:$lead, resumed_from:$from,
       next_board_id: ($old.next_board_id // 0),
       board: (($old.board // {}) | map_values(if .status == "claimed" then .status = "todo" | .assignee = "" else . end))}' \
      | bus team-create --dir "$BUS_DIR" || die "could not create the resumed team"
    try team_close_failed bus team-done --dir "$BUS_DIR" --team "$old_team"
    for r in "${remote_ids[@]}"; do
      remote_member_start "$r" || die "could not start remote member $(task_field "$r" AGENT) (see ~/agents/logs/agent.jsonl)"
    done
    if [[ -f $BUS_DIR/checkpoints/team-$old_team.md ]]; then
      try checkpoint_copy_failed cp "$BUS_DIR/checkpoints/team-$old_team.md" "$BUS_DIR/checkpoints/team-$new_team.md"
    fi
  else
    if [[ -f $BUS_DIR/checkpoints/task-$first.md ]]; then
      try checkpoint_copy_failed cp "$BUS_DIR/checkpoints/task-$first.md" "$BUS_DIR/checkpoints/task-${ids[0]}.md"
    fi
  fi

  trap - EXIT; RESUME_NEW_IDS=()   # made: from here on the tasks run (a runner that fails to start is its own failure)
  unlock_task_ids
  for id in "${ids[@]}"; do start_runner "$id" new || exit 1; done
  log_info resumed "from=${old_team:-$first}" "new_team=$new_team" "tasks=${ids[*]}"
  echo "Resumed ${old_team:-$first} from the last checkpoint:"
  for id in "${ids[@]}"; do echo "  $id  →  $(task_field "$id" BRANCH)"; done
  [[ -n $new_team ]] && echo "  new team: $new_team${lead:+, coordinator: $lead}"
  [[ -n ${add//[[:space:]]/} ]] && echo "  addition appended to the task"
  return 0
}

cmd_run() {
  local members=() verify=0 autopilot=0 same_round=0 team_list="" resume_ref="" need_caps=() target_node=""
  while [[ ${1:-} == --need || ${1:-} == --on || ${1:-} == --team || ${1:-} == --verify || ${1:-} == --autopilot || ${1:-} == --resume || ${1:-} == --same-round || ${1:-} == --last-team ]]; do
    case $1 in
      --need)
        [[ -n ${2:-} && ${2:-} != --* ]] || die "usage: agent run --need cap1,cap2 <agent|normal|worker> \"task\""
        IFS=, read -ra need_caps <<< "$2"; shift 2 ;;
      --on)
        [[ -n ${2:-} && ${2:-} != --* ]] || die "usage: agent run --on instance <agent> \"task\""
        target_node=$2; shift 2 ;;
      --last-team)
        resume_ref=$(last_team_id)
        [[ -n $resume_ref ]] || die "--last-team: no team of this repository (outside a repository: no team at all)"
        shift ;;
      --verify) verify=1; shift ;;
      --autopilot) verify=1; autopilot=1; shift ;;   # --verify, then the merge and the next round by themselves
      --same-round) same_round=1; shift ;;
      --resume)
        [[ -n ${2:-} ]] || die "usage: agent run --resume <team|task> [\"addition\" | -f file.md]"
        resume_ref=$2; shift 2 ;;
      --team)
        [[ -n ${2:-} && ${2:-} != --* ]] || die "usage: agent run --team agent1,agent2[,...] [--verify] [-f file.md | \"task text\"]"
        team_list=$2; shift 2 ;;
    esac
  done
  if ((${#need_caps[@]} > 0)) || [[ -n $target_node ]]; then
    [[ -z $team_list ]] || die "--need/--on cannot be combined with --team"
    ((verify == 0)) || die "--need/--on cannot be combined with --verify"
    [[ -z $resume_ref ]] || die "--need/--on cannot be combined with --resume"
    local selector=${1:-}
    [[ -n $selector ]] || die "usage: agent run --need <caps> | --on <node> <agent|normal|worker> \"task\""
    shift
    local task
    if [[ ${1:-} == -f ]]; then
      [[ -r ${2:-} ]] || die "file not found: ${2:-}"
      task=$(<"$2")
    elif (($#)); then
      task="$*"
    elif [[ ! -t 0 ]]; then
      task=$(cat)
    else
      die "give the task text (argument, -f file or stdin)"
    fi
    [[ -n ${task//[[:space:]]/} ]] || die "empty task"
    submit_remote_job "$selector" "$target_node" "$task" "${need_caps[@]}"
    return
  fi
  ((same_round == 0)) || [[ -n $resume_ref ]] || die "--same-round only works with --resume"
  if [[ -n $resume_ref ]]; then
    [[ -z $team_list ]] || die "--resume takes the members from the interrupted task — do not combine it with --team"
    resume_run "$resume_ref" "$verify" "$same_round" "$@"
    return
  fi
  if ((verify)) && [[ -z $team_list ]]; then
    die "--verify only works with --team (PR review of the team's work by an investigator)"
  fi
  if [[ -n $team_list ]]; then
    IFS=, read -ra members <<< "$team_list"
    ((${#members[@]} >= 2)) || die "a team needs at least two agents"
  else
    local name=${1:-}
    [[ -n $name ]] || die "usage: agent run <agent> | --team a,b [-f file.md | \"task text\"]"
    shift
    members=("$name")
  fi
  local m seen=" " locals=() remotes=()
  for m in "${members[@]}"; do
    if [[ $m == *@* ]]; then   # a remote member, <agent>@<node>: it works on its node, in this lead's team
      [[ $seen != *" $m "* ]] || die "agent $m is listed twice"
      seen+="$m "; remotes+=("$m")
      continue
    fi
    locals+=("$m")
    ! is_investigator "$m" || die "investigators are not started directly — agents request them (request_investigation)"
    [[ -n ${AGENT_TYPE[$m]:-} ]] || die "unknown agent '$m'. Configured: ${!AGENT_TYPE[*]}"
    [[ $seen != *" $m "* ]] || die "agent $m is listed twice"
    seen+="$m "
  done
  if ((${#remotes[@]})); then
    ((${#members[@]} > 1)) || die "a remote member works in a team: agent run --team <local agents>,<agent>@<node> …"
    members=("${locals[@]}")
  fi

  local task
  if [[ ${1:-} == -f ]]; then
    [[ -r ${2:-} ]] || die "file not found: ${2:-}"
    task=$(<"$2")
  elif (($#)); then
    task="$*"
  elif [[ ! -t 0 ]]; then
    task=$(cat)
  else
    die "give the task text (argument, -f file or stdin)"
  fi
  [[ -n ${task//[[:space:]]/} ]] || die "empty task"

  local root common main_root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run this inside a git repository"
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
  main_root=$(dirname "$common")

  if ((${#members[@]} > 1)); then
    local has_normal=0
    for m in "${members[@]}"; do [[ $(agent_tier "$m") == normal ]] && has_normal=1; done
    ((has_normal)) || die "a team needs at least one local agent outside WORKER_AGENTS (workers cannot coordinate; remote members neither)"
  fi
  lock_task_ids
  local busy
  for m in "${members[@]}"; do
    if busy=$(agent_running_task "$m"); then
      die "agent $m is busy (task $busy). Wait, or add another agent in $CONF."
    fi
  done

  local ts base team="" ids=() roots=() repos=() with_team=0
  for m in "${members[@]}"; do roots+=("$root"); repos+=("$(basename "$main_root")"); done
  ((${#members[@]} + ${#remotes[@]} > 1)) && with_team=1
  ts=$(allocate_run_ids "$with_team" members roots repos)
  base=$(git -C "$root" symbolic-ref --quiet --short HEAD || git -C "$root" rev-parse --short HEAD)
  ((${#members[@]} + ${#remotes[@]} > 1)) && team="$ts-team"
  for m in "${members[@]}"; do
    if ! create_task "$m" "$task" "$root" "$main_root" "$base" "$ts" "$team"; then
      abandon_run "could not create task for $m: ${CREATE_TASK_ERROR:-worktree creation failed}" "${ids[@]}"
    fi
    ids+=("$NEW_ID")
  done

  if [[ -n $team ]]; then
    local json='{}' i
    for i in "${ids[@]}"; do
      json=$(jq --arg a "$(task_field "$i" AGENT)" --arg t "$i" --arg b "$(task_field "$i" BRANCH)" \
               --arg w "$(task_field "$i" WORKTREE)" \
               --arg tier "$(agent_tier "$(task_field "$i" AGENT)")" --arg prov "$(agent_provider "$(task_field "$i" AGENT)")" \
               '.[$a] = {agent:$a, task:$t, branch:$b, worktree:$w, state:"active", tier:$tier, provider:$prov}' <<< "$json")
    done
    local r rid remote_ids=()
    for r in "${remotes[@]}"; do   # a remote member: its proxy task here, a member like any other in the team
      rid=$(remote_member_task "$r" "$task" "$team" "$base" "$main_root" "$ts") || abandon_run "could not prepare remote member $r" "${ids[@]}"
      remote_ids+=("$rid")
      json=$(jq --arg a "$r" --arg t "$rid" --arg w "remote:${r#*@}" --arg tier "$(task_field "$rid" TIER)" \
               '.[$a] = {agent:$a, task:$t, branch:"", worktree:$w, state:"active", tier:$tier, provider:"remote"}' <<< "$json")
    done
    jq -n --arg id "$team" --arg repo "$(basename "$main_root")" --arg wake "$SELF" --arg home "$AGENTS_HOME" \
      --argjson members "$json" '{id:$id, repo:$repo, wake_cmd:$wake, home:$home, members:$members}' \
      | bus team-create --dir "$BUS_DIR" ||
      abandon_run "could not create the team on the bus (see ~/agents/logs/agentbus.jsonl)" "${ids[@]}"
    for rid in "${remote_ids[@]}"; do
      remote_member_start "$rid" || abandon_run "could not start remote member $(task_field "$rid" AGENT)" "${ids[@]}"
    done
  fi

  if [[ -n $(git -C "$root" status --porcelain 10>&-) ]]; then
    echo "Note: uncommitted changes in $root were NOT copied to the agents' worktrees (they start from HEAD)."
  fi
  if ((verify)); then
    for i in "${ids[@]}"; do meta_set "$i" VERIFY 1; done
    if ((autopilot)); then for i in "${ids[@]}"; do meta_set "$i" AUTOPILOT 1; done; fi
  fi
  unlock_task_ids
  for i in "${ids[@]}"; do
    start_runner "$i" new || exit 1
  done
  if [[ -n $team ]]; then
    echo "Started team $team: ${members[*]} (from $base)"
    for i in "${ids[@]}"; do echo "  $i  →  $(task_field "$i" BRANCH)"; done
    echo "  watch: agent live   |   team: agent team $team"
    if ((verify)); then echo "  --verify: once the PR is ready an investigator reviews it on GitHub"; fi
  else
    echo "Started: ${ids[0]}"
    echo "  agent:    ${members[0]} (${AGENT_TYPE[${members[0]}]})"
    echo "  branch:   $(task_field "${ids[0]}" BRANCH) (from $base)"
    echo "  worktree: $(task_field "${ids[0]}" WORKTREE)"
    echo "  watch:    agent log ${ids[0]}"
  fi
  if [[ $(task_field "${ids[0]}" AGENTS_MD) == missing ]]; then
    echo "WARNING: $(task_field "${ids[0]}" REPO_NAME) has no AGENTS.md (at $base) — the agents do not know its"
    echo "  conventions, build, lint and test commands (see README, \"Repository instructions\")."
    log_warn agents_md_missing "repo=$(task_field "${ids[0]}" REPO_NAME)" "base=$base"
  fi
}

cmd_answer() {
  local id; id=$(resolve_id "${1:?usage: agent answer <id>}")
  meta_load "$id"
  [[ $STATUS == waiting ]] || die "task $id has status '$STATUS' — it is not waiting for answers"
  local q="$TASKS/$id/questions-$ROUND.md"
  "${EDITOR:-nano}" "$q"
  if validate_answers "$q"; then
    local yn
    read -rp "All questions are answered. Resume now? [Y/n] " yn
    [[ ${yn,,} == n* ]] || cmd_resume "$id"
  else
    echo "Not all questions are answered. Complete them and run: agent answer $id"
  fi
}

cmd__answers_saved() { # id round — the human saved a questions file (systemd path unit)
  stopping && return 0
  local id; id=$(resolve_id "${1:?}")
  local round=${2:?} f out errs
  exec 8>"$TASKS/$id/answers.lock"
  flock -w 30 8 || exit 0
  meta_load "$id"
  f="$TASKS/$id/questions-$round.md"
  if [[ $STATUS != waiting || $ROUND != "$round" ]]; then
    stop_answers_watch "$id" "$round"     # answered another way, or the task no longer waits
    return 0
  fi
  [[ $(file_mtime "$f") != "${QUESTIONS_MTIME:-}" ]] || return 0   # not changed since the questions were asked
  if ! answers_marked "$f"; then
    log_info answers_saved "task=$id" "round=$round" "marked=false"
    return 0
  fi
  if ! errs=$(validate_answers "$f" 2>&1); then
    log_warn answers_incomplete "task=$id" "round=$round"
    notify "$id" waiting "Questions file: $f" "the answers are marked ANSWERED but not complete:
$errs
Complete them and save the file again."
    return 0
  fi
  if out=$(cmd_resume "$id" 2>&1); then
    log_info answers_sent "task=$id" "round=$round"
  else
    log_warn answers_resume_failed "task=$id" "round=$round" "reason=$out"
    notify "$id" waiting "Questions file: $f" "the answers are complete, but the task could not be resumed: $out
Save the file again later, or run: agent resume $id"
  fi
}

cmd_resume() {
  local id; id=$(resolve_id "${1:?usage: agent resume <id> [additional note]}")
  shift
  meta_load "$id"
  [[ $STATUS == waiting ]] || die "task $id has status '$STATUS' (resume only works for 'waiting')"
  local q="$TASKS/$id/questions-$ROUND.md"
  validate_answers "$q" || die "not all questions are answered — complete: $q"
  [[ -n $SESSION_ID ]] || die "no agent session ID — cannot resume (see: agent log $id)"
  if (($#)); then printf '%s\n' "$*" > "$TASKS/$id/note-$((RUN + 1)).md"; fi
  meta_set "$id" ANSWERS_PENDING "$ROUND"
  stop_answers_watch "$id" "$ROUND"

  if [[ ${KIND:-worker} == worker ]]; then
    local pending
    pending=$(bus inv-pending --dir "$BUS_DIR" --task "$id")
    if [[ -n $pending ]]; then
      meta_set "$id" STATUS investigating
      echo "Answers accepted. $id resumes automatically when investigation #$pending finishes."
      return
    fi
    local busy
    if busy=$(agent_running_task "$AGENT"); then
      die "agent $AGENT is busy with $busy — resume when it finishes"
    fi
  else
    bus inv-set --dir "$BUS_DIR" --id "$INV_ID" --status running
  fi
  start_runner "$id" resume || exit 1
  echo "Resumed $id (run $((RUN + 1)))."
}

cmd_status() {
  printf '%-30s %-12s %-13s %-6s %-5s %s\n' TASK AGENT STATUS ROUND RUN REPO
  local d
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    (
      source "$d/meta.env"
      st=${STATUS:-?}
      # a remote member's proxy task has no local unit: its member runs on its node
      if [[ ${KIND:-worker} != remote-member && ( $st == running || $st == starting ) ]] && ! unit_active "${ID:-}" "${RUN:-0}"; then
        st="$st?"
      fi
      ag=${AGENT:-?}; [[ ${KIND:-worker} == investigation ]] && ag="inv#${INV_ID:-?}"
      d=${d%/}
      printf '%-30s %-12s %-13s %-6s %-5s %s\n' "${ID:-${d##*/}}" "$ag" "$st" "${ROUND:--}" "${RUN:--}" "${REPO_NAME:-}"
    )
  done
}

cmd_show() {
  local id; id=$(resolve_id "${1:?usage: agent show <id>}")
  local dir="$TASKS/$id"
  meta_load "$id"
  echo "== $id"
  sed 's/^/  /' "$dir/meta.env"
  echo; echo "== task"; cat "$dir/task.md"
  if ((ROUND > 0)); then echo; echo "== questions (round $ROUND): $dir/questions-$ROUND.md"; fi
  local last=""
  [[ -f $dir/final.md ]] && last=$(<"$dir/final.md")
  if [[ ${KIND:-worker} == worker ]]; then
    local invs; invs=$(try inv_list_failed bus inv-list --dir "$BUS_DIR" --task "$id")
    if [[ -n $invs ]]; then echo; echo "== investigations"; printf '%s\n' "$invs"; fi
  else
    echo; echo "== investigation #$INV_ID for $FROM_AGENT (task $PARENT_TASK)"
    [[ -s $dir/result.md ]] && echo "   result: $dir/result.md"
  fi
  if [[ -n $last ]]; then echo; echo "== the agent's last message"; printf '%s\n' "$last"; fi
  if [[ -f $WORKTREE/.agents/reports/$id.md ]]; then
    echo; echo "== report: $WORKTREE/.agents/reports/$id.md"
  fi
}

# render_log — renders log lines readably: structured records (JSON with an "event") become
# "HH:MM:SS LEVEL event key=value ...", any other line (output of git, the CLIs, tail headers) passes unchanged.
render_log() {
  jq --unbuffered -Rr '. as $line | (try fromjson catch null) as $r
    | if ($r | type) == "object" and ($r | has("event")) then
        "\(($r.ts // "")[11:19]) \(($r.level // "info") | ascii_upcase | .[0:5]) \($r.event)"
        + ([$r | to_entries[]
            | select(.key | IN("ts", "level", "event", "component", "pid", "subcommand", "task") | not)
            | select(.value != "")
            | " \(.key)=\(.value | tostring | if test("[[:space:]]") then @json else . end)"] | join(""))
      else $line end'
}

cmd_log() { # <id> [--raw] — follows the runner log of a task (structured records rendered unless --raw)
  local id; id=$(resolve_id "${1:?usage: agent log <id> [--raw]}")
  local dir="$TASKS/$id" run
  run=$(task_field "$id" RUN)
  # the error log of the current run may not exist yet; tail -F waits for it (its "cannot open" notice is noise)
  if [[ ${2:-} == --raw ]]; then
    tail -n 60 -F "$dir/runner.log" "$dir/err-$run.log" 2>/dev/null
  else
    tail -n 60 -F "$dir/runner.log" "$dir/err-$run.log" 2>/dev/null | render_log
  fi
}

stop_all() { # agent stop --running: stops everything that is active, whatever its state
  local flag="$AGENTS_HOME/.stop-all" d id st run units=() stopped=()
  : > "$flag"
  try cancel_pending_failed bus cancel-pending --dir "$BUS_DIR"
  for d in "$TASKS"/*/; do
    d=${d%/}; id=${d##*/}
    [[ -f $d/meta.env ]] || continue
    st=$(task_field "$id" STATUS)
    case $st in
      new|starting|running|waiting|investigating|sleeping|paused)
        touch "$d/stop-requested"
        meta_set "$id" STATUS stopped
        meta_set "$id" FINISHED "$(date -Is)"
        run=$(task_field "$id" RUN)
        units+=("$(unit_name "$id" "$run").service")
        stopped+=("$id ($st)") ;;
    esac
  done
  if ((${#units[@]})); then
    try unit_stop_failed systemctl --user stop "${units[@]}"
  fi
  for d in "${stopped[@]}"; do   # a runner may have overwritten the status while stopping
    id=${d%% *}
    meta_set "$id" STATUS stopped
    act "$id" info "■ stopped (agent stop --running)"
  done
  rm -f "$flag"
  if ((${#stopped[@]})); then
    local n=${#stopped[@]} w=tasks
    ((n == 1)) && w=task
    log_info stop_all "stopped=$n" "tasks=${stopped[*]}"
    echo "Stopped $n $w:"
    printf '  %s\n' "${stopped[@]}"
  else
    echo "Nothing was running."
  fi
}

cmd_stop() {
  if [[ ${1:-} == --running ]]; then stop_all; return; fi
  local id; id=$(resolve_id "${1:?usage: agent stop <id> | --running}")
  local run st team agent is_job=0
  [[ -n $(task_field "$id" JOB_ID) ]] && is_job=1
  ((is_job)) && lock_task_ids
  touch "$TASKS/$id/stop-requested"
  run=$(task_field "$id" RUN); st=$(task_field "$id" STATUS)
  team=$(task_field "$id" TEAM); agent=$(task_field "$id" AGENT)
  ((is_job)) && unlock_task_ids
  try unit_stop_failed systemctl --user stop "$(unit_name "$id" "$run").service"
  meta_set "$id" STATUS stopped
  meta_set "$id" FINISHED "$(date -Is)"
  if [[ -n $team ]]; then
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$agent" --state done >/dev/null
    if [[ $agent == "$(team_lead "$team")" ]]; then
      finish_team "$team" "team stopped by the user"
    elif [[ $st == sleeping ]]; then
      notice member_stopped "${USER:-human}" "$(team_lead "$team")" "TEAM: member $agent was stopped by the human." "agent=$agent" "team=$team"
    fi
  fi
  log_info task_stopped "task=$id"
  echo "Stopped $id."
}

cmd_clean() {
  local id; id=$(resolve_id "${1:?usage: agent clean <id>}")
  meta_load "$id"
  [[ $STATUS != running && $STATUS != starting ]] || die "task $id is still running (agent stop $id)"
  if [[ -d $WORKTREE ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKTREE"
    echo "Removed worktree $WORKTREE (branch $BRANCH is kept)."
  else
    echo "The worktree no longer exists."
  fi
}

cmd_agents() {
  local a busy
  for a in "${!AGENT_TYPE[@]}"; do
    if busy=$(agent_running_task "$a"); then busy="busy: $busy"; else busy="free"; fi
    printf '%-12s %-7s model=%-24s %s\n' "$a" "${AGENT_TYPE[$a]}" "${AGENT_MODEL[$a]:-default}" "$busy"
  done
  local inv
  while read -r inv; do
    printf '%-12s %-7s model=%-24s investigator\n' "$inv" "${INVESTIGATORS_TYPE[$inv]}" "${INVESTIGATORS_MODEL[$inv]:-default}"
  done < <(investigator_names)
  bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" | head -1
}

cmd_inv() { # [number] — the queue, or the full record of one investigation
  if [[ -z ${1:-} ]]; then
    bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS"
    echo
    echo "All: agent inv --all   |   details: agent inv <number>"
  elif [[ $1 == --all ]]; then
    bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --all
  else
    local f; f=$(bus inv-get --dir "$BUS_DIR" --id "${1#\#}" | jq -r .file)
    cat "$f"
  fi
}

cmd_dispatch() { dispatch; bus inv-list --dir "$BUS_DIR" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS"; }

cmd_live() {
  local remind=$LIVE_REMIND_MIN feed=()
  while (($#)); do
    case $1 in
      --remind) remind=${2:?give a number of minutes}; shift ;;
      --feed)   feed+=(--feed) ;;
      --light)  feed+=(--light) ;;
      *) die "usage: agent live [--feed] [--remind MINUTES] [--light]" ;;
    esac
    shift
  done
  [[ -x $AGENTLIVE_BIN ]] || die "$AGENTLIVE_BIN not found — run ./install.sh again"
  exec "$AGENTLIVE_BIN" --home "$AGENTS_HOME" --bus "$BUS_DIR" --agent "$SELF" \
    --remind "$remind" --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" "${feed[@]}"
}

member_out() { # id reason — a team member is out of the team's work: its board items go back (with their progress
  # notes) and the coordinator and the normal members hear who, why, which items and where its work is
  local id=$1 why=$2 team agent branch wt released head="" nm text
  team=$(task_field "$id" TEAM)
  [[ -n $team ]] || return 0
  agent=$(task_field "$id" AGENT); branch=$(task_field "$id" BRANCH); wt=$(task_field "$id" WORKTREE)
  released=$(try board_release_failed bus board-release-agent --dir "$BUS_DIR" --team "$team" --agent "$agent" | paste -sd,)
  if [[ -d $wt ]]; then
    head=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null) || head=""   # no commit yet: no head to name
  fi
  text="MEMBER $agent IS OUT: $why.${released:+ Its items ($released) are back on the board with its progress notes — take them over.} Its work is on branch $branch${head:+ at $head}: continue from there (merge it) unless its notes say the approach failed."
  if [[ $agent == "$(team_lead "$team")" ]]; then
    text="COORDINATOR $agent IS OUT: $why. Normal model: take over coordination (claim_lead), read the last checkpoint, the board and the PR, and continue.${released:+ Its items ($released) are back on the board.} Its integrated work is on branch $branch${head:+ at $head} — the PR's branch."
  fi
  for nm in $(bus team-get --dir "$BUS_DIR" --team "$team" | jq -r --arg a "$agent" '.members[] | select(.agent != $a and .tier != "worker" and (.state == "active" or .state == "sleeping" or .state == "waking")) | .agent'); do
    notice member_out agentbus "$nm" "$text" "agent=$agent" "team=$team" "released=$released"
  done
  log_warn member_out "task=$id" "team=$team" "released=$released" "reason=${why:0:200}"
}

cmd__supervise() { # (a systemd timer) ends the tasks whose runner died: running or starting, but no unit is active —
  # unless their machine restarted under the run (restart_interrupted)
  local d id st run rb
  supervise_answer_watches   # watches of answers nobody waits for any more
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    id=${d%/}; id=${id##*/}
    st=$(task_field "$id" STATUS)
    [[ $st == running || $st == starting ]] || continue
    # a remote member's proxy task has no local unit: its member runs on its node, followed through its heartbeat
    [[ $(task_field "$id" KIND) != remote-member ]] || continue
    (($(date +%s) - $(stat -c %Y "$d/meta.env") >= AGENT_SUPERVISE_GRACE_SEC)) || continue   # a fresh run: its unit may come
    run=$(task_field "$id" RUN)
    systemctl --user is-active --quiet "$(unit_name "$id" "$run").service" && continue   # inactive is the case looked for
    rb=$(task_field "$id" RUN_BOOT)
    if [[ -n $rb && $rb != "$(boot_id)" ]]; then   # its machine restarted under the run: not a dead runner
      restart_interrupted "$id"
      continue
    fi
    meta_set "$id" STATUS failed
    act "$id" err "✗ the runner died (no running unit) — the task is ended"
    log_warn runner_died "task=$id" "run=$run"
    if [[ -n $(task_field "$id" TEAM) ]]; then
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$(task_field "$id" TEAM)" --agent "$(task_field "$id" AGENT)" --state done >/dev/null
      member_out "$id" "its runner died (no running unit)"
    fi
    notify "$id" failed "" "the runner died (no running unit) — the task is ended"
  done
  supervise_member_jobs
  supervise_teams
  supervise_review_waits
}

supervise_member_jobs() { # the lead: a remote member's job whose team is closed or unknown to the bus is cancelled
  # (and its grant revoked) — whatever way its team ended without it
  [[ -n ${LEAD_LISTEN:-} && -f $BUS_DIR/jobs.json ]] || return 0
  local job team member out
  while IFS=$'\t' read -r job team member; do
    [[ -n $job ]] || continue
    if bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null 2>&1 && [[ $(team_done_flag "$team") != true ]]; then
      continue   # its team goes on (a team the bus does not know fails team-get: it does not go on)
    fi
    if out=$("$SELF" jobs --cancel "$job" 2>&1); then
      log_warn member_job_orphaned "job=$job" "team=$team" "member=$member"
    else
      log_warn member_job_cancel_failed "job=$job" "team=$team" "reason=${out:0:300}"
    fi
    bus lead-member --dir "$BUS_DIR" --remove --member "$member" >/dev/null 2>&1 \
      || log_info member_grant_already_gone "member=$member"   # revoked when its team finished, or never granted
  done < <(jq -r '.Jobs[] | select((.Request.Team // "") != "" and (.State | IN("queued", "assigned", "running", "waiting")))
                  | [.Request.ID, .Request.Team, .Request.Member] | @tsv' "$BUS_DIR/jobs.json")
}

supervise_teams() { # an open team with no local member at work or asleep for AGENT_TEAM_ABANDON_MIN is reported to the
  # human, once: it waits for a resume (a coordinator's failure keeps a team open) or to be closed — never by itself
  local m team t alive last tm mark first
  local -A seen=()
  for m in "$TASKS"/*/meta.env; do
    [[ -f $m ]] || continue
    team=$(sed -n 's/^TEAM=//p' "$m")
    [[ -n $team && -z ${seen[$team]:-} ]] || continue
    seen[$team]=1
    grep -qx 'REMOTE_TEAM=1' "$m" && continue                 # a remote member's task: its team lives on the lead
    [[ $(team_done_flag "$team") == false ]] || continue        # closed, or unknown to the bus
    mark="$BUS_DIR/abandoned-teams/$team"
    [[ ! -e $mark ]] || continue                                # reported already
    alive=0 last=0 first=""
    for t in $(team_tasks "$team"); do
      [[ $(task_field "$t" KIND) != remote-member ]] || continue
      [[ -n $first ]] || first=$t
      case $(task_field "$t" STATUS) in
        new|starting|running|sleeping|waiting|paused|investigating|interrupted) alive=1 ;;
      esac
      tm=$(stat -c %Y "$TASKS/$t/meta.env")
      ((tm <= last)) || last=$tm
    done
    ((alive == 0)) && [[ -n $first ]] || continue
    (($(date +%s) - last >= AGENT_TEAM_ABANDON_MIN * 60)) || continue
    log_warn team_abandoned "team=$team"
    notify "$first" abandoned "" "team $team has no local member at work or asleep. Resume it: agent run --resume $team \"…\" — or close it: agent team $team --close"
    mkdir -p "${mark%/*}"
    : > "$mark"   # after the notification: one that failed is sent again at the next run
  done
}

remote_member_task() { # member task team base main-root ts — a remote member's proxy task on the lead (no worktree, no
  # runner: the member runs on its node); checks first that this is a lead, the node is online with the agent free,
  # and the base is on origin (the node starts from there). Prints the task ID.
  local member=$1 task=$2 team=$3 base=$4 root=$5 ts=$6 resuming=${7:-} agent node nodes row tier sha id
  agent=${member%@*}; node=${member#*@}
  [[ -n ${LEAD_LISTEN:-} ]] || die "remote member $member: this installation is not a lead (LEAD_LISTEN)"
  nodes=$(bus node-request --url "$(lead_url)" --path /v1/nodes --get) || die "remote member $member: cannot list the nodes"
  row=$(jq -c --arg n "$node" '.[] | select(.Node == $n)' <<< "$nodes")
  [[ -n $row ]] || die "remote member $member: no node $node (agent nodes)"
  [[ $(jq -r '.Offline // false' <<< "$row") != true ]] || die "remote member $member: node $node is offline"
  tier=$(jq -r --arg a "$agent" '.FreeAgents // [] | .[] | select(.Name == $a) | .Tier' <<< "$row")
  [[ -n $tier ]] || die "remote member $member: $agent is not a free agent of $node (agent nodes)"
  git -C "$root" fetch -q origin "$base" 10>&- || die "remote member $member: cannot fetch $base from origin"
  # a new team's members start from one commit; a member coming back on a resume continues its round, whatever the
  # lead's own checkout holds just now
  if [[ -z $resuming ]]; then
    remote_start_check "$root" "$base" || die "remote member $member starts from origin: push $base first (git push origin $base)"
    sha=$(git -C "$root" rev-parse HEAD 10>&-)
  else
    sha=$(git -C "$root" rev-parse "origin/$base" 10>&-) || die "remote member $member: no origin/$base to come back from"
  fi
  id="$ts-$agent-at-$node"
  mkdir -p "$TASKS/$id"
  : > "$TASKS/$id/meta.env"
  meta_set "$id" ID "$id"; meta_set "$id" AGENT "$member"; meta_set "$id" KIND remote-member
  meta_set "$id" REMOTE_NODE "$node"; meta_set "$id" REMOTE_AGENT "$agent"; meta_set "$id" TEAM "$team"
  meta_set "$id" TIER "$tier"; meta_set "$id" STATUS remote; meta_set "$id" CREATED "$(date -Is)"
  meta_set "$id" ROUND 0; meta_set "$id" RUN 0   # what every task has (agent status reads them)
  meta_set "$id" REPO_NAME "$(basename "$root")"; meta_set "$id" REPO_ROOT "$root"
  meta_set "$id" BASE "$base"; meta_set "$id" BASE_SHA "$sha"; meta_set "$id" BRANCH ""; meta_set "$id" WORKTREE ""
  meta_set "$id" JOB_ID "member-$id"
  printf '%s\n' "$task" > "$TASKS/$id/task.md"
  act "$id" info "remote member $member: it works on $node, in team $team"
  printf '%s' "$id"
}

node_stop_doorbell() { # the node daemon ends: so does its doorbell (a coprocess would outlive it)
  if [[ -n ${DOORBELL_PID:-} ]]; then
    kill "$DOORBELL_PID" 2>/dev/null || log_info node_doorbell_already_gone   # it may have ended by itself
  fi
}

boot_id() { # this machine's boot ID (another after each restart); AGENT_BOOT_ID_FILE in tests
  local f=${AGENT_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}
  if [[ -r $f ]]; then cat "$f"; fi   # none where the system has no boot ID: restarts are not told apart then
}

restart_interrupted() { # id — a run its machine's restart interrupted: the task goes on, told what happened (a local
  # task or a job's at once; a remote team member when its lead wakes it), up to AGENT_RESTART_MAX restarts
  local id=$1 n note
  n=$(task_field "$id" RESTARTS); n=$(( ${n:-0} + 1 ))
  meta_set "$id" RESTARTS "$n"
  if (( n > AGENT_RESTART_MAX )); then
    note="its machine restarted $n times during this task (AGENT_RESTART_MAX=$AGENT_RESTART_MAX)"
    meta_set "$id" STATUS failed
    meta_set "$id" NOTE "$note"
    act "$id" err "✗ $note — the task is ended"
    log_warn restart_limit "task=$id" "restarts=$n"
    if [[ -n $(task_field "$id" TEAM) && $(task_field "$id" REMOTE_TEAM) != 1 ]]; then
      try team_state_failed bus team-set --dir "$BUS_DIR" --team "$(task_field "$id" TEAM)" --agent "$(task_field "$id" AGENT)" --state done >/dev/null
      member_out "$id" "$note"
    fi
    notify "$id" failed "" "$note"
    return 0
  fi
  meta_set "$id" STATUS interrupted
  meta_set "$id" RESTART_PENDING "$(date '+%H:%M')"
  meta_set "$id" NOTE "interrupted by a restart of its machine ($n/$AGENT_RESTART_MAX)"
  act "$id" info "↻ interrupted by a restart of the machine ($n/$AGENT_RESTART_MAX)"
  log_warn run_interrupted_by_restart "task=$id" "restarts=$n"
  [[ $(task_field "$id" REMOTE_TEAM) != 1 ]] || return 0   # its lead decides, and wakes it (memberActivity)
  start_runner "$id" resume || log_error resume_failed "task=$id" "reason=after a restart of its machine"
}

cmd__remote_member() { # proxy status branch note — a remote member's change, handed over by the lead's bus: the
  # proxy task's status (what the team's checks read), then the team's logic for it, as after a local member's run
  local id status=${2:?} branch=${3:-} note=${4:-}
  id=$(resolve_id "${1:?}")
  meta_load "$id"
  [[ ${KIND:-} == remote-member ]] || die "task $id is not a remote member's proxy task"
  case $status in
    sleeping|running|paused|done|failed|stopped) ;;
    out) status=failed ;;   # its node was away longer than the grace: out of its team, as a failed member
    *) die "unknown remote member status: $status" ;;
  esac
  [[ -z $branch ]] || meta_set "$id" BRANCH "$branch"
  [[ -z $note ]] || meta_set "$id" NOTE "$note"   # what it stopped or ended on, for the dashboard
  meta_set "$id" STATUS "$status"
  case $status in done|failed|stopped) meta_set "$id" FINISHED "$(date -Is)" ;; esac
  act "$id" info "remote member $AGENT: $status${note:+ — ${note:0:200}}"
  log_info remote_member_status "task=$id" "member=$AGENT" "status=$status"
  if [[ $status == paused ]]; then   # on its node, until its timer resumes it: the human and its team hear why, until when
    meta_set "$id" PAUSE_REASON "$(pause_reason_from_note "$note")"
    meta_set "$id" WAKE_AT "$(pause_until_from_note "$note")"
    notify "$id" paused "" "remote member $AGENT${note:+: ${note:0:300}}"
    meta_load "$id"
    team_after_run "$id" paused "$note" "$note"   # as a local member's pause: the coordinator's notice; a long one frees its items
    return 0
  fi
  if [[ $status == running ]]; then   # at work again (after a pause too): active in its team
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$TEAM" --agent "$AGENT" --state active > /dev/null
    return 0
  fi
  [[ $status != running ]] || return 0
  meta_load "$id"   # BRANCH for member_out
  team_after_run "$id" "$status" "$note" "$note"
}

remote_agent_wait_free() { # member seconds — waits until the node offers the member's agent as free again
  local agent=${1%@*} node=${1#*@} i
  for ((i = 0; i < $2; i++)); do
    if bus node-request --url "$(lead_url)" --path /v1/nodes --get | jq -e --arg n "$node" --arg a "$agent" \
         '.[] | select(.Node == $n) | .FreeAgents // [] | .[] | select(.Name == $a)' >/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

RESUME_NEW_IDS=()           # the tasks a resume in progress has made (removed again if it fails)
declare -A RESUME_NEW_WT=() # their worktrees, by task

resume_abandon() { # [status command] a resume that failed: its new tasks go — changes it carried are committed (WIP) on
  # their branch, their worktrees and task files removed, its remote members' jobs and grants ended — so nothing
  # half-made blocks the branches or --last-team
  local id wt name status=${1:-} cmd=${2:-}
  ((${#RESUME_NEW_IDS[@]})) || return 0
  for id in "${RESUME_NEW_IDS[@]}"; do
    name=${id#*-}; name=${name#*-}   # <date>-<time>-<agent>
    if [[ -f $TASKS/$id/meta.env && $(task_field "$id" KIND) == remote-member ]]; then
      "$SELF" jobs --cancel "$(task_field "$id" JOB_ID)" >/dev/null 2>&1 \
        || log_info remote_member_cancel_skipped "task=$id"   # its job may not have been submitted yet
      bus lead-member --dir "$BUS_DIR" --remove --member "$(task_field "$id" AGENT)" >/dev/null 2>&1 \
        || log_info remote_member_revoke_skipped "task=$id"   # nor granted
    fi
    wt=${RESUME_NEW_WT[$id]:-}
    if [[ -n $wt && -d $wt ]]; then
      if [[ -n $(git -C "$wt" status --porcelain) ]]; then
        { git -C "$wt" add -A &&
          GIT_AUTHOR_NAME="$name (team-agents)" GIT_AUTHOR_EMAIL="$name@team-agents.invalid" \
          GIT_COMMITTER_NAME="$name (team-agents)" GIT_COMMITTER_EMAIL="$name@team-agents.invalid" \
            git -C "$wt" commit -q -m "WIP: uncommitted work carried by an interrupted resume"; } \
          || log_warn resume_wip_commit_failed "task=$id" "worktree=$wt"
      fi
      git -C "$wt" worktree remove --force "$wt" || log_warn resume_worktree_remove_failed "task=$id" "worktree=$wt"
    fi
    rm -rf "${TASKS:?}/$id"
  done
  log_warn resume_abandoned "tasks=${RESUME_NEW_IDS[*]}" "status=$status" "command=${cmd:0:300}"
  echo "agent: the resume failed — its new tasks were removed; changes it carried are committed (WIP) on their branches" >&2
}

remote_member_start() { # proxy-task — grants the remote member on the lead and submits the job that runs it on its
  # node (its tools reach the team through the relay; its task text is the team's)
  local id=$1 member agent node body out
  member=$(task_field "$id" AGENT); agent=$(task_field "$id" REMOTE_AGENT); node=$(task_field "$id" REMOTE_NODE)
  bus lead-member --dir "$BUS_DIR" --add --member "$member" --agent "$agent" --node "$node" --team "$(task_field "$id" TEAM)" \
    --task "$id" --tier "$(task_field "$id" TIER)" --repo "$(task_field "$id" REPO_NAME)" --job "$(task_field "$id" JOB_ID)" >/dev/null \
    || { log_error remote_member_grant_failed "member=$member"; return 1; }
  body=$(jq -n --arg id "$(task_field "$id" JOB_ID)" --arg repo "$(task_field "$id" REPO_NAME)" --arg base "$(task_field "$id" BASE)" \
    --arg sha "$(task_field "$id" BASE_SHA)" --arg agent "$agent" --arg node "$node" --rawfile task "$TASKS/$id/task.md" \
    --arg team "$(task_field "$id" TEAM)" --arg member "$member" --arg repo_url "$(github_repo_url "$(task_field "$id" REPO_ROOT)")" \
    '{ID:$id, Repository:$repo, BaseRef:$base, BaseSHA:$sha, Selector:$agent, Target:$node, Task:$task, Requester:"human", Team:$team, Member:$member, RepoURL:$repo_url, RequesterTask:""}')
  if ! out=$(printf '%s' "$body" | bus node-request --url "$(lead_url)" --path /v1/jobs); then
    log_error remote_member_job_failed "member=$member" "reason=${out:0:300}"
    return 1
  fi
  meta_set "$id" STATUS remote
  log_info remote_member_started "member=$member" "task=$id" "job=$(task_field "$id" JOB_ID)"
}

cmd_wake() { # <task> — a paused task resumes now, not at its pause's end (its provider's limit lifted early, a bigger
  # plan bought); a remote member's proxy task on the lead asks the member's node, which resumes it at once
  local id
  id=$(resolve_id "${1:?usage: agent wake <task>}")
  meta_load "$id"
  [[ ${STATUS:-} == paused ]] || die "task $id is not paused (status: ${STATUS:-unknown}) — nothing to resume"
  if [[ ${KIND:-} == remote-member ]]; then
    bus lead-member --dir "$BUS_DIR" --wake-now --member "$AGENT" > /dev/null \
      || die "cannot ask ${AGENT#*@} to resume $AGENT: the lead's registry refused it"
    act "$id" info "asked ${AGENT#*@} to resume $AGENT now (agent wake)"
    log_info wake_now_requested "task=$id" "member=$AGENT"
    echo "asked ${AGENT#*@} to resume $AGENT now: it starts as soon as the node hears its doorbell"
    return 0
  fi
  meta_set "$id" WAKE_AT "$(date +%s)"
  act "$id" info "■ resumed by hand before its pause's end (${PAUSE_REASON:-paused})"
  log_info wake_by_hand "task=$id" "reason=${PAUSE_REASON:-}"
  "$SELF" _wake "$id"
  echo "resumed $id"
}

cmd_kick() { # <task> [from] — cuts an agent's current run short (the web interface's stop button): a team member
  # goes to sleep, so its team can wake it again, and the coordinator is told; a solo task is stopped
  local id run st team agent lead
  id=$(resolve_id "${1:?usage: agent kick <task>}")
  run=$(task_field "$id" RUN); st=$(task_field "$id" STATUS); team=$(task_field "$id" TEAM); agent=$(task_field "$id" AGENT)
  [[ $st == running || $st == starting ]] || die "task $id is not running ($st) — nothing to stop"
  meta_set "$id" KICKED "$(date -Is)"
  try unit_stop_failed systemctl --user stop "$(unit_name "$id" "$run").service"
  if [[ -n $team ]]; then
    meta_set "$id" STATUS sleeping
    try team_state_failed bus team-set --dir "$BUS_DIR" --team "$team" --agent "$agent" --state sleeping >/dev/null
    lead=$(team_lead "$team")
    if [[ -n $lead && $lead != "$agent" ]]; then
      notice member_stopped "${USER:-human}" "$lead" "TEAM: member $agent was stopped by the human (its current run only); it sleeps — wake it if its work is still needed." "agent=$agent" "team=$team"
    fi
  else
    meta_set "$id" STATUS stopped
  fi
  act "$id" info "■ stopped by the human${2:+ (from the $2 interface)}"
  log_info task_kicked "task=$id" "team=$team" "from=${2:-cli}"
  echo "stopped $id${team:+ — it sleeps; team $team can wake it}"
}

cmd_web() { # runs the web interface in the foreground (agentweb.service runs this)
  [[ -x $AGENTLIVE_BIN ]] || die "$AGENTLIVE_BIN not found — run ./install.sh again"
  exec "$AGENTLIVE_BIN" web --home "$AGENTS_HOME" --bus "$BUS_DIR" --agent "$SELF" \
    --listen "$AGENT_WEB_LISTEN" --users "$AGENT_WEB_USERS" --devices "$AGENT_WEB_DEVICES" \
    --tailscale "$(command -v tailscale || echo tailscale)" \
    --queue-max "$INVESTIGATION_QUEUE_MAX" --inv-slots "$INV_SLOTS" --node-ttl "$NODE_TTL_SEC"
}

cmd_lead() { # runs the lead's listener in the foreground (agentlead.service runs this); needs LEAD_LISTEN
  [[ -n $LEAD_LISTEN ]] || die "LEAD_LISTEN is not set in agents.conf — a lead needs its Tailscale address, e.g. 100.x.y.z:7780"
  local args=(lead --dir "$BUS_DIR" --listen "$LEAD_LISTEN" --node "$INSTANCE_NAME" --ttl "${NODE_TTL_SEC}s")
  [[ -n ${NOTIFY_DIR:-} ]] && args+=(--notify-dir "$NOTIFY_DIR")
  args+=(--member-grace "${AGENT_RESTART_GRACE_MIN}m")
  [[ -n ${NOTIFY_CMD:-} ]] && args+=(--notify-cmd "$NOTIFY_CMD")
  local dev
  for dev in $LEAD_NODES; do args+=(--allow "$dev"); done
  exec "$AGENTBUS_BIN" "${args[@]}"
}

# node_jobs_file returns the node's durable local mapping and latest reports.
node_jobs_file() { printf '%s/node-jobs.json' "$BUS_DIR"; }

# node_jobs_load fails closed on damaged storage; only an absent path denotes a fresh installation.
node_jobs_load() {
  local f content
  f=$(node_jobs_file)
  if [[ ! -e $f && ! -L $f ]]; then printf '{"jobs":{},"outbox":[]}\n'; return; fi
  [[ -f $f ]] || die "node state is not a regular file: $f"
  content=$(cat -- "$f") || die "cannot read node state: $f"
  jq -e 'type == "object" and (.jobs|type == "object") and (.outbox|type == "array")' <<< "$content" >/dev/null \
    || die "corrupt node state: $f"
  printf '%s\n' "$content"
}

# node_jobs_save atomically replaces state without losing the previous snapshot on a write failure.
node_jobs_save() {
  local data=$1 tmp
  tmp=$(umask 077; mktemp "$BUS_DIR/node-jobs.XXXXXX") || die "cannot allocate node state temporary file"
  if ! { printf '%s\n' "$data" > "$tmp" && mv -- "$tmp" "$(node_jobs_file)"; }; then
    if ! rm -f -- "$tmp"; then log_error node_storage_failed "path=$tmp"; fi
    die "cannot save node state"
  fi
}

# node_save commits the current single-writer snapshot before any network or launch side effect.
node_save() { node_jobs_save "$NODE_STATE"; }

# node_lock excludes another daemon for this installation; runner children explicitly close descriptor 8.
node_lock() {
  mkdir -p "$BUS_DIR"
  exec 8>"$BUS_DIR/node-daemon.lock"
  flock -n 8 || die "another node daemon is already running"
}

# lead_url returns the configured LEAD_URL or the lead's loopback address.
lead_url() {
  if [[ -n ${LEAD_URL:-} ]]; then
    printf '%s' "${LEAD_URL%/}"
  elif [[ -n ${LEAD_LISTEN:-} ]]; then
    printf 'http://127.0.0.1:%s' "${LEAD_LISTEN##*:}"
  else
    die "neither LEAD_URL nor LEAD_LISTEN is configured"
  fi
}

# node_request sends only a coarse HTTP operation through the bounded Go transport.
node_request() { bus node-request --url "$LEAD_URL" "$@"; }

# submit_remote_job submits a job to the lead queue.
submit_remote_job() {
  local selector=$1 target_node=$2 task=$3; shift 3
  local caps=("$@")
  local root common repo_name base_ref job_id req_json body out state
  root=$(git rev-parse --show-toplevel) || die "cannot find the repository root; run this inside a git repository"
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir) || die "cannot resolve the repository common directory"
  repo_name=$(basename "$(dirname "$common")")
  base_ref=$(git -C "$root" rev-parse --abbrev-ref HEAD) || die "cannot resolve the current branch for the remote job"
  # A detached checkout deliberately uses main; failed git lookups must never submit a fallback job.
  [[ $base_ref != "HEAD" ]] || base_ref="main"
  job_id="$(date +%Y%m%d-%H%M%S)-${USER:-human}-$RANDOM"
  req_json='[]'
  if ((${#caps[@]})); then
    req_json=$(printf '%s\n' "${caps[@]}" | jq -R . | jq -s .)
  fi
  body=$(jq -cn \
    --arg id "$job_id" \
    --arg repo "$repo_name" \
    --arg base "$base_ref" \
    --argjson req "$req_json" \
    --arg sel "$selector" \
    --arg target "$target_node" \
    --arg task "$task" \
    --arg reqstr "human" --arg repo_url "$(github_repo_url "$root")" \
    '{ID:$id,Repository:$repo,BaseRef:$base,Requires:$req,Selector:$sel,Target:$target,Task:$task,Requester:$reqstr,RepoURL:$repo_url,RequesterTask:""}')
  out=$(printf '%s' "$body" | bus node-request --url "$(lead_url)" --path /v1/jobs) || die "failed to submit job to lead: $out"
  state=$(jq -r '.State // "queued"' <<< "$out")
  echo "Job $job_id submitted to lead ($state)"
  echo "Track with: agent jobs $job_id"
}

# cmd_jobs lists remote jobs, inspects a single job, or cancels a job on the lead.
cmd_jobs() {
  if [[ ${1:-} == --cancel ]]; then
    local id=${2:-}
    [[ -n $id ]] || die "usage: agent jobs --cancel <id>"
    [[ -n ${LEAD_LISTEN:-} ]] || die "cancelling a job is only supported on the lead"
    local cancel_args=(lead-cancel --dir "$BUS_DIR" --ttl "${NODE_TTL_SEC}s")
    [[ -n ${NOTIFY_DIR:-} ]] && cancel_args+=(--notify-dir "$NOTIFY_DIR")
    [[ -n ${NOTIFY_CMD:-} ]] && cancel_args+=(--notify-cmd "$NOTIFY_CMD")
    cancel_args+=("$id")
    local res state
    res=$(bus "${cancel_args[@]}") || die "cannot cancel job $id"
    state=$(jq -r '.State // "stopped"' <<< "$res")
    echo "Job $id cancelled ($state)"
    return
  fi
  local id=${1:-}
  if [[ -n $id ]]; then
    local job state node branch pr wait_reason offline task_text result reqs target
    job=$(bus node-request --url "$(lead_url)" --path "/v1/jobs/$id" --get) || die "job not found: $id"
    state=$(jq -r '.State // ""' <<< "$job")
    node=$(jq -r '.Node // ""' <<< "$job")
    branch=$(jq -r '.Branch // ""' <<< "$job")
    pr=$(jq -r '.PRURL // ""' <<< "$job")
    wait_reason=$(jq -r '.WaitReason // ""' <<< "$job")
    offline=$(jq -r '.NodeOffline // false' <<< "$job")
    task_text=$(jq -r '.Request.Task // ""' <<< "$job")
    result=$(jq -r '.Result // ""' <<< "$job")

    echo "Job: $id"
    if [[ $state == queued && -n $wait_reason ]]; then
      echo "State: queued (waiting: $wait_reason)"
    elif [[ $offline == true && $state == running ]]; then
      echo "State: running (node offline)"
    else
      echo "State: $state"
    fi
    echo "Repo: $(jq -r '.Request.Repository // ""' <<< "$job")"
    echo "Base: $(jq -r '.Request.BaseRef // ""' <<< "$job")"
    reqs=$(jq -r '.Request.Requires // [] | join(",")' <<< "$job")
    [[ -z $reqs ]] || echo "Requires: $reqs"
    echo "Selector: $(jq -r '.Request.Selector // ""' <<< "$job")"
    target=$(jq -r '.Request.Target // ""' <<< "$job")
    [[ -z $target ]] || echo "Target: $target"
    [[ -z $node ]] || echo "Node: $node"
    [[ -z $branch ]] || echo "Branch: $branch"
    [[ -z $pr ]] || echo "PR: $pr"
    if [[ -n $task_text ]]; then
      echo
      echo "Task:"
      echo "$task_text"
    fi
    if [[ -n $result ]]; then
      echo
      echo "Result:"
      echo "$result"
    fi
  else
    local jobs count
    jobs=$(bus node-request --url "$(lead_url)" --path "/v1/jobs" --get) || die "failed to list jobs from lead"
    if [[ -z ${LEAD_LISTEN:-} && -n ${LEAD_URL:-} ]]; then
      jobs=$(jq -c --arg node "$INSTANCE_NAME" '[.[] | select(.Node == $node)]' <<< "$jobs")
    fi
    count=$(jq 'length' <<< "$jobs")
    if ((count == 0)); then
      echo "No remote jobs found."
      return
    fi
    printf '%-26s %-12s %-12s %-10s %s\n' "JOB ID" "STATE" "NODE" "SELECTOR" "DETAILS"
    local i
    for ((i=0; i<count; i++)); do
      local row jid st nd sel wr off br details=""
      row=$(jq -c ".[$i]" <<< "$jobs")
      jid=$(jq -r '.Request.ID // ""' <<< "$row")
      st=$(jq -r '.State // ""' <<< "$row")
      nd=$(jq -r '.Node // "-"' <<< "$row")
      [[ -n $nd ]] || nd="-"
      sel=$(jq -r '.Request.Selector // ""' <<< "$row")
      wr=$(jq -r '.WaitReason // ""' <<< "$row")
      off=$(jq -r '.NodeOffline // false' <<< "$row")
      br=$(jq -r '.Branch // ""' <<< "$row")
      if [[ $st == queued && -n $wr ]]; then
        details="waiting: $wr"
      elif [[ $off == true && $st == running ]]; then
        details="node offline"
      elif [[ -n $br ]]; then
        details="$br"
      fi
      printf '%-26s %-12s %-12s %-10s %s\n' "$jid" "$st" "$nd" "$sel" "$details"
    done
  fi
}

# cmd_nodes lists the nodes registered on the lead.
cmd_nodes() {
  local nodes count
  nodes=$(bus node-request --url "$(lead_url)" --path "/v1/nodes" --get) || die "failed to list nodes from lead"
  count=$(jq 'length' <<< "$nodes")
  if ((count == 0)); then
    echo "No nodes registered yet."
    return
  fi
  printf '%-16s %-10s %-24s %-20s %-32s %s\n' "NODE" "STATUS" "CAPABILITIES" "FREE AGENTS" "LAST SEEN" "WEB URL"
  local i
  for ((i=0; i<count; i++)); do
    local row name off status="online" caps free last_seen web
    row=$(jq -c ".[$i]" <<< "$nodes")
    name=$(jq -r '.Node // ""' <<< "$row")
    off=$(jq -r '.Offline // false' <<< "$row")
    [[ $off != true ]] || status="offline"
    caps=$(jq -r '.Capabilities // [] | join(",")' <<< "$row")
    [[ -n $caps ]] || caps="-"
    free=$(jq -r '[.FreeAgents[]? | .Name] | join(",")' <<< "$row")
    [[ -n $free ]] || free="none"
    last_seen=$(jq -r '.LastSeen // "-"' <<< "$row")
    web=$(jq -r '.WebURL // "-"' <<< "$row")
    [[ -n $web ]] || web="-"
    printf '%-16s %-10s %-24s %-20s %-32s %s\n' "$name" "$status" "$caps" "$free" "$last_seen" "$web"
  done
}

# agent_cli_present agent — is the CLI of the agent's type installed? (a missing one is not offered as free)
agent_cli_present() {
  local bin=""
  case ${AGENT_TYPE[$1]:-} in
    claude) bin=$CLAUDE_BIN ;; codex) bin=$CODEX_BIN ;; gemini) bin=$AGY_BIN ;; opencode) bin=$OPENCODE_BIN ;;
  esac
  [[ -n $bin && -x $bin ]] || command -v "$bin" >/dev/null 2>&1   # a name on PATH; its output is not needed
}

declare -A NODE_MISSING_CLI=()   # agents already reported as lacking their CLI (once per daemon)

# node_activity_json — what the node's running jobs are doing: [{ID, Agent, Stage, Lines}], the latest 20 lines each
node_activity_json() {
  local jid tid lines out='[]'
  for jid in $(jq -r '.jobs | to_entries[] | select(.value.launched and (.value.obsolete|not) and (.value.state // "" | test("^(done|failed|stopped)$") | not)) | .key' <<< "${NODE_STATE:-"{\"jobs\":{}}"}"); do
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -n $tid && -f $TASKS/$tid/meta.env ]] || continue
    lines='[]'
    if [[ -f $TASKS/$tid/activity.jsonl ]]; then
      lines=$(tail -n 20 "$TASKS/$tid/activity.jsonl" | jq -sc '[.[] | ((.ts // "" | split(" ") | last) + " " + (.t // ""))]') \
        || lines='[]'   # a line being written may be cut: the next heartbeat sends it whole
    fi
    out=$(jq -c --arg id "$jid" --arg agent "$(task_field "$tid" AGENT)" --arg stage "$(task_field "$tid" STATUS)" \
      --argjson lines "$lines" '. + [{ID:$id, Agent:$agent, Stage:$stage, Lines:$lines}]' <<< "$out")
  done
  printf '%s' "$out"
}

# node_job_result task state — what a finished job reports: its final message, or the task's note when there is
# none (a CLI that did not start leaves no final message: "CLI exit code: 127")
node_job_result() {
  local tid=$1 state=$2
  [[ $state =~ ^(done|failed|stopped)$ ]] || return 0
  # a final message of blanks only (a failed run leaves one) is none: the run's note says what it ended on
  if [[ -f $TASKS/$tid/final.md && -n $(tr -d '[:space:]' < "$TASKS/$tid/final.md") ]]; then cat "$TASKS/$tid/final.md"; return 0; fi
  task_field "$tid" NOTE
}

# node_heartbeat_json advertises configured inventory and free capacity using ordinary admission rules.
node_heartbeat_json() {
  local a available_json='[]' configured_json='[]' caps='[]'
  for a in "${!AGENT_TYPE[@]}"; do
    is_investigator "$a" && continue
    configured_json=$(jq -c --arg name "$a" --arg type "${AGENT_TYPE[$a]}" --arg model "${AGENT_MODEL[$a]:-}" \
      --arg tier "$(agent_tier "$a")" '. + [{Name:$name,Type:$type,Model:$model,Tier:$tier}]' <<< "$configured_json")
    if ! agent_cli_present "$a"; then
      if [[ -z ${NODE_MISSING_CLI[$a]:-} ]]; then
        NODE_MISSING_CLI[$a]=1
        log_error node_agent_cli_missing "agent=$a" "type=${AGENT_TYPE[$a]}"
      fi
      continue
    fi
    if agent_running_task "$a" >/dev/null; then continue; fi # Exit 1 means the configured agent is free.
    available_json=$(jq -c --arg name "$a" --arg tier "$(agent_tier "$a")" '. + [{Name:$name,Tier:$tier}]' <<< "$available_json")
  done
  if ((${#INSTANCE_CAPABILITIES[@]})); then caps=$(printf '%s\n' "${INSTANCE_CAPABILITIES[@]}" | jq -R . | jq -s .); fi
  jq -cn --arg node "$INSTANCE_NAME" --argjson caps "$caps" --argjson free "$available_json" --arg web "$AGENT_WEB_URL" \
    --argjson agents "$configured_json" --argjson activity "$(node_activity_json)" '{Node:$node,Capabilities:$caps,Agents:($agents|sort_by(.Name)),FreeAgents:$free,WebURL:$web,Activity:$activity}'
}

# node_select_agent uses provider rotation for workers, otherwise the configured normal-agent order.
node_select_agent() {
  local selector=$1 a
  case $selector in
    worker) if free_worker; then return; else return 1; fi ;; # No free worker is an expected answer.
    normal)
      for a in "${NORMAL_AGENTS[@]}"; do
        [[ -n ${AGENT_TYPE[$a]:-} ]] || continue
        if ! agent_running_task "$a" >/dev/null; then printf '%s' "$a"; return; fi
      done ;;
    *)
      [[ -n ${AGENT_TYPE[$selector]:-} ]] || return 1
      is_investigator "$selector" && return 1
      if ! agent_running_task "$selector" >/dev/null; then printf '%s' "$selector"; return; fi ;;
  esac
  return 1
}

# node_time normalizes a timestamp and clamps it to the last observed instant after clock rollback.
node_time() {
  local base=${1:-} candidate=${2:-} now
  if [[ -n $candidate ]]; then now=$(date -u -d "$candidate" +%Y-%m-%dT%H:%M:%S.%NZ); else now=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ); fi
  if [[ -n $base ]]; then
    base=$(date -u -d "$base" +%Y-%m-%dT%H:%M:%S.%NZ)
    [[ $now < $base ]] && now=$base
  fi
  printf '%s' "$now"
}

# node_map_state maps local statuses to the job lifecycle; transient local states are not separate job states.
node_map_state() {
  case $1 in
    waiting) printf waiting ;;
    done) printf done ;;
    failed|hung|excluded) printf failed ;;
    stopped) printf stopped ;;
    new|starting|running|paused|investigating|sleeping|interrupted) printf running ;;
    *) die "unknown local task status: $1" ;;
  esac
}

# node_transition persists a cumulative report; result text is a bounded UTF-8 prefix of the final message.
node_transition() {
  local jid=$1 state=$2 observed=${3:-} result=${4:-} previous at entry
  entry=$(jq -c --arg id "$jid" '.jobs[$id]' <<< "$NODE_STATE")
  previous=$(jq -r '.report.At // .assigned_at // empty' <<< "$entry")
  at=$(node_time "$previous" "$observed")
  # jq's UTF-8 byte length accounts for multibyte text; task output is text, not a transferred file.
  result=$(jq -nr --arg text "$result" '$text | until(utf8bytelength <= 65536 and (tojson|utf8bytelength) <= 65536; .[0:(length / 2 | floor)])')
  NODE_STATE=$(jq -c --arg id "$jid" --arg state "$state" --arg at "$at" --arg result "$result" --arg node "$INSTANCE_NAME" '
    .jobs[$id] |= (. as $j | .report = {
      ID:$id,Node:$node,Assignment:.assignment,State:$state,TaskID:(.task_id // ""),Branch:(.branch // ""),Agent:(.agent // ""),
      PRURL:(.pr_url // ""),Result:$result,At:$at,
      Transitions:((.report.Transitions // []) + [{State:$state,At:$at}])
    } | .state=$state | .pending=true | if ($state == "done" or $state == "failed" or $state == "stopped") then .preparing=false else . end)' <<< "$NODE_STATE")
  node_save
}

# node_reconcile fences a rejected old assignment without treating a transport failure as an acknowledgement.
node_reconcile() {
  local jid=$1 view assignment state
  if ! view=$(node_request --get --path "/v1/jobs/$jid" < /dev/null); then return; fi
  assignment=$(jq -r --arg id "$jid" '.jobs[$id].assignment' <<< "$NODE_STATE")
  if ! jq -e --arg id "$jid" '.Request.ID == $id and (.State|type == "string")' <<< "$view" >/dev/null; then
    log_warn node_reply_invalid "job=$jid"; return
  fi
  state=$(jq -r '.State' <<< "$view")
  if [[ $(jq -r '.Assignment' <<< "$view") != "$assignment" || $(jq -r '.Node' <<< "$view") != "$INSTANCE_NAME" || $state =~ ^(done|failed|stopped|queued)$ ]]; then
    NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].obsolete=true | .jobs[$id].pending=false' <<< "$NODE_STATE")
    node_save
    local prepared_task
    prepared_task=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    if [[ -n $prepared_task && -f $TASKS/$prepared_task/meta.env ]] && [[ $(task_field "$prepared_task" RUN) == 0 ]]; then
      meta_set "$prepared_task" STATUS stopped
    fi
    log_warn node_assignment_obsolete "job=$jid" "state=$state"
  fi
}

# node_start_ack retries the exact persisted start snapshot and requires matching assignment/task evidence.
node_start_ack() {
  local jid=$1 report reply rc
  report=$(jq -c --arg id "$jid" '.jobs[$id].report' <<< "$NODE_STATE")
  if reply=$(printf '%s' "$report" | node_request --path "/v1/jobs/$jid/state"); then
    if jq -e --argjson report "$report" '.Request.ID == $report.ID and .Assignment == $report.Assignment and .State == "running" and .TaskID == $report.TaskID and .Branch == $report.Branch' <<< "$reply" >/dev/null; then
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].start_acked=true | .jobs[$id].pending=false' <<< "$NODE_STATE")
      node_save
    else log_warn node_reply_invalid "job=$jid"; fi
  else
    rc=$?
    log_warn node_start_report_failed "job=$jid" "exit=$rc"
    if ((rc == BUS_PERMISSION)); then node_reconcile "$jid"; fi
  fi
}

# node_process_pending_launches progresses prepared tasks independently of the heartbeat's assignment reply.
node_process_pending_launches() {
  local jid tid busy run status ids
  ids=$(jq -r '.jobs | keys[]' <<< "$NODE_STATE")
  for jid in $ids; do
    [[ -n $jid ]] || continue
    if jq -e --arg id "$jid" '.jobs[$id] | .obsolete or .launched or (.task_id == "")' <<< "$NODE_STATE" >/dev/null; then continue; fi
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id' <<< "$NODE_STATE")
    if [[ -f $TASKS/$tid/meta.env ]]; then
      run=$(task_field "$tid" RUN)
      status=$(task_field "$tid" STATUS)
      if [[ $status =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
        # A stop can arrive after acknowledgement while local capacity delays launch.
        NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
        node_save
        continue
      elif ((run == 0)) && [[ -f $TASKS/$tid/stop-requested || -f $TASKS/$tid/node-stop-requested ]]; then
        meta_set "$tid" STATUS stopped
        meta_set "$tid" FINISHED "$(date -Is)"
        NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
        node_save
        continue
      fi
    fi
    if [[ ! -f $TASKS/$tid/meta.env ]]; then
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
      node_transition "$jid" failed '' 'CheckoutFailed: prepared task or worktree is missing during recovery'
      continue
    fi
    run=$(task_field "$tid" RUN)
    if ((run > 0)); then
      # A live runner stays independent even if its checkout was removed after launch.
      status=$(task_field "$tid" STATUS)
      if [[ $status =~ ^(starting|new)$ ]] && ! unit_active "$tid" "$run"; then
        meta_set "$tid" STATUS failed
        meta_set "$tid" FINISHED "$(date -Is)"
      fi
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE"); node_save
      continue
    fi
    if [[ ! -d $(task_field "$tid" WORKTREE) ]]; then
      meta_set "$tid" STATUS failed
      meta_set "$tid" FINISHED "$(date -Is)"
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
      node_transition "$jid" failed '' 'CheckoutFailed: prepared task or worktree is missing during recovery'
      continue
    fi
    if ! jq -e --arg id "$jid" '.jobs[$id].start_acked' <<< "$NODE_STATE" >/dev/null; then node_start_ack "$jid"; fi
    if ! jq -e --arg id "$jid" '.jobs[$id] | .start_acked and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then continue; fi
    lock_task_ids
    if busy=$(agent_running_task "$(task_field "$tid" AGENT)"); then
      if [[ $busy != "$tid" ]]; then unlock_task_ids; continue; fi
    fi
    status=$(task_field "$tid" STATUS)
    if [[ $status =~ ^(done|failed|stopped|hung|excluded)$ ]] || [[ -f $TASKS/$tid/stop-requested || -f $TASKS/$tid/node-stop-requested ]] || jq -e --arg id "$jid" '.jobs[$id] | .obsolete or (.state == "stopped")' <<< "$NODE_STATE" >/dev/null; then
      if [[ ! $status =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
        meta_set "$tid" STATUS stopped
        meta_set "$tid" FINISHED "$(date -Is)"
      fi
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE")
      node_save
      unlock_task_ids
      continue
    fi
    if start_runner "$tid" new; then :; else log_error node_launch_failed "job=$jid" "task=$tid"; fi
    unlock_task_ids
    NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].launched=true' <<< "$NODE_STATE"); node_save
  done
}

# node_recover_tasks binds a preparation interrupted before its mapping save to its already tagged local task.
node_recover_tasks() {
  local jid tid assignment candidate found ids assigned run
  local -a matched partial started
  ids=$(jq -r '.jobs | keys[]' <<< "$NODE_STATE")
  for jid in $ids; do
    [[ -n $jid ]] || continue
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -z $tid ]] || continue
    if ! jq -e --arg id "$jid" '.jobs[$id].preparing and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then continue; fi
    assignment=$(jq -r --arg id "$jid" '.jobs[$id].assignment' <<< "$NODE_STATE")
    # Admission excludes a local resume while recovery classifies or removes unstarted checkouts.
    lock_task_ids
    found=''; matched=(); partial=(); started=()
    for candidate in "$TASKS"/*/; do
      [[ -f $candidate/meta.env ]] || continue
      candidate=${candidate%/}; candidate=${candidate##*/}
      [[ $(task_field "$candidate" JOB_ID) == "$jid" ]] || continue
      assigned=$(task_field "$candidate" JOB_ASSIGNMENT)
      run=$(task_field "$candidate" RUN)
      if [[ $assigned == "$assignment" ]]; then
        matched+=("$candidate")
        [[ $run == 0 ]] || started+=("$candidate")
      elif [[ -z $assigned && $run == 0 ]]; then
        partial+=("$candidate")
      fi
    done
    if ((${#started[@]} > 1)); then
      unlock_task_ids
      die "multiple started tasks match job $jid; inspect local tasks ${started[*]} before restarting the node"
    elif ((${#started[@]} == 1)); then
      found=${started[0]}
    elif ((${#matched[@]} == 1)); then
      found=${matched[0]}
    elif ((${#matched[@]} == 0 && ${#partial[@]} == 1)); then
      found=${partial[0]}
    fi
    # Other assignments were excluded above; every removable candidate has RUN=0.
    for candidate in "${matched[@]}" "${partial[@]}"; do
      [[ $candidate == "$found" ]] || discard_task "$candidate"
    done
    if [[ -n $found ]]; then
      if [[ -z $(task_field "$found" JOB_ASSIGNMENT) ]]; then meta_set "$found" JOB_ASSIGNMENT "$assignment"; fi
      if [[ -n ${LEAD_URL:-} && -z $(task_field "$found" JOB_LEAD) ]]; then meta_set "$found" JOB_LEAD "$LEAD_URL"; fi
      node_bind_task "$jid" "$found"
    else
      node_transition "$jid" failed '' 'CheckoutFailed: prepared task is missing or ambiguous during recovery'
    fi
    unlock_task_ids
  done
}

# node_bind_task persists a prepared checkout and its exact first running transition before asking permission to launch.
node_bind_task() {
  local jid=$1 tid=$2
  NODE_STATE=$(jq -c --arg id "$jid" --arg tid "$tid" --arg branch "$(task_field "$tid" BRANCH)" \
    '.jobs[$id].task_id=$tid | .jobs[$id].branch=$branch | .jobs[$id].preparing=false' <<< "$NODE_STATE")
  node_transition "$jid" running
}

# node_scan_tasks consumes the job-only transition journal under the same lock as task metadata writes.
node_scan_tasks() {
  local jid tid journal cursor total record state result current previous ids
  ids=$(jq -r '.jobs | keys[]' <<< "$NODE_STATE")
  for jid in $ids; do
    [[ -n $jid ]] || continue
    tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -n $tid && -f $TASKS/$tid/meta.env ]] || continue
    if ! jq -e --arg id "$jid" '.jobs[$id].launched and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then continue; fi
    journal='[]'
    if [[ -f $TASKS/$tid/job_transitions.jsonl ]]; then
      journal=$({ flock -s 9 && jq -sc . "$TASKS/$tid/job_transitions.jsonl"; } 9>"$TASKS/$tid/meta.env.lock") || die "cannot read job transitions for $tid"
    fi
    cursor=$(jq -r --arg id "$jid" '.jobs[$id].cursor // 0' <<< "$NODE_STATE")
    total=$(jq length <<< "$journal")
    while ((cursor < total)); do
      record=$(jq -c --argjson n "$cursor" '.[$n]' <<< "$journal")
      state=$(node_map_state "$(jq -r .state <<< "$record")")
      previous=$(jq -r --arg id "$jid" '.jobs[$id].state' <<< "$NODE_STATE")
      cursor=$((cursor+1))
      NODE_STATE=$(jq -c --arg id "$jid" --argjson cursor "$cursor" '.jobs[$id].cursor=$cursor' <<< "$NODE_STATE")
      if [[ ! $previous =~ ^(done|failed|stopped)$ ]]; then
        result=$(node_job_result "$tid" "$state")
        if [[ $state != "$previous" || $state == waiting ]]; then node_transition "$jid" "$state" "$(jq -r .at <<< "$record")" "$result"; fi
      fi
      node_save
    done
    # A crash after metadata replacement but before journal append still exposes the latest local state.
    current=$(node_map_state "$(task_field "$tid" STATUS)")
    previous=$(jq -r --arg id "$jid" '.jobs[$id].state' <<< "$NODE_STATE")
    if [[ $current != "$previous" && ! $previous =~ ^(done|failed|stopped)$ ]]; then
      result=$(node_job_result "$tid" "$current")
      node_transition "$jid" "$current" '' "$result"
    fi
  done
}

# node_flush_reports sends one latest snapshot per job with byte-bounded heartbeats, preserving it until acknowledgement.
node_flush_reports() {
  local jid declaration report payload reply rc ids
  declaration=$(node_heartbeat_json)
  # Start snapshots are acknowledged separately before launch; only launched/failed preparations use heartbeat reports.
  ids=$(jq -r '.jobs | to_entries[] | select(.value.pending and (.value.obsolete|not) and (.value.launched or .value.task_id == "")) | .key' <<< "$NODE_STATE")
  for jid in $ids; do
    report=$(jq -c --arg id "$jid" '.jobs[$id].report' <<< "$NODE_STATE")
    payload=$(jq -c --argjson report "$report" '.Reports=[$report]' <<< "$declaration")
    # Truncate only when constructing a transition, never after an attempted send: retries stay identical.
    if (($(printf '%s' "$payload" | wc -c) > 262144)); then die "job transition history exceeds heartbeat limit"; fi
    if reply=$(printf '%s' "$payload" | node_request --path /v1/heartbeat); then
      if ! jq -e 'has("Job") and (.Stops|type == "array")' <<< "$reply" >/dev/null; then log_warn node_reply_invalid "job=$jid"; continue; fi
      NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].pending=false' <<< "$NODE_STATE"); node_save
      node_handle_reply "$reply"
    else
      rc=$?; log_warn node_report_failed "job=$jid" "exit=$rc"
      if ((rc == BUS_PERMISSION)); then node_reconcile "$jid"; fi
    fi
  done
}

# node_handle_stop requires a successful local stop and keeps the actual result if completion won the race.
node_handle_stop() {
  local jid=$1 assignment=$2 tid state run detail
  if ! jq -e --arg id "$jid" --argjson assignment "$assignment" '.jobs[$id] | .assignment == $assignment and (.obsolete|not)' <<< "$NODE_STATE" >/dev/null; then return; fi
  tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
  [[ -n $tid ]] || return 0
  state=$(task_field "$tid" STATUS)
  [[ ! $state =~ ^(done|failed|stopped|hung|excluded)$ ]] || return 0
  run=$(task_field "$tid" RUN)
  if ((run > 0)) && unit_active "$tid" "$run"; then   # a paused or sleeping task has no unit to stop
    touch "$TASKS/$tid/node-stop-requested"
    if ! detail=$(systemctl --user stop "$(unit_name "$tid" "$run").service" 2>&1); then
      rm -f "$TASKS/$tid/node-stop-requested"
      log_warn node_stop_failed "job=$jid" "error=$detail"; return
    fi
    if unit_active "$tid" "$run"; then
      rm -f "$TASKS/$tid/node-stop-requested"
      log_warn node_stop_failed "job=$jid" "error=unit remains active"; return
    fi
  fi
  state=$(task_field "$tid" STATUS)
  if [[ ! $state =~ ^(done|failed|stopped|hung|excluded)$ ]]; then
    touch "$TASKS/$tid/stop-requested"
    meta_set "$tid" STATUS stopped
  fi
  node_scan_tasks
}

# node_handle_reply validates and handles only assignments and stop requests from this heartbeat.
node_handle_reply() {
  local reply=$1 stop job jid assignment existing agent at ids
  ids=$(jq -r '.Stops[].Request.ID' <<< "$reply")
  for stop in $ids; do
    node_handle_stop "$stop" "$(jq -r --arg id "$stop" '.Stops[] | select(.Request.ID == $id) | .Assignment' <<< "$reply")"
  done
  local wjid wtid   # wakes for this node's remote team members: each in its own process (_wake takes the task's lock)
  for wjid in $(jq -r '.Wakes // [] | .[]' <<< "$reply"); do
    wtid=$(jq -r --arg id "$wjid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    if [[ -n $wtid ]]; then "$SELF" _wake "$wtid" || log_warn node_wake_failed "job=$wjid" "task=$wtid"; fi
  done
  # paused members the lead's human resumes now (agent wake on its proxy task): each that is still paused
  for wjid in $(jq -r '.WakesNow // [] | .[]' <<< "$reply"); do
    wtid=$(jq -r --arg id "$wjid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
    [[ -n $wtid && $(task_field "$wtid" STATUS) == paused ]] || continue
    "$SELF" wake "$wtid" > /dev/null || log_warn node_wake_now_failed "job=$wjid" "task=$wtid"
  done
  job=$(jq -c .Job <<< "$reply")
  [[ $job != null ]] || return 0
  jid=$(jq -r .Request.ID <<< "$job"); assignment=$(jq -r .Assignment <<< "$job")
  jq -e '.Request.ID | test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")' <<< "$job" >/dev/null || die "invalid assignment ID"
  [[ $assignment =~ ^[1-9][0-9]*$ ]] || die "invalid assignment evidence"
  existing=$(jq -r --arg id "$jid" '.jobs[$id].assignment // 0' <<< "$NODE_STATE")
  [[ $existing != "$assignment" ]] || return 0
  at=$(jq -r '.History[-1].At // empty' <<< "$job")
  if agent=$(node_select_agent "$(jq -r .Request.Selector <<< "$job")"); then :; else agent=''; fi
  # Stream the request: escaped task text can exceed Linux's per-argument limit.
  NODE_STATE=$(printf '%s\n' "$job" "$NODE_STATE" | jq -cs --arg id "$jid" --argjson assignment "$assignment" --arg agent "$agent" --arg at "$at" \
    '.[1].jobs[$id]={assignment:$assignment,request:.[0].Request,agent:$agent,assigned_at:$at,task_id:"",branch:"",launched:false,start_acked:false,obsolete:false,pending:false,preparing:true,cursor:0} | .[1]'); node_save
  if [[ -z $agent ]]; then node_transition "$jid" failed '' 'no free local agent for assignment'; return; fi
  NODE_PREPARE_ERROR=''
  if prepare_job_task "$jid" "$agent" "$(jq -r .Request.Repository <<< "$job")" "$(jq -r .Request.BaseRef <<< "$job")" "$(jq -r '.Request.BaseSHA // ""' <<< "$job")" "$(jq -r .Request.Task <<< "$job")" "$assignment" "$(jq -r '.Request.Team // ""' <<< "$job")" "$(jq -r '.Request.Member // ""' <<< "$job")"; then
    node_bind_task "$jid" "$NEW_ID"
  else
    NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].preparing=false' <<< "$NODE_STATE")
    node_transition "$jid" failed '' "${NODE_PREPARE_ERROR:-node task preparation failed}"
  fi
}

# node_poll_remote_helpers submits queued remote helpers and polls terminal results.
node_poll_remote_helpers() {
  local caps='[]' list rows helper hid job_id req_json reply state node branch result pr rc diag
  if ((${#INSTANCE_CAPABILITIES[@]})); then caps=$(printf '%s\n' "${INSTANCE_CAPABILITIES[@]}" | jq -R . | jq -s .); fi
  if ! list=$(bus helper-remote-list --dir "$BUS_DIR" --capabilities "$caps"); then
    log_warn node_remote_helpers_list_failed
    return 0
  fi
  [[ -n $list && $list != "[]" ]] || return 0
  if ! rows=$(jq -c '.[]' <<< "$list"); then
    log_warn node_remote_helpers_parse_failed
    return 0
  fi

  while read -r helper; do
    [[ -n $helper ]] || continue
    hid=$(jq -r '.id' <<< "$helper")
    job_id=$(jq -r '.remote_job.ID // empty' <<< "$helper")
    local hstatus
    hstatus=$(jq -r '.status // empty' <<< "$helper")

    if [[ -z $job_id ]]; then
      rc=0
      req_json=$(bus helper-remote-prepare --dir "$BUS_DIR" --id "$hid" --instance "${INSTANCE_NAME:-node}" \
        --repo-url "$(github_repo_url "$(jq -r .worktree <<< "$helper")")" 2>&1) || rc=$?
      if ((rc != 0)); then
        if ((rc == BUS_STORAGE)); then
          log_warn node_helper_prepare_storage_failed "helper=$hid" "exit=$rc"
        else
          log_warn node_helper_prepare_failed "helper=$hid" "exit=$rc" "detail=$req_json"
          diag=${req_json:-remote preparation failed}
          try helper_finish_failed bus helper-remote-finish --dir "$BUS_DIR" --id "$hid" --state failed --node "" --branch "" --result "$diag"
        fi
        continue
      fi
      job_id=$(jq -r '.ID' <<< "$req_json")
    else
      req_json=$(jq -c '.remote_job' <<< "$helper")
    fi

    # Compare complete JSON documents via stdin so escaped maximum-size tasks fit.
    if [[ $hstatus == "queued" ]]; then
      if reply=$(printf '%s' "$req_json" | node_request --path /v1/jobs); then
        if ! printf '%s\n' "$req_json" "$reply" | jq -es 'length == 2 and .[1].Request == .[0] and (.[1].State|type == "string")' >/dev/null; then
          log_warn node_helper_reply_invalid "helper=$hid" "job=$job_id"
          continue
        fi
        log_info node_helper_submitted "helper=$hid" "job=$job_id"
        try helper_state_failed bus helper-set --dir "$BUS_DIR" --id "$hid" --status running
      else
        rc=$?
        log_warn node_helper_submit_failed "helper=$hid" "job=$job_id" "exit=$rc"
        continue
      fi
    fi

    if reply=$(node_request --get --path "/v1/jobs/$job_id" < /dev/null); then
      if ! printf '%s\n' "$req_json" "$reply" | jq -es 'length == 2 and .[1].Request == .[0] and (.[1].State|type == "string")' >/dev/null; then
        log_warn node_helper_reply_invalid "helper=$hid" "job=$job_id"
        continue
      fi
      state=$(jq -r '.State' <<< "$reply")
      case "$state" in
        done|failed|stopped)
          node=$(jq -r '.Node // ""' <<< "$reply")
          branch=$(jq -r '.Branch // ""' <<< "$reply")
          result=$(jq -r '.Result // ""' <<< "$reply")
          pr=$(jq -r '.PRURL // ""' <<< "$reply")
          local finish_args=(helper-remote-finish --dir "$BUS_DIR" --id "$hid" --state "$state" --node "$node" --branch "$branch" --result "$result")
          [[ -z $pr ]] || finish_args+=(--pr "$pr")
          try helper_finish_failed bus "${finish_args[@]}"
          ;;
      esac
    else
      rc=$?
      log_warn node_helper_get_failed "helper=$hid" "job=$job_id" "exit=$rc"
    fi
  done <<< "$rows"
}

# Maximum wire payload size for POST /v1/sync in bytes (2 MiB).
NODE_SYNC_MAX_PAYLOAD_BYTES=2097152

# Soft budget threshold for batching files and logs in a single sync request (1,500,000 bytes).
NODE_SYNC_BATCH_BUDGET_BYTES=1500000

# Maximum file size sent in POST /v1/sync before tail truncation (256 KiB).
NODE_SYNC_MAX_FILE_BYTES=262144

# Maximum line count for activity.jsonl in POST /v1/sync.
NODE_SYNC_MAX_ACTIVITY_LINES=2000

# Maximum line count for err-*.log in POST /v1/sync.
NODE_SYNC_MAX_ERR_LOG_LINES=500

# Maximum log entries per sync request.
NODE_SYNC_MAX_LOG_ENTRIES=500

# Maximum single log entry size in bytes (64 KiB).
NODE_SYNC_MAX_LOG_ENTRY_BYTES=65536

# node_sync_save_json atomically writes JSON content to target path, optionally stamping mtime with ref_ts.
# It logs on failure without terminating node.
node_sync_save_json() {
  local target=$1 content=$2 ref_ts=${3:-}
  local tmpf
  # Suppress duplicate stderr diagnostics: the structured warning below reports a retryable save failure.
  # A sibling temporary file keeps replacement atomic even when the task directory is on another filesystem.
  if tmpf=$(mktemp "${target}.tmp.XXXXXX" 2>/dev/null); then
    if printf '%s\n' "$content" > "$tmpf" 2>/dev/null && \
       { [[ -z $ref_ts ]] || touch -d "$ref_ts" "$tmpf" 2>/dev/null; } && \
       mv -fT "$tmpf" "$target" 2>/dev/null; then
      return 0
    fi
    try node_sync_cleanup_failed rm -f "$tmpf"
  fi
  log_warn node_sync_save_failed "target=$target"
  return 0
}

# node_read_meta returns JSON object of allowed display metadata fields for a task.
node_read_meta() {
  local tid=$1 jid=$2
  local task_dir="$TASKS/$tid"
  local meta_f="$task_dir/meta.env"
  [[ -f $meta_f ]] || return 1
  (
    local run_start=""
    if [[ -f $task_dir/runner.pid ]]; then
      local errf rc=0
      if errf=$(mktemp); then
        run_start=$(date -Is -r "$task_dir/runner.pid" 2>"$errf") || rc=$?
        if ((rc != 0)); then
          # A finished runner can remove runner.pid between the existence check and stat.
          if [[ -e $task_dir/runner.pid ]]; then
            log_warn node_sync_run_start_failed "task=$tid" "exit=$rc"
          fi
          run_start=""
        fi
        rm -f "$errf"
      else
        log_warn node_sync_run_start_failed "task=$tid" "stage=temporary_file"
      fi
    fi
    local STATUS="" RUN="" AGENT="" TYPE="" MODEL="" NOTE="" PAUSE_REASON="" WAKE_AT="" CREATED="" FINISHED="" JOB_ID="" RESTARTS=""
    # shellcheck source=/dev/null
    source "$meta_f"
    local job_id=${JOB_ID:-$jid}
    jq -n \
      --arg STATUS "${STATUS:-}" \
      --arg RUN "${RUN:-}" \
      --arg AGENT "${AGENT:-}" \
      --arg TYPE "${TYPE:-}" \
      --arg MODEL "${MODEL:-}" \
      --arg NOTE "${NOTE:-}" \
      --arg PAUSE_REASON "${PAUSE_REASON:-}" \
      --arg WAKE_AT "${WAKE_AT:-}" \
      --arg CREATED "${CREATED:-}" \
      --arg FINISHED "${FINISHED:-}" \
      --arg RUN_START "$run_start" \
      --arg JOB_ID "$job_id" \
      --arg RESTARTS "${RESTARTS:-0}" \
      '{
        STATUS: $STATUS,
        RUN: $RUN,
        AGENT: $AGENT,
        TYPE: $TYPE,
        MODEL: $MODEL,
        NOTE: $NOTE,
        PAUSE_REASON: $PAUSE_REASON,
        WAKE_AT: $WAKE_AT,
        CREATED: $CREATED,
        FINISHED: $FINISHED,
        RUN_START: $RUN_START,
        JOB_ID: $JOB_ID,
        RESTARTS: $RESTARTS
      } | with_entries(select(.value != ""))'
  )
}

# node_mark_job_obsolete marks a job whose assignment or existence the lead rejected as obsolete.
node_mark_job_obsolete() {
  local jid=$1 rc=${2:-0}
  NODE_STATE=$(jq -c --arg id "$jid" '.jobs[$id].obsolete=true | .jobs[$id].pending=false' <<< "$NODE_STATE")
  node_sync_save_json "$(node_jobs_file)" "$NODE_STATE"
  local prepared_task
  prepared_task=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
  if [[ -n $prepared_task && -f $TASKS/$prepared_task/meta.env ]] && [[ $(task_field "$prepared_task" RUN) == 0 ]]; then
    meta_set "$prepared_task" STATUS stopped
  fi
  log_warn node_assignment_obsolete "job=$jid" "exit=$rc"
}

# node_sync_terminal_unchanged checks a complete terminal snapshot without reading task artifacts.
node_sync_terminal_unchanged() {
  local task_dir=$1 manifest_file="$1/sync_manifest.json" newer
  [[ -f $manifest_file ]] || return 1
  if [[ $(jq_soft node_sync_manifest_invalid -r '.complete == true and (.metadata.STATUS | IN("done", "failed", "stopped", "hung", "excluded"))' "$manifest_file") != true ]]; then
    return 1
  fi
  if newer=$(find "$task_dir" -mindepth 1 -maxdepth 1 -type f ! -name '*.lock' ! -name 'sync_manifest.json*' -newer "$manifest_file" -print -quit); then
    [[ -z $newer ]]
  else
    log_warn node_sync_scan_failed "task=${task_dir##*/}"
    return 1
  fi
}

# node_sync_has_new_logs checks whether any local log file has unread lines beyond the saved sync cursor.
node_sync_has_new_logs() {
  local log_cursor_file="$BUS_DIR/sync_log_cursors.json"
  local cursors='{}'
  if [[ -f $log_cursor_file ]]; then
    cursors=$(jq_soft node_sync_cursor_invalid -c . "$log_cursor_file")
    [[ -n $cursors ]] || cursors='{}'
  fi
  local f log_p total_l cur
  for f in agent.jsonl agentbus.jsonl agentlive.jsonl; do
    log_p="$LOG_DIR/$f"
    [[ -f $log_p ]] || continue
    total_l=$(wc -l < "$log_p")
    cur=$(jq -r --arg f "$f" '.[$f] // 0' <<< "$cursors")
    [[ $cur =~ ^[0-9]+$ ]] || cur=0
    if (( total_l != cur )); then
      return 0
    fi
  done
  return 1
}

# node_send_sync sends one POST /v1/sync request payload bounded at 2 MiB.
node_send_sync() {
  local jid=$1 tid=$2 assignment=$3 meta_json=$4 files_json=$5 logs_json=$6
  local payload
  payload=$(jq -nc \
    --arg job "$jid" \
    --argjson assignment "$assignment" \
    --arg task "$tid" \
    --argjson meta "$meta_json" \
    '{
      Job: $job,
      Assignment: $assignment,
      TaskID: $task,
      Metadata: $meta
    }')

  payload=$(printf '%s\n%s\n%s\n' "$payload" "$files_json" "$logs_json" | jq -s \
    '.[0] + {Files: .[1], Logs: .[2]}')

  local byte_len
  byte_len=$(printf '%s' "$payload" | wc -c)
  if (( byte_len > NODE_SYNC_MAX_PAYLOAD_BYTES )); then
    log_warn node_sync_payload_oversized "job=$jid" "task=$tid" "bytes=$byte_len"
    return 1
  fi

  local reply rc=0
  if reply=$(printf '%s' "$payload" | node_request --path /v1/sync); then
    if ! jq -e 'has("OK") or has("Accepted") or (type == "object")' <<< "$reply" >/dev/null; then
      log_warn node_sync_invalid_reply "job=$jid" "task=$tid"
      return 1
    fi
    log_info node_sync_accepted "job=$jid" "target_task=$tid"
    return 0
  else
    rc=$?
    log_warn node_sync_failed "job=$jid" "task=$tid" "exit=$rc"
    return "$rc"
  fi
}

# node_sync_task sends incremental metadata, files and logs for one assigned job task.
node_sync_task() {
  local jid=$1 tid=$2 assignment=$3
  local task_dir="$TASKS/$tid"
  local manifest_file="$task_dir/sync_manifest.json"
  local prev_manifest='{"metadata":{},"files":{}}'
  local is_terminal_unchanged=false
  # A cleaned task still needs log-only delivery or reconciliation of its retained job.
  [[ -d $task_dir && -f $task_dir/meta.env ]] || is_terminal_unchanged=true
  if [[ -f $manifest_file ]]; then
    prev_manifest=$(jq_soft node_sync_manifest_invalid -c . "$manifest_file")
    [[ -n $prev_manifest ]] || prev_manifest='{"metadata":{},"files":{}}'
    if node_sync_terminal_unchanged "$task_dir"; then
      is_terminal_unchanged=true
    fi
  fi

  local current_meta='{}' prev_meta='{}' meta_diff='{}'
  local changed_files='[]' new_manifest_files='{}'
  local f fname cut byte_len sha256 prev_sha prev_cut base_num tmp_f tmp_cut file_obj total_l
  local content_raw decoded_len source_bytes
  local artifacts_complete=true

  prev_meta=$(jq -c '.metadata // {}' <<< "$prev_manifest")

  local snapshot_ts="" tmp_b epoch
  if [[ $is_terminal_unchanged == "true" ]]; then
    current_meta="$prev_meta"
    new_manifest_files=$(jq -c '.files // {}' <<< "$prev_manifest")
  else
    # Capture inode timestamp from sibling reference file before reading metadata or artifacts.
    # A conservative 1-second margin avoids missing same-tick writes under strict find -newer comparison.
    if tmp_b=$(mktemp "${manifest_file}.ref.XXXXXX" 2>/dev/null); then
      if epoch=$(date +%s -r "$tmp_b" 2>/dev/null); then
        snapshot_ts="@$((epoch - 1))"
      fi
      try node_sync_cleanup_failed rm -f "$tmp_b"
    fi
    if [[ -z $snapshot_ts ]]; then
      log_warn node_sync_artifact_failed "task=$tid" "stage=boundary"
      return 0
    fi
    current_meta=$(node_read_meta "$tid" "$jid") || return 0
    meta_diff=$(jq -nc --argjson cur "$current_meta" --argjson prev "$prev_meta" '
      (($cur | to_entries | map(select($prev[.key] != .value))) +
       ($prev | keys | map(select($cur[.] == null) | {key: ., value: ""}))) | from_entries
    ')

    for f in "$task_dir"/*; do
      [[ -f $f ]] || continue
      fname=$(basename "$f")
      case "$fname" in
        activity.jsonl|final.md|result.md) ;;
        prompt-[1-9]*.md|questions-[1-9]*.md|err-[1-9]*.log)
          base_num=${fname#*-}
          base_num=${base_num%.*}
          [[ $base_num =~ ^[1-9][0-9]*$ ]] || continue
          ;;
        *) continue ;;
      esac

      cut=false
      if ! source_bytes=$(wc -c < "$f"); then
        log_warn node_sync_artifact_failed "task=$tid" "file=$fname" "stage=size"
        artifacts_complete=false
        continue
      fi
      if ! tmp_f=$(mktemp "$BUS_DIR/sync_file.XXXXXX"); then
        log_warn node_sync_artifact_failed "task=$tid" "file=$fname" "stage=temporary_file"
        return 0
      fi
      # tail counts a partial final line; always applying it avoids wc -l's newline-only count.
      # Cap the stream before writing temporary data, then discard a split leading UTF-8 sequence.
      if {
        case $fname in
          activity.jsonl)
            tail -n "$NODE_SYNC_MAX_ACTIVITY_LINES" "$f" | tail -c "$NODE_SYNC_MAX_FILE_BYTES" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_f"
            ;;
          err-*.log)
            tail -n "$NODE_SYNC_MAX_ERR_LOG_LINES" "$f" | tail -c "$NODE_SYNC_MAX_FILE_BYTES" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_f"
            ;;
          *) tail -c "$NODE_SYNC_MAX_FILE_BYTES" "$f" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_f" ;;
        esac
      }; then
        byte_len=$(wc -c < "$tmp_f")
        if (( byte_len != source_bytes )); then cut=true; fi
      else
        log_warn node_sync_artifact_failed "task=$tid" "file=$fname" "stage=read"
        artifacts_complete=false
        try node_sync_cleanup_failed rm -f "$tmp_f"
        continue
      fi

      content_raw=$(jq -Rs . < "$tmp_f")
      decoded_len=$(printf '%s' "$content_raw" | jq -rj . | wc -c)
      if (( decoded_len > NODE_SYNC_MAX_FILE_BYTES )); then
        cut=true
        tmp_cut=$(mktemp "$BUS_DIR/sync_file.XXXXXX")
        printf '%s' "$content_raw" | jq -rj . | tail -c "$NODE_SYNC_MAX_FILE_BYTES" | LC_ALL=C sed -e '1s/^[\x80-\xbf]*//' > "$tmp_cut"
        mv "$tmp_cut" "$tmp_f"
        content_raw=$(jq -Rs . < "$tmp_f")
      fi

      if [[ $(wc -c < "$tmp_f") -ne $(printf '%s' "$content_raw" | jq -rj . | wc -c) ]]; then
        cut=true
      fi

      sha256=$(printf '%s' "$content_raw" | jq -rj . | sha256sum | awk '{print $1}')
      new_manifest_files=$(jq -c --arg name "$fname" --arg sha "$sha256" --argjson cut "$cut" \
        '. + {($name): {sha: $sha, cut: $cut}}' <<< "$new_manifest_files")

      prev_sha=$(jq -r --arg name "$fname" '.files[$name].sha // .files[$name] // empty' <<< "$prev_manifest")
      prev_cut=$(jq -r --arg name "$fname" '.files[$name].cut // false' <<< "$prev_manifest")
      if [[ $sha256 != "$prev_sha" || "$cut" != "$prev_cut" ]]; then
        file_obj=$(printf '%s' "$content_raw" | jq -c --arg name "$fname" --arg sha "$sha256" --argjson cut "$cut" \
          '{Name: $name, Content: ., SHA256: $sha, Cut: $cut}')
        changed_files=$(printf '%s\n%s\n' "$changed_files" "$file_obj" | jq -s '.[0] + [.[1]]')
      fi
      rm -f "$tmp_f"
    done
  fi

  local log_cursor_file="$BUS_DIR/sync_log_cursors.json"
  local cursors='{}'
  if [[ -f $log_cursor_file ]]; then
    cursors=$(jq_soft node_sync_cursor_invalid -c . "$log_cursor_file")
    [[ -n $cursors ]] || cursors='{}'
  fi

  local all_tids_json
  all_tids_json=$(jq_soft node_sync_jobs_invalid -c '[.jobs | to_entries[] | select((.value.obsolete|not) and .value.task_id) | .value.task_id]' <<< "$NODE_STATE")
  [[ -n $all_tids_json ]] || all_tids_json='[]'

  local logs_payload='[]'
  local new_cursors="$cursors"
  local log_bytes=0 log_count=0
  local log_p cur line entry entry_len
  for f in agent.jsonl agentbus.jsonl agentlive.jsonl; do
    log_p="$LOG_DIR/$f"
    [[ -f $log_p ]] || continue
    total_l=$(wc -l < "$log_p")
    cur=$(jq -r --arg f "$f" '.[$f] // 0' <<< "$cursors")
    [[ $cur =~ ^[0-9]+$ ]] || cur=0
    if (( total_l < cur )); then
      cur=0
    fi
    if (( total_l > cur )); then
      while IFS= read -r line; do
        cur=$((cur + 1))
        [[ -n $line ]] || continue
        entry=$(jq_soft node_sync_log_malformed -c --argjson tids "$all_tids_json" 'select(type == "object" and ((.level == "warn" or .level == "error") or (.task as $t | ($t != null and (any($tids[]; . == $t))))))' <<< "$line")
        if [[ -n $entry ]]; then
          entry_len=$(printf '%s' "$entry" | wc -c)
          if (( entry_len > NODE_SYNC_MAX_LOG_ENTRY_BYTES )); then
            log_warn node_sync_log_oversized "log=$f" "task=$tid"
            continue
          fi
          if (( log_bytes + entry_len > NODE_SYNC_BATCH_BUDGET_BYTES || log_count >= NODE_SYNC_MAX_LOG_ENTRIES )); then
            cur=$((cur - 1))
            break
          fi
          logs_payload=$(printf '%s\n%s\n' "$logs_payload" "$entry" | jq -s '.[0] + [.[1]]')
          log_bytes=$((log_bytes + entry_len))
          log_count=$((log_count + 1))
        fi
      done < <(tail -n +"$((cur + 1))" "$log_p")
      new_cursors=$(jq -c --arg f "$f" --argjson c "$cur" '. + {($f): $c}' <<< "$new_cursors")
      if (( log_count >= NODE_SYNC_MAX_LOG_ENTRIES || log_bytes > NODE_SYNC_BATCH_BUDGET_BYTES )); then
        break
      fi
    fi
  done

  if (( log_count == 0 )) && [[ $new_cursors != "$cursors" ]]; then
    node_sync_save_json "$log_cursor_file" "$new_cursors"
  fi

  local accepted_manifest_files
  accepted_manifest_files=$(jq -c '.files // {}' <<< "$prev_manifest")
  local current_manifest_meta
  current_manifest_meta="$prev_meta"

  local meta_diff_count changed_files_count
  meta_diff_count=$(jq 'length' <<< "$meta_diff")
  changed_files_count=$(jq 'length' <<< "$changed_files")

  if (( meta_diff_count == 0 && changed_files_count == 0 && log_count == 0 )); then
    # A clean comparison upgrades old manifests even when no upload is necessary.
    if [[ $is_terminal_unchanged != true ]]; then
      local complete_manifest
      complete_manifest=$(jq -nc --argjson metadata "$current_meta" --argjson files "$accepted_manifest_files" \
        --argjson complete "$artifacts_complete" '{metadata: $metadata, files: $files, complete: $complete}')
      node_sync_save_json "$manifest_file" "$complete_manifest" "$snapshot_ts"
    fi
    return 0
  fi

  local meta_len logs_len
  meta_len=$(printf '%s' "$meta_diff" | wc -c)
  logs_len=$(printf '%s' "$logs_payload" | wc -c)

  local req_files='[]' req_bytes=$(( meta_len + logs_len ))
  local sync_meta="$meta_diff"
  local sync_logs="$logs_payload"
  local num_files i f_obj f_bytes
  num_files=$(jq 'length' <<< "$changed_files")

  if (( num_files == 0 )); then
    if node_send_sync "$jid" "$tid" "$assignment" "$sync_meta" "[]" "$sync_logs"; then
      # Log-only delivery must not hide artifact changes made after the eligibility check.
      if [[ $is_terminal_unchanged != true ]]; then
        local final_manifest
        final_manifest=$(printf '%s\n%s\n' "$current_meta" "$accepted_manifest_files" | jq -s --argjson complete "$artifacts_complete" \
          '{metadata: .[0], files: .[1], complete: $complete}')
        node_sync_save_json "$manifest_file" "$final_manifest" "$snapshot_ts"
      fi
      if (( log_count > 0 )) || [[ $new_cursors != "$cursors" ]]; then
        node_sync_save_json "$log_cursor_file" "$new_cursors"
      fi
      return 0
    else
      local rc=$?
      if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
        node_mark_job_obsolete "$jid" "$rc"
      fi
      return "$rc"
    fi
  fi

  for (( i=0; i<num_files; i++ )); do
    f_obj=$(jq -c --argjson idx "$i" '.[$idx]' <<< "$changed_files")
    f_bytes=$(printf '%s' "$f_obj" | wc -c)

    # If adding this file would exceed budget and we already have items to send, flush current request
    if (( req_bytes + f_bytes > NODE_SYNC_BATCH_BUDGET_BYTES && ($(jq 'length' <<< "$req_files") > 0 || meta_diff_count > 0 || log_count > 0) )); then
      if node_send_sync "$jid" "$tid" "$assignment" "$sync_meta" "$req_files" "$sync_logs"; then
        current_manifest_meta="$current_meta"
        # Update accepted files from req_files
        local sent_f s_name s_sha s_cut j num_sent
        num_sent=$(jq 'length' <<< "$req_files")
        for (( j=0; j<num_sent; j++ )); do
          sent_f=$(jq -c --argjson idx "$j" '.[$idx]' <<< "$req_files")
          s_name=$(jq -r '.Name' <<< "$sent_f")
          s_sha=$(jq -r '.SHA256' <<< "$sent_f")
          s_cut=$(jq -r '.Cut' <<< "$sent_f")
          accepted_manifest_files=$(jq -c --arg n "$s_name" --arg s "$s_sha" --argjson c "$s_cut" \
            '. + {($n): {sha: $s, cut: $c}}' <<< "$accepted_manifest_files")
        done
        local partial_manifest
        partial_manifest=$(printf '%s\n%s\n' "$current_manifest_meta" "$accepted_manifest_files" | jq -s \
          '{metadata: .[0], files: .[1], complete: false}')
        node_sync_save_json "$manifest_file" "$partial_manifest" "$snapshot_ts"
        if (( log_count > 0 )); then
          node_sync_save_json "$log_cursor_file" "$new_cursors"
          log_count=0
        fi
        sync_meta='{}'
        sync_logs='[]'
        meta_diff_count=0
        req_files='[]'
        req_bytes=0
      else
        local rc=$?
        if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
          node_mark_job_obsolete "$jid" "$rc"
        fi
        return "$rc"
      fi
    fi

    req_files=$(printf '%s\n%s\n' "$req_files" "$f_obj" | jq -s '.[0] + [.[1]]')
    req_bytes=$(( req_bytes + f_bytes ))
  done

  # Flush final chunk if any items remain
  if (( $(jq 'length' <<< "$req_files") > 0 || meta_diff_count > 0 || log_count > 0 )); then
    if node_send_sync "$jid" "$tid" "$assignment" "$sync_meta" "$req_files" "$sync_logs"; then
      current_manifest_meta="$current_meta"
      local sent_f s_name s_sha s_cut j num_sent
      num_sent=$(jq 'length' <<< "$req_files")
      for (( j=0; j<num_sent; j++ )); do
        sent_f=$(jq -c --argjson idx "$j" '.[$idx]' <<< "$req_files")
        s_name=$(jq -r '.Name' <<< "$sent_f")
        s_sha=$(jq -r '.SHA256' <<< "$sent_f")
        s_cut=$(jq -r '.Cut' <<< "$sent_f")
        accepted_manifest_files=$(jq -c --arg n "$s_name" --arg s "$s_sha" --argjson c "$s_cut" \
          '. + {($n): {sha: $s, cut: $c}}' <<< "$accepted_manifest_files")
      done
      local final_manifest
      final_manifest=$(printf '%s\n%s\n' "$current_manifest_meta" "$accepted_manifest_files" | jq -s --argjson complete "$artifacts_complete" \
        '{metadata: .[0], files: .[1], complete: $complete}')
      node_sync_save_json "$manifest_file" "$final_manifest" "$snapshot_ts"
      if (( log_count > 0 )) || [[ $new_cursors != "$cursors" ]]; then
        node_sync_save_json "$log_cursor_file" "$new_cursors"
      fi
      return 0
    else
      local rc=$?
      if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
        node_mark_job_obsolete "$jid" "$rc"
      fi
      return "$rc"
    fi
  fi
  return 0
}

# node_sync_tasks syncs changed metadata, files and logs for assigned jobs.
node_sync_tasks() {
  local jid tid assignment ids pass=0 changed_state=false
  while (( pass < 2 )); do
    pass=$((pass + 1))
    changed_state=false
    ids=$(jq_soft node_sync_jobs_invalid -r '.jobs | to_entries[] | select((.value.obsolete|not) and .value.task_id and (.value.launched or .value.start_acked)) | .key' <<< "$NODE_STATE")
    for jid in $ids; do
      [[ -n $jid ]] || continue
      if jq -e --arg id "$jid" '.jobs[$id].obsolete // false' <<< "$NODE_STATE" >/dev/null; then
        continue
      fi
      tid=$(jq -r --arg id "$jid" '.jobs[$id].task_id // empty' <<< "$NODE_STATE")
      assignment=$(jq -r --arg id "$jid" '.jobs[$id].assignment // 0' <<< "$NODE_STATE")
      [[ -n $tid && $assignment =~ ^[1-9][0-9]*$ ]] || continue

      if node_sync_terminal_unchanged "$TASKS/$tid" && ! node_sync_has_new_logs; then
        continue
      fi

      if node_sync_task "$jid" "$tid" "$assignment"; then
        :
      else
        local rc=$?
        if (( rc == BUS_NOT_FOUND || rc == BUS_PERMISSION )); then
          changed_state=true
        fi
      fi
    done
    [[ $changed_state == true ]] || break
  done
}

# node_poll performs one durable recovery/report/assignment cycle without involving the ordinary MCP bus.
node_poll() {
  NODE_STATE=$(node_jobs_load)
  node_recover_tasks
  node_process_pending_launches
  node_scan_tasks
  node_flush_reports
  node_sync_tasks
  node_poll_remote_helpers
  local declaration reply
  declaration=$(node_heartbeat_json)
  if reply=$(printf '%s' "$declaration" | node_request --path /v1/heartbeat); then
    if jq -e 'has("Job") and (.Stops|type == "array")' <<< "$reply" >/dev/null; then
      log_info node_heartbeat_accepted
      node_handle_reply "$reply"
      node_process_pending_launches
    else log_warn node_reply_invalid; fi
  else log_warn node_heartbeat_failed; fi
}

# cmd_node runs the configured node in the foreground; --once is a single recovery/poll cycle for diagnostics.
cmd_node() {
  [[ $# == 0 || ($# == 1 && $1 == --once) ]] || die "usage: agent node [--once]"
  exec 10>&-
  [[ -n $LEAD_URL ]] || die "LEAD_URL is not set: set it in config/agents.conf (e.g. LEAD_URL=http://lead-instance:7780)"
  [[ $NODE_POLL_SEC =~ ^[1-9][0-9]*$ ]] || die "NODE_POLL_SEC must be a positive integer"
  local repo declaration detail
  for repo in "${!NODE_REPOS[@]}"; do [[ ${NODE_REPOS[$repo]} == /* ]] || die "NODE_REPOS paths must be absolute: $repo"; done
  declaration=$(node_heartbeat_json)
  if ! detail=$(printf '%s' "$declaration" | node_request --validate 2>&1); then die "invalid capabilities: $detail"; fi
  node_lock
  log_info node_started "lead_url=$LEAD_URL" "poll_sec=$NODE_POLL_SEC"
  trap 'log_info node_stopped; exit 0' TERM INT
  trap 'node_stop_doorbell' EXIT
  local bell="" rc
  if [[ ${1:-} != --once ]]; then   # the lead's doorbell: when it rings, the next poll comes at once
    coproc DOORBELL { exec "$AGENTBUS_BIN" node-doorbell --url "$LEAD_URL" 8>&-; }
    bell=${DOORBELL[0]}
  fi
  while :; do
    node_poll
    [[ ${1:-} != --once ]] || break
    if [[ -n $bell ]]; then
      rc=0
      read -r -t "$NODE_POLL_SEC" -u "$bell" _ || rc=$?
      if ((rc == 0 || rc > 128)); then continue; fi   # rang, or the usual interval passed
      log_warn node_doorbell_lost; bell=""             # the doorbell ended: plain polling from now on
    fi
    sleep "$NODE_POLL_SEC" 8>&- &
    if wait $!; then :; else log_warn node_sleep_interrupted; fi
  done
}

cmd__agents_json() { # the configured agents and investigators as JSON lines (for agentlive web)
  local a tier inv
  for a in "${!AGENT_TYPE[@]}"; do
    tier=normal
    [[ " ${WORKER_AGENTS[*]} " == *" $a "* ]] && tier=worker
    jq -cn --arg name "$a" --arg type "${AGENT_TYPE[$a]}" --arg model "${AGENT_MODEL[$a]:-}" --arg tier "$tier" \
      --arg provider "$(agent_provider "$a")" '{name: $name, type: $type, model: $model, tier: $tier, provider: $provider}'
  done
  while read -r inv; do
    [[ -n $inv ]] || continue
    jq -cn --arg name "$inv" --arg type "${INVESTIGATORS_TYPE[$inv]}" --arg model "${INVESTIGATORS_MODEL[$inv]:-}" \
      '{name: $name, type: $type, model: $model, tier: "investigator", provider: ""}'
  done < <(investigator_names)
}

cmd_ack() { # <id | all> — acknowledges finished tasks (they disappear from agent live)
  local q=${1:?usage: agent ack <id|all>} d n=0
  if [[ $q == all ]]; then
    for d in "$TASKS"/*/; do
      [[ -f $d/meta.env ]] || continue
      case $(task_field "$(basename "$d")" STATUS) in
        done|failed|stopped|excluded|hung) : > "$d/acked"; n=$((n + 1)) ;;
      esac
    done
    echo "Acknowledged: $n"
  else
    local id; id=$(resolve_id "$q")
    case $(task_field "$id" STATUS) in
      done|failed|stopped|excluded|hung) : > "$TASKS/$id/acked"; echo "Acknowledged $id." ;;
      *) die "task $id is still running" ;;
    esac
  fi
}

# ------------------------------------------------------------------ account authentication

auth_classify() { # error-file → a category with the CLI's or provider's own words: "needs authentication — …",
  # "limit — …" (a quota, credits or a rate limit), "cannot reach the provider — …" or "other error: …"
  local text line
  text=$(tr '\n' ' ' < "$1" | tr -s ' ')
  line=$(grep -m1 -v '^[[:space:]]*$' "$1" | cut -c1-200)
  shopt -s nocasematch
  if [[ $text =~ (401|unauthori[sz]ed|authentication|not[[:space:]]logged[[:space:]]in|log[[:space:]]?in[[:space:]]again|/login|invalid[[:space:]](api|x-api)[[:space:]-]?key|oauth[[:space:]]token|token[[:space:]](has[[:space:]])?expired|expired[[:space:]]token|refresh[[:space:]]token|re-?authenticate|sign[[:space:]]in|credentials) ]]; then
    echo "needs authentication — ${line:-no message}"
  elif [[ $text =~ (rate[[:space:]_-]?limit|usage[[:space:]]limit|quota|429|too[[:space:]]many[[:space:]]requests|limit[[:space:]]reached|resource_exhausted|credits) ]]; then
    echo "limit — ${line:-no message}"
  elif [[ $text =~ (enotfound|econnrefused|econnreset|eai_again|could[[:space:]]not[[:space:]]resolve|network|connection[[:space:]](refused|reset)) ]]; then
    echo "cannot reach the provider — ${line:-no message}"
  else
    echo "other error: ${line:-unknown}"
  fi
  shopt -u nocasematch
}

api_error_text() { # body-file — the provider's own message from an API error body (not JSON: the raw body)
  local m=""
  # a body that is not JSON makes jq fail: then the raw body is the message
  m=$(jq -r '.error.message // .error.metadata.raw // .detail // .message // (.error | strings) // empty' "$1" 2>/dev/null) || m=""
  [[ -n $m ]] || m=$(tr -s '[:space:]' ' ' < "$1")
  printf '%s' "${m:0:200}"
}

agent_auth_target() { # agent → "provider<TAB>model": the model as its provider's API or CLI takes it ("" = CLI default)
  local type model
  if [[ -n ${AGENT_TYPE[$1]:-} ]]; then type=${AGENT_TYPE[$1]}; model=${AGENT_MODEL[$1]:-}
  else type=${INVESTIGATORS_TYPE[$1]:-}; model=${INVESTIGATORS_MODEL[$1]:-}; fi
  case $type in
    claude) printf 'anthropic\t%s' "$model" ;;
    codex) printf 'openai\t%s' "$model" ;;
    gemini) printf 'gemini\t%s' "$model" ;;
    opencode)
      case $model in
        openrouter/*) printf 'openrouter\t%s' "${model#openrouter/}" ;;
        deepinfra/*) printf 'deepinfra\t%s' "${model#deepinfra/}" ;;
        *) printf 'other\t%s' "$model" ;;
      esac ;;
    *) printf 'other\t%s' "$model" ;;
  esac
}

cmd__authcheck() { # provider | --agent NAME — one check, as a systemd --user unit (the agents' context)
  if [[ ${1:-} == --agent ]]; then
    local p model
    IFS=$'\t' read -r p model <<< "$(agent_auth_target "$2")"
    printf '%s\t%s\t%s\n' "$p" "${model:-(CLI default)}" "$(auth_probe "$p" "$model" agent)"
    return 0
  fi
  local m=""
  case $1 in
    anthropic) m=$AUTH_MODEL_ANTHROPIC ;;
    openai) m=$AUTH_MODEL_OPENAI ;;
    gemini) m=$AUTH_MODEL_GEMINI ;;
    openrouter) m=${AUTH_MODEL_OPENROUTER:-$(opencode_model_for openrouter)} ;;
    deepinfra) m=${AUTH_MODEL_DEEPINFRA:-$(opencode_model_for deepinfra)} ;;
  esac
  auth_probe "$1" "$m" provider
}

auth_probe() { # provider model mode(agent|provider) — one request to the provider; prints OK or what went wrong
  local p=$1 model=$2 tmp rc=0
  export LC_ALL=C.UTF-8
  if [[ -f $AGENTS_HOME/secrets.env ]]; then set -a; source "$AGENTS_HOME/secrets.env"; set +a; fi
  local v
  for v in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY CODEX_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY DEEPINFRA_API_KEY; do
    if [[ -z ${!v:-} ]]; then unset "$v"; fi
  done
  tmp=$(mktemp -d); cd "$tmp" || exit 1
  trap 'rm -rf "$tmp"' EXIT
  local q="Reply with the single word: OK"
  case $p in
    anthropic)
      [[ -x $CLAUDE_BIN ]] || { echo "other error: CLI not found ($CLAUDE_BIN)"; return; }
      timeout 180 "$CLAUDE_BIN" -p "$q" --output-format json --max-turns 1 \
        ${model:+--model "$model"} </dev/null >out 2>err || rc=$?
      # output that is not JSON is not an OK answer; it is kept as the error text (fallback: cat out)
      if ((rc == 0)) && [[ $(jq -r '.is_error | tostring' out 2>/dev/null) == false ]]; then echo OK; return; fi
      jq -r '.result // empty' out >> err 2>/dev/null || cat out >> err ;;
    openai)
      [[ -x $CODEX_BIN ]] || { echo "other error: CLI not found ($CODEX_BIN)"; return; }
      timeout 180 "$CODEX_BIN" exec --json --skip-git-repo-check \
        ${model:+-m "$model"} "$q" </dev/null >out 2>err || rc=$?
      if ((rc == 0)) && ! grep -q '"type":"\(turn.failed\|error\)"' out; then echo OK; return; fi
      jq_soft auth_check_parse -rR 'fromjson? | select(.type=="turn.failed" or .type=="error") | (.error.message // .message // empty)' < out >> err ;;
    gemini)
      [[ -x $AGY_BIN ]] || { echo "other error: CLI not found ($AGY_BIN)"; return; }
      timeout 180 "$AGY_BIN" -p "$q" --output-format json --print-timeout 2m \
        ${model:+--model "$model"} </dev/null >out 2>err || rc=$?
      # output that is not JSON is not an OK answer; it is kept as the error text (fallback: cat out)
      if ((rc == 0)) && [[ $(jq -r '.status // empty' out 2>/dev/null) == SUCCESS ]]; then echo OK; return; fi
      jq -r '.error // empty' out >> err 2>/dev/null || cat out >> err ;;
    openrouter|deepinfra)
      local key url code
      if [[ $p == openrouter ]]; then
        key=${OPENROUTER_API_KEY:-}; url=$AUTH_OPENROUTER_URL
      else
        key=${DEEPINFRA_API_KEY:-}; url=$AUTH_DEEPINFRA_URL
      fi
      [[ -n $key ]] || { echo "needs authentication — no ${p^^}_API_KEY in secrets.env"; return; }
      if [[ -z $model ]]; then
        if [[ $p == openrouter ]]; then   # no model configured: only check the key and its limit
          code=$(curl -sS -m 60 -o out -w '%{http_code}' -H "Authorization: Bearer $key" "$url/key" 2>err) || rc=$?
          if [[ $code == 200 ]]; then
            [[ $(jq -r '.data.limit_remaining // "x"' out) == 0 ]] && { echo "limit — the key's credit limit is used up (limit_remaining 0)"; return; }
            echo OK; return
          fi
        else
          echo "other error: no model to test (set AUTH_MODEL_DEEPINFRA or configure a deepinfra/... agent)"; return
        fi
      else
        code=$(jq -n --arg m "$model" --arg q "$q" '{model:$m, max_tokens:5, messages:[{role:"user", content:$q}]}' \
          | curl -sS -m 120 -o out -w '%{http_code}' -H "Authorization: Bearer $key" \
              -H 'Content-Type: application/json' -d @- "$url/chat/completions" 2>err) || rc=$?
        [[ $code == 200 ]] && { echo OK; return; }
      fi
      case $code in
        000|"") echo "cannot reach the provider — $(head -c 200 err)"; return ;;
        401|403) echo "needs authentication — HTTP $code: $(api_error_text out)"; return ;;
        *) echo "HTTP $code: $(api_error_text out)"; return ;;
      esac ;;
    *) echo "not checked — only claude, codex and gemini agents and opencode agents with openrouter/… or deepinfra/… models are"; return ;;
  esac
  if ((rc == 124)); then echo "other error: the request timed out"; return; fi
  auth_classify err
}

opencode_model_for() { # provider — the model (without prefix) of the first opencode agent using that provider
  local a
  for a in "${!AGENT_TYPE[@]}"; do
    if [[ ${AGENT_TYPE[$a]} == opencode && ${AGENT_MODEL[$a]:-} == "$1"/* ]]; then
      printf '%s' "${AGENT_MODEL[$a]#"$1"/}"; return
    fi
  done
}

cmd_authenticated() { # [--providers | agent...] — every agent with its own model (default), the given agents, or
  # one quick request per provider (--providers)
  [[ ${1:-} == --providers ]] && { auth_providers; return; }
  local agents=() a tmp r p model res
  if (($#)); then
    for a in "$@"; do
      [[ -n ${AGENT_TYPE[$a]:-} || -n ${INVESTIGATORS_TYPE[$a]:-} ]] || die "no agent '$a' in agents.conf (see: agent agents)"
      agents+=("$a")
    done
  else
    mapfile -t agents < <({ printf '%s\n' "${!AGENT_TYPE[@]}"; investigator_names; } | sort -u)
  fi
  tmp=$(mktemp -d)
  for a in "${agents[@]}"; do
    systemd-run --user --wait --pipe --quiet --collect --unit="agent-auth-$a-$$" \
      --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
      --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
      "$SELF" _authcheck --agent "$a" </dev/null >"$tmp/$a" 2>"$tmp/$a.err" &
  done
  wait
  printf '%-26s %-10s %-44s %s\n' AGENT PROVIDER MODEL RESULT
  for a in "${agents[@]}"; do
    r=""
    [[ -s $tmp/$a ]] && r=$(head -1 "$tmp/$a")
    if [[ -z $r ]]; then
      log_warn auth_check_failed "agent=$a" "stderr=$(head -c 2000 "$tmp/$a.err")"
      r=$'?\t?\tother error: could not run the check (systemd-run)'
    fi
    IFS=$'\t' read -r p model res <<< "$r"
    printf '%-26s %-10s %-44s %s\n' "$a" "$p" "$model" "$res"
  done
  rm -rf "$tmp"
}

auth_providers() { # one quick request per provider (agent authenticated --providers)
  local tmp p; tmp=$(mktemp -d)
  for p in anthropic openai gemini openrouter deepinfra; do
    systemd-run --user --wait --pipe --quiet --collect --unit="agent-auth-$p-$$" \
      --setenv=AGENTS_HOME="$AGENTS_HOME" --setenv=PATH="$RUN_PATH" \
      --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
      "$SELF" _authcheck "$p" </dev/null >"$tmp/$p" 2>"$tmp/$p.err" &
  done
  wait
  for p in anthropic openai gemini openrouter deepinfra; do
    local r=""
    [[ -s $tmp/$p ]] && r=$(head -1 "$tmp/$p")
    if [[ -z $r ]]; then
      r="other error: could not run the check (systemd-run)"
      log_warn auth_check_failed "provider=$p" "stderr=$(head -c 2000 "$tmp/$p.err")"
    fi
    printf '%-10s %s\n' "$p" "$r"
  done
  rm -rf "$tmp"
}

cmd_team() { # [id [--close]] [--all]
  if [[ -n ${1:-} && $1 != --all && ${2:-} == --close ]]; then
    team_close "$1"
    return
  fi
  if [[ -n ${1:-} && $1 != --all ]]; then
    bus team-get --dir "$BUS_DIR" --team "$1" | jq -r '"\(.id) repo \(.repo), coordinator \(.lead // "—"), finished: \(.done)"'
    team_summary "$1"
  else
    bus team-list --dir "$BUS_DIR" "$@"
  fi
}

team_close() { # team — closes a team whatever its members do: local ones still at work or waiting are stopped,
  # then finish_team (sleeping ones done, its remote members' jobs ended, their grants revoked)
  local team=$1 t
  bus team-get --dir "$BUS_DIR" --team "$team" >/dev/null || die "no team $team on the bus (agent team)"
  for t in $(team_tasks "$team"); do
    [[ $(task_field "$t" KIND) != remote-member ]] || continue
    case $(task_field "$t" STATUS) in
      new|starting|running|waiting|investigating|paused|interrupted)
        "$SELF" stop "$t" >/dev/null || log_warn team_close_stop_failed "task=$t" "team=$team" ;;
    esac
  done
  finish_team "$team" "closed by the human (agent team $team --close)"
  log_info team_closed "team=$team"
  echo "Closed team $team."
}

cmd_notes() { # [repo] [--section S] [--search Q] [-n N]
  local repo=""
  if [[ -n ${1:-} && $1 != -* ]]; then repo=$1; shift; fi
  if [[ -z $repo ]]; then
    local root; root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""   # outside a repository: no repository name
    [[ -n $root ]] && repo=$(basename "$(dirname "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)")")
  fi
  if [[ -z $repo ]]; then
    echo "Repository notebooks:"; bus notes --dir "$BUS_DIR" --list; return
  fi
  bus notes --dir "$BUS_DIR" --repo "$repo" "$@"
}

cmd_helpers() { bus helper-list --dir "$BUS_DIR" "$@"; }

cmd_transcript() { # <task|team|fragment> [--raw] — chronological log of a task or a team
  local q="" raw=0
  while (($#)); do
    case $1 in --raw) raw=1 ;; *) q=$1 ;; esac
    shift
  done
  [[ -n $q ]] || die "usage: agent transcript <task id | team id | fragment> [--raw]"
  local d first="" team=""
  for d in "$TASKS"/*/; do
    d=${d%/}; d=${d##*/}
    [[ -f $TASKS/$d/meta.env ]] || continue
    if [[ $d == *"$q"* || $(task_field "$d" TEAM) == *"$q"* ]]; then first=$d; team=$(task_field "$d" TEAM); break; fi
  done
  [[ -n $first ]] || die "no task or team matches: $q"

  # tasks: the given one or the whole team + investigations and worker requests made for them (recursively)
  local tasks=("$first") t p changed=1
  if [[ -n $team ]]; then
    tasks=()
    for d in "$TASKS"/*/; do
      d=${d%/}; d=${d##*/}
      [[ -f $TASKS/$d/meta.env && $(task_field "$d" TEAM) == "$team" ]] && tasks+=("$d")
    done
  fi
  while ((changed)); do
    changed=0
    for d in "$TASKS"/*/; do
      d=${d%/}; d=${d##*/}
      [[ -f $TASKS/$d/meta.env ]] || continue
      p=$(task_field "$d" PARENT_TASK)
      [[ -n $p ]] || continue
      [[ " ${tasks[*]} " == *" $d "* ]] && continue
      [[ " ${tasks[*]} " == *" $p "* ]] && { tasks+=("$d"); changed=1; }
    done
  done

  local names=() start="" end="" c f
  for t in "${tasks[@]}"; do
    names+=("$(task_field "$t" AGENT)")
    c=$(task_field "$t" CREATED | cut -c1-19 | tr T ' ')
    f=$(task_field "$t" FINISHED | cut -c1-19 | tr T ' ')
    [[ -z $start || $c < $start ]] && start=$c
    [[ -z $f ]] && f="9999-12-31 23:59:59"
    [[ -z $end || $f > $end ]] && end=$f
  done

  printf '# Transcript: %s%s\n# Tasks: %s\n# Window: %s — %s\n\n' "${team:-$first}" "$( ((raw)) && echo ' (full texts)')" \
    "${tasks[*]}" "$start" "${end/9999-12-31 23:59:59/still running}"
  {
    jq -rc --argjson n "$(printf '%s\n' "${names[@]}" | jq -R . | jq -sc .)" \
       --arg team "team:$team" --arg s "$start" --arg e "$end" '
       select(.ts >= $s and .ts <= $e)
       | select((.from as $f | $n | index($f)) or (.to as $t | $n | index($t)) or .to == $team)
       | "\(.ts)\t[bus] \(.from) → \(.to): \(.text | gsub("\n"; "\u001f    "))"' "$BUS_DIR/messages.jsonl" 2>/dev/null || log_warn transcript_bus_unreadable "file=$BUS_DIR/messages.jsonl"
    local label inv hid day file
    for t in "${tasks[@]}"; do
      file="$TASKS/$t/activity.jsonl"
      ((raw)) && [[ -s $TASKS/$t/activity-full.jsonl ]] && file="$TASKS/$t/activity-full.jsonl"
      [[ -f $file ]] || continue
      label=$(task_field "$t" AGENT)
      inv=$(task_field "$t" INV_ID); hid=$(task_field "$t" HELPER_ID)
      [[ -n $inv ]] && label="inv#$inv"
      [[ -n $hid ]] && label="$label/H$hid"
      day=$(task_field "$t" CREATED | cut -c1-10)
      jq -r '"\(.ts)\t\(.k)\t\(.t | gsub("\n"; "\u001f    "))"' "$file" | awk -F'\t' -v day="$day" -v who="$label" '
        { ts = $1
          if (length(ts) == 8) {            # old HH:MM:SS format — take the date from when the task was created
            if (prev != "" && ts < prev) { cmd = "date -d \"" day " +1 day\" +%F"; cmd | getline day; close(cmd) }
            prev = ts; ts = day " " ts
          }
          k = $2
          icon = (k=="text")?"»":(k=="cmd")?"$":(k=="edit")?"✎":(k=="mcp")?"⇄":(k=="err")?"✗":(k=="info")?"·":"⚙"
          printf "%s\t[%s] %s %s\n", ts, who, icon, $3 }'
    done
  } | sort -s -t$'\t' -k1,1 | sed 's/\t/  /' | tr '\037' '\n'
}

# ------------------------------------------------------------------ task archiving

archive_index() { # loads the metadata of all tasks into the IX_* arrays (a single pass)
  declare -gA IX_TEAM=() IX_RES=() IX_PAR=() IX_ST=() IX_KIND=()
  local d id team res par st kind
  for d in "$TASKS"/*/; do
    [[ -f $d/meta.env ]] || continue
    id=${d%/}; id=${id##*/}
    IFS=$'\t' read -r team res par st kind < <( source "$d/meta.env"
      printf '%s\t%s\t%s\t%s\t%s\n' "${TEAM:--}" "${RESUMED_FROM:--}" "${PARENT_TASK:--}" "${STATUS:--}" "${KIND:-worker}" )
    IX_TEAM[$id]=${team#-}; IX_RES[$id]=${res#-}; IX_PAR[$id]=${par#-}; IX_ST[$id]=${st#-}; IX_KIND[$id]=$kind
  done
}

archive_group() { # task → GROUP: the team/task with its whole resume chain, investigations and worker requests
  declare -gA GROUP=()
  local queue=("$1") t x
  while ((${#queue[@]})); do
    t=${queue[0]}; queue=("${queue[@]:1}")
    [[ -n ${GROUP[$t]:-} || -z ${IX_ST[$t]+x} ]] && continue
    GROUP[$t]=1
    [[ -n ${IX_RES[$t]} ]] && queue+=("${IX_RES[$t]}")
    [[ -n ${IX_PAR[$t]} ]] && queue+=("${IX_PAR[$t]}")
    for x in "${!IX_ST[@]}"; do
      [[ -n ${GROUP[$x]:-} ]] && continue
      if [[ ( -n ${IX_TEAM[$t]} && ${IX_TEAM[$x]} == "${IX_TEAM[$t]}" ) || ${IX_RES[$x]} == "$t" || ${IX_PAR[$x]} == "$t" ]]; then
        queue+=("$x")
      fi
    done
  done
}

sevenzip() { command -v 7z || command -v 7za || command -v 7zr; }

archive_one() { # start-task — packs the whole group into tasks-archived/<name>.7z and removes it from tasks/
  local start=$1 t
  archive_group "$start"
  local ids=() active=()
  for t in "${!GROUP[@]}"; do
    ids+=("$t")
    case ${IX_ST[$t]} in new|starting|running|waiting|investigating|sleeping|paused) active+=("$t (${IX_ST[$t]})") ;; esac
  done
  if ((${#active[@]})); then
    echo "agent: skipped — the group is still active: ${active[*]} (agent stop first)" >&2
    return 1
  fi
  mapfile -t ids < <(printf '%s\n' "${ids[@]}" | sort)
  local root=${ids[0]} name keys=() k
  name=${IX_TEAM[$root]:-$root}
  local zip; zip=$(sevenzip) || die "7z (p7zip) not found"
  local arch_dir="$AGENTS_HOME/tasks-archived"; mkdir -p "$arch_dir"
  local archive_file="$arch_dir/$name.7z" i=1
  while [[ -e $archive_file ]]; do archive_file="$arch_dir/$name-$((i++)).7z"; done
  local stage; stage=$(mktemp -d)
  mkdir -p "$stage/tasks" "$stage/checkpoints"

  # full transcripts (bus + activity) — while the task directories still exist
  for t in "${ids[@]}"; do
    [[ ${IX_KIND[$t]} == worker ]] || continue
    k=${IX_TEAM[$t]:-$t}
    [[ " ${keys[*]} " == *" $k "* ]] && continue
    keys+=("$k")
    ( cmd_transcript "$k" --raw ) > "$stage/transcript-$k.txt" || log_warn transcript_failed "key=$k" "effect=archive without a transcript of $k"
  done
  for k in "${keys[@]}"; do
    for t in team task; do
      [[ -f $BUS_DIR/checkpoints/$t-$k.md ]] && cp "$BUS_DIR/checkpoints/$t-$k.md" "$stage/checkpoints/"
    done
  done
  for t in "${ids[@]}"; do cp -a "$TASKS/$t" "$stage/tasks/"; done

  ( cd "$stage" && "$zip" a -t7z -mx=7 "$archive_file" . >/dev/null ) || { rm -rf "$stage"; die "packing failed"; }
  "$zip" t "$archive_file" >/dev/null || { rm -rf "$stage"; rm -f "$archive_file"; die "archive test of $archive_file failed — nothing was removed"; }
  rm -rf "$stage"

  # only after a successful test: worktrees (branches stay), task directories, checkpoints
  local wt root_repo n_wt=0
  for t in "${ids[@]}"; do
    wt=$(task_field "$t" WORKTREE); root_repo=$(task_field "$t" REPO_ROOT)
    if [[ -n $wt && -d $wt && -n $root_repo ]]; then
      if [[ -d $wt ]]; then
        try worktree_remove_failed git -C "$root_repo" worktree remove --force "$wt"
        [[ -d $wt ]] || n_wt=$((n_wt + 1))
      fi
      try worktree_prune_failed git -C "$root_repo" worktree prune
    fi
  done
  for t in "${ids[@]}"; do rm -rf "${TASKS:?}/$t"; done
  for k in "${keys[@]}"; do rm -f "$BUS_DIR/checkpoints/team-$k.md" "$BUS_DIR/checkpoints/task-$k.md" "$TASKS/.team-$k.stuck"; done
  for t in "${ids[@]}"; do unset "IX_ST[$t]"; done
  log_info archived "archive=$archive_file" "tasks=${ids[*]}" "worktrees_removed=$n_wt"
  printf '%s  (%s, tasks: %d, worktrees removed: %d)\n' "$archive_file" "$(du -h "$archive_file" | cut -f1)" "${#ids[@]}" "$n_wt"
}

cmd_discard() { # <id>... — removes tasks that never started (status new): worktree, branch, task directory
  (($#)) || die "usage: agent discard <id>..."
  local ref id st
  for ref in "$@"; do
    id=$(resolve_id "$ref")
    st=$(task_field "$id" STATUS)
    [[ $st == new ]] || die "$id has already run (status $st): use agent archive for finished tasks"
    discard_task "$id"
    echo "discarded $id"
  done
}

cmd_archive() { # <task|team> | --finished
  local q=${1:?usage: agent archive <task|team> | --finished}
  archive_index
  if [[ $q == --finished ]]; then
    local t done_n=0 skip=0
    for t in $(printf '%s\n' "${!IX_ST[@]}" | sort); do
      [[ -n ${IX_ST[$t]+x} ]] || continue          # already archived in this pass
      archive_group "$t"
      local x all=1
      for x in "${!GROUP[@]}"; do
        case ${IX_ST[$x]} in done|failed|stopped|excluded|hung) ;; *) all=0 ;; esac
      done
      if ((all)); then archive_one "$t" && done_n=$((done_n + 1)); else
        for x in "${!GROUP[@]}"; do unset "IX_ST[$x]"; done; skip=$((skip + 1)); fi
    done
    echo "Archived: $done_n, skipped (still active): $skip"
    return
  fi
  local d start=""
  for d in "${!IX_ST[@]}"; do
    if [[ $d == *"$q"* || ${IX_TEAM[$d]} == *"$q"* ]]; then start=$d; break; fi
  done
  [[ -n $start ]] || die "no task or team matches: $q"
  archive_one "$start"
}

cmd_bus() { "$AGENTBUS_BIN" status --dir "$BUS_DIR"; echo; "$AGENTBUS_BIN" log --dir "$BUS_DIR" -n "${1:-30}"; }

cmd_say() {
  local to=${1:?usage: agent say <agent|all|team:ID> "text"}; shift
  (($#)) || die "give the message text"
  rm -f "$TASKS"/.team-*.stuck
  "$AGENTBUS_BIN" send --dir "$BUS_DIR" --from "${USER:-mat}" --to "$to" "$*"
}

usage() {
  cat <<'EOF'
agent run <agent> "task" | -f file.md      start a task (run inside the repository)
agent status                              task list
agent agents                              configured agents and whether they are busy
agent show <id>                           task details and the last message
agent answer <id>                         open the questions in $EDITOR, validate, resume
agent resume <id> ["note"]                resume after all questions are answered
agent log <id> [--raw]                    follow the runner log (structured records rendered)
agent stop <id>                           stop a run
agent stop --running                      stop EVERYTHING that is active (teams, agents, investigations, queues)
agent clean <id>                          remove the task's worktree (the branch is kept)
agent inv [number | --all]                investigation queue / full record of one
agent dispatch                            manually start the next queued investigation (fallback)
agent live [--feed] [--remind MIN]        live panel (or an event stream with --feed)
agent web                                 web interface in the foreground (normally: agentweb.service)
agent lead                                the lead's job listener in the foreground (normally: agentlead.service; LEAD_LISTEN)
agent node                                the node daemon in the foreground (normally: agentnode.service; LEAD_URL)
agent jobs [<id>]                         remote jobs on the lead (or this node's jobs)
agent jobs --cancel <id>                  cancel a remote job on the lead
agent nodes                               registered nodes on the lead
agent kick <task>                         cut a run short: a team member sleeps (the team can wake it), solo: stopped
agent wake <task>                         resume a paused task now, not at its pause's end (a remote member's: on its node)
agent round-size <task>                   size of a task's change against the round limit (README "Rounds")
agent run --need <caps> <agent|normal|worker> "task"   submit a remote job with required capabilities
agent run --on <instance> <agent> "task"               submit a remote job pinned to an instance
agent run --resume <team|task> --same-round  continue an unmerged round (e.g. review fixes) on the same branches
agent run --last-team [--same-round] ["…"]  resume the newest team of this repository (no ID to look up)
agent ack <id|all>                        acknowledge finished tasks (they leave the panel)
agent run --team a,b[,c] [--verify|--autopilot] "task"  team; --verify: an investigator reviews the PR at the end;
                                           --autopilot: two independent reviews, the merge, the next round
agent autopilot <team> [on|off]            a team's --autopilot: shown, or switched (off: no merge nor next round by itself)
agent run --resume <team|task> ["addition"]  resume from the last checkpoint (same branches)
agent team [id | --all]                   teams and their members
agent team <id> --close                                close a team: stop its local members, end its remote ones' jobs
agent helpers [--all]                     worker requests made by normal models
agent transcript <id|team> [--raw]        full chronological log of a task/team (bus + activity)
agent archive <id|team> | --finished      pack a finished task (with its resume chain) into tasks-archived/*.7z
agent discard <id>...                     remove tasks that never started (worktree, branch, task directory)
agent notes [repo] [--section S] [--search Q] [-n N]   persistent repository notebook
agent authenticated [agent...]            check every agent's (or the given agents') model, with the provider's own message
agent authenticated --providers           one quick request per provider account
agent bus [N]                             bus state and the last N agent messages
agent say <agent|all|team:ID> "text"     message agents through the bus
<id> may be an unambiguous fragment of a task ID.
EOF
}

main() {
  local cmd=${1:-help}; (($#)) && shift
  case $cmd in
    run)     cmd_run "$@" ;;
    status|ls) cmd_status ;;
    agents)  cmd_agents ;;
    show)    cmd_show "$@" ;;
    answer)  cmd_answer "$@" ;;
    resume)  cmd_resume "$@" ;;
    log)     cmd_log "$@" ;;
    stop)    cmd_stop "$@" ;;
    clean)   cmd_clean "$@" ;;
    bus)     cmd_bus "$@" ;;
    inv)     cmd_inv "$@" ;;
    live)    cmd_live "$@" ;;
    web)     cmd_web ;;
    lead)    cmd_lead ;;
    node)    cmd_node "$@" ;;
    jobs)    cmd_jobs "$@" ;;
    nodes)   cmd_nodes ;;
    kick)    cmd_kick "$@" ;;
    wake)    cmd_wake "$@" ;;
    round-size) cmd_round_size "$@" ;;
    _agents-json) cmd__agents_json ;;
    ack)     cmd_ack "$@" ;;
    authenticated) cmd_authenticated "$@" ;;
    team)    cmd_team "$@" ;;
    autopilot) cmd_autopilot "$@" ;;
    helpers) cmd_helpers "$@" ;;
    transcript) cmd_transcript "$@" ;;
    archive) cmd_archive "$@" ;;
    discard) cmd_discard "$@" ;;
    _dispatch-helpers) dispatch_helpers ;;
    notes)   cmd_notes "$@" ;;
    _wake)   cmd__wake "$@" ;;
    _remote_member) cmd__remote_member "$@" ;;
    _precheck) cmd__precheck "$@" ;;
    _merge) cmd__merge "$@" ;;
    _fixpass) cmd__fixpass "$@" ;;
    _supervise) cmd__supervise ;;
    _answers_saved) cmd__answers_saved "$@" ;;
    _authcheck) cmd__authcheck "$@" ;;
    dispatch) cmd_dispatch ;;
    say)     cmd_say "$@" ;;
    _runner) cmd__runner "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

# run the command when executed; tests source the script to call its functions directly
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
