# ------------------------------------------------------------------ structured logging
#
# Every event of the script is one JSON object per line in $AGENTS_HOME/logs/agent.jsonl (for Promtail,
# Vector, vmagent ...) and in the systemd journal (`logger`, SYSLOG_IDENTIFIER=agent). Inside a runner the
# record also goes to the task's runner.log, which `agent log` renders readably. Human-facing output of
# interactive commands stays plain text.

LOG_DIR="$AGENTS_HOME/logs"
AGENT_SUBCOMMAND="${1:-}"   # the subcommand being run (recorded in every log record)
RUNNER_ID=""                # task ID while running as a runner (set by cmd__runner)

# log_event level event [key=value ...] — writes one structured log record
log_event() {
  local level=$1 event=$2; shift 2
  local args=(--arg level "$level" --arg event "$event" --arg sub "$AGENT_SUBCOMMAND" --arg task "$RUNNER_ID")
  local prog='{ts: (now | todate), level: $level, component: "agent", event: $event,
               pid: '"$$"', subcommand: $sub} + (if $task != "" then {task: $task} else {} end)'
  local kv i=0
  for kv in "$@"; do
    args+=(--arg "k$i" "${kv%%=*}" --arg "v$i" "${kv#*=}")
    prog+=" + {(\$k$i): \$v$i}"
    i=$((i + 1))
  done
  local line
  if ! line=$(jq -nc "${args[@]}" "$prog" 2>&1); then
    echo "agent: cannot encode the log record '$event': $line" >&2
    return 0
  fi
  if ! { mkdir -p "$LOG_DIR" && printf '%s\n' "$line" >> "$LOG_DIR/agent.jsonl"; } 2>/dev/null; then
    echo "agent: cannot write $LOG_DIR/agent.jsonl" >&2
  fi
  if command -v logger >/dev/null; then
    local prio=info
    case $level in warn) prio=warning ;; error) prio=err ;; debug) prio=debug ;; esac
    logger -t agent -p "user.$prio" -- "$line" 2>/dev/null || echo "agent: cannot write to the system journal" >&2
  fi
  if [[ -n $RUNNER_ID ]]; then
    printf '%s\n' "$line" >&3   # fd 3 is the task's runner.log (opened by cmd__runner)
  elif [[ -z ${LOG_QUIET:-} && ( $level == warn || $level == error ) ]] && [[ -t 2 ]]; then
    echo "agent: $level: $event${*:+ ($*)}" >&2
  fi
}
log_info()  { log_event info "$@"; }
log_warn()  { log_event warn "$@"; }
log_error() { log_event error "$@"; }

# try event command [args...] — runs a command whose failure must not stop the caller (a side effect such as
# a bus notice or a cleanup step). A failure is logged as a warning with its exit code and stderr; stdout is
# passed through. Commands whose failure must stop the caller are not run through try.
try() {
  local event=$1; shift
  local errf rc=0
  errf=$(mktemp)
  "$@" 2>"$errf" || rc=$?
  if ((rc != 0)); then
    log_warn "$event" "exit_code=$rc" "command=$*" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  return 0
}

# jq_soft event jq-args... — jq for data that may legitimately lack a field (CLI outputs): a missing field yields
# empty output, but input that is not valid JSON is logged as a warning instead of being silently ignored.
jq_soft() {
  local event=$1; shift
  local errf rc=0 out
  errf=$(mktemp)
  out=$(jq "$@" 2>"$errf") || rc=$?
  if ((rc != 0)); then
    log_warn "$event" "exit_code=$rc" "stderr=$(head -c 2000 "$errf")"
  fi
  rm -f "$errf"
  printf '%s' "$out"
}

die() { LOG_QUIET=1 log_error command_failed "message=$*"; echo "agent: $*" >&2; exit 1; }

