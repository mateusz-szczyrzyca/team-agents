#!/usr/bin/env bash
# shellcheck disable=SC1010  # "status=done" assigns the word "done"; it is not a loop keyword
# agent — runs and coordinates LLM coding agents (Claude Code, Codex CLI, Antigravity, OpenCode) on this host.
# Every task gets its own git worktree + branch and runs in the background as a systemd --user unit;
# questions/answers live in .md files, and a notification is sent after every run.
set -euo pipefail
shopt -u patsub_replacement 2>/dev/null || :   # bash < 5.2 has no such option (nothing to disable)

# agent as gh — the agents' gh: the runner puts a link named gh to this script first on their CLI's PATH. Text on GitHub reaches them only from the trusted
# accounts (AGENT_GITHUB_TRUSTED_RESOLVED, set by the runner). Comments and reviews by anyone else — and the trusted
# accounts' own that begin with "ignore this mate" (a way to check this on GitHub's real data) — are left out and
# logged, on open, closed and merged PRs and issues alike. A fork's PR, or one opened by an unknown account, is not
# shown at all (its description, diff or checkout), nor listed — the lists are the trusted accounts' PRs and issues
# only. A GraphQL query for comments or reviews is refused: the agents
# read them through the ways filtered here. Everything else goes to the real gh (AGENT_REAL_GH).
agent_gh() {
  set +e   # each failure is handled where it happens

real=${AGENT_REAL_GH:-}
[[ -n $real && -x $real ]] || { echo "agent-gh: the real gh is not known (AGENT_REAL_GH)" >&2; exit 127; }
trusted_json=$(printf '%s' "${AGENT_GITHUB_TRUSTED_RESOLVED:-}" | jq -Rc 'split(" ") | map(select(. != ""))')
LOG="${AGENTS_HOME:-$HOME/agents}/logs/agent.jsonl"

# log event message key=value… — one warning line in the agents' log, as bin/agent writes them
gh_log() {
  local ev=$1 msg=$2; shift 2
  jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg ev "$ev" --arg msg "$msg" \
    '{ts: $ts, level: "warn", component: "agent-gh", event: $ev, message: $msg}
     + ([$ARGS.positional[] | capture("^(?<k>[^=]+)=(?<v>.*)$"; "s") | {(.k): .v}] | add // {})' --args "$@" >> "$LOG" \
    || echo "agent-gh: cannot write the log $LOG" >&2
}

# who wrote an entry; whether a trusted account marked it to be ignored; whether it is from a trusted account; kept
JQDEF='def who: (.author.login // .user.login // "");
def marked: ((.body // "") | test("^\\s*ignore this mate"; "i"));
def trusted: (who as $w | $t | index($w)) != null;
def keep: trusted and (marked | not);
def entries: if type == "array" then .[]
  elif type == "object" and has("body") and (has("user") or has("author")) and (has("comments") | not) then .
  elif type == "object" then (.comments // [])[], (.reviews // [])[], (.latestReviews // [])[]
  else empty end;'

# report json — logs each comment or review that is left out
gh_report() {
  local kind author id
  while IFS=$'\t' read -r kind author id; do
    if [[ $kind == unknown ]]; then
      gh_log github_comment_ignored "there is unknown comment from unknown user and it's ignored" "author=$author" "id=$id"
    else
      gh_log github_comment_marked_ignored "a comment that begins with \"ignore this mate\" is ignored" "author=$author" "id=$id"
    fi
  done < <(jq -r --argjson t "$trusted_json" "$JQDEF"'
    entries | select(keep | not) | [(if trusted then "marked" else "unknown" end), who, ((.id // .databaseId // "") | tostring)] | @tsv' <<< "$1")
}

# filter json — the same JSON without what is left out
gh_filter() {
  jq -c --argjson t "$trusted_json" "$JQDEF"'
    if type == "array" then map(select(keep))
    elif type == "object" and has("body") and (has("user") or has("author")) and (has("comments") | not) then (if keep then . else empty end)
    elif type == "object" then
      (if has("comments") then .comments |= map(select(keep)) else . end)
      | (if has("reviews") then .reviews |= map(select(keep)) else . end)
      | (if has("latestReviews") then .latestReviews |= map(select(keep)) else . end)
    else . end' <<< "$1"
}

# gh_colour_names text — the text as it goes to GitHub: each agent's name in a PR's attribution ("- coordinator: `x`
# (", "- member: …", "- agent: …") and in an investigator's review byline bold, in its colour (AGENT_GITHUB_NAME_COLORS
# "name=#RRGGBB …", set by the runner; a name it does not know: a colour of AGENT_GITHUB_COLORS from the name's
# checksum). Two names of one text never share a colour while the palette has another. No colours known: unchanged.
gh_colour_names() {
  local text=$1 line out="" pre name post c p e
  [[ -n ${AGENT_GITHUB_NAME_COLORS:-} ]] || { printf '%s' "$text"; return 0; }
  local -A cmap=() given=() holder=()
  local palette=()
  read -ra palette <<< "${AGENT_GITHUB_COLORS:-}"
  for e in $AGENT_GITHUB_NAME_COLORS; do cmap[${e%%=*}]=${e#*=}; done
  local re='^([[:space:]]*-[[:space:]]+(agent|coordinator|member):[[:space:]]+|.*Review by the team-agents investigator )`([A-Za-z0-9._@-]+)`( \(.*)$'
  while IFS= read -r line; do
    if [[ $line =~ $re ]]; then
      pre=${BASH_REMATCH[1]} name=${BASH_REMATCH[3]} post=${BASH_REMATCH[4]}
      c=${given[$name]:-}
      if [[ -z $c ]]; then
        c=${cmap[$name]:-}
        if [[ -z $c ]] && ((${#palette[@]})); then
          read -r e _ < <(printf '%s' "$name" | cksum)
          c=${palette[e % ${#palette[@]}]}
        fi
        if [[ -n $c && -n ${holder[$c]:-} ]]; then   # taken in this text by another name: the palette's next free one
          for p in "${palette[@]}"; do [[ -n ${holder[$p]:-} ]] || { c=$p; break; }; done
        fi
        if [[ -n $c ]]; then given[$name]=$c; holder[$c]=$name; fi
      fi
      [[ -z $c ]] || line="$pre\$\\color{$c}{\\textbf{${name//_/\\_}}}\$$post"
    fi
    out+=$line$'\n'
  done <<< "$text"
  printf '%s' "${out%$'\n'}"
}

# gh_colour_recommendation text — an investigator's review as published: on its recommendation's line (a line that
# begins "Recommendation", or the first line below a "Recommendation" heading) the verdict's words ("Ready to merge",
# "Needs changes", "needs fixes"; any case, bold or not) bold, ✅ green or 🔧 red (🧩 red when the line says
# incomplete): the notifications' icons. A recommendation in colour already, and every other line, stay as they are.
gh_colour_recommendation() {
  local line out="" state=0 low w i best=-1 word="" pre post bold icon colour
  local head='^[[:space:]]*(#{1,6}[[:space:]]*)?[*_]{0,2}[Rr]ecommendation([^[:alpha:]]|$)'
  while IFS= read -r line; do
    if ((state == 0)) && [[ $line =~ $head ]]; then state=1; fi
    if ((state == 1)) && [[ -n ${line//[[:space:]]/} ]]; then
      low=${line,,} best=-1
      for w in "ready to merge" "needs changes" "needs fixes"; do
        i=${low%%"$w"*}
        if [[ $i != "$low" ]] && ((best < 0 || ${#i} < best)); then best=${#i} word=$w; fi
      done
      if [[ $line == *'\color{'* ]]; then
        state=2
      elif ((best >= 0)); then
        pre=${line:0:best} post=${line:best+${#word}} bold=""
        if [[ $pre == *'**' || $pre == *'__' ]]; then bold=${pre: -2}; pre=${pre%??}; fi
        pre=${pre%"${pre##*[![:space:]]}"}
        pre=${pre%✅}; pre=${pre%🔧}; pre=${pre%🧩}
        pre=${pre%"${pre##*[![:space:]]}"}
        [[ -z $bold ]] || post=${post/"$bold"/}
        if [[ $word == "ready to merge" ]]; then
          icon="✅" colour='$\color{green}{\textbf{Ready to merge}}$'
        else
          icon="🔧" colour='$\color{red}{\textbf{Needs changes}}$'
          [[ $low != *incomplete* ]] || icon="🧩"
        fi
        line="${pre:+$pre }$icon $colour$post"
        state=2
      elif [[ ! $line =~ $head ]]; then
        state=2   # the heading's first line names no verdict: nothing to colour
      fi
    fi
    out+=$line$'\n'
  done <<< "$1"
  printf '%s' "${out%$'\n'}"
}

# colour_json_recommendation file — a copy of that JSON review request (file.rec) with its body's recommendation in
# colour (gh_colour_recommendation); prints the file to send: the copy, or the file itself when nothing changed or it
# is no JSON
colour_json_recommendation() {
  local body new
  if ! body=$(jq -er '(.body // empty) + "."' "$1" 2>/dev/null); then printf '%s' "$1"; return 0; fi   # no body
  body=${body%.}
  new=$(gh_colour_recommendation "$body"; printf .); new=${new%.}
  if [[ $new != "$body" ]] && jq --arg b "$new" '.body = $b' "$1" > "$1.rec"; then printf '%s' "$1.rec"; return 0; fi
  printf '%s' "$1"
}

# gh_publish_text text — the text as the agents publish it on GitHub: without Claude Code's own "Generated with
# Claude Code" line (and the blank line after it) — the attribution is the script's —, the names coloured
# (gh_colour_names)
gh_publish_text() {
  local line out="" drop=0
  local re='^[[:space:]]*(🤖[[:space:]]*)?Generated with \[?Claude Code\]?(\([^)]*\))?[[:space:]]*$'
  while IFS= read -r line; do
    if [[ $line =~ $re ]]; then drop=1; continue; fi
    if ((drop)) && [[ -z ${line//[[:space:]]/} ]]; then drop=0; continue; fi
    drop=0
    out+=$line$'\n'
  done <<< "$1"
  gh_colour_names "${out%$'\n'}"
}

# colour_json_body file — a copy of that JSON request file (file.names) with its body as published
# (gh_publish_text); prints the file to send: the copy, or the file itself when nothing changed or it is no JSON
colour_json_body() {
  local body new
  if ! body=$(jq -er '(.body // empty) + "."' "$1" 2>/dev/null); then printf '%s' "$1"; return 0; fi   # no body
  body=${body%.}
  new=$(gh_publish_text "$body"; printf .); new=${new%.}
  if [[ $new != "$body" ]] && jq --arg b "$new" '.body = $b' "$1" > "$1.names"; then printf '%s' "$1.names"; return 0; fi
  printf '%s' "$1"
}

# show json jq-expression — the filtered JSON, through the caller's --jq if any
gh_show() {
  if [[ -n $2 ]]; then jq -r "$2" <<< "$1"; else printf '%s\n' "$1"; fi
}

# gh_team_lead — who coordinates the run's team (AGENT_GH_TEAM), asked of the bus now: a new team has nobody when its
# first runs start, and a member can take over during a run. Prints the coordinator ("" = nobody yet); fails, logged,
# when the bus does not answer
gh_team_lead() {
  local out errf rc=0
  errf=$(mktemp) || return 1
  out=$("${AGENTBUS_BIN:-$HOME/.local/bin/agentbus}" team-get --dir "${AGENT_GH_BUS_DIR:-${AGENTS_HOME:-$HOME/agents}/bus}" \
          --team "$AGENT_GH_TEAM" 2> "$errf") || rc=$?
  if ((rc != 0)); then
    gh_log github_coordinator_unknown "the bus did not say who coordinates the team" "team=$AGENT_GH_TEAM" \
      "exit_code=$rc" "stderr=$(head -c 500 "$errf")"
    rm -f "$errf"
    return 1
  fi
  rm -f "$errf"
  jq -r '.lead // empty' <<< "$out"
}

# gh_member — whether this run is a non-coordinator team member; sets gh_lead to its coordinator for the refusal.
# The bus is asked now: a new team has nobody when its first runs start, and a member can take over during a run.
gh_member() {
  local member=${AGENT_GH_COORDINATOR:+1} now
  gh_lead=${AGENT_GH_COORDINATOR:-}
  if [[ -n ${AGENT_GH_TEAM:-} ]] && now=$(gh_team_lead); then
    gh_lead=$now member=1
    [[ $now != "${AGENT_GH_SELF:-}" ]] || member=""
  fi
  [[ -n $member ]]
}

# a team member opens, merges, marks ready, closes, reopens and edits no PR: the round has one, its coordinator's, which
# takes the member's work in, and the human (or --autopilot) merges it. AGENT_GH_COORDINATOR is the fallback for a solo
# task (empty) and for a team whose bus cannot answer.
case "${1:-} ${2:-}" in
  "pr create"|"pr merge"|"pr ready"|"pr close"|"pr reopen"|"pr edit")
    if gh_member; then
      gh_log github_member_pr_refused "a team member's gh pr $2 is refused: its coordinator opens the round's PR" \
        "action=$2" "coordinator=${gh_lead:-none}"
      case $2 in create) gh_verb=open ;; ready) gh_verb="mark ready" ;; *) gh_verb=$2 ;; esac
      if [[ -z $gh_lead ]]; then
        echo "agent-gh: a team member does not $gh_verb a PR — the round has one, its coordinator's, and your team has no coordinator yet. Push your branch and tell the team what is on it (send_message to \"team\")." >&2
      elif [[ $2 == create ]]; then
        echo "agent-gh: a team member does not open a PR — the round has one, opened by its coordinator ($gh_lead). Push your branch and tell the coordinator what is on it (a board item or a message): it merges your work into the round's PR." >&2
      else
        echo "agent-gh: a team member does not $gh_verb a PR — the round's PR is its coordinator's ($gh_lead), and the human (or --autopilot) merges it. Push your branch and tell the coordinator what is on it (a board item or a message)." >&2
      fi
      exit 1
    fi
    ;;
esac

# a task that owns an open PR opens no second one (AGENT_GH_OWN_PR: its PR, set by the runner)
if [[ ${1:-} == pr && ${2:-} == create && -n ${AGENT_GH_OWN_PR:-} ]]; then
  own_state=$("$AGENT_REAL_GH" pr view "$AGENT_GH_OWN_PR" --json state 2> /dev/null | jq -r '.state // empty' 2> /dev/null) \
    || own_state=""   # unknown: let gh decide
  if [[ $own_state == OPEN ]]; then
    gh_log github_second_pr_refused "a second PR of a task whose PR is open is refused" "pr=$AGENT_GH_OWN_PR"
    echo "agent-gh: this task's PR is #$AGENT_GH_OWN_PR and still open — push to its branch and keep its description up to date; open no other PR." >&2
    exit 1
  fi
fi

if [[ ${1:-} == api ]]; then
  shift
  args=() jqexpr="" path="" api_method="" api_fields=0
  while (($#)); do
    case $1 in
      --jq|-q) jqexpr=${2:-}; shift 2 ;;
      --jq=*) jqexpr=${1#--jq=}; shift ;;
      -t|--template|--template=*) echo "agent-gh: --template is not available to the agents; use --jq" >&2; exit 2 ;;
      -X|--method)
        if (($# < 2)); then args+=("$1"); shift; continue; fi
        api_method=$2; args+=("$1" "$2"); shift 2 ;;
      --method=*|-X=*) api_method=${1#*=}; args+=("$1"); shift ;;
      -X?*) api_method=${1#-X}; args+=("$1"); shift ;;
      -f|--raw-field|-F|--field|--input)
        if (($# < 2)); then args+=("$1"); shift; continue; fi
        api_fields=1; args+=("$1" "$2"); shift 2 ;;
      -f=*|--raw-field=*|-F=*|--field=*|--input=*|-f?*|-F?*) api_fields=1; args+=("$1"); shift ;;
      -H|--header|--hostname|--cache|--preview)
        if (($# < 2)); then args+=("$1"); shift; continue; fi
        args+=("$1" "$2"); shift 2 ;;
      *) if [[ -z $path && $1 != -* ]]; then path=$1; fi; args+=("$1"); shift ;;
    esac
  done
  # The REST API is another way to change a PR: apply the same member rule to explicit and field-implied writes.
  api_path=${path%%[?#]*} api_mutation=0
  if [[ $api_path =~ (^|/)pulls/[0-9]+/merge$ ]]; then
    api_mutation=1
  elif [[ $api_path =~ (^|/)pulls(/[0-9]+)?$ ]]; then
    if [[ -n $api_method ]]; then
      [[ ${api_method^^} == GET ]] || api_mutation=1
    elif ((api_fields)); then
      api_mutation=1
    fi
  fi
  if ((api_mutation)) && gh_member; then
    gh_log github_member_pr_refused "a team member's gh api PR mutation is refused: its coordinator owns the round's PR" \
      "action=api" "coordinator=${gh_lead:-none}"
    echo "agent-gh: a team member does not create or change a PR through gh api — the round's PR is its coordinator's (${gh_lead:-none}), and the human (or --autopilot) merges it. Push your branch and tell the coordinator what is on it (a board item or a message)." >&2
    exit 1
  fi
  # an investigator's review says who wrote it at its very top too (AGENT_REVIEW_BYLINE, set for an investigation)
  if [[ -n ${AGENT_REVIEW_BYLINE:-} && $path =~ /pulls/[0-9]+/reviews$ ]]; then
    for i in "${!args[@]}"; do
      [[ ${args[i]} == --input && -f ${args[i+1]:-} ]] || continue
      first=$(jq -r '(.body // "") | ltrimstr("\n") | split("\n")[0]' "${args[i+1]}")
      [[ $first != *"Review by the team-agents investigator"* ]] || continue
      if jq --arg l "$AGENT_REVIEW_BYLINE" '.body = ($l + "\n\n" + (.body // ""))' "${args[i+1]}" > "${args[i+1]}.byline"; then
        args[i+1]="${args[i+1]}.byline"
      else
        gh_log review_byline_failed "the byline could not be put at the top of the review" "file=${args[i+1]}"
      fi
    done
  fi
  if [[ $path =~ /pulls/[0-9]+/reviews$ ]]; then   # a review's recommendation in colour, whatever words it is in
    for i in "${!args[@]}"; do
      [[ ${args[i]} == --input && -f ${args[i+1]:-} ]] || continue
      args[i+1]=$(colour_json_recommendation "${args[i+1]}")
    done
  fi
  if [[ $path =~ /(pulls|issues)(/[0-9]+)?(/reviews|/comments)?$ ]]; then   # a description, comment or review
    for i in "${!args[@]}"; do
      [[ ${args[i]} == --input && -f ${args[i+1]:-} ]] || continue
      args[i+1]=$(colour_json_body "${args[i+1]}")
    done
  fi
  if [[ $path == graphql ]]; then
    if [[ " ${args[*]} " =~ (comments|reviews|reviewThreads|timelineItems|body) ]]; then
      gh_log github_graphql_refused "a GraphQL query for comments, reviews or bodies is refused: the agents read them through gh pr view --json or gh api …/comments"
      echo "agent-gh: a GraphQL query for comments, reviews or bodies is refused — use gh pr view --json comments,reviews or gh api …/comments" >&2
      exit 1
    fi
  elif [[ $path =~ (^|/)(issues|pulls)/([0-9]+/)?(comments|reviews)(/|$|\?) || $path =~ /reviews/[0-9]+/comments ]]; then
    out=$("$real" api "${args[@]}") || exit $?
    out=$(jq -sc 'if length == 1 then .[0] elif all(.[]; type == "array") then add else .[0] end' <<< "$out")   # --paginate
    gh_report "$out"
    gh_show "$(gh_filter "$out")" "$jqexpr"
    exit 0
  fi
  if [[ -n $jqexpr ]]; then exec "$real" api "${args[@]}" --jq "$jqexpr"; fi
  exec "$real" api "${args[@]}"
fi

if [[ ${1:-} == pr || ${1:-} == issue ]] && [[ ${2:-} == list ]]; then   # the lists: the trusted accounts' only
  kind=$1
  shift 2
  rest=() jsonf="" jqexpr=""
  while (($#)); do
    case $1 in
      --json) jsonf=${2:-}; shift 2 ;;
      --json=*) jsonf=${1#--json=}; shift ;;
      --jq|-q) jqexpr=${2:-}; shift 2 ;;
      --jq=*) jqexpr=${1#--jq=}; shift ;;
      -t|--template|--template=*) echo "agent-gh: --template is not available to the agents; use --jq" >&2; exit 2 ;;
      -w|--web) echo "agent-gh: --web is not available to the agents" >&2; exit 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  want=${jsonf:-number,title,state,url}
  if [[ $kind == pr ]]; then
    [[ -n $jsonf ]] || want+=,headRefName
    want+=,author,isCrossRepository
  else
    want+=,author
  fi
  want=$(tr ',' '\n' <<< "$want" | awk 'NF && !seen[$0]++' | paste -sd, -)
  out=$("$real" "$kind" list "${rest[@]}" --json "$want") || exit $?
  while IFS=$'\t' read -r fork num author; do
    if [[ $fork == true ]]; then
      gh_log "github_${kind}_ignored" "there is a $kind from a fork and it's ignored" "author=$author" "number=$num"
    else
      gh_log "github_${kind}_ignored" "there is unknown $kind from unknown user and it's ignored" "author=$author" "number=$num"
    fi
  done < <(jq -r --argjson t "$trusted_json" '.[] | select((.isCrossRepository // false) or (((.author.login // "") as $a | $t | index($a)) == null))
             | [((.isCrossRepository // false) | tostring), (.number | tostring), (.author.login // "")] | @tsv' <<< "$out")
  out=$(jq -c --argjson t "$trusted_json" 'map(select(((.isCrossRepository // false) | not) and (((.author.login // "") as $a | $t | index($a)) != null)))' <<< "$out")
  if [[ -n $jsonf ]]; then gh_show "$out" "$jqexpr"; exit 0; fi
  jq -r '.[] | ["#\(.number)", (.title // ""), (.headRefName // ""), (.state // "")] | @tsv' <<< "$out"
  exit 0
fi

if [[ ${1:-} == pr || ${1:-} == issue ]] && [[ ${2:-} == create || ${2:-} == edit || ${2:-} == comment ]]; then
  # a text the agents publish: as gh_publish_text makes it
  args=("$@") tmp=""
  for i in "${!args[@]}"; do
    case ${args[i]} in
      --body|-b) args[i+1]=$(gh_publish_text "${args[i+1]:-}") ;;
      --body=*) args[i]="--body=$(gh_publish_text "${args[i]#--body=}")" ;;
      --body-file|-F)
        [[ -z $tmp ]] || continue
        tmp=$(mktemp) || { gh_log github_names_failed "the names could not be coloured: no temporary file"; break; }
        if [[ ${args[i+1]:-} == - ]]; then text=$(cat && printf .); else text=$(cat -- "${args[i+1]:-}" && printf .); fi
        if [[ $text != *. ]] || ! gh_publish_text "${text%.}" > "$tmp"; then   # unreadable: gh says so itself
          rm -f "$tmp"; tmp=""; continue
        fi
        args[i+1]=$tmp ;;
    esac
  done
  "$real" "${args[@]}"
  rc=$?
  [[ -z $tmp ]] || rm -f "$tmp"
  exit "$rc"
fi

if [[ ${1:-} == pr || ${1:-} == issue ]] && [[ ${2:-} == view || ${2:-} == diff || ${2:-} == checkout ]]; then
  kind=$1 verb=$2
  shift 2
  pos=() rest=() jsonf="" jqexpr="" comments=0
  while (($#)); do
    case $1 in
      --json) jsonf=${2:-}; shift 2 ;;
      --json=*) jsonf=${1#--json=}; shift ;;
      --jq|-q) jqexpr=${2:-}; shift 2 ;;
      --jq=*) jqexpr=${1#--jq=}; shift ;;
      -t|--template|--template=*) echo "agent-gh: --template is not available to the agents; use --jq" >&2; exit 2 ;;
      -c|--comments) comments=1; shift ;;
      -R|--repo) rest+=("$1" "${2:-}"); shift 2 ;;
      -*) rest+=("$1"); shift ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  idf=author
  [[ $kind == issue ]] || idf=author,isCrossRepository
  who=$("$real" "$kind" view "${pos[@]}" "${rest[@]}" --json "$idf") || exit $?
  if ! jq -e --argjson t "$trusted_json" '((.isCrossRepository // false) | not) and (((.author.login // "") as $a | $t | index($a)) != null)' <<< "$who" > /dev/null; then
    gh_log pr_untrusted_ignored "a $kind from a fork or opened by an unknown account is not shown to the agents" \
      "author=$(jq -r '.author.login // ""' <<< "$who")" "cross_repository=$(jq -r '.isCrossRepository // false' <<< "$who")" "ref=${pos[*]}"
    echo "agent-gh: this $kind is from a fork or opened by an account that is not trusted — it is not shown" >&2
    exit 1
  fi
  if [[ $verb != view ]]; then exec "$real" "$kind" "$verb" "${pos[@]}" "${rest[@]}"; fi
  if [[ -n $jsonf ]]; then
    out=$("$real" "$kind" view "${pos[@]}" "${rest[@]}" --json "$jsonf") || exit $?
    gh_report "$out"
    gh_show "$(gh_filter "$out")" "$jqexpr"
    exit 0
  fi
  if ((comments)); then
    "$real" "$kind" view "${pos[@]}" "${rest[@]}" || exit $?   # its description: a trusted account's
    cf=comments
    [[ $kind == issue ]] || cf=comments,reviews
    out=$("$real" "$kind" view "${pos[@]}" "${rest[@]}" --json "$cf") || exit $?
    gh_report "$out"
    printf '\n-- comments and reviews (the trusted accounts'"'"' only) --\n'
    jq -r '[(.comments // [])[], (.reviews // [])[] | select((.body // "") != "")] | .[] | "\(.author.login // .user.login): \(.body)\n"' <<< "$(gh_filter "$out")"
    exit 0
  fi
  exec "$real" "$kind" view "${pos[@]}" "${rest[@]}"
fi

exec "$real" "$@"
}
if [[ ${0##*/} == gh ]]; then agent_gh "$@"; exit $?; fi

