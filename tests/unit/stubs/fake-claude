#!/usr/bin/env python3
"""Fake Claude Code CLI for tests.

Behaviour is selected by the scenario file $STUB_HOME/scenario.json, keyed by agent name, e.g.
  {"solo": {"new": "done"}, "lead": {"new": "team-lead-done"}}
Actions:
  done            final message "STATUS: DONE"
  tool-done       calls list_agents (an agentbus tool), then STATUS: DONE
  commit          commits a file with the trailers from the prompt, then STATUS: DONE
  quota           the provider refuses the run: a quota error on stderr, exit code 3, no result
  idle            STATUS: SLEEPING right away, without doing anything
  questions-file  writes the questions file, STATUS: QUESTIONS
  questions-text  asks questions only in the final message
  questions-norec writes a questions file without recommendations, STATUS: QUESTIONS
  review-majors   a --verify review result with two major findings, STATUS: DONE
  review-ready    a review with no findings and VERDICT: ready-to-merge, STATUS: DONE
  review-fixes    a review with one major finding and VERDICT: needs-fixes, STATUS: DONE
  big-report      commits a 3500-line report under .agents/reports/ and one small file, STATUS: DONE
  remote-hello    sends "hello from node2" to the coordinator "lead" over the bus, STATUS: SLEEPING
  team-lead-wait  claims the coordinator role, reads its messages and sleeps, keeping the team open (STATUS: SLEEPING)
  capacity        exits 1: "Selected model is at capacity" (the provider is overloaded)
  budget-spent    exits 1: the workspace budget is spent, it resets in three days (an ISO time)
  which-gh        DONE with the gh it finds on PATH and AGENT_GITHUB_TRUSTED_RESOLVED
  kill-group      sends SIGTERM to its own process group (a CLI cleaning up its children), exits
  cli-error       exits 1 with an error line on stderr ("Error: invalid argument --frobnicate")
  network-down    exits 1: a network issue — the provider's host cannot be resolved (DNS i/o timeout), retryable
  team-lead-crash claims the coordinator role, then the CLI fails (exit 1, no STATUS)
  blocked         ends with STATUS: BLOCKED (not a status of the system)
  claim-fail / claim-quota / claim-rate-limit   add, claim and note progress on B1, then STATUS: FAILED / an
                  exhausted quota / an HTTP 429
  rate-limit      exits 1 with an HTTP 429 rate-limit error on stderr
  stale-rate-limit  a retried 429 early on stderr, much more output, then a final message without STATUS
  commit-lines:N  commits a file of N lines, STATUS: DONE
  round-done:N/M  STATUS: ROUND_DONE N/M
  team-lead-round:N/M  claim_lead, tell the team, STATUS: ROUND_DONE N/M (a coordinator ending a round)
  pending:K:N/M   commits a test skipped as "pending: parser, round K", STATUS: ROUND_DONE N/M
  no-status       a final message without a STATUS line
  hang            sleeps without output (the watchdog must kill it)
  sleep:N         works silently for N seconds, then DONE
  team-lead-done  claim_lead, checkpoint, tell the team, STATUS: DONE
  team-sleep      claim_lead (fails for non-leads), reads its messages, STATUS: SLEEPING
  team-lead-slow  claim_lead, work for 5 s, close the team, STATUS: DONE
The agent's MCP config (--mcp-config) is used to call agentbus tools.
"""
import json, os, re, subprocess, sys, time

args = sys.argv[1:]
prompt = args[-1]
mode = "resume" if "--resume" in args else "new"
cfg = json.load(open(args[args.index("--mcp-config") + 1]))["mcpServers"]["agentbus"]
if "--agent" in cfg["args"]:
    me = cfg["args"][cfg["args"].index("--agent") + 1]
else:  # a remote team member: its MCP server relays to the lead; its scenario key is the node's agent name
    me = cfg["args"][cfg["args"].index("--member") + 1].split("@")[0]
home = os.environ["STUB_HOME"]
scenario = json.load(open(os.path.join(home, "scenario.json"))).get(me, {})
action = scenario.get(mode, scenario.get("new", "done"))
with open(os.path.join(home, "calls.log"), "a") as f:
    f.write(f"{me} {mode} {action}\n")
with open(os.path.join(home, f"prompt-{me}-{mode}.txt"), "w") as f:
    f.write(prompt)


def call(tool, **a):
    req = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}}) + "\n" + \
          json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": tool, "arguments": a}}) + "\n"
    out = subprocess.run([cfg["command"]] + cfg["args"], input=req, capture_output=True, text=True).stdout
    return json.loads(out.strip().split("\n")[-1])["result"]["content"][0]["text"]


def finish(text):
    print(json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": "working"}]}}), flush=True)
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": text}))
    sys.exit(0)


if action == "questions-file":
    q = re.search(r"(/\S*questions-\d+\.md)", prompt).group(1)
    open(q, "w").write("# Questions\n\n## 1. Which board?\na) A\nb) B\n\n**Recommended:** a) — the simpler one (fake)\n\n**Answer:**\n")
    finish("STATUS: QUESTIONS")
if action == "questions-norec":
    q = re.search(r"(/\S*questions-\d+\.md)", prompt).group(1)
    open(q, "w").write("# Questions\n\n## 1. Which board?\na) A\nb) B\n\n**Verdict:**\n")
    finish("1. Which board?\n\nSTATUS: QUESTIONS")
if action == "questions-text":
    finish("Before I start:\n\n1. **Format?** a) x b) y\n\n2. **Location?**\n\nSTATUS: QUESTIONS")
if action == "no-status":
    finish("I checked the file. Shall I continue?")
if action == "hang":
    time.sleep(600)
if action.startswith("sleep:"):
    time.sleep(int(action.split(":")[1]))
    finish("STATUS: DONE")
if action == "team-lead-done":
    call("claim_lead")
    call("checkpoint", summary="stage 1 done", next_steps="stage 2")
    call("send_message", to="team", text="TEAM DONE")
    finish("STATUS: DONE\nRole: coordinator")
if action == "quota":
    print("Individual quota reached. Please upgrade your subscription to increase your limits. Resets in 1m30s.", file=sys.stderr)
    sys.exit(3)
def claim_one():
    """adds an item, claims it and records progress on it (through the bus, as an agent does)"""
    call("board_add", title="the parser", details="write the parser", level="normal")
    call("board_claim", id="B1")
    call("board_progress", id="B1", note="lexer done at abc123; next: the parser")
if action == "big-report":
    # a team report of the protocol (.agents/reports/) far over the round limit, plus a small change
    os.makedirs(".agents/reports", exist_ok=True)
    with open(".agents/reports/report.md", "w") as f:
        f.write("".join(f"report line {i}\n" for i in range(3500)))
    with open("small.txt", "w") as f:
        f.write("one line\n")
    subprocess.run(["git", "add", "-A"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", "a small change and the team report"], check=True)
    finish("Done.\nSTATUS: DONE")
if action == "remote-hello":
    # a remote team member: its message goes through the relay to the team on the lead
    call("send_message", to="lead", text="hello from node2")
    finish("Said hello to the coordinator.\nSTATUS: SLEEPING")
if action == "budget-spent":
    # the provider's workspace budget is spent until its reset in three days (an ISO time, as OpenRouter gives it)
    import datetime
    reset = (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=3)).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    print("Workspace monthly budget of $200.00 exceeded. Contact your org admin. $200.18 of $200.00 used; resets "
          + reset + ".", file=sys.stderr)
    sys.exit(1)
if action == "which-gh":
    # which gh the agent gets, and whom it trusts
    import shutil
    finish("STATUS: DONE\ngh=" + (shutil.which("gh") or "") + " trusted=" + os.environ.get("AGENT_GITHUB_TRUSTED_RESOLVED", ""))
if action == "kill-group":
    # a CLI that, on its way out, sends SIGTERM to its whole process group (as some CLIs clean up their children)
    import signal
    os.killpg(os.getpgrp(), signal.SIGTERM)
    time.sleep(5)
    sys.exit(1)
if action == "budget-spent":
    # the provider's workspace budget is spent until its reset, three days from now (an ISO time)
    import datetime
    reset = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=3)
    print("Workspace monthly budget of $200.00 exceeded. Contact your org admin. $200.18 of $200.00 used; resets "
          + reset.strftime("%Y-%m-%dT%H:%M:%S.000Z") + ".", file=sys.stderr)
    sys.exit(1)
if action == "cli-error":
    print("Error: invalid argument --frobnicate", file=sys.stderr)
    sys.exit(1)
if action == "network-down":
    # the network or the provider cannot be reached (a DNS timeout, as an ISP's night works cause it)
    print("error: There was a network issue connecting to the server, please try again.", file=sys.stderr)
    print('AGY_ERROR: {"short_error":"agent executor error: generating and executing: request failed: Post '
          '\\"https://daily-cloudcode-pa.googleapis.com/v1internal:streamGenerateContent?alt=sse\\": dial tcp: lookup '
          'daily-cloudcode-pa.googleapis.com on 127.0.0.53:53: read udp 127.0.0.1:41211->127.0.0.53:53: i/o timeout",'
          '"status":"UNKNOWN","error_code":2,"code_kind":"grpc","retryable":true}', file=sys.stderr)
    sys.exit(1)
if action == "capacity":
    print("Selected model is at capacity. Please try a different model.", file=sys.stderr)
    sys.exit(1)
if action == "team-lead-crash":
    call("claim_lead")
    print("Error: the CLI crashed", file=sys.stderr)
    sys.exit(1)
if action == "blocked":
    finish("Waiting for the daemon to be merged.\nSTATUS: BLOCKED")
if action == "claim-fail":
    claim_one()
    finish("I cannot go on.\nSTATUS: FAILED")
if action == "claim-quota":
    claim_one()
    print("Error: You have hit your usage limit. Individual quota reached", file=sys.stderr)
    sys.exit(3)
if action == "claim-rate-limit":
    claim_one()
    print("APIError: 429 Too Many Requests: rate limit exceeded", file=sys.stderr)
    sys.exit(1)
if action == "review-ready":
    finish("Answer: the PR can be merged.\nProblems: critical 0, major 0, minor 0\n\nVERDICT: ready-to-merge\nSTATUS: DONE")
if action == "review-fixes":
    finish("Answer: one fix is needed.\nProblems: critical 0, major 1, minor 0\n\n"
           "1. major: the cache never expires — simplest fix: add a TTL\n\nVERDICT: needs-fixes\nSTATUS: DONE")
if action == "review-majors":
    finish("Answer: needs changes — two major problems.\n"
           "Problems: critical 0, major 2, minor 1\n\n"
           "1. major: the parser drops the last line — simplest fix: read until EOF\n"
           "2. major: no test for an empty file — simplest fix: add one table case\n\n"
           "STATUS: DONE")
if action == "rate-limit":
    print("APIError: 429 Too Many Requests: rate limit exceeded by the upstream provider", file=sys.stderr)
    sys.exit(1)
if action == "stale-rate-limit":
    # an early 429 the CLI retried, then a long run that ends without STATUS for another reason
    print("APIError: 429 Too Many Requests: rate limit exceeded, retrying in 2s", file=sys.stderr)
    for i in range(60):
        print(f"step {i}: working", file=sys.stderr)
    finish("I changed the parser but forgot to say how it ended.")
if action == "idle":
    finish("Nothing for me.\n\nSTATUS: SLEEPING")
if action == "commit":
    trailers = re.search(r"exactly these trailers, after a blank line:\n\n```\n(.*?)\n```", prompt, re.S).group(1)
    open("hello.txt", "w").write("hello\n")
    subprocess.run(["git", "add", "hello.txt"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", "Add hello.txt\n\n" + trailers], check=True)
    finish("STATUS: DONE")
if action == "commit-push":
    trailers = re.search(r"exactly these trailers, after a blank line:\n\n```\n(.*?)\n```", prompt, re.S).group(1)
    open("hello.txt", "w").write("hello\n")
    subprocess.run(["git", "add", "hello.txt"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", "Add hello.txt\n\n" + trailers], check=True)
    subprocess.run(["git", "push", "-q", "-u", "origin", "HEAD"], check=True)
    finish("STATUS: DONE")
if action.startswith(("round8-delegate:", "round8-unpushed:", "round8-advance:")):
    # New fixture action: capture a real commit, optionally push it, and submit a capabilities request.
    kind, capability = action.split(":", 1)
    trailers = re.search(r"exactly these trailers, after a blank line:\n\n```\n(.*?)\n```", prompt, re.S).group(1)
    with open("delegated.txt", "w") as f:
        f.write("captured base\n")
    subprocess.run(["git", "add", "delegated.txt"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", "Capture delegation base\n\n" + trailers], check=True)
    captured = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    with open(os.path.join(home, "captured-sha.txt"), "w") as f:
        f.write(captured)
    if kind != "round8-unpushed":
        subprocess.run(["git", "push", "-q", "-u", "origin", "HEAD"], check=True)
    answer = call("delegate", request="commit and push hello.txt", context="verify this captured base", requires=[capability])
    with open(os.path.join(home, "delegation.txt"), "w") as f:
        f.write(answer)
    if kind == "round8-advance":
        with open("advance.txt", "w") as f:
            f.write("later commit\n")
        subprocess.run(["git", "add", "advance.txt"], check=True)
        subprocess.run(["git", "commit", "-q", "-m", "Advance requester\n\n" + trailers], check=True)
        subprocess.run(["git", "push", "-q", "origin", "HEAD"], check=True)
    finish("STATUS: DONE")
def commit_file(name, text, message):
    trailers = re.search(r"exactly these trailers, after a blank line:\n\n```\n(.*?)\n```", prompt, re.S).group(1)
    open(name, "w").write(text)
    subprocess.run(["git", "add", name], check=True)
    subprocess.run(["git", "commit", "-q", "-m", message + "\n\n" + trailers], check=True)
if action.startswith("commit-lines:"):
    n = int(action.split(":")[1])
    commit_file("big.txt", "".join(f"line {i}\n" for i in range(n)), f"Add {n} lines")
    finish("STATUS: DONE")
if action.startswith("team-lead-round:"):
    # a coordinator ending a round of a team: claim the role, tell the team, STATUS: ROUND_DONE N/M
    call("claim_lead")
    call("send_message", to="team", text="TEAM DONE")
    finish("Round finished.\n\nSTATUS: ROUND_DONE " + action.split(":")[1] + "\nRole: coordinator")
if action.startswith("round-done:"):
    finish("Round finished.\n\nSTATUS: ROUND_DONE " + action.split(":")[1])
if action.startswith("pending:"):
    _, due, nm = action.split(":")
    commit_file("parser_test.go", f'package p\n\nimport "testing"\n\nfunc TestParser(t *testing.T) {{\n\tt.Skip("pending: parser, round {due}")\n}}\n', "Pending parser test")
    finish("STATUS: ROUND_DONE " + nm)
if action == "tool-done":
    call("list_agents")
    finish("STATUS: DONE")
if action == "team-lead-wait":
    # a coordinator that keeps its team open: it claims the role and sleeps (woken by its members' messages); as an
    # agent does before it sleeps, it reads what it was sent, which then no longer wakes it
    call("claim_lead")
    call("read_messages")
    finish("Coordinating; waiting for the members.\nSTATUS: SLEEPING\nRole: coordinator")
if action == "team-lead-slow":
    call("claim_lead")
    time.sleep(5)
    call("send_message", to="team", text="TEAM DONE")
    finish("STATUS: DONE\nRole: coordinator")
if action == "team-sleep":
    time.sleep(1)
    call("claim_lead")
    call("read_messages")   # as an agent does before it sleeps: what it was sent is read, and no longer wakes it
    finish("STATUS: SLEEPING")
finish("STATUS: DONE\nDone: everything")
