#!/usr/bin/env bash
# Test stub for `systemctl --user is-active|stop <unit>...` backed by the PIDs recorded by the systemd-run stub
# (path units: by the files it records).
[[ ${1:-} == --user ]] && shift
cmd=$1; shift
for u in "$@"; do
  [[ $u == --quiet ]] && continue
  if [[ $u == *.path ]]; then   # path units recorded by the systemd-run stub
    case $cmd in
      is-active) [[ -f $STUB_UNITS/$u ]] && exit 0 || exit 3 ;;
      stop) rm -f "$STUB_UNITS/$u" ;;
    esac
    continue
  fi
  f=$STUB_UNITS/$u; [[ $u == *.service ]] || f=$STUB_UNITS/$u.service
  p=$(cat "$f.pid" 2>/dev/null || true)
  case $cmd in
    is-active) [[ -n $p ]] && kill -0 "$p" 2>/dev/null && exit 0 || exit 3 ;;
    stop)
      # as systemd: a transient unit is gone once its process has ended — stopping it is "not loaded" (exit 5)
      if [[ -z $p ]] || ! kill -0 "$p" 2>/dev/null; then
        echo "Failed to stop $u: Unit $u not loaded." >&2
        exit 5
      fi
      kill -TERM -- -"$p" 2>/dev/null || true
      for _ in $(seq 1 50); do kill -0 "$p" 2>/dev/null || break; sleep 0.1; done ;;
  esac
done
exit 0
