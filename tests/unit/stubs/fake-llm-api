#!/usr/bin/env python3
# A fake OpenAI-compatible chat API for the tests of `agent authenticated` (no network): it answers by the model's
# name — "limited" → 402, "busy" → 429, "badkey" → 401, otherwise 200 — and appends "<path> <model>" to a log.
#   fake-llm-api PORT LOGFILE
import http.server, json, sys

port, log = int(sys.argv[1]), sys.argv[2]

class Handler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        model = body.get("model", "")
        with open(log, "a") as f:
            f.write(f"{self.path} {model}\n")
        if "limited" in model:
            code, reply = 402, {"error": {"message": "Monthly spending limit reached"}}
        elif "busy" in model:
            code, reply = 429, {"error": {"message": "Model is overloaded, try again later"}}
        elif "badkey" in model:
            code, reply = 401, {"error": {"message": "Invalid API key"}}
        else:
            code, reply = 200, {"choices": [{"message": {"content": "OK"}}]}
        data = json.dumps(reply).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass

http.server.HTTPServer(("127.0.0.1", port), Handler).serve_forever()
