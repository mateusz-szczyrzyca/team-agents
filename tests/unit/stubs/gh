#!/usr/bin/env bash
# Test stub for gh: logs calls; `gh pr list` returns $STUB_HOME/gh-prs.json if present (filtered by --head), else [].
echo "gh $*" >> "$STUB_HOME/gh.log"
if [[ "${1:-} ${2:-}" == "pr list" ]]; then
  # --head picks the PRs of one branch; an entry without headRefName stands for any branch
  head=""; prev=""
  for a in "$@"; do [[ $prev == --head ]] && head=$a; prev=$a; done
  if [[ -f $STUB_HOME/gh-prs.json ]]; then
    jq -c --arg h "$head" '[.[] | select($h == "" or (.headRefName // $h) == $h)]' "$STUB_HOME/gh-prs.json"
  else
    echo '[]'
  fi
fi
exit 0
