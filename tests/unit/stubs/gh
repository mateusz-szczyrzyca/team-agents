#!/usr/bin/env bash
# Test stub for gh: logs calls; `gh pr list` returns $STUB_HOME/gh-prs.json if present (filtered by --head; a PR
# without isCrossRepository and author is from this repository, by $STUB_GH_LOGIN), else []; `gh api user` gives
# $STUB_GH_LOGIN (agents-bot).
echo "gh $*" >> "$STUB_HOME/gh.log"
if [[ "${1:-} ${2:-}" == "api user" ]]; then   # the account gh is logged in as (the agents' one)
  echo "${STUB_GH_LOGIN:-agents-bot}"
  exit 0
fi
if [[ "${1:-} ${2:-}" == "pr list" ]]; then
  # --head picks the PRs of one branch; an entry without headRefName stands for any branch
  head=""; prev=""
  for a in "$@"; do [[ $prev == --head ]] && head=$a; prev=$a; done
  if [[ -f $STUB_HOME/gh-prs.json ]]; then
    # a PR without them is the agents' own: from this repository, opened by the account gh is logged in as
    jq -c --arg h "$head" --arg login "${STUB_GH_LOGIN:-agents-bot}" \
      '[.[] | select($h == "" or (.headRefName // $h) == $h) | {isCrossRepository: false, author: {login: $login}} + .]' "$STUB_HOME/gh-prs.json"
  else
    echo '[]'
  fi
fi
if [[ "${1:-}" == api && "${2:-}" != user && -f $STUB_HOME/gh-api.json ]]; then   # comments and reviews: gh-api.json
  cat "$STUB_HOME/gh-api.json"
  exit 0
fi
if [[ "${1:-}" == pr && ( "${2:-}" == view || "${2:-}" == diff ) && -f $STUB_HOME/gh-pr-view.json ]]; then   # one PR
  if [[ "${2:-}" == diff ]]; then jq -r '.diff // "diff --git a/x b/x"' "$STUB_HOME/gh-pr-view.json"
  elif [[ " $* " == *" --json "* ]]; then cat "$STUB_HOME/gh-pr-view.json"
  else jq -r '"title:\t\(.title // "")\n\(.body // "")"' "$STUB_HOME/gh-pr-view.json"
  fi
  exit 0
fi
if [[ "${1:-} ${2:-}" == "pr view" && " $* " == *" body "* ]]; then   # a PR's description: $STUB_HOME/gh-pr-body.md
  cat "$STUB_HOME/gh-pr-body.md" 2>/dev/null || true
fi
if [[ "${1:-} ${2:-}" == "pr merge" && -f $STUB_HOME/gh-prs.json ]]; then   # as GitHub: the PR is merged
  jq -c --arg u "${3:-}" '[.[] | if .url == $u then .state = "MERGED" else . end]' "$STUB_HOME/gh-prs.json" > "$STUB_HOME/gh-prs.json.new"
  mv "$STUB_HOME/gh-prs.json.new" "$STUB_HOME/gh-prs.json"
fi
exit 0
