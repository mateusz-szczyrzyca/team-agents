#!/usr/bin/env bash
# Test stub for systemd-run: runs the command as a detached background process (or in the foreground
# with --wait) and records its PID under $STUB_UNITS/<unit>.service.pid so that the systemctl stub
# can report and stop it.
wd=.; envs=(); wait=0; unit=x
while [[ ${1:-} == --* ]]; do
  case $1 in
    --working-directory=*) wd=${1#*=} ;;
    --setenv=*) envs+=("${1#*=}") ;;
    --wait) wait=1 ;;
    --unit=*) unit=${1#*=} ;;
  esac
  shift
done
if ((wait)); then ( cd "$wd" && exec env "${envs[@]}" "$@" ); exit $?; fi
( cd "$wd" && exec setsid env "${envs[@]}" "$@" ) </dev/null >/dev/null 2>&1 &
echo $! > "$STUB_UNITS/$unit.service.pid"
