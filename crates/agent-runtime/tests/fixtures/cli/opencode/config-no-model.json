{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "agentbus": {
      "type": "local",
      "command": [
        "/opt/bin/agentbus",
        "serve",
        "--agent",
        "claude-1",
        "--team",
        "team-7"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "/opt/bin/serena",
        "start-mcp-server",
        "--project",
        "/work/tree",
        "--open-web-dashboard",
        "false",
        "--context",
        "ide"
      ],
      "enabled": true
    }
  },
  "provider": {
    "deepinfra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepInfra",
      "options": {
        "baseURL": "https://api.deepinfra.com/v1/openai",
        "apiKey": "{env:DEEPINFRA_API_KEY}"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
