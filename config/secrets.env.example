# ~/agents/secrets.env — chmod 600. Loaded by the runner before every agent run.
# Empty values are ignored (do not set variables to an empty string "just in case").

# --- Claude Code -------------------------------------------------------------
# Subscription: a token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Or the API (pay per token). NOTE: if both are set, Claude Code uses the API key.
#ANTHROPIC_API_KEY=

# --- Codex CLI ---------------------------------------------------------------
# ChatGPT subscription: `codex login --device-auth` (stored in ~/.codex/auth.json) — nothing to put here.
# Or the API (codex exec only):
#CODEX_API_KEY=

# --- Gemini (Antigravity CLI `agy`) ------------------------------------------
# Google AI subscription: a one-time interactive `agy` login (link + code) — nothing to put here.
# Alternatively an API key: GEMINI_API_KEY=... AND "modelProvider": "gemini"
# in ~/.gemini/antigravity-cli/settings.json (the key alone changes nothing).
#GEMINI_API_KEY=

# --- OpenRouter / DeepInfra (opencode agents, pay per token) ------------------
#OPENROUTER_API_KEY=
#DEEPINFRA_API_KEY=
